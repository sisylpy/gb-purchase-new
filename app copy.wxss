/* -------------------------------------------------------------------------- */
/* 6. 排版与文字颜色 */
/* -------------------------------------------------------------------------- */

.font-xs {
  font-size: 20rpx;
}

.font-sm {
  font-size: 24rpx;
}

.font-sl {
  font-size: 28rpx;
}

.font-base{
  font-size: 30rpx;
}

.font-md {
  font-size: 32rpx;
}

.font-lg {
  font-size: 34rpx;
}

.font-xl {
  font-size: 36rpx;
}

.font-xxl {
  font-size: 40rpx;
}

.font-bold {
  font-weight: bold;
}

.text-center {
  text-align: center;
}

.small {
  font-size: 24rpx;
}

.big {
  font-size: 36rpx;
  font-weight: bold;
}

.text-primary,
.mainColor {
  color: var(--gb-primary);
}

.text-secondary {
  color: var(--gb-text-secondary);
}

.gray,
.darktext-secondary,
.text-placeholder {
  color: var(--gb-text-muted);
}

.text-danger {
  color: var(--gb-danger);
}

.text-success {
  color: var(--gb-success);
}

.text-warning {
  color: var(--gb-warning);
}

.text-white {
  color: var(--gb-text-inverse);
}

.brand {
  margin-right: 4rpx;
  padding: 0 6rpx;
  font-size: 35rpx;
  font-weight: 300;
  color: var(--gb-text-inverse);
  border: 1rpx solid var(--gb-text-inverse);
  border-radius: 10rpx;
}

/* -------------------------------------------------------------------------- */
/* 7. 背景 */
/* -------------------------------------------------------------------------- */

.bg-page,
.pageBack {
  background-color: var(--gb-bg-page);
}

.bg-white {
  background-color: var(--gb-bg-white);
}

.bg-gray {
  background-color: var(--gb-bg-gray);
}

.bg-primary {
  background-color: var(--gb-primary);
}

.bg-mainColor {
  background-color: var(--gb-primary);
}

.bg-success {
  background-color: var(--gb-success);
}

.bg-warning {
  background-color: var(--gb-warning);
}

.bg-danger {
  background-color: var(--gb-danger);
}

.bg-light,
.liziBack {
  background-color: var(--gb-bg-light);
}

/* -------------------------------------------------------------------------- */
/* 8. 边框、阴影、透明度 */
/* -------------------------------------------------------------------------- */

.border {
  border: 1rpx solid var(--gb-border);
}

.border-b,
.border-bottom {
  border-bottom: 1rpx solid var(--gb-border);
}

.border-t {
  border-top: 1rpx solid var(--gb-border);
}

.shadow-sm {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.shadow-md {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.shadow-lg {
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.opacity-50 {
  opacity: 0.5;
}

/* -------------------------------------------------------------------------- */
/* 9. 通用组件与杂项 */
/* -------------------------------------------------------------------------- */

.btn {
  width: 170rpx;
  height: 60rpx;
  padding: 10rpx 20rpx;
  color: var(--gb-text-inverse);
  background: rgb(68, 108, 170);
  border-radius: 5rpx;
}

.badge {
  position: absolute;
  top: -5rpx;
  right: -5rpx;
  z-index: 1;
  min-width: 40rpx;
  height: 40rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: var(--gb-text-inverse);
  text-align: center;
  background-color: var(--gb-primary);
  border-radius: 50%;
}

.badge.is-gray {
  background-color: gray;
}

/* 显隐：空状态、遮罩等配合使用 */
.show {
  display: block;
}

.hide {
  display: none;
}

.empty_image {
  width: 100rpx;
  height: 100rpx;
}

.empty-container {
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods_item {
  width: 140rpx;
  height: 140rpx;
  border-radius: 10rpx;
}

.goods_item_small {
  width: 40rpx;
  height: 40rpx;
}

.goods_item_lg {
  width: 80rpx;
  height: 80rpx;
}

/* 历史命名：头像/链接小图，慎用过于泛化的类名 */
.url {
  float: left;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.top_img {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
  margin-left: 20rpx;
  border-radius: 50%;
}

.face_img {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
}

.icon {
  width: 40rpx;
  height: 40rpx;
}

.icon-sm {
  width: 30rpx;
  height: 30rpx;
}

.icon-md {
  width: 50rpx;
  height: 50rpx;
}

.wx_icon {
  width: 80rpx;
  height: 80rpx;
}

.input {
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 10rpx;
}

.form-label {
  width: 200rpx;
  font-size: 32rpx;
  color: var(--gb-text-secondary);
}

.form-input,
.flex-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  border: 1rpx solid var(--gb-border-input);
  border-radius: 10rpx;
}

.wx_part {
  position: fixed;
  bottom: 0;
  width: 100%;
  padding: 20rpx;
  background-color: rgb(190, 190, 190);
}

.orderBottom {
  position: fixed;
  bottom: 0;
  z-index: 99998;
  width: 100%;
  padding-bottom: 200rpx;
  background-color: rgb(216, 229, 233);
}

.dot {
  display: block;
  width: 40rpx;
  height: 40rpx;
  border: 1rpx solid gray;
}

.dotSelected {
  width: 46rpx;
  height: 46rpx;
}

.dotWx {
  position: absolute;
  width: 46rpx;
  margin-top: -30rpx;
  margin-left: 40rpx;
  font-size: 24rpx;
  line-height: 40rpx;
  color: var(--gb-text-inverse);
  text-align: center;
  background: #1ba0e5;
  border-radius: 40rpx;
}

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 1000;
  display: none;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}

.overlay.show {
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}

.popup-container {
  position: fixed;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 80%;
  background-color: var(--gb-bg-white);
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  border-bottom: 1rpx solid var(--gb-border-soft);
}

.popup-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--gb-text);
}

.popup-content {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.popup-footer {
  padding: 20rpx;
  border-top: 1rpx solid var(--gb-border-soft);
}

.save-btn {
  width: 100%;
  height: 80rpx;
  font-size: 32rpx;
  line-height: 80rpx;
  color: var(--gb-text-inverse);
  text-align: center;
  background-color: var(--gb-primary);
  border-radius: 10rpx;
}

.close-icon {
  width: 40rpx;
  height: 40rpx;
}

.hover {
  opacity: 0.7;
}

.hoverBar {
  background-color: var(--gb-bg-white);
  border-radius: 10rpx;
}

.hoverBtn {
  background-color: #a0defd;
}
