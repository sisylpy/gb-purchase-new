/**
 * app.wxss - 全局样式（单文件便于微信开发者工具 class 补全）
 *
 * 区块：1.设计变量与 page  2.基础重置  3.布局  4.尺寸与省略
 *       5.间距  6.排版与文字色  7.背景  8.边框圆角阴影  9.通用组件
 *
 * 说明：.show / .hide 用于显隐切换；与 .overlay 组合时用 .overlay.show。
 * 页面 wxss 中可覆盖同名类（如个别页的 .bg-mainColor）。
 */

/* -------------------------------------------------------------------------- */
/* 1. 设计变量 + 页面根样式 */
/* -------------------------------------------------------------------------- */

page {
  /* 品牌与语义色 */
  --gb-primary: #187e6e;
  --gb-success: #07c160;
  --gb-warning: #fa9d3b;
  --gb-danger: #fa5151;
  --gb-text: #333333;
  --gb-text-secondary: #666666;
  --gb-text-muted: #999999;
  --gb-text-inverse: #ffffff;
  /* 背景 */
  --gb-bg-page: #f5f5f5;
  --gb-bg-white: #ffffff;
  --gb-bg-light: #e5f8f6;
  --gb-bg-gray: #f0f0f0;
  /* 线框 */
  --gb-border: #e0e0e0;
  --gb-border-input: #dddddd;
  --gb-border-soft: #f0f0f0;

  height: 100%;
  background-color: var(--gb-bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--gb-text);
  line-height: 1.6;
}

/* -------------------------------------------------------------------------- */
/* 2. 基础重置 */
/* -------------------------------------------------------------------------- */

::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

view,
text,
image,
input,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}

button::after {
  border: none;
}

/* -------------------------------------------------------------------------- */
/* 3. 布局（flex） */
/* -------------------------------------------------------------------------- */

.flex,
.flex-row,
.flex-row-default {
  display: flex;
  flex-direction: row;
}

/* 横向一行，且子项在交叉轴居中（行内图标与文字垂直对齐）。
   与 .flex-row 区分：.flex-row 只负责横向排布，不默认 align-items。 */
.flex-row-items-center {
  display: flex;
  flex-direction: row;
  align-items: center;
}

/* 横向一行，且主轴方向整体居中（整行内容在水平方向居中） */
.flex-row-justify-center {
  display: flex;
  flex-direction: row;
  justify-content: center;
}

.flex-col,
.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

.flex-shrink-0 {
  flex-shrink: 0;
}

/* 主轴 */
.flex-start {
  justify-content: flex-start;
}

.flex-center {
  justify-content: center;
}

.flex-end {
  justify-content: flex-end;
}

.flex-between {
  justify-content: space-between;
}

.flex-around {
  justify-content: space-around;
}

/* 交叉轴 */
.items-start {
  align-items: flex-start;
}

.items-center,
.align-center {
  align-items: center;
}

.items-end {
  align-items: flex-end;
}

.items-stretch {
  align-items: stretch;
}

.center-content {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 老项目：常用横向组合 */
.flex-row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-row-between-default {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.flex-row-around {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
}

.flex-row-reverse {
  display: flex;
  flex-direction: row-reverse;
  align-items: center;
}

.flex-row-wrap {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.flex-stretch {
  display: flex;
  flex-direction: row;
  align-items: stretch;
}

.flex-column-center {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

/* -------------------------------------------------------------------------- */
/* 4. 尺寸、省略、圆角工具 */
/* -------------------------------------------------------------------------- */

.full-height {
  height: 100%;
}

.w-full {
  width: 100%;
}

.w-half,
.half-row {
  width: 50%;
}

.w-third {
  width: 33.33%;
}

.third-row {
  width: 30%;
  text-align: center;
}

.w-quarter,
.quarter-row {
  width: 25%;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.radius-10 {
  border-radius: 10rpx;
}

.radius-sm,
.rounded-sm {
  border-radius: 8rpx;
}

.radius-md,
.rounded-md {
  border-radius: 16rpx;
}

.radius-lg,
.rounded-lg {
  border-radius: 24rpx;
}

.radius-20,
.twenty_radius {
  border-radius: 20rpx;
}

