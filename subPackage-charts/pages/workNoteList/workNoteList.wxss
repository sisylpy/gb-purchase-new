/* ========== 页面根容器 ========== */
.wn-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #faf8f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial,
    'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

/* ========== 主滚动区 ========== */
.wn-scroll {
  position: relative;
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
}

/* ========== 加载中 ========== */
.wn-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.wn-loading-text {
  font-size: 28rpx;
  color: #999;
}

/* ========== 空状态 ========== */
.wn-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
  box-sizing: border-box;
}

.wn-empty-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.6;
}

.wn-empty-text {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: #5f5f5f;
}

.wn-empty-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #999;
}

/* ========== 笔记卡片 ========== */
.wn-card {
  margin: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04), 0 1rpx 4rpx rgba(0, 0, 0, 0.02);
  box-sizing: border-box;
  transition: opacity 0.15s ease;
}

.wn-card:active {
  opacity: 0.85;
}

/* 卡片头部：类型标签 + 标题 */
.wn-card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.wn-type-tag {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
}

.wn-card-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

.wn-card-delete {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(250, 81, 81, 0.08);
}

.wn-card-delete-icon {
  font-size: 24rpx;
  color: #fa5151;
  line-height: 1;
}

/* 预览内容（最多 2 行） */
.wn-card-preview {
  margin-top: 16rpx;
}

.wn-card-preview-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-word;
}

/* 展开后的完整内容 */
.wn-card-full {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
}

.wn-card-full-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  word-break: break-word;
}

/* 底部：来源 + 时间 */
.wn-card-footer {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.wn-card-source {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}

.wn-card-time {
  font-size: 24rpx;
  color: #bbb;
  line-height: 1.4;
}

/* ========== 操作按钮行 ========== */
.wn-card-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0f0f0;
}

.wn-action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
  transition: opacity 0.15s ease;
}

.wn-action-btn:active {
  opacity: 0.7;
}

.wn-action-btn--edit {
  background: #f0f4ff;
  color: #4a6cf7;
}

.wn-action-btn--push {
  background: #e8f5e9;
  color: #2e7d32;
}

.wn-action-btn--delete {
  background: rgba(250, 81, 81, 0.08);
  color: #fa5151;
}

/* ========== 编辑弹窗 ========== */
.wn-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
}

.wn-modal {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 60rpx;
  background: #fff;
  border-radius: 32rpx;
  z-index: 1001;
  overflow: hidden;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.wn-modal-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.wn-modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.wn-modal-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  font-size: 28rpx;
  color: #999;
  background: #f5f5f5;
}

.wn-modal-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.wn-modal-field {
  margin-bottom: 24rpx;
}

.wn-modal-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #666;
  margin-bottom: 12rpx;
}

.wn-modal-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  background: #f8f8f8;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.wn-modal-textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  background: #f8f8f8;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.wn-modal-footer {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 20rpx 32rpx 32rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.wn-modal-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  padding: 20rpx 40rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
}

.wn-modal-btn--cancel {
  background: #f5f5f5;
  color: #666;
}

.wn-modal-btn--confirm {
  background: #4a6cf7;
  color: #fff;
}

.wn-modal-btn:active {
  opacity: 0.75;
}

/* 底部留白 */
.wn-scroll-spacer {
  height: 120rpx;
}

/* ========== 上拉加载更多 ========== */
.wn-loadmore {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 40rpx;
}

.wn-loadmore-text {
  font-size: 26rpx;
  color: #bbb;
}
