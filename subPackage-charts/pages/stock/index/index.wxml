<wxs module="imgUrl" src="/wxs/imgUrl.wxs" />
<wxs src="/wxs/format.wxs" module="tool" />
<view class="page">
  <back-navbar title="库存" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <view style="height:{{navBarHeight}}rpx"></view>

  <scroll-view scroll-x class="day-tabs" show-scrollbar="false">
    <view class="day-tab {{activeDay==index?'active':''}}" wx:for="{{dayTabs}}" wx:key="whichDay" data-index="{{index}}" bindtap="chooseDay">
      <view class="day-label">{{item.label}}</view><view><text>{{item.sub}}</text><text class="day-total">{{item.total}}元</text></view>
    </view>
  </scroll-view>

  <view class="summary">
    <view class="summary-card total"><text class="summary-icon">▱</text><view><text>库存总额</text><text class="strong">{{totalAmount}}元</text></view></view>
    <view class="summary-card today"><text class="summary-icon">↑</text><view><text>今日入库</text><text class="strong">{{todayAmount}}元</text></view></view>
    <view class="summary-card count"><text class="summary-icon">♙</text><view><text>库存商品</text><text class="strong">{{goodsCount}}个</text></view></view>
    <view class="summary-card attention"><text class="summary-icon">!</text><view><text>重点关注</text><text class="strong">{{attentionCount}}个</text></view></view>
  </view>

  <view class="main">
    <scroll-view scroll-y class="category-rail">
      <view class="category {{activeCategory==index?'active':''}}" wx:for="{{categories}}" wx:key="gbDistributerFatherGoodsId" data-index="{{index}}" bindtap="chooseCategory">
        <text class="category-icon">{{item.icon}}</text><text>{{item.gbDfgFatherGoodsName}}</text>
      </view>
    </scroll-view>

    <view class="content" wx:if="{{categories.length}}">
      <view class="category-card">
        <image src="{{imgUrl.resolve(url,categories[activeCategory].gbDfgFatherGoodsImgLarge||categories[activeCategory].gbDfgFatherGoodsImg)}}" mode="aspectFill"></image>
        <view class="category-info"><text class="category-title">{{categories[activeCategory].gbDfgFatherGoodsName}}</text><view class="category-grid"><view><text class="small">库存金额</text><text class="strong">{{categories[activeCategory].amountText}}元</text></view><view><text class="small">商品数</text><text class="strong">{{categories[activeCategory].goodsCount}}个</text></view><view><text class="small">批次入库</text><text class="strong">{{categoryInbound||0}}元</text></view><view><text class="small">重点商品</text><text class="strong">{{categories[activeCategory].attentionCount}}个</text></view></view></view>
      </view>

      <view class="tools">
        <picker mode="selector" range="{{sortNames}}" bindchange="changeSort"><view class="sort">排序方式⌄</view></picker>
        <view class="filters"><text class="{{activeFilter=='all'?'active':''}}" data-value="all" bindtap="chooseFilter">全部</text><text class="{{activeFilter=='more'?'active':''}}" data-value="more" bindtap="chooseFilter">库存偏多</text><text class="{{activeFilter=='attention'?'warn':''}}" data-value="attention" bindtap="chooseFilter">临期关注</text></view>
      </view>

      <scroll-view scroll-y class="goods-list">
        <view class="goods-card" wx:for="{{goods}}" wx:key="gbDistributerGoodsId" data-index="{{index}}" bindtap="toGoods">
          <view class="goods-head"><image src="{{imgUrl.resolve(url,item.imagePath)}}" mode="aspectFill"></image><view class="goods-name"><text>{{item.gbDgGoodsName}}</text><text class="small">¥{{item.firstPrice}}/{{item.gbDgGoodsStandardname}}</text></view><text class="status {{item.tone}}">{{item.status}}</text><text class="arrow">›</text></view>
          <view class="batch" wx:for="{{item.batches}}" wx:for-item="stock" wx:key="gbDepartmentGoodsStockId">
            <view class="batch-age"><text class="strong">{{tool.getHowManyDays(stock.gbDgsDate)}}天库存</text><text class="small">{{stock.gbDepartmentName}}</text></view>
            <view><text class="small">单价</text><text class="strong blue">{{stock.gbDgsPrice}}元/{{stock.goodsStandardName}}</text></view>
            <view><text class="small">剩余数量</text><text class="strong green">{{stock.gbDgsRestWeight}}{{stock.goodsStandardName}}</text></view>
            <view><text class="small">本月入库</text><text class="strong green">{{stock.gbDgsSubtotal}}元</text></view>
            <view><text class="small">剩余金额</text><text class="strong orange">{{stock.gbDgsRestSubtotal}}元</text></view>
          </view>
        </view>
        <view class="empty" wx:if="{{!goods.length}}"><image src="/images/file-common.png"></image><text>当前条件暂无库存商品</text></view>
        <view class="bottom-space"></view>
      </scroll-view>
    </view>
    <view class="empty-page" wx:else>暂无库存</view>
  </view>
</view>
