<wxs src="/wxs/format.wxs" module="tool" />
<wxs module="imgUrl" src="/wxs/imgUrl.wxs" />

<view class="flex flex-column ">

  <back-navbar title="库存" style="height: {{navBarHeight}}rpx;" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <!-- 顶部标签栏 -->
  <view class=" flex-row-between bg-white border-bottom" wx:if="{{total && total.restTotal > 0}}">
    <block wx:if="{{}}">
      
    </block>
    <view class="flex-row " >
      <scroll-view scroll-x="true" show-scrollbar="false" enhanced="true" class="nav" scroll-with-animation="{{true}}" scroll-left="{{leftWidth}}" style="width: {{windowWidth - 140 }}rpx; padding: 0 16rpx;">
        <view class="swiper1_top_item flex-column {{itemIndex == 0 ? 'on' : ''}} " data-index='0'  bindtap="onTab1Click" style="width: {{windowWidth / 4}}rpx; min-width: 140rpx; padding: 16rpx 12rpx; margin: 0 4rpx; box-sizing: border-box;">
          <view class="flex-row">
            <view class="time-icon all-stock">总</view>
            <text class="">所有库存</text>
          </view>
          <view class="font-md">{{total.restTotal}}元</view>
        </view>
        <view class="swiper1_top_item flex-column {{itemIndex == 1 ? 'on' : ''}}" data-index='1'  data-total="{{in && in.zeroTotal ? in.zeroTotal : 0}}"  bindtap="onTab1Click" style="width: {{windowWidth / 4}}rpx; min-width: 140rpx; padding: 16rpx 12rpx; margin: 0 4rpx; box-sizing: border-box;">
          <view class="flex-row">
            <view class="time-icon today">今</view>
            <text class="">{{in ? in.dateString : ''}}</text>
          </view>
          <view class="font-md">{{in ? in.zeroTotal : 0}}元</view>
        </view>
        <view class="swiper1_top_item  flex-column {{itemIndex==2 ? 'on' : ''}}" data-index='2' bindtap="onTab1Click" style="width: {{windowWidth / 4}}rpx; min-width: 140rpx; padding: 16rpx 12rpx; margin: 0 4rpx; box-sizing: border-box;">
          <view class="flex-row">
            <view class="time-icon one-day">1</view>
            <text class="">{{one ? one.dateString : ''}}</text>
          </view>
          <view class="font-md">{{one ? one.oneTotal : 0}}元</view>
        </view>
        <view class="swiper1_top_item  flex-column {{itemIndex==3 ? 'on' : ''}}" data-index='3' data-which="-2" data-total="{{two ? two.twoTotal : 0}}" data-days="2天" bindtap="onTab1Click" style="width: {{windowWidth / 4}}rpx; min-width: 140rpx; padding: 16rpx 12rpx; margin: 0 4rpx; box-sizing: border-box;">
          <view class="flex-row">
            <view class="time-icon two-days">2</view>
            <text class="font-md">{{two ? two.dateString : ''}}</text>
          </view>
          <view class="font-md">{{two ? two.twoTotal : 0}}元</view>
        </view>
        <view class="swiper1_top_item   flex-column {{itemIndex==4 ? 'on' : ''}}" data-index='4'  bindtap="onTab1Click" style="width: {{windowWidth / 4}}rpx; min-width: 140rpx; padding: 16rpx 12rpx; margin: 0 4rpx; box-sizing: border-box;">
          <view class="flex-row">
            <view class="time-icon three-days">3</view>
            <text class="">{{three ? three.dateString : ''}}</text>
          </view>
          <view class="font-md">{{three ? three.threeTotal : 0}}元</view>
        </view>
        <view class="swiper1_top_item  flex-column {{itemIndex==5 ? 'on' : ''}}" data-index='5' bindtap="onTab1Click" style="width: {{windowWidth / 4}}rpx; min-width: 140rpx; padding: 16rpx 12rpx; margin: 0 4rpx; box-sizing: border-box;">
          <view class="flex-row">
            <view class="time-icon more-days">3+</view>
            <text class="">{{exceedThree ? exceedThree.dateString : ''}}</text>
          </view>
          <view class="font-md">{{exceedThree ? exceedThree.exceedThreeTotal : 0}}元</view>
        </view>
      </scroll-view>

    </view>
  </view>

  <swiper duration="300" bindanimationfinish="animationfinish" current="{{itemIndex}}" data-index='{{itemIndex}}' style="height: {{windowHeight - navBarHeight - 120}}rpx;">

    <!-- all -->
    <swiper-item style="height: 100%;">
      <scroll-view scroll-y style="height:{{ windowHeight - navBarHeight - 120}}rpx;" wx:if="{{total && total.restTotal > 0 && itemIndex == 0}}">
        <view class="flex-column bg-light " >
          <view class="bg-light flex-column" wx:if="{{totalArr && totalArr.length > 0}}">
            <view class="flex-column font-md  bg-white " wx:for="{{totalArr}}" wx:for-item="grand" wx:for-index="greatIndex" wx:key="gbDistributerGoodsFatherId">
              <view class="flex-row-default" style="width: {{windowWidth - 40}}rpx;" bindtap="toStockPage" data-id="{{grand.gbDistributerFatherGoodsId}}" data-name="{{grand.gbDfgFatherGoodsName}}"  data-color="{{grand.gbDfgFatherGoodsColor}}" data-total="{{grand.fatherStockTotalString}}" data-index="{{greatIndex}}" hover-class="hover">
                <!-- <view class="p-20">
                  <image src="{{(url + grand.gbDfgFatherGoodsImg || '/images/logo.png')}}" mode="aspectFill" class="category-image" />
                </view> -->
                <view class="flex-column p-20">
                  <view class="flex-row-between " style="width: {{windowWidth - 80}}rpx;">
                    <text class="category-name">{{grand.gbDfgFatherGoodsName}}</text>
                    <view class="donut-chart-container">
                      <view class="donut-chart" style="width: 80rpx; height: 80rpx; background: {{grand.stockConicGradient}};">
                        <text class="donut-percent">{{grand.fatherStockTotalPercent}}%</text>
                      </view>
                    </view>
                  </view>
                  <view class="flex-column">
                    <view class="stock-quantity">
                      <text class="quantity-label">库存金额:</text>
                      <view class="flex-column">
                        <view class="quantity-value">{{grand.fatherStockTotalString}}元</view>
                        <block wx:if="{{grand.fatherWasteTotalString > 0}}">
                          <view class="waste-value">过期{{grand.fatherWasteTotalString}}元</view>
                        </block>
                      </view>
                    </view>
                    <view class="stock-quantity">
                      <text class="quantity-label">商品:</text>
                      <view class="flex-column">
                        <view class="quantity-value">{{grand.fatherStockManyString}}个</view>
                        <block wx:if="{{grand.fatherWasteTotalString > 0}}">
                          <view class="waste-value">过期{{grand.fatherWasteRateString}}个</view>
                        </block>
                      </view>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
          <view style="height: 200rpx; "> </view>
        </view>
      </scroll-view>
      <view class=" " wx:else style="margin-top: 300rpx; height: 200rpx;">
        <view class=" flex-column center-content">
          <image class="icon" src="../../../../images/file-common.png"></image>
          <text class="p-20">暂无库存</text>
        </view>
      </view>
    </swiper-item>

