page,.page{height:100%;background:#f2f8f6;color:#17233b}.page{display:flex;flex-direction:column;overflow:hidden}.overview-panel{position:relative;z-index:2;padding:14rpx 0 18rpx;background:linear-gradient(145deg,#f3fff8 0%,#f8fffc 48%,#edf9f4 100%);border-bottom:1rpx solid #e6f0ec;box-shadow:0 10rpx 30rpx rgba(31,91,69,.05)}
