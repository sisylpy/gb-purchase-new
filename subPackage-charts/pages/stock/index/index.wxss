
page {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  background-color: #fff;
}

.time-cards-container {
  background: #f5f5f5;
  padding: 20rpx;
  min-height: 100%;
}

.bg-white {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f0f0f0;
}

swiper {
  height: 100%;
  width: 100%;
}

.tabbar {
  height: 80rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  z-index: 999999;
  border-right: 1px solid lightgray;
}

.tabbar_item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  line-height: 80rpx;
  height: 80rpx;
  font-size: 32rpx;
}

.on {
  color: #187e6e;
}

.swiper-box {
  display: flex;
  flex-direction: column;
  flex: 1;
  height: 0;
  width: 100%;
  overflow-x: hidden;
  overflow-y: scroll;
}

.swiper1_top_item {
  font-size: 22rpx;
  display: inline-block;
  padding: 12rpx 8rpx !important;
  text-align: center;
  box-sizing: border-box;
  margin-right: 20rpx;
}

.swiper1_top_item.on {
  color: #FFFFFF;
  font-weight: 600;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #52b956, #3fa844);
}

scroll-view {
  white-space: nowrap;
}

.category-stock-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.category-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  background-color: #f0f0f0;
}

.category-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

.donut-chart-container {
  margin-left: 12rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.donut-chart {
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.donut-chart::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 60%;
  height: 60%;
  background-color: white;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  z-index: 1;
}

.donut-percent {
  font-size: 18rpx;
  font-weight: bold;
  color: #333;
  z-index: 2;
  position: relative;
  line-height: 1;
}

.time-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 500;
  color: white;
  position: relative;
  margin-right: 8rpx;
}

.time-icon.all-stock { background: #607D8B; }
.time-icon.today { background: #4CAF50; }
.time-icon.one-day { background: #2196F3; }
.time-icon.two-days { background: #FF9800; }
.time-icon.three-days { background: #F44336; }
.time-icon.more-days { background: #9C27B0; }

.stock-quantity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
  padding: 6rpx 0;
}

.quantity-label {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.quantity-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.waste-value {
  font-size: 24rpx;
  font-weight: 500;
  color: #ff4d4f;
}
