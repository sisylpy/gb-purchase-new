page,.page{height:100%;background:#f7faf9;color:#182238}.page{display:flex;flex-direction:column}.day-tabs{height:112rpx;background:#fff;white-space:nowrap;border-bottom:1rpx solid #edf1f2}.day-tab{display:inline-flex;align-items:center;gap:12rpx;height:84rpx;margin:12rpx 5rpx;padding:0 18rpx;border-radius:20rpx;box-sizing:border-box;color:#667389}.day-label{width:42rpx;height:42rpx;border-radius:12rpx;background:#8795a4;color:#fff;display:flex;align-items:center;justify-content:center;font-size:22rpx;font-weight:800}.day-tab>view:last-child{display:flex;flex-direction:column;font-size:20rpx}.day-total{font-size:24rpx;font-weight:800;color:#172238}.day-tab.active{background:#eaf9f0;color:#078b55}.day-tab.active .day-label{background:#18b96f}
.summary{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;padding:18rpx;background:#fff}.summary-card{height:106rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;gap:12rpx;background:#f0fbf4}.summary-icon{font-size:42rpx;color:#17ad5c}.summary-card>view{display:flex;flex-direction:column;font-size:21rpx}.summary-card .strong{font-size:31rpx;margin-top:7rpx;color:#13a34f;font-weight:800}.summary-card.today{background:#f4f8f5}.summary-card.today .strong{color:#222}.summary-card.count{background:#f0f6ff}.summary-card.count .summary-icon,.summary-card.count .strong{color:#2677cf}.summary-card.attention{background:#fff5ea}.summary-card.attention .summary-icon,.summary-card.attention .strong{color:#ef6810}
.main{display:flex;flex:1;min-height:0}.category-rail{width:174rpx;background:linear-gradient(#f0fbf4,#f7fafb)}.category{height:145rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;color:#737d8b;font-size:27rpx;font-weight:700}.category-icon{font-size:44rpx;margin-bottom:8rpx}.category.active{background:#e9f9ef;color:#07944f}.category.active:before{content:"";position:absolute;left:0;width:8rpx;height:100%;background:#16b967}.content{flex:1;min-width:0;display:flex;flex-direction:column;padding:14rpx;box-sizing:border-box}
.category-card{min-height:188rpx;border-radius:22rpx;background:linear-gradient(110deg,#f5fff8,#e6faed);display:flex;padding:18rpx;box-sizing:border-box}.category-card>image{width:145rpx;height:145rpx;border-radius:18rpx;background:#fff;flex-shrink:0}.category-info{flex:1;margin-left:18rpx}.category-title{display:block;font-size:38rpx;font-weight:900;color:#12243a;border-bottom:5rpx solid #32c778;padding-bottom:7rpx}.category-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12rpx;margin-top:12rpx}.category-grid view{border-right:1rpx solid #dce8e0}.category-grid .small,.category-grid .strong{display:block}.category-grid .small{font-size:19rpx;color:#6d7887}.category-grid .strong{font-size:25rpx;margin-top:4rpx;font-weight:800}
.tools{height:80rpx;display:flex;align-items:center;justify-content:space-between}.sort{font-size:24rpx;color:#3f4858}.filters{display:flex;gap:9rpx}.filters text{font-size:21rpx;padding:11rpx 21rpx;border-radius:25rpx;background:#f0f3f4;color:#5c6877}.filters .active{background:#e7f8ed;color:#098b50}.filters .warn{background:#fff0e5;color:#ef6412}.goods-list{flex:1;min-height:0}.goods-card{background:#fff;border-radius:22rpx;padding:17rpx;margin-bottom:14rpx;box-shadow:0 5rpx 18rpx rgba(33,66,63,.06)}
.goods-head{display:flex;align-items:center}.goods-head>image{width:110rpx;height:104rpx;border-radius:16rpx;background:#eef8f1}.goods-name{display:flex;flex-direction:column;margin-left:18rpx}.goods-name>text:first-child{font-size:33rpx;font-weight:900}.goods-name .small{font-size:22rpx;color:#536176;margin-top:8rpx}.status{margin-left:auto;padding:11rpx 17rpx;border-radius:24rpx;font-size:21rpx}.status.normal{background:#eaf8ff;color:#2478d4}.status.warn{background:#fff0e5;color:#ef6412}.arrow{font-size:42rpx;color:#8590a0;margin-left:10rpx}
.batch{display:grid;grid-template-columns:1.25fr repeat(4,1fr);gap:8rpx;align-items:center;border-top:1rpx solid #edf1f2;margin-top:13rpx;padding-top:13rpx}.batch>view{min-width:0;text-align:center;background:#f4f8fb;border-radius:11rpx;padding:10rpx 5rpx}.batch-age{background:#fff!important;text-align:left!important}.batch .small,.batch .strong{display:block;font-size:18rpx;overflow:hidden;text-overflow:ellipsis}.batch .strong{font-size:21rpx;margin-top:5rpx;font-weight:800}.batch-age .strong{font-size:22rpx}.batch-age .small{color:#667487}.blue{color:#2175cf}.green{color:#0a9a53}.orange{color:#ed6412}.empty,.empty-page{display:flex;flex-direction:column;align-items:center;justify-content:center;color:#8a94a2;padding:80rpx 0}.empty image{width:56rpx;height:56rpx;margin-bottom:16rpx}.empty-page{flex:1}.bottom-space{height:40rpx}
