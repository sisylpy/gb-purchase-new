.goods-card {
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.goods-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
}

.filter-bar {
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.filter-item {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.summary-bar {
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stock-item {
  background-color: #ffffff;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 0;
  font-size: 24rpx;
}

.info-label {
  color: #999;
}

.info-value {
  color: #333;
  font-weight: 500;
}

.days-badge {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.days-fresh {
  background-color: #e8f5e9;
  color: #4caf50;
}

.days-normal {
  background-color: #e3f2fd;
  color: #2196f3;
}

.days-old {
  background-color: #fff3e0;
  color: #ff9800;
}

.status-badge {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.status-normal {
  background-color: #e8f5e9;
  color: #4caf50;
}

.status-warning {
  background-color: #fff3e0;
  color: #ff9800;
}

.status-used {
  background-color: #f5f5f5;
  color: #999;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  background-color: #007aff;
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.action-btn:active {
  background-color: #0066cc;
}

.dep-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.dep-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.dep-item.active {
  color: #007aff;
  background-color: #f0f8ff;
}

.loading-mask {
  height: 200rpx;
}
