<wxs src="../../../../utils/fn.wxs" module="tool" />
<wxs module="imgUrl" src="/wxs/imgUrl.wxs" />

<view class="flex flex-column">
  <back-navbar title="{{fatherName}}" style="height: {{navBarHeight}}rpx;" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view class="time-card has-stock {{currentOpen ? 'has-stock' : ''}}" bindtap="open1">
    <view class="card-header p-20">
      <view class="time-title-section">
        <view class="time-icon {{whichDay == 1 ? 'today' : (whichDay == 0 ? 'one-day' : (whichDay == 2 ? 'two-days' : (whichDay == 3 ? 'three-days' : (whichDay == 99 ? 'all-stock' : 'more-days'))))}}">
          {{whichDay == 0 ? '今' : (whichDay == 1 ? '1' : (whichDay == 2 ? '2' : (whichDay == 3 ? '3' : (whichDay == 99 ? '总' : '3+'))))}}
        </view>
        <view class="flex-column">
          <text class="time-text">{{dateString}}</text>
          <view class="font-yuan">商品:{{oneDay.arr.length}}个</view>
          <block wx:if="{{oneDay.goodsEveryWasteTotal > 0}}">
            <view class="font-yuan text-danger">过期商品:{{oneDay.wasteGoodsCount}}个</view>
          </block>
        </view>
      </view>
      <view class="stock-amount-section flex-column">
        <text class="stock-amount">{{oneDay ? oneDay.total : 0}}元</text>
        <block wx:if="{{oneDay.wasteGoodsCount > 0}}">
          <view class="font-yuan text-danger">过期金额:{{oneDay.wasteSubtotal}}元</view>
        </block>
      </view>
    </view>

    <view class="flex-column" wx:if="{{oneDay && oneDay.total > 0}}">
      <view class="flex-column bg-white border-bottom p-20" wx:for="{{oneDay.arr}}" wx:for-item="goods" wx:for-index="stockIndex" wx:key="gbDistributerGoodsId">

        <view class="flex-row-between" catch:tap="showList" data-index="{{stockIndex}}">
          <view class="flex-row-default">
            <image src="{{(url + goods.gbDgNxFatherImg || '/images/logo.jpg')}}" mode="aspectFill" class="goods-image" />
            <view class="goods-details">
              <text class="flex-row font-sl">第{{stockIndex + 1}}/{{oneDay.arr.length}}个</text>
              <text class="goods-name">{{goods.gbDgGoodsName}}</text>
            </view>
          </view>

          <view class="goods-price-section">
            <view class="price-container stock-type1 mr-10">
              <text class="price-label rest-weight">剩余</text>
              <text class="price-value1">{{goods.goodsStockWeightTotal}}{{goods.gbDgGoodsStandardname}}</text>
              <block wx:if="{{goods.goodsWasteTotal > 0}}">
                <text class="text-danger font-yuan">过期金额:¥{{goods.goodsWasteTotal}}</text>
              </block>
            </view>
            <view class="arrow-container {{goods.showStockList ? 'expanded' : 'collapsed'}}">
              <image src="/images/arrow-right-3.png" mode="aspectFill" class="arrow-icon" style="width: 24rpx; height: 24rpx;" />
            </view>
          </view>
        </view>

        <view class="purchase-row-content expandable-content {{goods.showStockList ? 'expanded' : ''}}" wx:for="{{goods.gbDepartmentGoodsStockSimpleEntities}}" wx:for-item="stock" wx:for-index="stockBatchIndex" >

          <view class="flex-row">
            <view class="purchase-section">
              <view class="flex-column-center">
                <view class="purchase-date">
                  <text>{{tool.getHowManyDays(stock.gbDgsDate)}}天库存</text>
                </view>
                <text class="font-sm">{{stock.gbDepartmentName}}</text>
                <block wx:if="{{stock.gbDgsWasteFullTime !== null && stock.gbDgsWasteFullTime !== ''}}">
                  <block wx:if="{{tool.getRestTime(stock.gbDgsWasteFullTime, nowTime) < 0}}">
                    <view class="waste-time-tag waste-time-tag--pending">
                      <text class="waste-time-tag__label">剩余</text>
                      <text class="waste-time-tag__value">{{tool.getWasteRemainHours(stock.gbDgsWasteFullTime, nowTime)}}小时</text>
                    </view>
                  </block>
                  <block wx:else>
                    <view class="waste-time-tag waste-time-tag--expired">
                      <text class="waste-time-tag__icon">!</text>
                      <text class="waste-time-tag__label">已废弃</text>
                      <text class="waste-time-tag__value">超{{tool.getRestTime(stock.gbDgsWasteFullTime, nowTime)}}小时</text>
                    </view>
                  </block>
                </block>
              </view>
            </view>

            <view class="purchase-info purchase-inbound">
              <view class="column-label purchase-price">单价</view>
              <view class="flex-column">
                <view class="amount-text">{{stock.gbDgsPrice}}元/{{stock.goodsStandardName}}</view>
                <block wx:if="{{stock.gbDgsNxSupplierId == -1}}">
                  <text class="weight-text">{{stock.purUserName}}</text>
                </block>
                <block wx:elif="{{stock.gbDgsNxSupplierId !== -1}}">
                  <text class="weight-text">{{stock.nxSupplierName}}</text>
                </block>
              </view>
            </view>

            <view class="comparison-divider"></view>

            <view class="purchase-info-column purchase-inbound">
              <view class="column-label">入库</view>
              <view class="flex-column">
                <text class="amount-text">{{stock.gbDgsSubtotal}}元</text>
                <text class="weight-text">{{stock.gbDgsWeight}}{{stock.goodsStandardName}}</text>
              </view>
            </view>

            <view class="comparison-divider"></view>

            <view class="purchase-info-column purchase-rest">
              <view class="column-label">剩余</view>
              <view class="flex-column">
                <text class="amount-text rest-amount">{{stock.gbDgsRestSubtotal}}元</text>
                <text class="weight-text rest-weight">{{stock.gbDgsRestWeight}}{{stock.goodsStandardName}}</text>
              </view>
            </view>
          </view>

        </view>

      </view>
    </view>
  </view>
</view>
