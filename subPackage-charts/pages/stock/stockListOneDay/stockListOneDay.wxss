page {
  background-color: #f5f5f5;
}

.stockList {
  display: none;
}

.stockList.is-active {
  display: block;
}

.stock_header {
  background-color: rgb(246, 251, 255);
}

.hidden_stock_header {
  color: rgb(246, 251, 255);
}

.stockColor {
  color: #187e6e;
}

.stock_dep {
  width: 30%;
  text-align: center;
}

.five_bottome_line {
  border-bottom: 8rpx solid #10554b;
}

.arrow-icon {
  transition: transform 0.3s ease-in-out;
  width: 30rpx;
  height: 30rpx;
}

.arrow-icon.expanded {
  transform: rotate(90deg);
}

.arrow-icon.collapsed {
  transform: rotate(0deg);
}

.expandable-content {
  overflow: hidden;
  transition: all 0.3s ease-in-out;
  opacity: 0;
  max-height: 0;
  transform: translateY(-10rpx);
}

.expandable-content.expanded {
  opacity: 1;
  max-height: 2000rpx;
  transform: translateY(0);
}

.expandable-content.collapsed {
  opacity: 0;
  max-height: 0;
  transform: translateY(-10rpx);
}
