<!-- 店内公告牌：人工公告 + 今日采购价格影响（按时间倒序） -->
<view class="page" style="padding-top: {{navBarHeight}}px;">

  <back-navbar title="店内公告" style="height: {{navBarHeight}}rpx;" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>


    <view class="section">
      <block wx:for="{{feedItems}}" wx:key="_key" wx:for-index="fi">
        <!-- 公告：工作笔记推送 → 与工作笔记列表一致 -->
        <view class="note-card wn-card {{item._isAi ? 'note-card--ai' : ''}}" wx:if="{{item._type === 'note' && item._useWorkNoteStyle}}">
          <view class="wn-card-header">
            <view class="wn-type-tag" wx:if="{{item.noteTypeLabel}}" style="background: {{item.noteTypeBg}}; color: {{item.noteTypeColor}};">
              <text class="wn-type-tag-text">{{item.noteTypeLabel}}</text>
            </view>
            <view class="wr-category-tag" wx:if="{{item.categoryName}}" style="background: {{item.categoryBg}}; color: {{item.categoryColor}};">
              <text class="wr-category-icon" wx:if="{{item.categoryIcon}}">{{item.categoryIcon}}</text>
              <text class="wr-category-name">{{item.categoryName}}</text>
            </view>
            <text class="wn-card-title" wx:if="{{item._showTitle}}">{{item.displayTitle}}</text>
          </view>

          <view class="wn-card-body" wx:if="{{item.textContent}}">
            <text class="wn-card-full-text">{{item.textContent}}</text>
          </view>

          <business-card-renderer
            wx:if="{{item._hasSourceCard}}"
            card-type="{{item._sourceCardType}}"
            payload="{{item._sourceCardPayload}}"
            title="{{item._sourceCardTitle}}"
            subtitle="{{item._sourceCardSubtitle}}"
            source-item-key="{{item._sourceItemKey}}"
            readonly="{{true}}"
            scene="announcement"
          />

          <block wx:if="{{item._hasOldCards}}">
            <view class="note-old-tip">
              <text class="note-old-tip-text">📋 此公告关联了以下卡片快照：</text>
            </view>
            <view class="note-old-cards">
              <block wx:for="{{item._oldCards}}" wx:key="cardKey" wx:for-item="oc">
                <view class="note-old-card">
                  <text class="note-old-card-title">▪ {{oc.title || oc.cardType}}</text>
                  <text class="note-old-card-sub">{{oc.subtitle || ''}}</text>
                </view>
              </block>
            </view>
          </block>

          <view class="wn-card-footer">
            <text class="wn-card-source">{{item.publisherName || '工作笔记'}}</text>
            <text class="wn-card-time">{{item.publishedAt}}</text>
          </view>
        </view>

        <!-- 公告：工作记录推送 → 与工作记录列表一致 -->
        <view class="note-card wr-card" wx:elif="{{item._type === 'note' && item._useWorkRecordStyle}}">
          <view class="wr-card-header">
            <text class="wr-card-title" wx:if="{{item._showTitle}}">{{item.displayTitle}}</text>
            <view class="wr-category-tag" style="background: {{item.categoryBg}}; color: {{item.categoryColor}};">
              <text class="wr-category-icon" wx:if="{{item.categoryIcon}}">{{item.categoryIcon}}</text>
              <text class="wr-category-name">{{item.categoryName || '未分类'}}</text>
            </view>
          </view>

          <view class="wr-card-body" wx:if="{{item.textContent}}">
            <text class="wr-polished-text">{{item.textContent}}</text>
          </view>

          <business-card-renderer
            wx:if="{{item._hasSourceCard}}"
            card-type="{{item._sourceCardType}}"
            payload="{{item._sourceCardPayload}}"
            title="{{item._sourceCardTitle}}"
            subtitle="{{item._sourceCardSubtitle}}"
            source-item-key="{{item._sourceItemKey}}"
            readonly="{{true}}"
            scene="announcement"
          />

          <block wx:if="{{item._hasOldCards}}">
            <view class="note-old-tip">
              <text class="note-old-tip-text">📋 此公告关联了以下卡片快照：</text>
            </view>
            <view class="note-old-cards">
              <block wx:for="{{item._oldCards}}" wx:key="cardKey" wx:for-item="oc">
                <view class="note-old-card">
                  <text class="note-old-card-title">▪ {{oc.title || oc.cardType}}</text>
                  <text class="note-old-card-sub">{{oc.subtitle || ''}}</text>
                </view>
              </block>
            </view>
          </block>

          <view class="wn-card-footer">
            <text class="wn-card-source">{{item.publisherName || '工作记录'}}</text>
            <text class="wn-card-time">{{item.publishedAt}}</text>
          </view>
        </view>

        <!-- 公告：其他来源（图钉、直接发布等） -->
        <view class="note-card {{item._isAi ? 'note-card--ai' : ''}}" wx:elif="{{item._type === 'note'}}">
          <view class="note-badge" wx:if="{{item._isAi}}">
            <text class="note-badge-icon">✨</text>
            <text class="note-badge-text">AI 智能消息</text>
          </view>
          <view class="note-badge note-badge--work" wx:elif="{{item.sourceType === 'WORK_NOTE'}}">
            <text class="note-badge-text">工作笔记</text>
          </view>
          <view class="note-badge note-badge--recipe" wx:elif="{{item._isRecipeReview}}">
            <text class="note-badge-text">配方提醒</text>
          </view>

          <text class="note-title">{{item.title}}</text>

          <view class="note-body" wx:if="{{item.textContent}}">
            <text class="note-text">{{item.textContent}}</text>
          </view>

          <business-card-renderer
            wx:if="{{item._hasSourceCard}}"
            card-type="{{item._sourceCardType}}"
            payload="{{item._sourceCardPayload}}"
            title="{{item._sourceCardTitle}}"
            subtitle="{{item._sourceCardSubtitle}}"
            source-item-key="{{item._sourceItemKey}}"
            readonly="{{true}}"
            scene="announcement"
          />

          <block wx:if="{{item._hasOldCards}}">
            <view class="note-old-tip">
              <text class="note-old-tip-text">📋 此公告关联了以下卡片快照：</text>
            </view>
            <view class="note-old-cards">
              <block wx:for="{{item._oldCards}}" wx:key="cardKey" wx:for-item="oc">
                <view class="note-old-card">
                  <text class="note-old-card-title">▪ {{oc.title || oc.cardType}}</text>
                  <text class="note-old-card-sub">{{oc.subtitle || ''}}</text>
                </view>
              </block>
            </view>
          </block>

          <view class="recipe-review-actions" wx:if="{{item._isRecipeReview && isManager}}">
            <button class="recipe-review-btn recipe-review-btn--minor"
              data-task-id="{{item._recipeReviewId}}"
              bindtap="onIgnoreRecipeReview">不需要加入配方</button>
            <button class="recipe-review-btn recipe-review-btn--primary"
              data-raw-goods-id="{{item._rawGoodsId}}"
              bindtap="onHandleRecipeReview">去调整配方</button>
          </view>

          <view class="note-footer">
            <text class="note-author">{{item.publisherName}}</text>
            <text class="note-time">{{item.publishedAt}}</text>
          </view>
        </view>

        <!-- 采购价格影响 -->
        <view wx:elif="{{item._type === 'purchase'}}">
          <view class="section-head">
            <view class="section-head-left">
              <view class="section-dot section-dot--price"></view>
              <text class="section-title">采购价格影响</text>
            </view>
          </view>

          <view class="price-card">
            <block wx:if="{{item._summaryOnly}}">
              <view class="price-summary-only">
                <view class="price-stat-row">
                  <view class="price-stat-box">
                    <text class="price-stat-num">{{item.priceChangedGoodsCount}}</text>
                    <text class="price-stat-lbl">发生价格波动商品</text>
                  </view>
                  <view class="price-stat-box">
                    <text class="price-stat-num">{{item.affectedDishCount}}</text>
                    <text class="price-stat-lbl">受影响菜品</text>
                  </view>
                </view>
                <text class="price-empty-note" wx:if="{{item.affectedDishCount === 0 && item.priceChangedGoodsCount > 0}}">暂无菜品超过影响阈值</text>
              </view>
            </block>

            <block wx:else>
              <view class="price-summary">
                <view class="price-stat-box">
                  <text class="price-stat-num">{{item.priceChangedGoodsCount}}</text>
                  <text class="price-stat-lbl">价格波动商品</text>
                </view>
                <view class="price-stat-box">
                  <text class="price-stat-num">{{item.affectedDishCount}}</text>
                  <text class="price-stat-lbl">受影响菜品</text>
                </view>
                <view class="price-stat-box" wx:if="{{item.highImpactDishCount > 0}}">
                  <text class="price-stat-num price-stat-num--danger">{{item.highImpactDishCount}}</text>
                  <text class="price-stat-lbl">高影响菜品</text>
                </view>
              </view>

              <block wx:if="{{item.hasGoodsRows}}">
                <text class="price-subtitle">商品单价波动</text>
                <view class="goods-row-list">
                  <block wx:for="{{item.goodsRows}}" wx:key="goodsName" wx:for-item="gr">
                    <view class="goods-row-item">
                      <view class="goods-row-top">
                        <text class="goods-row-name">{{gr.goodsName}}</text>
                        <text class="goods-row-delta {{gr.unitPriceDeltaRaw > 0 ? 'goods-row-delta--up' : 'goods-row-delta--down'}}">{{gr.unitPriceDelta}} / {{gr.unitPriceDeltaRate}}</text>
                      </view>
                      <view class="goods-row-bottom">
                        <text class="goods-row-price">当前 {{gr.currentUnitPrice}}元/{{gr.unit}}</text>
                        <text class="goods-row-old-price">上批 {{gr.previousUnitPrice}}元/{{gr.unit}}</text>
                      </view>
                      <view class="goods-row-footer" wx:if="{{gr.purchaserName || gr.purchaseDate}}">
                        <text class="goods-row-buyer">{{gr.purchaserName}}</text>
                        <text class="goods-row-date">{{gr.purchaseDate}}</text>
                      </view>
                    </view>
                  </block>
                </view>
              </block>

              <block wx:if="{{item.hasAffectedDishes}}">
                <text class="price-subtitle">受影响菜品</text>
                <view class="dish-list">
                  <block wx:for="{{item.affectedDishes}}" wx:key="dishName" wx:for-item="dish">
                    <view class="dish-item {{dish.highImpact ? 'dish-item--high' : ''}}">
                      <view class="dish-row">
                        <text class="dish-name">{{dish.dishName}}</text>
                        <text class="dish-tag" wx:if="{{dish.highImpact}}">高影响</text>
                      </view>
                      <view class="dish-row">
                        <text class="dish-info">售价 {{dish.dishPrice}}元</text>
                        <text class="dish-info">配方用量 {{dish.recipeAmountPerPortion}}{{dish.recipeAmountUnit}}/份</text>
                      </view>
                      <view class="dish-row">
                        <text class="dish-info">折合 {{dish.normalizedUsagePerPortion}}{{dish.normalizedUsageUnit}}</text>
                        <text class="dish-info">成本影响 {{dish.costImpactPerPortion}}</text>
                      </view>
                      <view class="dish-row">
                        <text class="dish-info dish-info--margin">毛利率影响 {{dish.grossMarginRateImpact}} 个百分点</text>
                        <text class="dish-info">阈值 {{dish.grossMarginFloatThreshold}} 个百分点</text>
                      </view>
                    </view>
                  </block>
                </view>
              </block>

              <block wx:if="{{item.hasRecipeDebug}}">
                <view class="debug-toggle" bindtap="onToggleRecipeDebug">
                  <text class="debug-toggle-text">{{showRecipeDebug ? '收起' : '展开'}}排除分析（{{item.recipeDebug.length}} 项）</text>
                  <text class="debug-toggle-arrow">{{showRecipeDebug ? '▲' : '▼'}}</text>
                </view>
                <view class="debug-list" wx:if="{{showRecipeDebug}}">
                  <block wx:for="{{item.recipeDebug}}" wx:key="dishName" wx:for-item="dbg">
                    <view class="debug-item">
                      <view class="debug-name-row">
                        <text class="debug-dish-name">{{dbg.dishName}}</text>
                        <text class="debug-reason">{{dbg.skippedReasonLabel}}</text>
                      </view>
                      <view class="debug-detail">
                        <text class="debug-detail-text">配方用量 {{dbg.recipeAmountPerPortion}}{{dbg.recipeAmountUnit}} → 折合 {{dbg.normalizedUsagePerPortion}}{{dbg.normalizedUsageUnit}}</text>
                      </view>
                      <view class="debug-detail">
                        <text class="debug-detail-text">成本影响 {{dbg.costImpactPerPortion}}</text>
                        <text class="debug-detail-text">毛利率影响 {{dbg.grossMarginRateImpact}} 个百分点</text>
                        <text class="debug-detail-text" wx:if="{{dbg.thresholdRate}}">阈值 {{dbg.thresholdRate}} 个百分点</text>
                      </view>
                    </view>
                  </block>
                </view>
              </block>
            </block>

            <view class="purchase-foot">
              <text class="purchase-foot-label">系统</text>
              <text class="purchase-foot-time">{{item.timeLabel}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view class="feed-bottom"></view>

</view>
