/* ========== 页面级 ========== */
.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: env(safe-area-inset-bottom);
  color: #1a1a1a;
  font-size: 28rpx;
}


/* ========== 导航栏 ========== */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  background: #fff;
  box-sizing: border-box;
}
.navbar-back {
  display: flex;
  align-items: center;
  color: #3b82f6;
  font-size: 28rpx;
}
.navbar-back-icon {
  font-size: 44rpx;
  font-weight: 300;
  margin-right: 4rpx;
  line-height: 1;
}
.navbar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.navbar-placeholder {
  width: 120rpx;
}

/* ========== 顶部标题区 ========== */
.header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 32rpx 30rpx 20rpx 30rpx;
  background: #fff;
}
.header-scope {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.header-sub {
  font-size: 24rpx;
  color: #888;
}
.header--empty {
  padding-bottom: 8rpx;
}

/* ========== 摘要统计栏 ========== */
.summary-bar {
  display: flex;
  align-items: center;
  margin: 0 30rpx 8rpx 30rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #f0f5ff 0%, #eef2ff 100%);
  border-radius: 16rpx;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #3b82f6;
  line-height: 1.1;
}
.stat-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}
.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #d1d5ff;
}

/* ========== 区块通用 ========== */
.section {
  margin: 24rpx 20rpx;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}
.section-head-left {
  display: flex;
  align-items: center;
}
.section-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.section-dot--note { background: #f59e0b; }
.section-dot--price { background: #8b5cf6; }

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

/* ========== 公告卡片 ========== */
.note-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 8rpx rgba(0,0,0,0.04);
}
.note-card--ai {
  border-left: 6rpx solid #f59e0b;
}

.note-badge {
  display: inline-flex;
  align-items: center;
  background: #fef3c7;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}
.note-badge--work {
  background: #e0f2fe;
}
.note-badge-icon {
  font-size: 22rpx;
  margin-right: 6rpx;
}
.note-badge-text {
  font-size: 22rpx;
  color: #92400e;
  font-weight: 500;
}
.note-badge--work .note-badge-text {
  color: #0369a1;
}

.note-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  line-height: 1.4;
}
.note-body {
  margin-bottom: 12rpx;
}
.note-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.65;
}

.note-old-tip {
  margin: 12rpx 0 8rpx;
}
.note-old-tip-text {
  font-size: 24rpx;
  color: #888;
}
.note-old-cards {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}
.note-old-card {
  padding: 8rpx 0;
}
.note-old-card-title {
  display: block;
  font-size: 26rpx;
  color: #333;
}
.note-old-card-sub {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 2rpx;
}

.note-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.note-author {
  font-size: 24rpx;
  color: #888;
}
.note-time {
  font-size: 24rpx;
  color: #aaa;
}

/* ========== 工作笔记卡片（与 workNoteList 一致） ========== */
.note-card.wn-card {
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04), 0 1rpx 4rpx rgba(0, 0, 0, 0.02);
}

.wn-card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.wn-type-tag {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
}

.wn-card-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

.wn-card-body {
  margin-top: 16rpx;
}

.wn-card-full-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  word-break: break-word;
}

.wn-card-footer {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.wn-card-source {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}

.wn-card-time {
  font-size: 24rpx;
  color: #bbb;
  line-height: 1.4;
}

/* ========== 工作记录分类标签（与 workRecord 一致） ========== */
.wr-card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.wr-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
}

.wr-category-tag {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
}

.wr-category-icon {
  margin-right: 6rpx;
  font-size: 24rpx;
}

.wr-card-body {
  margin-top: 16rpx;
}

.wr-polished-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  word-break: break-word;
}

.note-card.wr-card {
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04), 0 1rpx 4rpx rgba(0, 0, 0, 0.02);
}

/* ========== 采购价格影响卡 ========== */
.price-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 8rpx rgba(0,0,0,0.04);
}

.price-summary,
.price-stat-row {
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  padding-bottom: 20rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.price-summary-only .price-stat-row {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.price-stat-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.price-stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #8b5cf6;
  line-height: 1.1;
}
.price-stat-num--danger {
  color: #ef4444;
}
.price-stat-lbl {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 6rpx;
  text-align: center;
}

.price-empty-note {
  display: block;
  font-size: 24rpx;
  color: #888;
  text-align: center;
  padding: 12rpx 0 4rpx;
}

.price-subtitle {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  margin: 16rpx 0 12rpx;
}

.goods-row-list {
  margin-bottom: 8rpx;
}
.goods-row-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.goods-row-item:last-child {
  border-bottom: none;
}
.goods-row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.goods-row-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
}
.goods-row-delta {
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.goods-row-delta--up { color: #ef4444; }
.goods-row-delta--down { color: #16a34a; }

.goods-row-bottom {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}
.goods-row-price,
.goods-row-old-price {
  font-size: 24rpx;
  color: #888;
}
.goods-row-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 6rpx;
}
.goods-row-buyer,
.goods-row-date {
  font-size: 22rpx;
  color: #aaa;
}

.dish-list {
  margin-top: 4rpx;
}
.dish-item {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}
.dish-item--high {
  background: #fef2f2;
  border: 1rpx solid #fecaca;
}
.dish-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
  margin-bottom: 6rpx;
}
.dish-row:last-child {
  margin-bottom: 0;
}
.dish-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.dish-tag {
  font-size: 20rpx;
  color: #ef4444;
  background: #fee2e2;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.dish-info {
  font-size: 24rpx;
  color: #666;
}
.dish-info--margin {
  color: #8b5cf6;
}

.debug-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0 4rpx;
  margin-top: 8rpx;
  border-top: 1rpx dashed #e5e7eb;
}
.debug-toggle-text {
  font-size: 24rpx;
  color: #6b7280;
}
.debug-toggle-arrow {
  font-size: 20rpx;
  color: #9ca3af;
}
.debug-list {
  margin-top: 12rpx;
}
.debug-item {
  background: #f9fafb;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 10rpx;
}
.debug-name-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.debug-dish-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}
.debug-reason {
  font-size: 22rpx;
  color: #f59e0b;
  flex-shrink: 0;
}
.debug-detail {
  margin-top: 4rpx;
}
.debug-detail-text {
  display: block;
  font-size: 22rpx;
  color: #888;
  line-height: 1.6;
}

.purchase-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.purchase-foot-label {
  font-size: 24rpx;
  color: #888;
}
.purchase-foot-time {
  font-size: 24rpx;
  color: #aaa;
}

/* ========== 空状态 ========== */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}
.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}
.empty-retry {
  margin-top: 32rpx;
  padding: 12rpx 40rpx;
  border: 1rpx solid #3b82f6;
  border-radius: 32rpx;
  color: #3b82f6;
  font-size: 26rpx;
}

.feed-bottom {
  height: 60rpx;
}
