/* ========== 页面根容器 ========== */
.wr-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #faf8f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

/* 浅色聊天纹理背景 */
.wr-page::before {
  content: '';
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
  background-image:
    radial-gradient(circle at 1px 1px, rgba(0,0,0,0.03) 1px, transparent 0);
  background-size: 20px 20px;
}

/* ========== 分类筛选栏 ========== */
.wr-category-bar {
  position: relative;
  z-index: 10;
  background: #ffffff;
  border-bottom: 1rpx solid #f0ece6;
  padding: 30rpx 30rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.wr-category-list {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.wr-category-filter {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.wr-category-filter-icon {
  margin-right: 8rpx;
  font-size: 26rpx;
}

.wr-category-filter--active {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* ========== 主滚动区 ========== */
.wr-scroll {
  position: relative;
  z-index: 5;
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
}

/* ========== 空状态 ========== */
.wr-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
  box-sizing: border-box;
}

.wr-empty-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.6;
}

.wr-empty-text {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: #5f5f5f;
}

.wr-empty-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #999999;
}

/* ========== 日期分组 ========== */
.wr-date-group {
  padding: 24rpx 24rpx 8rpx;
  box-sizing: border-box;
}

.wr-date-badge {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.wr-date-badge-text {
  display: inline-block;
  padding: 10rpx 28rpx;
  background: rgba(0, 0, 0, 0.06);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #888888;
  line-height: 1.4;
}

.wr-card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ========== 记录卡片 ========== */
.wr-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04), 0 1rpx 4rpx rgba(0, 0, 0, 0.02);
  box-sizing: border-box;
  position: relative;
}

/* 分类标签 + 列表抬头 */
.wr-card-header {
  margin-bottom: 16rpx;
}

.wr-card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.wr-category-tag {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
}

.wr-category-icon {
  margin-right: 10rpx;
  font-size: 28rpx;
}

/* 卡片正文 */
.wr-card-body {
  margin-bottom: 16rpx;
}

.wr-polished-text {
  font-size: 32rpx;
  font-weight: 400;
  color: #1a1a1a;
  line-height: 1.65;
  word-break: break-word;
}

/* 原话展开/收起 */
.wr-raw-toggle {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 0;
  margin-bottom: 8rpx;
  box-sizing: border-box;
}

.wr-raw-toggle-text {
  font-size: 26rpx;
  color: #999999;
  line-height: 1.4;
}

.wr-raw-toggle-arrow {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #bbbbbb;
  line-height: 1;
}

/* 展开后的原话 */
.wr-raw-content {
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.wr-raw-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  word-break: break-word;
}

/* 卡片底部 */
.wr-card-footer {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

/* 「查看来源」入口 */
.wr-source-btn {
  padding: 10rpx 24rpx;
  background: rgba(7, 193, 96, 0.06);
  border: 1rpx solid rgba(7, 193, 96, 0.25);
  border-radius: 12rpx;
}

.wr-source-text {
  font-size: 24rpx;
  color: #07c160;
  line-height: 1.4;
}

/* 列表内来源业务卡区块 */
.wr-source-card-section {
  margin: 16rpx 0 20rpx;
  padding: 16rpx;
  background: #fafafa;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
}

.wr-source-card-section-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.wr-source-card-section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.wr-source-card-section-type {
  font-size: 22rpx;
  color: #999;
}

.wr-source-card-preview {
  overflow: hidden;
  border-radius: 8rpx;
}

.wr-status-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.wr-status-label {
  font-size: 24rpx;
  line-height: 1.4;
}

.wr-status--success {
  color: #07c160;
}

.wr-status--failed {
  color: #fa5151;
}

.wr-status--pending {
  color: #ff9900;
}

.wr-card-time {
  font-size: 24rpx;
  color: #bbbbbb;
  line-height: 1.4;
}

/* 重新整理按钮 */
.wr-retry-btn {
  padding: 10rpx 24rpx;
  background: rgba(250, 81, 81, 0.08);
  border: 1rpx solid rgba(250, 81, 81, 0.2);
  border-radius: 12rpx;
}

.wr-retry-text {
  font-size: 24rpx;
  color: #fa5151;
  line-height: 1.4;
}

/* ========== 加载更多 ========== */
.wr-loadmore {
  display: flex;
  justify-content: center;
  padding: 32rpx 0 48rpx;
}

.wr-loadmore-text {
  font-size: 26rpx;
  color: #bbbbbb;
}

.wr-scroll-spacer {
  height: 180rpx;
}

/* ========== 底部输入栏 ========== */
.wr-composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #ffffff;
  border-top: 1rpx solid #f0ece6;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

.wr-composer-inner {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 16rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

.wr-input {
  flex: 1;
  min-height: 48rpx;
  max-height: 160rpx;
  font-size: 32rpx;
  color: #1a1a1a;
  line-height: 1.5;
  padding: 4rpx 8rpx;
  box-sizing: border-box;
}

.wr-input-placeholder {
  font-size: 30rpx;
  color: #bbbbbb;
}

.wr-submit-btn {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  background: #d9d9d9;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.wr-submit-btn--active {
  background: #07c160;
}

.wr-submit-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #ffffff;
  line-height: 1;
}

/* ========== 来源卡片内联展开 ========== */

.wr-source-inline {
  margin-top: 20rpx;
  border-top: 1rpx solid #f0ece6;
  padding-top: 20rpx;
}

.wr-source-inline-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 16rpx;
  font-size: 26rpx;
  color: #999;
}

.wr-source-inline-error {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 16rpx;
  font-size: 26rpx;
  color: #999;
}

.wr-source-inline-unknown {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 16rpx;
  font-size: 26rpx;
  color: #999;
}

.wr-source-inline-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.wr-source-inline-title {
  font-size: 26rpx;
  color: #999;
  line-height: 1.4;
}

.wr-source-inline-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
}

.wr-source-inline-close-icon {
  font-size: 28rpx;
  color: #999;
  line-height: 1;
}

/* ========== 修改 / 删除 操作按钮 ========== */

.wr-card-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-left: 0;
}

.wr-action-btn {
  padding: 14rpx 36rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wr-action-btn--edit {
  background: rgba(7, 193, 96, 0.06);
  border: 1rpx solid rgba(7, 193, 96, 0.25);
}

.wr-action-btn--delete {
  background: rgba(250, 81, 81, 0.06);
  border: 1rpx solid rgba(250, 81, 81, 0.25);
}

.wr-action-btn-text {
  font-size: 24rpx;
  line-height: 1.4;
}

.wr-action-btn--edit .wr-action-btn-text {
  color: #07c160;
}

.wr-action-btn--delete .wr-action-btn-text {
  color: #fa5151;
}

.wr-action-btn--announce {
  background: rgba(46, 125, 50, 0.06);
  border: 1rpx solid rgba(46, 125, 50, 0.25);
}

.wr-action-btn--announce .wr-action-btn-text {
  color: #2e7d32;
}

/* ========== 修改弹窗 ========== */

.wr-edit-popup-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 900;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.wr-edit-popup-mask--show {
  opacity: 1;
  pointer-events: auto;
}

.wr-edit-popup {
  position: fixed;
  left: 50%;
  top: 50%;
  width: 630rpx;
  background: #fff;
  border-radius: 20rpx;
  z-index: 901;
  transform: translate(-50%, -50%) scale(0.9);
  opacity: 0;
  pointer-events: none;
  transition: transform 0.25s ease, opacity 0.25s ease;
  display: flex;
  flex-direction: column;
  max-height: 70vh;
}

.wr-edit-popup--show {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
  pointer-events: auto;
}

.wr-edit-popup-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 16rpx;
  flex-shrink: 0;
}

.wr-edit-popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f1f1f;
}

.wr-edit-popup-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
}

.wr-edit-popup-close-icon {
  font-size: 28rpx;
  color: #999;
  line-height: 1;
}

.wr-edit-popup-body {
  flex: 1;
  padding: 0 28rpx 20rpx;
  overflow-y: auto;
}

.wr-edit-popup-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 20rpx 24rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  box-sizing: border-box;
}

.wr-edit-popup-footer {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 16rpx 28rpx;
  flex-shrink: 0;
}

.wr-edit-popup-cancel {
  padding: 14rpx 48rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.4;
}

.wr-edit-popup-save {
  padding: 14rpx 48rpx;
  background: #07c160;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #fff;
  line-height: 1.4;
}


