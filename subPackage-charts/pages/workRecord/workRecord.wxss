/* ========== 页面根容器 ========== */
.wr-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #faf8f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

/* 浅色聊天纹理背景 */
.wr-page::before {
  content: '';
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
  background-image:
    radial-gradient(circle at 1px 1px, rgba(0,0,0,0.03) 1px, transparent 0);
  background-size: 20px 20px;
}

/* ========== 分类筛选栏 ========== */
.wr-category-bar {
  position: relative;
  z-index: 10;
  background: #ffffff;
  border-bottom: 1rpx solid #f0ece6;
  padding: 20rpx 24rpx 16rpx;
  box-sizing: border-box;
}

.wr-category-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wr-add-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #edf8f1;
  color: #07864d;
}

.wr-add-btn-icon {
  font-size: 46rpx;
  font-weight: 400;
  line-height: 1;
}

/* 折叠按钮（默认显示的「全部记录」入口） */
.wr-category-toggle {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #f4f1ec;
  color: #5f5f5f;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.4;
}

.wr-category-toggle-icon {
  margin-right: 10rpx;
  font-size: 30rpx;
}

.wr-category-toggle-label {
  flex: 1;
}

.wr-category-toggle-arrow {
  margin-left: 8rpx;
  font-size: 28rpx;
  color: #999999;
}

.wr-category-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.wr-category-filter {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.4;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.wr-category-filter-icon {
  margin-right: 8rpx;
  font-size: 36rpx;
}

.wr-category-filter-img {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.wr-category-filter--active {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* ========== 主滚动区 ========== */
.wr-scroll {
  position: relative;
  z-index: 5;
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
}

/* ========== 空状态 ========== */
.wr-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
  box-sizing: border-box;
}

.wr-empty-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.6;
}

.wr-empty-text {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: #5f5f5f;
}

.wr-empty-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #999999;
}

/* ========== 日期分组 ========== */
.wr-date-group {
  padding: 24rpx 24rpx 8rpx;
  box-sizing: border-box;
}

.wr-date-badge {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.wr-date-badge-text {
  display: inline-block;
  padding: 10rpx 28rpx;
  background: rgba(0, 0, 0, 0.06);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #888888;
  line-height: 1.4;
}

.wr-card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ========== 记录卡片 ========== */
.wr-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04), 0 1rpx 4rpx rgba(0, 0, 0, 0.02);
  box-sizing: border-box;
  position: relative;
}

.wr-card--menu-open {
  z-index: 40;
}

/* 列表抬头：标题 + 时间 +「…」菜单 */
.wr-card-header {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.wr-card-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  margin-right: 16rpx;
  word-break: break-all;
}

.wr-card-header-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.wr-announcement-badge {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  margin-right: 8rpx;
  margin-top: 2rpx;
}

.wr-announcement-icon {
  font-size: 30rpx;
  line-height: 1;
}

.wr-more-btn {
  margin-left: 12rpx;
  padding: 6rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wr-more-btn-icon {
  font-size: 40rpx;
  line-height: 1;
  color: #999999;
  letter-spacing: 2rpx;
}

.wr-category-tag {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
}

.wr-record-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.wr-record-tags--below {
  margin-top: 16rpx;
}

.wr-category-icon {
  margin-right: 8rpx;
  font-size: 26rpx;
}

.wr-category-img {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

/* 卡片正文 */
.wr-card-body {
  margin-bottom: 16rpx;
}

.wr-polished-text {
  font-size: 32rpx;
  font-weight: 400;
  color: #1a1a1a;
  line-height: 1.65;
  word-break: break-word;
}

/* 展开后的原话 */
.wr-raw-content {
  position: relative;
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.wr-raw-close {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.wr-raw-close-icon {
  font-size: 26rpx;
  color: #999999;
  line-height: 1;
}

.wr-raw-text {
  display: block;
  padding-right: 40rpx;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  word-break: break-word;
}

/* 卡片底部 */
.wr-card-footer {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

/* 「查看来源」入口 */
.wr-source-btn {
  padding: 10rpx 24rpx;
  background: rgba(7, 193, 96, 0.06);
  border: 1rpx solid rgba(7, 193, 96, 0.25);
  border-radius: 12rpx;
}

.wr-source-text {
  font-size: 24rpx;
  color: #07c160;
  line-height: 1.4;
}

/* 列表内来源业务卡区块 */
.wr-source-card-section {
  margin: 16rpx 0 20rpx;
  padding: 16rpx;
  background: #fafafa;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
}

.wr-source-card-section-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.wr-source-card-section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.wr-source-card-section-type {
  font-size: 22rpx;
  color: #999;
}

.wr-source-card-preview {
  overflow: hidden;
  border-radius: 8rpx;
}

.wr-status-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.wr-status-label {
  font-size: 24rpx;
  line-height: 1.4;
}

.wr-status--success {
  color: #07c160;
}

.wr-status--failed {
  color: #fa5151;
}

.wr-status--pending {
  color: #ff9900;
}

.wr-card-time {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #bbbbbb;
  line-height: 1.4;
}

/* 重新整理按钮 */
.wr-retry-btn {
  padding: 10rpx 24rpx;
  background: rgba(250, 81, 81, 0.08);
  border: 1rpx solid rgba(250, 81, 81, 0.2);
  border-radius: 12rpx;
}

.wr-retry-text {
  font-size: 24rpx;
  color: #fa5151;
  line-height: 1.4;
}

/* ========== 加载更多 ========== */
.wr-loadmore {
  display: flex;
  justify-content: center;
  padding: 32rpx 0 48rpx;
}

.wr-loadmore-text {
  font-size: 26rpx;
  color: #bbbbbb;
}

.wr-scroll-spacer {
  height: 48rpx;
}

/* ========== 来源卡片内联展开 ========== */

.wr-source-inline {
  margin-top: 20rpx;
  border-top: 1rpx solid #f0ece6;
  padding-top: 20rpx;
}

.wr-source-inline-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 16rpx;
  font-size: 26rpx;
  color: #999;
}

.wr-source-inline-error {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 16rpx;
  font-size: 26rpx;
  color: #999;
}

.wr-source-inline-unknown {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 16rpx;
  font-size: 26rpx;
  color: #999;
}

.wr-source-inline-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.wr-source-inline-title {
  font-size: 26rpx;
  color: #999;
  line-height: 1.4;
}

.wr-source-inline-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
}

.wr-source-inline-close-icon {
  font-size: 28rpx;
  color: #999;
  line-height: 1;
}

/* ========== 修改 / 删除 操作按钮 ========== */

/* 「…」下拉菜单 */
.wr-menu-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: transparent;
}

.wr-menu {
  position: absolute;
  top: 64rpx;
  right: 20rpx;
  z-index: 30;
  min-width: 220rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.14), 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.wr-menu-item {
  padding: 26rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.wr-menu-item + .wr-menu-item {
  border-top: 1rpx solid #f0f0f0;
}

.wr-menu-item:active {
  background: #f7f7f7;
}

.wr-menu-item-text {
  font-size: 28rpx;
  line-height: 1.4;
  color: #333333;
}

.wr-menu-item--danger .wr-menu-item-text {
  color: #fa5151;
}

/* ========== 修改弹窗 ========== */

.wr-edit-popup-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 900;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.wr-edit-popup-mask--show {
  opacity: 1;
  pointer-events: auto;
}

.wr-edit-popup {
  position: fixed;
  left: 50%;
  top: 50%;
  width: 630rpx;
  background: #fff;
  border-radius: 20rpx;
  z-index: 901;
  transform: translate(-50%, -50%) scale(0.9);
  opacity: 0;
  pointer-events: none;
  transition: transform 0.25s ease, opacity 0.25s ease;
  display: flex;
  flex-direction: column;
  max-height: 70vh;
}

.wr-edit-popup--show {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
  pointer-events: auto;
}

.wr-edit-popup-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 16rpx;
  flex-shrink: 0;
}

.wr-edit-popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f1f1f;
}

.wr-edit-popup-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
}

.wr-edit-popup-close-icon {
  font-size: 28rpx;
  color: #999;
  line-height: 1;
}

.wr-edit-popup-body {
  flex: 1;
  padding: 0 28rpx 20rpx;
  overflow-y: auto;
}

.wr-edit-popup-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 20rpx 24rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  box-sizing: border-box;
}

.wr-edit-popup-footer {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 16rpx 28rpx;
  flex-shrink: 0;
}

.wr-edit-popup-cancel {
  padding: 14rpx 48rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.4;
}

.wr-edit-popup-save {
  padding: 14rpx 48rpx;
  background: #07c160;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #fff;
  line-height: 1.4;
}
