<view class="confirm-page">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="添加工作记录" avatar="/images/back-gray.png" button-text="取消" bindnavbuttontap="toBack"></back-navbar>

  <scroll-view scroll-y class="confirm-scroll">
    <view class="confirm-intro">
      <text class="confirm-intro-title">{{records.length > 0 ? 'AI 已完成整理' : 'AI 识别工作记录'}}</text>
      <text class="confirm-intro-sub">{{records.length > 0 ? 'AI 已按独立事项拆分。请逐条检查，确认后将分别写入工作记录。' : '输入或粘贴店长原话，AI 将整理标题、正文并推荐业务标签。'}}</text>
    </view>

    <view class="recognition-composer">
      <textarea
        class="recognition-input"
        placeholder="记录今天发现的问题、想法或需要跟进的事项…"
        placeholder-class="recognition-input-placeholder"
        value="{{inputValue}}"
        maxlength="500"
        auto-height="{{true}}"
        fixed="{{true}}"
        show-confirm-bar="{{false}}"
        cursor-spacing="16"
        adjust-position="{{true}}"
        bindinput="onInputChange"
        bindconfirm="onSubmit"
        confirm-type="send"
        disabled="{{submitting}}"
      />
      <view class="recognition-submit {{canSubmit && !submitting ? 'recognition-submit--active' : ''}}" catchtap="onSubmit">
        <text class="recognition-submit-text">记录</text>
      </view>
    </view>

    <view class="confirm-loading" wx:if="{{loading}}">正在读取整理结果…</view>
    <block wx:else>
      <view class="record-count" wx:if="{{records.length > 1}}">共整理出 {{records.length}} 条独立记录</view>
      <view class="confirm-card" wx:for="{{records}}" wx:for-item="record" wx:for-index="recordIndex" wx:key="recordId">
        <view class="record-order" wx:if="{{records.length > 1}}">第 {{recordIndex + 1}} 条</view>
        <text class="field-label">标题</text>
        <input class="title-input" value="{{record.title}}" maxlength="100" data-index="{{recordIndex}}" bindinput="onTitleInput" />

        <text class="field-label field-label--spaced">标签</text>
        <view class="tag-grid">
          <view class="tag-option {{item.selected ? 'tag-option--selected' : ''}}" wx:for="{{record.tagOptions}}" wx:key="id" data-record-index="{{recordIndex}}" data-id="{{item.id}}" bindtap="onToggleTag">
            <text>{{item.name}}</text>
            <text class="tag-check" wx:if="{{item.selected}}">✓</text>
          </view>
        </view>

        <text class="field-label field-label--spaced">记录内容</text>
        <textarea class="content-input" value="{{record.content}}" maxlength="3000" auto-height show-confirm-bar="{{false}}" data-index="{{recordIndex}}" bindinput="onContentInput"></textarea>
      </view>
      <view class="trace-note">原始输入已由系统保留用于追溯，不会替代上方正式记录正文。</view>
      <view class="bottom-spacer"></view>
    </block>
  </scroll-view>

  <view class="confirm-footer" wx:if="{{!loading && records.length > 0}}">
    <button class="confirm-button" loading="{{saving}}" disabled="{{saving}}" bindtap="onConfirm">确认保存</button>
  </view>
</view>
