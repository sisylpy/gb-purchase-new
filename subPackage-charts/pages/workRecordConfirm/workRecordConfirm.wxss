.confirm-page{height:100vh;display:flex;flex-direction:column;background:#f6f7f5;color:#17211c;box-sizing:border-box}.confirm-scroll{flex:1;min-height:0}.confirm-intro{margin:24rpx 24rpx 0;padding:28rpx;border-radius:24rpx;background:linear-gradient(135deg,#e8f8ef,#f7fbf8);display:flex;flex-direction:column}.confirm-intro-title{font-size:34rpx;font-weight:700;color:#087846}.confirm-intro-sub{margin-top:10rpx;font-size:25rpx;line-height:1.55;color:#557065}.confirm-loading{padding:120rpx 30rpx;text-align:center;color:#87938d;font-size:27rpx}.record-count{margin:22rpx 28rpx 0;font-size:26rpx;font-weight:650;color:#247b55}.confirm-card{margin:20rpx 24rpx;padding:30rpx 26rpx;background:#fff;border-radius:24rpx;box-shadow:0 5rpx 22rpx rgba(31,65,49,.06)}.record-order{display:inline-flex;margin-bottom:20rpx;padding:7rpx 15rpx;border-radius:999rpx;background:#e6f7ed;color:#07814b;font-size:23rpx;font-weight:700}.field-label{display:block;font-size:25rpx;font-weight:650;color:#526159;margin-bottom:13rpx}.field-label--spaced{margin-top:30rpx}.title-input{height:78rpx;padding:0 20rpx;border-radius:16rpx;background:#f5f7f5;font-size:31rpx;font-weight:650;box-sizing:border-box}.tag-grid{display:flex;flex-wrap:wrap;gap:12rpx}.tag-option{display:flex;align-items:center;gap:8rpx;padding:12rpx 20rpx;border-radius:999rpx;background:#f2f4f2;color:#54625b;font-size:25rpx;border:2rpx solid transparent}.tag-option--selected{background:#e5f7ed;color:#07814b;border-color:#36b77d}.tag-check{font-weight:800}.content-input{width:100%;min-height:220rpx;padding:20rpx;border-radius:16rpx;background:#f5f7f5;font-size:29rpx;line-height:1.65;box-sizing:border-box}.trace-note{margin:0 34rpx;font-size:23rpx;line-height:1.55;color:#929b96}.bottom-spacer{height:160rpx}.confirm-footer{padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e8ece9}.confirm-button{height:88rpx;line-height:88rpx;border-radius:18rpx;background:#09a864;color:#fff;font-size:31rpx;font-weight:700}.confirm-button::after{border:0}
