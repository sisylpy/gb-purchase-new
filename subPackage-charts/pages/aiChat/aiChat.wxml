
<!-- Gemini 风格：自定义顶栏 + 主内容 + 底部输入面板 -->
<view class="gem-page" style="height: {{windowHeight}}px;">
  <!-- 顶栏 -->
  <view class="gem-nav" style="padding-top: {{statusBarHeight + 20}}px;">
   

<back-navbar style="height: {{navBarHeight}}rpx;" title="{{pageTitle || 'AI助手'}}" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>
     
  </view>

  <!-- Debug 切换按钮 -->
  <view class="gem-debug-toggle" catchtap="toggleDebugJson">
    <text class="gem-debug-toggle-text">🐞 {{showDebugJson ? 'ON' : 'OFF'}}</text>
  </view>

  <!-- 主区域 -->
  <scroll-view
    scroll-y="{{true}}"
    class="gem-scroll"
    scroll-into-view="{{scrollToView}}"
    scroll-with-animation="{{true}}"
    show-scrollbar="{{false}}"
  >
    <!-- 连接中 -->
    <view class="gem-loading" wx:if="{{isLoading}}">
      <text class="gem-loading-text">正在连接…</text>
    </view>

    <!-- 空会话：问候 + 推荐主题（Gemini 首页） -->
    <block wx:if="{{!isLoading && messages.length === 0}}">
      <view class="gem-home">
        <view class="gem-hero-banner">
          <view class="gem-hero-deco gem-hero-deco-ring"></view>
          <view class="gem-hero-deco gem-hero-deco-star gem-hero-deco-star-1">✦</view>
          <view class="gem-hero-deco gem-hero-deco-star gem-hero-deco-star-2">✦</view>
          <view class="gem-hero-inner">
            <view class="gem-hero-avatar-wrap">
              <image class="gem-hero-avatar" src="{{url + 'uploadImage/imPurchase/300jj.png'}}" mode="aspectFit"></image>
            </view>
            <view class="gem-hero-text">
              <text class="gem-hero-title">{{heroTitle}}</text>
              <text class="gem-hero-sub">{{heroSubtitle}}</text>
            </view>
          </view>
        </view>
        <view class="gem-subtitle" wx:if="{{topicPageSubtitle}}">{{topicPageSubtitle}}</view>
        <view class="gem-pill-list">
          <view class="gem-topic-block" wx:for="{{topics}}" wx:for-item="topic" wx:key="id">
            <view
              class="gem-pill {{expandedTopicId === topic.id ? 'gem-pill-open' : ''}}"
              hover-class="gem-pill-hover"
              catchtap="onTopicHeaderTap"
              data-id="{{topic.id}}"
            >
              <text class="gem-pill-emoji">{{topic.emoji}}</text>
              <view class="gem-pill-body">
                <text class="gem-pill-title">{{topic.title}}</text>
                <!-- <text class="gem-pill-desc" wx:if="{{topic.description}}">{{topic.description}}</text> -->
              </view>
              <text class="gem-pill-chevron">{{expandedTopicId === topic.id ? '⌃' : '⌄'}}</text>
            </view>
            <view class="gem-sublist" wx:if="{{expandedTopicId === topic.id}}">
              <view wx:if="{{topic.questions.length}}" class="gem-sublist-chips">
                <view
                  class="gem-chip {{!q.clickable ? 'gem-chip--disabled' : 'gem-chip--active'}}"
                  wx:for="{{topic.questions}}"
                  wx:for-item="q"
                  wx:key="id"
                  hover-class="{{q.clickable ? 'gem-chip-hover' : ''}}"
                  catchtap="onQuestionTap"
                  data-text="{{q.text}}"
                  data-clickable="{{q.clickable}}"
                >
                  <text class="gem-chip-text">{{q.text}}</text>
                  <text class="gem-chip-tag" wx:if="{{!q.clickable}}">即将支持</text>
                </view>
              </view>
              <view wx:else class="gem-sublist-empty">暂无具体问题</view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- 有消息：对话流 -->
    <block wx:if="{{!isLoading && messages.length > 0}}">
      <view class="gem-chat-inner">
        <block wx:for="{{messages}}" wx:key="id">
          <view class="gem-msg-row gem-msg-user" id="msg-{{index}}" wx:if="{{item.role === 'user'}}">
            <view class="gem-bubble gem-bubble-user">{{item.content}}</view>
          </view>
          <view class="gem-msg-row gem-msg-ai flex-column" id="msg-{{index}}" wx:if="{{item.role === 'assistant'}}">
            <view class="gem-bubble gem-bubble-ai">
              <!-- SSE 阶段滚动列表（替代原来的三个小点） -->
              <scroll-view
                wx:if="{{item.isLoading && streamingStages.length > 0}}"
                scroll-y="{{true}}"
                class="gem-stage-scroll"
                scroll-into-view="stage-{{streamingStages.length - 1}}"
                scroll-with-animation="{{true}}"
              >
                <block wx:for="{{streamingStages}}" wx:key="index">
                  <text id="stage-{{index}}" class="gem-stage-item">{{item}}</text>
                </block>
              </scroll-view>
              <!-- AI 正文：无卡片 / 无 answerPreview 时才显示（避免与下方卡片摘要重复） -->
              <view wx:if="{{item.richNodes && !item.answerPreview && (!item.cards || item.cards.length === 0)}}" class="gem-ai-stream-row">
                <rich-text class="gem-rich-md gem-rich-md--flex" nodes="{{item.richNodes}}" />
                <view class="gem-stream-cursor" wx:if="{{item.isLoading}}"></view>
              </view>
              <view wx:elif="{{item.content && !item.answerPreview && (!item.cards || item.cards.length === 0)}}" class="gem-ai-stream-row">
                <text class="gem-bubble-text">{{item.content}}</text>
                <view class="gem-stream-cursor" wx:if="{{item.isLoading}}"></view>
              </view>

              <!-- 业务卡片渲染（cards 经 cardNormalizer 预构建 cardData） -->
              <block wx:if="{{!item.isLoading && item.cards && item.cards.length > 0}}">
                <!-- 上下文栏：门店 · 时间范围 · 权限说明（轻量辅助信息，优先读 contextSummary.contextBar） -->
                <view class="gem-ctx-bar" wx:if="{{item.contextSummary && item.contextSummary.contextBar}}">
                  <text class="gem-ctx-bar-text">{{item.contextSummary.contextBar}}</text>
                </view>
                <!-- 业务短结论 -->
                <view class="gem-answer-preview" wx:if="{{item.answerPreview}}">
                  <text class="gem-answer-preview-text">{{item.answerPreview}}</text>
                </view>
                <!-- 统一循环：每张卡片 + 操作按钮紧挨渲染 -->
                <block wx:for="{{item.cards}}" wx:for-item="dc" wx:key="_cardKey">
                  <business-card-renderer
                    card-type="{{dc.cardType}}"
                    card-data="{{dc.cardData}}"
                    readonly="{{!dc._allowsRowRecordUI}}"
                    scene="chat"
                    message-id="{{item.id}}"
                    run-id="{{item.runId}}"
                    bind:recordWork="onRecordToWorkRecord"
                  />

                  <!-- 卡级「加入工作记录」（全业务卡统一；不走 work-notes） -->
                  <view class="gem-card-record-area" wx:if="{{conversationId && item.id && item._realMessageReady}}">
                    <view
                      wx:if="{{dc._supportsWorkRecord}}"
                      class="gem-card-record-btn {{dc._cardRecorded ? 'gem-card-record-btn--done' : ''}}"
                      hover-class="{{dc._cardRecorded ? '' : 'gem-card-record-btn--hover'}}"
                      catchtap="{{dc._cardRecorded ? 'onViewWorkRecord' : 'onRecordToWorkRecord'}}"
                      data-card-type="{{dc.cardType}}"
                      data-item-key="__CARD__"
                      data-message-id="{{item.id}}"
                      data-run-id="{{item.runId}}"
                    >
                      <text class="gem-card-record-icon">{{dc._cardRecorded ? '✅' : '📝'}}</text>
                      <text class="gem-card-record-text">{{dc._cardRecorded ? '查看工作记录' : '加入工作记录'}}</text>
                    </view>
                    <view wx:else class="gem-card-record-btn gem-card-record-btn--disabled">
                      <text class="gem-card-record-icon">📝</text>
                      <text class="gem-card-record-text">暂不支持加入工作记录</text>
                    </view>
                  </view>

                  <!-- 卡级「图钉」操作区 -->
                  <view class="gem-card-pin-area" wx:if="{{conversationId && item.id && item._realMessageReady}}">
                    <view class="gem-card-pin-group">
                      <view
                        class="gem-card-pin-btn {{dc._cardPinned ? 'gem-card-pin-btn--done' : ''}}"
                        hover-class="{{dc._cardPinned ? '' : 'gem-card-pin-btn--hover'}}"
                        catchtap="onCardPinToggle"
                        data-card-type="{{dc.cardType}}"
                        data-item-key="__CARD__"
                        data-message-id="{{item.id}}"
                        data-run-id="{{item.runId}}"
                        data-card-instance-id="{{dc.cardInstanceId}}"
                        data-card-title-raw="{{dc._cardTitle}}"
                        data-card-index="{{dc._cardIndex}}"
                        data-card-key="{{dc._cardKey}}"
                      >
                        <text class="gem-card-pin-icon">{{dc._cardPinned ? '📍' : '📌'}}</text>
                        <text class="gem-card-pin-text">{{dc._cardPinned ? '已固定' : '加图钉'}}</text>
                      </view>
                    </view>
                  </view>
                </block>
              </block>
            </view>
            <!-- 调试 JSON 面板 -->
            <view
              class="gem-debug-panel " 
              wx:if="{{showDebugJson && !item.isLoading && item.debugJsonText}}"
            >
              <view class="gem-debug-head">
                <text class="gem-debug-title">原始 Debug JSON</text>
                <view class="gem-debug-copy" catchtap="onCopyDebugJson" data-msgid="{{item.id}}">
                  <text>复制</text>
                </view>
              </view>
              <scroll-view scroll-y class="gem-debug-body">
                <text class="gem-debug-json">{{item.debugJsonText}}</text>
              </scroll-view>
            </view>
          </view>
        </block>
      </view>
    </block>

    <view class="gem-scroll-spacer"></view>
  </scroll-view>

  <!-- 底部输入区：侧栏 + 输入框 + 发送 -->
  <view class="gem-composer-wrap" style="padding-bottom: calc(12px + env(safe-area-inset-bottom));">
    <view class="gem-composer-card">
      <view class="gem-composer-row">
        <view class="gem-side-btn" catchtap="onOpenDrawerTap" hover-class="gem-side-btn-hover">
          <text class="gem-side-btn-icon">☰</text>
        </view>
        <input
          class="gem-input gem-input--row"
          type="text"
          placeholder="问问Ai助手"
          placeholder-class="gem-input-ph"
          value="{{inputValue}}"
          cursor-spacing="16"
          adjust-position="{{true}}"
          disabled="{{isSending}}"
          focus="{{inputFocus}}"
          selection-start="{{inputSelectionStart}}"
          selection-end="{{inputSelectionEnd}}"
          bindinput="onInputChange"
          bindconfirm="onSendTap"
          confirm-type="send"
        />
        <view
          wx:if="{{isSending}}"
          class="gem-stop-btn"
          catchtap="onStopGeneratingTap"
        >停止</view>
        <view
          wx:else
          class="gem-send-pill {{!inputValue ? 'gem-send-pill-off' : ''}}"
          catchtap="onSendTap"
        >发送</view>
      </view>
    </view>
  </view>

  <!-- 左侧抽屉：推荐问题 + 历史会话（用 class 控制显隐以做过渡动画） -->
  <view
    class="gem-drawer-mask {{drawerOpen ? 'gem-drawer-mask--show' : ''}}"
    catchtap="onDrawerMaskTap"
    catchtouchmove="onDrawerTouchMove"
  ></view>
  <view
    class="gem-drawer-sheet {{drawerOpen ? 'gem-drawer-sheet--open' : ''}}"
    style="padding-top: {{drawerPaddingTop}}px;"
  >
  
      <view class="gem-drawer-head">
        <text class="gem-drawer-head-title">主题与历史</text>
        <view class="gem-drawer-close" catchtap="onDrawerCloseTap">✕</view>
      </view>
      <!-- 新建对话 + 店长日志 同行按钮 -->
      <view class="gem-drawer-action-row">
        <view class="gem-drawer-action-btn gem-drawer-action-btn--new" catchtap="onNewConversationTap">
          <text class="gem-drawer-action-icon">+</text>
          <text class="gem-drawer-action-label">新建对话</text>
        </view>
        <view  class="gem-drawer-action-btn gem-drawer-action-btn--wr" catchtap="onOpenPinList">
          <text class="gem-drawer-action-icon">📌</text>
          <text class="gem-drawer-action-label">图钉</text>

        </view>
       
      </view>
      <scroll-view
        scroll-y="{{true}}"
        class="gem-drawer-scroll"
        style="height: {{drawerScrollHeight}}px;"
      >
        <view class="gem-drawer-section-title">推荐问题</view>
        <view class="gem-drawer-pills">
          <view class="gem-topic-block" wx:for="{{topics}}" wx:for-item="topic" wx:key="id">
            <view
              class="gem-pill gem-pill--drawer {{drawerExpandedTopicId === topic.id ? 'gem-pill-open' : ''}}"
              hover-class="gem-pill-hover"
              catchtap="onDrawerTopicHeaderTap"
              data-id="{{topic.id}}"
            >
              <text class="gem-pill-emoji">{{topic.emoji}}</text>
              <view class="gem-pill-body">
                <text class="gem-pill-title">{{topic.title}}</text>
                <!-- <text class="gem-pill-desc" wx:if="{{topic.description}}">{{topic.description}}</text> -->
              </view>
              <text class="gem-pill-chevron">{{drawerExpandedTopicId === topic.id ? '⌃' : '⌄'}}</text>
            </view>
            <view class="gem-sublist" wx:if="{{drawerExpandedTopicId === topic.id}}">
              <view wx:if="{{topic.questions.length}}" class="gem-sublist-chips">
                <view
                  class="gem-chip {{!q.clickable ? 'gem-chip--disabled' : 'gem-chip--active'}}"
                  wx:for="{{topic.questions}}"
                  wx:for-item="q"
                  wx:key="id"
                  hover-class="{{q.clickable ? 'gem-chip-hover' : ''}}"
                  catchtap="onDrawerQuestionTap"
                  data-text="{{q.text}}"
                  data-clickable="{{q.clickable}}"
                >
                  <text class="gem-chip-text">{{q.text}}</text>
                  <text class="gem-chip-tag" wx:if="{{!q.clickable}}">即将支持</text>
                </view>
              </view>
              <view wx:else class="gem-sublist-empty">暂无具体问题</view>
            </view>
          </view>
        </view>
        <view class="gem-drawer-section-title gem-drawer-section-title--history1  flex-row-between p-20 ">
          <text>历史对话</text>
          <!-- 打开图钉,工作笔记页面 -->
          <view class="flex-row">
            <!-- <text class="gem-drawer-pin-entry" bindtap="onOpenPinList">图钉</text> -->
            <text class="gem-drawer-pin-entry" bindtap="onOpenNoteList">笔记</text>
          </view>
        </view>
        <view wx:if="{{conversationHistoryLoading}}" class="gem-drawer-loading">加载中…</view>
        <block wx:else>
          <view
            class="gem-drawer-history-row {{item.id == conversationId && histIdx > 0 ? 'gem-drawer-history-row--active' : ''}}"
            wx:for="{{conversationHistoryList}}"
            wx:for-index="histIdx"
            wx:key="id"
            catchtap="onHistoryConversationTap"
            data-id="{{item.id}}"
          >
            <text class="gem-drawer-history-title">{{item.title}}</text>
            <text class="gem-drawer-history-time" wx:if="{{item.time}}">{{item.time}}</text>
          </view>
          <view wx:if="{{!conversationHistoryList.length}}" class="gem-drawer-empty">暂无历史对话</view>
        </block>
        <view class="gem-drawer-scroll-bottom"></view>
      </scroll-view>
  </view>

  <!-- 加入店长工作记录 编辑弹窗 -->
  <view class="gem-wr-dialog-mask" wx:if="{{showWorkRecordDialog}}" catchtap="onCloseWorkRecordDialog"></view>
  <view class="gem-wr-dialog" wx:if="{{showWorkRecordDialog}}">
    <view class="gem-wr-dialog-head">
      <text class="gem-wr-dialog-title">加入店长工作记录</text>
      <text class="gem-wr-dialog-desc">确认标题与内容后保存</text>
    </view>
    <scroll-view scroll-y="{{true}}" class="gem-wr-dialog-scroll">
      <view class="gem-wr-dialog-body">
        <view class="gem-wr-dialog-field">
          <text class="gem-wr-dialog-label">记录标题</text>
          <input
            class="gem-wr-dialog-input"
            type="text"
            placeholder="请输入记录标题"
            placeholder-class="gem-wr-dialog-input-ph"
            value="{{workRecordDialogTitle}}"
            bindinput="onWorkRecordTitleInput"
            maxlength="120"
          />
        </view>
        <view class="gem-wr-dialog-field">
          <text class="gem-wr-dialog-label">主要内容</text>
          <textarea
            class="gem-wr-dialog-textarea"
            placeholder="记录需要跟进的事项…"
            placeholder-class="gem-wr-dialog-textarea-ph"
            value="{{workRecordDialogContent}}"
            bindinput="onWorkRecordContentInput"
            maxlength="2000"
            auto-height
          />
        </view>
        <view class="gem-wr-dialog-field" wx:if="{{workRecordDialogCategory}}">
          <text class="gem-wr-dialog-label">建议分类</text>
          <text class="gem-wr-dialog-category">{{workRecordDialogCategory}}</text>
        </view>
        <view class="gem-wr-dialog-field">
          <text class="gem-wr-dialog-label">来源卡片预览</text>
          <view class="gem-wr-dialog-preview">
            <business-card-renderer
              card-type="{{workRecordDialogCardType}}"
              card-data="{{workRecordDialogCardData}}"
              title="{{workRecordDialogCardTitle}}"
              subtitle="{{workRecordDialogCardSubtitle}}"
              readonly="{{true}}"
              scene="chat"
            />
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="gem-wr-dialog-foot">
      <view class="gem-wr-dialog-btn gem-wr-dialog-btn--cancel" catchtap="onCloseWorkRecordDialog">取消</view>
      <view class="gem-wr-dialog-btn gem-wr-dialog-btn--confirm {{_recordingCard ? 'gem-wr-dialog-btn--disabled' : ''}}" catchtap="{{_recordingCard ? '' : 'onConfirmWorkRecord'}}">保存</view>
    </view>
  </view>

  <!-- 添加到工作笔记 弹窗（已停用，保留占位） -->
  <view class="gem-note-dialog-mask" wx:if="{{showNoteDialog}}" catchtap="onCloseNoteDialog"></view>
  <view class="gem-note-dialog" wx:if="{{showNoteDialog}}">
    <view class="gem-note-dialog-head">
      <text class="gem-note-dialog-title">添加工作笔记</text>
      <text class="gem-note-dialog-desc">记录店长自己的看法</text>
    </view>
    <view class="gem-note-dialog-body">
      <view class="gem-note-dialog-field">
        <text class="gem-note-dialog-label">笔记标题</text>
        <input
          class="gem-note-dialog-input"
          type="text"
          placeholder="请输入笔记标题"
          placeholder-class="gem-note-dialog-input-ph"
          value="{{noteDialogTitle}}"
          bindinput="onNoteTitleInput"
          maxlength="120"
        />
      </view>
      <view class="gem-note-dialog-field">
        <text class="gem-note-dialog-label">笔记内容</text>
        <textarea
          class="gem-note-dialog-textarea"
          placeholder="记录你的看法…"
          placeholder-class="gem-note-dialog-textarea-ph"
          value="{{noteDialogContent}}"
          bindinput="onNoteContentInput"
          maxlength="2000"
          auto-height
        />
      </view>
    </view>
    <view class="gem-note-dialog-foot">
      <view class="gem-note-dialog-btn gem-note-dialog-btn--cancel" catchtap="onCloseNoteDialog">取消</view>
      <view class="gem-note-dialog-btn gem-note-dialog-btn--confirm {{_notingCard ? 'gem-note-dialog-btn--disabled' : ''}}" catchtap="{{_notingCard ? '' : 'onConfirmAddNote'}}">保存</view>
    </view>
  </view>
</view>
