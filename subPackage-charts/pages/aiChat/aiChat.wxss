/* ============================================================
   AI 对话页 — Gemini 浅色风格（算账版）
   字体栈贴近 Google Sans / 系统无衬线
   ============================================================ */

.gem-page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 顶栏 ---------- */
.gem-nav {
  flex-shrink: 0;
  background: #ffffff;
  z-index: 50;
}

.gem-nav-inner {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8px;
  box-sizing: border-box;
}

.gem-nav-side {
  width: 48px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gem-nav-left {
  justify-content: flex-start;
  padding-left: 4px;
}

.gem-nav-right {
  justify-content: flex-end;
  padding-right: 4px;
}

.gem-icon-menu {
  width: 40px;
  height: 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding-left: 8px;
  gap: 5px;
}

.gem-menu-line {
  width: 18px;
  height: 2px;
  background: #3c4043;
  border-radius: 1px;
}

.gem-nav-brand {
  font-size: 20px;
  font-weight: 500;
  color: #1f1f1f;
  letter-spacing: -0.02em;
}

.gem-avatar-ring {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: #1a73e8;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1px 2px rgba(60, 64, 67, 0.12);
}

.gem-avatar-char {
  font-size: 16px;
  font-weight: 500;
  color: #fff;
  line-height: 1;
}

/* ---------- 主滚动 ---------- */
.gem-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
}

.gem-loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.gem-loading-text {
  font-size: 30rpx;
  color: #5f6368;
  font-weight: 400;
}

/* ---------- 首页（空会话） ---------- */
.gem-home {
  padding: 24rpx 40rpx 32rpx;
  box-sizing: border-box;
}

.gem-greet {
  font-size: 42rpx;
  font-weight: 500;
  color: #1f1f1f;
  line-height: 1.35;
  letter-spacing: -0.01em;
}

.gem-greet-sub {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 500;
  color: #1f1f1f;
  line-height: 1.35;
  letter-spacing: -0.01em;
  margin-bottom: 20rpx;
}

.gem-subtitle {
  font-size: 30rpx;
  font-weight: 400;
  color: #5f6368;
  line-height: 1.5;
  letter-spacing: -0.01em;
  margin-bottom: 32rpx;
}

.gem-pill-list {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 20rpx;
}

.gem-topic-block {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.gem-pill {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #ffffff;
  border-radius: 9999rpx;
  padding: 26rpx 28rpx 26rpx 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(60, 64, 67, 0.08), 0 1rpx 2rpx rgba(60, 64, 67, 0.06);
  box-sizing: border-box;
}

.gem-pill-open {
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 2rpx 8rpx rgba(60, 64, 67, 0.06);
}

.gem-pill-hover {
  background: #f8f9fa;
}

.gem-pill-chevron {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #80868b;
  margin-left: 12rpx;
  line-height: 1;
}

.gem-pill-emoji {
  font-size: 38rpx;
  line-height: 1;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.gem-pill-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.gem-pill-title {
  font-size: 32rpx;
  font-weight: 400;
  color: #1f1f1f;
  line-height: 1.45;
  letter-spacing: -0.01em;
}

.gem-pill-desc {
  margin-top: 6rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: #80868b;
  line-height: 1.4;
}

/* 主题下的具体问题列表 */
.gem-sublist {
  margin-top: -4rpx;
}

/* 圆角 chip 容器 */
.gem-sublist-chips {
  background: #ffffff;
  border-radius: 0 0 28rpx 28rpx;
  padding: 16rpx 20rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(60, 64, 67, 0.08);
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.gem-sublist-empty {
  background: #ffffff;
  border-radius: 0 0 28rpx 28rpx;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: #80868b;
  box-shadow: 0 4rpx 12rpx rgba(60, 64, 67, 0.08);
}

/* 圆角 chip 基础样式 */
.gem-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  border-radius: 9999rpx;
  box-sizing: border-box;
  max-width: 100%;
}

/* 可点击的活跃 chip */
.gem-chip--active {
  background: #f0f4f9;
  border: 1rpx solid #d2e3fc;
}

.gem-chip-hover {
  background: #dce8f8;
}

/* 灰态 chip：COMING_SOON 或 enabled=false */
.gem-chip--disabled {
  background: #f8f9fa;
  border: 1rpx solid #f0f0f0;
  pointer-events: none;
}

.gem-chip-text {
  font-size: 28rpx;
  font-weight: 400;
  color: #1f1f1f;
  line-height: 1.5;
  word-break: break-all;
}

.gem-chip--disabled .gem-chip-text {
  color: #c4c7cc;
}

/* 灰态 chip 的「即将支持」标签 */
.gem-chip-tag {
  font-size: 22rpx;
  font-weight: 400;
  color: #c4c7cc;
  margin-left: 8rpx;
  line-height: 1;
  white-space: nowrap;
}

/* ---------- 对话消息 ---------- */
.gem-chat-inner {
  padding: 24rpx 0;
  box-sizing: border-box;
  width: 100%;
}

.gem-msg-row {
  display: flex;
  margin-bottom: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.gem-msg-user {
  justify-content: flex-end;
  padding-left: 72rpx;
  padding-right: 24rpx;
}

.gem-msg-ai {
  justify-content: flex-start;
  padding-left: 0;
  padding-right: 0;
}

.gem-bubble {
  max-width: 85%;
  padding: 22rpx 28rpx;
  border-radius: 22rpx;
  font-size: 32rpx;
  line-height: 1.55;
  letter-spacing: -0.01em;
  word-break: break-word;
  box-sizing: border-box;
}

.gem-bubble-user {
  background: #f0f4f9;
  color: #1f1f1f;
  border-bottom-right-radius: 6rpx;
  border: 1rpx solid #e3eaf3;
}

/* AI：无背景，横向占满；正文留白由 padding 控制 */
.gem-bubble-ai {
  max-width: 100%;
  width: 100%;
  background: transparent;
  color: #1f1f1f;
  border-radius: 0;
  border: none;
  box-shadow: none;
  padding: 20rpx 32rpx 28rpx;
}

/* ===== contextBar（门店 · 时间范围 · 权限说明）===== */
.gem-ctx-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 6rpx 18rpx;
  margin-bottom: 10rpx;
  background: #F6F8FB;
  border-radius: 12rpx;
  height: 44rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.gem-ctx-bar-text {
  font-size: 22rpx;
  color: #8A97A8;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ===== answerPreview（业务短结论）===== */
.gem-answer-preview {
  padding: 14rpx 18rpx;
  margin-bottom: 16rpx;
  background: #fefbf5;
  border-radius: 10rpx;
  border: 1rpx solid #f3e8c8;
}
.gem-answer-preview-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #4a3f1a;
  line-height: 1.5;
}

.gem-bubble-text {
  font-size: 32rpx;
  font-weight: 400;
  color: #1f1f1f;
  white-space: pre-wrap;
}

/* rich-text 内联样式为主；外层控制宽度与对齐 */
.gem-rich-md {
  display: block;
  width: 100%;
  overflow: hidden;
}

/* 流式输出：与尾部光标同一行（光标贴在段落右下角） */
.gem-ai-stream-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: flex-end;
  width: 100%;
  max-width: 100%;
}

.gem-rich-md--flex {
  flex: 1;
  min-width: 0;
  width: auto;
}

.gem-ai-stream-row .gem-bubble-text {
  flex: 1;
  min-width: 0;
}

.gem-stream-cursor {
  flex-shrink: 0;
  width: 4rpx;
  height: 34rpx;
  margin-left: 4rpx;
  margin-bottom: 6rpx;
  background: #5f6368;
  border-radius: 2rpx;
  animation: gemStreamCursor 1s ease-in-out infinite;
}

@keyframes gemStreamCursor {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.12;
  }
}

/* SSE 阶段提示（替代原来的三个小点，仅显示一行最新文案） */
.gem-stage-scroll {
  height: 40rpx;
  overflow: hidden;
  padding: 6rpx 0;
}

.gem-stage-item {
  display: block;
  font-size: 26rpx;
  color: #5f6368;
  line-height: 40rpx;
}

.gem-scroll-spacer {
  height: 24rpx;
}

/* ---------- 底部输入面板 ---------- */
.gem-composer-wrap {
  flex-shrink: 0;
  background: #ffffff;
  padding-top: 8rpx;
}

.gem-composer-card {
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 16rpx 20rpx 16rpx;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: none;
  box-sizing: border-box;
}

.gem-composer-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.gem-side-btn {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #f0f4f9;
  border: 1rpx solid #e3eaf3;
  box-sizing: border-box;
}

.gem-side-btn-hover {
  background: #e8eef5;
}

.gem-side-btn-icon {
  font-size: 34rpx;
  color: #3c4043;
  line-height: 1;
}

.gem-input {
  width: 100%;
  min-height: 44px;
  font-size: 36rpx;
  font-weight: 400;
  color: #1f1f1f;
  line-height: 44px;
  letter-spacing: -0.01em;
  padding: 4rpx 8rpx;
  box-sizing: border-box;
}

.gem-input--row {
  flex: 1;
  width: 0;
  min-width: 0;
}

.gem-input-ph {
  color: #80868b;
  font-weight: 400;
}

.gem-send-pill {
  flex-shrink: 0;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
  background: #1a73e8;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.gem-send-pill-off {
  background: #dadce0;
  color: #fff;
  pointer-events: none;
}

/* 停止生成按钮 */
.gem-stop-btn {
  flex-shrink: 0;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #1a73e8;
  background: #e8f0fe;
  border: 1rpx solid #d2e3fc;
  border-radius: 999rpx;
  box-sizing: border-box;
}

/* ---------- 左侧抽屉 ---------- */
/* 新建对话 + 店长日志 同行按钮 */
.gem-drawer-action-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 8rpx 20rpx 12rpx;
}

.gem-drawer-action-btn {
  display: flex;
  flex: 1;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.gem-drawer-action-btn--new {
  background: #e8f0fe;
}

.gem-drawer-action-btn--wr {
  background: #f8f9fa;
  border: 1rpx solid #e8eaed;
}

.gem-drawer-action-icon {
  font-size: 28rpx;
  line-height: 1;
}

.gem-drawer-action-btn--new .gem-drawer-action-icon {
  color: #1a73e8;
  font-weight: 500;
}

.gem-drawer-action-btn--wr .gem-drawer-action-icon {
  color: #5f6368;
}

.gem-drawer-action-label {
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.4;
}

.gem-drawer-action-btn--new .gem-drawer-action-label {
  color: #1a73e8;
}

.gem-drawer-action-btn--wr .gem-drawer-action-label {
  color: #3c4043;
}

/* ---------- 左侧抽屉 ---------- */
.gem-drawer-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 800;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.gem-drawer-mask--show {
  opacity: 1;
  pointer-events: auto;
}

.gem-drawer-sheet {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  width: 72%;
  max-width: 600rpx;
  background: #ffffff;
  z-index: 801;
  box-shadow: none;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  transform: translateX(-100%);
  transition: transform 0.28s ease;
  pointer-events: none;
}

.gem-drawer-sheet--open {
  transform: translateX(0);
  pointer-events: auto;
}

.gem-drawer-head {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.gem-drawer-head-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f1f1f;
}

.gem-drawer-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #5f6368;
}

.gem-drawer-scroll {
  width: 100%;
  padding: 0 24rpx 24rpx;
  box-sizing: border-box;
}

.gem-drawer-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #5f6368;
  padding: 24rpx 4rpx 12rpx;
}

.gem-drawer-section-title--history {
  margin-top: 8rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 28rpx;
}

.gem-drawer-pills {
  padding-bottom: 8rpx;
}

.gem-pill--drawer {
  box-shadow: 0 1rpx 6rpx rgba(60, 64, 67, 0.06);
}

.gem-drawer-loading,
.gem-drawer-empty {
  font-size: 28rpx;
  color: #80868b;
  padding: 24rpx 8rpx;
}

.gem-drawer-history-row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 22rpx 20rpx;
  margin-bottom: 12rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.gem-drawer-history-row--active {
  border-color: #1a73e8;
  background: #e8f0fe;
}

.gem-drawer-history-title {
  font-size: 30rpx;
  color: #1f1f1f;
  line-height: 1.4;
  word-break: break-all;
}

.gem-drawer-history-time {
  font-size: 24rpx;
  color: #80868b;
  margin-top: 8rpx;
}

.gem-drawer-scroll-bottom {
  height: env(safe-area-inset-bottom);
  min-height: 16rpx;
}

/* ========== 调试 JSON 面板 ========== */

/* 顶栏下方 Debug 切换按钮 */
.gem-debug-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0 6rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.gem-debug-toggle-text {
  font-size: 22rpx;
  color: #5f6368;
  font-weight: 500;
}

/* 每条消息下的调试面板 */
.gem-debug-panel {
  margin: 8rpx 28rpx 0;
  border: 1rpx solid #e8eaed;
  border-radius: 12rpx;
  background: #fafafa;
  overflow: hidden;
}

.gem-debug-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #f5f5f5;
}

.gem-debug-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #5f6368;
}

.gem-debug-copy {
  padding: 6rpx 18rpx;
  background: #1a73e8;
  border-radius: 8rpx;
}

.gem-debug-copy text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

.gem-debug-body {
  max-height: 500rpx;
  padding: 16rpx 20rpx;
}

.gem-debug-json {
  font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
  font-size: 20rpx;
  color: #374151;
  white-space: pre-wrap;
  word-break: break-all;
  line-height: 1.6;
}

/* ========== 卡级「加入工作记录」按钮 ========== */

.gem-card-record-area {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  margin-top: 8rpx;
}

.gem-card-record-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  background: #f0f4ff;
  border: 1rpx solid #d6e4ff;
  border-radius: 20rpx;
  transition: background 0.15s ease;
}

.gem-card-record-btn--hover {
  background: #d6e4ff;
}

/* 已加入（可查看） */
.gem-card-record-btn--done {
  background: #f5f5f5;
  border-color: #e8e8e8;
}

.gem-card-record-btn--done .gem-card-record-text {
  color: #576b95;
}

/* 暂不支持 */
.gem-card-record-btn--disabled {
  background: #f5f5f5;
  border-color: #ebebeb;
  opacity: 0.85;
}

.gem-card-record-btn--disabled .gem-card-record-text {
  color: #bbb;
}

.gem-card-record-icon {
  font-size: 24rpx;
}

.gem-card-record-text {
  font-size: 24rpx;
  color: #576b95;
  font-weight: 500;
}

/* ========== 卡级「图钉」按钮 ========== */

.gem-card-pin-area {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  margin-top: 8rpx;
}

/* 每张卡的操作按钮组（图钉 + 笔记横向并排） */
.gem-card-pin-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
}

.gem-card-pin-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  background: #fff7e6;
  border: 1rpx solid #ffe4a0;
  border-radius: 20rpx;
  transition: background 0.15s ease;
}

.gem-card-pin-btn--hover {
  background: #ffe4a0;
}

/* 已固定（不可再点） */
.gem-card-pin-btn--done {
  background: #f5f5f5;
  border-color: #e8e8e8;
}

.gem-card-pin-btn--done .gem-card-pin-text {
  color: #999;
}

.gem-card-pin-icon {
  font-size: 24rpx;
}

.gem-card-pin-text {
  font-size: 24rpx;
  color: #e6a23c;
  font-weight: 500;
}

/* ========== 卡级「添加到工作笔记」按钮 ========== */

.gem-card-note-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  background: #e6f7ff;
  border: 1rpx solid #b3e5fc;
  border-radius: 20rpx;
  transition: background 0.15s ease;
}

.gem-card-note-btn--hover {
  background: #b3e5fc;
}

.gem-card-note-icon {
  font-size: 24rpx;
}

.gem-card-note-text {
  font-size: 24rpx;
  color: #1890ff;
  font-weight: 500;
}

/* ========== 工作笔记弹窗 ========== */

.gem-note-dialog-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
}

.gem-note-dialog {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
  z-index: 201;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.gem-note-dialog-head {
  padding: 32rpx 36rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.gem-note-dialog-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.gem-note-dialog-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.gem-note-dialog-body {
  padding: 28rpx 36rpx;
}

.gem-note-dialog-field {
  margin-bottom: 24rpx;
}

.gem-note-dialog-field:last-child {
  margin-bottom: 0;
}

.gem-note-dialog-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.gem-note-dialog-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  background: #f7f8fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.gem-note-dialog-input-ph {
  color: #bbb;
  font-size: 28rpx;
}

.gem-note-dialog-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  background: #f7f8fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.gem-note-dialog-textarea-ph {
  color: #bbb;
  font-size: 28rpx;
}

.gem-note-dialog-foot {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 20rpx 36rpx 32rpx;
}

.gem-note-dialog-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 16rpx;
  transition: opacity 0.15s ease;
}

.gem-note-dialog-btn--cancel {
  background: #f5f5f5;
  color: #666;
}

.gem-note-dialog-btn--confirm {
  background: #1890ff;
  color: #fff;
}

.gem-note-dialog-btn--disabled {
  opacity: 0.5;
}

