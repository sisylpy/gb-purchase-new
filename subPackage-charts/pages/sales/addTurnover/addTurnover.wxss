.form-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.form-title {
  font-size: 30rpx;
  color: #333;
}

.form-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-row {
  display: flex;
  align-items: center;
}

.form-label {
  display: block;
  width: 140rpx;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.date-row {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.date-input-wrapper {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 70rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  background: #fafafa;
  box-sizing: border-box;
}

.field-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  width: 100%;
}

.field-row:last-child {
  margin-bottom: 0;
}

.preview-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.preview-row:last-child {
  border-bottom: none;
}

.save-btn-wrapper {
  padding: 30rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn {
  background-color: #007aff;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
  margin: 0;
  width: 100%;
  line-height: 1;
}

.save-btn::after {
  border: none;
}

.save-btn:active {
  background-color: #0066cc;
}

.download-btn {
  font-size: 28rpx;
  color: #007aff;
  padding: 10rpx 24rpx;
  border: 1rpx solid #007aff;
  border-radius: 30rpx;
}

.upload-btn {
  font-size: 28rpx;
  color: #34c759;
  padding: 10rpx 24rpx;
  border: 1rpx solid #34c759;
  border-radius: 30rpx;
}

.food-sales-tool-row {
  justify-content: space-between;
  align-items: center;
  padding-top: 0 !important;
}

/* 菜品销量模板：日期范围弹窗（与同项目 depFoodList 一致） */
.food-tpl-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1100;
}

.food-tpl-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.5);
}

.food-tpl-panel {
  position: absolute;
  top: 50%;
  left: 50%;
  box-sizing: border-box;
  width: 600rpx;
  max-width: 90%;
  padding: 36rpx 32rpx 32rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
  transform: translate(-50%, -50%);
}

.food-tpl-title {
  margin-bottom: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

.food-tpl-form {
  margin-bottom: 28rpx;
}

.food-tpl-form-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.food-tpl-form-item:last-child {
  border-bottom: none;
}

.food-tpl-form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.food-tpl-form-input {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  padding: 0 20rpx;
  background: #fafafa;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.food-tpl-actions {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.food-tpl-actions .food-tpl-btn {
  box-sizing: border-box;
  width: 47%;
  margin: 0;
  padding: 20rpx 0;
  font-size: 28rpx;
  line-height: 1.35;
  text-align: center;
  border-radius: 44rpx;
}

.food-tpl-btn--ghost {
  color: #666;
  background: #f5f5f5;
}

.food-tpl-btn--primary {
  font-weight: 500;
  color: #fff;
  background: #007aff;
}

/* 模板下载弹窗 */
.template-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.template-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.template-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.template-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 40rpx;
  color: #333;
}

.template-form {
  margin-bottom: 40rpx;
}

.template-actions {
  display: flex;
  gap: 24rpx;
}

.btn-cancel {
  flex: 1;
  background: #f5f5f5;
  color: #666;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  margin: 0;
}

.btn-confirm {
  flex: 1;
  background: #007aff;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  margin: 0;
}

/* 表格布局 */
.info-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 200rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.info-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
  padding: 0 10rpx;
}

.info-unit {
  width: 60rpx;
  font-size: 26rpx;
  color: #999;
  text-align: right;
  flex-shrink: 0;
}

.info-divider {
  height: 1rpx;
  background: #e0e0e0;
  margin: 10rpx 0;
}

/* 模块卡片布局 */
.module-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.module-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.module-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.module-row:last-child {
  margin-bottom: 0;
}

.field-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.field-row:last-child {
  margin-bottom: 0;
}

.field-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  height: 70rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  background: #fafafa;
  box-sizing: border-box;
}
