/* ========================================
   九宫格汇总统计卡片
   ======================================== */
.summary-grid {
  background-color: #f5f6fa;
  padding: 16rpx 20rpx;
}

.sg-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.sg-row:last-child {
  margin-bottom: 0;
}

.sg-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  flex: 1;
  margin-right: 12rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  min-width: 0;
}

.sg-card:last-child {
  margin-right: 0;
}

.sg-card__label {
  font-size: 24rpx;
  color: #666;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.sg-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sg-card__header .sg-card__label {
  margin-bottom: 0;
  flex: 1;
}

.sg-card__icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.sg-card__value {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 4rpx;
  word-break: break-all;
}

.sg-card__unit {
  font-size: 22rpx;
  font-weight: 400;
  color: inherit;
  margin-left: 2rpx;
}

.sg-card__sub {
  font-size: 20rpx;
  color: #999;
  line-height: 1.2;
}

/* 颜色变体 */
.sg-card__value--green { color: #07c160; }
.sg-card__value--blue { color: #007aff; }
.sg-card__value--orange { color: #ff9500; }
.sg-card__value--pink { color: #ff2d55; }
.sg-card__value--purple { color: #af52de; }

/* 小标签 */
.sg-card__tag {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  text-align: center;
  line-height: 32rpx;
  color: #fff;
  flex-shrink: 0;
}

.sg-card__tag--orange { background-color: #ff9500; }
.sg-card__tag--pink { background-color: #ff2d55; }

/* ========================================
   添加营业额按钮
   ======================================== */
.turnover-add-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 6rpx 24rpx 6rpx 20rpx;
  border-radius: 999rpx;
  background-color: #ecf8f0;
  border: 1rpx solid #7cbf8e;
  box-sizing: border-box;
}

.turnover-add-btn--hover { background-color: #dff0e6; }

.turnover-add-btn__icon { width: 32rpx; height: 32rpx; margin-right: 10rpx; }

.turnover-add-btn__text {
  font-size: 28rpx;
  font-weight: 500;
  color: #2d6a45;
  letter-spacing: 0.5rpx;
}

/* 子部门选择器图标 */
.dfl-search-top-ico { width: 36rpx; height: 36rpx; }

/* ========================================
   图表区域
   ======================================== */
.chart-section { padding: 20rpx; }

.chart-section__header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.chart-section__title-bar {
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, #007aff 0%, #34c759 100%);
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.chart-section__title { font-size: 30rpx; font-weight: 700; color: #333; }

/* ========================================
   每日营业详情 - 头部
   ======================================== */
.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
}

.detail-header__left { display: flex; align-items: center; }

.detail-header__bar {
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, #007aff 0%, #34c759 100%);
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.detail-header__title { font-size: 30rpx; font-weight: 700; color: #333; }

.detail-header__right {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
}

.detail-header__action { font-size: 24rpx; color: #999; margin-right: 4rpx; }

.detail-header__arrow {
  font-size: 20rpx;
  color: #999;
  transition: transform 0.2s;
}

.detail-header__arrow.rotated { transform: rotate(180deg); }

/* ========================================
   每日卡片 — 按设计图
   ======================================== */
.daily-card {
  margin: 0 20rpx;
  padding: 24rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.daily-card--hover { background-color: #fafbfc; }

/* 卡片主体行 */
.daily-card__top {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

/* ===== 左侧：日期区 ===== */
.daily-card__date-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 110rpx;
  margin-right: 20rpx;
  padding-top: 2rpx;
}

.daily-card__date-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.2;
}

.daily-card__date-sub {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  gap: 6rpx;
}

.daily-card__weekday {
  font-size: 26rpx;
  color: #302f2f;
}

.daily-card__weather {
  font-size: 26rpx;
  line-height: 1;
}

/* ===== 中间：数据列 ===== */
.daily-card__main-stats {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  min-width: 0;
}

.dc-stat-col {
  display: flex;
  flex-direction: column;
  margin-right: 20rpx;
  min-width: 100rpx;
}

.dc-stat-col--total { min-width: 140rpx; }
.dc-stat-col--order {
  min-width: 80rpx;
  margin-right: 0;
  margin-left: auto;
}

.dc-stat-label { font-size: 22rpx; color: #999; line-height: 1.3; }

.dc-stat-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.3;
}
.dc-stat-val--blue { color: #007aff; }
.dc-stat-val--green { color: #07c160; }
.dc-stat-val--orange { color: #ff9500; }

.dc-unit { font-size: 22rpx; font-weight: 400; }

.dc-stat-sub { font-size: 20rpx; color: #999; line-height: 1.3; }

.dc-stat-pct { font-size: 20rpx; color: #999; line-height: 1.3; }

/* ===== 右侧箭头 ===== */
.daily-card__arrow {
  width: 24rpx;
  height: 24rpx;
  margin-left: 12rpx;
  padding-top: 8rpx;
  opacity: 0.5;
  flex-shrink: 0;
}

/* ===== 标签行 ===== */
.daily-card__tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #eee;
}

.dc-tag {
  display: flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  white-space: nowrap;
}

.dc-tag__label { color: #888; margin-right: 6rpx; }

.dc-tag__value { font-weight: 500; }

.dc-tag--purple { background: #f4f0fa; }
.dc-tag--purple .dc-tag__value { color: #af52de; }

.dc-tag--orange { background: #fff8ee; }
.dc-tag--orange .dc-tag__value { color: #ff9500; }

.dc-tag--pink { background: #fef0f3; }
.dc-tag--pink .dc-tag__value { color: #ff2d55; }

.dc-tag--orange-light { background: #fef8ec; }
.dc-tag--orange-light .dc-tag__value { color: #e08e00; }

.dc-tags-arrow {
  width: 22rpx;
  height: 22rpx;
  opacity: 0.35;
  margin-left: auto;
  flex-shrink: 0;
}

/* 底部提示 */
.detail-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 20rpx;
  gap: 8rpx;
}

.detail-footer__icon-text {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 1.5rpx solid #ccc;
  font-size: 20rpx;
  font-style: italic;
  color: #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.detail-footer__text { font-size: 22rpx; color: #bbb; }

/* ========================================
   下载/上传模板按钮
   ======================================== */
.tool-btns {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.download-btn {
  font-size: 24rpx;
  color: #007aff;
  padding: 8rpx 20rpx;
  border: 1rpx solid #007aff;
  border-radius: 30rpx;
}

.upload-btn {
  font-size: 24rpx;
  color: #34c759;
  padding: 8rpx 20rpx;
  border: 1rpx solid #34c759;
  border-radius: 30rpx;
}

/* ========================================
   合并模板弹窗
   ======================================== */
.combined-tpl-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1100;
}

.combined-tpl-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.5);
}

.combined-tpl-panel {
  position: absolute;
  top: 50%;
  left: 50%;
  box-sizing: border-box;
  width: 600rpx;
  max-width: 90%;
  padding: 36rpx 32rpx 32rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
  transform: translate(-50%, -50%);
}

.combined-tpl-title {
  margin-bottom: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

.combined-tpl-form {
  margin-bottom: 28rpx;
}

.combined-tpl-form-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.combined-tpl-form-item:last-child {
  border-bottom: none;
}

.combined-tpl-form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.combined-tpl-form-input {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  padding: 0 20rpx;
  background: #fafafa;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.combined-tpl-actions {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.combined-tpl-actions .combined-tpl-btn {
  box-sizing: border-box;
  width: 47%;
  margin: 0;
  padding: 20rpx 0;
  font-size: 28rpx;
  line-height: 1.35;
  text-align: center;
  border-radius: 44rpx;
}

.combined-tpl-btn--ghost {
  color: #666;
  background: #f5f5f5;
}

.combined-tpl-btn--primary {
  font-weight: 500;
  color: #fff;
  background: #007aff;
}
