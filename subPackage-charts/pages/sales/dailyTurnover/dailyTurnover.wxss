.stat-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.bg-dinein {
  background: linear-gradient(135deg, #e8f0ff 0%, #d4e5ff 100%);
}

.bg-takeout {
  background: linear-gradient(135deg, #e8fff0 0%, #d4f5e0 100%);
}

.bg-platform {
  background: linear-gradient(135deg, #fff5e8 0%, #ffe8d4 100%);
}

.chart-legend {
  display: flex;
  align-items: center;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 6rpx;
}

.daily-item {
  background-color: #ffffff;
}

.platform-tag {
  background-color: #ff9500;
  color: #ffffff;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
}

/* 添加菜单 */
.add-menu {
  position: fixed;
  top: calc(var(--nav-bar-height, 88rpx) + 20rpx);
  right: 30rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  z-index: 1000;
  overflow: hidden;
  transition: opacity 0.2s, transform 0.2s;
}

.add-menu.show {
  opacity: 1;
  transform: scale(1);
}

.add-menu.hide {
  opacity: 0;
  transform: scale(0.9);
  pointer-events: none;
}

.add-menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
}

.add-menu-item:last-child {
  border-bottom: none;
}

.add-menu-item:active {
  background-color: #f5f5f5;
}

/* 每日详情列表美化 */
.date-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #007aff 0%, #0056cc 100%);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  min-width: 80rpx;
}

.date-day {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.date-month {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.revenue-badge {
  display: flex;
  align-items: baseline;
  background: #f0f7ff;
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
}
