<wxs src="/wxs/format.wxs" module="tool" />

<view class="flex flex-column">

  <back-navbar title="每日营业额" style="height: {{navBarHeight}}rpx;" avatar="/images/back-gray.png" button-text="添加" bindnavbuttontap="toBack"></back-navbar>

  <!-- 顶部日期选择 -->
  <view class="flex-row-between pl-20 pr-20 border-bottom bg-white">
    <view class="flex-row" bindtap="toDatePage">
      <view class="p-20">
        <image src="../../../../images/calender.png" class="icon"></image>
      </view>
      <view class="flex-column pt-10">
        <view class="font-yuan">{{hanzi}}</view>
        <view class="flex-row" wx:if="{{startDate == stopDate}}">
          <view class="small" wx:if="{{startDate}}">{{tool.transferDateString(startDate)}}</view>
        </view>
        <view class="flex-row" wx:else>
          <view wx:if="{{startDate}}">{{tool.transferDateString(startDate)}}</view>
          <text class="plr-10">-</text>
          <view wx:if="{{stopDate}}">{{tool.transferDateString(stopDate)}}</view>
        </view>
      </view>
    </view>

    <!-- AI外部报表 / 标准模板 -->
    <view class="tool-btns">
      <view class="ai-import-top-btn" bindtap="onAiImportExcel">AI导入</view>
      <view class="download-btn" bindtap="onDownloadCombinedTemplate">下载模板</view>
      <view class="upload-btn" bindtap="onUploadCombinedExcel">标准导入</view>
    </view>
  </view>

  <!-- 合并模板日期弹窗 -->
  <view class="combined-tpl-modal" wx:if="{{showCombinedTemplateModal}}">
    <view class="combined-tpl-mask" bindtap="onCloseCombinedTemplateModal"></view>
    <view class="combined-tpl-panel">
      <view class="combined-tpl-title">合并模板 · 日期范围</view>
      <view class="combined-tpl-form">
        <view class="combined-tpl-form-item">
          <text class="combined-tpl-form-label">开始日期</text>
          <picker mode="date" value="{{combinedTemplateStartDate}}" end="{{todayDate}}"
            bindchange="onCombinedTemplateStartChange">
            <view class="combined-tpl-form-input flex-row-between">
              <text>{{combinedTemplateStartDate || '请选择'}}</text>
              <text class="text-secondary">›</text>
            </view>
          </picker>
        </view>
        <view class="combined-tpl-form-item">
          <text class="combined-tpl-form-label">结束日期</text>
          <picker mode="date" value="{{combinedTemplateEndDate}}" start="{{combinedTemplateStartDate}}"
            end="{{todayDate}}" bindchange="onCombinedTemplateEndChange">
            <view class="combined-tpl-form-input flex-row-between">
              <text>{{combinedTemplateEndDate || '请选择'}}</text>
              <text class="text-secondary">›</text>
            </view>
          </picker>
        </view>
      </view>
      <view class="combined-tpl-actions">
        <view class="combined-tpl-btn combined-tpl-btn--ghost" bindtap="onCloseCombinedTemplateModal">取消</view>
        <view class="combined-tpl-btn combined-tpl-btn--primary" bindtap="onConfirmDownloadCombined">确认下载</view>
      </view>
    </view>
  </view>

  <!-- ========== 九宫格汇总统计卡片 ========== -->
  <view class="summary-grid p-20" wx:if="{{summary}}">
    <!-- 第一行：总营业额 / 实收 / 总订单数 -->
    <view class="sg-row">
      <view class="sg-card">
        <view class="sg-card__label">总营业额</view>
        <view class="sg-card__value sg-card__value--green">{{summary.totalRevenueAmount}}</view>
        <view class="sg-card__sub">日均 {{summary.averageDailyRevenue}}</view>
      </view>
      <view class="sg-card">
        <view class="sg-card__label">实收</view>
        <view class="sg-card__value sg-card__value--blue">{{summary.netReceivedAmount}}</view>
        <view class="sg-card__sub">日均 {{summary.averageDailyRevenue}}</view>
      </view>
      <view class="sg-card">
        <view class="sg-card__label">总订单数</view>
        <view class="sg-card__value sg-card__value--orange">{{summary.totalOrderCount}}<text class="sg-card__unit">单</text></view>
        <view class="sg-card__sub">日均 {{summary.averageDailyOrderCount}} 单</view>
      </view>
    </view>

    <!-- 第二行：堂食营业额 / 外卖营业额 / 员工餐 -->
    <view class="sg-row">
      <view class="sg-card">
        <view class="sg-card__header">
          <text class="sg-card__label">堂食营业额</text>
          <image src="../../../../images/dish.png" class="sg-card__icon"></image>
        </view>
        <view class="sg-card__value sg-card__value--green">{{summary.dineInRevenueAmount}}</view>
        <view class="sg-card__sub">占比 {{dineInPercent}}%</view>
      </view>
      <view class="sg-card">
        <view class="sg-card__header">
          <text class="sg-card__label">外卖营业额</text>
          <image src="../../../../images/delivery.png" class="sg-card__icon"></image>
        </view>
        <view class="sg-card__value sg-card__value--green">{{summary.takeoutRevenueAmount}}</view>
        <view class="sg-card__sub">占比 {{takeoutPercent}}%</view>
      </view>
      <view class="sg-card">
        <view class="sg-card__header">
          <text class="sg-card__label">员工餐</text>
          <image src="../../../../images/user-group-2.png" class="sg-card__icon" mode="aspectFit"></image>
        </view>
        <view class="sg-card__value sg-card__value--purple">{{empSummaryDisplay || (summary.employeeMealPortions + '份')}}</view>
        <view class="sg-card__sub">日均 {{empDailyAverage}} 份</view>
      </view>
    </view>

    <!-- 第三行：折扣餐额 / 赠送金额 / 平台抽成 -->
    <view class="sg-row">
      <view class="sg-card">
        <view class="sg-card__header">
          <text class="sg-card__label">折扣餐额</text>
          <text class="sg-card__tag sg-card__tag--orange">折</text>
        </view>
        <view class="sg-card__value sg-card__value--orange">{{summary.discountSalesAmount}}</view>
        <view class="sg-card__sub">占比 {{discountPercent}}%</view>
      </view>
      <view class="sg-card">
        <view class="sg-card__header">
          <text class="sg-card__label">赠送金额</text>
          <text class="sg-card__tag sg-card__tag--pink">赠</text>
        </view>
        <view class="sg-card__value sg-card__value--pink">{{summary.complimentaryOriginalValue}}</view>
        <view class="sg-card__sub">占比 {{complimentaryPercent}}%</view>
      </view>
      <view class="sg-card">
        <view class="sg-card__header">
          <text class="sg-card__label">平台抽成</text>
          <text class="sg-card__tag sg-card__tag--orange">%</text>
        </view>
        <view class="sg-card__value sg-card__value--orange">{{summary.platformFeeAmount}}</view>
        <view class="sg-card__sub">占比 {{platformPercent}}%</view>
      </view>
    </view>
  </view>

  <!-- ========== 营业额趋势图 ========== -->
  <view class="chart-section bg-white mb-20" wx:if="{{dailyRows.length > 0}}">
    <view class="chart-section__header">
      <view class="chart-section__title-bar"></view>
      <text class="chart-section__title">营业额趋势</text>
    </view>
    <view style="height: 400rpx;">
      <ec-canvas id="turnoverChart" canvas-id="turnoverChart" ec="{{ ecTurnover }}" style="width: 100%; height: 100%;"></ec-canvas>
    </view>
  </view>

  <!-- ========== 每日营业详情 ========== -->
  <view class="bg-white" wx:if="{{dailyRows.length > 0}}">
    <!-- 标题栏 -->
    <view class="detail-header border-bottom">
      <view class="detail-header__left">
        <view class="detail-header__bar"></view>
        <text class="detail-header__title">每日营业详情</text>
      </view>
      <view class="detail-header__right" bindtap="toggleDailyRows">
        <text class="detail-header__action">{{showAllDailyRows ? '展开更多' : '收起'}}</text>
        <text class="detail-header__arrow {{showAllDailyRows ? '' : 'rotated'}}">&#xe900;</text>
      </view>
    </view>

    <!-- 每日卡片列表 -->
    <view class="flex-column" wx:for="{{dailyRows}}" wx:key="date" wx:for-item="row" wx:if="{{showAllDailyRows || index < 3}}">
      <view class="daily-card" hover-class="daily-card--hover" bindtap="openFoodSalesEdit" data-date="{{row.date}}" data-record-date="{{row.date}}">
        <!-- 主体行：日期 + 数据 + 箭头 -->
        <view class="daily-card__top">
          <!-- 左侧：日期 + 星期 + 天气图标 -->
          <view class="daily-card__date-info">
            <text class="daily-card__date-text">{{tool.getAttrDateString(row.date)}}</text>
            <view class="daily-card__date-sub">
              <text class="daily-card__weekday">{{row.weekLabel}}</text>
              <!-- <text class="daily-card__weather">☀</text> -->
            </view>
          </view>

          <!-- 中间数据列：总营业额 / 堂食 / 外卖 / 订单数 -->
          <view class="daily-card__main-stats">
            <view class="dc-stat-col dc-stat-col--total">
              <text class="dc-stat-label">总营业额</text>
              <text class="dc-stat-val">¥ {{row.totalRevenueAmount}}</text>
              <text class="dc-stat-sub">实收 ¥ {{row.netReceivedAmount}}</text>
            </view>
            <view class="dc-stat-col">
              <text class="dc-stat-label">堂食</text>
              <text class="dc-stat-val dc-stat-val--blue">¥ {{row.dineInRevenueAmount}}</text>
              <text class="dc-stat-pct">{{row._dineInPercent}}%</text>
            </view>
            <view class="dc-stat-col">
              <text class="dc-stat-label">外卖</text>
              <text class="dc-stat-val dc-stat-val--green">¥ {{row.takeoutRevenueAmount}}</text>
              <text class="dc-stat-pct">{{row._takeoutPercent}}%</text>
            </view>
            <view class="dc-stat-col dc-stat-col--order">
              <text class="dc-stat-label">订单数</text>
              <text class="dc-stat-val dc-stat-val--orange">{{row.orderCount}}<text class="dc-unit"> 单</text></text>
            </view>
          </view>

          <!-- 右侧箭头 -->
          <image src="../../../../images/arrow-right-3.png" class="daily-card__arrow"></image>
        </view>

        <!-- 标签行：员工餐 / 折扣餐 / 赠送金额 / 平台抽成 + 箭头 -->
        <view class="daily-card__tags">
          <view class="dc-tag dc-tag--purple" wx:if="{{row.normalPortions && row.normalPortions !== '0'}}">
            <text class="dc-tag__label">销售</text>
            <text class="dc-tag__value">{{row.normalPortions}}</text>
          </view>
          <view class="dc-tag dc-tag--orange" wx:if="{{row.discountPortions && row.discountPortions !== '0'}}">
            <text class="dc-tag__label">折扣餐</text>
            <text class="dc-tag__value">{{row.discountPortions}}</text>
          </view>
          <view class="dc-tag dc-tag--purple" wx:if="{{row.employeeMealPortions && row.employeeMealPortions !== '0'}}">
            <text class="dc-tag__label">员工餐</text>
            <text class="dc-tag__value">{{row.employeeMealPortions}}</text>
          </view>
          <view class="dc-tag dc-tag--orange" wx:if="{{row.discountPortions && row.discountPortions !== '0'}}">
            <text class="dc-tag__label">折扣餐</text>
            <text class="dc-tag__value">{{row.discountPortions}}</text>
          </view>
          <view class="dc-tag dc-tag--pink" wx:if="{{row.complimentaryPortions && row.complimentaryPortions !== '0'}}">
            <text class="dc-tag__label">赠送金额</text>
            <text class="dc-tag__value">{{row.complimentaryPortions}}</text>
          </view>
          <view class="dc-tag dc-tag--orange-light" wx:if="{{row.platformFeeAmount && row.platformFeeAmount !== '0.00'}}">
            <text class="dc-tag__label">平台抽成</text>
            <text class="dc-tag__value">{{row._platformDisplay}}</text>
          </view>
          <image src="../../../../images/arrow-right-3.png" class="dc-tags-arrow"></image>
        </view>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="detail-footer" wx:if="{{showAllDailyRows}}">
      <text class="detail-footer__icon-text">i</text>
      <text class="detail-footer__text">已显示全部数据（{{tool.transferDateString(startDate)}}-{{tool.transferDateString(stopDate)}}）</text>
    </view>
  </view>

  <!-- 无数据 -->
  <view wx:if="{{!summary || dailyRows.length === 0}}" style="height: {{windowHeight - 360}}rpx;">
    <view class="center-content flex-column" style="padding-top: 200rpx;">
      <image class="empty_image" src="/images/cart-Empty.png"></image>
      <text class="big">无数据</text>
    </view>
  </view>

  <!-- AI经营日报识别结果：未确认前不写入任何业务数据 -->
  <view class="ai-import-modal" wx:if="{{showAiImportPreview && aiImportPreview}}" catchtouchmove="noopAiImport">
    <view class="ai-import-mask" bindtap="onCloseAiImportPreview"></view>
    <view class="ai-import-panel">
      <view class="ai-import-header">
        <view>
          <view class="ai-import-title">AI经营日报识别</view>
          <view class="ai-import-file">{{aiImportPreview.fileName}}</view>
        </view>
        <view class="ai-import-close" bindtap="onCloseAiImportPreview">×</view>
      </view>

      <scroll-view class="ai-import-scroll" scroll-y="true">
        <view class="ai-import-state {{aiImportPreview.canCommit ? 'ai-import-state--ready' : 'ai-import-state--error'}}">
          <view class="ai-import-state__title">
            {{aiImportPreview.canCommit ? '核对完成，可以导入' : '导入未完成'}}
          </view>
          <view class="ai-import-state__desc" wx:if="{{!aiImportPreview.canCommit}}">
            发现 {{aiImportPreview.summary.errorCount}} 个问题，本次尚未写入任何数据
          </view>
          <view class="ai-import-state__desc" wx:else>
            菜品、销量、单价和营业额已经完成交叉核对
          </view>
        </view>

        <view class="ai-import-summary">
          <view class="ai-import-summary__item">
            <text class="ai-import-summary__value">{{aiImportPreview.summary.sourceDishRows}}</text>
            <text class="ai-import-summary__label">菜品行</text>
          </view>
          <view class="ai-import-summary__item">
            <text class="ai-import-summary__value ai-import-summary__value--green">{{aiImportPreview.summary.matchedDishRows}}</text>
            <text class="ai-import-summary__label">已匹配</text>
          </view>
          <view class="ai-import-summary__item">
            <text class="ai-import-summary__value ai-import-summary__value--orange">{{aiImportPreview.summary.unresolvedDishRows}}</text>
            <text class="ai-import-summary__label">待处理</text>
          </view>
          <view class="ai-import-summary__item">
            <text class="ai-import-summary__value">{{aiImportPreview.summary.dateCount}}</text>
            <text class="ai-import-summary__label">营业日</text>
          </view>
        </view>

        <view class="ai-import-section" wx:if="{{aiImportPreview.notices.length > 0}}">
          <view class="ai-import-section__title">识别说明</view>
          <view class="ai-import-notice" wx:for="{{aiImportPreview.notices}}" wx:key="*this">• {{item}}</view>
        </view>

        <view class="ai-import-section" wx:if="{{aiImportPreview.issues.length > 0}}">
          <view class="ai-import-section__title">需要处理（{{aiImportPreview.issues.length}}）</view>
          <view class="ai-import-issue" wx:for="{{aiImportPreview.issues}}" wx:key="index" wx:for-item="problem">
            <view class="ai-import-issue__top">
              <text class="ai-import-issue__dish">{{problem.externalDishName || problem.code}}</text>
              <text class="ai-import-issue__position" wx:if="{{problem.sheetName}}">
                {{problem.sheetName}}{{problem.rowNumber ? ' · 第' + problem.rowNumber + '行' : ''}}
              </text>
            </view>
            <view class="ai-import-issue__message">{{problem.message}}</view>
            <view class="ai-import-issue__action">建议：{{problem.action}}</view>
            <view class="ai-import-candidates" wx:if="{{problem.candidates.length > 0}}">
              <text class="ai-import-candidates__label">可能对应：</text>
              <text class="ai-import-candidate" wx:for="{{problem.candidates}}" wx:key="foodId" wx:for-item="candidate">
                {{candidate.foodName}}{{index < problem.candidates.length - 1 ? '、' : ''}}
              </text>
            </view>
          </view>
        </view>

        <view class="ai-import-section" wx:if="{{aiImportPreview.dailyRows.length > 0}}">
          <view class="ai-import-section__title">营业额核对</view>
          <view class="ai-import-day" wx:for="{{aiImportPreview.dailyRows}}" wx:key="date" wx:for-item="day">
            <view class="ai-import-day__top">
              <text class="ai-import-day__date">{{day.date}}</text>
              <text class="ai-import-day__status {{day.status === 'READY' ? 'is-ready' : 'is-error'}}">
                {{day.status === 'READY' ? '已核对' : '有问题'}}
              </text>
            </view>
            <view class="ai-import-day__numbers">
              <text>菜品 {{day.dishCount}} 道</text>
              <text>菜品营业额 ¥{{day.calculatedDineInRevenue}}</text>
              <text>总营业额 ¥{{day.calculatedTotalRevenue}}</text>
            </view>
            <view class="ai-import-day__declared" wx:if="{{day.declaredTotalRevenue !== null}}">
              Excel合计 ¥{{day.declaredTotalRevenue}}
              <text wx:if="{{day.difference !== null}}"> · 差额 ¥{{day.difference}}</text>
            </view>
          </view>
        </view>

        <view class="ai-import-section" wx:if="{{aiImportPreview.dishRows.length > 0}}">
          <view class="ai-import-section__title">菜品识别明细</view>
          <view class="ai-import-dish" wx:for="{{aiImportPreview.dishRows}}" wx:key="index" wx:for-item="dish">
            <view class="ai-import-dish__main">
              <view class="ai-import-dish__name">
                <text>{{dish.externalDishName}}</text>
                <text class="ai-import-dish__arrow" wx:if="{{dish.systemDishName}}"> → {{dish.systemDishName}}</text>
              </view>
              <text class="ai-import-dish__status {{dish.status === 'MATCHED' ? 'is-ready' : 'is-error'}}">
                {{dish.status === 'MATCHED' ? '已匹配' : '未通过'}}
              </text>
            </view>
            <view class="ai-import-dish__meta">
              {{dish.date || '日期未识别'}} · 销量 {{dish.quantity || '-'}}
              <text wx:if="{{dish.unitPrice !== null}}"> · ¥{{dish.unitPrice}}/份</text>
              <text wx:if="{{dish.lineAmount !== null}}"> · ¥{{dish.lineAmount}}</text>
            </view>
          </view>
        </view>

        <view class="ai-import-scroll-bottom"></view>
      </scroll-view>

      <view class="ai-import-footer" wx:if="{{aiImportPreview.canCommit}}">
        <view class="ai-import-footer__ghost" bindtap="onCloseAiImportPreview">取消</view>
        <view class="ai-import-footer__primary" bindtap="onCommitAiImport">
          {{aiImportSubmitting ? '正在导入...' : '确认导入'}}
        </view>
      </view>
      <view class="ai-import-footer" wx:else>
        <view class="ai-import-footer__ghost" bindtap="onOpenAiImportFailureReport">下载错误明细</view>
        <view class="ai-import-footer__primary" bindtap="onRetryAiImport">修改后重新上传</view>
      </view>
    </view>
  </view>

</view>
