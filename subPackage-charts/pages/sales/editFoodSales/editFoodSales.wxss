/* ========== 页面基础 ========== */
.page-food-sales-view {
  min-height: 100vh;
  background: #f5f6fa;
}

.page-body {
  padding: 20rpx;
}

/* ========== 日期栏 ========== */
.date-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.date-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.date-icon {
  width: 40rpx;
  height: 40rpx;
}

.date-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.week-text {
  font-size: 28rpx;
  color: #666;
}

.arrow-down {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.5;
}

.status-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.status-tag--pending {
  background: #fff7ed;
  color: #d97706;
  border: 1rpx solid #fcd34d;
}

.status-tag--done {
  background: #ecfdf5;
  color: #059669;
  border: 1rpx solid #6ee7b7;
}

.status-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.6;
}

/* ========== 区块标题 ========== */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-bar {
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #22c55e 0%, #16a34a 100%);
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.section-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.section-hint {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.hint-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 1.5rpx solid #999;
  font-size: 20rpx;
  color: #999;
  text-align: center;
  line-height: 26rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #999;
}

/* ========== 经营总账网格 ========== */
.revenue-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.revenue-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rg-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.rg-card {
  flex: 1;
  min-width: 0;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.rg-card__header {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rg-card__icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.rg-card__label {
  font-size: 24rpx;
  color: #666;
  line-height: 1.2;
}

.rg-card__value {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
  word-break: break-all;
}

.rg-card__unit {
  font-size: 22rpx;
  font-weight: 400;
  color: inherit;
  margin-left: 2rpx;
}

.rg-card__value--green { color: #16a34a; }
.rg-card__value--blue { color: #2563eb; }
.rg-card__value--orange { color: #ea580c; }
.rg-card__value--purple { color: #9333ea; }

/* ========== 菜品区域 ========== */
.dish-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.sub-dep-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.sub-dep-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.sub-dep-count {
  font-size: 24rpx;
  color: #999;
}

/* ========== 菜品分类标题 ========== */
.food-category-title {
  display: flex;
  align-items: center;
  padding: 12rpx 0 12rpx 8rpx;
}

.food-category-bar {
  width: 6rpx;
  height: 28rpx;
  background: #22c55e;
  border-radius: 3rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.food-category-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.dish-list {
  display: flex;
  flex-direction: column;
}

.dish-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.dish-row:last-child {
  border-bottom: none;
}

.dish-row--empty .dish-name {
  color: #999;
}

.dish-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.dish-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.dish-tag--green {
  background: #ecfdf5;
  color: #059669;
}

.dish-tag--purple {
  background: #f3e8ff;
  color: #7c3aed;
}

.dish-tag--orange {
  background: #fff7ed;
  color: #c2410c;
}

.dish-tag__label {
  font-weight: 500;
}

.dish-tag__value {
  font-weight: 700;
}

.dish-sales-amount {
  font-size: 26rpx;
  color: #666;
  margin-left: 8rpx;
}

.dish-empty-text {
  font-size: 26rpx;
  color: #22c55e;
  font-weight: 500;
}

.dish-action {
  flex-shrink: 0;
  margin-left: 20rpx;
}

.edit-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid #22c55e;
  background: #fff;
}

.edit-btn__icon {
  width: 28rpx;
  height: 28rpx;
}

.edit-btn__text {
  font-size: 26rpx;
  color: #22c55e;
  font-weight: 500;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-image {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* ========== 弹窗 ========== */

.meal-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1100;
}

.meal-modal-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.5);
}

.meal-modal-panel {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85vw;
  max-height: 80vh;
  padding: 36rpx 32rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
  box-sizing: border-box;
  z-index: 1101;
  overflow-y: auto;
}

.meal-modal__title {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 28rpx;
}

/* 表单项 */
.meal-form-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.meal-form-item--notes {
  flex-direction: column;
  align-items: stretch;
}

.meal-form-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.meal-form-input {
  flex: 1;
  height: 70rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  background: #fafafa;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.meal-form-readonly {
  background: #f0f0f0;
  color: #333;
}

.meal-dish-name {
  font-weight: 600;
  color: #1a1a1a;
}

.meal-placeholder { color: #bbb; }

/* 类型行 */
.meal-type-inline {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.meal-type-picker {
  flex-direction: row;
  justify-content: space-between;
}

.meal-type-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 18rpx;
  background: #e8f5e9;
  border-radius: 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #2e7d32;
}

.meal-type-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.5;
}

/* 备注 textarea */
.meal-textarea {
  width: 100%;
  min-height: 100rpx;
  padding: 14rpx 20rpx;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #333;
  background: #fafafa;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.meal-textarea-count {
  text-align: right;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #ccc;
}

/* 弹窗按钮 */
.meal-modal-actions {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  margin-top: 28rpx;
}

.meal-btn-cancel,
.meal-btn-confirm {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin: 0;
  padding: 0;
}

.meal-btn-cancel::after,
.meal-btn-confirm::after { border: none; }

.meal-btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.meal-btn-confirm {
  background: #4a9960;
  color: #fff;
}

/* ========== 营收弹窗分区标题 ========== */
.rev-section-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  padding: 8rpx 0 4rpx;
  margin-top: 12rpx;
}

/* ========== 总营业额行 ========== */
.meal-form-item--total {
  border-bottom: none;
  margin-top: 12rpx;
  padding-top: 20rpx;
}

.meal-form-label--total {
  font-weight: 700;
  color: #333;
}

.meal-total-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #16a34a;
}
