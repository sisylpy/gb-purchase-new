<wxs src="/wxs/format.wxs" module="tool" />
<wxs src="./costTab.wxs" module="costTab" />


<view class="page-root flex flex-column">

  <block wx:if="{{greatId != -1}}">
    <back-navbar-search style="height: {{navBarHeight}}rpx;" titleLarge="{{name}}" title="" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack" isScrolled="{{isScrolled}}" tabIndex="{{tab1Index}}" bindtabclick="onNavTabClick" pageType="cost">
    </back-navbar-search>
  </block>

  <block wx:else>
    <back-navbar-search style="height: {{navBarHeight}}rpx;" titleLarge="{{value}}元" title="" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack" isScrolled="{{isScrolled}}" tabIndex="{{tab1Index}}" bindtabclick="onNavTabClick" pageType="cost">
    </back-navbar-search>
  </block>
  

  <view class="date-bar flex-row-between pl-20 pr-20 border-bottom bg-white {{isScrolled ? 'hidden' : ''}}">
    <view class="flex-row">
      <view class="p-20" bindtap="toDatePageSearch">
        <image src="../../../../images/calender.png" class="icon"></image>
      </view>
      <view class="flex-column pt-10">
        <view class="font-yuan">{{hanzi}}</view>
        <view class="flex-row" wx:if="{{startDate == stopDate}}">
          <view class="font-md" wx:if="{{startDate}}">{{tool.transferDateString(startDate)}}</view>
        </view>
        <view class="flex-row" wx:else>
          <view wx:if="{{startDate}}">{{tool.transferDateString(startDate)}}</view>
          <text class="plr-10">-</text>
          <view wx:if="{{stopDate}}">{{tool.transferDateString(stopDate)}}</view>
        </view>
      </view>
    </view>
  </view>

  <scroll-view
    class="page-scroll"
    scroll-y="{{true}}"
    style="height: {{isScrolled ? scrollViewHeightCollapsed : scrollViewHeight}}rpx;"
    bindscrolltolower="onReachBottom"
    bindscroll="onScroll">

    <view class="cost-stats-board">
      <view class="cost-stats-row cost-stats-row--top">
        <view
          wx:for="{{costTabCards}}"
          wx:key="type"
          wx:if="{{item.row === 'top'}}"
          class="cost-stat-card cost-stat-card--top {{tab1Index == item.index ? 'cost-stat-card--active' : ''}}"
          data-index="{{item.index}}"
          data-type="{{item.type}}"
          bindtap="onTab1Click"
          hover-class="cost-stat-card--hover">
          <view class="cost-stat-icon {{item.iconClass}}">
            <image src="{{item.icon}}" class="cost-stat-icon-img" mode="aspectFit"></image>
          </view>
          <text class="cost-stat-title">{{item.title}}</text>
          <text class="cost-stat-amount">{{item.total}}元</text>
          <text class="cost-stat-count">商品{{item.count}}个</text>
        </view>
      </view>

      <view class="cost-stats-row cost-stats-row--bottom">
        <view
          wx:for="{{costTabCards}}"
          wx:key="type"
          wx:if="{{item.row === 'bottom'}}"
          class="cost-stat-card cost-stat-card--bottom {{tab1Index == item.index ? 'cost-stat-card--active' : ''}}"
          data-index="{{item.index}}"
          data-type="{{item.type}}"
          bindtap="onTab1Click"
          hover-class="cost-stat-card--hover">
          <view class="cost-stat-card-head">
            <view class="cost-stat-icon {{item.iconClass}}">
              <image src="{{item.icon}}" class="cost-stat-icon-img" mode="aspectFit"></image>
            </view>
            <text class="cost-stat-title cost-stat-title--inline">{{item.title}}</text>
          </view>
          <text class="cost-stat-amount">{{item.total}}元</text>
          <text class="cost-stat-count">商品{{item.count}}个</text>
        </view>
      </view>
    </view>

    <view class="goods-list" wx:if="{{produceArr.length > 0}}">
      <view
        id="goods-container-{{goodsIndex}}"
        class="goods-item flex-column p-20 bg-white border-bottom"
        wx:for="{{produceArr}}"
        wx:for-index="goodsIndex"
        wx:key="gbDistributerGoodsId">

        <view class="flex-row-between" bind:tap="showList" data-index="{{goodsIndex}}">
          <view class="flex-row-default mb-20">
            <image src="{{(url + item.gbDgNxFatherImg || '/images/logo.png')}}" mode="aspectFill" class="url mr-20" />
            <view class="flex-column" style="flex: 1;">
              <view class="flex-row">
                <text class="font-sm">第{{goodsIndex + 1}}名/共{{totalCount}}个</text>
              </view>
              <view class="flex-row">
                <text class="font-bold mr-10">{{item.gbDgGoodsName}}</text>
                <block wx:if="{{item.gbDgGoodsStandardWeight.length > 0}}">
                  <text class="text-secondary font-sl">({{item.gbDgGoodsStandardWeight}}/{{item.gbDgGoodsStandardname}})</text>
                </block>
                <block wx:else>
                  <text class="text-secondary font-sl">({{item.gbDgGoodsStandardname}})</text>
                </block>
              </view>
            </view>
          </view>

          <view class="goods-price-section">
            <view class="price-container {{costTab.lineTypeClass(tab1Index)}}">
              <text class="price-label">{{costTab.lineLabel(tab1Index)}}</text>
              <text class="price-value">¥{{costTab.lineAmount(tab1Index, item)}}</text>
            </view>
            <view class="arrow-container {{item.showCostList ? 'expanded' : 'collapsed'}}">
              <image src="/images/arrow-right-3.png" mode="aspectFill" class="icon" style="width: 24rpx; height: 24rpx;" />
            </view>
          </view>
        </view>

        <view wx:if="{{item.showCostList}}" class="flex-column" wx:for="{{item.wasteDepartmentEntities}}" wx:key="gbDepartmentId" wx:for-item="dep" wx:for-index="depIndex">
          <view class="flex-column font-sl mb-20" wx:for="{{dep.wasteReduceList}}" wx:for-item="reduceDay" wx:for-index="reduceIndex" wx:key="reduceIndex">
            <view class="unified-card-container {{expandedRows[goodsIndex + '_' + depIndex + '_' + reduceIndex] ? 'unified-card-expanded' : 'unified-card-collapsed'}}">
              <view id="src-{{goodsIndex}}-{{depIndex}}-{{reduceIndex}}" class="stock-row-container" data-index="{{reduceIndex}}" data-item-index="{{goodsIndex}}" data-day-index="{{depIndex}}">
                <view class="stock-row {{expandedRows[goodsIndex + '_' + depIndex + '_' + reduceIndex] ? 'stock-row-active' : ''}}" bind:tap="showOne" data-index="{{reduceIndex}}" data-item-index="{{goodsIndex}}" data-day-index="{{depIndex}}">
                  <view class="stock-info-left">
                    <view class="stock-department">{{dep.gbDepartmentName}}</view>
                    <view class="stock-date">{{tool.transferDateString(reduceDay.gbDgsrDate)}}</view>
                  </view>
                  <view class="stock-info-center">
                    <view class="stock-amount">{{reduceDay.gbDgsrSubtotal}}元</view>
                    <view class="stock-quantity">{{reduceDay.gbDgsrWeight}}{{item.gbDgGoodsStandardname}}</view>
                    <block wx:if="{{reduceDay.gbDgsrType == 1}}">
                      <view class="stock-type sales-type">售出</view>
                    </block>
                    <block wx:if="{{reduceDay.gbDgsrType == 2}}">
                      <view class="stock-type waste-type">废弃</view>
                    </block>
                    <block wx:if="{{reduceDay.gbDgsrType == 3}}">
                      <view class="stock-type loss-type">损耗</view>
                    </block>
                    <block wx:if="{{reduceDay.gbDgsrType == 4}}">
                      <view class="stock-type return-type">退货</view>
                    </block>
                    <block wx:if="{{reduceDay.gbDgsrType == 6}}">
                      <view class="stock-type employee-meal-type">员工餐</view>
                    </block>
                  </view>
                  <view class="stock-info-right">
                    <view class="stock-arrow">
                      <image src="/images/arrow-right-3.png" mode="aspectFill" class="icon {{expandedRows[goodsIndex + '_' + depIndex + '_' + reduceIndex] ? 'expanded' : 'collapsed'}}" />
                    </view>
                  </view>
                </view>
              </view>

              <view wx:if="{{expandedRows[goodsIndex + '_' + depIndex + '_' + reduceIndex]}}" class="purchase-info-card expandable-content expanded">
                <view class="section-divider"></view>
                <view class="purchase-info-card">
                  <view class="purchase-detail-section">
                    <view class="stock-info-row">
                      <view class="purchase-info">
                        <text class="font-bold">{{tool.transferDateString(reduceDay.gbDepartmentGoodsStockEntity.gbDgsDate)}}</text>
                        <block wx:if="{{reduceDay.gbDepartmentGoodsStockEntity.purchaseGoodsEntity.gbDpgPurchaseType == 1}}">
                          <text class="purchase-type">{{reduceDay.gbDepartmentGoodsStockEntity.purchaseGoodsEntity.purchaseDepartmentUser.gbDuWxNickName}}</text>
                        </block>
                        <block wx:else>
                          <text class="purchase-type">{{reduceDay.gbDepartmentGoodsStockEntity.purchaseGoodsEntity.nxJrdhSupplierEntity.nxJrdhsSupplierName}}</text>
                        </block>
                      </view>
                      <view class="comparison-divider"></view>
                      <view class="purchase-info purchase-inbound">
                        <view class="column-label purchase-price">单价</view>
                        <view class="column-content">
                          <view class="amount-text">{{reduceDay.gbDepartmentGoodsStockEntity.purchaseGoodsEntity.gbDpgBuyPrice}}元/{{item.gbDgGoodsStandardname}}</view>
                          <block wx:if="{{reduceDay.gbDepartmentGoodsStockEntity.purchaseGoodsEntity.purchaseDepartmentUser !== null}}">
                            <text class="weight-text purchase-price">{{reduceDay.gbDepartmentGoodsStockEntity.purchaseGoodsEntity.purchaseDepartmentUser.gbDuWxNickName}}</text>
                          </block>
                          <block wx:elif="{{reduceDay.gbDepartmentGoodsStockEntity.purchaseGoodsEntity.nxJrdhSupplierEntity !== null}}">
                            <text class="weight-text">{{reduceDay.gbDepartmentGoodsStockEntity.purchaseGoodsEntity.nxJrdhSupplierEntity.nxJrdhsSupplierName}}</text>
                          </block>
                        </view>
                      </view>
                      <view class="comparison-divider"></view>
                      <view class="stock-comparison-container">
                        <view class="stock-info-column stock-inbound">
                          <view class="column-label">入库</view>
                          <view class="column-content">
                            <text class="amount-text purchase-amount">{{reduceDay.gbDepartmentGoodsStockEntity.gbDgsSubtotal}}元</text>
                            <text class="weight-text">{{reduceDay.gbDepartmentGoodsStockEntity.gbDgsWeight}}{{item.gbDgGoodsStandardname}}</text>
                          </view>
                        </view>
                        <view class="comparison-divider"></view>
                        <view class="stock-info-column stock-rest">
                          <view class="column-label">剩余</view>
                          <view class="column-content">
                            <text class="amount-text rest-amount">{{reduceDay.gbDepartmentGoodsStockEntity.gbDgsRestSubtotal}}元</text>
                            <text class="weight-text rest-weight">{{reduceDay.gbDepartmentGoodsStockEntity.gbDgsRestWeight}}{{item.gbDgGoodsStandardname}}</text>
                          </view>
                        </view>
                      </view>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="flex-column center-content text-secondary empty-block" wx:if="{{produceArr.length == 0}}">
      <view class="empty_View flex-column-center">
        <text class="empty-emoji">🌶️</text>
        <text class="big">没有数据啦!</text>
      </view>
    </view>

    <view class="flex-column-center mt-30 text-secondary pagination-bar" wx:if="{{produceArr.length > 0}}">
      <view class="flex-row">
        <text class="pagination-text">共{{totalCount}}条记录,第{{currentPage}}/{{totalPage}}页</text>
      </view>
      <view class="loading-more" wx:if="{{isLoading}}">
        <text class="loading-text">加载中...</text>
      </view>
      <view class="load-more-tip" wx:elif="{{currentPage < totalPage}}">
        <text class="tip-text">上拉加载更多</text>
      </view>
      <view class="load-complete" wx:elif="{{currentPage >= totalPage && totalPage > 0}}">
        <text class="complete-text">已加载全部数据</text>
      </view>
    </view>
  </scroll-view>
</view>
