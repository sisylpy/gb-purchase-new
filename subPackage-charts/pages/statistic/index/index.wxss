


.dateGroupSmall{
  width:100rpx;
  height:110rpx;
  border: 1px solid rgba(211, 211, 211, 0.7) ;
  border-radius: 10rpx;
  text-align: center;
  flex-grow: 0;


}

#week{
  font-size: 26rpx;
  color: red;
  margin-top: 10rpx;
  /* background: green; */
}

#date{
  font-size: 45rpx;
  margin-top: -6rpx;

}

/* 定义hover效果，覆盖内联样式 */
.hover {
  background-color: #f0f0f0 !important;
}

/* ============ 顶部汇总卡片 ============ */
.summary-section {
  padding: 24rpx 24rpx 0;
  background-color: #f5f5f5;
}

.summary-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  padding: 30rpx 24rpx;
}

.summary-card-body {
  display: flex;
  flex-direction: row;
  align-items: stretch;
}

.summary-col {
  flex: 1;
  min-width: 0;
  padding: 0 12rpx;
  display: flex;
  flex-direction: column;
}

.summary-col-rows {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.summary-col--purchase .summary-col-rows,
.summary-col--cost .summary-col-rows {
  gap: 12rpx;
}

.summary-row--avg {
  background-color: rgba(0, 122, 255, 0.08);
  border-radius: 12rpx;
  padding: 16rpx 14rpx;
  border-bottom: none;
}

.summary-col--cost .summary-row--avg {
  background-color: rgba(5, 192, 167, 0.1);
}

.summary-row--tap {
  background-color: #ffffff;
  border: 1rpx solid #ececec;
  border-radius: 12rpx;
  padding: 16rpx 14rpx;
  border-bottom: none;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.summary-row--hover {
  background-color: #f8f8f8;
}

.summary-row-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.summary-row-arrow {
  width: 20rpx;
  height: 20rpx;
  margin-left: 8rpx;
  opacity: 0.45;
}

.summary-row--last {
  border-bottom: none;
  padding-bottom: 0;
}

.summary-col-divider {
  width: 1rpx;
  background-color: #f0f0f0;
  margin: 8rpx 0;
  flex-shrink: 0;
}

.summary-col-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20rpx;
}

.summary-col-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.summary-col-icon--purchase {
  background-color: rgba(0, 122, 255, 0.1);
}

.summary-col-icon--cost {
  background-color: rgba(5, 192, 167, 0.12);
}

.summary-col-icon-img {
  width: 28rpx;
  height: 28rpx;
}

.summary-col-title {
  font-size: 30rpx;
  font-weight: 600;
}

.summary-col-title--purchase {
  color: #007aff;
}

.summary-col-title--cost {
  color: #05c0a7;
}

.summary-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.summary-row--stretch {
  flex: 1;
  align-items: flex-start;
  padding-top: 12rpx;
  padding-bottom: 12rpx;
}

.summary-row-label {
  font-size: 26rpx;
  color: #666666;
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}

.summary-row-value {
  font-size: 30rpx;
  font-weight: 600;
  flex-shrink: 0;
  text-align: right;
}

.summary-row-value--purchase {
  color: #007aff;
}

.summary-row-value--cost {
  color: #05c0a7;
}

.summary-row-value--return {
  color: #f5576c;
}

.summary-row-value--meal {
  color: #ff9500;
}

.summary-chart-wrap {
  height: 400rpx;
  margin-top: 20rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.summary-chart {
  width: 100%;
  height: 100%;
}

/* ============ 每日左右卡片 ============ */
.daily-cards-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 20rpx;
}

.daily-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

/* ============ 每日采购卡片 ============ */
.daily-purchase-card {
  flex: 1;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  padding: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.daily-purchase-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 0;
}

.daily-purchase-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.daily-purchase-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 12rpx;
  flex-shrink: 0;
}

.daily-purchase-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.daily-purchase-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333366;
}

.daily-purchase-rows {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  min-height: 0;
}

.daily-purchase-section:first-child .daily-purchase-rows {
  min-height: 0;
}

.daily-purchase-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0;
}

.daily-purchase-label {
  font-size: 26rpx;
  color: #666666;
}

.daily-purchase-value {
  font-size: 26rpx;
  color: #333333;
}

/* ============ 每日支出卡片 ============ */
.daily-cost-card {
  flex: 1;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  padding: 20rpx 20rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.daily-cost-header {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.daily-cost-header-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.daily-cost-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.daily-cost-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.daily-cost-underline {
  width: 36rpx;
  height: 6rpx;
  background-color: #e54d42;
  border-radius: 3rpx;
  margin-top: 4rpx;
}

.daily-cost-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e54d42;
  line-height: 40rpx;
}

.daily-cost-grid {
  border: 1rpx solid #eeeeee;
  border-radius: 8rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.daily-cost-grid-row {
  display: flex;
  flex-direction: row;
  border-bottom: 1rpx solid #eeeeee;
}

.daily-cost-grid-row:last-child {
  border-bottom: none;
}

.daily-cost-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 6rpx;
  border-right: 1rpx solid #eeeeee;
  box-sizing: border-box;
}

.daily-cost-cell--last {
  border-right: none;
}

.daily-cost-cell--half {
  flex: 1;
}

.daily-cost-cell-label {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 4rpx;
  line-height: 1.2;
}

.daily-cost-cell-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.2;
}

.daily-cost-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx -20rpx 0;
  padding: 12rpx 20rpx;
  background-color: rgba(229, 77, 66, 0.08);
  flex-shrink: 0;
}

.daily-cost-footer-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #e54d42;
}

.daily-cost-footer-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #e54d42;
}
