<wxs src="/wxs/format.wxs" module="tool" />


<view class="flex flex-column">


  <back-navbar title="日看板" style="height: {{navBarHeight}}rpx;" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <!--  top -->
  <view class=" flex-row-between pl-20 pr-20 border-bottom bg-white">
    <view class="flex-row">
      <view class="p-20" bindtap="toDatePage">
        <image src="../../../../images/calender.png" class="icon"></image>
      </view>
      <view class="flex-column pt-10">
        <view class="font-yuan">{{hanzi}}</view>
        <view class="flex-row" wx:if="{{startDate == stopDate}}">
          <view class=" small" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
        </view>
        <view class="flex-row" wx:else>
          <view class="" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
          <text class="plr-10">-</text>
          <view class="" wx:if="{{stopDate}}">{{tool.transferDateString(stopDate)}}</view>
        </view>
      </view>
    </view>

    <!-- <view class="flex-row p-20" bindtap="toFilterType">
      <image src="{{searchDepId !== -1 ? '../../../../images/filter.png' : '../../../../images/filter-3-fill.png'}}" class="icon mr-20"></image>
    </view> -->
  </view>


  <!-- 供货商和采购员选择显示 -->
  <view class="filter-container" wx:if="{{(selectedSupplierName && selectedSupplierName.length > 0) || (selectedPurUserName && selectedPurUserName.length > 0)}}">
    <view class="filter-row">
      <!-- 供货商选择显示 -->
      <view class="filter-chip" wx:if="{{selectedSupplierName && selectedSupplierName.length > 0}}">
        <text class="filter-text">供货商: {{selectedSupplierName}}</text>
        <view class="filter-delete" bindtap="delSearch">
          <image src="/images/del-2.png" mode="aspectFill" class="delete-icon"></image>
        </view>
      </view>

      <!-- 采购员选择显示 -->
      <view class="filter-chip" wx:if="{{selectedPurUserName && selectedPurUserName.length > 0}}">
        <text class="filter-text">采购员: {{selectedPurUserName}}</text>
        <view class="filter-delete" bindtap="delSearch">
          <image src="/images/del-2.png" mode="aspectFill" class="delete-icon"></image>
        </view>
      </view>
    </view>
  </view>



  <view class="flex-column">
    <view class="flex-column  " wx:if="{{arr.length > 0}}">
      <view class="summary-section">
        <view class="summary-card">
          <view class="summary-card-body">
            <!-- 采购 -->
            <view class="summary-col summary-col--purchase">
              <view class="summary-col-header">
                <view class="summary-col-icon summary-col-icon--purchase">
                  <image src="../../../../images/gouwuche.png" class="summary-col-icon-img" mode="aspectFit"></image>
                </view>
                <text class="summary-col-title summary-col-title--purchase">采购</text>
              </view>
              <view class="summary-col-rows">
                <view class="summary-row summary-row--avg">
                  <text class="summary-row-label">平均采购</text>
                  <text class="summary-row-value summary-row-value--purchase">{{purchasePerDay}}元/天</text>
                </view>
                <view class="summary-row summary-row--tap" bindtap="toSummaryPurchase" data-kind="zicai" hover-class="summary-row--hover">
                  <text class="summary-row-label">自采总额</text>
                  <view class="summary-row-right">
                    <text class="summary-row-value summary-row-value--purchase">{{zicaiTotal}}元</text>
                    <image src="/images/arrow-right-3.png" class="summary-row-arrow" mode="aspectFit"></image>
                  </view>
                </view>
                <view class="summary-row summary-row--tap" bindtap="toSummaryPurchase" data-kind="dinghuo" hover-class="summary-row--hover">
                  <text class="summary-row-label">供货商订货总额</text>
                  <view class="summary-row-right">
                    <text class="summary-row-value summary-row-value--purchase">{{dinghuoTotal}}元</text>
                    <image src="/images/arrow-right-3.png" class="summary-row-arrow" mode="aspectFit"></image>
                  </view>
                </view>
                <view class="summary-row summary-row--tap summary-row--last" bindtap="toSummaryPurchase" data-kind="stock" hover-class="summary-row--hover">
                  <text class="summary-row-label">库存总额</text>
                  <view class="summary-row-right">
                    <text class="summary-row-value summary-row-value--purchase">{{restStockTotal}}元</text>
                    <image src="/images/arrow-right-3.png" class="summary-row-arrow" mode="aspectFit"></image>
                  </view>
                </view>
              </view>
            </view>

            <view class="summary-col-divider"></view>

            <!-- 支出 -->
            <view class="summary-col summary-col--cost">
              <view class="summary-col-header">
                <view class="summary-col-icon summary-col-icon--cost">
                  <image src="../../../../images/qiandaizi.png" class="summary-col-icon-img" mode="aspectFit"></image>
                </view>
                <text class="summary-col-title summary-col-title--cost">支出</text>
              </view>
              <view class="summary-col-rows">
                <view class="summary-row summary-row--avg">
                  <text class="summary-row-label">平均支出</text>
                  <text class="summary-row-value summary-row-value--cost">{{costPerDay}}元/天</text>
                </view>
                <view class="summary-row summary-row--tap" bindtap="toSummaryCost" data-kind="sales" hover-class="summary-row--hover">
                  <text class="summary-row-label">制作总额</text>
                  <view class="summary-row-right">
                    <text class="summary-row-value summary-row-value--cost">{{saleCostTotal}}元</text>
                    <image src="/images/arrow-right-3.png" class="summary-row-arrow" mode="aspectFit"></image>
                  </view>
                </view>
                <view class="summary-row summary-row--tap" bindtap="toSummaryCost" data-kind="loss" hover-class="summary-row--hover">
                  <text class="summary-row-label">损耗废弃总额</text>
                  <view class="summary-row-right">
                    <text class="summary-row-value summary-row-value--cost">{{lossWasteTotal}}元</text>
                    <image src="/images/arrow-right-3.png" class="summary-row-arrow" mode="aspectFit"></image>
                  </view>
                </view>
                <view class="summary-row summary-row--tap" bindtap="toSummaryCost" data-kind="return" hover-class="summary-row--hover">
                  <text class="summary-row-label">退货总额</text>
                  <view class="summary-row-right">
                    <text class="summary-row-value summary-row-value--return">{{returnCostTotal}}元</text>
                    <image src="/images/arrow-right-3.png" class="summary-row-arrow" mode="aspectFit"></image>
                  </view>
                </view>
                <view class="summary-row summary-row--tap summary-row--last" bindtap="toSummaryCost" data-kind="employeeMeal" hover-class="summary-row--hover">
                  <text class="summary-row-label">员工餐</text>
                  <view class="summary-row-right">
                    <text class="summary-row-value summary-row-value--meal">{{employeeMealCostTotal}}元</text>
                    <image src="/images/arrow-right-3.png" class="summary-row-arrow" mode="aspectFit"></image>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="summary-chart-wrap">
          <ec-canvas id="dailyChart" canvas-id="dailyChart" ec="{{ ecDaily }}" class="summary-chart"></ec-canvas>
        </view>
      </view>


      <view class="bg-white">
        <view class="flex-column border-bottom p-20" wx:for="{{arr}}" wx:key="day" style="width: {{windowWidth}}rpx; background-color: #f5f5f5;">

          <!-- 日期显示在顶部 - 按照图片样式 -->
          <view class="flex-row-center mb-20">
            <text class="font-md font-bold" style="color: #333;">{{tool.getMonthDay(item.day)}} {{tool.getWeekDay(item.day)}}</text>
          </view>

          <!-- 主要内容：左右两列 -->
          <view class="daily-cards-row" wx:if="{{item.allStock > 0 || item.costTotal  > 0}}">

            <!-- 左侧：采购列 -->
            <view class="daily-col">
              <view class="daily-purchase-card" bindtap="toPurGoodsFenxi" data-item="{{item}}" hover-class="hover">
                <view class="daily-purchase-body">
                  <view class="daily-purchase-section">
                    <view class="daily-purchase-header">
                      <image src="../../../../images/gouwuche.png" class="daily-purchase-icon" mode="aspectFit"></image>
                      <text class="daily-purchase-title">采购</text>
                    </view>
                    <view class="daily-purchase-rows">
                      <view class="daily-purchase-row">
                        <text class="daily-purchase-label">自采:</text>
                        <text class="daily-purchase-value">{{item.zicai}}元</text>
                      </view>
                      <view class="daily-purchase-row">
                        <text class="daily-purchase-label">订货:</text>
                        <text class="daily-purchase-value">{{item.dinghuo}}元</text>
                      </view>
                    </view>
                  </view>

                  <view class="daily-purchase-section">
                    <view class="daily-purchase-header">
                      <image src="../../../../images/kucun.png" class="daily-purchase-icon" mode="aspectFit"></image>
                      <text class="daily-purchase-title">库存</text>
                    </view>
                    <view class="daily-purchase-rows">
                      <view class="daily-purchase-row">
                        <text class="daily-purchase-label">库存:</text>
                        <text class="daily-purchase-value">{{item.restStock}}元</text>
                      </view>
                    </view>
                  </view>
                </view>
              </view>
            </view>

            <!-- 右侧：支出列 -->
            <view class="flex-column daily-col">
              <view class="daily-cost-card" bind:tap="toFenxiDate" data-index="{{index}}" hover-class="hover">
                <view class="daily-cost-header">
                  <view class="daily-cost-header-icon">
                    <view class="daily-cost-icon-wrap">
                      <image src="../../../../images/qiandaizi.png" class="daily-cost-icon-img" mode="aspectFit"></image>
                    </view>
                    <view class="daily-cost-underline"></view>
                  </view>
                  <text class="daily-cost-title">支出</text>
                </view>

                <view class="daily-cost-grid">
                  <view class="daily-cost-grid-row">
                    <view class="daily-cost-cell">
                      <text class="daily-cost-cell-label">销售</text>
                      <text class="daily-cost-cell-value">{{item.saleCostTotal}}元</text>
                    </view>
                    <view class="daily-cost-cell">
                      <text class="daily-cost-cell-label">损耗</text>
                      <text class="daily-cost-cell-value">{{item.lossCostTotal}}元</text>
                    </view>
                    <view class="daily-cost-cell daily-cost-cell--last">
                      <text class="daily-cost-cell-label">废弃</text>
                      <text class="daily-cost-cell-value">{{item.wasteTotal}}元</text>
                    </view>
                  </view>
                  <view class="daily-cost-grid-row">
                    <view class="daily-cost-cell daily-cost-cell--half">
                      <text class="daily-cost-cell-label">退货</text>
                      <text class="daily-cost-cell-value">{{item.returnCostTotal}}元</text>
                    </view>
                    <view class="daily-cost-cell daily-cost-cell--half daily-cost-cell--last">
                      <text class="daily-cost-cell-label">员工餐</text>
                      <text class="daily-cost-cell-value">{{item.employeeMealCostTotal}}元</text>
                    </view>
                  </view>
                </view>

                <view class="daily-cost-footer">
                  <text class="daily-cost-footer-label">合计:</text>
                  <text class="daily-cost-footer-value">{{item.costTotal}}元</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="text-secondary font-sl flex-column center-content" style="height: 200rpx;">没有数据了！</view>

    </view>



  <view class="" wx:if="{{arr.length == 0}}" style="height: {{windowHeight - 360}}rpx;">

<view class="center-content flex-column" style="padding-top: 200rpx;">
  <image class="empty_image" src="/images/cart-Empty.png"></image>
  <text class="big">无数据</text>
</view>

</view>
<!-- ./empty -->




  </view>

</view>