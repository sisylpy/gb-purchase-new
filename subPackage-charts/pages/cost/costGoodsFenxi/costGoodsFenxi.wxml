<wxs src="../../../../utils/fn.wxs" module="tool" />
<wxs module="imgUrl" src="/wxs/imgUrl.wxs" />
<wxs module="utilLv" src="/wxs/utilizationLevel.wxs" />
<wxs module="num" src="/wxs/signedNumber.wxs" />

<view class="page-root flex flex-column">
  <back-navbar class="flex-shrink-0" style="height: {{navBarHeight}}rpx;" title="配料分析" avatar="/images/back-gray.png"
    button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  
  <!--  top -->
  <view class=" flex-row-between pl-20 pr-20 border-bottom bg-white">
    <view class="flex-row">
      <view class="p-20" bindtap="toDatePage">
        <image src="../../../../images/calender.png" class="icon"></image>
      </view>
      <view class="flex-column pt-10">
        <view class="font-yuan">{{hanzi}}</view>
        <view class="flex-row" wx:if="{{startDate == stopDate}}">
          <view class=" small" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
        </view>
        <view class="flex-row" wx:else>
          <view class="" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
          <text class="plr-10">-</text>
          <view class="" wx:if="{{stopDate}}">{{tool.transferDateString(stopDate)}}</view>
        </view>
      </view>
    </view>
   
    <view class="flex-row p-20" bindtap="onToggleSearchBar">
      <image src="/images/search-3.png" class="icon mr-20 cog-search-top-ico {{goodsNameSearch ? 'cog-search-top-ico--on' : ''}}"></image>
    </view>
  </view>

  <view class="cog-search-panel bg-white border-bottom" wx:if="{{searchBarOpen}}">
    <view class="cog-search-inner">
      <image class="cog-search-inner-ico" src="/images/search-3.png" mode="aspectFit" />
      <input
        class="cog-search-input"
        value="{{goodsNameSearchDraft}}"
        placeholder="搜索配料名称"
        confirm-type="search"
        focus="{{searchInputFocus}}"
        bindinput="onGoodsSearchInput"
        bindconfirm="onGoodsSearchConfirm"
      />
      <text class="cog-search-clear" wx:if="{{goodsNameSearchDraft}}" catchtap="onGoodsSearchClear">×</text>
    </view>
  </view>

  <scroll-view
    id="cogIngredientScroll"
    scroll-y
    class="list-scroll flex-1"
    scroll-top="{{ingredientScrollRestoreTop}}"
    scroll-with-animation="{{false}}"
    bindscroll="onIngredientListScroll"
    bindscrolltolower="onIngredientScrollToLower"
    lower-threshold="100"
  >
    <view class="cog-sum-row" wx:if="{{summary && !goodsNameSearch}}">
      <!-- 出库总额 -->
      <view class="cog-sum-card cog-sum-card--blue">
        <view class="cog-sum-card-hd">
          <view class="cog-sum-icon">￥</view>
          <text class="cog-sum-card-title">出库总额</text>
        </view>
        <text class="cog-sum-card-val">¥{{summary.totalOutboundAmount || '0.00'}}</text>
        <text class="cog-sum-card-foot">员工餐 ¥{{summary.employeeMealTotalAmount || '0.00'}}<text wx:if="{{summary.employeeMealTotalAmount}}" class="cog-sum-foot-info">ⓘ</text></text>
      </view>

      <!-- 核销总额 -->
      <view class="cog-sum-card cog-sum-card--green">
        <view class="cog-sum-card-hd">
          <view class="cog-sum-icon cog-sum-icon--check">✓</view>
          <text class="cog-sum-card-title">核销总额</text>
        </view>
        <text class="cog-sum-card-val">¥{{summary.verifiedTotalAmount || '0.00'}}</text>
        <view class="cog-sum-sub-row">
          <view class="cog-sum-sub-item">
            <text class="cog-sum-sub-cap">制作毛利率</text>
            <text class="cog-sum-sub-val">{{summary.verifiedGrossMarginRate != null ? summary.verifiedGrossMarginRate : '--'}}%</text>
          </view>
          <view class="cog-sum-sub-item">
            <text class="cog-sum-sub-cap">较理论</text>
            <text class="cog-sum-sub-val cog-sum-sub-dev">{{summary.verifiedTheoryDeviationAmount != null ? num.formatSigned(summary.verifiedTheoryDeviationAmount) : '--'}}</text>
          </view>
        </view>
      </view>

      <!-- 非核销总额 -->
      <view class="cog-sum-card cog-sum-card--red">
        <view class="cog-sum-card-hd">
          <view class="cog-sum-icon cog-sum-icon--cross">✕</view>
          <text class="cog-sum-card-title">非核销总额</text>
        </view>
        <text class="cog-sum-card-val">¥{{summary.nonVerifiedTotalAmount || '0.00'}}</text>
        <view class="cog-sum-card-foot">
          <text>不含员工餐</text>
          <text wx:if="{{summary.nonVerifiedDishCount != null}}"> · 未核销菜品 {{summary.nonVerifiedDishCount}} 道</text>
        </view>
      </view>
    </view>

    <!-- 出库去向分布 -->
    <view class="cog-dist-block" wx:if="{{summary && !goodsNameSearch}}">
      <view class="cog-dist-hd">
        <text class="cog-dist-title">出库去向分布</text>
      </view>
      <view class="cog-dist-bar-wrap">
        <view class="cog-dist-bar">
          <view class="cog-dist-seg cog-dist-seg--verified" style="width: {{_distVerifiedPct}}%"></view>
          <view class="cog-dist-seg cog-dist-seg--nonverified" style="width: {{_distNonVerifiedPct}}%"></view>
          <view class="cog-dist-seg cog-dist-seg--meal" style="width: {{_distMealPct}}%"></view>
        </view>
      </view>
      <view class="cog-dist-legend">
        <view class="cog-dist-leg-row">
          <text class="cog-dist-dot cog-dist-dot--verified"></text>
          <text class="cog-dist-leg-lab">核销</text>
          <text class="cog-dist-leg-val">¥{{summary.verifiedTotalAmount || '0.00'}}</text>
          <text class="cog-dist-leg-pct">({{_distVerifiedTxt}})</text>
        </view>
        <view class="cog-dist-leg-row">
          <text class="cog-dist-dot cog-dist-dot--nonverified"></text>
          <text class="cog-dist-leg-lab">未核销</text>
          <text class="cog-dist-leg-val">¥{{summary.nonVerifiedTotalAmount || '0.00'}}</text>
          <text class="cog-dist-leg-pct">({{_distNonVerifiedTxt}})</text>
        </view>
        <view class="cog-dist-leg-row">
          <text class="cog-dist-dot cog-dist-dot--meal"></text>
          <text class="cog-dist-leg-lab">员工餐</text>
          <text class="cog-dist-leg-val">¥{{summary.employeeMealTotalAmount || '0.00'}}</text>
          <text class="cog-dist-leg-pct">({{_distMealTxt}})</text>
        </view>
      </view>
    </view>

    <!-- 核销状态筛选栏（搜索时隐藏） -->
    <view class="cog-vfilter-wrap" wx:if="{{!goodsNameSearch}}">
      <text class="cog-vfilter-label">筛选模式</text>
      <view class="cog-vfilter-chips">
        <view class="cog-vfilter-chip {{verificationStatus === 'all' ? 'is-on' : ''}}" bindtap="onVerificationFilterChange" data-status="all">全部</view>
        <view class="cog-vfilter-chip {{verificationStatus === 'verified' ? 'is-on' : ''}}" bindtap="onVerificationFilterChange" data-status="verified">已核销</view>
        <view class="cog-vfilter-chip {{verificationStatus === 'unverified' ? 'is-on' : ''}}" bindtap="onVerificationFilterChange" data-status="unverified">未核销</view>
        <view class="cog-vfilter-chip {{verificationStatus === 'employeeMeal' ? 'is-on' : ''}}" bindtap="onVerificationFilterChange" data-status="employeeMeal">员工餐</view>
      </view>
    </view>

    <view class="cog-sort-wrap" wx:if="{{ingredientsAnalysis.length && !goodsNameSearch}}">
      <view class="cog-sort-left">
        <view class="cog-sort-arrows">
          <text class="cog-sort-arrow cog-sort-arrow--up {{ingredientSortOrder === 'asc' ? 'is-on' : ''}}">↑</text>
          <text class="cog-sort-arrow cog-sort-arrow--down {{ingredientSortOrder === 'desc' ? 'is-on' : ''}}">↓</text>
        </view>
        <text class="cog-sort-label">排序{{ingredientSortOrder === 'asc' ? '·升序' : '·降序'}}</text>
      </view>
      <scroll-view scroll-x class="cog-sort-scroll" show-scrollbar="{{false}}">
        <view class="cog-sort-chips">
          <view class="cog-sort-chip cog-sort-chip--outbound {{ingredientSortBy === 'outbound' ? 'is-on' : ''}}" bindtap="onIngredientSort" data-sort="outbound">
            <text>出库金额</text>
          </view>
          <view class="cog-sort-chip cog-sort-chip--deviance {{ingredientSortBy === 'deviance' ? 'is-on' : ''}}" bindtap="onIngredientSort" data-sort="deviance">
            <text>偏差率</text>
          </view>
          <view class="cog-sort-chip cog-sort-chip--devianceAmount {{ingredientSortBy === 'devianceAmount' ? 'is-on' : ''}}" bindtap="onIngredientSort" data-sort="devianceAmount">
            <text>偏差金额</text>
            <text class="cog-sort-chip-arrow" wx:if="{{ingredientSortBy === 'devianceAmount'}}">{{ingredientSortOrder === 'asc' ? '↑' : '↓'}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="cog-empty" wx:if="{{!ingredientsAnalysis.length && !loading}}">{{emptyHint || '暂无原料分析数据'}}</view>

    <view class="cog-ing-list">
      <view class="cog-ing-card" wx:for="{{ingredientsAnalysis}}" wx:for-item="goods" wx:key="disGoodsId">
        <!-- 卡片头：图片 + 名称 + 规格 -->
        <view class="cog-ing-hd flex-row">
          <image class="cog-ing-thumb"
            src="{{(url + goods.gbDgGoodsFileImg || '/images/logo.jpg')}}" mode="aspectFill" />
          <view class="cog-ing-hd-body flex-1 min-w-0">
            <view class="flex-row-between">
              <text class="cog-ing-name">{{goods.gbDgGoodsName}}</text>
            </view>
            <text class="cog-ing-spec">{{goods.gbDgGoodsStandardname || '--'}} · ¥{{goods.unitPrice != null ? goods.unitPrice : '0.00'}}</text>
          </view>
        </view>

<!-- 3种排序 -->
<view class="cog-ing-stat4-row">
          <view class="cog-stat4-cell cog-stat4--outbound">
         <text class="cog-stat4-cap">出库金额</text>
         <text>¥{{goods.outboundTotalAmount}}</text>
         </view>
         <view class="cog-stat4-cell cog-stat4--outbound">
         <text class="cog-stat4-cap">偏差率</text>
         <text>{{goods.devianceRate}}%</text>
         </view>
         <view class="cog-stat4-cell cog-stat4--outbound">
          <text  class="cog-stat4-cap">偏差金额</text>
          <text>¥{{goods.diffCostAmount}}</text>
         </view>
         
         
        </view>

        <!-- 四格去向：出库 / 核销 / 未核销 / 员工餐（金额 + 数量） -->
        <view class="cog-ing-stat4-row">
          <view class="cog-stat4-cell cog-stat4--outbound">
            <text class="cog-stat4-cap">出库</text>
            <text class="cog-stat4-valcog-stat4-val ">{{goods.outboundTotalQty}} {{goods.gbDgGoodsStandardname}}</text>
            <text class="cog-stat4-sub">¥{{goods.outboundTotalAmount}}</text>
          </view>
          <view class="cog-stat4-cell cog-stat4--verified">
            <text class="cog-stat4-cap">核销</text>
            <text class="cog-stat4-val">¥{{goods.verifiedAmount != null ? goods.verifiedAmount : '0.00'}}</text>
            <text class="cog-stat4-sub">{{goods.verifiedQty || '0.00'}} {{goods.gbDgGoodsStandardname}}</text>
          </view>
          <view class="cog-stat4-cell cog-stat4--nonverified">
            <text class="cog-stat4-cap">未核销</text>
            <text class="cog-stat4-val">¥{{goods.nonVerifiedAmount != null ? goods.nonVerifiedAmount : '0.00'}}</text>
            <text class="cog-stat4-sub">{{goods.nonVerifiedQty}} {{goods.gbDgGoodsStandardname}}</text>
          </view>
          <view class="cog-stat4-cell cog-stat4--meal">
            <text class="cog-stat4-cap">员工餐</text>
            <text class="cog-stat4-val">¥{{goods.employeeMealAmount != null ? goods.employeeMealAmount : '0.00'}}</text>
            <text class="cog-stat4-sub">{{goods.employeeMealQty || '0.00'}} {{goods.gbDgGoodsStandardname}}</text>
          </view>
        </view>
        

        <!-- <view class="flex-row p-20">
         <view class="flex-column half-row">
         <text>废弃</text>
         <text>{{goods.wasteAmount}}</text>
         <text>{{goods.wasteQty}} {{goods.gbDgGoodsStandardname}}</text>
         </view>
         <view class="flex-column">
          <text>损耗</text>
          <text>¥{{goods.lossAmount}}</text>
          <text>{{goods.lossQty}} {{goods.gbDgGoodsStandardname}}</text>
         </view>
        </view> -->

        <!-- 关联菜品明细 -->
        <view class="cog-sub-hd" bindtap="onToggleIngredientExpand" data-id="{{goods.disGoodsId}}">
          <view class="cog-sub-hd-left">
            <view class="cog-sub-bar"></view>
            <text class="cog-sub-title">关联菜品 ({{(goods.supportedDishes && goods.supportedDishes.length) || 0}})</text>
          </view>
          <text class="cog-sub-arrow">{{expandedDisGoodsId == goods.disGoodsId ? '⌃' : '⌄'}}</text>
        </view>

        <view class="cog-sub-table" wx:if="{{expandedDisGoodsId == goods.disGoodsId}}">
          <view class="cog-tr cog-tr--head">
            <text class="cog-td cog-td--name">菜品名称</text>
            <text class="cog-td">销量(份)</text>
            <text class="cog-td">单份用量({{goods.gbDgGoodsStandardname}})</text>
            <text class="cog-td">理论消耗({{goods.gbDgGoodsStandardname}})</text>
            <text class="cog-td">实际分摊({{goods.gbDgGoodsStandardname}})</text>
            <text class="cog-td cog-td--right">偏差({{goods.gbDgGoodsStandardname}})</text>
          </view>
          <view class="cog-tr" wx:for="{{goods.supportedDishes}}" wx:for-item="row" wx:key="dishId">
            <text class="cog-td cog-td--name">{{row.dishName}}</text>
            <text class="cog-td">{{row.salesPortions}}</text>
            <text class="cog-td">{{row.recipeUnitPerDish}}</text>
            <text class="cog-td">{{row.theoryUsage}}</text>
            <text class="cog-td">{{row.actualUsage}}</text>
            <text class="cog-td cog-td--right {{num.diffClass(row.diffUsage)}}">{{num.formatSigned(row.diffUsage)}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="cog-list-footer" wx:if="{{ingredientsAnalysis.length}}">
      <view wx:if="{{listLoadingMore}}" class="cog-list-footer-text">加载中…</view>
      <view wx:elif="{{!ingredientHasMore}}" class="cog-list-footer-text cog-list-footer-done">已加载全部</view>
    </view>

    <view class="cog-scroll-pad"></view>
  </scroll-view>
</view>
