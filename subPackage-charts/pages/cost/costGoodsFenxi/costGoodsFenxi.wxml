<wxs src="../../../../utils/fn.wxs" module="tool" />
<wxs module="imgUrl" src="/wxs/imgUrl.wxs" />

<view class="page-root flex flex-column">
  <back-navbar class="flex-shrink-0" style="height: {{navBarHeight}}rpx;" title="成本/出库分析" avatar="/images/back-gray.png"
    button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view class="flex-shrink-0 flex-row-between pl-20 pr-20 border-bottom bg-white">
    <view class="flex-row" bindtap="toDatePageSearch">
      <view class="p-20">
        <image src="../../../../images/calender.png" class="icon"></image>
      </view>
      <view class="flex-column pt-10 pb-10">
        <view class="font-yuan">{{hanzi}}</view>
        <view class="flex-row" wx:if="{{startDate == stopDate}}">
          <view class=" text-secondary" wx:if="{{startDate}}">{{tool.transferDateString(startDate)}}</view>
        </view>
        <view class="flex-row" wx:else>
          <view wx:if="{{startDate}}">{{tool.transferDateString(startDate)}}</view>
          <text class="pl-10 pr-10 text-secondary">-</text>
          <view wx:if="{{stopDate}}">{{tool.transferDateString(stopDate)}}</view>
        </view>
      </view>
    </view>
    <view class="cost-report-toolbar flex-row flex-row-items-center pr-20">
      <image class="mode-seg-img mode-seg-img--on"
        src="{{reportKind === 'salesDish' ? '/images/logo.jpg' : '/images/add.png'}}" mode="aspectFit"
        bindtap="onToggleReportKind" />
    </view>
  </view>

