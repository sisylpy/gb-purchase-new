<wxs src="../../../../utils/fn.wxs" module="tool" />
<wxs module="imgUrl" src="/wxs/imgUrl.wxs" />
<wxs module="utilLv" src="/wxs/utilizationLevel.wxs" />
<wxs module="num" src="/wxs/signedNumber.wxs" />

<view class="page-root flex flex-column">
  <back-navbar class="flex-shrink-0" style="height: {{navBarHeight}}rpx;" title="配料分析" avatar="/images/back-gray.png"
    button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  
  <!--  top -->
  <view class=" flex-row-between pl-20 pr-20 border-bottom bg-white">
    <view class="flex-row">
      <view class="p-20" bindtap="toDatePage">
        <image src="../../../../images/calender.png" class="icon"></image>
      </view>
      <view class="flex-column pt-10">
        <view class="font-yuan">{{hanzi}}</view>
        <view class="flex-row" wx:if="{{startDate == stopDate}}">
          <view class=" small" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
        </view>
        <view class="flex-row" wx:else>
          <view class="" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
          <text class="plr-10">-</text>
          <view class="" wx:if="{{stopDate}}">{{tool.transferDateString(stopDate)}}</view>
        </view>
      </view>
    </view>

    <picker
      wx:if="{{subDepPickerRange.length > 1}}"
      mode="selector"
      range="{{subDepPickerRange}}"
      range-key="gbDepartmentName"
      value="{{activeSubDepIndex}}"
      bindchange="onSubDepChange"
    >
      <view class="flex-row p-20">
        <image src="/images/search-3.png" class="icon mr-20 cog-search-top-ico"></image>
        <text class="small">{{activeSubDepName ? activeSubDepName : '子部门'}}</text>
      </view>
    </picker>

    <view class="flex-row p-20" bindtap="onToggleSearchBar">
      <image src="/images/search-3.png" class="icon mr-20 cog-search-top-ico {{goodsNameSearch ? 'cog-search-top-ico--on' : ''}}"></image>
    </view>
  </view>

  <view class="cog-search-panel bg-white border-bottom" wx:if="{{searchBarOpen}}">
    <view class="cog-search-inner">
      <image class="cog-search-inner-ico" src="/images/search-3.png" mode="aspectFit" />
      <input
        class="cog-search-input"
        value="{{goodsNameSearchDraft}}"
        placeholder="搜索配料名称"
        confirm-type="search"
        focus="{{searchInputFocus}}"
        bindinput="onGoodsSearchInput"
        bindconfirm="onGoodsSearchConfirm"
      />
      <text class="cog-search-clear" wx:if="{{goodsNameSearchDraft}}" catchtap="onGoodsSearchClear">×</text>
    </view>
  </view>

  <scroll-view
    id="cogIngredientScroll"
    scroll-y
    class="list-scroll flex-1"
    scroll-top="{{ingredientScrollRestoreTop}}"
    scroll-with-animation="{{false}}"
    bindscroll="onIngredientListScroll"
    bindscrolltolower="onIngredientScrollToLower"
    lower-threshold="100"
  >
    <view class="cog-sum-row" wx:if="{{summary}}">
      <view class="cog-sum-card cog-sum-card--blue">
        <view class="cog-sum-card-hd">
          <view class="cog-sum-icon">￥</view>
          <text class="cog-sum-card-title">出库总金额</text>
        </view>
        <text class="cog-sum-card-val">¥ {{summary.totalOutboundAmount}}</text>
        <text class="cog-sum-card-foot cog-sum-card-foot--muted">本期所选日期范围</text>
      </view>
      <view class="cog-sum-card cog-sum-card--orange">
        <view class="cog-sum-card-hd">
          <view class="cog-sum-icon">%</view>
          <text class="cog-sum-card-title">平均利用率</text>
        </view>
        <view class="cog-sum-val-row">
          <text class="cog-sum-card-val">{{summary.averageUtilizationRate}}</text>
          <text class="cog-sum-card-suf">%</text>
          <view class="cog-sum-pill" wx:if="{{summary.averageUtilizationRate}}">
            <text class="{{utilLv.textClassFromRate(summary.averageUtilizationRate)}}">{{utilLv.labelZhFromRate(summary.averageUtilizationRate)}}</text>
          </view>
        </view>
        <text class="cog-sum-card-foot cog-sum-card-foot--muted">按区间原料利用率汇总</text>
      </view>

      <view class="cog-sum-card cog-sum-card--abnormal">
        <view class="cog-sum-card-hd">
          <view class="cog-sum-icon cog-sum-icon--bell">!</view>
          <text class="cog-sum-card-title">异常菜品</text>
        </view>
        <text class="cog-sum-card-val cog-sum-card-val--abnormal">{{summary.abnormalIngredientCount || 0}}<text class="cog-sum-card-ing-unit"> 道</text></text>
        <view class="cog-sum-card-foot cog-abnormal-foot">
          <text class="cog-abnormal-foot-muted">较上月</text>
          <block wx:if="{{num.signKind(summary.abnormalIngredientMomDelta) == 'zero' || num.signKind(summary.abnormalIngredientMomDelta) == 'na'}}">
            <text class="cog-abnormal-foot-flat"> 持平</text>
          </block>
          <block wx:else>
            <text class="cog-abnormal-foot-delta {{num.momDeltaClassIng(summary.abnormalIngredientMomDelta)}}"> {{num.momArrowIng(summary.abnormalIngredientMomDelta)}} {{num.momAbsKinds(summary.abnormalIngredientMomDelta)}}</text>
          </block>
        </view>
      </view>

    </view>


    <view class="cog-util-dist" wx:if="{{utilizationDistribution && utilizationDistribution.buckets && utilizationDistribution.buckets.length}}">
      <view class="cog-util-dist-title">利用率分布（共{{utilizationDistribution.totalKindsWithUtilization}}种配料）</view>
      <view class="cog-util-dist-body">
        <view class="cog-util-dist-chart">
          <ec-canvas id="utilDonut" canvas-id="utilDonut" ec="{{ ecUtil }}" class="cog-util-ec"></ec-canvas>
        </view>
        <view class="cog-util-dist-legend">
          <view class="cog-util-legend-row" wx:for="{{utilizationDistribution.buckets}}" wx:key="index">
            <view class="cog-util-legend-dot cog-util-legend-dot--{{item.level}}"></view>
            <view class="cog-util-legend-mid">
              <text class="cog-util-legend-name">{{item.labelZh}}</text>
              <text class="cog-util-legend-range">{{item.rangeZh}}</text>
            </view>
            <view class="cog-util-legend-right">
              <text class="cog-util-legend-count">{{item.count}} 种</text>
              <text class="cog-util-legend-pct">{{item.percentOfKinds}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="cog-empty" wx:if="{{!ingredientsAnalysis.length && !loading}}">{{emptyHint || '暂无原料分析数据'}}</view>

    <view class="cog-sort-wrap">
      <view class="cog-sort-left">
        <view class="cog-sort-arrows">
          <text class="cog-sort-arrow cog-sort-arrow--up {{ingredientSortOrder === 'asc' ? 'is-on' : ''}}">↑</text>
          <text class="cog-sort-arrow cog-sort-arrow--down {{ingredientSortOrder === 'desc' ? 'is-on' : ''}}">↓</text>
        </view>
        <text class="cog-sort-label">排序{{ingredientSortOrder === 'asc' ? '·升序' : '·降序'}}</text>
      </view>
      <scroll-view scroll-x class="cog-sort-scroll" show-scrollbar="{{false}}">
        <view class="cog-sort-chips">
          <view class="cog-sort-chip cog-sort-chip--outbound {{ingredientSortBy === 'outbound' ? 'is-on' : ''}}" bindtap="onIngredientSort" data-sort="outbound">
            <text class="cog-sort-chip-ico">￥</text>
            <text>出库金额</text>
          </view>
          <view class="cog-sort-chip cog-sort-chip--util {{ingredientSortBy === 'util' ? 'is-on' : ''}}" bindtap="onIngredientSort" data-sort="util">
            <text class="cog-sort-chip-ico">%</text>
            <text>制作率</text>
          </view>
          <view class="cog-sort-chip cog-sort-chip--wasteloss {{ingredientSortBy === 'wasteloss' ? 'is-on' : ''}}" bindtap="onIngredientSort" data-sort="wasteloss">
            <text class="cog-sort-chip-ico">◇</text>
            <text>损耗损失</text>
          </view>
        </view>
      </scroll-view>
      <!-- <view class="cog-sort-filter" bindtap="onIngredientFilter">
        <text class="cog-sort-filter-ico">⏷</text>
        <text>筛选</text>
      </view> -->
    </view>

    <view class="cog-ing-list">
      <view class="cog-ing-card" wx:for="{{ingredientsAnalysis}}" wx:for-item="goods" wx:key="disGoodsId">
        <view class="cog-ing-main flex-row">
          <image class="cog-ing-thumb"
            src="{{(imgUrl.resolve(url, goods.gbDgGoodsFileImg) || '/images/logo.jpg')}}" mode="aspectFill" />
          <view class="cog-ing-body flex-1 min-w-0">
            <view class="cog-ing-title-row flex-row-between">
              <text class="cog-ing-name">{{goods.gbDgGoodsName}}</text>
              <view class="cog-ing-util flex-row flex-row-items-center">
                <text class="cog-ing-util-lab">制作率</text>
                <text class="cog-ing-util-num">{{goods.utilizationRate}}</text>
                <text class="cog-ing-util-pct">%</text>
                <view class="cog-ing-pill" wx:if="{{goods.utilization || goods.utilizationRate}}">
                  <text class="{{goods.utilization ? utilLv.textClass(goods.utilization.level) : utilLv.textClassFromRate(goods.utilizationRate)}}">{{goods.utilization ? goods.utilization.labelZh : utilLv.labelZhFromRate(goods.utilizationRate)}}</text>
                </view>
              </view>
            </view>

            <view class="cog-stat-row">
              <view class="cog-stat-cell">
                <text class="cog-stat-cap">理论用量</text>
                <text class="cog-stat-val">{{goods.theoryUsage}}</text>
                <text class="cog-stat-unit">{{goods.gbDgGoodsStandardname}}</text>
              </view>
              <view class="cog-stat-cell">
                <text class="cog-stat-cap">实际出库</text>
                <text class="cog-stat-val">{{goods.actualUsage}}</text>
                <text class="cog-stat-unit">{{goods.gbDgGoodsStandardname}}</text>
              </view>
              <view class="cog-stat-cell">
                <text class="cog-stat-cap">差异</text>
                <text class="cog-stat-val {{num.diffClass(goods.diffUsage)}}">{{num.formatSigned(goods.diffUsage)}}</text>
                <text class="cog-stat-unit">{{goods.gbDgGoodsStandardname}}</text>
              </view>
              <view class="cog-stat-cell {{num.costCellExtra(goods.diffCostAmount)}}">
                <text class="cog-stat-cap">成本差异</text>
                <text class="cog-stat-val {{num.diffClass(goods.diffCostAmount)}}">{{num.formatSigned(goods.diffCostAmount)}}</text>
                <text class="cog-stat-unit">元</text>
              </view>
            </view>
          </view>
        </view>

        <view class="cog-sub-hd" bindtap="onToggleIngredientExpand" data-id="{{goods.disGoodsId}}">
          <view class="cog-sub-hd-left">
            <view class="cog-sub-bar"></view>
            <text class="cog-sub-title">关联菜品明细</text>
          </view>
          <text class="cog-sub-arrow">{{expandedDisGoodsId == goods.disGoodsId ? '⌃' : '⌄'}}</text>
        </view>

        <view class="cog-sub-table" wx:if="{{expandedDisGoodsId == goods.disGoodsId}}">
          <view class="cog-tr cog-tr--head">
            <text class="cog-td cog-td--name">菜品名称</text>
            <text class="cog-td">销量(份)</text>
            <text class="cog-td">单份用量({{goods.gbDgGoodsStandardname}})</text>
            <text class="cog-td">理论消耗({{goods.gbDgGoodsStandardname}})</text>
            <text class="cog-td">实际分摊({{goods.gbDgGoodsStandardname}})</text>
            <text class="cog-td cog-td--right">偏差({{goods.gbDgGoodsStandardname}})</text>
          </view>
          <view class="cog-tr" wx:for="{{goods.supportedDishes}}" wx:for-item="row" wx:key="dishId">
            <text class="cog-td cog-td--name">{{row.dishName}}</text>
            <text class="cog-td">{{row.salesPortions}}</text>
            <text class="cog-td">{{row.recipeUnitPerDish}}</text>
            <text class="cog-td">{{row.theoryUsage}}</text>
            <text class="cog-td">{{row.actualUsage}}</text>
            <text class="cog-td cog-td--right {{num.diffClass(row.diffUsage)}}">{{num.formatSigned(row.diffUsage)}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="cog-list-footer" wx:if="{{ingredientsAnalysis.length}}">
      <view wx:if="{{listLoadingMore}}" class="cog-list-footer-text">加载中…</view>
      <view wx:elif="{{!ingredientHasMore}}" class="cog-list-footer-text cog-list-footer-done">已加载全部</view>
    </view>

    <view class="cog-scroll-pad"></view>
  </scroll-view>
</view>
