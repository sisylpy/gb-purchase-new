<view class="page"><back-navbar title="配料分析" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar><view class="navbar-spacer" style="height:{{topSpacerHeight}}rpx;flex-shrink:0"></view>
  <view class="datebar" style="flex-shrink:0" bindtap="toDatePage"><image src="/images/calender.png"></image><text class="period">{{hanzi}}</text><text>{{dateText}}</text><text class="arrow">⌄</text><text class="search">⌕</text></view>
  <scroll-view scroll-y class="scroll"><view class="banner"><view><text class="banner-title">看清原料变化</text><text class="banner-title">守住菜品利润</text><text class="banner-sub">发现影响利润的原料问题，</text><text class="banner-sub">让每一份食材都用在刀刃上。</text></view><view class="banner-art"><text>🥕</text><text>🥬🧺</text></view></view>
    <view class="kpis"><view class="kpi blue"><text class="ico">▰</text><text>原料成本</text><text class="value">¥{{summary.totalOutboundAmount || '0.00'}}</text><text class="small">本期消耗</text></view><view class="kpi red"><text class="ico">!</text><text>重点关注</text><text class="value">{{abnormalCount}} 种</text><text class="small">异常原料</text></view><view class="kpi orange"><text class="ico">↗</text><text>价格波动</text><text class="value">{{priceCount}} 种</text><text class="small">上涨 / 下降</text></view><view class="kpi green"><text class="ico">♨</text><text>影响菜品</text><text class="value">{{impactedDishCount}} 道</text><text class="small">关联菜品</text></view></view>
    <view class="panel"><view class="head"><view><text class="head-title">▥ 原料问题排行榜</text><text class="head-sub">这些原料正在影响你的经营利润</text></view></view><view class="tabs"><text class="{{rankingMode=='impact'?'active':''}}" data-mode="impact" bindtap="switchRanking">影响经营</text><text class="{{rankingMode=='price'?'active':''}}" data-mode="price" bindtap="switchRanking">价格波动</text><text class="{{rankingMode=='deviance'?'active':''}}" data-mode="deviance" bindtap="switchRanking">消耗偏差</text></view><view class="rank" wx:for="{{ranking}}" wx:key="disGoodsId" data-index="{{index}}" bindtap="toDetail"><text class="no n{{index}}">{{index+1}}</text><image src="{{item.imageUrl}}" mode="aspectFill"></image><text class="name">{{item.name}}</text><view class="impact"><text class="small">成本影响</text><text class="strong">¥{{item.amountText}}</text></view><text class="badge {{item.tone}}">{{item.statusText}}</text><text class="go">›</text></view><view class="more" bindtap="toList">查看全部原料 ›</view></view>
    <view class="split"><view class="panel structure"><view class="head-title">◕ 原料结构</view><view class="ring"><text>¥{{summary.totalOutboundAmount || 0}}</text><text class="small">原料成本</text></view><view class="legend"><view wx:for="{{structure}}" wx:key="name"><text class="color" style="background:{{item.color}}"></text><text>{{item.name}}</text><text class="strong">{{item.percent}}%</text></view></view></view><view class="panel tips"><view class="head-title">♧ 经营提示</view><view wx:for="{{ranking}}" wx:key="disGoodsId" wx:if="{{index<3}}" class="tip"><text class="dot {{item.tone}}">!</text><view><text class="strong">{{item.name}}{{item.statusText}}</text><text class="small">{{item.dishCount}} 道菜品受影响，建议及时核查。</text></view></view></view></view>
    <view class="slogan">💡　精细化管理每一种原料，就是在为你的利润加分！</view><view class="bottom-space"></view></scroll-view></view>
