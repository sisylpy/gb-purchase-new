/* 图表容器样式 */
.mb-20 {
  margin-bottom: 20rpx;
}

ec-canvas {
  width: 100% !important;
  height: 100% !important;
}

.mt-20 {
  margin-top: 20rpx;
}

.font-sm {
  font-size: 28rpx;
}

.font-xs {
  font-size: 24rpx;
}

.text-gray {
  color: #999;
}

.text-primary {
  color: #007aff;
}

.border-bottom {
  border-bottom: 1rpx solid #f0f0f0;
}

.flex-row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mt-5 {
  margin-top: 10rpx;
}

.expand-btn {
  width: 32rpx;
  height: 32rpx;
  transition: transform 0.3s ease;
}

.goods_item_lg {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
}
