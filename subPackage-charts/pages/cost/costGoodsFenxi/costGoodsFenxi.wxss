}

.dish-summary-line--emph {
  margin-bottom: 0;
  margin-top: 4rpx;
}


.dish-summary-val {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  font-variant-numeric: tabular-nums;
}


.dish-summary-unit {
  font-size: 24rpx;
  color: #888888;
  margin-left: 6rpx;
}

.dish-ing-panel {
  background: #fff0e8;
  border-radius: 16rpx;
  padding: 16rpx 16rpx 8rpx;
  margin-bottom: 0;
}

.dish-ing-title {
  font-size: 22rpx;
  margin-bottom: 12rpx;
}

.dish-ing-panel1 {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.dish-ing-row1 {
  background: #ffffff;
  border-radius: 18rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
  padding: 18rpx 18rpx 16rpx;
}

.ing-card-head {
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.ing-card-title-wrap {
  flex: 1;
  min-width: 0;
  margin-right: 14rpx;
}

.ing-name-line {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
  column-gap: 10rpx;
  row-gap: 4rpx;
}

.ing-name-inline {
  flex: 0 1 auto;
  min-width: 0;
  margin-right: 0;
}

.ing-sigma {
  flex: 0 1 auto;
  font-size: 34rpx;
  line-height: 1.2;
}

/* 调试：与 badge 同色值的小色块；勿用 gap（低版本基础库不支持），用 margin */
.ing-diff-badge-wrap {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  flex-shrink: 0;
}

.ing-diff-debug-compare {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  margin-bottom: -60rpx;
  margin-left: 12rpx;
  max-width: 168rpx;
}

.ing-diff-debug-swatch {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  border: 2rpx solid #d1d5db;
  box-sizing: border-box;
  flex-shrink: 0;
  margin-bottom: 6rpx;
}

.ing-diff-debug-ratio {
  font-size: 18rpx;
  color: #374151;
  line-height: 1.3;
  text-align: center;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.ing-diff-debug-val {
  font-size: 16rpx;
  color: #6b7280;
  line-height: 1.25;
  text-align: center;
  word-wrap: break-word;
  word-break: break-all;
}

.ing-diff-badge {
  width: 170rpx;
  margin-bottom: -60rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  padding: 10rpx 12rpx;
  /* 勿用 background 简写，避免与行内 background-color 叠在一起时底色不生效 */
  background-color: #f4f5f7;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
  display: flex;
  flex-direction: column;
}

.ing-diff-line {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.ing-diff-line:last-child {
  margin-bottom: 0;
}

.ing-diff-key {
  flex-shrink: 0;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

.ing-diff-val {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.25;
}

.ing-diff-line:first-child .ing-diff-val {
  font-size: 28rpx;
}

.ing-compare-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  column-gap: 10rpx;
  background: #f5f4ef;
  border-radius: 14rpx;
  padding: 10rpx 14rpx;
  margin-bottom: 10rpx;
}

