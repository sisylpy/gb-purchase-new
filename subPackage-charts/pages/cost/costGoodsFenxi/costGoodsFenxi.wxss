}

.ing-compare-body .dish-ing-metric-row {
  column-gap: 10rpx;
}

.ing-compare-body .dish-ing-metric-label {
  margin-right: 10rpx;
}

.ing-compare-body .dish-ing-metric-val {
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.dish-ing-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.dish-ing-row:last-child {
