page {
  height: 100%;
  box-sizing: border-box;
}

.page-root {
  min-height: 100%;
  height: 100%;
  box-sizing: border-box;
  background-color: var(--gb-bg-page);
}

/* 顶栏下：蓝系底色对照条（色值与 JS 中公式一致） */
.ing-diff-palette-demo {
  justify-content: space-around;
}

.ing-diff-palette-item {
  flex: 1;
  align-items: center;
  padding: 0 8rpx;
}

.ing-diff-palette-swatch {
  width: 140rpx;
  height: 88rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e5e7eb;
  box-sizing: border-box;
  margin-bottom: 8rpx;
}

.ing-diff-palette-cap {
  font-size: 22rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.3;
}

/* 报告类型：顶栏右侧图标（占位图可替换为正式资源） */
.cost-report-toolbar {
  gap: 16rpx;
  flex-shrink: 0;
}

.cost-report-toolbar-hint {
  font-size: 24rpx;
  margin-right: 4rpx;
  white-space: nowrap;
}

.mode-seg-img {
  width: 56rpx;
  height: 56rpx;
  padding: 8rpx;
  border-radius: 12rpx;
  background: var(--gb-bg-gray);
  box-sizing: border-box;
}

.mode-seg-img--on {
  background: var(--gb-bg-white);
  box-shadow: 0 0 0 3rpx var(--gb-primary);
}

.tip-banner {
  padding-top: 12rpx;
  padding-bottom: 16rpx;
}

.tip-text {
  font-size: 24rpx;
  color: var(--gb-text-muted);
  line-height: 1.5;
}

.font-yuan {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gb-text);
}

.list-scroll {
  box-sizing: border-box;
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 20rpx 20rpx 0;
}

.empty-panel {
  padding: 80rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
}

.dish-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.min-w-0 {
  min-width: 0;
}

.dish-card-head {
  margin-bottom: 20rpx;
}

.dish-card-head-main {
  margin-right: 16rpx;
}

.dish-rank-badge {
  flex-shrink: 0;
  min-width: 56rpx;
  padding: 6rpx 14rpx 6rpx 12rpx;
  margin-right: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
  border-top-left-radius: 10rpx;
  border-top-right-radius: 10rpx;
  border-bottom-left-radius: 10rpx;
  border-bottom-right-radius: 0;
}

.dish-rank-badge.dish-rank--1 {
  background: #c04831;
}

.dish-rank-badge.dish-rank--2 {
  background: #e8964e;
}

.dish-rank-badge.dish-rank--n {
  background: #9aa0a6;
}

.dish-name--card {
  font-size: 38rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.35;
  flex: 1;
  min-width: 0;
}

.dish-head-deviation {
  flex-shrink: 0;
  max-width: 46%;
}

.dish-usage-dev-text {
  font-size: 24rpx;
  font-weight: 600;
  text-align: right;
  line-height: 1.35;
}

.dish-head-deviation.dish-rank--1 .dish-usage-dev-text,
.dish-head-deviation.dish-rank--1 .dish-chevron--accent {
  color: #c04831;
}

.dish-head-deviation.dish-rank--2 .dish-usage-dev-text,
.dish-head-deviation.dish-rank--2 .dish-chevron--accent {
  color: #e8964e;
}

.dish-head-deviation.dish-rank--n .dish-usage-dev-text,
.dish-head-deviation.dish-rank--n .dish-chevron--accent {
  color: #9aa0a6;
}

.dish-chevron {
  margin-left: 6rpx;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
}

.dish-chevron--accent {
  opacity: 0.85;
}

.dish-chevron--muted {
  color: #bbbbbb;
  font-size: 32rpx;
}

.dish-summary-pane {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  background: #fff5f0;
  border-radius: 16rpx;
  padding: 22rpx 12rpx;
  margin-bottom: 20rpx;
}


