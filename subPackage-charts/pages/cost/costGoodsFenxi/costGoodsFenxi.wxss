  align-items: center;
  column-gap: 12rpx;
}

.dish-ing-metric-part {
  min-width: 0;
}

.dish-ing-metric-label {
  flex-shrink: 0;
  margin-right: 12rpx;
}

.dish-ing-metric-val {
