/**
 * 配料分析 — 出库去向三卡 + 去向分布 + 核销筛选 + 配料四格卡片
 */

page {
  height: 100%;
  background-color: #f2f3f5;
  box-sizing: border-box;
}

.page-root {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 100vh;
  box-sizing: border-box;
}

.list-scroll {
  flex: 1;
  height: 0;
  min-width: 0;
  box-sizing: border-box;
}

.cog-search-top-ico {
  opacity: 0.72;
}

.cog-search-top-ico--on {
  opacity: 1;
}

.cog-search-panel {
  padding: 12rpx 24rpx 16rpx;
}

.cog-search-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #f3f4f6;
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
  min-height: 72rpx;
  box-sizing: border-box;
}

.cog-search-inner-ico {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  opacity: 0.45;
}

.cog-search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #111827;
  height: 44rpx;
  line-height: 44rpx;
}

.cog-search-clear {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 40rpx;
  color: #9ca3af;
  margin-left: 8rpx;
}

/* ========== 顶部 summary 三卡（浅色底 + 彩色边，与设计图一致） ========== */
.cog-sum-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 16rpx 16rpx 8rpx;
  gap: 12rpx;
}

.cog-sum-card {
  flex: 1;
  min-width: 0;
  border-radius: 20rpx;
  padding: 18rpx 14rpx 16rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.cog-sum-card--blue {
  background: #eff6ff;
  border: 2rpx solid #bfdbfe;
}

.cog-sum-card--green {
  background: #fff7ec;
  border: 2rpx solid #fde8c9;
}

.cog-sum-card--red {
  background: #fff5f5;
  border: 2rpx solid #ffcccc;
}

.cog-sum-card-hd {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 12rpx;
}

.cog-sum-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  line-height: 1;
  margin-right: 10rpx;
  flex-shrink: 0;
  color: #ffffff;
}

.cog-sum-card--blue .cog-sum-icon { background: #3b82f6; }
.cog-sum-card--green .cog-sum-icon--check { background: #fb923c; }
.cog-sum-card--red .cog-sum-icon--cross { background: #ef4444; }

.cog-sum-card-title {
  font-size: 22rpx;
  font-weight: 500;
  color: #4b5563;
  line-height: 1.25;
  flex: 1;
  min-width: 0;
}

.cog-sum-card-val {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
  line-height: 1.25;
  word-break: break-all;
  color: #111827;
}

.cog-sum-card-foot {
  margin-top: auto;
  padding-top: 10rpx;
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.35;
}

.cog-sum-foot-info {
  margin-left: 6rpx;
  opacity: 0.5;
}

/* 核销总额卡片 — 辅助指标双列 */
.cog-sum-sub-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: auto;
  padding-top: 8rpx;
}

.cog-sum-sub-item {
  display: flex;
  flex-direction: column;
}

.cog-sum-sub-cap {
  font-size: 20rpx;
  color: #9ca3af;
  margin-bottom: 2rpx;
}

.cog-sum-sub-val {
  font-size: 24rpx;
  font-weight: 600;
  color: #374151;
}

.cog-sum-sub-dev {
  color: #ea580c;
}

/* ========== 出库去向分布 ========== */
.cog-dist-block {
  margin: 10rpx 20rpx 0;
  padding: 18rpx 18rpx 14rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #e8e8e8;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.cog-dist-hd {
  margin-bottom: 14rpx;
}

.cog-dist-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.cog-dist-bar-wrap {
  margin-bottom: 14rpx;
}

.cog-dist-bar {
  display: flex;
  flex-direction: row;
  height: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.cog-dist-seg {
  height: 100%;
  transition: width 0.3s ease;
}

.cog-dist-seg--verified   { background: #3b82f6; }
.cog-dist-seg--nonverified{ background: #ef4444; }
.cog-dist-seg--meal      { background: #fb923c; }

.cog-dist-legend {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx 32rpx;
}

.cog-dist-leg-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 24rpx;
  color: #4b5563;
}

.cog-dist-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.cog-dist-dot--verified   { background: #3b82f6; }
.cog-dist-dot--nonverified{ background: #ef4444; }
.cog-dist-dot--meal      { background: #fb923c; }

.cog-dist-leg-lab {
  margin-right: 8rpx;
  font-weight: 500;
}

.cog-dist-leg-val {
  font-weight: 600;
  color: #111827;
  margin-right: 6rpx;
}

.cog-dist-leg-pct {
  color: #9ca3af;
}

/* ========== 核销状态筛选栏 ========== */
.cog-vfilter-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 20rpx 14rpx;
  gap: 12rpx;
}

.cog-vfilter-label {
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 500;
  flex-shrink: 0;
}

.cog-vfilter-chips {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.cog-vfilter-chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #333;
  background: #f5f6f8;
  border: none;
}

.cog-vfilter-chip.is-on {
  color: #2563eb;
  background: #eff6ff;
  font-weight: 600;
  border: 1rpx solid #bfdbfe;
}

/* ---------- 排序条 ---------- */
.cog-sort-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 16rpx 8rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.cog-sort-left {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 12rpx;
}

.cog-sort-arrows {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 10rpx;
  gap: 2rpx;
}

.cog-sort-arrow {
  font-size: 30rpx;
  color: #d1d5db;
  line-height: 1;
  font-weight: 700;
  padding: 0 2rpx;
}

.cog-sort-arrow.is-on {
  color: #2563eb;
}

.cog-sort-label {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #4b5563;
  font-weight: 500;
}

.cog-sort-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.cog-sort-chips {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 4rpx 0 8rpx;
  gap: 12rpx;
}

.cog-sort-chip {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #333;
  background: #fff;
  border: 1rpx solid #e5e5e5;
}

.cog-sort-chip-ico {
  margin-right: 6rpx;
  font-size: 26rpx;
}

.cog-sort-chip.is-on {
  font-weight: 600;
}

.cog-sort-chip--outbound.is-on {
  color: #1d4ed8;
  background: #eff6ff;
  border-color: #bfdbfe;
}

.cog-sort-chip--deviance.is-on {
  color: #059669;
  background: #ecfdf5;
  border-color: #a7f3d0;
}

.cog-sort-chip--devianceAmount.is-on {
  color: #c2410c;
  background: #fff7ed;
  border-color: #fed7aa;
}

.cog-sort-chip-arrow {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: inherit;
}

/* ---------- 空状态 / 分页 ---------- */
.cog-list-footer {
  padding: 24rpx 16rpx 8rpx;
  text-align: center;
}

.cog-list-footer-text {
  font-size: 24rpx;
  color: #9ca3af;
}

.cog-list-footer-done {
  color: #c4c4c4;
}

.cog-scroll-pad {
  height: 40rpx;
}

.cog-empty {
  padding: 48rpx 32rpx;
  text-align: center;
  font-size: 30rpx;
  color: #6b7280;
  line-height: 1.5;
}

/* ---------- 配料卡片（新版：去向四格） ---------- */
.cog-ing-list {
  padding: 8rpx 0 0;
}

.cog-ing-card {
  margin: 16rpx 20rpx 20rpx;
  padding: 20rpx 18rpx 12rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #e8e8e8;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 卡片头：图片 + 名称 */
.cog-ing-hd {
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.cog-ing-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  border: 1rpx solid #eee;
  background: #f5f5f5;
}

.cog-ing-hd-body {
  margin-left: 18rpx;
  flex: 1;
  min-width: 0;
}

.cog-ing-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.35;
  margin-right: 12rpx;
}

.cog-ing-spec {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

/* 四格去向行 */
.cog-ing-stat4-row {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.cog-stat4-cell {
  flex: 1;
  min-width: 0;
  padding: 14rpx 6rpx;
  border-radius: 12rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fafafa;
  border: 1rpx solid #ececec;
}

.cog-stat4--outbound {
  background: #f0f9ff;
  border-color: #bae6fd;
}

.cog-stat4--verified {
  background: #eff6ff;
  border-color: #dbeafe;
}

.cog-stat4--nonverified {
  background: #fef2f2;
  border-color: #fecdd3;
}

.cog-stat4--meal {
  background: #fff7ed;
  border-color: #fed7aa;
}

.cog-stat4-cap {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
  font-weight: 500;
}

.cog-stat4-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  word-break: break-all;
}

.cog-stat4--outbound .cog-stat4-val { color: #0369a1; }
.cog-stat4--verified .cog-stat4-val  { color: #2563eb; }
.cog-stat4--nonverified .cog-stat4-val { color: #dc2626; }
.cog-stat4--meal .cog-stat4-val      { color: #ea580c; }

.cog-stat4-sub {
  font-size: 24rpx;
  font-weight: 400;
  color: #9ca3af;
  margin-top: 4rpx;
}

/* ---------- 关联菜品表 ---------- */
.cog-sub-hd {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 4rpx 12rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid #f0f0f0;
}

.cog-sub-hd-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.cog-sub-bar {
  width: 6rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: #f87171;
  margin-right: 12rpx;
}

.cog-sub-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #4b5563;
}

.cog-sub-arrow {
  font-size: 30rpx;
  color: #6b7280;
  padding: 8rpx;
}

.cog-sub-table {
  padding: 0 0 8rpx;
}

.cog-allocation-note {
  margin: 0 8rpx 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: #f0f9ff;
  color: #475569;
  font-size: 22rpx;
  line-height: 1.55;
}

.cog-allocation-note__attention {
  display: block;
  margin-top: 6rpx;
  color: #b45309;
  font-weight: 600;
}

.cog-tr {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  border-bottom: 1rpx solid #f0f0f0;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
}

.cog-tr--head {
  padding: 10rpx 8rpx 12rpx;
  border-bottom: 1rpx solid #e5e7eb;
  background: #f9fafb;
  border-radius: 10rpx;
}

.cog-tr--head .cog-td {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 600;
}

.cog-td {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #1f2937;
  line-height: 1.45;
  text-align: center;
  padding: 0 6rpx;
  word-break: break-all;
}

.cog-td--name {
  flex: 2.1;
  text-align: left;
}

.cog-dish-name {
  display: block;
  font-weight: 600;
}

.cog-usage-path {
  margin-top: 6rpx;
}

.cog-usage-tag {
  display: inline-block;
  padding: 1rpx 8rpx;
  border-radius: 8rpx;
  background: #ecfdf5;
  color: #047857;
  font-size: 21rpx;
}

.cog-usage-formula,
.cog-usage-direct {
  display: block;
  margin-top: 3rpx;
  color: #6b7280;
  font-size: 20rpx;
  line-height: 1.35;
}

.min-w-0 {
  min-width: 0;
}
