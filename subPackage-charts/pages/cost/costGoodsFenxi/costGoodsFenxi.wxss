/**
 * 出库分析 — 顶部 summary 三卡 + 列表滚动区
 */

page {
  height: 100%;
  background-color: #f2f3f5;
  box-sizing: border-box;
}

.page-root {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 100vh;
  box-sizing: border-box;
}

.list-scroll {
  flex: 1;
  height: 0;
  min-width: 0;
  box-sizing: border-box;
}

.cog-search-top-ico {
  opacity: 0.72;
}

.cog-search-top-ico--on {
  opacity: 1;
}

.cog-search-panel {
  padding: 12rpx 24rpx 16rpx;
}

.cog-search-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #f3f4f6;
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
  min-height: 72rpx;
  box-sizing: border-box;
}

.cog-search-inner-ico {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  opacity: 0.45;
}

.cog-search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #111827;
  height: 44rpx;
  line-height: 44rpx;
}

.cog-search-clear {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 40rpx;
  color: #9ca3af;
  margin-left: 8rpx;
}

.cog-list-footer {
  padding: 24rpx 16rpx 8rpx;
  text-align: center;
}

.cog-list-footer-text {
  font-size: 24rpx;
  color: #9ca3af;
}

.cog-list-footer-done {
  color: #c4c4c4;
}

/* ========== 顶部 summary 三卡（参考：蓝 / 绿 / 橙） ========== */
.cog-sum-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 16rpx 16rpx 8rpx;
  gap: 12rpx;
}

.cog-sum-card {
  flex: 1;
  min-width: 0;
  border-radius: 20rpx;
  padding: 18rpx 14rpx 16rpx;
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.12);
  display: flex;
  flex-direction: column;
}

.cog-sum-card--blue {
  background: linear-gradient(160deg, #3b82f6 0%, #2563eb 100%);
}

.cog-sum-card--green {
  background: linear-gradient(160deg, #34d399 0%, #059669 100%);
}

.cog-sum-card--orange {
  background: linear-gradient(160deg, #fb923c 0%, #ea580c 100%);
}

/* 异常配料（前端文案「异常菜品」）：白底卡片 */
.cog-sum-card--abnormal {
  background: #ede9fe;
  color: #1f2937;
  border: 1rpx solid #ddd8f4;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
}

.cog-sum-card--abnormal .cog-sum-card-title {
  color: #374151;
  opacity: 1;
}

.cog-sum-icon--bell {
  background: #ede9fe;
  color: #7c3aed;
  font-size: 24rpx;
  font-weight: 700;
}

.cog-sum-card-val--abnormal {
  color: #111827;
  font-size: 36rpx;
}

.cog-sum-card-ing-unit {
  font-size: 26rpx;
  font-weight: 600;
  color: #6b7280;
}

.cog-abnormal-foot {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
  margin-top: auto;
  padding-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.cog-abnormal-foot-muted {
  color: #9ca3af;
}

.cog-abnormal-foot-flat {
  color: #9ca3af;
}

.cog-abnormal-foot-delta {
  font-weight: 600;
}

.cog-mom--worse {
  color: #dc2626;
}

.cog-mom--better {
  color: #16a34a;
}

.cog-mom--flat {
  color: #9ca3af;
}

/* 利用率分布 */
.cog-util-dist {
  margin: 0 16rpx 16rpx;
  padding: 20rpx 18rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.cog-util-dist-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
}

.cog-util-dist-body {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.cog-util-dist-chart {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
}

.cog-util-ec {
  width: 100%;
  height: 100%;
}

ec-canvas.cog-util-ec {
  display: block;
}

.cog-util-dist-legend {
  flex: 1;
  min-width: 0;
  padding-left: 8rpx;
}

.cog-util-legend-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.cog-util-legend-row:last-child {
  border-bottom: none;
}

.cog-util-legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.cog-util-legend-dot--CRITICAL {
  background: #dc2626;
}

.cog-util-legend-dot--HIGH {
  background: #ea580c;
}

.cog-util-legend-dot--NORMAL {
  background: #16a34a;
}

.cog-util-legend-dot--LOW {
  background: #2563eb;
}

.cog-util-legend-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cog-util-legend-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.cog-util-legend-range {
  font-size: 22rpx;
  color: #9ca3af;
}

.cog-util-legend-right {
  flex-shrink: 0;
  text-align: right;
  padding-left: 8rpx;
}

.cog-util-legend-count {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
}

.cog-util-legend-pct {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.cog-sum-card-hd {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 14rpx;
}

.cog-sum-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  line-height: 1;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.cog-sum-card-title {
  font-size: 22rpx;
  font-weight: 500;
  opacity: 0.95;
  line-height: 1.25;
  flex: 1;
  min-width: 0;
}

.cog-sum-card-val {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
  line-height: 1.2;
  word-break: break-all;
}

.cog-sum-card-suf {
  font-size: 26rpx;
  font-weight: 600;
  opacity: 0.9;
  margin-left: 2rpx;
}

.cog-sum-val-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.cog-sum-pill {
  margin-left: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  max-width: 100%;
}

.cog-sum-pill .util-text {
  font-size: 22rpx;
}

.cog-sum-card-foot {
  margin-top: auto;
  padding-top: 10rpx;
  font-size: 20rpx;
  font-weight: 400;
  opacity: 0.82;
  line-height: 1.35;
}

.cog-sum-card-foot--muted {
  opacity: 0.72;
}

.cog-scroll-pad {
  height: 40rpx;
}

.cog-empty {
  padding: 48rpx 32rpx;
  text-align: center;
  font-size: 30rpx;
  color: #6b7280;
  line-height: 1.5;
}

/* ---------- 排序条 ---------- */
.cog-sort-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 16rpx 8rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.cog-sort-left {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 12rpx;
}

.cog-sort-arrows {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 10rpx;
  gap: 2rpx;
}

.cog-sort-arrow {
  font-size: 30rpx;
  color: #d1d5db;
  line-height: 1;
  font-weight: 700;
  padding: 0 2rpx;
}

.cog-sort-arrow.is-on {
  color: #2563eb;
}

.cog-sort-label {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #4b5563;
  font-weight: 500;
}

.cog-sort-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.cog-sort-chips {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 4rpx 0 8rpx;
  gap: 12rpx;
}

.cog-sort-chip {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #333;
  background: #fff;
  border: 1rpx solid #e5e5e5;
}

.cog-sort-chip-ico {
  margin-right: 6rpx;
  font-size: 26rpx;
}

.cog-sort-chip.is-on {
  font-weight: 600;
}

.cog-sort-chip--outbound.is-on {
  color: #1d4ed8;
  background: #eff6ff;
  border-color: #bfdbfe;
}

.cog-sort-chip--util.is-on {
  color: #059669;
  background: #ecfdf5;
  border-color: #a7f3d0;
}

.cog-sort-chip--wasteloss.is-on {
  color: #c2410c;
  background: #fff7ed;
  border-color: #fed7aa;
}

.cog-sort-filter {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 500;
  padding: 8rpx 0 8rpx 12rpx;
}

.cog-sort-filter-ico {
  margin-right: 4rpx;
  font-size: 26rpx;
  opacity: 0.75;
}

/* ---------- 原料卡片 ---------- */
.cog-ing-list {
  padding: 8rpx 0 0;
}

.cog-ing-card {
  margin: 16rpx 20rpx 20rpx;
  padding: 20rpx 18rpx 12rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 2rpx solid #ffd6d6;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.cog-ing-main {
  align-items: flex-start;
}

.cog-ing-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  border: 1rpx solid #eee;
  background: #f5f5f5;
}

.cog-ing-body {
  margin-left: 18rpx;
}

.cog-ing-title-row {
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.cog-ing-name {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.35;
  margin-right: 12rpx;
}

.cog-ing-util {
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  max-width: 52%;
}

.cog-ing-util-lab {
  font-size: 24rpx;
  color: #9ca3af;
  margin-right: 6rpx;
}

.cog-ing-util-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #374151;
}

.cog-ing-util-pct {
  font-size: 24rpx;
  color: #6b7280;
  margin-right: 8rpx;
}

.cog-ing-pill {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid #e8e8e8;
}

.cog-ing-pill .util-text {
  font-size: 22rpx;
}

.cog-stat-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 10rpx;
}

.cog-stat-cell {
  flex: 1;
  min-width: 0;
  padding: 14rpx 8rpx;
  background: #fafafa;
  border-radius: 12rpx;
  border: 1rpx solid #ececec;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.cog-stat-cap {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
  margin-bottom: 8rpx;
  line-height: 1.25;
}

.cog-stat-val {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.25;
  word-break: break-all;
}

.cog-stat-unit {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.cog-diff--pos {
  color: #fa5151;
}

.cog-diff--neg {
  color: #07c160;
}

.cog-diff--zero {
  color: #666;
}

.cog-diff--na {
  color: #999;
}

.cog-stat-cell--cost-alert {
  background: #fff1f2;
  border-color: #fecdd3;
}

.cog-stat-cell--cost-good {
  background: #ecfdf5;
  border-color: #bbf7d0;
}

/* ---------- 关联菜品表 ---------- */
.cog-sub-hd {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 4rpx 12rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid #f0f0f0;
}

.cog-sub-hd-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.cog-sub-bar {
  width: 6rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: #f87171;
  margin-right: 12rpx;
}

.cog-sub-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #4b5563;
}

.cog-sub-arrow {
  font-size: 30rpx;
  color: #6b7280;
  padding: 8rpx;
}

.cog-sub-table {
  padding: 0 0 8rpx;
}

.cog-tr {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  border-bottom: 1rpx solid #f0f0f0;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
}

.cog-tr--head {
  padding: 10rpx 8rpx 12rpx;
  border-bottom: 1rpx solid #e5e7eb;
  background: #f9fafb;
  border-radius: 10rpx;
}

.cog-tr--head .cog-td {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 600;
}

.cog-td {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #1f2937;
  line-height: 1.45;
  text-align: center;
  padding: 0 6rpx;
  word-break: break-all;
}

.cog-td--name {
  flex: 1.35;
  text-align: left;
}

.cog-td--right {
  text-align: right;
}

.min-w-0 {
  min-width: 0;
}

