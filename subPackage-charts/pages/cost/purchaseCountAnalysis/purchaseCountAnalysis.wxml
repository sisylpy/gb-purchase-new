<view class="page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="采购次数分析" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar><view style="height:{{navBarHeight}}rpx"></view>
  <view class="filters"><view class="date" bindtap="toDatePage"><image src="/images/calender.png"></image>{{dateRangeText}}⌄</view><view class="period {{periodKey=='month'?'active':''}}" data-key="month" bindtap="selectPeriod">本月</view><view class="period {{periodKey=='thirty'?'active':''}}" data-key="thirty" bindtap="selectPeriod">近30天</view><picker mode="selector" range="{{sourceNames}}" value="{{sourceIndex}}" bindchange="changeSource"><view class="select">{{sourceNames[sourceIndex]}}⌄</view></picker></view>
  <view class="sub-filter"><picker mode="selector" range="{{departmentNames}}" value="{{departmentIndex}}" bindchange="changeDepartment"><view>{{departmentNames[departmentIndex]}} ▾</view></picker></view>
  <view class="banner"><image src="{{bannerUrl}}" mode="aspectFill"></image></view>

  <view wx:if="{{hasData}}">
    <view class="summary">
      <view class="summary-card"><view class="sum-icon green"><image src="{{iconRoot}}menu_green.png"></image></view><view><text>采购总次数</text><text class="sum-value">{{summary.purchaseCount}}<text class="unit"> 次</text></text><text class="sum-note">较上期 <text class="{{summary.countTrend.direction}}">{{summary.countTrend.text}}</text></text></view></view>
      <view class="summary-card"><view class="sum-icon blue"><image src="/images/calender.png"></image></view><view><text>活跃采购日</text><text class="sum-value">{{summary.activeDays}}<text class="unit"> 天</text></text><text class="sum-note">占本期 {{summary.activeRate}}%</text></view></view>
      <view class="summary-card"><view class="sum-icon yellow">♛</view><view><text>高频商品</text><text class="sum-value goods-name">{{summary.highName}}</text><text class="sum-note">共 {{summary.highCount}} 次采购</text></view></view>
      <view class="summary-card"><view class="sum-icon orange"><image src="{{iconRoot}}bar_chart.png"></image></view><view><text>平均每日采购</text><text class="sum-value">{{summary.average}}<text class="unit"> 次</text></text><text class="sum-note">较上期 <text class="{{summary.averageTrend.direction}}">{{summary.averageTrend.text}}</text></text></view></view>
    </view>
    <view class="panel rhythm-panel"><view class="head"><view class="title"><image src="{{iconRoot}}bar_chart.png"></image>采购节奏</view><view class="tabs"><text class="{{rhythmMetric=='count'?'active':''}}" data-metric="count" bindtap="switchRhythm">采购次数</text><text class="{{rhythmMetric=='active'?'active':''}}" data-metric="active" bindtap="switchRhythm">活跃来源</text></view></view><view class="rhythm-chart-wrap"><ec-canvas id="rhythmChart" canvas-id="purchase-rhythm-chart" ec="{{ecRhythm}}" class="rhythm-chart" style="display:block;width:100%;height:285rpx;"></ec-canvas></view></view>
    <view class="panel"><view class="head"><view class="title"><image src="{{iconRoot}}leaf.png"></image>高频采购</view></view><scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="goods-scroll"><view class="goods-list"><view class="goods-card" wx:for="{{goods}}" wx:key="disGoodsId" bindtap="toCategoryGoods" data-id="{{item.disGoodsId}}"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"></image><view wx:else class="goods-placeholder">{{item.initial}}</view><view><text class="card-name">{{item.goodsName}}</text><text class="card-value">{{item.purchaseCount}}<text class="unit"> 次</text></text><text class="card-note">占比 {{item.percentDisplay}}%</text><view class="dots"><text wx:for="{{item.dotsArr}}" wx:key="index" style="background:{{item.color}}"></text></view><text class="recent">近7天：{{item.recentSevenActiveDays}}天有采购</text></view></view></view></scroll-view></view>
    <view class="panel"><view class="head"><view class="title"><image src="{{iconRoot}}user.png"></image>行为观察</view></view><scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="behavior-scroll"><view class="behavior-list"><view class="behavior" wx:for="{{behaviors}}" wx:key="subjectId"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill"></image><view wx:else class="avatar" style="background:{{item.color}}">{{item.initial}}</view><view><text class="card-name">{{item.subjectName}}</text><text class="card-value">{{item.purchaseCount}} 次</text><text class="card-note">{{item.roleText}}</text><view class="track"><view style="width:{{item.barWidth}}%;background:{{item.color}}"></view></view></view></view></view></scroll-view></view>
    <view class="tips"><view class="title"><image src="{{iconRoot}}light_bulb.png"></image>采购提示</view><view class="tip-list"><view class="tip" wx:for="{{tips}}" wx:key="type"><text>↗</text><view><text class="card-note">{{item.title}}</text><text class="card-name">{{item.displayValue}}</text><text class="card-note">{{item.description}}</text></view></view></view></view>
  </view>
  <view wx:elif="{{!loading}}" class="empty"><image src="/subPackage-charts/images/purchase/keaibaicai.png" mode="aspectFit"></image><text class="empty-title">本期暂无采购次数数据</text><text class="empty-note">可切换日期、门店或采购来源查看</text></view><view class="bottom"></view>
</view>
