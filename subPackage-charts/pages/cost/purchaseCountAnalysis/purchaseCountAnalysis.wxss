page{background:#f0fbf8;color:#12213b}.page{min-height:100vh;padding:0 22rpx;box-sizing:border-box;background:linear-gradient(180deg,#f4fcff,#effaf7)}
.date-toolbar{min-height:104rpx;margin:0 -22rpx;padding:10rpx 24rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #e5efed;background:#fff;box-sizing:border-box}.date-selector{display:flex;align-items:center;min-width:245rpx;flex-shrink:0}.date-selector-hover{opacity:.72}.date-calendar{width:58rpx;height:64rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.date-calendar image{width:34rpx;height:34rpx}.date-copy{display:flex;flex-direction:column;min-width:0}.date-title{font-size:27rpx;line-height:34rpx;color:#26354b}.date-values{display:flex;align-items:center;margin-top:2rpx;color:#26354b;font-size:22rpx;line-height:30rpx;white-space:nowrap}.date-divider{padding:0 8rpx}.date-actions{display:flex;align-items:center;justify-content:flex-end;gap:8rpx;min-width:0}.date-actions picker{min-width:0}.date-filter-select{height:52rpx;max-width:154rpx;padding:0 13rpx;border:1rpx solid #e2ebe8;border-radius:27rpx;background:#f7faf9;color:#607087;font-size:20rpx;line-height:52rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;box-sizing:border-box}
.banner{height:235rpx;border-radius:28rpx;overflow:hidden;margin:10rpx 0 14rpx;background:#e2fae9}.banner image{width:100%;height:100%;display:block}
.summary{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-bottom:16rpx}.summary-card{background:#fff;border-radius:22rpx;padding:18rpx;display:flex;align-items:center;min-width:0}.sum-icon{width:70rpx;height:70rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;margin-right:14rpx;font-size:40rpx;flex-shrink:0}.sum-icon image{width:48rpx;height:48rpx}.green{background:#e5faf0}.blue{background:#e9f4ff}.yellow{background:#fff5d9;color:#ffb800}.orange{background:#fff0e8}.summary-card>view:last-child{display:flex;flex-direction:column;min-width:0}.summary-card text{font-size:20rpx}.summary-card .sum-value{font-size:32rpx;font-weight:700;margin:5rpx 0;white-space:nowrap}.summary-card .unit{font-size:19rpx;font-weight:400}.summary-card .sum-note{font-size:18rpx;color:#7e8ca0;white-space:nowrap}.up{color:#ff5963!important}.down{color:#0bad76!important}.flat{color:#8995a7!important}.goods-name{font-size:25rpx!important;overflow:hidden;text-overflow:ellipsis}
.panel{background:#fff;border-radius:26rpx;padding:21rpx;margin:15rpx 0}.head{display:flex;align-items:center;justify-content:space-between}.title{font-size:29rpx;font-weight:800;display:flex;align-items:center}.title image{width:38rpx;height:38rpx;margin-right:10rpx}.tabs{background:#f2f8f6;border-radius:24rpx;padding:4rpx}.tabs text{display:inline-block;padding:7rpx 18rpx;border-radius:20rpx;font-size:20rpx;color:#718198}.tabs text.active{background:#fff;color:#10af75;box-shadow:0 3rpx 9rpx rgba(40,100,85,.12)}.rhythm-chart-wrap{display:block;width:100%;height:285rpx;margin-top:8rpx;position:relative;overflow:hidden}.rhythm-chart{display:block;width:100%;height:285rpx}
.goods-scroll,.behavior-scroll{width:100%;margin-top:18rpx}.goods-list,.behavior-list{display:flex;gap:14rpx;min-width:max-content}.goods-card{width:265rpx;padding:15rpx;background:linear-gradient(135deg,#f2fff7,#f8fcfb);border-radius:20rpx;display:flex;box-sizing:border-box}.goods-card>image,.goods-placeholder{width:86rpx;height:86rpx;flex-shrink:0;margin-right:12rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#e7f8ef;color:#15ae75;font-size:29rpx}.goods-card>view:last-child{display:flex;flex-direction:column;min-width:0}.card-name{font-size:22rpx;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.card-value{font-size:25rpx;font-weight:700;margin:3rpx 0}.card-value .unit,.card-note{font-size:17rpx;color:#74859a;font-weight:400}.dots{display:flex;gap:6rpx;margin:8rpx 0}.dots text{width:12rpx;height:12rpx;border-radius:50%}.recent{background:#e7faef;color:#3a8c6c;border-radius:14rpx;padding:5rpx 7rpx;font-size:16rpx;white-space:nowrap}
.behavior{width:230rpx;background:#f6fbfa;border-radius:19rpx;padding:14rpx;display:flex;box-sizing:border-box}.behavior>image,.avatar{width:62rpx;height:62rpx;border-radius:50%;margin-right:10rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:#fff}.behavior>view:last-child{display:flex;flex-direction:column;min-width:0;flex:1}.behavior .card-name{font-size:20rpx}.behavior .card-value{font-size:23rpx}.behavior .card-note{font-size:16rpx;color:#7b8b9f}.track{height:9rpx;background:#e8eef1;border-radius:8rpx;margin-top:8rpx;overflow:hidden}.track view{height:100%;border-radius:8rpx}
.tips{border-radius:26rpx;padding:21rpx;background:linear-gradient(110deg,#e4fae9,#fafff7);margin-top:15rpx}.tip-list{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:16rpx}.tip{background:rgba(255,255,255,.88);border-radius:18rpx;padding:12rpx;display:flex;min-width:0}.tip>text{font-size:28rpx;color:#10b377;margin-right:7rpx}.tip>view{display:flex;flex-direction:column;min-width:0}.tip .card-name{font-size:20rpx;margin:4rpx 0}.tip .card-note{font-size:17rpx;color:#6f8195}.empty{height:520rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#65788b}.empty image{width:210rpx;height:210rpx}.empty-title{font-size:27rpx;font-weight:700}.empty-note{font-size:21rpx;margin-top:8rpx}.bottom{height:40rpx}
