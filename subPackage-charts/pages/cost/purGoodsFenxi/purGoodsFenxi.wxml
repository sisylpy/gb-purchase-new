<wxs src="/wxs/format.wxs" module="tool" />

<view class="page">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="采购分析" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <!-- back-navbar 内部为 fixed，显式占位避免日期筛选和概览卡片被导航栏覆盖 -->
  <view class="navbar-spacer" style="height: {{navBarHeight}}rpx;"></view>

  <view class="hero-strip">
    <view class="date-filter" bindtap="toDatePageSearch" hover-class="tap-hover">
      <image src="/images/calender.png" class="date-icon"></image>
      <view class="date-name">{{hanzi}}</view>
      <view class="date-range" wx:if="{{startDate == stopDate}}">{{tool.transferDateString(startDate)}}</view>
      <view class="date-range" wx:else>{{tool.transferDateString(startDate)}} - {{tool.transferDateString(stopDate)}}</view>
      <view class="date-chevron"></view>
    </view>
    <view class="hero-slogan">新鲜食材<text>让好生意更简单！</text></view>
  </view>

  <view wx:if="{{hasData}}" class="content">
    <view class="overview-card">
      <view class="overview-head">
        <view><view class="overview-title">本期采购概况</view><view class="overview-subtitle">新鲜食材，助力美好餐桌</view></view>
        <view class="purchase-times">一共采购 <text>{{purchaseCount}}</text> 次</view>
      </view>
      <view class="hero-heart">♥</view>
      <image src="/subPackage-charts/images/purchase/keaibaicai.png" mode="aspectFit" class="cabbage"></image>
      <view class="metric-grid">
        <view class="metric-item"><view class="metric-icon icon-yellow"><image src="{{imageRoot}}money_bag.png"></image></view><view class="metric-body"><view class="metric-label">采购总金额</view><view class="metric-value">￥{{purTotalDisplay}}</view><view class="metric-note" wx:if="{{totalTrend}}">较上期 <text class="trend-{{totalTrend.direction}}">{{totalTrend.direction == 'up' ? '+' : '-'}}{{totalTrend.value}}%</text></view></view></view>
        <view class="metric-item"><view class="metric-icon icon-blue"><image src="{{imageRoot}}cart_blue.png"></image></view><view class="metric-body"><view class="metric-label">自采金额</view><view class="metric-value">￥{{selfTotalDisplay}}</view><view class="metric-note">占比 {{selfPercent}}%</view></view></view>
        <view class="metric-item"><view class="metric-icon icon-sky"><image src="{{imageRoot}}truck_blue.png"></image></view><view class="metric-body"><view class="metric-label">供货金额</view><view class="metric-value">￥{{supplierTotalDisplay}}</view><view class="metric-note">占比 {{supplierPercent}}%</view></view></view>
        <view class="metric-item"><view class="metric-icon icon-green"><image src="{{imageRoot}}menu_green.png"></image></view><view class="metric-body"><view class="metric-label">采购次数</view><view class="metric-value">{{purchaseCount}} <text class="metric-unit">次</text></view><view class="metric-note" wx:if="{{countTrend}}">较上期 <text class="trend-{{countTrend.direction}}">{{countTrend.direction == 'up' ? '+' : '-'}}{{countTrend.value}}%</text></view></view></view>
      </view>
    </view>

    <view class="analysis-card">
      <view class="section-head"><view class="section-title"><image src="{{imageRoot}}basket_green.png"></image>自采分析</view><view class="more" bindtap="toPurchaser">查看更多 <image src="{{imageRoot}}arrow_right.png"></image></view></view>
      <view class="self-content">
        <view class="donut-wrap"><ec-canvas id="selfDonutChart" canvas-id="self-donut-chart" ec="{{ecSelf}}" class="self-donut-chart"></ec-canvas><view class="donut-center"><text>{{selfPercent}}%</text><view>自采占比</view></view></view>
        <view class="self-amounts"><view><view class="dot dot-green"></view><text>自采金额</text><text class="strong">￥{{selfTotalDisplay}}</text></view><view><view class="dot dot-gray"></view><text>供货金额</text><text class="strong">￥{{supplierTotalDisplay}}</text></view></view>
        <view class="self-summary"><view><image src="{{imageRoot}}user.png"></image><view><text>主要采购人</text><text class="strong">{{mainPurchaser}}</text></view></view><view><image src="{{imageRoot}}leaf.png"></image><view><text>采购金额最高</text><text class="strong">{{mainGoodsName}}</text></view></view></view>
      </view>
    </view>

    <view class="analysis-card">
      <view class="section-head"><view class="section-title" bindtap="toSupplier"><image src="{{imageRoot}}truck_green.png"></image>供货商分析</view><view class="more" bindtap="toSupplier">查看更多 <image src="{{imageRoot}}arrow_right.png"></image></view></view>
      <scroll-view class="supplier-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{supplierCards.length}}"><view class="supplier-list"><view class="supplier-item supplier-rank-{{item.rank}}" wx:for="{{supplierCards}}" wx:key="supplierName" bindtap="toSupplier"><view class="supplier-name"><text wx:if="{{item.rank == 1}}">★</text>{{item.supplierName || item.name || '未命名供货商'}}</view><view class="supplier-money">￥{{item.totalAmountDisplay}}</view><view class="supplier-meta">{{item.purchaseCountDisplay}} 次</view><view class="mini-ring">{{item.sharePercent}}%</view></view></view></scroll-view>
      <view class="empty-inline" wx:else>暂无供货商采购数据</view>
    </view>

    <view class="two-column">
      <view class="analysis-card half-card">
        <view class="section-head compact-head"><view class="section-title"><image src="{{imageRoot}}trend_up.png"></image>单价波动</view><view class="more" bindtap="togglePriceGoodsList">{{showAllPriceGoods ? '收起' : '更多'}}</view></view>
        <view class="compact-row" wx:for="{{topGoodsPrice}}" wx:key="gbDistributerGoodsId" wx:if="{{index < (showAllPriceGoods ? 10 : 3)}}" data-id="{{item.gbDistributerGoodsId}}" data-goods="{{item}}" bindtap="toGoodsPage"><image src="{{item.imageUrl}}" mode="aspectFill"></image><view class="compact-main"><text>{{item.gbDgGoodsName}}</text><text class="small">￥{{item.gbDgGoodsLowestPrice}} - ￥{{item.gbDgGoodsHighestPrice}}</text></view><view class="fluctuation">{{item.fluctuationDisplay}}%</view></view>
        <view class="empty-inline small-empty" wx:if="{{!topGoodsPrice.length}}">暂无波动数据</view>
      </view>
      <view class="analysis-card half-card">
        <view class="section-head compact-head"><view class="section-title"><image src="{{imageRoot}}cart_green.png"></image>采购次数</view><view class="more" bindtap="toggleGoodsList">{{showAllGoods ? '收起' : '更多'}}</view></view>
        <view class="times-row" wx:for="{{topTimesGoods}}" wx:key="gbDistributerGoodsId" wx:if="{{index < (showAllGoods ? 10 : 3)}}" data-id="{{item.gbDistributerGoodsId}}" data-goods="{{item}}" bindtap="toGoodsPage"><image src="{{item.imageUrl}}" mode="aspectFill"></image><view class="times-main"><text>{{item.gbDgGoodsName}}</text><view class="bar-track"><view class="bar-fill" style="width: {{item.barWidth}}%;"></view></view></view><text class="strong">{{item.gbDgQuantityDays}}次</text></view>
        <view class="empty-inline small-empty" wx:if="{{!topTimesGoods.length}}">暂无次数数据</view>
      </view>
    </view>

    <view class="analysis-card">
      <view class="section-head"><view class="section-title"><image src="{{imageRoot}}bar_chart.png"></image>采购金额</view><view class="more" bindtap="toggleSubtotalGoodsList">{{showAllSubtotalGoods ? '收起' : '查看更多'}} <image src="{{imageRoot}}arrow_right.png"></image></view></view>
      <scroll-view class="amount-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{topSubtotalGoods.length}}"><view class="amount-list"><view class="amount-item" wx:for="{{topSubtotalGoods}}" wx:key="gbDistributerGoodsId" wx:if="{{index < (showAllSubtotalGoods ? 10 : 5)}}" data-id="{{item.gbDistributerGoodsId}}" data-goods="{{item}}" bindtap="toGoodsPage"><view class="amount-bar amount-color-{{index % 5}}" style="height: {{150 - index * 14}}rpx;"></view><image src="{{item.imageUrl}}" mode="aspectFill"></image><text>{{item.gbDgGoodsName}}</text><text class="strong">￥{{item.subtotalDisplay}}</text></view></view></scroll-view>
      <view class="empty-inline" wx:else>暂无采购金额数据</view>
    </view>

    <view class="reminder-card"><image src="{{imageRoot}}light_bulb.png"></image><view class="reminder-title">本期提醒</view><view class="reminder-text">{{reminderText}}</view></view>
    <view class="bottom-space"></view>
  </view>

  <view wx:elif="{{!loading}}" class="empty-state" style="min-height: {{windowHeight - 300}}rpx;"><image src="/subPackage-charts/images/purchase/keaibaicai.png" mode="aspectFit"></image><text>本期暂无采购数据</text><view bindtap="toDatePageSearch">切换日期查看</view></view>
</view>
