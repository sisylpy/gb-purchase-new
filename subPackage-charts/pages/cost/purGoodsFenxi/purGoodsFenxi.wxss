page { background: #f4faf8; color: #152039; }
.page { min-height: 100vh; }
.navbar-spacer { width: 100%; flex-shrink: 0; }
.content { padding: 10rpx 24rpx 20rpx; }
.tap-hover { opacity: .75; }
.date-toolbar { min-height: 104rpx; padding: 10rpx 24rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #e5efed; background: #fff; box-sizing: border-box; }
.date-selector { display: flex; align-items: center; min-width: 0; }
.date-selector-hover { opacity: .72; }
.date-calendar { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.date-calendar image { width: 34rpx; height: 34rpx; }
.date-copy { display: flex; flex-direction: column; min-width: 0; }
.date-title { font-size: 28rpx; line-height: 34rpx; color: #26354b; }
.date-values { display: flex; align-items: center; margin-top: 2rpx; color: #26354b; font-size: 24rpx; line-height: 32rpx; white-space: nowrap; }
.date-divider { padding: 0 10rpx; }
.overview-card { position: relative; overflow: visible; padding: 26rpx 20rpx 20rpx; border-radius: 30rpx; background: linear-gradient(135deg, #e8faed, #f5fff5); }
.overview-head { min-height: 130rpx; display: flex; justify-content: space-between; align-items: flex-start; position: relative; z-index: 2; }
.overview-title { font-size: 34rpx; font-weight: 800; letter-spacing: 2rpx; }
.overview-subtitle { color: #79a58e; font-size: 23rpx; margin-top: 8rpx; }
.purchase-times { position: relative; z-index: 4; background: rgba(255,255,255,.9); color: #35a877; padding: 12rpx 18rpx; border-radius: 30rpx; font-size: 22rpx; }
.purchase-times text { font-size: 32rpx; font-weight: 800; }
.hero-heart { position: absolute; z-index: 4; top: -16rpx; right: 326rpx; width: 52rpx; height: 52rpx; border: 7rpx solid rgba(255,255,255,.9); border-radius: 50%; background: #fff; color: #ff8398; font-size: 40rpx; line-height: 52rpx; text-align: center; transform: rotate(-8deg); }
.cabbage { position: absolute; width: 210rpx; height: 188rpx; top: -44rpx; right: 170rpx; z-index: 3; }
.metric-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; position: relative; z-index: 2; }
.metric-item { min-height: 126rpx; padding: 16rpx; border-radius: 22rpx; background: rgba(255,255,255,.94); display: flex; align-items: center; }
.metric-icon { width: 70rpx; height: 70rpx; flex-shrink: 0; border-radius: 22rpx; display: flex; justify-content: center; align-items: center; margin-right: 14rpx; }
.metric-icon image { width: 54rpx; height: 54rpx; }
.icon-yellow { background: #fff8dc; }.icon-blue { background: #eaf6ff; }.icon-sky { background: #eaf7ff; }.icon-green { background: #e8faef; }
.metric-body { min-width: 0; }
.metric-label { font-size: 23rpx; }
.metric-value { font-size: 34rpx; font-weight: 800; margin: 5rpx 0; white-space: nowrap; }
.metric-unit { font-size: 22rpx; font-weight: 500; }
.metric-note { color: #8390a4; font-size: 21rpx; }
.trend-up { color: #ff5f62; }.trend-down { color: #18ad7b; }
.analysis-card { background: #fff; border-radius: 24rpx; padding: 22rpx; margin-top: 18rpx; box-shadow: 0 8rpx 24rpx rgba(31, 90, 73, .05); }
.core-card { padding: 22rpx 16rpx 18rpx; overflow: hidden; }
.core-card-hover { opacity: .88; transform: scale(.995); }
.core-head { padding: 0 6rpx; margin-bottom: 18rpx; }
.title-mark { width: 7rpx; height: 34rpx; margin-right: 11rpx; border-radius: 8rpx; background: #20bf82; }
.core-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10rpx; }
.core-item { min-width: 0; padding: 17rpx 8rpx 15rpx; border-radius: 18rpx; text-align: center; box-sizing: border-box; }
.core-loss { background: linear-gradient(180deg, #edfbf4, #f8fffb); }
.core-waste { background: linear-gradient(180deg, #fff0f3, #fff9fa); }
.core-return { background: linear-gradient(180deg, #f0efff, #fafaff); }
.core-meal { background: linear-gradient(180deg, #fff7e5, #fffcf5); }
.core-icon { width: 50rpx; height: 50rpx; margin: 0 auto 7rpx; border-radius: 15rpx; background: rgba(255,255,255,.88); display: flex; align-items: center; justify-content: center; }
.core-icon image { width: 36rpx; height: 36rpx; }
.core-label { color: #536176; font-size: 20rpx; white-space: nowrap; }
.core-value { margin: 7rpx 0; color: #152039; font-size: 26rpx; line-height: 1.2; font-weight: 800; white-space: nowrap; }
.core-note { min-height: 28rpx; color: #8b97a8; font-size: 16rpx; white-space: nowrap; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.section-title { font-size: 30rpx; font-weight: 800; display: flex; align-items: center; white-space: nowrap; }
.section-title image { width: 38rpx; height: 38rpx; margin-right: 12rpx; }
.more { color: #8290a3; font-size: 21rpx; display: flex; align-items: center; }
.more image { width: 24rpx; height: 24rpx; opacity: .5; margin-left: 4rpx; }
.self-content { display: grid; grid-template-columns: 190rpx 1fr 1fr; align-items: center; }
.donut-wrap { width: 170rpx; height: 170rpx; position: relative; display: flex; align-items: center; justify-content: center; }
.self-donut-chart { width: 170rpx; height: 170rpx; }
.donut-center { position: absolute; z-index: 2; text-align: center; color: #8090a3; font-size: 20rpx; pointer-events: none; }
.donut-center text { display: block; color: #152039; font-size: 30rpx; font-weight: 800; }
.self-amounts { padding: 0 18rpx; border-right: 1rpx solid #e4eaf0; }
.self-amounts > view { position: relative; padding-left: 24rpx; margin: 16rpx 0; color: #78869a; font-size: 22rpx; }
.self-amounts .strong { display: block; color: #16213a; font-size: 28rpx; font-weight: 700; margin-top: 5rpx; }
.dot { position: absolute; left: 0; top: 7rpx; width: 14rpx; height: 14rpx; border-radius: 50%; }.dot-green { background: #20b77d; }.dot-gray { background: #d6e0e8; }
.self-summary { padding-left: 22rpx; }
.self-summary > view { display: flex; align-items: center; margin: 15rpx 0; }
.self-summary image { width: 42rpx; height: 42rpx; margin-right: 10rpx; }
.self-summary text { display: block; color: #7b889b; font-size: 20rpx; }
.self-summary .strong { display: block; max-width: 150rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 25rpx; font-weight: 700; margin-top: 3rpx; }
.supplier-scroll, .amount-scroll { width: 100%; white-space: nowrap; }
.supplier-list { display: inline-flex; gap: 14rpx; }
.supplier-item { width: 190rpx; min-height: 150rpx; padding: 18rpx; border-radius: 20rpx; background: #f2f7ff; position: relative; box-sizing: border-box; }
.supplier-rank-1 { background: #fff7e6; }.supplier-rank-3 { background: #fff3ea; }
.supplier-name { font-size: 23rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; }.supplier-name text { color: #ffb400; margin-right: 6rpx; }
.supplier-money { font-size: 29rpx; font-weight: 800; margin: 18rpx 0 8rpx; }
.supplier-meta { color: #8190a6; font-size: 21rpx; }
.mini-ring { position: absolute; right: 12rpx; bottom: 12rpx; width: 56rpx; height: 56rpx; border: 7rpx solid #62c895; border-radius: 50%; font-size: 17rpx; display: flex; align-items: center; justify-content: center; background: #fff; }
.two-column { display: flex; flex-direction: column; gap: 14rpx; margin-top: 18rpx; }
.half-card { min-width: 0; padding: 18rpx 14rpx; margin-top: 0; }
.compact-head { margin-bottom: 10rpx; }.compact-head .section-title { font-size: 26rpx; }.compact-head .section-title image { width: 32rpx; height: 32rpx; margin-right: 7rpx; }
.compact-row, .times-row { min-height: 78rpx; display: flex; align-items: center; border-bottom: 1rpx solid #f0f3f5; }
.compact-row > image, .times-row > image { width: 50rpx; height: 50rpx; border-radius: 14rpx; margin-right: 8rpx; flex-shrink: 0; background: #f2f7f4; }
.compact-main, .times-main { flex: 1; min-width: 0; }
.compact-main text, .times-main text { display: block; max-width: 360rpx; font-size: 30rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.compact-main .small { display: block; color: #8794a5; font-size: 28rpx; margin-top: 5rpx; }
.fluctuation { color: #ff686d; font-size: 26rpx; font-weight: 700; }
.times-row .strong { font-size: 26rpx; font-weight: 700; margin-left: 7rpx; }
.bar-track { height: 12rpx; border-radius: 8rpx; background: #edf1f5; margin-top: 9rpx; overflow: hidden; }.bar-fill { height: 100%; background: #55c594; border-radius: 8rpx; }
.amount-list { height: 240rpx; display: inline-flex; gap: 30rpx; align-items: flex-end; padding: 0 8rpx; }
.amount-item { width: 140rpx; height: 230rpx; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; position: relative; }
.amount-bar { position: absolute; bottom: 62rpx; width: 58rpx; max-height: 150rpx; border-radius: 18rpx 18rpx 6rpx 6rpx; opacity: .8; }
.amount-color-0 { background: #48c895; }.amount-color-1 { background: #ff9298; }.amount-color-2 { background: #9dde83; }.amount-color-3 { background: #ff9b63; }.amount-color-4 { background: #ffc645; }
.amount-item image { width: 66rpx; height: 66rpx; border-radius: 50%; z-index: 1; background: #f4f7f5; }
.amount-item text { width: 150rpx; text-align: center; font-size: 28rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; z-index: 1; }
.amount-item .strong { font-size: 30rpx; font-weight: 700; margin-top: 3rpx; z-index: 1; }
.reminder-card { margin-top: 18rpx; padding: 20rpx; border: 1rpx solid #d8f1df; border-radius: 22rpx; background: linear-gradient(90deg,#edfaef,#f8fff8); display: flex; align-items: center; }
.reminder-card > image { width: 48rpx; height: 48rpx; margin-right: 10rpx; }.reminder-title { color: #1eaf75; font-size: 25rpx; font-weight: 800; padding-right: 18rpx; margin-right: 18rpx; border-right: 1rpx solid #bfe5cd; white-space: nowrap; }.reminder-text { color: #4f5c6c; font-size: 21rpx; line-height: 1.5; }
.empty-inline { color: #a3adb9; font-size: 23rpx; text-align: center; padding: 32rpx 0; }.small-empty { padding: 24rpx 0; }
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #718094; }
.empty-state image { width: 250rpx; height: 220rpx; }.empty-state text { font-size: 29rpx; font-weight: 700; }.empty-state view { color: #20af78; margin-top: 18rpx; font-size: 24rpx; }
.bottom-space { height: 60rpx; }
