<wxs src="/wxs/format.wxs" module="tool" />
<view class="page">
  <back-navbar title="{{dish.name || '菜品成本明细'}}" avatar="/images/back.png" bindnavbuttontap="toBack"></back-navbar>
  <view style="height:{{navBarHeight}}rpx"></view>

  <view class="date-bar" bindtap="toDatePage">
    <image src="/images/calender.png"></image>
    <view>
      <text>{{hanzi}}</text>
      <text>{{tool.transferDateString(startDate)}} - {{tool.transferDateString(stopDate)}}</text>
    </view>
  </view>

  <view wx:if="{{hasData}}">
    <view class="panel conclusion-panel">
      <view class="head conclusion-head">
        <view><text>分析结论</text><text class="info-icon">i</text></view>
      </view>

      <view class="conclusion-hero">
        <view class="conclusion-art"><image src="/images/dish-analysis/banner.png" mode="heightFix"></image></view>
        <image wx:if="{{dish.image}}" class="dish-image" src="{{dish.image}}" mode="aspectFill"></image>
        <view wx:else class="dish-placeholder">菜</view>
        <view class="dish-title-wrap">
          <text class="dish-title">{{dish.name}}</text>
          <text class="status-badge {{analysis.status}}">{{analysis.statusLabel}}</text>
        </view>
      </view>

      <view class="conclusion-grid">
        <view class="conclusion-metric actual">
          <text class="metric-icon">▂</text>
          <view><text>实际毛利率</text><text>{{dish.margin}}</text></view>
        </view>
        <view class="conclusion-metric target">
          <text class="metric-icon">◎</text>
          <view><text>目标区间</text><text>{{dish.targetRange}}</text></view>
        </view>
        <view class="conclusion-metric deviation {{analysis.status}}">
          <text class="metric-icon">↗</text>
          <view><text>偏离值</text><text>{{analysis.deviationLabel}} {{analysis.deviationValue}}</text></view>
        </view>
      </view>

      <view class="analysis-tip"><text>💡</text><text>{{analysis.advice}}</text></view>
    </view>

    <view class="panel business-panel">
      <view class="head"><text>收入和成本怎么来的</text><text>按步骤看懂</text></view>

      <view class="owner-step revenue-step">
        <view class="owner-step-head">
          <text class="owner-step-number">1</text>
          <view><text>先算原价应该收多少</text><text>每份售价 × 总出品份数 = 原价应收</text></view>
        </view>
        <view class="owner-equation">
          <view class="owner-metric price-metric"><text>每份售价</text><text>¥{{dish.price}}</text></view>
          <text class="owner-operator">×</text>
          <view class="owner-metric sales-metric"><text>总出品</text><text>{{dish.sales}}份</text></view>
          <text class="owner-operator">=</text>
          <view class="owner-metric list-revenue-metric"><text>原价应收</text><text>¥{{dish.originalRevenue}}</text></view>
        </view>
        <view class="owner-equation actual-revenue-equation">
          <view class="owner-metric list-revenue-metric"><text>原价应收</text><text>¥{{dish.originalRevenue}}</text></view>
          <text class="owner-operator">−</text>
          <view class="owner-metric concession-metric"><text>打折等少收</text><text>¥{{dish.unreceivedAmount}}</text></view>
          <text class="owner-operator">=</text>
          <view class="owner-metric received-metric"><text>实际收到</text><text>¥{{dish.revenue}}</text></view>
        </view>
        <view class="owner-note"><text>说明：</text><text>“打折等少收”包括打折、赠送、员工餐等没有收到的钱。</text></view>
      </view>

      <view class="owner-step cost-step">
        <view class="owner-step-head">
          <text class="owner-step-number">2</text>
          <view><text>再看做菜实际花了多少</text><text>用出库记录算实际用料成本，再和配方标准比较</text></view>
        </view>
        <view class="cost-compare-row">
          <view class="owner-metric theory-metric"><text>按配方应花</text><text>¥{{dish.theoryTotal}}</text></view>
          <text class="compare-word">对比</text>
          <view class="owner-metric actual-cost-metric"><text>实际用料成本</text><text>¥{{dish.actualCost}}</text></view>
          <text class="owner-operator">→</text>
          <view class="owner-metric difference-metric {{dish.differenceTone}}"><text>{{dish.differenceLabel}}</text><text>¥{{dish.differenceAbs}}</text></view>
        </view>
        <view class="owner-note cost-compare-note"><text>判断：</text><text>{{analysis.costCompareText}}</text></view>
      </view>
    </view>

    <view class="panel reason-panel">
      <view class="owner-step-head profit-step-head">
        <text class="owner-step-number">3</text>
        <view><text>最后算这道菜的实际毛利</text><text>实际收到 − 实际用料成本 = 实际毛利</text></view>
      </view>
      <view class="owner-equation profit-equation">
        <view class="owner-metric received-metric"><text>实际收到</text><text>¥{{dish.revenue}}</text></view>
        <text class="owner-operator">−</text>
        <view class="owner-metric actual-cost-metric"><text>实际用料成本</text><text>¥{{dish.actualCost}}</text></view>
        <text class="owner-operator">=</text>
        <view class="owner-metric profit-metric"><text>实际毛利</text><text>¥{{dish.actualProfit}}</text></view>
      </view>
      <view class="margin-rate-row">
        <view><text>实际毛利率</text><text>实际毛利 ÷ 实际收到</text></view>
        <text class="margin-rate-formula">¥{{dish.actualProfit}} ÷ ¥{{dish.revenue}} =</text>
        <text class="margin-rate-value {{analysis.status}}">{{dish.margin}}</text>
      </view>
      <view class="reason-note"><text>◎</text><text>目标毛利率 {{dish.targetRange}}，当前 {{dish.margin}}，{{analysis.deviationLabel}} {{analysis.deviationValue}}。</text></view>
    </view>

    <view class="panel ingredient-panel">
      <view class="head"><text>配料成本明细</text><text>按理论成本降序 ⇅</text></view>
      <view class="ingredient-table">
        <view class="table-head">
          <text>配料</text><text>单份用量</text><text>理论成本</text><text>出库分摊</text><text>成本差额</text><text>成本占比</text>
        </view>
        <view class="ingredient" wx:for="{{ingredients}}" wx:key="disGoodsId">
          <view class="ingredient-name">
            <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
            <view wx:else>料</view>
            <text>{{item.name}}</text>
          </view>
          <text class="portion-value">{{item.portion}}{{item.unit}}/份</text>
          <text>¥{{item.theoryCost}}</text>
          <text class="allocated-value">¥{{item.actualCost}}</text>
          <text class="{{item.diffTone}}">¥{{item.difference}}</text>
          <view class="share"><text>{{item.shareText}}%</text><view><view style="width:{{item.barWidth}}%"></view></view></view>
        </view>
      </view>
    </view>

    <view class="panel attention-panel">
      <view class="head"><text>重点关注</text></view>
      <view class="attention-grid">
        <view class="attention-card {{item.tone}}" wx:for="{{attention}}" wx:key="title">
          <text class="attention-icon">{{item.icon}}</text>
          <view><text>{{item.title}}</text><text>{{item.text}}</text></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="empty">暂无该菜品成本明细</view>
  <view class="bottom"></view>
</view>
