<wxs src="/wxs/format.wxs" module="tool" />
<view class="page"><back-navbar title="{{dish.name||'菜品成本明细'}}" avatar="/images/back.png" bindnavbuttontap="toBack"></back-navbar><view style="height:{{navBarHeight}}rpx"></view>
  <view class="date-bar" bindtap="toDatePage"><image src="/images/calender.png"></image><view><text>{{hanzi}}</text><text>{{tool.transferDateString(startDate)}} - {{tool.transferDateString(stopDate)}}</text></view><text>›</text></view>
  <view wx:if="{{hasData}}"><view class="hero"><view class="dish-head"><image wx:if="{{dish.image}}" src="{{dish.image}}" mode="aspectFill"></image><view wx:else class="placeholder">菜</view><view><text>{{dish.name}}</text><view><text>单价</text><text>¥{{dish.price}}/份</text><text>销量</text><text>{{dish.sales}}份</text><text>销售额</text><text>¥{{dish.revenue}}</text></view></view></view><view class="dish-summary"><view><text>配料数</text><text>{{dish.count}} 种</text></view><view><text>毛利率</text><text class="green">{{dish.margin}}%</text></view><view><text>理论总成本</text><text>¥{{dish.theoryTotal}}</text></view><view><text>出库分摊成本</text><text class="green">¥{{dish.actualCost}}</text></view><view><text>成本差额</text><text class="green">¥{{dish.difference}}</text></view></view></view>
  <view class="panel"><view class="head"><text>配料成本明细</text><text>按理论成本排序 ⇅</text></view><view class="table-head"><text>配料</text><text>单份用量</text><text>理论用量</text><text>理论成本</text><text>出库分摊成本</text><text>成本差额</text><text>成本占比</text></view><view class="ingredient" wx:for="{{ingredients}}" wx:key="disGoodsId"><view class="name"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image><view wx:else>料</view><text>{{item.name}}</text></view><text>{{item.portion}}{{item.unit}}/份</text><text>{{item.theoryQty}}{{item.unit}}</text><text>¥{{item.theoryCost}}</text><text class="green">¥{{item.actualCost}}</text><text class="green">¥{{item.difference}}</text><view class="share"><text>{{item.shareText}}%</text><view><view style="width:{{item.barWidth}}%"></view></view></view></view></view>
  <view class="panel"><text class="section-title">关键数据</text><view class="key-grid"><view><text>♛</text><view><text>成本TOP1</text><text>{{keyData.topName}}</text><text>{{keyData.topShare}}%</text></view></view><view><text>↓</text><view><text>节省最多</text><text>{{keyData.savingName}}</text><text>¥{{keyData.savingValue}}</text></view></view><view><text>▤</text><view><text>最小成本</text><text>{{keyData.minName}}</text><text>¥{{keyData.minCost}}</text></view></view></view></view>
  <view class="panel"><view class="head"><text>成本对比（理论成本）</text><text>单位：元</text></view><view class="compare" wx:for="{{ingredients}}" wx:key="disGoodsId"><text>{{item.name}}</text><view><view style="width:{{item.barWidth}}%"></view></view><text>¥{{item.theoryCost}}</text></view></view></view><view wx:elif="{{!loading}}" class="empty">暂无该菜品成本明细</view><view class="bottom"></view></view>
