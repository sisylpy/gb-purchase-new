page { background: #f3fafc; color: #122039; }
.page { min-height: 100vh; }
.date-bar { height: 92rpx; padding: 0 29rpx; background: #fff; display: flex; align-items: center; box-sizing: border-box; border-bottom: 1rpx solid #e4ebed; }
.date-bar image { width: 42rpx; height: 42rpx; margin-right: 14rpx; }
.date-bar > view { display: flex; flex-direction: column; }
.date-bar > view text:first-child { font-size: 30rpx; font-weight: 900; }
.date-bar > view text:last-child { color: #52647c; font-size: 23rpx; margin-top: 3rpx; }

.panel { margin: 14rpx 14rpx 0; padding: 17rpx; background: #fff; border-radius: 20rpx; box-shadow: 0 5rpx 18rpx rgba(39, 71, 87, .04); box-sizing: border-box; }
.head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 15rpx; }
.head > text:first-child, .head > view > text:first-child { position: relative; padding-left: 17rpx; color: #122039; font-size: 30rpx; font-weight: 900; }
.head > text:first-child::before, .head > view > text:first-child::before { content: ""; position: absolute; left: 0; top: 7rpx; width: 7rpx; height: 30rpx; border-radius: 6rpx; background: #31bf8a; }
.head > text:last-child { color: #60738a; font-size: 21rpx; }

.conclusion-head > view { display: flex; align-items: center; }
.info-icon { width: 34rpx; height: 34rpx; margin-left: 12rpx; border: 2rpx solid #8da0b4; border-radius: 50%; color: #6d8095; font-size: 22rpx; font-weight: 900; line-height: 30rpx; text-align: center; box-sizing: border-box; }
.conclusion-hero { position: relative; height: 150rpx; border-radius: 16rpx 16rpx 0 0; background: linear-gradient(100deg, #fffaf1 0%, #fff7eb 58%, #f2f7ee 100%); overflow: hidden; display: flex; align-items: center; padding: 16rpx; box-sizing: border-box; }
.conclusion-art { position: absolute; right: 0; top: 0; width: 225rpx; height: 150rpx; overflow: hidden; opacity: .95; }
.conclusion-art image { position: absolute; right: 0; top: 0; height: 150rpx; }
.dish-image, .dish-placeholder { position: relative; z-index: 1; width: 122rpx; height: 105rpx; margin-right: 16rpx; border-radius: 14rpx; flex-shrink: 0; }
.dish-placeholder { display: flex; align-items: center; justify-content: center; background: #e7f8ed; color: #078e58; font-size: 42rpx; font-weight: 900; }
.dish-title-wrap { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; max-width: 280rpx; }
.dish-title { max-width: 100%; color: #11213a; font-size: 34rpx; font-weight: 900; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.status-badge { margin-top: 11rpx; padding: 5rpx 15rpx; border-radius: 20rpx; font-size: 21rpx; font-weight: 800; }
.status-badge.high { background: #fff0df; color: #e46b00; }
.status-badge.low { background: #ffedef; color: #d92738; }
.status-badge.healthy { background: #e8faf0; color: #078c58; }
.status-badge.pending { background: #eaf4ff; color: #2574ca; }

.conclusion-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; padding-top: 13rpx; }
.conclusion-metric { min-height: 103rpx; border-radius: 15rpx; display: flex; align-items: center; padding: 12rpx; box-sizing: border-box; }
.conclusion-metric.actual { background: #eaf9f4; }
.conclusion-metric.target { background: #edf4ff; }
.conclusion-metric.deviation { background: #fff0f2; }
.conclusion-metric.deviation.high { background: #fff3e7; }
.conclusion-metric.deviation.healthy { background: #eaf9f4; }
.metric-icon { width: 50rpx; height: 50rpx; margin-right: 9rpx; border-radius: 13rpx; background: rgba(255,255,255,.65); color: #20b77a; font-size: 30rpx; line-height: 50rpx; text-align: center; flex-shrink: 0; }
.target .metric-icon { color: #3b83e5; }
.deviation .metric-icon { color: #e84552; }
.deviation.high .metric-icon { color: #ed7b12; }
.conclusion-metric > view { min-width: 0; display: flex; flex-direction: column; }
.conclusion-metric > view text:first-child { color: #66788c; font-size: 20rpx; }
.conclusion-metric > view text:last-child { margin-top: 5rpx; color: #122039; font-size: 29rpx; font-weight: 900; line-height: 1.25; }
.deviation > view text:last-child { color: #e5333e; font-size: 23rpx; }
.deviation.high > view text:last-child { color: #dc6e00; }
.deviation.healthy > view text:last-child { color: #078b58; }
.analysis-tip { min-height: 67rpx; margin-top: 12rpx; padding: 13rpx 17rpx; border-radius: 13rpx; background: #fff8e9; color: #43566b; display: flex; align-items: flex-start; box-sizing: border-box; }
.analysis-tip text:first-child { margin-right: 10rpx; font-size: 26rpx; }
.analysis-tip text:last-child { font-size: 21rpx; line-height: 1.45; }

.owner-step { padding: 14rpx; border: 1rpx solid #e0e9ec; border-radius: 16rpx; box-sizing: border-box; }
.owner-step + .owner-step { margin-top: 13rpx; }
.revenue-step { background: linear-gradient(110deg,#f5fbff,#fbfdff); }
.cost-step { background: linear-gradient(110deg,#fffaf3,#fffdf9); }
.owner-step-head { display: flex; align-items: center; }
.owner-step-number { width: 38rpx; height: 38rpx; margin-right: 12rpx; border-radius: 50%; background: #32b982; color: #fff; font-size: 23rpx; font-weight: 900; line-height: 38rpx; text-align: center; flex-shrink: 0; }
.cost-step .owner-step-number { background: #f0a443; }
.profit-step-head .owner-step-number { background: #548fe8; }
.owner-step-head > view { min-width: 0; display: flex; flex-direction: column; }
.owner-step-head > view text:first-child { color: #1b304a; font-size: 25rpx; font-weight: 900; }
.owner-step-head > view text:last-child { margin-top: 4rpx; color: #697b8f; font-size: 20rpx; line-height: 1.35; }
.owner-equation, .cost-compare-row { margin-top: 12rpx; display: grid; grid-template-columns: minmax(0,1fr) 28rpx minmax(0,1fr) 28rpx minmax(0,1fr); align-items: center; }
.cost-compare-row { grid-template-columns: minmax(0,1fr) 45rpx minmax(0,1fr) 28rpx minmax(0,1fr); }
.owner-metric { min-width: 0; min-height: 92rpx; padding: 11rpx 8rpx; border-radius: 13rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; }
.owner-metric > text:first-child { color: #566b83; font-size: 21rpx; white-space: nowrap; }
.owner-metric > text:last-child { margin-top: 6rpx; color: #142842; font-size: 29rpx; font-weight: 900; white-space: nowrap; }
.price-metric, .theory-metric { background: #fff2df; }
.sales-metric { background: #edf5ff; }
.list-revenue-metric { background: #e9f7f1; }
.concession-metric { background: #fff0e9; }
.concession-metric > text:last-child { color: #e26428; }
.received-metric { background: #e5f7ef; }
.received-metric > text:last-child { color: #087f61; }
.actual-cost-metric { background: #f0efff; }
.actual-cost-metric > text:last-child { color: #4d63c8; }
.difference-metric { background: #edf9f3; }
.difference-metric.saving > text:last-child { color: #078e5c; }
.difference-metric.danger { background: #fff0f1; }
.difference-metric.danger > text:last-child { color: #df3541; }
.profit-metric { background: #e5f7ef; }
.profit-metric > text:last-child { color: #087f61; }
.owner-operator, .compare-word { color: #7a8da2; font-size: 31rpx; font-weight: 900; text-align: center; }
.compare-word { font-size: 19rpx; }
.actual-revenue-equation { margin-top: 9rpx; }
.owner-note { margin-top: 10rpx; padding: 9rpx 12rpx; border-radius: 10rpx; background: rgba(255,255,255,.8); color: #65778b; font-size: 20rpx; line-height: 1.45; }
.owner-note text:first-child { color: #263b54; font-weight: 900; }
.cost-compare-note { background: #fff8e8; color: #79633f; }
.profit-step-head { padding: 2rpx 0 4rpx; }
.profit-equation { margin-top: 13rpx; }
.margin-rate-row { margin-top: 12rpx; padding: 12rpx 14rpx; border-radius: 13rpx; background: #f1f6ff; display: grid; grid-template-columns: 1fr auto auto; gap: 12rpx; align-items: center; }
.margin-rate-row > view { display: flex; flex-direction: column; }
.margin-rate-row > view text:first-child { color: #253b56; font-size: 23rpx; font-weight: 900; }
.margin-rate-row > view text:last-child { margin-top: 3rpx; color: #6a7c90; font-size: 18rpx; }
.margin-rate-formula { color: #61758d; font-size: 20rpx; }
.margin-rate-value { color: #e33945; font-size: 30rpx; font-weight: 900; }
.margin-rate-value.high { color: #df7000; }
.margin-rate-value.healthy { color: #078b58; }
.reason-note { min-height: 58rpx; margin-top: 12rpx; padding: 11rpx 15rpx; border-radius: 12rpx; background: #eefaf5; color: #47675d; display: flex; align-items: center; box-sizing: border-box; }
.reason-note text:first-child { margin-right: 10rpx; color: #10a86a; font-size: 28rpx; }
.reason-note text:last-child { font-size: 20rpx; line-height: 1.4; }

.ingredient-list { display: flex; flex-direction: column; gap: 13rpx; }
.ingredient-card { position: relative; padding: 17rpx 15rpx 15rpx; border: 1rpx solid #dce7ea; border-radius: 17rpx; background: #fff; box-shadow: 0 3rpx 10rpx rgba(42,76,91,.035); box-sizing: border-box; }
.ingredient-rank { position: absolute; left: 10rpx; top: 10rpx; z-index: 2; width: 38rpx; height: 38rpx; border-radius: 50%; background: #ffc95d; color: #8a5b00; font-size: 22rpx; font-weight: 900; line-height: 38rpx; text-align: center; }
.ingredient-card-head { min-height: 76rpx; padding: 0 0 12rpx 14rpx; display: flex; align-items: center; border-bottom: 1rpx solid #e2eaed; box-sizing: border-box; }
.ingredient-card-head > image, .ingredient-placeholder { width: 76rpx; height: 68rpx; margin-right: 13rpx; border-radius: 12rpx; flex-shrink: 0; }
.ingredient-placeholder { display: flex; align-items: center; justify-content: center; background: #e7f8ed; color: #078e58; font-size: 29rpx; font-weight: 900; }
.ingredient-title-wrap { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.ingredient-title-row { min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.ingredient-title-row > text:first-child { min-width: 0; color: #14263f; font-size: 29rpx; font-weight: 900; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ingredient-status { padding: 5rpx 12rpx; border-radius: 18rpx; font-size: 19rpx; font-weight: 800; white-space: nowrap; flex-shrink: 0; }
.ingredient-status.saving { background: #e9f9f1; }
.ingredient-status.danger { background: #fff0f1; }
.ingredient-status.neutral { background: #eef3f7; }
.ingredient-summary { margin-top: 7rpx; font-size: 21rpx; line-height: 1.35; }
.allocated-value, .saving { color: #07965d !important; }
.danger { color: #e3343e !important; }
.neutral { color: #566b82 !important; }

.ingredient-metrics { display: grid; grid-template-columns: repeat(4, 1fr); padding: 13rpx 0 12rpx; }
.ingredient-metrics > view { min-width: 0; padding: 0 8rpx; display: flex; flex-direction: column; align-items: center; border-right: 1rpx solid #e1e9ec; box-sizing: border-box; }
.ingredient-metrics > view:last-child { border-right: 0; }
.ingredient-metrics > view > text:first-child { color: #66798d; font-size: 19rpx; white-space: nowrap; }
.ingredient-metrics > view > text:nth-child(2) { margin-top: 5rpx; color: #14263f; font-size: 25rpx; font-weight: 900; white-space: nowrap; }
.ingredient-metrics > view > text:nth-child(2) > text { margin-left: 2rpx; font-size: 17rpx; font-weight: 700; }

.usage-bars { padding-top: 10rpx; border-top: 1rpx solid #e2eaed; }
.usage-bar-row { min-height: 37rpx; display: grid; grid-template-columns: 90rpx minmax(120rpx, 1fr) 132rpx; gap: 10rpx; align-items: center; }
.usage-bar-row > text:first-child { color: #5a6e84; font-size: 20rpx; }
.usage-bar-row > text:last-child { color: #4d6784; font-size: 20rpx; text-align: right; white-space: nowrap; }
.usage-track { height: 15rpx; overflow: hidden; border-radius: 10rpx; background: #e8eef0; }
.usage-fill { height: 100%; border-radius: 10rpx; }
.usage-fill.theory { background: linear-gradient(90deg,#218de5,#43adf2); }
.usage-fill.actual { background: linear-gradient(90deg,#09a96a,#36c68b); }

.attention-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }
.attention-card { min-height: 113rpx; padding: 13rpx; border-radius: 14rpx; display: flex; align-items: flex-start; box-sizing: border-box; }
.attention-card.red { background: #fff0f2; }
.attention-card.blue { background: #eef6ff; }
.attention-card.green { background: #eaf9f4; }
.attention-icon { width: 42rpx; height: 42rpx; margin-right: 9rpx; border-radius: 50%; background: rgba(255,255,255,.75); color: #e33a45; font-size: 25rpx; font-weight: 900; line-height: 42rpx; text-align: center; flex-shrink: 0; }
.attention-card.blue .attention-icon { color: #2e7edc; }
.attention-card.green .attention-icon { color: #0b9c62; }
.attention-card > view { min-width: 0; display: flex; flex-direction: column; }
.attention-card > view text:first-child { color: #21344d; font-size: 21rpx; font-weight: 900; line-height: 1.3; }
.attention-card > view text:last-child { margin-top: 6rpx; color: #66788c; font-size: 18rpx; line-height: 1.35; }

.empty { height: 500rpx; display: flex; align-items: center; justify-content: center; color: #68798b; font-size: 27rpx; }
.bottom { height: 35rpx; }
