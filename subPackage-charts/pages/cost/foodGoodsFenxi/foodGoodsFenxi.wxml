<wxs src="/wxs/format.wxs" module="tool" />

<view class="cost-page">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="菜品成本" avatar="/images/back-gray.png"
    bindnavbuttontap="toBack"></back-navbar>

  <view class="cost-toolbar">
    <view class="cost-date" bindtap="toDatePage">
      <image src="../../../../images/calender.png" class="cost-date__icon"></image>
      <view class="cost-date__text">
        <text class="cost-date__name">{{hanzi}}</text>
        <text class="cost-date__range" wx:if="{{startDate == stopDate}}">{{tool.transferDateString(startDate)}}</text>
        <text class="cost-date__range" wx:else>{{tool.transferDateString(startDate)}} - {{tool.transferDateString(stopDate)}}</text>
      </view>
    </view>
    <image src="/images/search-3.png" class="cost-search-button" bindtap="onToggleSearchBar"></image>
  </view>

  <view class="cost-search" wx:if="{{searchBarOpen}}">
    <image src="/images/search-3.png" class="cost-search__icon"></image>
    <input class="cost-search__input" value="{{dishNameSearchDraft}}" placeholder="搜索菜品名称"
      confirm-type="search" focus="{{searchInputFocus}}" bindinput="onDishNameSearchInput"
      bindconfirm="onDishNameSearchConfirm" />
    <text class="cost-search__clear" wx:if="{{dishNameSearchDraft}}" bindtap="onDishNameSearchClear">×</text>
  </view>

  <scroll-view scroll-y class="cost-scroll">
    <view class="cost-summary" wx:if="{{reportSummary}}">
      <view class="cost-summary-card">
        <text class="cost-summary-card__label">营业额</text>
        <text class="cost-summary-card__value">¥{{reportSummary.totalRevenueText}}</text>
        <text class="cost-summary-card__hint">销量 {{reportSummary.totalSalesQuantityText}} 份</text>
      </view>
      <view class="cost-summary-card">
        <text class="cost-summary-card__label">历史理论成本</text>
        <text class="cost-summary-card__value" wx:if="{{reportSummary.allComplete}}">¥{{reportSummary.totalCostText}}</text>
        <text class="cost-summary-card__value cost-summary-card__value--pending" wx:else>待完善</text>
        <text class="cost-summary-card__hint" wx:if="{{!reportSummary.allComplete && reportSummary.hasResolvedCost}}">已完整 ¥{{reportSummary.resolvedCostText}}</text>
        <text class="cost-summary-card__hint" wx:elif="{{!reportSummary.allComplete}}">已完整 —</text>
        <text class="cost-summary-card__hint" wx:else>按营业日采购价</text>
      </view>
      <view class="cost-summary-card">
        <text class="cost-summary-card__label">销量核算完整率</text>
        <text class="cost-summary-card__value">{{reportSummary.salesCoverageRateText}}%</text>
        <text class="cost-summary-card__hint">{{reportSummary.completedGrainCount}} / {{reportSummary.totalGrainCount}} 个营业日</text>
      </view>
    </view>

    <view class="cost-warning" wx:if="{{reportSummary && !reportSummary.allComplete}}">
      <text class="cost-warning__title">还有 {{reportSummary.pendingGrainCount}} 条营业日成本待完善</text>
      <text class="cost-warning__text" wx:if="{{reportSummary.hasKnownEvidence}}">缺失成本不会按 0 元计算。已知配料金额 ¥{{reportSummary.knownPartialCostText}} 只用于排查，不是最终菜品成本。</text>
      <text class="cost-warning__text" wx:else>缺失成本不会按 0 元计算；当前没有可用于金额计算的完整配料证据。</text>
    </view>

    <view class="cost-list-head" wx:if="{{dishRowsAll.length && !dishNameSearch}}">
      <text class="cost-list-head__title">菜品明细（{{dishRowsAll.length}}）</text>
      <view class="cost-sort-row">
        <view class="cost-sort {{sortBy === 'status' ? 'is-active' : ''}}" data-sort="status" bindtap="onSort">待完善</view>
        <view class="cost-sort {{sortBy === 'revenue' ? 'is-active' : ''}}" data-sort="revenue" bindtap="onSort">营业额</view>
        <view class="cost-sort {{sortBy === 'sales' ? 'is-active' : ''}}" data-sort="sales" bindtap="onSort">销量</view>
        <view class="cost-sort {{sortBy === 'completion' ? 'is-active' : ''}}" data-sort="completion" bindtap="onSort">完整率</view>
      </view>
    </view>

    <view class="cost-empty" wx:if="{{!loading && !dishRows.length}}">
      <text>{{dishNameSearch ? '没有找到相关菜品' : (emptyHint || '暂无成本数据')}}</text>
    </view>

    <view class="cost-dish-list" wx:if="{{dishRows.length}}">
      <view class="cost-dish" wx:for="{{dishRows}}" wx:key="foodId">
        <view class="cost-dish__head">
          <view class="cost-dish__name-wrap">
            <text class="cost-dish__index">{{index + 1}}</text>
            <view class="cost-dish__title-wrap">
              <text class="cost-dish__title">{{item.dishName}}</text>
              <text class="cost-dish__sub">销量 {{item.salesQuantityText}} 份 · 营业额 ¥{{item.revenueAmountText}}</text>
            </view>
          </view>
          <text class="cost-status {{item.allComplete ? 'is-complete' : (item.status === 'RECALCULATION_PENDING' ? 'is-running' : 'is-pending')}}">{{item.statusLabel}}</text>
        </view>

        <view class="cost-dish__metrics">
          <view class="cost-metric">
            <text class="cost-metric__label">历史理论成本</text>
            <text class="cost-metric__value" wx:if="{{item.allComplete}}">¥{{item.totalCostText}}</text>
            <text class="cost-metric__value is-empty" wx:else>—</text>
          </view>
          <view class="cost-metric">
            <text class="cost-metric__label">单份成本</text>
            <text class="cost-metric__value" wx:if="{{item.allComplete}}">¥{{item.costPerPortionText}}</text>
            <text class="cost-metric__value is-empty" wx:else>—</text>
          </view>
          <view class="cost-metric">
            <text class="cost-metric__label">理论毛利率</text>
            <text class="cost-metric__value" wx:if="{{item.allComplete}}">{{item.grossMarginRateText}}%</text>
            <text class="cost-metric__value is-empty" wx:else>—</text>
          </view>
          <view class="cost-metric">
            <text class="cost-metric__label">销量完整率</text>
            <text class="cost-metric__value">{{item.salesCoverageRateText}}%</text>
          </view>
        </view>

        <view class="cost-partial" wx:if="{{!item.allComplete && item.hasKnownEvidence}}">
          <text>已核算部分 ¥{{item.knownPartialCostText}}</text>
          <text>配料证据完整率 {{item.evidenceCoverageRateText}}%</text>
        </view>

        <view class="cost-reasons" wx:if="{{item.missingReasons.length}}">
          <view class="cost-reason" wx:for="{{item.missingReasons}}" wx:for-item="reason" wx:key="*this">
            <text class="cost-reason__dot">!</text>
            <text class="cost-reason__text">{{reason}}</text>
          </view>
        </view>

        <view class="cost-expand" bindtap="onToggleDishDetail" data-index="{{index}}">
          <text>{{item._expanded ? '收起营业日明细' : '查看营业日明细'}}</text>
          <text>{{item._expanded ? '⌃' : '⌄'}}</text>
        </view>

        <view class="cost-days" wx:if="{{item._expanded}}">
          <view class="cost-day" wx:for="{{item.dailyRows}}" wx:for-item="day" wx:key="salesInputVersionId">
            <view class="cost-day__top">
              <view>
                <text class="cost-day__date">{{day.businessDate}}</text>
                <text class="cost-day__sales">{{day.salesQuantityText}} 份 · ¥{{day.revenueAmountText}}</text>
              </view>
              <text class="cost-status cost-status--small {{day.isComplete ? 'is-complete' : (day.isCalculating ? 'is-running' : 'is-pending')}}">{{day.statusLabel}}</text>
            </view>
            <view class="cost-day__body">
              <text>配方 {{day.recipeVersionText}}</text>
              <text wx:if="{{day.isComplete}}">成本 ¥{{day.completeCostAmountText}}</text>
              <text wx:elif="{{day.hasKnownEvidence}}">已知部分 ¥{{day.knownCostAmountText}}</text>
              <text wx:else>成本 —</text>
            </view>
            <text class="cost-day__reason" wx:if="{{day.missingReasonText}}">{{day.missingReasonText}}</text>
            <view class="cost-day__evidence" wx:if="{{day.resultId}}"
              data-result-id="{{day.resultId}}" data-food-id="{{item.foodId}}"
              data-business-date="{{day.businessDate}}" data-dish-name="{{item.dishName}}"
              bindtap="onOpenCostEvidence">
              <text>查看成本证据</text>
              <text>›</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="cost-bottom-space"></view>
  </scroll-view>
</view>
