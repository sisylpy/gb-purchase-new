<wxs src="/wxs/format.wxs" module="tool" />
<wxs module="utilLv" src="/wxs/utilizationLevel.wxs" />
<wxs module="num" src="/wxs/signedNumber.wxs" />

<view class="cost-page">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="菜品分析" avatar="/images/back-gray.png"
    button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view class="cost-toolbar">
    <view class="cost-date" bindtap="toDatePage">
      <image src="../../../../images/calender.png" class="cost-date__icon"></image>
      <view class="cost-date__text">
        <text class="cost-date__name">{{hanzi}}</text>
        <text class="cost-date__range" wx:if="{{startDate == stopDate}}">{{tool.transferDateString(startDate)}}</text>
        <text class="cost-date__range" wx:else>{{tool.transferDateString(startDate)}} - {{tool.transferDateString(stopDate)}}</text>
      </view>
    </view>
    <image src="/images/search-3.png" class="cost-search-button" bindtap="onToggleSearchBar"></image>
  </view>

  <view class="cost-search" wx:if="{{searchBarOpen}}">
    <image src="/images/search-3.png" class="cost-search__icon"></image>
    <input class="cost-search__input" value="{{dishNameSearchDraft}}" placeholder="搜索菜品名称"
      confirm-type="search" focus="{{searchInputFocus}}" bindinput="onDishNameSearchInput"
      bindconfirm="onDishNameSearchConfirm" />
    <text class="cost-search__clear" wx:if="{{dishNameSearchDraft}}" bindtap="onDishNameSearchClear">×</text>
  </view>

  <scroll-view scroll-y class="cost-scroll">
    <!-- 原菜品分析汇总：保留出库分摊、理论成本和偏差。 -->
    <view class="cost-summary" wx:if="{{scopeSalesSubtotals && !dishNameSearch}}">
      <view class="cost-summary-card">
        <text class="cost-summary-card__label">出库分摊总成本</text>
        <text class="cost-summary-card__value">¥{{scopeSalesSubtotals.outboundAllocatedCostTotal}}</text>
        <text class="cost-summary-card__hint">库存出库归集与分摊</text>
      </view>
      <view class="cost-summary-card">
        <text class="cost-summary-card__label">理论总成本</text>
        <text class="cost-summary-card__value">¥{{scopeSalesSubtotals.theoreticalCostTotal}}</text>
        <text class="cost-summary-card__hint">{{scopeSalesSubtotals._theoreticalHint}}</text>
      </view>
      <view class="cost-summary-card">
        <text class="cost-summary-card__label">成本偏差率</text>
        <text class="cost-summary-card__value">{{scopeSalesSubtotals.costDeviationRateDisplay}}</text>
        <text class="cost-summary-card__hint">差额 {{scopeSalesSubtotals.costDeviationTotal}} 元</text>
      </view>
    </view>

    <!-- 新核算校验仅作为附加信息，不替换原菜品分析。 -->
    <view class="history-summary" wx:if="{{historicalSummary && !dishNameSearch}}">
      <view class="history-summary__head">
        <text class="history-summary__title">理论成本核算</text>
        <text class="history-summary__rate">销量完整率 {{historicalSummary.salesCoverageRateText}}%</text>
      </view>
      <text class="history-summary__text" wx:if="{{historicalSummary.allComplete}}">
        按营业日有效配方和当日有效入库价核算：¥{{historicalSummary.totalCostText}}
      </text>
      <text class="history-summary__text" wx:elif="{{historicalSummary.hasResolvedCost}}">
        已完整核算 ¥{{historicalSummary.resolvedCostText}}；其余部分保持“—”，不按 0 元计算
      </text>
      <text class="history-summary__text" wx:else>当前没有完整理论成本；缺失数据保持“—”，不按 0 元计算</text>
    </view>

    <view class="cost-list-head" wx:if="{{salesDishRowsAll.length && !dishNameSearch}}">
      <text class="cost-list-head__title">菜品明细（{{salesDishRowsAll.length}}）</text>
      <view class="cost-sort-row">
        <view class="cost-sort {{sortBy === 'diffCostPerPortion' ? 'is-active' : ''}}"
          data-sort="diffCostPerPortion" bindtap="onIngredientSort">成本偏差</view>
        <view class="cost-sort {{sortBy === 'diffRate' ? 'is-active' : ''}}"
          data-sort="diffRate" bindtap="onIngredientSort">偏差率</view>
        <view class="cost-sort {{sortBy === 'ingredientCount' ? 'is-active' : ''}}"
          data-sort="ingredientCount" bindtap="onIngredientSort">配料数量</view>
      </view>
    </view>

    <view class="cost-empty" wx:if="{{!loading && !salesDishRows.length}}">
      <text>{{dishNameSearch ? '没有找到相关菜品' : (emptyHint || '暂无菜品分析数据')}}</text>
    </view>

    <view class="cost-dish-list" wx:if="{{salesDishRows.length}}">
      <view class="cost-dish" wx:for="{{salesDishRows}}" wx:key="_foodId">
        <view class="cost-dish__head">
          <view class="cost-dish__name-wrap">
            <text class="cost-dish__index">{{index + 1}}.</text>
            <view class="cost-dish__title-wrap">
              <text class="cost-dish__title">{{item.dishName || item.gbDfFoodName}}</text>
              <text class="cost-dish__sub">
                售价: {{item.salesUnitPrice != null ? item.salesUnitPrice : '—'}}元/份 ·
                销量: {{item.salesPortions != null ? item.salesPortions : '—'}}份 ·
                配料 {{item.ingredientCount || 0}} 种
              </text>
            </view>
          </view>
        </view>

        <!-- 原功能：单份成本对比。 -->
        <view class="cost-dish__metrics original-metrics">
          <view class="cost-metric">
            <text class="cost-metric__label">出库分摊成本</text>
            <text class="cost-metric__value {{item._outboundCostPerPortionText === '—' ? 'is-empty' : ''}}">{{item._outboundCostPerPortionText}}</text>
            <text class="cost-metric__unit">元/份</text>
          </view>
          <view class="cost-metric">
            <text class="cost-metric__label">理论成本</text>
            <text class="cost-metric__value {{item._theoryCostPerPortionText === '—' ? 'is-empty' : ''}}">{{item._theoryCostPerPortionText}}</text>
            <text class="cost-metric__unit">元/份·销量加权</text>
          </view>
          <view class="cost-metric">
            <text class="cost-metric__label">成本偏差</text>
            <text class="cost-metric__value metric-deviation {{num.diffClass(item._costDiffPerPortionText)}}">
              {{num.formatSigned(item._costDiffPerPortionText)}}
              {{num.signKind(item._costDiffPerPortionText) === 'pos' ? '↑' : (num.signKind(item._costDiffPerPortionText) === 'neg' ? '↓' : '')}}
            </text>
            <text class="cost-metric__unit">元/份</text>
          </view>
          <view class="cost-metric">
            <text class="cost-metric__label">偏差率</text>
            <text class="cost-metric__value metric-deviation">{{item._costDiffRateDisplayText}}</text>
            <text class="cost-metric__unit"></text>
          </view>
        </view>

        <!-- 附加校验：不替代上面的原成本字段。 -->
        <view class="history-strip" wx:if="{{item._historical}}">
          <view class="history-strip__head">
            <text>理论成本核算</text>
            <text class="cost-status {{item._historical.allComplete ? 'is-complete' : (item._historical.status === 'RECALCULATION_PENDING' ? 'is-running' : 'is-pending')}}">
              {{item._historical.statusLabel}}
            </text>
          </view>
          <view class="history-strip__values">
            <text>本期完整成本 {{item._historical.completeCostDisplayText}}</text>
            <text>销量完整率 {{item._historical.salesCoverageRateText}}%</text>
            <text>证据完整率 {{item._historical.evidenceCoverageRateText}}%</text>
          </view>
          <text class="history-strip__breakdown" wx:if="{{item._historical.versionCostBreakdownText}}">
            {{item._historical.versionCostBreakdownText}}
          </text>
          <text class="history-strip__reason" wx:if="{{item._historical.missingReasons.length}}">
            {{item._historical.missingReasons[0]}}
          </text>
        </view>

        <view class="cost-expand" bindtap="onToggleDishDetail" data-index="{{index}}">
          <text>{{item._expanded ? '收起详情' : '展开更多'}}</text>
          <text>{{item._expanded ? '⌃' : '⌄'}}</text>
        </view>

        <view class="legacy-detail" wx:if="{{item._expanded}}">
          <!-- 原功能：总量成本对比。 -->
          <view class="legacy-section">
            <view class="legacy-section__title">总量成本对比</view>
            <view class="legacy-total-metrics">
              <view>
                <text>出库分摊成本</text>
                <text>{{item._outboundCostAmountText}}</text>
                <text>元</text>
              </view>
              <view>
                <text>理论总成本</text>
                <text>{{item._theoryCostTotalText}}</text>
                <text>元</text>
              </view>
              <view>
                <text>成本差额</text>
                <text class="metric-deviation">{{item._costTotalDiffText}}</text>
                <text>元</text>
              </view>
            </view>
          </view>

          <!-- 原功能：配料偏差、理论/分摊含量及出库数据。 -->
          <view class="legacy-section">
            <view class="legacy-section__title">主要配料分析</view>
            <scroll-view scroll-x class="legacy-ingredient-scroll" wx:if="{{item.ingredientRows.length}}">
              <view class="legacy-ingredient-table">
                <view class="legacy-ingredient-row is-head">
                  <text class="legacy-ingredient-name">配料</text>
                  <text>理论成本</text>
                  <text>{{item._ingredientDeviationTitle}}</text>
                  <text>理论含量</text>
                  <text>分摊含量</text>
                  <text>出库分摊成本</text>
                  <text>制作总量</text>
                  <text>损耗总量</text>
                </view>
                <view class="legacy-ingredient-row" wx:for="{{item.ingredientRows}}" wx:for-item="ingredient" wx:key="_intervalKey">
                  <view class="legacy-ingredient-name">
                    <image class="legacy-ingredient-image" wx:if="{{ingredient._imageUrl}}" src="{{ingredient._imageUrl}}" mode="aspectFill"></image>
                    <view class="legacy-ingredient-image is-empty" wx:else>料</view>
                    <text>{{ingredient.gbDgGoodsName}}</text>
                  </view>
                  <view class="legacy-ingredient-cell">
                    <text>{{ingredient._theoryCostText}}</text>
                    <text class="legacy-ingredient-tag" wx:if="{{ingredient._theoryCostText !== '—'}}">有效期内每份</text>
                  </view>
                  <view class="legacy-ingredient-cell">
                    <text>{{ingredient._devianceText}}{{ingredient._devianceText === '—' ? '' : '%'}}</text>
                    <text class="legacy-ingredient-tag" wx:if="{{ingredient._devianceHint}}">{{ingredient._devianceHint}}</text>
                    <text class="legacy-ingredient-tag {{utilLv.textClass(ingredient.deviance.level)}}"
                      wx:elif="{{ingredient.deviance}}">{{ingredient.deviance.labelZh}}</text>
                  </view>
                  <view class="legacy-ingredient-cell">
                    <text>{{ingredient._theoryQuantityText}}</text>
                  </view>
                  <view class="legacy-ingredient-cell">
                    <text>{{ingredient._allocatedQuantityText}}</text>
                    <text class="legacy-ingredient-tag" wx:if="{{ingredient._allocatedQuantityHint}}">{{ingredient._allocatedQuantityHint}}</text>
                  </view>
                  <view class="legacy-ingredient-cell">
                    <text>{{ingredient._outboundCostText}}</text>
                    <text>元/份</text>
                  </view>
                  <view class="legacy-ingredient-cell">
                    <text>{{ingredient.actualProduceUsage != null ? ingredient.actualProduceUsage : '—'}}</text>
                    <text>{{ingredient.gbDgGoodsStandardname}}</text>
                  </view>
                  <view class="legacy-ingredient-cell">
                    <text>{{ingredient.actualLossAndWasteUsage != null ? ingredient.actualLossAndWasteUsage : '—'}}</text>
                    <text>{{ingredient.gbDgGoodsStandardname}}</text>
                  </view>
                </view>
              </view>
            </scroll-view>
            <view class="cost-ingredients__empty" wx:else>该菜品暂无配料分析明细</view>
          </view>

          <!-- 新功能：按营业日配方版本和入库价格形成的验证证据。 -->
          <view class="legacy-section history-detail" wx:if="{{item._historical}}">
            <view class="history-detail__head">
              <view>
                <text class="legacy-section__title">理论成本明细</text>
                <text class="history-detail__hint">按所选营业日期及有效配方汇总</text>
              </view>
              <text>{{item._historical.ingredientSummaries.length}} 种配料</text>
            </view>
            <view class="cost-ingredients__empty" wx:if="{{!item._historical.ingredientSummaries.length}}">
              当前日期范围没有可汇总的成本证据
            </view>
            <view class="cost-ingredient" wx:for="{{item._historical.ingredientSummaries}}"
              wx:for-item="historyIngredient" wx:key="_key">
              <view class="cost-ingredient__head">
                <view class="cost-ingredient__identity">
                  <image class="cost-ingredient__image" wx:if="{{historyIngredient._imageUrl}}"
                    src="{{historyIngredient._imageUrl}}" mode="aspectFill"></image>
                  <view class="cost-ingredient__image cost-ingredient__image--empty" wx:else>料</view>
                  <view class="cost-ingredient__name-wrap">
                    <text class="cost-ingredient__name">{{historyIngredient._name}}</text>
                    <text class="cost-ingredient__spec" wx:if="{{historyIngredient._spec}}">{{historyIngredient._spec}}</text>
                    <text class="cost-ingredient__spec">{{historyIngredient._versionText}} · {{historyIngredient._dateText}}</text>
                  </view>
                </view>
                <text class="cost-status cost-status--small {{historyIngredient.allEvidenceComplete ? 'is-complete' : 'is-pending'}}">
                  {{historyIngredient.statusLabel}}
                </text>
              </view>
              <view class="cost-ingredient__metrics">
                <view><text>单份配方用量</text><text>{{historyIngredient._portionText}}</text></view>
                <view><text>累计理论用量</text><text>{{historyIngredient._totalQuantityText}}</text></view>
                <view><text>基础单价</text><text>{{historyIngredient._priceText}}</text></view>
                <view>
                  <text>理论成本</text>
                  <text wx:if="{{historyIngredient.completeCostAmount != null}}">{{historyIngredient._costText}}</text>
                  <text wx:elif="{{historyIngredient.knownCostAmount > 0}}">已知 {{historyIngredient._knownCostText}}</text>
                  <text wx:else>—</text>
                </view>
              </view>
              <text class="cost-ingredient__reason" wx:if="{{historyIngredient._missingReasonText}}">{{historyIngredient._missingReasonText}}</text>
              <view class="cost-ingredient__evidence" wx:if="{{historyIngredient.latestResultId}}"
                data-result-id="{{historyIngredient.latestResultId}}" data-food-id="{{item._foodId}}"
                data-business-date="{{historyIngredient.lastBusinessDate}}"
                data-dish-name="{{item.dishName || item.gbDfFoodName}}" bindtap="onOpenCostEvidence">
                <text>查看最近营业日的成本证据</text>
                <text>›</text>
              </view>
            </view>
          </view>

          <!-- 原入口保留。 -->
          <view class="legacy-ingredient-dashboard" catchtap="onOpenIngredients" data-dish="{{item}}">
            <text>查看配料成本分析</text>
            <text>›</text>
          </view>
        </view>
      </view>
    </view>
    <view class="cost-bottom-space"></view>
  </scroll-view>
</view>
