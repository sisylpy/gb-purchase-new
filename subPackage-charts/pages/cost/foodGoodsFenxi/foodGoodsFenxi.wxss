page {
  height: 100%;
  background: #f3f5f4;
  color: #1f2933;
}

.cost-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.cost-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #e7ece9;
}

.cost-date {
  display: flex;
  align-items: center;
  min-width: 0;
}

.cost-date__icon,
.cost-search-button {
  width: 40rpx;
  height: 40rpx;
}

.cost-date__icon {
  margin-right: 14rpx;
}

.cost-date__text {
  display: flex;
  flex-direction: column;
}

.cost-date__name {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 650;
}

.cost-date__range {
  color: #77817d;
  font-size: 23rpx;
  line-height: 32rpx;
}

.cost-search-button {
  padding: 16rpx;
  opacity: .72;
}

.cost-search {
  display: flex;
  align-items: center;
  margin: 14rpx 20rpx 0;
  padding: 12rpx 18rpx;
  min-height: 72rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #fff;
}

.cost-search__icon {
  width: 32rpx;
  height: 32rpx;
  opacity: .5;
  margin-right: 12rpx;
}

.cost-search__input {
  flex: 1;
  height: 46rpx;
  font-size: 28rpx;
}

.cost-search__clear {
  padding: 0 8rpx;
  font-size: 38rpx;
  color: #98a19d;
}

.cost-scroll {
  flex: 1;
  height: 0;
}

.cost-summary {
  display: flex;
  padding: 18rpx 16rpx 10rpx;
  gap: 10rpx;
}

.cost-summary-card {
  flex: 1;
  min-width: 0;
  padding: 20rpx 10rpx 16rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(26, 65, 52, .05);
  text-align: center;
}

.cost-summary-card__label {
  display: block;
  min-height: 54rpx;
  font-size: 23rpx;
  line-height: 30rpx;
  color: #64716c;
}

.cost-summary-card__value {
  display: block;
  margin-top: 4rpx;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 750;
  color: #146f60;
}

.cost-summary-card__value--pending {
  color: #c9771a;
}

.cost-summary-card__hint {
  display: block;
  margin-top: 4rpx;
  min-height: 30rpx;
  font-size: 21rpx;
  line-height: 30rpx;
  color: #8a9590;
}

.cost-warning {
  display: flex;
  flex-direction: column;
  margin: 6rpx 16rpx 14rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #f0d7ad;
  border-radius: 16rpx;
  background: #fff9ee;
}

.cost-warning__title {
  color: #a85c0b;
  font-size: 27rpx;
  line-height: 38rpx;
  font-weight: 650;
}

.cost-warning__text {
  margin-top: 6rpx;
  color: #846e53;
  font-size: 23rpx;
  line-height: 34rpx;
}

.cost-list-head {
  margin: 0 16rpx 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff;
}

.cost-list-head__title {
  display: block;
  margin-bottom: 14rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.cost-sort-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.cost-sort {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f1f4f2;
  color: #66716d;
  font-size: 23rpx;
}

.cost-sort.is-active {
  background: #e0f3ed;
  color: #12806d;
  font-weight: 650;
}

.cost-dish-list {
  padding: 0 16rpx;
}

.cost-dish {
  margin-bottom: 16rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(26, 65, 52, .05);
}

.cost-dish__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 22rpx 20rpx 16rpx;
  gap: 16rpx;
}

.cost-dish__name-wrap {
  display: flex;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
}

.cost-dish__index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: #e9f5f1;
  color: #168472;
  font-size: 23rpx;
  font-weight: 700;
}

.cost-dish__title-wrap {
  min-width: 0;
}

.cost-dish__title {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 31rpx;
  line-height: 42rpx;
  font-weight: 700;
}

.cost-dish__sub {
  display: block;
  margin-top: 5rpx;
  font-size: 23rpx;
  line-height: 32rpx;
  color: #7c8782;
}

.cost-status {
  flex-shrink: 0;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  color: #a85c0b;
  background: #fff1d9;
}

.cost-status.is-complete {
  color: #137965;
  background: #ddf4ed;
}

.cost-status.is-running {
  color: #356fa8;
  background: #e5f0fb;
}

.cost-status--small {
  font-size: 20rpx;
  padding: 5rpx 10rpx;
}

.cost-dish__metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin: 0 20rpx;
  padding: 17rpx 0;
  border-top: 1rpx solid #edf0ee;
  border-bottom: 1rpx solid #edf0ee;
}

.cost-metric {
  min-width: 0;
  padding: 0 8rpx;
  text-align: center;
  border-right: 1rpx solid #edf0ee;
}

.cost-metric:last-child {
  border-right: 0;
}

.cost-metric__label {
  display: block;
  min-height: 54rpx;
  color: #74807b;
  font-size: 21rpx;
  line-height: 27rpx;
}

.cost-metric__value {
  display: block;
  margin-top: 4rpx;
  color: #157b69;
  font-size: 27rpx;
  line-height: 38rpx;
  font-weight: 700;
}

.cost-metric__value.is-empty {
  color: #a5ada9;
}

.cost-partial {
  display: flex;
  justify-content: space-between;
  margin: 14rpx 20rpx 0;
  padding: 12rpx 15rpx;
  border-radius: 12rpx;
  background: #f4f8f6;
  color: #557068;
  font-size: 22rpx;
}

.cost-reasons {
  margin: 14rpx 20rpx 0;
  padding: 12rpx 15rpx;
  border-radius: 12rpx;
  background: #fff8ee;
}

.cost-reason {
  display: flex;
  align-items: flex-start;
  margin-bottom: 6rpx;
}

.cost-reason:last-child {
  margin-bottom: 0;
}

.cost-reason__dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  margin: 2rpx 9rpx 0 0;
  border-radius: 50%;
  background: #e8a347;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
}

.cost-reason__text {
  flex: 1;
  color: #8f5d24;
  font-size: 22rpx;
  line-height: 33rpx;
}

.cost-expand {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding: 17rpx 22rpx;
  border-top: 1rpx solid #edf0ee;
  color: #257f70;
  font-size: 24rpx;
}

.cost-ingredients {
  padding: 0 20rpx 18rpx;
  background: #fbfcfb;
}

.cost-ingredients__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0 10rpx;
  color: #384640;
  font-size: 25rpx;
  font-weight: 650;
}

.cost-ingredients__head text:last-child {
  color: #87918d;
  font-size: 21rpx;
  font-weight: 400;
}

.cost-ingredients__empty {
  padding: 24rpx 16rpx;
  border-radius: 12rpx;
  background: #f2f5f3;
  color: #7f8985;
  font-size: 22rpx;
  line-height: 32rpx;
}

.cost-ingredient {
  padding: 17rpx 0;
  border-bottom: 1rpx solid #e8ecea;
}

.cost-ingredient:last-child {
  border-bottom: 0;
}

.cost-ingredient__head,
.cost-ingredient__identity {
  display: flex;
  align-items: center;
}

.cost-ingredient__head {
  justify-content: space-between;
  gap: 12rpx;
}

.cost-ingredient__identity {
  flex: 1;
  min-width: 0;
}

.cost-ingredient__image {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 70rpx;
  height: 70rpx;
  margin-right: 13rpx;
  border-radius: 12rpx;
  background: #eef3f1;
  color: #7a8a84;
  font-size: 22rpx;
}

.cost-ingredient__image--empty {
  color: #168472;
  background: #e5f4ef;
  font-weight: 700;
}

.cost-ingredient__name-wrap {
  min-width: 0;
}

.cost-ingredient__name {
  display: block;
  color: #33413c;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 650;
}

.cost-ingredient__spec {
  display: block;
  margin-top: 2rpx;
  color: #86908c;
  font-size: 21rpx;
  line-height: 29rpx;
}

.cost-ingredient__metrics {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx 20rpx;
  margin-top: 15rpx;
  padding: 15rpx;
  border-radius: 12rpx;
  background: #f3f8f6;
}

.cost-ingredient__metrics view {
  min-width: 0;
}

.cost-ingredient__metrics text {
  display: block;
  color: #7a8580;
  font-size: 21rpx;
  line-height: 29rpx;
}

.cost-ingredient__metrics text:last-child {
  margin-top: 3rpx;
  color: #177e6c;
  font-size: 24rpx;
  font-weight: 600;
}

.cost-ingredient__reason {
  display: block;
  margin-top: 10rpx;
  color: #a16522;
  font-size: 21rpx;
  line-height: 31rpx;
}

.cost-ingredient__evidence {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 12rpx 15rpx;
  border-radius: 10rpx;
  background: #edf8f5;
  color: #168573;
  font-size: 21rpx;
  font-weight: 600;
}

.cost-empty {
  padding: 120rpx 30rpx;
  text-align: center;
  color: #8a9490;
  font-size: 27rpx;
}

.cost-bottom-space {
  height: 48rpx;
}
