page{background:#f2fbfa;color:#12213b}.page{min-height:100vh;background:linear-gradient(180deg,#f5fcff,#effaf8)}
.date-toolbar{min-height:104rpx;padding:10rpx 24rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #e5efed;background:#fff;box-sizing:border-box}.date-selector{display:flex;align-items:center;min-width:0}.date-selector-hover{opacity:.72}.date-calendar{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.date-calendar image{width:34rpx;height:34rpx}.date-copy{display:flex;flex-direction:column;min-width:0}.date-title{font-size:28rpx;line-height:34rpx;color:#26354b}.date-values{display:flex;align-items:center;margin-top:2rpx;color:#26354b;font-size:24rpx;line-height:32rpx;white-space:nowrap}.date-divider{padding:0 10rpx}
.workspace{display:flex;border-top:1rpx solid #e5efed}.category-column{width:148rpx;height:100%;background:rgba(247,251,252,.94);flex-shrink:0}.category-item{height:118rpx;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#6e7d94}.category-item image{width:41rpx;height:41rpx;margin-bottom:7rpx;opacity:.72}.category-fallback{font-size:27rpx;color:#a5b0c1;margin-bottom:6rpx}.category-name{font-size:25rpx;font-weight:700;white-space:nowrap;max-width:126rpx;overflow:hidden;text-overflow:ellipsis}.category-item.active{background:#eef3ff;color:#4869d8}.category-item.active image{opacity:1}.category-item.active .category-fallback{color:#6d86dc}.active-line{display:none;position:absolute;left:0;top:15rpx;bottom:15rpx;width:7rpx;background:#5c7cde;border-radius:0 8rpx 8rpx 0}.category-item.active .active-line{display:block}
.goods-column{flex:1;min-width:0;height:100%;display:flex;flex-direction:column}.sort-row{height:88rpx;display:flex;align-items:center;gap:8rpx;padding:0 15rpx;background:#fff;box-sizing:border-box;overflow-x:auto;white-space:nowrap}.sort-label{font-size:23rpx;color:#65768b;flex-shrink:0}.sort-button{height:52rpx;line-height:52rpx;border-radius:27rpx;padding:0 16rpx;background:#f6faf9;color:#607088;font-size:23rpx;box-shadow:0 2rpx 8rpx rgba(52,100,91,.06);flex-shrink:0}.sort-button.active{background:#10b979;color:#fff;font-weight:700}.goods-scroll{flex:1;height:calc(100% - 88rpx);padding:0 14rpx;box-sizing:border-box}.category-summary{font-size:25rpx;color:#65778d;padding:16rpx 4rpx 10rpx}.goods-card{background:#fff;border-radius:23rpx;padding:18rpx;margin-bottom:15rpx;box-shadow:0 5rpx 16rpx rgba(50,100,90,.07);border:2rpx solid transparent}.goods-card.focus-true{border-color:#20c487}.goods-header{display:flex;align-items:center;position:relative}.goods-header>image,.goods-placeholder{width:112rpx;height:88rpx;border-radius:16rpx;flex-shrink:0;margin-right:15rpx;display:flex;align-items:center;justify-content:center;background:#e8f8ef;color:#10ad74;font-size:34rpx}.goods-title-block{display:flex;flex-direction:column;min-width:0;flex:1}.goods-name{font-size:32rpx;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.goods-price{font-size:23rpx;color:#12a97a;margin-top:9rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.goods-tag{position:absolute;right:0;top:0;border-radius:22rpx;padding:8rpx 13rpx;font-size:21rpx;font-weight:650}.tag-stable,.tag-down{background:#e8faf2;color:#0ca875}.tag-up{background:#fff0f1;color:#f45e68}
.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8rpx;margin-top:17rpx}.metric{min-width:0;border-radius:15rpx;padding:10rpx 7rpx;display:flex;align-items:center}.metric image,.pie-icon{width:39rpx;height:39rpx;margin-right:6rpx;flex-shrink:0}.pie-icon{font-size:35rpx;color:#12b77a;line-height:39rpx}.metric>view:last-child{display:flex;flex-direction:column;min-width:0}.metric text:first-child{font-size:20rpx;color:#66778d;white-space:nowrap}.metric-value{font-size:25rpx!important;font-weight:800!important;color:#17263f!important;margin-top:3rpx;white-space:nowrap}.metric-value.up{color:#f05d66!important}.metric-value.down{color:#09a873!important}.metric-amount{background:#fff8e9}.metric-count{background:#eef8ff}.metric-price{background:#fff1f3}.metric-share{background:#edfbf5}.category-empty{padding:100rpx 20rpx;text-align:center;font-size:26rpx;color:#8391a3}.scroll-bottom{height:40rpx}.empty{height:600rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#65778c}.empty image{width:220rpx;height:220rpx}.empty-title{font-size:30rpx;font-weight:800}.empty-note{font-size:24rpx;margin-top:8rpx}
