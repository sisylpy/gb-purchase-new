<wxs src="/wxs/format.wxs" module="tool" />

<view class="page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="采购分类明细" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <view style="height:{{navBarHeight}}rpx"></view>

  <view class="date-toolbar">
    <view class="date-selector" bindtap="toDatePage" hover-class="date-selector-hover">
      <view class="date-calendar"><image src="/images/calender.png"></image></view>
      <view class="date-copy">
        <view class="date-title">{{hanzi}}</view>
        <view class="date-values" wx:if="{{startDate == stopDate}}"><text>{{tool.transferDateString(startDate)}}</text></view>
        <view class="date-values" wx:else><text>{{tool.transferDateString(startDate)}}</text><text class="date-divider">-</text><text>{{tool.transferDateString(stopDate)}}</text></view>
      </view>
    </view>
  </view>

  <view wx:if="{{hasData}}" class="workspace" style="height:{{contentHeight}}rpx">
    <scroll-view scroll-y class="category-column">
      <view class="category-item {{item.selected?'active':''}}" wx:for="{{categories}}" wx:key="categoryId" data-id="{{item.categoryId}}" bindtap="selectCategory">
        <view class="active-line"></view>
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"></image>
        <text wx:else class="category-fallback">●</text>
        <text class="category-name">{{item.categoryName}}</text>
      </view>
    </scroll-view>

    <view class="goods-column">
      <view class="sort-row">
        <text class="sort-label">排序方式：</text>
        <view class="sort-button {{sortKey==item.key?'active':''}}" wx:for="{{sortOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="selectSort">{{item.name}}{{sortKey==item.key?' ↓':''}}</view>
      </view>

      <scroll-view scroll-y class="goods-scroll" scroll-into-view="{{scrollIntoView}}" scroll-with-animation>
        <view class="category-summary">{{selectedCategoryName}} · {{visibleGoods.length}}种商品</view>
        <view id="goods-{{item.disGoodsId}}" class="goods-card focus-{{focusGoodsId==item.disGoodsId}}" wx:for="{{visibleGoods}}" wx:key="disGoodsId" data-item="{{item}}" bindtap="toGoodsDetail">
          <view class="goods-header">
            <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"></image>
            <view wx:else class="goods-placeholder">{{item.initial}}</view>
            <view class="goods-title-block">
              <text class="goods-name">{{item.goodsName}}</text>
              <text class="goods-price">平均单价：￥{{item.priceDisplay}} / {{item.standardName||'单位'}}</text>
            </view>
            <view class="goods-tag tag-{{item.fluctuationDirection}}">{{item.tag}}</view>
          </view>
          <view class="metric-grid">
            <view class="metric metric-amount"><image src="{{iconRoot}}money_bag.png"></image><view><text>采购金额</text><text class="metric-value">￥{{item.amountDisplay}}</text></view></view>
            <view class="metric metric-count"><image src="{{iconRoot}}menu_green.png"></image><view><text>采购次数</text><text class="metric-value">{{item.purchaseCount}}次</text></view></view>
            <view class="metric metric-price"><image src="{{iconRoot}}trend_up.png"></image><view><text>单价波动</text><text class="metric-value {{item.fluctuationDirection}}">{{item.fluctuationDirection=='up'?'+':item.fluctuationDirection=='down'?'-':''}}{{item.fluctuationDisplay}}%</text></view></view>
            <view class="metric metric-share"><view class="pie-icon">◕</view><view><text>金额占比</text><text class="metric-value">{{item.shareDisplay}}%</text></view></view>
          </view>
        </view>
        <view wx:if="{{!visibleGoods.length}}" class="category-empty">该分类本期暂无采购商品</view>
        <view class="scroll-bottom"></view>
      </scroll-view>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="empty">
    <image src="/subPackage-charts/images/purchase/keaibaicai.png" mode="aspectFit"></image>
    <text class="empty-title">本期暂无采购商品</text>
    <text class="empty-note">可切换日期后查看</text>
  </view>
</view>
