page,.page{height:100%;background:#f4f6f8;color:#11213b}.page{display:flex;flex-direction:column;overflow:hidden}
.page-scroll{height:0;min-height:0;flex:1}

.toolbar{margin:0 24rpx 15rpx;display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.date-picker,.search-box{height:76rpx;border-radius:17rpx;background:#fff;display:flex;align-items:center;box-sizing:border-box}.date-picker{padding:0 14rpx}.date-picker image{width:38rpx;height:38rpx;margin-right:10rpx;flex-shrink:0}.date-name{font-size:29rpx;font-weight:900;white-space:nowrap}.date-range{margin-left:10rpx;color:#5b708a;font-size:21rpx;white-space:nowrap}.date-arrow{margin-left:auto;color:#233a57;font-size:28rpx}.search-box{padding:0 18rpx;background:#edf4fd}.search-icon{margin-right:10rpx;color:#7f9cb9;font-size:39rpx;line-height:1}.search-box input{min-width:0;flex:1;color:#243b56;font-size:25rpx}

.analysis-banner{display:block;width:calc(100% - 48rpx);margin:0 24rpx 13rpx;border-radius:18rpx;overflow:hidden}

.filter-panel{margin:0 24rpx 15rpx;padding:17rpx 16rpx 14rpx;border-radius:20rpx;background:#fff;box-sizing:border-box;box-shadow:0 5rpx 18rpx rgba(41,75,91,.04)}.filter-step-head{min-height:42rpx;display:flex;align-items:center}.step-number{width:38rpx;height:38rpx;margin-right:10rpx;border-radius:50%;background:#42bd92;color:#fff;font-size:23rpx;font-weight:900;line-height:38rpx;text-align:center;flex-shrink:0}.step-title{color:#18304c;font-size:28rpx;font-weight:900}.step-help{margin-left:13rpx;color:#7d8da0;font-size:20rpx}.scope-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9rpx;margin-top:12rpx}.scope-option{height:78rpx;padding:8rpx 8rpx;border:1rpx solid transparent;border-radius:13rpx;background:#f2f7fd;display:flex;align-items:center;box-sizing:border-box}.scope-option.active{border-color:#308dff;background:#eaf4ff;box-shadow:0 0 0 1rpx rgba(48,141,255,.08)}.scope-option image{width:42rpx;height:42rpx;margin-right:7rpx;object-fit:contain;flex-shrink:0}.scope-option>view{min-width:0;display:flex;flex-direction:column}.scope-option>view text:first-child{color:#213750;font-size:23rpx;font-weight:900;white-space:nowrap}.scope-option>view text:last-child{margin-top:3rpx;color:#7890a7;font-size:17rpx;white-space:nowrap}.filter-divider{height:1rpx;margin:14rpx 0;background:#e6edf0}.sort-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:12rpx}.sort-option{height:82rpx;padding:9rpx 10rpx;border:1rpx solid transparent;border-radius:13rpx;background:#f2f7fd;display:flex;align-items:center;box-sizing:border-box}.sort-option.active{border-color:#308dff;background:#eaf4ff}.sort-option image{width:45rpx;height:45rpx;margin-right:9rpx;object-fit:contain;flex-shrink:0}.sort-option>view{min-width:0;display:flex;flex-direction:column}.sort-option>view text:first-child{color:#203650;font-size:23rpx;font-weight:900;white-space:nowrap}.sort-option>view text:last-child{margin-top:3rpx;color:#7890a7;font-size:17rpx;white-space:nowrap}.current-filter{margin-top:12rpx;padding-top:11rpx;border-top:1rpx solid #e7edef;display:flex;align-items:center;justify-content:center;color:#415a74;font-size:20rpx;font-weight:700}.current-filter text:first-child{margin-right:8rpx;color:#224f89;font-size:26rpx}

.body{display:flex;min-height:calc(100vh - 180rpx);margin:0 18rpx;border-radius:18rpx 18rpx 0 0;overflow:visible;background:#f2f4f7;align-items:flex-start}.cats{position:sticky;top:0;width:96rpx;height:calc(100vh - 180rpx);max-height:calc(100vh - 180rpx);border:0;border-radius:0;background:transparent;flex-shrink:0;overflow:hidden;box-sizing:border-box}.cat{position:relative;min-height:122rpx;margin:0;padding:12rpx 8rpx 10rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#68798c;box-sizing:border-box}.cat .icon{width:64rpx;height:64rpx;border:0;border-radius:12rpx;background:#fff;font-size:38rpx;line-height:64rpx;text-align:center;box-sizing:border-box}.category-image{width:64rpx;height:64rpx;border:0;border-radius:12rpx;background:#fff;box-shadow:none;box-sizing:border-box}.category-count{margin-top:8rpx;color:#607286;font-size:22rpx;font-weight:900;line-height:1;white-space:nowrap}.cat.active{background:#fff;color:#2479dc;box-shadow:none}.cat.active .category-image,.cat.active .icon{border:0;box-shadow:none}.cat.active .category-count{color:#2479dc}.cat.active:before{content:"";position:absolute;left:0;top:18rpx;bottom:18rpx;width:7rpx;border-radius:0 7rpx 7rpx 0;background:#398be8}

.goods{min-width:0;flex:1;padding:0 0 0 6rpx;box-sizing:border-box}.card{position:relative;min-height:174rpx;padding:15rpx;margin-bottom:10rpx;border:0;border-radius:16rpx;background:#fff;box-shadow:0 3rpx 10rpx rgba(31,52,73,.045);box-sizing:border-box}.card-main{display:flex;align-items:center}.goods-image{width:72rpx;height:72rpx;margin-right:14rpx;border:1rpx solid #edf0f3;border-radius:12rpx;background:#f3f5f7;flex-shrink:0}.info{min-width:0;flex:1}.line{height:43rpx;display:flex;align-items:center;gap:7rpx}.name{min-width:0;color:#142842;font-size:35rpx;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.go{color:#1a3856;font-size:37rpx;line-height:1}.badge{margin-left:auto;padding:5rpx 9rpx;border-radius:15rpx;font-size:17rpx;font-weight:800;white-space:nowrap}.danger{color:#ef3245!important}.badge.danger{background:#fff0f2}.warn{color:#e98011!important}.badge.warn{background:#fff5e8}.ok{color:#07945c!important}.badge.ok{background:#eef8f3}.price{display:block;margin-top:3rpx;color:#61758d;font-size:25rpx}.metrics{display:grid;grid-template-columns:minmax(0,1.22fr) minmax(0,1fr) minmax(0,.86fr);gap:8rpx;margin-top:13rpx}.metrics>view{min-width:0;height:70rpx;padding:7rpx 9rpx;border:1rpx solid #e9edf2;border-radius:11rpx;background:#f5f7fa;display:flex;align-items:center;box-sizing:border-box}.metrics>view>image,.dish-icon{width:30rpx;height:30rpx;margin-right:7rpx;object-fit:contain;flex-shrink:0}.dish-icon{border-radius:7rpx;background:#e5eef9;color:#407bc5;font-size:18rpx;font-weight:900;line-height:30rpx;text-align:center}.metrics>view>view{min-width:0;display:flex;flex-direction:column}.metrics>view>view text:first-child{color:#65778c;font-size:19rpx;font-weight:700;white-space:nowrap}.metrics>view>view text:last-child{margin-top:2rpx;color:#19304c;font-size:29rpx;font-weight:900;line-height:1.1;white-space:nowrap}.metrics>view:first-child>view text:first-child{font-size:20rpx;font-weight:800}.metrics>view:first-child>view text:last-child{font-size:35rpx}.metrics>view>view text.compact-number{font-size:25rpx}.metrics>view:first-child>view text.compact-number{font-size:29rpx}.empty{padding:80rpx 20rpx;color:#8796a8;text-align:center;display:flex;flex-direction:column}.empty text:first-child{font-size:28rpx;font-weight:800}.empty text:last-child{margin-top:8rpx;font-size:22rpx}.goods-bottom{height:80rpx}
