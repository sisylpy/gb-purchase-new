page,.page{height:100%;background:#f5fafc;color:#11213b}.page{display:flex;flex-direction:column;overflow:hidden}

.toolbar{margin:0 24rpx 13rpx;display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.date-picker,.search-box{height:69rpx;border-radius:17rpx;background:#fff;display:flex;align-items:center;box-sizing:border-box}.date-picker{padding:0 14rpx}.date-picker image{width:35rpx;height:35rpx;margin-right:10rpx;flex-shrink:0}.date-name{font-size:26rpx;font-weight:900;white-space:nowrap}.date-range{margin-left:10rpx;color:#5b708a;font-size:19rpx;white-space:nowrap}.date-arrow{margin-left:auto;color:#233a57;font-size:25rpx}.search-box{padding:0 18rpx;background:#edf4fd}.search-icon{margin-right:10rpx;color:#7f9cb9;font-size:36rpx;line-height:1}.search-box input{min-width:0;flex:1;color:#243b56;font-size:22rpx}

.analysis-banner{display:block;width:calc(100% - 48rpx);margin:0 24rpx 13rpx;border-radius:18rpx;overflow:hidden}

.filter-panel{margin:0 24rpx 13rpx;padding:14rpx 15rpx 12rpx;border-radius:20rpx;background:#fff;box-sizing:border-box;box-shadow:0 5rpx 18rpx rgba(41,75,91,.04)}.filter-step-head{min-height:38rpx;display:flex;align-items:center}.step-number{width:34rpx;height:34rpx;margin-right:10rpx;border-radius:50%;background:#42bd92;color:#fff;font-size:21rpx;font-weight:900;line-height:34rpx;text-align:center;flex-shrink:0}.step-title{color:#18304c;font-size:25rpx;font-weight:900}.step-help{margin-left:13rpx;color:#7d8da0;font-size:18rpx}.scope-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9rpx;margin-top:10rpx}.scope-option{height:68rpx;padding:7rpx 8rpx;border:1rpx solid transparent;border-radius:13rpx;background:#f2f7fd;display:flex;align-items:center;box-sizing:border-box}.scope-option.active{border-color:#308dff;background:#eaf4ff;box-shadow:0 0 0 1rpx rgba(48,141,255,.08)}.scope-option image{width:39rpx;height:39rpx;margin-right:7rpx;object-fit:contain;flex-shrink:0}.scope-option>view{min-width:0;display:flex;flex-direction:column}.scope-option>view text:first-child{color:#213750;font-size:20rpx;font-weight:900;white-space:nowrap}.scope-option>view text:last-child{margin-top:2rpx;color:#7890a7;font-size:14rpx;white-space:nowrap}.filter-divider{height:1rpx;margin:12rpx 0;background:#e6edf0}.sort-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:10rpx}.sort-option{height:72rpx;padding:8rpx 10rpx;border:1rpx solid transparent;border-radius:13rpx;background:#f2f7fd;display:flex;align-items:center;box-sizing:border-box}.sort-option.active{border-color:#308dff;background:#eaf4ff}.sort-option image{width:42rpx;height:42rpx;margin-right:9rpx;object-fit:contain;flex-shrink:0}.sort-option>view{min-width:0;display:flex;flex-direction:column}.sort-option>view text:first-child{color:#203650;font-size:20rpx;font-weight:900;white-space:nowrap}.sort-option>view text:last-child{margin-top:2rpx;color:#7890a7;font-size:14rpx;white-space:nowrap}.current-filter{margin-top:10rpx;padding-top:9rpx;border-top:1rpx solid #e7edef;display:flex;align-items:center;justify-content:center;color:#415a74;font-size:17rpx;font-weight:700}.current-filter text:first-child{margin-right:8rpx;color:#224f89;font-size:23rpx}

.body{display:flex;flex:1;min-height:0;margin:0 24rpx;border-radius:20rpx 20rpx 0 0;overflow:hidden;background:#f6fafb}.cats{width:137rpx;height:100%;background:linear-gradient(180deg,#e9faf3,#eef6fb);flex-shrink:0}.cat{position:relative;min-height:112rpx;padding:10rpx 5rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#73859a;box-sizing:border-box}.cat .icon{font-size:35rpx;line-height:1}.category-name{margin-top:5rpx;font-size:21rpx;font-weight:800;text-align:center}.category-count{margin-top:2rpx;font-size:17rpx}.cat.active{background:#fff;color:#078e5d}.cat.active:before{content:"";position:absolute;left:0;top:0;width:7rpx;height:100%;border-radius:0 5rpx 5rpx 0;background:#21be82}

.goods{height:100%;flex:1;padding:0 0 0 11rpx;box-sizing:border-box}.card{position:relative;display:flex;min-height:150rpx;padding:13rpx 12rpx;margin-bottom:11rpx;border:1rpx solid #e5ecef;border-radius:18rpx;background:#fff;box-shadow:0 5rpx 15rpx rgba(34,62,82,.045);box-sizing:border-box}.goods-image{width:91rpx;height:91rpx;margin-right:12rpx;border-radius:13rpx;background:#eff7f2;flex-shrink:0}.info{min-width:0;flex:1}.line{height:36rpx;display:flex;align-items:center;gap:7rpx}.name{min-width:0;color:#142842;font-size:27rpx;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.go{color:#1a3856;font-size:31rpx;line-height:1}.badge{margin-left:auto;padding:4rpx 9rpx;border-radius:15rpx;font-size:15rpx;font-weight:800;white-space:nowrap}.danger{color:#ef3245!important}.badge.danger{background:#fff0f2}.warn{color:#e98011!important}.badge.warn{background:#fff5e8}.ok{color:#07945c!important}.badge.ok{background:#eafaf1}.price{display:block;margin-top:1rpx;color:#61758d;font-size:20rpx}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:6rpx;margin-top:9rpx}.metrics>view{min-width:0;height:55rpx;padding:6rpx;border-radius:9rpx;background:#f0f6fd;display:flex;align-items:center;box-sizing:border-box}.metrics>view>image,.dish-icon{width:28rpx;height:28rpx;margin-right:5rpx;object-fit:contain;flex-shrink:0}.dish-icon{border-radius:7rpx;background:#dceaff;color:#407bc5;font-size:16rpx;font-weight:900;line-height:28rpx;text-align:center}.metrics>view>view{min-width:0;display:flex;flex-direction:column}.metrics>view>view text:first-child{color:#74869b;font-size:14rpx;white-space:nowrap}.metrics>view>view text:last-child{margin-top:1rpx;color:#19304c;font-size:20rpx;font-weight:900;white-space:nowrap}.empty{padding:80rpx 20rpx;color:#8796a8;text-align:center;display:flex;flex-direction:column}.empty text:first-child{font-size:24rpx;font-weight:800}.empty text:last-child{margin-top:7rpx;font-size:19rpx}.goods-bottom{height:26rpx}
