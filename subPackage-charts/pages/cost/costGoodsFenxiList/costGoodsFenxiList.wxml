<view class="page"><back-navbar title="配料分析" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar><view style="height:{{navBarHeight}}rpx"></view><view class="datebar" bindtap="toDatePage"><image src="/images/calender.png"></image><text class="bold">{{hanzi}}</text><text>{{dateText}}</text><text>⌄</text><input value="{{search}}" placeholder="搜索" catchtap="noop" bindconfirm="searchInput"/></view>
<view class="filters"><text class="{{status=='all'?'active':''}}" data-value="all" bindtap="chooseStatus">全部</text><text class="{{status=='verified'?'active':''}}" data-value="verified" bindtap="chooseStatus">已核销</text><text class="{{status=='unverified'?'active':''}}" data-value="unverified" bindtap="chooseStatus">未核销</text><text class="{{status=='employeeMeal'?'active':''}}" data-value="employeeMeal" bindtap="chooseStatus">员工餐</text></view>
<view class="sorts"><text>↕ 排序:{{sortOrder=='desc'?'降序':'升序'}}</text><text class="{{sortBy=='outbound'?'active':''}}" data-value="outbound" bindtap="chooseSort">出库金额</text><text class="{{sortBy=='deviance'?'active':''}}" data-value="deviance" bindtap="chooseSort">出库分摊偏差率</text><text class="{{sortBy=='devianceAmount'?'active':''}}" data-value="devianceAmount" bindtap="chooseSort">偏差金额</text></view>
<view class="body"><scroll-view scroll-y class="cats"><view class="cat {{categoryId==item.id?'active':''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseCategory"><text class="icon">{{item.icon}}</text><text>{{item.name}}</text><text class="small">({{item.count}})</text></view></scroll-view><scroll-view scroll-y class="goods"><view class="category-summary"><view><text class="title">{{categoryName}}</text><text>按商品档案分类统计</text></view><view><text>商品数</text><text class="strong">{{rows.length}}</text></view><view><text>出库金额</text><text class="strong">¥{{summary.totalOutboundAmount||0}}</text></view></view><view class="card" wx:for="{{rows}}" wx:key="disGoodsId" data-index="{{index}}" bindtap="toDetail"><image src="{{item.imageUrl}}" mode="aspectFill"></image><view class="info"><view class="line"><text class="name">{{item.name}}</text><text class="badge {{item.tone}}">{{item.statusText}}</text><text class="go">›</text></view><text class="price">¥{{item.unitPrice||0}} / {{item.gbDgGoodsStandardname||'斤'}}</text><view class="metrics"><view><text class="small">出库金额</text><text class="strong">¥{{item.amountText}}</text></view><view><text class="small">偏差率</text><text class="strong {{item.tone}}">{{item.rateText}}</text></view><view><text class="small">关联菜品</text><text class="strong">{{item.dishCount}}道</text></view></view><text class="dishes">关联菜品：{{item.dishNames||'暂无关联菜品'}}</text></view></view><view class="empty" wx:if="{{!rows.length}}">当前分类暂无原料</view></scroll-view></view></view>
