<view class="page">
  <back-navbar title="配料分析" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <view style="height:{{navBarHeight}}rpx"></view>

  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="page-scroll">
  <view class="toolbar">
    <view class="date-picker" bindtap="toDatePage">
      <image src="/images/calender.png"></image>
      <text class="date-name">{{hanzi}}</text>
      <text class="date-range">{{dateText}}</text>
      <text class="date-arrow">⌄</text>
    </view>
    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input value="{{search}}" placeholder="搜索商品名称" confirm-type="search" bindconfirm="searchInput"/>
    </view>
  </view>

  <image class="analysis-banner" src="/images/ingredient-analysis/banner.png" mode="widthFix"></image>

  <view class="filter-panel">
    <view class="filter-step-head">
      <text class="step-number">1</text>
      <text class="step-title">先选查看范围</text>
      <text class="step-help">选择要分析的出库范围</text>
    </view>
    <view class="scope-grid">
      <view class="scope-option {{status=='all'?'active':''}}" data-value="all" bindtap="chooseStatus">
        <image src="/images/ingredient-analysis/scope_all.png"></image>
        <view><text>全部</text><text>查看全部出库</text></view>
      </view>
      <view class="scope-option {{status=='verified'?'active':''}}" data-value="verified" bindtap="chooseStatus">
        <image src="/images/ingredient-analysis/scope_written_off.png"></image>
        <view><text>已核销</text><text>已审核的出库</text></view>
      </view>
      <view class="scope-option {{status=='unverified'?'active':''}}" data-value="unverified" bindtap="chooseStatus">
        <image src="/images/ingredient-analysis/scope_pending_write_off.png"></image>
        <view><text>未核销</text><text>待审核的出库</text></view>
      </view>
      <view class="scope-option {{status=='employeeMeal'?'active':''}}" data-value="employeeMeal" bindtap="chooseStatus">
        <image src="/images/ingredient-analysis/scope_staff_meal.png"></image>
        <view><text>员工餐</text><text>员工使用的出库</text></view>
      </view>
    </view>

    <view class="filter-divider"></view>

    <view class="filter-step-head">
      <text class="step-number">2</text>
      <text class="step-title">再选统计指标</text>
      <text class="step-help">选择要查看的数据指标</text>
    </view>
    <view class="sort-grid">
      <view class="sort-option {{sortBy=='outbound'?'active':''}}" data-value="outbound" bindtap="chooseSort">
        <image src="/images/ingredient-analysis/outbound_amount.png"></image>
        <view><text>出库金额</text><text>查看出库总金额</text></view>
      </view>
      <view class="sort-option {{sortBy=='deviance'?'active':''}}" data-value="deviance" bindtap="chooseSort">
        <image src="/images/ingredient-analysis/allocation_deviation_rate.png"></image>
        <view><text>分摊偏差率</text><text>查看成本偏差情况</text></view>
      </view>
      <view class="sort-option {{sortBy=='devianceAmount'?'active':''}}" data-value="devianceAmount" bindtap="chooseSort">
        <image src="/images/ingredient-analysis/deviation_amount.png"></image>
        <view><text>偏差金额</text><text>查看偏差金额</text></view>
      </view>
    </view>
    <view class="current-filter">
      <text>▥</text>
      <text>当前：{{statusLabel}} · 按{{sortLabel}}{{sortOrder=='desc'?'从高到低':'从低到高'}}查看</text>
    </view>
  </view>

  <view class="body">
    <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="cats">
      <view class="cat {{categoryId==item.id?'active':''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" aria-label="{{item.name}}" bindtap="chooseCategory">
        <image wx:if="{{item.imageUrl}}" class="category-image" src="{{item.imageUrl}}" mode="aspectFill"></image>
        <text wx:else class="icon">{{item.icon}}</text>
        <text class="category-count">{{item.count}}个</text>
      </view>
    </scroll-view>

    <view class="goods">
      <view class="card" wx:for="{{rows}}" wx:key="disGoodsId" data-index="{{index}}" bindtap="toDetail">
        <view class="card-main">
          <image class="goods-image" src="{{item.imageUrl}}" mode="aspectFill"></image>
          <view class="info">
            <view class="line">
              <text class="name">{{item.name}}</text>
              <text class="go">›</text>
              <text wx:if="{{item.tone!='ok'}}" class="badge {{item.tone}}">{{item.statusText}}</text>
            </view>
            <text class="price">¥{{item.unitPrice||0}} / {{item.gbDgGoodsStandardname||'斤'}}</text>
          </view>
        </view>
        <view class="metrics">
          <view>
            <image src="/images/ingredient-analysis/outbound_amount.png"></image>
            <view><text>出库金额</text><text class="{{item.amountCompact?'compact-number':''}}">¥{{item.amountText}}</text></view>
          </view>
          <view>
            <image src="/images/ingredient-analysis/allocation_deviation_rate.png"></image>
            <view><text>偏差率</text><text class="{{item.tone}} {{item.rateCompact?'compact-number':''}}">{{item.rateText}}</text></view>
          </view>
          <view>
            <text class="dish-icon">菜</text>
            <view><text>关联菜品</text><text>{{item.dishCount}}道</text></view>
          </view>
        </view>
      </view>
      <view class="empty" wx:if="{{!rows.length}}">
        <text>{{categories.length ? '当前分类暂无原料' : '当前筛选没有原料'}}</text>
        <text>{{categories.length ? '可以切换左侧分类查看' : '请调整出库范围或搜索条件'}}</text>
      </view>
      <view class="goods-bottom"></view>
    </view>
  </view>
  </scroll-view>
</view>
