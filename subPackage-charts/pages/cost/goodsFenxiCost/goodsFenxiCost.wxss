page,.page{height:100%;background:#f3f8f7;color:#10213b}
.page{display:flex;flex-direction:column}
.scroll{flex:1;min-height:0}
.datebar{flex-shrink:0;height:88rpx;margin:0 22rpx 18rpx;padding:0 22rpx;background:#fff;border:1rpx solid #dbe8e5;border-radius:18rpx;display:flex;align-items:center;gap:15rpx;box-sizing:border-box}
.datebar image{width:39rpx;height:39rpx}
.date-name{font-size:32rpx;font-weight:900}
.date-range{font-size:26rpx;color:#53677f}
.date-arrow{margin-left:auto;font-size:43rpx;color:#51667c}
.hero-card,.section-card{margin:0 22rpx 18rpx;border-radius:26rpx;background:#fff;box-sizing:border-box;box-shadow:0 8rpx 24rpx rgba(37,77,70,.055)}
.hero-card{padding:24rpx;background:linear-gradient(145deg,#f1fff8 0%,#e7f9f2 58%,#f8fffb 100%);border:1rpx solid #d8f0e6}
.hero-top{display:flex;align-items:center;gap:20rpx}
.ingredient-photo{width:122rpx;height:112rpx;border-radius:22rpx;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0;color:#13a06b;font-size:46rpx;font-weight:900}
.ingredient-photo image{width:100%;height:100%}
.ingredient-main{flex:1;min-width:0}
.ingredient-name{display:block;font-size:42rpx;font-weight:900;line-height:1.25}
.ingredient-sub{display:block;margin-top:11rpx;color:#607589;font-size:24rpx;line-height:1.45}
.hero-metrics{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:22rpx}
.hero-metric{padding:20rpx;border-radius:20rpx;background:rgba(255,255,255,.9);border:1rpx solid rgba(205,228,220,.9)}
.metric-label,.metric-value,.metric-help{display:block}
.metric-label{font-size:25rpx;color:#5b6f83}
.metric-value{margin-top:10rpx;font-size:33rpx;font-weight:900}
.metric-help{margin-top:7rpx;font-size:23rpx;color:#74869a}
.purchase-tone .metric-value{color:#168d63}
.outbound-tone .metric-value{color:#246fd2}
.stock-tone .metric-value{color:#0b9c75}
.average-tone .metric-value{color:#e3771b}
.price-explanation{margin-top:18rpx;padding:18rpx 20rpx;border-radius:18rpx;background:#fff8e8;color:#665426;font-size:24rpx;line-height:1.55}
.price-explanation text{display:block}
.price-explanation-title{margin-bottom:5rpx;color:#ad6b00;font-size:25rpx;font-weight:900}
.conclusion-strip{margin-top:14rpx;padding:18rpx 20rpx;border-radius:18rpx;background:#dbf7e9;display:flex;align-items:flex-start;gap:12rpx;color:#257054;font-size:25rpx;line-height:1.55}
.bulb{font-size:30rpx}
.section-card{padding:24rpx}
.section-head{display:flex;align-items:center;justify-content:space-between;gap:14rpx}
.section-head>view{display:flex;align-items:center;min-width:0}
.step{width:39rpx;height:39rpx;margin-right:13rpx;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:24rpx;font-weight:900;flex-shrink:0}
.step-green{background:#2fbf88}
.step-blue{background:#4a8df5}
.step-orange{background:#f0a343}
.step-purple{background:#8272d8}
.section-title{font-size:34rpx;font-weight:900}
.section-note{font-size:23rpx;color:#73859b;white-space:nowrap}
.purchase-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:22rpx}
.purchase-summary>view{padding:17rpx 12rpx;border-radius:17rpx;background:#f4f8fb;text-align:center}
.purchase-summary text{display:block;font-size:23rpx;color:#718297}
.purchase-summary .big{margin-top:9rpx;font-size:29rpx;color:#12243e;font-weight:900}
.source-scope-note{margin-top:16rpx;padding:13rpx 16rpx;border-radius:14rpx;background:#eef7f4;color:#4f7468;font-size:24rpx;line-height:1.4}
.source-list{margin-top:10rpx}
.source-row{padding:24rpx 0;border-top:1rpx solid #e7efec}
.source-heading{display:flex;align-items:center;gap:16rpx}
.source-icon{width:70rpx;height:70rpx;border-radius:18rpx;background:#e5f1ff;color:#2d77d8;display:flex;align-items:center;justify-content:center;font-size:30rpx;font-weight:900;flex-shrink:0}
.source-icon.self-icon{background:#fff1de;color:#dd7710}
.source-main{flex:1;min-width:0}
.source-name-row{display:flex;align-items:center;gap:11rpx}
.source-name{font-size:36rpx;font-weight:900;max-width:300rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.source-tag{padding:6rpx 12rpx;border-radius:12rpx;background:#eef5f3;color:#557169;font-size:23rpx}
.source-purchase-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:18rpx}
.source-purchase-metric{padding:15rpx 8rpx;border-radius:15rpx;background:#f3f7fb;text-align:center}
.source-purchase-metric text{display:block;color:#64788e;font-size:23rpx}
.source-purchase-metric text:last-child{margin-top:7rpx;color:#132842;font-size:31rpx;font-weight:900;white-space:nowrap}
.source-share{width:116rpx;text-align:right;flex-shrink:0}
.source-share text{display:block}
.source-share text:first-child{font-size:33rpx;color:#118e61;font-weight:900}
.source-share text:last-child{font-size:23rpx;color:#7c8b9d;margin-top:5rpx}
.source-loss-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:18rpx}
.source-loss-item{padding:15rpx 16rpx;border-radius:15rpx;display:flex;align-items:center;justify-content:space-between;gap:10rpx}
.source-loss-item text:first-child{font-size:25rpx;font-weight:900}
.source-loss-item text:last-child{font-size:25rpx;font-weight:800;white-space:nowrap}
.source-loss-item.loss-tone{background:#fff5e7;color:#b96a11}
.source-loss-item.waste-tone{background:#fff0f1;color:#c74752}
.source-progress{height:14rpx;margin-top:15rpx;background:#e7eeec;border-radius:9rpx;overflow:hidden}
.source-progress view{height:100%;background:linear-gradient(90deg,#27bd84,#43cf99);border-radius:9rpx}
.empty-box{padding:38rpx 20rpx;text-align:center;color:#8493a4;font-size:26rpx;background:#f6f9f8;border-radius:18rpx;margin-top:20rpx}
.inventory-card{background:linear-gradient(135deg,#ffffff,#f1f8ff)}
.live-tag{padding:8rpx 14rpx;border-radius:15rpx;background:#e3f5ed;color:#159267;font-size:23rpx;font-weight:800}
.inventory-body{display:grid;grid-template-columns:1fr 1fr;gap:15rpx;margin-top:22rpx}
.inventory-number{padding:23rpx;border-radius:20rpx;background:#fff;border:1rpx solid #dae8ef}
.inventory-label,.inventory-value{display:block}
.inventory-label{font-size:25rpx;color:#687b90}
.inventory-value{margin-top:12rpx;font-size:42rpx;font-weight:900;color:#0e9670}
.inventory-value text{font-size:27rpx}
.inventory-value.amount{color:#df741a}
.plain-note{margin-top:17rpx;padding:16rpx 18rpx;border-radius:16rpx;background:#edf5f8;color:#586e83;font-size:24rpx;line-height:1.5}
.usage-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:22rpx}
.usage-item{padding:20rpx;border-radius:20rpx;background:#f6f9f8;border:1rpx solid #e3ece9}
.usage-item:last-child{grid-column:1/3}
.usage-title-row{display:flex;align-items:center;gap:10rpx}
.usage-dot{width:16rpx;height:16rpx;border-radius:50%}
.usage-name{font-size:27rpx;font-weight:900}
.usage-amount{display:block;margin-top:12rpx;font-size:36rpx;font-weight:900}
.usage-qty{display:block;margin-top:7rpx;font-size:24rpx;color:#556a80}
.usage-hint{display:block;margin-top:9rpx;font-size:22rpx;color:#8290a0}
.usage-normal .usage-amount{color:#128f61}
.usage-discount .usage-amount{color:#3276d5}
.usage-employee .usage-amount{color:#df7e16}
.usage-pending .usage-amount{color:#e63f4c}
.usage-waste .usage-amount{color:#7461bd}
.usage-bar{display:flex;height:22rpx;border-radius:13rpx;overflow:hidden;margin-top:23rpx;background:#edf1f0}
.usage-bar view{height:100%}
.pending-help{margin-top:17rpx;padding:17rpx 19rpx;border-radius:17rpx;background:#fff6e4;color:#755b27;font-size:24rpx;line-height:1.5}
.pending-help text{font-weight:900;color:#b87200}
.dish-card{margin-top:20rpx;padding:20rpx;border-radius:22rpx;border:1rpx solid #dce8e4;background:#fff;box-shadow:0 4rpx 14rpx rgba(35,77,68,.04)}
.dish-top{display:flex;gap:18rpx;align-items:center}
.dish-photo{width:102rpx;height:92rpx;border-radius:18rpx;background:#e9f8ef;overflow:hidden;display:flex;align-items:center;justify-content:center;color:#17a36d;font-size:38rpx;font-weight:900;flex-shrink:0}
.dish-photo image{width:100%;height:100%}
.dish-main{flex:1;min-width:0}
.dish-name-row{display:flex;align-items:center}
.dish-name{font-size:32rpx;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dish-arrow{margin-left:auto;font-size:42rpx;color:#6b7d91}
.dish-total{display:block;margin-top:7rpx;font-size:24rpx;color:#64768a}
.dish-total text{color:#146fbc;font-weight:900}
.dish-relation{display:block;margin-top:8rpx;font-size:23rpx;color:#66798d}
.dish-metrics{display:grid;grid-template-columns:1fr 1fr;gap:10rpx;margin-top:18rpx}
.dish-metrics view{padding:14rpx 15rpx;border-radius:15rpx;background:#f3f7f8}
.dish-metrics text{display:block;font-size:22rpx;color:#708196}
.dish-metrics text:last-child{margin-top:7rpx;font-size:28rpx;color:#152943;font-weight:900}
.danger{color:#ef3a48!important}
.ok{color:#0b9865!important}
.dish-tip{margin-top:13rpx;padding:13rpx 15rpx;border-radius:13rpx;font-size:23rpx;line-height:1.4}
.danger-tip{background:#fff0ef;color:#bd3740}
.ok-tip{background:#eaf8f1;color:#247455}
.trend-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:22rpx}
.trend-summary view{padding:17rpx 10rpx;border-radius:16rpx;background:#f3f8f6;text-align:center}
.trend-summary text{display:block;font-size:22rpx;color:#75869a}
.trend-summary text:last-child{margin-top:8rpx;font-size:29rpx;color:#142640;font-weight:900}
.chart-wrap{height:300rpx;margin-top:18rpx}
.trend-chart{width:100%;height:100%}
.bottom-slogan{margin:0 22rpx;padding:24rpx;border-radius:22rpx;background:#dff7eb;text-align:center;color:#1b7959;font-size:25rpx;font-weight:800;line-height:1.5}
.bottom-space{height:40rpx}

