page,.page{height:100%;background:#f4faf8;color:#101c32}.page{display:flex;flex-direction:column}.scroll{flex:1}.datebar{margin:0 24rpx 18rpx;height:94rpx;padding:0 24rpx;background:#fff;border-radius:22rpx;display:flex;align-items:center;gap:18rpx;font-size:26rpx}.datebar image{width:40rpx;height:40rpx}.datebar .bold{font-size:32rpx;font-weight:800}.search{margin-left:auto;font-size:48rpx}.hero,.panel{margin:0 24rpx 18rpx;background:#fff;border-radius:28rpx;padding:22rpx;box-sizing:border-box;box-shadow:0 7rpx 24rpx rgba(28,65,72,.05)}.hero{background:linear-gradient(115deg,#effff5,#e0fae9)}.top{display:flex;align-items:center;gap:22rpx}.top>image{width:150rpx;height:122rpx;border-radius:22rpx;background:#fff}.top .name{display:block;font-size:44rpx;font-weight:900}.desc{display:block;font-size:24rpx;color:#66768c;margin-top:12rpx}.price{margin-left:auto;background:rgba(255,255,255,.75);padding:20rpx;border-radius:20rpx}.price .small{display:block;font-size:23rpx;color:#6a788a}.price .strong{display:block;color:#e81d2f;font-size:39rpx;margin-top:10rpx}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin-top:22rpx}.kpis view{background:rgba(255,255,255,.8);border:1rpx solid #dcece4;border-radius:20rpx;padding:18rpx}.kpis text{display:block;font-size:21rpx;color:#5d6d83}.kpis .strong{font-size:35rpx;margin:15rpx 0 8rpx;color:#111}.kpis .red .strong{color:#ef2c3b}.kpis .orange .strong{color:#ec8611}.head{display:flex;align-items:center;justify-content:space-between;font-size:34rpx;font-weight:900}.head>view{display:flex;background:#f3f5f8;border-radius:30rpx;padding:4rpx}.head>view text{font-size:22rpx;font-weight:500;padding:12rpx 22rpx}.head .active{background:#fff;border:1rpx solid #67a6ff;color:#176bd8;border-radius:25rpx}.small{font-size:21rpx!important;font-weight:400!important;color:#738197}.bar{display:flex;height:28rpx;border-radius:16rpx;overflow:hidden;margin:30rpx 0 22rpx;background:#edf1f4}.bar text:nth-child(1){background:#3688f7}.bar text:nth-child(2){background:#fb4e4e}.bar text:nth-child(3){background:#ff961c}.legend{display:flex;justify-content:space-between;font-size:22rpx}.legend view{display:flex;align-items:center;gap:10rpx}.legend .dot{width:18rpx;height:18rpx;border-radius:50%}.legend .blue{background:#3688f7}.legend .red{background:#fb4e4e}.legend .orange{background:#ff961c}.table-head,.dish{display:grid;grid-template-columns:1.5fr repeat(5,1fr);align-items:center;gap:8rpx;text-align:center}.table-head{margin-top:22rpx;background:#f3f7fb;border-radius:16rpx;padding:18rpx 10rpx;font-size:20rpx;color:#66758b}.dish{min-height:92rpx;border-bottom:1rpx solid #e8edf2;font-size:22rpx}.dishname{text-align:left;font-size:26rpx;font-weight:800}.danger{color:#ee263b!important}.ok{color:#07985a!important}.empty{text-align:center;color:#8793a5;padding:44rpx}.costbody{display:flex;margin-top:24rpx}.stats{width:45%;display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.stats view{background:#f4f8fc;border-radius:18rpx;padding:18rpx}.stats view:last-child{grid-column:span 2}.stats text{display:block}.stats .strong{font-size:29rpx;font-weight:800;margin-top:12rpx}.chart{flex:1;height:300rpx;margin-left:18rpx;font-size:22rpx;color:#607089}.chart ec-canvas{display:block;width:100%;height:270rpx}.slogan{margin:0 24rpx;padding:30rpx;text-align:center;background:linear-gradient(90deg,#eafff3,#d9fbea);border-radius:24rpx;color:#078f58;font-size:26rpx;font-weight:800}.space{height:34rpx}
