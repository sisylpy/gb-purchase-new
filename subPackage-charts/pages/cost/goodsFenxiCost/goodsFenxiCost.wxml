<view class="page">
  <back-navbar title="{{row.name}}经营分析" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <view style="height:{{navBarHeight}}rpx;flex-shrink:0"></view>
  <view class="datebar" bindtap="toDatePage">
    <image src="/images/calender.png"></image>
    <text class="date-name">{{hanzi}}</text>
    <text class="date-range">{{dateText}}</text>
    <text class="date-arrow">›</text>
  </view>

  <scroll-view scroll-y class="scroll" enhanced show-scrollbar="{{false}}">
    <view class="hero-card">
      <view class="hero-top">
        <view class="ingredient-photo">
          <image wx:if="{{row.imageUrl}}" src="{{row.imageUrl}}" mode="aspectFill"></image>
          <text wx:else>{{row.initial}}</text>
        </view>
        <view class="ingredient-main">
          <text class="ingredient-name">{{row.name}}</text>
          <text class="ingredient-sub">关联菜品：{{row.relatedDishNamesText || '暂无关联菜品'}}</text>
        </view>
      </view>
      <view class="hero-metrics">
        <view class="hero-metric purchase-tone">
          <text class="metric-label">本期采购</text>
          <text class="metric-value">{{purchase.totalQuantityText || 0}} {{row.unit}}</text>
          <text class="metric-help">共 {{purchase.batchCount || 0}} 批</text>
        </view>
        <view class="hero-metric outbound-tone">
          <text class="metric-label">本期出库</text>
          <text class="metric-value">{{row.totalQtyText || 0}} {{row.unit}}</text>
          <text class="metric-help">成本 ¥{{row.totalText || 0}}</text>
        </view>
        <view class="hero-metric stock-tone">
          <text class="metric-label">当前库存</text>
          <text class="metric-value">{{purchase.currentStockText || '--'}} {{purchase.hasCurrentStock ? row.unit : ''}}</text>
          <text class="metric-help">现值 ¥{{purchase.currentStockAmountText || '--'}}</text>
        </view>
        <view class="hero-metric average-tone">
          <text class="metric-label">本期加权均价</text>
          <text class="metric-value">¥{{purchase.averagePriceText || 0}}</text>
          <text class="metric-help">{{dateText}}</text>
        </view>
      </view>
      <view class="price-explanation">
        <text class="price-explanation-title">加权均价统计：{{dateText}}</text>
        <text>采购总金额 ¥{{purchase.totalAmountText || 0}} ÷ 到货 {{purchase.totalQuantityText || 0}}{{row.unit}} = ¥{{purchase.averagePriceText || 0}}/{{row.unit}}，代表本期实际每{{row.unit}}采购成本。</text>
      </view>
      <view class="conclusion-strip"><text class="bulb">💡</text><text>{{row.conclusion}}</text></view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view><text class="step step-green">1</text><text class="section-title">这些货从哪里买的</text></view>
        <text class="section-note">本期共花 ¥{{purchase.totalAmountText || 0}}</text>
      </view>
      <view class="purchase-summary">
        <view><text>采购批次</text><text class="big">{{purchase.batchCount || 0}} 批</text></view>
        <view><text>采购数量</text><text class="big">{{purchase.totalQuantityText || 0}} {{row.unit}}</text></view>
        <view><text>加权平均价</text><text class="big">¥{{purchase.averagePriceText || 0}}/{{row.unit}}</text></view>
      </view>
      <view class="source-scope-note">损耗和废弃按本期采购批次累计统计</view>
      <view class="source-list" wx:if="{{purchaseSources.length}}">
        <view class="source-row" wx:for="{{purchaseSources}}" wx:key="indexNo">
          <view class="source-heading">
            <view class="source-icon {{item.sourceType === 'SELF' ? 'self-icon' : ''}}">{{item.iconText}}</view>
            <view class="source-main">
              <view class="source-name-row"><text class="source-name">{{item.displayName}}</text><text class="source-tag">{{item.typeText}}</text></view>
            </view>
            <view class="source-share"><text>{{item.shareText}}%</text><text>采购占比</text></view>
          </view>
          <view class="source-purchase-metrics">
            <view class="source-purchase-metric"><text>采购批次</text><text>{{item.batchCount}} 批</text></view>
            <view class="source-purchase-metric"><text>采购数量</text><text>{{item.quantityText}} {{row.unit}}</text></view>
            <view class="source-purchase-metric"><text>加权均价</text><text>¥{{item.priceText}}/{{row.unit}}</text></view>
          </view>
          <view class="source-loss-grid">
            <view class="source-loss-item loss-tone"><text>损耗</text><text>{{item.lossQuantityText}} {{row.unit}} · ¥{{item.lossAmountText}}</text></view>
            <view class="source-loss-item waste-tone"><text>废弃</text><text>{{item.wasteQuantityText}} {{row.unit}} · ¥{{item.wasteAmountText}}</text></view>
          </view>
          <view class="source-progress"><view style="width:{{item.barWidth}}%"></view></view>
        </view>
      </view>
      <view class="empty-box" wx:else>本期没有采购记录</view>
    </view>

    <view class="section-card inventory-card">
      <view class="section-head">
        <view><text class="step step-blue">2</text><text class="section-title">现在还剩多少</text></view>
        <text class="live-tag">实时库存</text>
      </view>
      <view class="inventory-body">
        <view class="inventory-number"><text class="inventory-label">当前库存</text><text class="inventory-value">{{purchase.currentStockText || '--'}} <text>{{purchase.hasCurrentStock ? row.unit : ''}}</text></text></view>
        <view class="inventory-number"><text class="inventory-label">库存货值</text><text class="inventory-value amount">¥{{purchase.currentStockAmountText || '--'}}</text></view>
      </view>
      <view class="plain-note">库存是现在实时剩下的数量；采购和出库按上方所选日期统计，两者时间口径不同。</view>
    </view>

    <view class="section-card usage-card">
      <view class="section-head">
        <view><text class="step step-orange">3</text><text class="section-title">这些{{row.name}}用到哪里</text></view>
        <text class="section-note">按成本金额</text>
      </view>
      <view class="usage-grid">
        <view class="usage-item usage-{{item.key}}" wx:for="{{row.destinations}}" wx:key="key">
          <view class="usage-title-row"><text class="usage-dot" style="background:{{item.color}}"></text><text class="usage-name">{{item.name}}</text></view>
          <text class="usage-amount">¥{{item.amountText}}</text>
          <text class="usage-qty">{{item.qtyText}} {{row.unit}} · {{item.percent}}%</text>
          <text class="usage-hint">{{item.hint}}</text>
        </view>
      </view>
      <view class="usage-bar"><view wx:for="{{row.destinations}}" wx:key="key" style="width:{{item.barWidth}}%;background:{{item.color}}"></view></view>
      <view class="pending-help"><text>“待确认用途”</text>就是货已经出库，但还没找到对应的菜品或经营记录，需要核对。</view>
    </view>

    <view class="section-card dishes-card">
      <view class="section-head">
        <view><text class="step step-purple">4</text><text class="section-title">哪些菜用了{{row.name}}</text></view>
        <text class="section-note">共 {{dishes.length}} 道</text>
      </view>
      <view class="dish-card" wx:for="{{dishes}}" wx:key="dishId" data-index="{{index}}" bindtap="toDish">
        <view class="dish-top">
          <view class="dish-photo"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image><text wx:else>{{item.initial}}</text></view>
          <view class="dish-main">
            <view class="dish-name-row"><text class="dish-name">{{item.dishName}}</text><text class="dish-arrow">›</text></view>
            <text class="dish-total">本期一共做了 <text>{{item.totalText}} 份</text></text>
            <view class="dish-sale-chips">
              <text>正常销售 {{item.normalText}}份</text>
              <text>折扣餐 {{item.discountText}}份</text>
              <text>员工餐 {{item.employeeText}}份</text>
            </view>
          </view>
        </view>

        <view class="dish-business-block ingredient-usage-block">
          <view class="dish-block-title"><text>① {{row.name}}在这道菜里用了多少</text></view>
          <view class="dish-metrics">
            <view><text>每份配方用量</text><text>{{item.unitText}} {{row.unit}}</text></view>
            <view><text>本期应该用</text><text>{{item.theoryText}} {{row.unit}}</text></view>
            <view><text>实际分摊到菜</text><text>{{item.actualText}} {{row.unit}}</text></view>
            <view><text>实际与配方相差</text><text class="{{item.tone}}">{{item.diffText}} {{row.unit}}</text></view>
          </view>
          <view class="usage-compare">
            <view class="usage-compare-row"><text>配方应该用</text><view><view style="width:{{item.theoryBarWidth}}%"></view></view><text>{{item.theoryText}}</text></view>
            <view class="usage-compare-row actual"><text>实际分摊到菜</text><view><view style="width:{{item.actualBarWidth}}%"></view></view><text>{{item.actualText}}</text></view>
          </view>
          <view class="dish-tip {{item.tone}}-tip">{{item.issueText}}</view>
        </view>

        <view class="dish-business-block composition-block">
          <view class="dish-block-title">
            <text>② 这道菜的配料成本怎么组成</text>
            <text class="dish-block-note">共 {{item.ingredientCountText}} 种配料</text>
          </view>
          <view class="composition-bar">
            <view class="focus-part" style="width:{{item.focusShareWidth}}%"></view>
            <view class="other-part" style="width:{{item.otherShareWidth}}%"></view>
          </view>
          <view class="composition-legend">
            <view><text class="legend-dot focus-dot"></text><text>{{row.name}}</text><text class="legend-strong">{{item.focusShareText}}%</text><text class="legend-small">配方成本 ¥{{item.focusTheoryCostText}}</text></view>
            <view><text class="legend-dot other-dot"></text><text>其他配料</text><text class="legend-strong">{{item.otherShareText}}%</text><text class="legend-small">配方成本 ¥{{item.otherTheoryCostText}}</text></view>
          </view>
          <text class="composition-help">这里按配方成本占比计算，不把斤、瓶、件等不同单位直接相加。</text>
        </view>

        <view class="dish-business-block finance-block">
          <view class="dish-block-title"><text>③ 这道菜的毛利是多少</text></view>
          <text class="finance-rule">按配方算：实际收到 − 配方成本 = 配方毛利</text>
          <view class="finance-equation">
            <view><text>实际收到</text><text class="finance-strong">¥{{item.salesAmountText}}</text></view>
            <text class="operator">−</text>
            <view><text>配方成本</text><text class="finance-strong">¥{{item.theoryCostText}}</text></view>
            <text class="operator">=</text>
            <view class="profit-box"><text>配方毛利</text><text class="finance-strong">¥{{item.theoryGrossProfitText}}</text><text class="finance-small">毛利率 {{item.theoryGrossMarginText}}%</text></view>
          </view>
          <text class="finance-rule recorded-rule">按出库记录算：实际收到 − 已分摊成本 = 账面毛利</text>
          <view class="finance-equation recorded-equation">
            <view><text>实际收到</text><text class="finance-strong">¥{{item.salesAmountText}}</text></view>
            <text class="operator">−</text>
            <view><text>已分摊成本</text><text class="finance-strong">¥{{item.allocatedCostText}}</text></view>
            <text class="operator">=</text>
            <view class="profit-box"><text>账面毛利</text><text class="finance-strong">¥{{item.recordedGrossProfitText}}</text><text class="finance-small">毛利率 {{item.recordedGrossMarginText}}%</text></view>
          </view>
          <view class="cost-warning {{item.costRecordTone}}-warning">{{item.costRecordWarning}}</view>
          <text class="gross-profit-help">毛利只扣了配料成本，还没有扣人工、房租、水电等费用。</text>
        </view>

        <view class="dish-detail-link">查看整道菜分析 <text>›</text></view>
      </view>
      <view class="empty-box" wx:if="{{!dishes.length}}">还没有找到使用这项原料的菜品</view>
    </view>

    <view class="section-card trend-card">
      <view class="section-head">
        <view><text class="step step-green">5</text><text class="section-title">采购价格怎么变</text></view>
        <text class="section-note">元 / {{row.unit}}</text>
      </view>
      <view class="trend-summary">
        <view><text>本期记录均价</text><text>¥{{row.unitPriceText}}</text></view>
        <view><text>上期记录均价</text><text>¥{{row.previousPrice || 0}}</text></view>
        <view><text>本期采购记录</text><text>{{row.priceRecordCount || 0}} 条</text></view>
      </view>
      <view class="chart-wrap"><ec-canvas id="trend" canvas-id="goods-price-trend" ec="{{ecTrend}}" class="trend-chart"></ec-canvas></view>
    </view>

    <view class="bottom-slogan">看清采购、库存和用途，才能知道每一斤原料花到哪里。</view>
    <view class="bottom-space"></view>
  </scroll-view>
</view>
