<view class="page"><back-navbar title="{{row.name}}" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar><view style="height:{{navBarHeight}}rpx;flex-shrink:0"></view><view class="datebar" style="flex-shrink:0" bindtap="toDatePage"><image src="/images/calender.png"></image><text class="bold">{{hanzi}}</text><text>{{dateText}}</text><text>⌄</text><text class="search">⌕</text></view><scroll-view scroll-y class="scroll" style="min-height:0">
<view class="hero"><view class="top"><image src="{{row.imageUrl||'/images/logo.jpg'}}" mode="aspectFill"></image><view><text class="name">{{row.name}}</text><text class="desc">主要用于{{row.dishNames||'多种菜品制作'}}</text></view><view class="price"><text class="small">当前单价</text><text class="strong">¥{{row.unitPriceText}}/{{row.unit}}</text></view></view><view class="kpis"><view><text>▰ 出库金额</text><text class="strong">¥{{row.totalText}}</text><text class="small">{{row.qtyText}} {{row.unit}}</text></view><view><text>✓ 核销金额</text><text class="strong">¥{{row.verifiedText}}</text><text class="small">{{row.verifiedQtyText}} {{row.unit}}</text></view><view class="red"><text>! 未核销金额</text><text class="strong">¥{{row.unverifiedText}}</text><text class="small">{{row.unverifiedQtyText}} {{row.unit}}</text></view><view class="orange"><text>♟ 员工餐</text><text class="strong">¥{{row.mealText}}</text><text class="small">{{row.mealQtyText}} {{row.unit}}</text></view></view></view>
<view class="panel"><view class="head"><text>▥ 出库去向分布</text><view><text class="active">按金额</text><text>按重量</text></view></view><view class="bar"><text style="width:{{row.verifiedPct}}%"></text><text style="width:{{row.unverifiedPct}}%"></text><text style="width:{{row.mealPct}}%"></text></view><view class="legend"><view><text class="dot blue"></text><text>核销 ¥{{row.verifiedText}} ({{row.verifiedPct}}%)</text></view><view><text class="dot red"></text><text>未核销 ¥{{row.unverifiedText}} ({{row.unverifiedPct}}%)</text></view><view><text class="dot orange"></text><text>员工餐 ¥{{row.mealText}} ({{row.mealPct}}%)</text></view></view></view>
<view class="panel"><view class="head"><text>♜ 关联菜品 ({{dishes.length}})</text><text class="small">按出库分摊量排序</text></view><view class="table-head"><text>菜品名称</text><text>销量(份)</text><text>单份用量</text><text>理论消耗</text><text>出库分摊</text><text>偏差</text></view><view class="dish" wx:for="{{dishes}}" wx:key="dishId" data-index="{{index}}" bindtap="toDish"><text class="dishname">{{item.dishName}} ›</text><text>{{item.salesText}}</text><text>{{item.unitText}}</text><text>{{item.theoryText}}</text><text>{{item.actualText}}</text><text class="{{item.tone}}">{{item.diffText}}</text></view><view class="empty" wx:if="{{!dishes.length}}">暂无关联菜品数据</view></view>
<view class="panel cost"><view class="head"><text>↗ 成本与消耗</text><view><text class="active">本期</text><text>价格趋势</text></view></view><view class="costbody"><view class="stats"><view><text class="small">本期均价</text><text class="strong">¥{{row.unitPriceText}}/{{row.unit}}</text></view><view><text class="small">上期均价</text><text class="strong">¥{{row.previousPrice||0}}/{{row.unit}}</text></view><view><text class="small">累计理论消耗</text><text class="strong">{{row.theoryText}} {{row.unit}}</text></view><view><text class="small">累计制作出库分摊</text><text class="strong">{{row.actualText}} {{row.unit}}</text><text class="{{row.diffTone}}">较理论 {{row.diffText}}</text></view></view><view class="chart"><text class="chart-title">采购单价走势（元/{{row.unit}}）</text><ec-canvas id="trend" canvas-id="trend" ec="{{ecTrend}}" class="trend-chart"></ec-canvas></view></view></view><view class="slogan">💡　合理控制食材损耗，让每一份食材创造更大价值！</view><view class="space"></view></scroll-view></view>
