<wxs src="../../../../utils/fn.wxs" module="tool" />
<wxs module="num" src="/wxs/signedNumber.wxs" />

<view class="flex flex-column">

  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{disGoods.gbDgGoodsName}}" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>
 
  <!--  top -->
  <view class=" flex-row-between pl-20 pr-20 border-bottom bg-white">
    <view class="flex-row">
      <view class="p-20" bindtap="toDatePage">
        <image src="../../../../images/calender.png" class="icon"></image>
      </view>
      <view class="flex-column pt-10">
        <view class="font-yuan">{{hanzi}}</view>
        <view class="flex-row" wx:if="{{startDate == stopDate}}">
          <view class=" small" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
        </view>
        <view class="flex-row" wx:else>
          <view class="" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
          <text class="plr-10">-</text>
          <view class="" wx:if="{{stopDate}}">{{tool.transferDateString(stopDate)}}</view>
        </view>
      </view>
    </view>

    <view class="flex-row p-20" bindtap="onToggleSearchBar">
      <image src="/images/search-3.png" class="icon mr-20 cog-search-top-ico {{goodsNameSearch ? 'cog-search-top-ico--on' : ''}}"></image>
    </view>
  </view>


  <!-- 部门筛选显示区域 -->
  <view class="filter-container" wx:if="{{selectedDepartment}}">
    <view class="filter-row">
      <view class="filter-chip">
        <text class="filter-text">部门: {{selectedDepartment.depName}}</text>
        <view class="filter-delete" bindtap="clearDepartmentFilter">
          <image src="/images/del-2.png" mode="aspectFill" class="delete-icon"></image>
        </view>
      </view>
    </view>
  </view>

  <view class="flex-column" wx:if="{{hasGoodsCostContent}}">

    <!-- AI智能分析卡片 -->
    <view class="ai-analysis-card" wx:if="{{aiAnalysis}}" >

      <!-- 成本指标区域 -->
      <block wx:if="{{aiAnalysis.type == 'fresh'}}">
        <view class="ai-metrics-section">
          <view class="metrics-title">📊 成本指标</view>
          <view class="metrics-grid">

            <view class="metric-item">
              <view class="metric-label">支出用量</view>
              <view class="metric-value">
                {{oneTotalWeight}}{{disGoods.gbDgGoodsStandardname}}
              </view>
            </view>
            <view class="metric-item">
              <view class="metric-label">支出成本</view>
              <view class="metric-value metric-info">
                {{oneTotal}}元
              </view>
            </view>

            <view class="metric-item">
              <view class="metric-label">平均用量</view>
              <view class="metric-value">
                {{aiAnalysis.averageWeight}}{{disGoods.gbDgGoodsStandardname}}/天
              </view>
            </view>
            <view class="metric-item">
              <view class="metric-label">平均成本</view>
              <view class="metric-value metric-info">
                {{aiAnalysis.averageSubtotal}}元/天
              </view>
            </view>
            <view class="metric-item">
              <view class="metric-label">库存</view>
              <view class="metric-value">
                {{aiAnalysis.stockWeight}}{{disGoods.gbDgGoodsStandardname}}
              </view>
            </view>
            <view class="metric-item">
              <view class="metric-label">库存金额</view>
              <view class="metric-value">
                {{aiAnalysis.stockSubtotal}}元
              </view>
            </view>


            <view class="metric-item">
              <view class="metric-label">损耗率</view>
              <view class="flex-column-center">
                <view class="metric-value {{aiAnalysis.lossRate > 10 ? 'metric-warning' : 'metric-success'}}">
                  {{aiAnalysis.lossRate}}%
                </view>
                <text class="font-yuan text-secondary">{{lossTotalWeight}}{{disGoods.gbDgGoodsStandardname}}</text>
              </view>

            </view>
            <view class="metric-item">
              <view class="metric-label">浪费率</view>
              <view class="flex-column-center">
                <view class="metric-value {{aiAnalysis.wasteRate > 5 ? 'metric-danger' : 'metric-success'}}">
                  {{aiAnalysis.wasteRate}}%
                </view>
                <text class="font-yuan text-secondary">{{wasteTotalWeight}}{{disGoods.gbDgGoodsStandardname}}</text>
              </view>

            </view>

            <!-- 菜品销量反推：理论/实际原料四项（合并进 aiAnalysis） -->
            <block >
              <view class="metric-item">
                <view class="metric-label">理论应耗</view>
                <view class="metric-value">{{aiAnalysis.theoreticalIngredientTotal}}{{disGoods.gbDgGoodsStandardname}}</view>
              </view>
              <view class="metric-item">
                <view class="metric-label">实际消耗</view>
                <view class="metric-value">{{aiAnalysis.actualIngredientTotal}}{{disGoods.gbDgGoodsStandardname}}</view>
              </view>
              <view class="metric-item">
                <view class="metric-label">差值(实际−理论)</view>
                <view class="metric-value">{{aiAnalysis.ingredientGapActualMinusTheoretical}}{{disGoods.gbDgGoodsStandardname}}</view>
              </view>
              <view class="metric-item">
                <view class="metric-label">偏差占理论</view>
                <view class="metric-value">{{aiAnalysis.ingredientGapPercentOfTheoretical == null ? '无' : aiAnalysis.ingredientGapPercentOfTheoretical + '%'}}</view>
              </view>
            </block>

          </view>
        </view>
      </block>
      <block wx:else="">
        <view class="ai-metrics-section">
          <view class="metrics-title">📊 成本指标</view>
          <view class="metrics-grid">

            <view class="metric-item">
              <view class="metric-label">采购总量</view>
              <view class="metric-value">
                {{weightTotal}}{{disGoods.gbDgGoodsStandardname}}
              </view>
            </view>
            <view class="metric-item">
              <view class="metric-label">采购总额</view>
              <view class="metric-value">
                {{subTotal}}元
              </view>
            </view>

            <view class="metric-item">
              <view class="metric-label">支出用量</view>
              <view class="metric-value">
                {{oneTotalWeight}}{{disGoods.gbDgGoodsStandardname}}
              </view>
            </view>
            <view class="metric-item">
              <view class="metric-label">支出成本</view>
              <view class="metric-value metric-info">
                {{oneTotal}}元
              </view>
            </view>

            <view class="metric-item">
              <view class="metric-label">平均用量</view>
              <view class="metric-value">
                {{aiAnalysis.averageWeight}}{{disGoods.gbDgGoodsStandardname}}/天
              </view>
            </view>
            <view class="metric-item">
              <view class="metric-label">平均成本</view>
              <view class="metric-value metric-info">
                {{aiAnalysis.averageSubtotal}}元/天
              </view>
            </view>

            <!-- 菜品销量反推：理论/实际原料四项（合并进 aiAnalysis） -->
            <block wx:if="{{showIngredientMetricsStrip}}">
              <view class="metric-item">
                <view class="metric-label">理论应耗</view>
                <view class="metric-value">{{aiAnalysis.theoreticalIngredientTotal}}{{disGoods.gbDgGoodsStandardname}}</view>
              </view>
              <view class="metric-item">
                <view class="metric-label">实际消耗</view>
                <view class="metric-value">{{aiAnalysis.actualIngredientTotal}}{{disGoods.gbDgGoodsStandardname}}</view>
              </view>
              <view class="metric-item">
                <view class="metric-label">差值(实际−理论)</view>
                <view class="metric-value">{{aiAnalysis.ingredientGapActualMinusTheoretical}}{{disGoods.gbDgGoodsStandardname}}</view>
              </view>
              <view class="metric-item">
                <view class="metric-label">偏差占理论</view>
                <view class="metric-value">{{aiAnalysis.ingredientGapPercentOfTheoretical == null ? '无' : aiAnalysis.ingredientGapPercentOfTheoretical + '%'}}</view>
              </view>
            </block>

            <!-- <view class="metric-item">
              <view class="metric-label">库存</view>
              <view class="metric-value">
                {{aiAnalysis.stockWeight}}{{disGoods.gbDgGoodsStandardname}}
              </view>
            </view>
            <view class="metric-item">
              <view class="metric-label">库存金额</view>
              <view class="metric-value">
                {{aiAnalysis.stockSubtotal}}元
              </view>
            </view> -->

          </view>
        </view>
      </block>

      <!-- 警告信息区域 -->
      <view class="ai-warnings-section" wx:if="{{aiAnalysis.warnings && aiAnalysis.warnings.length > 0}}">
        <view class="section-header" bindtap="toggleWarnings">
          <view class="section-title">
            <text class="warning-icon">⚠️</text>
            <text>警告信息 ({{aiAnalysis.warnings.length}}条)</text>
          </view>
          <image src="../../../../images/arrow-down.png" class="toggle-icon {{warningsExpanded ? 'expanded' : 'collapsed'}}" mode="aspectFit"></image>
        </view>
        <view class="warnings-content {{warningsExpanded ? 'expanded' : 'collapsed'}}">
          <view class="warning-item" wx:for="{{aiAnalysis.warnings}}" wx:key="index">
            <text class="warning-text">{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 建议信息区域 -->
      <view class="ai-suggestions-section" wx:if="{{aiAnalysis.suggestions && aiAnalysis.suggestions.length > 0}}">
        <view class="section-header" bindtap="toggleSuggestions">
          <view class="section-title">
            <text class="suggestion-icon">💡</text>
            <text>智能建议 ({{aiAnalysis.suggestions.length}}条)</text>
          </view>
          <image src="../../../../images/arrow-down.png" class="toggle-icon {{suggestionsExpanded ? 'expanded' : 'collapsed'}}" mode="aspectFit"></image>
        </view>
        <view class="suggestions-content {{suggestionsExpanded ? 'expanded' : 'collapsed'}}">
          <view class="suggestion-item" wx:for="{{aiAnalysis.suggestions}}" wx:key="index">
            <text class="suggestion-text">{{item}}</text>
          </view>
        </view>
      </view>


    </view>

    <!-- 日支出堆叠柱（生产出库 / 损耗 / 废弃） -->
    <view class="bg-white p-20 chart-daily-wrap gfc-chart-section" style="height: 460rpx;">
      <view class="gfc-block-caption">
        <text class="gfc-block-caption-title">日出库数量</text>
        <text class="gfc-block-caption-desc">按日汇总出库用量：生产出库、损耗、废弃等在图表中分段展示。</text>
      </view>
      <view wx:if="{{produceList.length > 0 || lossList.length > 0 || wasteList.length > 0}}" class="chart-container gfc-chart-body">
        <ec-canvas id="dailyChart" canvas-id="dailyChart" class="chart">
        </ec-canvas>
      </view>
    </view>


    <block wx:if="{{oneTotal > 0 || (itemList && itemList.length)}}">
      <view class="gfc-chart-to-list-gap"></view>

      <view scroll-y style="height:{{windowHeight - 460}}rpx;">
      <view class="gfc-block-caption gfc-block-caption--in-module bg-white pl-20 pr-20 pt-20 pb-8">
        <text class="gfc-block-caption-title">每日出库与销售对比</text>
        <text class="gfc-block-caption-desc">按日期与部门列出当日出库用量、菜品销售份数及相关成本与分摊收入，便于逐日对照。</text>
      </view>

      <view class="flex-column ">
        <view class="flex-row-default p-20 border-bottom bg-white gfc-itemlist-day" wx:for="{{itemList}}" wx:key="index" wx:for-item="everyday" wx:for-index="dayIndex">

          <view class="flex-column gfc-itemlist-day-inner" wx:for="{{everyday.arr}}" wx:for-item="day" wx:for-index="itemIndex" wx:key="itemIndex" style="width: {{windowWidth - 40}}rpx;">

            <view class="flex-column font-md">

              <view id="src-{{itemIndex}}-{{dayIndex}}" class="stock-row-container gfc-dep-card-wrap">
                <view
                  class="stock-row gfc-dep-summary-row {{expandedRows[itemIndex + '_' + dayIndex] ? 'stock-row-active' : ''}}"
                >
                  <view class="gfc-dep-summary-stack">
                    <!-- 顶部一行：日期 + 部门 -->
                    <view class="gfc-dep-head-row">
                      <text class="gfc-dep-head-date" wx:if="{{everyday.date}}">{{tool.transferDateString(everyday.date)}}</text>
                      <text class="gfc-dep-head-date" wx:elif="{{day.departmentGoodsDailyEntity && day.departmentGoodsDailyEntity.gbDgdDate}}">{{tool.transferDateString(day.departmentGoodsDailyEntity.gbDgdDate)}}</text>
                      <text class="gfc-dep-head-sep" wx:if="{{everyday.date || (day.departmentGoodsDailyEntity && day.departmentGoodsDailyEntity.gbDgdDate)}}">·</text>
                      <text class="gfc-dep-head-dept">{{day.gbDepartmentName}}</text>
                      <text class="gfc-dep-head-attr" wx:if="{{day.gbDepartmentAttrName}}">（{{day.gbDepartmentAttrName}}）</text>
                    </view>

                    <!-- 三模块：出库 | 菜品销售 | 本原料收支 -->
                    <view class="gfc-day-balance-cols gfc-day-balance-cols--triple">
                      <view class="gfc-day-col gfc-day-col--out">
                        <text class="gfc-day-col-tag">出库</text>
                        <text class="gfc-day-col-qty">{{day.dayOutbound123Weight}}{{disGoods.gbDgGoodsStandardname}}</text>
                        <text class="gfc-day-col-sub">出库成本 ¥{{day.dayOutbound123Subtotal}}</text>
                        <text class="gfc-day-col-hint">理论用料 {{day.dayTheoryOutboundQty}}{{disGoods.gbDgGoodsStandardname}}</text>
                      </view>
                      <view class="gfc-day-col gfc-day-col--sales">
                        <text class="gfc-day-col-tag">菜品销售</text>
                        <block wx:if="{{day._gfcDishCount > 0}}">
                          <text class="gfc-day-col-qty">共 {{day._gfcSalesPortionsTotal}} 份</text>
                          <text class="gfc-day-col-sub">{{day._gfcDishCount}} 道菜：{{day._gfcSalesPreview}}</text>
                        </block>
                        <block wx:else>
                          <text class="gfc-day-col-qty gfc-day-col-qty--muted">—</text>
                          <text class="gfc-day-col-sub">暂无关联菜品销量</text>
                          <text class="gfc-day-col-hint">可看左侧出库</text>
                        </block>
                      </view>
                      <view class="gfc-day-col gfc-day-col--money">
                        <text class="gfc-day-col-tag">本原料收支</text>
                        <text class="gfc-day-col-money-rev" wx:if="{{day._gfcDishCount > 0}}">¥{{day._gfcAllocatedRevenueSum}}</text>
                        <text class="gfc-day-col-money-rev gfc-day-col-money-rev--na" wx:else>—</text>
                        <text class="gfc-day-col-sub">分摊收入</text>
                        <text class="gfc-day-col-hint">出库成本 ¥{{day.dayOutbound123Subtotal}}</text>
                        <text class="gfc-day-col-hint gfc-day-col-hint-profit">毛利 ¥{{day.dayGrossProfitContributionTotal}}</text>
                      </view>
                    </view>
                  </view>

                  <!-- 菜品明细入口固定在卡片底部 -->
                  <view
                    wx:if="{{day.dayDishIngredientSales && day.dayDishIngredientSales.length}}"
                    class="gfc-dish-toggle-footer"
                    catchtap="showOne"
                    data-item-index="{{itemIndex}}"
                    data-day-index="{{dayIndex}}"
                  >
                    <view class="gfc-dish-toggle-foot-text">
                      <text class="gfc-dish-toggle-foot-title">菜品分摊明细</text>
                      <text class="gfc-dish-toggle-foot-sub">共 {{day._gfcSalesPortionsTotal}} 份 · {{day._gfcDishCount}} 道菜 · 收支明细</text>
                    </view>
                    <view class="gfc-dish-toggle-foot-arrow">
                      <image src="/images/arrow-right-3.png" mode="aspectFill" class="arrow-icon {{expandedRows[itemIndex + '_' + dayIndex] ? 'expanded' : 'collapsed'}}" />
                    </view>
                  </view>
                  <view wx:else class="gfc-dish-toggle-footer gfc-dish-toggle-footer--disabled">
                    <text class="gfc-dish-toggle-foot-title gfc-dish-toggle-foot-title--muted">暂无菜品分摊明细</text>
                  </view>
                </view>

                <view class="stock-info-card gfc-dish-expand" wx:if="{{expandedRows[itemIndex + '_' + dayIndex] && day.dayDishIngredientSales && day.dayDishIngredientSales.length}}">
                  <view class="gfc-dish-expand-title">各菜品 · 销量与本原料收支</view>
                  <view class="gfc-dish-card" wx:for="{{day.dayDishIngredientSales}}" wx:for-item="dishRow" wx:for-index="dishIdx" wx:key="dishIdx">
                    <view class="gfc-dish-card-hd">
                      <text class="gfc-dish-name">{{dishRow.dishName}}</text>
                      <text class="gfc-dish-id" wx:if="{{dishRow.dishId}}">#{{dishRow.dishId}}</text>
                    </view>
                    <view class="gfc-dish-quick-line">
                      <text class="gfc-dish-quick-label">当天售出</text>
                      <text class="gfc-dish-quick-strong">{{dishRow.salesPortions}} 份</text>
                    </view>
                    <text class="gfc-dish-quick-sub">整道菜营业额 ¥{{dishRow.salesAmount}}</text>
                    <view class="gfc-dish-money-trio">
                      <view class="gfc-dish-mt-item">
                        <text class="gfc-dish-mt-k">分摊收入</text>
                        <text class="gfc-dish-mt-v gfc-dish-mt-v--in">¥{{dishRow.listRevenueAllocatedToIngredient}}</text>
                      </view>
                      <view class="gfc-dish-mt-item">
                        <text class="gfc-dish-mt-k">分摊出库成本</text>
                        <text class="gfc-dish-mt-v gfc-dish-mt-v--out">¥{{dishRow.outbound123CostAllocatedToIngredient}}</text>
                      </view>
                      <view class="gfc-dish-mt-item">
                        <text class="gfc-dish-mt-k">毛利</text>
                        <text class="gfc-dish-mt-v gfc-dish-mt-v--profit">¥{{dishRow.grossProfitContribution}}</text>
                      </view>
                    </view>
                    <view class="gfc-dish-meta-line">
                      <text>均价 ¥{{dishRow.salesUnitPrice}}/份</text>
                      <text class="gfc-dish-meta-dot">·</text>
                      <text>每份用本原料 {{dishRow.recipeUnitPerDish}}{{disGoods.gbDgGoodsStandardname}}</text>
                      <text class="gfc-dish-meta-dot">·</text>
                      <text>理论用量 {{dishRow.theoryIngredientQty}}{{disGoods.gbDgGoodsStandardname}}</text>
                    </view>
                  </view>
                </view>

              </view>

            </view>
          </view>

        </view>
      </view>

      <view class="font-sl text-secondary flex-column-center" style="height: 100rpx;" wx:if="{{!itemList || itemList.length === 0}}">暂无按日部门明细</view>

    </view>
    </block>


  </view>

  <view wx:else>
    <!-- </block> -->

    <view class="" style="height: {{windowHeight - 360}}rpx;">

      <view class="center-content flex-column" style="padding-top: 200rpx;">
        <image class="empty_image" src="/images/cart-Empty.png"></image>
        <text class="big">无数据</text>
      </view>

    </view>
    <!-- ./empty -->
  </view>

</view>