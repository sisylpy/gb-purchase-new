<wxs src="../../../../utils/fn.wxs" module="tool" />

<view class="flex flex-column">

  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{disGoods.gbDgGoodsName}}" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <!--  top -->
  <view class=" flex-row-between pl-20 pr-20 border-bottom bg-white">
    <view class="flex-row">
      <view class="p-20" bindtap="toDatePage">
        <image src="../../../../images/calender.png" class="icon"></image>
      </view>
      <view class="flex-column pt-10">
        <view class="font-yuan">{{hanzi}}</view>
        <view class="flex-row" wx:if="{{startDate == stopDate}}">
          <view class=" small" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
        </view>
        <view class="flex-row" wx:else>
          <view class="" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
          <text class="plr-10">-</text>
          <view class="" wx:if="{{stopDate}}">{{tool.transferDateString(stopDate)}}</view>
        </view>
      </view>
    </view>

    <!-- <view class="flex-row p-20" bindtap="toFilterType">
      <image src="{{searchDepId !== -1 ? '../../../../images/filter.png' : '../../../../images/filter-3-fill.png'}}" class="icon mr-20"></image>
    </view> -->
  </view>

  <!-- 部门筛选显示区域 -->
  <view class="filter-container" wx:if="{{selectedDepartment}}">
    <view class="filter-row">
      <view class="filter-chip">
        <text class="filter-text">部门: {{selectedDepartment.depName}}</text>
        <view class="filter-delete" bindtap="clearDepartmentFilter">
          <image src="/images/del-2.png" mode="aspectFill" class="delete-icon"></image>
        </view>
      </view>
    </view>
  </view>

  <view class="flex-column" wx:if="{{hasGoodsCostContent}}">

    <!-- AI智能分析卡片 -->
    <view class="ai-analysis-card" wx:if="{{aiAnalysis}}">

      <!-- 成本指标区域 -->
      <block wx:if="{{aiAnalysis.type == 'fresh'}}">
        <view class="ai-metrics-section">
          <view class="metrics-title">📊 成本指标</view>
          <view class="metrics-grid">

          

            <view class="metric-item">
              <view class="metric-label">支出用量</view>
              <view class="metric-value">
                {{oneTotalWeight}}{{disGoods.gbDgGoodsStandardname}}
              </view>
            </view>
            <view class="metric-item">
              <view class="metric-label">支出成本</view>
              <view class="metric-value metric-info">
                {{oneTotal}}元
              </view>
            </view>

            <view class="metric-item">
              <view class="metric-label">平均用量</view>
              <view class="metric-value">
                {{aiAnalysis.averageWeight}}{{disGoods.gbDgGoodsStandardname}}/天
              </view>
            </view>
            <view class="metric-item">
              <view class="metric-label">平均成本</view>
              <view class="metric-value metric-info">
                {{aiAnalysis.averageSubtotal}}元/天
              </view>
            </view>
            <view class="metric-item">
              <view class="metric-label">库存</view>
              <view class="metric-value">
                {{aiAnalysis.stockWeight}}{{disGoods.gbDgGoodsStandardname}}
              </view>
            </view>
            <view class="metric-item">
              <view class="metric-label">库存金额</view>
              <view class="metric-value">
                {{aiAnalysis.stockSubtotal}}元
              </view>
            </view>


            <view class="metric-item">
              <view class="metric-label">损耗率</view>
              <view class="flex-column-center">
                <view class="metric-value {{aiAnalysis.lossRate > 10 ? 'metric-warning' : 'metric-success'}}">
                  {{aiAnalysis.lossRate}}%
                </view>
                <text class="font-yuan text-secondary">{{lossTotalWeight}}{{disGoods.gbDgGoodsStandardname}}</text>
              </view>

            </view>
            <view class="metric-item">
              <view class="metric-label">浪费率</view>
              <view class="flex-column-center">
                <view class="metric-value {{aiAnalysis.wasteRate > 5 ? 'metric-danger' : 'metric-success'}}">
                  {{aiAnalysis.wasteRate}}%
                </view>
                <text class="font-yuan text-secondary">{{wasteTotalWeight}}{{disGoods.gbDgGoodsStandardname}}</text>
              </view>

            </view>

          </view>
        </view>
      </block>
      <block wx:else="">
        <view class="ai-metrics-section">
          <view class="metrics-title">📊 成本指标</view>
          <view class="metrics-grid">

            <view class="metric-item">
              <view class="metric-label">采购总量</view>
              <view class="metric-value">
                {{weightTotal}}{{disGoods.gbDgGoodsStandardname}}
              </view>
            </view>
            <view class="metric-item">
              <view class="metric-label">采购总额</view>
              <view class="metric-value">
                {{subTotal}}元
              </view>
            </view>

            <view class="metric-item">
              <view class="metric-label">支出用量</view>
              <view class="metric-value">
                {{oneTotalWeight}}{{disGoods.gbDgGoodsStandardname}}
              </view>
            </view>
            <view class="metric-item">
              <view class="metric-label">支出成本</view>
              <view class="metric-value metric-info">
                {{oneTotal}}元
              </view>
            </view>

            <view class="metric-item">
              <view class="metric-label">平均用量</view>
              <view class="metric-value">
                {{aiAnalysis.averageWeight}}{{disGoods.gbDgGoodsStandardname}}/天
              </view>
            </view>
            <view class="metric-item">
              <view class="metric-label">平均成本</view>
              <view class="metric-value metric-info">
                {{aiAnalysis.averageSubtotal}}元/天
              </view>
            </view>
            <!-- <view class="metric-item">
              <view class="metric-label">库存</view>
              <view class="metric-value">
                {{aiAnalysis.stockWeight}}{{disGoods.gbDgGoodsStandardname}}
              </view>
            </view>
            <view class="metric-item">
              <view class="metric-label">库存金额</view>
              <view class="metric-value">
                {{aiAnalysis.stockSubtotal}}元
              </view>
            </view> -->

          </view>
        </view>
      </block>

      <!-- 警告信息区域 -->
      <view class="ai-warnings-section" wx:if="{{aiAnalysis.warnings && aiAnalysis.warnings.length > 0}}">
        <view class="section-header" bindtap="toggleWarnings">
          <view class="section-title">
            <text class="warning-icon">⚠️</text>
            <text>警告信息 ({{aiAnalysis.warnings.length}}条)</text>
          </view>
          <image src="../../../../images/arrow-down.png" class="toggle-icon {{warningsExpanded ? 'expanded' : 'collapsed'}}" mode="aspectFit"></image>
        </view>
        <view class="warnings-content {{warningsExpanded ? 'expanded' : 'collapsed'}}">
          <view class="warning-item" wx:for="{{aiAnalysis.warnings}}" wx:key="index">
            <text class="warning-text">{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 建议信息区域 -->
      <view class="ai-suggestions-section" wx:if="{{aiAnalysis.suggestions && aiAnalysis.suggestions.length > 0}}">
        <view class="section-header" bindtap="toggleSuggestions">
          <view class="section-title">
            <text class="suggestion-icon">💡</text>
            <text>智能建议 ({{aiAnalysis.suggestions.length}}条)</text>
          </view>
          <image src="../../../../images/arrow-down.png" class="toggle-icon {{suggestionsExpanded ? 'expanded' : 'collapsed'}}" mode="aspectFit"></image>
        </view>
        <view class="suggestions-content {{suggestionsExpanded ? 'expanded' : 'collapsed'}}">
          <view class="suggestion-item" wx:for="{{aiAnalysis.suggestions}}" wx:key="index">
            <text class="suggestion-text">{{item}}</text>
          </view>
        </view>
      </view>


    </view>

    <!-- 日支出堆叠柱 + 蓝色折线：菜品销量带动的本原料消耗 -->
    <view class="bg-white p-20 chart-daily-wrap" style="height: 400rpx;">
      <view wx:if="{{produceList.length > 0 || lossList.length > 0 || wasteList.length > 0 || foodSalesIngredientList.length > 0}}" class="chart-container">
        <ec-canvas id="dailyChart" canvas-id="dailyChart" class="chart">
        </ec-canvas>
      </view>
    </view>

    <!-- 门店菜品：接口文档中的菜品/原料字段全部展示 -->
    <view wx:if="{{foodSalesIngredientList.length || foodSalesStats || foodSalesIngredientTotal != null}}" class="food-sales-root">
      <view class="food-sales-card">
        <view class="food-sales-card-head">
          <text class="food-sales-card-title">门店菜品 · 本原料</text>
          <text class="food-sales-card-sub">按 Excel 导入的菜品销量反推本原料消耗；图中蓝线为「菜品原料消耗」</text>
        </view>

        <view class="food-sales-section">
          <view class="food-sales-section-title">按日·本原料消耗</view>
          <view class="food-sales-kv">
            <text class="food-sales-k">区间合计</text>
            <text class="food-sales-v">{{foodSalesIngredientTotal != null ? foodSalesIngredientTotal : '—'}}{{disGoods && disGoods.gbDgGoodsStandardname ? disGoods.gbDgGoodsStandardname : ''}}</text>
          </view>
          <scroll-view scroll-y class="food-sales-ingredient-scroll" wx:if="{{foodSalesIngredientList.length}}">
            <view class="food-sales-table food-sales-table-ing">
              <view class="food-sales-tr food-sales-th">
                <text class="food-sales-td w-date">日期</text>
                <text class="food-sales-td w-val">用量</text>
              </view>
              <view class="food-sales-tr" wx:for="{{foodSalesIngredientList}}" wx:for-index="ingIdx" wx:key="ingIdx">
                <text class="food-sales-td w-date">{{item.date}}</text>
                <text class="food-sales-td w-val">{{item.value}}</text>
              </view>
            </view>
          </scroll-view>
          <view wx:else class="food-sales-empty">暂无按日消耗数据</view>
        </view>

        <view class="food-sales-section" wx:if="{{foodSalesStats}}">
          <view class="food-sales-section-title">统计范围</view>
          <view class="food-sales-kv">
            <text class="food-sales-k">原料明细行数</text>
            <text class="food-sales-v">{{foodSalesStats.depFoodGoodsSalesRowCountInPeriod}}</text>
          </view>
          <view class="food-sales-kv" wx:if="{{foodSalesStats.period}}">
            <text class="food-sales-k">起止日期</text>
            <text class="food-sales-v">{{foodSalesStats.period.startDate}} ~ {{foodSalesStats.period.stopDate}}</text>
          </view>
          <view class="food-sales-kv" wx:if="{{foodSalesStats.filters}}">
            <text class="food-sales-k">商品编号 / 部门</text>
            <text class="food-sales-v">{{foodSalesStats.filters.disGoodsId}} / {{foodSalesStats.filters.searchDepId}}</text>
          </view>
        </view>

        <view class="food-sales-section" wx:if="{{foodSalesStats && foodSalesStats.dishSales}}">
          <view class="food-sales-section-title">菜品销售关联</view>
          <view class="food-sales-kv">
            <text class="food-sales-k">关联销售笔数</text>
            <text class="food-sales-v">{{foodSalesStats.dishSales.linkedSalesRowCount}}</text>
          </view>
          <view class="food-sales-kv">
            <text class="food-sales-k">关联菜品销量合计</text>
            <text class="food-sales-v">{{foodSalesStats.dishSales.linkedDishQtyTotal}}</text>
          </view>
          <view class="food-sales-section-sub">最耗本料的菜品（至多25条）</view>
          <scroll-view scroll-y class="food-sales-table-scroll" wx:if="{{foodSalesStats.dishSales.topDishesDrivingThisIngredient && foodSalesStats.dishSales.topDishesDrivingThisIngredient.length}}">
            <view class="food-sales-table">
              <view class="food-sales-tr food-sales-th">
                <text class="food-sales-td w-sm">销售单号</text>
                <text class="food-sales-td w-sm">菜品编号</text>
                <text class="food-sales-td w-qty">菜品销量</text>
                <text class="food-sales-td w-amt">本料消耗</text>
              </view>
              <view class="food-sales-tr" wx:for="{{foodSalesStats.dishSales.topDishesDrivingThisIngredient}}" wx:for-index="tdIdx" wx:key="tdIdx">
                <text class="food-sales-td w-sm">{{item.gbDepFoodSalesId}}</text>
                <text class="food-sales-td w-sm">{{item.gbDfsFoodId}}</text>
                <text class="food-sales-td w-qty">{{item.dishQty}}</text>
                <text class="food-sales-td w-amt">{{item.ingredientAmount}}</text>
              </view>
            </view>
          </scroll-view>
          <view wx:else class="food-sales-empty">暂无排行榜菜品数据</view>
        </view>

        <view class="food-sales-section" wx:if="{{foodSalesStats}}">
          <view class="food-sales-section-title">配方中的菜品</view>
          <scroll-view scroll-y class="food-sales-table-scroll" wx:if="{{foodSalesStats.recipeDishesUsingThisGood && foodSalesStats.recipeDishesUsingThisGood.length}}">
            <view class="food-sales-table">
              <view class="food-sales-tr food-sales-th">
                <text class="food-sales-td w-food">菜名</text>
                <text class="food-sales-td w-sm">菜品编号</text>
                <text class="food-sales-td w-num">每份本料量</text>
                <text class="food-sales-td w-num">配方总用量</text>
                <text class="food-sales-td w-pct">本料占比(%)</text>
              </view>
              <view class="food-sales-tr" wx:for="{{foodSalesStats.recipeDishesUsingThisGood}}" wx:for-index="rcIdx" wx:key="rcIdx">
                <text class="food-sales-td w-food">{{item.foodName}}</text>
                <text class="food-sales-td w-sm">{{item.gbDfsFoodId}}</text>
                <text class="food-sales-td w-num">{{item.recipeAmountThisGoodPerDish}}</text>
                <text class="food-sales-td w-num">{{item.totalRecipeAmountAllIngredients}}</text>
                <text class="food-sales-td w-pct">{{item.shareOfRecipePercent}}</text>
              </view>
            </view>
          </scroll-view>
          <view wx:else class="food-sales-empty">暂无配方数据（需在批发商菜品中维护配方）</view>
        </view>

        <view class="food-sales-section" wx:if="{{foodSalesStats}}">
          <view class="food-sales-section-title">按部门·菜品汇总</view>
          <scroll-view scroll-x="true" class="food-sales-xscroll" wx:if="{{foodSalesStats.periodSalesByDepAndDish && foodSalesStats.periodSalesByDepAndDish.length}}">
          <scroll-view scroll-y="true" class="food-sales-table-scroll food-sales-table-scroll-tall food-sales-inner-y">
            <view class="food-sales-table food-sales-table-wide">
              <view class="food-sales-tr food-sales-th">
                <text class="food-sales-td w-dep">部门</text>
                <text class="food-sales-td w-food">菜名</text>
                <text class="food-sales-td w-sm">部门编号</text>
                <text class="food-sales-td w-sm">菜品编号</text>
                <text class="food-sales-td w-qty">销量</text>
                <text class="food-sales-td w-num">每份本料量</text>
                <text class="food-sales-td w-amt">理论应耗</text>
              </view>
              <view class="food-sales-tr" wx:for="{{foodSalesStats.periodSalesByDepAndDish}}" wx:key="index">
                <text class="food-sales-td w-dep">{{item.depName}}</text>
                <text class="food-sales-td w-food">{{item.foodName}}</text>
                <text class="food-sales-td w-sm">{{item.gbDfsDepId}}</text>
                <text class="food-sales-td w-sm">{{item.gbDfsFoodId}}</text>
                <text class="food-sales-td w-qty">{{item.soldQty}}</text>
                <text class="food-sales-td w-num">{{item.recipeAmountThisGoodPerDish}}</text>
                <text class="food-sales-td w-amt">{{item.theoreticalIngredientForThisRow}}</text>
              </view>
            </view>
          </scroll-view>
          </scroll-view>
          <view wx:else class="food-sales-empty">暂无按部门菜品汇总</view>
        </view>

        <view class="food-sales-section" wx:if="{{foodSalesStats && foodSalesStats.theoreticalVsActual}}">
          <view class="food-sales-section-title">理论与实际对比</view>
          <view class="food-sales-kv">
            <text class="food-sales-k">理论应耗合计</text>
            <text class="food-sales-v">{{foodSalesStats.theoreticalVsActual.theoreticalIngredientTotal}}</text>
          </view>
          <view class="food-sales-kv">
            <text class="food-sales-k">实际消耗合计</text>
            <text class="food-sales-v">{{foodSalesStats.theoreticalVsActual.actualIngredientTotal}}</text>
          </view>
          <view class="food-sales-kv">
            <text class="food-sales-k">差值(实际−理论)</text>
            <text class="food-sales-v">{{foodSalesStats.theoreticalVsActual.ingredientGapActualMinusTheoretical}}</text>
          </view>
          <view class="food-sales-kv">
            <text class="food-sales-k">偏差占理论(%)</text>
            <text class="food-sales-v">{{foodSalesStats.theoreticalVsActual.ingredientGapPercentOfTheoretical == null ? '无' : foodSalesStats.theoreticalVsActual.ingredientGapPercentOfTheoretical + '%'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view scroll-y wx:if="{{oneTotal > 0}}" style="height:{{windowHeight - 400}}rpx; ">

      <view class="flex-column ">
        <view class="flex-row-default p-20  border-bottom bg-white " wx:for="{{itemList}}" wx:key="index" wx:for-item="everyday" wx:for-index="dayIndex">

         
          <view class="flex-column" wx:for="{{everyday.arr}}" wx:for-item="day" wx:for-index="itemIndex" wx:key="itemIndex" style="width: {{windowWidth - 40}}rpx;">

            <view class="flex-column font-md " wx:for="{{day.departmentGoodsDailyEntity.wasteReduceList}}" wx:for-item="reduceDay" wx:for-index="reduceIndex" wx:key="reduceIndex">

              <!-- 默认显示 -->
              <view id="src-{{itemIndex}}-{{dayIndex}}-{{reduceIndex}}" class="stock-row-container " data-index="{{reduceIndex}}" data-item-index="{{itemIndex}}" data-day-index="{{dayIndex}}">
                <view class="stock-row {{expandedRows[itemIndex + '_' + dayIndex + '_' + reduceIndex] ? 'stock-row-active' : ''}}" bind:tap="showOne" data-index="{{reduceIndex}}" data-item-index="{{itemIndex}}" data-day-index="{{dayIndex}}">

                  <!-- 左侧信息区域 -->
                  <view class="stock-info-left">
                    <view class="stock-department">{{day.gbDepartmentName}}</view>
                    <view class="stock-date">{{tool.transferDateString(reduceDay.gbDgsrDate)}}</view>
                  </view>

                  <!-- 中间价格数量区域 -->
                  <view class="stock-info-center">
                    <block wx:if="{{reduceDay.gbDgsrType == 1}}">
                      <view class="stock-amount">{{reduceDay.gbDgsrProduceSubtotal}}元</view>
                      <view class="stock-quantity">{{reduceDay.gbDgsrProduceWeight}}{{disGoods.gbDgGoodsStandardname}}</view>
                      <view class="stock-type sales-type">售出</view>
                    </block>
                    <block wx:if="{{reduceDay.gbDgsrType == 2}}">
                      <view class="stock-amount">{{reduceDay.gbDgsrWasteSubtotal}}元</view>
                      <view class="stock-quantity">{{reduceDay.gbDgsrWasteWeight}}{{disGoods.gbDgGoodsStandardname}}</view>
                      <view class="stock-type waste-type">废弃</view>
                    </block>
                    <block wx:if="{{reduceDay.gbDgsrType == 3}}">
                      <view class="stock-amount">{{reduceDay.gbDgsrLossSubtotal}}元</view>
                      <view class="stock-quantity">{{reduceDay.gbDgsrLossWeight}}{{disGoods.gbDgGoodsStandardname}}</view>
                      <view class="stock-type loss-type">损耗</view>
                    </block>
                    <block wx:if="{{reduceDay.gbDgsrType == 4}}">
                      <view class="stock-amount">{{reduceDay.gbDgsrReturnSubtotal}}元</view>
                      <view class="stock-quantity">{{reduceDay.gbDgsrReturnWeight}}{{disGoods.gbDgGoodsStandardname}}</view>
                      <view class="stock-type return-type">退货</view>
                    </block>
                  </view>

                  <!-- 右侧箭头区域 -->
                  <view class="stock-info-right">
                    <view class="stock-arrow">
                      <image src="/images/arrow-right-3.png" mode="aspectFill" class="arrow-icon {{expandedRows[itemIndex + '_' + dayIndex + '_' + reduceIndex] ? 'expanded' : 'collapsed'}}" />
                    </view>
                  </view>

                </view>
              </view>

              <!-- 显示库存批次信息 -->
              <view wx:if="{{expandedRows[itemIndex + '_' + dayIndex + '_' + reduceIndex]}}" class="stock-info-card expandable-content expanded" bind:tap="toCost" hover-class="hover">

                <!-- 图标 + 标题 -->
                <view class="info-header">
                  <view class="flex-row-between" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                    <view class="flex-row">
                      <image src="../../../../images/gouwuche.png" class="info-header-icon"></image>
                      <text class="info-header-title">入库信息</text>
                    </view>
                    <view class="flex-row">
                      <image src="/images/search.png" mode="aspectFill" class="icon p-10" />
                    </view>
                  </view>

                </view>

                <view class="info-item">
                  <text class="info-label">入库时间</text>
                  <text class="info-value">{{reduceDay.gbDepartmentGoodsStockEntity.gbDgsDate}}</text>
                </view>
                <view class="info-item">
                  <text class="info-label">入库数量</text>
                  <text class="info-value">{{reduceDay.gbDepartmentGoodsStockEntity.gbDgsWeight}}{{disGoods.gbDgGoodsStandardname}}</text>
                </view>
                <view class="info-item">
                  <text class="info-label">入库单价</text>
                  <text class="info-value">{{reduceDay.gbDepartmentGoodsStockEntity.gbDgsPrice}}元/{{disGoods.gbDgGoodsStandardname}}</text>
                </view>
                <view class="info-item">
                  <text class="info-label">入库金额</text>
                  <text class="info-value info-value-amount">{{reduceDay.gbDepartmentGoodsStockEntity.gbDgsSubtotal}}元</text>
                </view>
                <view class="info-item">
                  <text class="info-label">现库存</text>
                  <text class="info-value">{{reduceDay.gbDepartmentGoodsStockEntity.gbDgsRestWeight}}{{disGoods.gbDgGoodsStandardname}}</text>
                </view>


                <view class="info-item {{reduceDay.gbDgsrType == 1 ? 'active' : ''}}">
                  <text class="info-label">销售</text>
                  <view class="flex-row">
                    <text class="info-value info-value-amount mr-10">{{reduceDay.gbDepartmentGoodsStockEntity.gbDgsProduceSubtotal}}元</text>
                    <text class="font-xs">({{reduceDay.gbDepartmentGoodsStockEntity.gbDgsProduceWeight}}{{disGoods.gbDgGoodsStandardname}})</text>
                  </view>
                </view>
                <view class="info-item  {{reduceDay.gbDgsrType == 3 ? 'active' : ''}}">
                  <text class="info-label">损耗</text>
                  <view class="flex-row">
                    <text class="info-value info-value-amount mr-10">{{reduceDay.gbDepartmentGoodsStockEntity.gbDgsLossSubtotal}}元</text>
                    <text class="font-xs">({{reduceDay.gbDepartmentGoodsStockEntity.gbDgsLossWeight}}{{disGoods.gbDgGoodsStandardname}})</text>
                  </view>
                </view>
                <view class="info-item  {{reduceDay.gbDgsrType == 2 ? 'active' : ''}}">
                  <text class="info-label">废弃</text>
                  <view class="flex-row">
                    <text class="info-value info-value-amount mr-10">{{reduceDay.gbDepartmentGoodsStockEntity.gbDgsWasteSubtotal}}元</text>
