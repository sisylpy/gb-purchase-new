                      <text class="info-label">供货商</text>
                      <text class="info-value">{{reduceDay.gbDepartmentGoodsStockEntity.purchaseGoodsEntity.nxJrdhSupplierEntity.nxJrdhsSupplierName}}</text>
                    </view>
                  </block>
                </view>
              </view>
              <!-- 采购批次的所有库存批次（包括业务的库存批次） -->
