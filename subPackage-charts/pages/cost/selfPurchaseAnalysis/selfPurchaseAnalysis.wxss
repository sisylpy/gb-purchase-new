page { background:#f1fbf8; color:#12213b; }
.page { min-height:100vh; padding:0 22rpx; box-sizing:border-box; background:linear-gradient(180deg,#f5fcff 0,#effaf7 100%); }
.date-toolbar{min-height:104rpx;margin:0 -22rpx;padding:10rpx 24rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #e5efed;background:#fff;box-sizing:border-box}.date-selector{display:flex;align-items:center;min-width:0}.date-selector-hover{opacity:.72}.date-calendar{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.date-calendar image{width:34rpx;height:34rpx}.date-copy{display:flex;flex-direction:column;min-width:0}.date-title{font-size:28rpx;line-height:34rpx;color:#26354b}.date-values{display:flex;align-items:center;margin-top:2rpx;color:#26354b;font-size:24rpx;line-height:32rpx;white-space:nowrap}.date-divider{padding:0 10rpx}
.banner { height:252rpx; border-radius:30rpx; overflow:hidden; background:#dff7ff; margin-bottom:14rpx; }
.banner-image { display:block; width:100%; height:100%; }
.summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin-bottom:16rpx}.summary-card{background:#fff;border-radius:24rpx;padding:18rpx 12rpx;text-align:left;min-width:0}.summary-card>text{font-size:23rpx;font-weight:600}.summary-icon{width:68rpx;height:68rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:12rpx auto}.summary-icon image{width:48rpx;height:48rpx}.yellow{background:#fff5d9}.green{background:#e6faf1}.blue{background:#e9f4ff}.pink{background:#fff0f1}.summary-value{font-size:31rpx;font-weight:800;white-space:nowrap}.summary-value .unit{font-size:19rpx;font-weight:500}.compare{font-size:18rpx;color:#8794a8;white-space:nowrap;margin-top:8rpx}.compare .up{color:#ff5963}.compare .down{color:#09ad78}.compare .flat{color:#8794a8}
.panel{background:#fff;border-radius:28rpx;margin:16rpx 0;padding:22rpx}.panel-head{display:flex;align-items:center;justify-content:space-between}.panel-title{font-size:30rpx;font-weight:800;display:flex;align-items:center}.panel-title image{width:38rpx;height:38rpx;margin-right:12rpx}.tabs{background:#f3f8f7;border-radius:24rpx;padding:4rpx}.tabs text{display:inline-block;padding:8rpx 20rpx;border-radius:20rpx;font-size:21rpx;color:#7b899d}.tabs text.active{background:#fff;color:#11af76;box-shadow:0 3rpx 10rpx rgba(39,104,87,.12)}.trend-chart{display:block;height:310rpx;width:100%;margin-top:10rpx}
.purchaser-scroll{width:100%;margin-top:22rpx}.purchaser-list{display:flex;gap:24rpx;min-width:max-content}.purchaser{width:112rpx;text-align:center;position:relative;display:flex;flex-direction:column;align-items:center}.purchaser>image,.avatar{width:86rpx;height:86rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:30rpx}.medal{position:absolute;left:5rpx;top:-8rpx;z-index:2;background:#ffbd32;color:#fff;border-radius:50%;width:32rpx;height:32rpx;line-height:32rpx}.purchaser>text{font-size:22rpx;margin-top:8rpx;max-width:112rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.purchaser .bold{font-size:22rpx;margin-top:5rpx;font-weight:700}.purchaser .small{font-size:18rpx;color:#8693a8;margin-top:4rpx}.mini-track{width:100%;height:10rpx;background:#edf1f5;border-radius:8rpx;margin-top:8rpx;overflow:hidden}.mini-track view{height:100%;border-radius:8rpx}
.category-body{display:flex;align-items:center;gap:16rpx;margin-top:16rpx}.category-chart{width:224rpx;height:240rpx;flex-shrink:0}.category-list{flex:1;display:grid;grid-template-columns:1fr;gap:12rpx;min-width:0}.category-item{min-height:84rpx;background:#f2faf7;border:1rpx solid #e5f2ed;border-radius:18rpx;padding:13rpx 15rpx;display:flex;align-items:center;min-width:0;box-sizing:border-box}.category-image{width:46rpx;height:46rpx;display:flex;align-items:center;justify-content:center;margin-right:10rpx;flex-shrink:0}.category-image image{width:44rpx;height:44rpx}.color-dot{width:24rpx;height:24rpx;border-radius:50%}.category-item>view:nth-child(2){display:flex;flex:1;flex-direction:column;min-width:0}.category-item text{font-size:24rpx;line-height:31rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.category-item .bold{margin-top:3rpx;font-size:25rpx;font-weight:800;color:#17233b}.category-item .percent{margin-left:12rpx;color:#16996d;font-size:23rpx;font-weight:800;flex-shrink:0}
.tips-panel{border-radius:28rpx;padding:22rpx;background:linear-gradient(110deg,#e7faeb,#f9fff7);margin-top:16rpx}.tip-list{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:18rpx}.tip{background:rgba(255,255,255,.85);border-radius:20rpx;padding:14rpx;display:flex;min-width:0}.tip-arrow{color:#10b678;font-size:32rpx;margin-right:8rpx}.tip>view:last-child{display:flex;flex-direction:column;min-width:0}.tip text,.tip .small{font-size:18rpx;color:#75889a}.tip .bold{font-size:21rpx;font-weight:700;margin:4rpx 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.empty{height:560rpx;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#617486}.empty image{width:220rpx;height:220rpx}.empty>text{font-weight:700;font-size:28rpx}.empty .small{font-size:22rpx;font-weight:400;margin-top:10rpx}.bottom-space{height:40rpx}
@media (max-width:360px){.summary-card{padding-left:8rpx;padding-right:8rpx}.summary-value{font-size:27rpx}.category-body{align-items:flex-start;gap:10rpx}.category-chart{width:196rpx;height:224rpx}.category-item{padding-left:10rpx;padding-right:10rpx}.category-item text{font-size:22rpx}.category-item .bold{font-size:23rpx}.category-item .percent{font-size:21rpx}}
