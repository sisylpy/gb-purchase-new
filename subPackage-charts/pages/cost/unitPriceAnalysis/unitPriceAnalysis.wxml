<wxs src="/wxs/format.wxs" module="tool" />
<view class="page"><back-navbar style="height:{{navBarHeight}}rpx" title="单价波动" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar><view style="height:{{navBarHeight}}rpx"></view>
<view class="date-toolbar"><view class="date-selector" bindtap="toDatePage" hover-class="date-selector-hover"><view class="date-calendar"><image src="/images/calender.png"></image></view><view class="date-copy"><view class="date-title">{{hanzi}}</view><view class="date-values" wx:if="{{startDate == stopDate}}"><text>{{tool.transferDateString(startDate)}}</text></view><view class="date-values" wx:else><text>{{tool.transferDateString(startDate)}}</text><text class="date-divider">-</text><text>{{tool.transferDateString(stopDate)}}</text></view></view></view><view class="date-actions"><picker mode="selector" range="{{goodsNames}}" value="{{goodsIndex}}" bindchange="changeGoods"><view class="date-filter-select">{{goodsNames[goodsIndex]}} ▾</view></picker><picker mode="selector" range="{{sourceNames}}" value="{{sourceIndex}}" bindchange="changeSource"><view class="date-filter-select">{{sourceNames[sourceIndex]}} ▾</view></picker><picker mode="selector" range="{{departmentNames}}" value="{{departmentIndex}}" bindchange="changeDepartment"><view class="date-filter-select">{{departmentNames[departmentIndex]}} ▾</view></picker></view></view>
<view class="banner"><image src="{{bannerUrl}}" mode="aspectFill"></image></view>
<view wx:if="{{hasData}}"><view class="summary"><view class="sum-card"><text>波动商品</text><view class="sum-icon green"><image src="{{iconRoot}}bar_chart.png"></image></view><text class="sum-value">{{summary.changed}}<text> 种</text></text><text class="sum-note">占全部商品 {{summary.changedRate}}%</text></view><view class="sum-card"><text>均价波动率</text><view class="sum-icon yellow">%</view><text class="sum-value">{{summary.average}}%</text><text class="sum-note">按商品平均波动</text></view><view class="sum-card"><text>上涨商品</text><view class="sum-icon red">↗</view><text class="sum-value">{{summary.rising}}<text> 种</text></text><text class="sum-note red-text">价格较上期上涨</text></view><view class="sum-card"><text>下降商品</text><view class="sum-icon blue">↓</view><text class="sum-value">{{summary.falling}}<text> 种</text></text><text class="sum-note green-text">价格较上期下降</text></view></view>
<view class="panel"><view class="head"><view class="title"><image src="{{iconRoot}}bar_chart.png"></image>价格波动趋势</view><view class="tabs"><text class="{{metric=='price'?'active':''}}" data-metric="price" bindtap="switchMetric">平均单价</text><text class="{{metric=='rate'?'active':''}}" data-metric="rate" bindtap="switchMetric">波动率</text></view></view><view class="chart-wrap"><ec-canvas id="priceTrendChart" canvas-id="unit-price-trend" ec="{{ecTrend}}" class="price-chart" style="display:block;width:100%;height:300rpx"></ec-canvas></view></view>
<view class="panel"><view class="head"><view class="title"><image src="{{iconRoot}}basket_green.png"></image>关注商品</view></view><view class="goods-grid"><view class="goods-card" wx:for="{{goods}}" wx:key="disGoodsId" bindtap="toGoods" data-item="{{item}}"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"></image><view wx:else class="placeholder">{{item.initial}}</view><view class="goods-main"><view><text class="goods-name">{{item.goodsName}}</text><text class="badge {{item.directionClass}}">{{item.statusText}}</text></view><text class="price">￥{{item.currentPrice}}<text>/{{item.standardName||'单位'}}</text></text><text class="change {{item.directionClass}}">较上期 {{item.directionClass=='up'?'+':item.directionClass=='down'?'-':''}}{{item.rateAbs}}%</text></view><view class="spark {{item.directionClass}}">⌁</view></view></view></view>
<view class="reminder"><view class="title"><image src="{{iconRoot}}light_bulb.png"></image>波动提醒</view><view class="reminder-list"><view class="reminder-card" wx:for="{{reminders}}" wx:key="type"><view class="reminder-icon">{{item.type=='up'?'↗':item.type=='down'?'↓':'≈'}}</view><text class="reminder-title">{{item.value}} {{item.title}}</text><text class="reminder-text">{{item.description}}</text></view></view></view>
<view class="tip"><image src="{{iconRoot}}light_bulb.png"></image><text>采购小贴士</text><view>关注价格波动，合理安排采购节奏，在保证新鲜的同时有效控制成本～</view></view></view>
<view wx:elif="{{!loading}}" class="empty"><image src="/subPackage-charts/images/purchase/keaibaicai.png" mode="aspectFit"></image><text>本期暂无单价数据</text><text>可切换日期或商品查看</text></view><view class="bottom"></view></view>
