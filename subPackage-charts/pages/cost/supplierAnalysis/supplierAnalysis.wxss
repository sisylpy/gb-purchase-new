page{background:#effbf8;color:#12213b}.page{min-height:100vh;background:linear-gradient(180deg,#f4fdff 0,#effbf8 100%)}
.date-toolbar{min-height:104rpx;padding:10rpx 24rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #e5efed;background:#fff;box-sizing:border-box}.date-selector{display:flex;align-items:center;min-width:0}.date-selector-hover{opacity:.72}.date-calendar{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.date-calendar image{width:34rpx;height:34rpx}.date-copy{display:flex;flex-direction:column;min-width:0}.date-title{font-size:28rpx;line-height:34rpx;color:#26354b}.date-values{display:flex;align-items:center;margin-top:2rpx;color:#26354b;font-size:24rpx;line-height:32rpx;white-space:nowrap}.date-divider{padding:0 10rpx}
.banner{height:180rpx;margin:7rpx 24rpx 15rpx;border-radius:27rpx;padding:22rpx 25rpx;box-sizing:border-box;background:linear-gradient(115deg,#d8fbe9,#b8f3dc 52%,#e9faf0);position:relative;overflow:hidden}.banner-title{display:block;white-space:pre-line;font-size:34rpx;line-height:1.35;font-weight:900;color:#087a57}.banner-note{font-size:20rpx;color:#4b8f77}.banner-scene{position:absolute;right:90rpx;bottom:5rpx}.truck{font-size:63rpx}.seller{font-size:80rpx}.vegetables{font-size:35rpx;position:absolute;bottom:0;right:-30rpx}.banner-bubble{position:absolute;right:11rpx;top:20rpx;background:#fff;border-radius:42rpx;padding:13rpx 14rpx;white-space:pre-line;text-align:center;color:#07945f;font-size:21rpx;font-weight:800;transform:rotate(-5deg)}
.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:13rpx;padding:0 24rpx 15rpx}.summary-card{height:122rpx;background:#fff;border-radius:22rpx;padding:16rpx;display:flex;align-items:center;box-sizing:border-box;box-shadow:0 3rpx 12rpx rgba(43,99,87,.05)}.summary-icon{width:74rpx;height:74rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;margin-right:16rpx;font-size:31rpx;font-weight:800}.summary-icon image{width:43rpx;height:43rpx}.green{background:#e5faf2;color:#0db77a}.orange{background:#fff4df}.red{background:#fff0f2;color:#f35768}.blue{background:#eaf5ff;color:#368eed}.summary-card>view:last-child{display:flex;flex-direction:column}.summary-card text:first-child{font-size:23rpx}.summary-value{font-size:32rpx!important;font-weight:900;margin:4rpx 0}.summary-value text{font-size:22rpx!important}.compare{font-size:20rpx}.up{color:#f05361}.down{color:#08a875}.stable{color:#8090a3}
.panel{margin:0 24rpx 15rpx;background:#fff;border-radius:24rpx;padding:20rpx;box-sizing:border-box}.panel-title{display:flex;align-items:center;font-size:30rpx;font-weight:900;margin-bottom:18rpx}.panel-title image{width:36rpx;height:36rpx;margin-right:11rpx}.supplier-card{border:1rpx solid #e8f2ef;border-radius:24rpx;background:linear-gradient(145deg,#fff 0%,#f7fcfa 100%);padding:20rpx;box-sizing:border-box;margin-bottom:16rpx;box-shadow:0 6rpx 20rpx rgba(30,99,79,.07)}.supplier-card:last-child{margin-bottom:0}.supplier-head{display:flex;align-items:center;min-width:0}.rank{width:38rpx;height:38rpx;line-height:38rpx;text-align:center;background:#d9e2ed;color:#53647b;border-radius:50%;font-size:22rpx;font-weight:900;margin-right:12rpx;flex-shrink:0}.rank-1 .rank{background:#ffc52f;color:#8c5900}.rank-2 .rank{background:#cad7e8}.rank-3 .rank{background:#f0a44c;color:#fff}.supplier-avatar{width:82rpx;height:82rpx;border-radius:50%;margin-right:16rpx;flex-shrink:0;border:4rpx solid #e8faf3;background:#eef8f5;box-sizing:border-box}.supplier-avatar-fallback{display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#c8f5e2,#8ce1bd);color:#087c58;font-size:34rpx;font-weight:900}.supplier-main{flex:1;min-width:0;display:flex;flex-direction:column}.supplier-name{font-size:32rpx;line-height:42rpx;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.supplier-note{font-size:22rpx;line-height:30rpx;color:#718298;margin-top:5rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.share-badge{min-width:116rpx;margin-left:12rpx;border-radius:18rpx;padding:10rpx 12rpx;background:#e9faf3;display:flex;flex-direction:column;align-items:center;box-sizing:border-box}.share-badge text:first-child{font-size:19rpx;color:#667a73}.share-badge text:last-child{font-size:27rpx;line-height:34rpx;color:#08a875;font-weight:900;margin-top:2rpx}.supplier-metrics{display:grid;grid-template-columns:1.35fr 1fr 1fr;gap:10rpx;margin-top:20rpx}.supplier-metric{min-width:0;border-radius:18rpx;padding:14rpx 10rpx;background:#f3f7fb;display:flex;flex-direction:column;align-items:center;box-sizing:border-box}.supplier-metric>text:first-child{font-size:22rpx;line-height:30rpx;color:#708096}.supplier-metric>text:nth-child(2){font-size:31rpx;line-height:42rpx;font-weight:900;color:#13223c;margin-top:4rpx;white-space:nowrap}.supplier-metric.amount{background:#fff7e8}.supplier-metric.amount>text:nth-child(2){color:#c77c0c}.supplier-metric.orders{background:#edf9f5}.supplier-metric.orders>text:nth-child(2){color:#078f66}.supplier-metric.share{background:#eef5ff}.supplier-metric.share>text:nth-child(2){color:#2677d8}.metric-unit{font-size:21rpx}.share-track{height:9rpx;background:#e5eeec;border-radius:6rpx;margin-top:14rpx;overflow:hidden}.share-track view{height:100%;background:linear-gradient(90deg,#27c78d,#0baa73);border-radius:6rpx}.settle-title{font-size:22rpx;line-height:30rpx;color:#63758a;margin:16rpx 0 9rpx}.settle-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx}.settle-row view{border-radius:17rpx;padding:11rpx 5rpx;display:flex;flex-direction:column;align-items:center;box-sizing:border-box}.settle-row view text:first-child{font-size:20rpx;line-height:28rpx}.settle-row view text:last-child{font-size:25rpx;line-height:34rpx;font-weight:800;margin-top:2rpx;white-space:nowrap}.unsettled{background:#fff0f2;color:#ef5263}.pending{background:#fff5df;color:#bd7512}.settled{background:#e7faf1;color:#079d6c}
.insight-list{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx}.insight{min-height:105rpx;border-radius:17rpx;padding:13rpx;display:flex;align-items:center;box-sizing:border-box}.insight-icon{font-size:30rpx;margin-right:9rpx;color:#12ad77}.insight view{display:flex;flex-direction:column}.insight view text:first-child{font-size:23rpx;font-weight:800}.insight view text:last-child{font-size:18rpx;color:#65768b;margin-top:7rpx}.green-bg{background:#eafaf4}.orange-bg{background:#fff6e7}.blue-bg{background:#eef7ff}.tip{margin:0 24rpx;background:linear-gradient(90deg,#e5faf0,#f4fff8);height:92rpx;border-radius:21rpx;display:flex;align-items:center;padding:0 17rpx;box-sizing:border-box}.tip image{width:40rpx;height:40rpx;margin-right:10rpx}.tip>text{font-size:21rpx;color:#277a61;flex:1}.tip view{white-space:pre-line;font-size:18rpx;color:#08a970;transform:rotate(-6deg);font-weight:800}.empty{height:500rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:28rpx;font-weight:800;color:#607187}.empty image{width:210rpx;height:210rpx}.empty-note{font-size:22rpx;font-weight:400;margin-top:8rpx}.bottom{height:35rpx}
.banner-bubble text,.tip view text{display:block}
