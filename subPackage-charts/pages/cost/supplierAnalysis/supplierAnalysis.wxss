page{background:#effbf8;color:#12213b}.page{min-height:100vh;background:linear-gradient(180deg,#f4fdff 0,#effbf8 100%)}
.filter-row{height:84rpx;padding:10rpx 24rpx;display:flex;align-items:center;gap:13rpx;box-sizing:border-box}.date-pill{height:64rpx;min-width:365rpx;max-width:440rpx;padding:0 18rpx;background:#fff;border-radius:34rpx;display:flex;align-items:center;box-shadow:0 4rpx 15rpx rgba(37,91,83,.08);box-sizing:border-box}.date-pill image{width:32rpx;height:32rpx;margin-right:10rpx}.date-name{font-size:27rpx;font-weight:800;margin-right:13rpx}.date-range{font-size:23rpx;color:#60718a;flex:1;white-space:nowrap}.period{height:58rpx;line-height:58rpx;padding:0 23rpx;border-radius:31rpx;background:#f5f9fa;color:#65758d;font-size:24rpx;white-space:nowrap}.period.active{background:#0cbd78;color:#fff;font-weight:700}
.banner{height:180rpx;margin:7rpx 24rpx 15rpx;border-radius:27rpx;padding:22rpx 25rpx;box-sizing:border-box;background:linear-gradient(115deg,#d8fbe9,#b8f3dc 52%,#e9faf0);position:relative;overflow:hidden}.banner-title{display:block;white-space:pre-line;font-size:34rpx;line-height:1.35;font-weight:900;color:#087a57}.banner-note{font-size:20rpx;color:#4b8f77}.banner-scene{position:absolute;right:90rpx;bottom:5rpx}.truck{font-size:63rpx}.seller{font-size:80rpx}.vegetables{font-size:35rpx;position:absolute;bottom:0;right:-30rpx}.banner-bubble{position:absolute;right:11rpx;top:20rpx;background:#fff;border-radius:42rpx;padding:13rpx 14rpx;white-space:pre-line;text-align:center;color:#07945f;font-size:21rpx;font-weight:800;transform:rotate(-5deg)}
.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:13rpx;padding:0 24rpx 15rpx}.summary-card{height:122rpx;background:#fff;border-radius:22rpx;padding:16rpx;display:flex;align-items:center;box-sizing:border-box;box-shadow:0 3rpx 12rpx rgba(43,99,87,.05)}.summary-icon{width:74rpx;height:74rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;margin-right:16rpx;font-size:31rpx;font-weight:800}.summary-icon image{width:43rpx;height:43rpx}.green{background:#e5faf2;color:#0db77a}.orange{background:#fff4df}.red{background:#fff0f2;color:#f35768}.blue{background:#eaf5ff;color:#368eed}.summary-card>view:last-child{display:flex;flex-direction:column}.summary-card text:first-child{font-size:23rpx}.summary-value{font-size:32rpx!important;font-weight:900;margin:4rpx 0}.summary-value text{font-size:22rpx!important}.compare{font-size:20rpx}.up{color:#f05361}.down{color:#08a875}.stable{color:#8090a3}
.panel{margin:0 24rpx 15rpx;background:#fff;border-radius:24rpx;padding:18rpx;box-sizing:border-box}.panel-title{display:flex;align-items:center;font-size:29rpx;font-weight:900;margin-bottom:15rpx}.panel-title image{width:35rpx;height:35rpx;margin-right:11rpx}.supplier-row{min-height:158rpx;border-radius:20rpx;background:#f9fcfb;padding:15rpx 13rpx 48rpx;box-sizing:border-box;margin-bottom:12rpx;display:flex;align-items:center;position:relative}.rank{width:34rpx;height:34rpx;line-height:34rpx;text-align:center;background:#d9e2ed;color:#53647b;border-radius:50%;font-size:21rpx;font-weight:900;margin-right:7rpx}.rank-1 .rank{background:#ffc52f;color:#8c5900}.rank-2 .rank{background:#cad7e8}.rank-3 .rank{background:#f0a44c;color:#fff}.shop{width:64rpx;height:64rpx;border-radius:50%;background:#e5faf1;display:flex;align-items:center;justify-content:center;font-size:40rpx;margin-right:10rpx}.supplier-main{width:180rpx;min-width:0;display:flex;flex-direction:column}.supplier-name{font-size:27rpx;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.supplier-note{font-size:18rpx;color:#78889c;margin:5rpx 0}.share-track{height:6rpx;background:#e5eeec;border-radius:4rpx}.share-track view{height:100%;background:#20c78b;border-radius:4rpx}.supplier-amount{width:125rpx;display:flex;flex-direction:column;align-items:center}.supplier-amount text:first-child{font-size:27rpx;font-weight:900}.supplier-amount text:last-child,.orders text:last-child{font-size:18rpx;color:#77879a}.share-ring{width:68rpx;height:68rpx;border:8rpx solid #2cc88d;border-right-color:#e4ecea;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;box-sizing:border-box}.share-ring text:first-child{font-size:18rpx;font-weight:900}.share-ring text:last-child{font-size:15rpx;color:#8090a1}.orders{width:78rpx;display:flex;flex-direction:column;align-items:center}.orders image{width:26rpx;height:26rpx}.orders text:nth-child(2){font-size:23rpx;font-weight:800}.settle-row{position:absolute;left:95rpx;right:13rpx;bottom:10rpx;display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx}.settle-row text{text-align:center;border-radius:17rpx;padding:6rpx 3rpx;font-size:18rpx}.unsettled{background:#fff0f2;color:#ef5263}.pending{background:#fff5df;color:#c68020}.settled{background:#e7faf1;color:#079d6c}
.insight-list{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx}.insight{min-height:105rpx;border-radius:17rpx;padding:13rpx;display:flex;align-items:center;box-sizing:border-box}.insight-icon{font-size:30rpx;margin-right:9rpx;color:#12ad77}.insight view{display:flex;flex-direction:column}.insight view text:first-child{font-size:23rpx;font-weight:800}.insight view text:last-child{font-size:18rpx;color:#65768b;margin-top:7rpx}.green-bg{background:#eafaf4}.orange-bg{background:#fff6e7}.blue-bg{background:#eef7ff}.tip{margin:0 24rpx;background:linear-gradient(90deg,#e5faf0,#f4fff8);height:92rpx;border-radius:21rpx;display:flex;align-items:center;padding:0 17rpx;box-sizing:border-box}.tip image{width:40rpx;height:40rpx;margin-right:10rpx}.tip>text{font-size:21rpx;color:#277a61;flex:1}.tip view{white-space:pre-line;font-size:18rpx;color:#08a970;transform:rotate(-6deg);font-weight:800}.empty{height:500rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:28rpx;font-weight:800;color:#607187}.empty image{width:210rpx;height:210rpx}.empty-note{font-size:22rpx;font-weight:400;margin-top:8rpx}.bottom{height:35rpx}
.banner-bubble text,.tip view text{display:block}
