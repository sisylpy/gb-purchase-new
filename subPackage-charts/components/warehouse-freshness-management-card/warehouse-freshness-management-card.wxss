.wfm-card{margin-top:24rpx;padding:28rpx 24rpx;background:#fff;border:1rpx solid #eaeaea;border-radius:20rpx}.wfm-head,.wfm-basis,.wfm-row,.wfm-standards{display:flex;flex-direction:column;gap:8rpx}.wfm-title{font-size:32rpx;font-weight:700}.wfm-subtitle,.wfm-basis,.wfm-row{font-size:23rpx;color:#777}.wfm-basis{margin:16rpx 0;padding:14rpx;background:#f6f8fa;border-radius:12rpx}.wfm-warning{margin-bottom:12rpx;padding:14rpx;border-radius:12rpx;background:#fff5e8;color:#9a5d21;font-size:23rpx}.wfm-empty{padding:32rpx 0;text-align:center;color:#aaa}.wfm-row{padding:18rpx 0;border-top:1rpx solid #f0f0f0}.wfm-main{display:flex;justify-content:space-between}.wfm-name{font-size:27rpx;color:#222;font-weight:600}.wfm-state{color:#d65b32}.wfm-standards{margin-top:8rpx;color:#555}
