/* ========== 卡片容器 ========== */
.wwr-card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #eaeaea;
  box-sizing: border-box;
}

/* ========== 标题区 ========== */
.wwr-header {
  margin-bottom: 4rpx;
}

.wwr-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  line-height: 1.3;
}

.wwr-subtitle {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
  line-height: 1.4;
}
.wwr-basis{display:flex;flex-direction:column;gap:4rpx;margin-top:14rpx;padding:12rpx;background:#f8f5f0;border-radius:10rpx;font-size:22rpx;color:#8a6741}

/* ========== 概览统计 ========== */
.wwr-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.wwr-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
}

.wwr-stat-item--due {
  background: #fef5f5;
}

.wwr-stat-item--warning {
  background: #fff8f0;
}

.wwr-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.wwr-stat-item--due .wwr-stat-num {
  color: #e02020;
}

.wwr-stat-item--warning .wwr-stat-num {
  color: #e8632d;
}

.wwr-stat-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
}

/* ========== 空数据 ========== */
.wwr-empty {
  padding: 48rpx 0;
  text-align: center;
}
.wwr-empty-text {
  font-size: 26rpx;
  color: #bbb;
}

/* ========== 紧凑行列表 ========== */
.wwr-list {
  margin-top: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #f0f0f0;
}

.wwr-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f7f7f7;
}

.wwr-row:last-child {
  border-bottom: none;
}

.wwr-row--due {
  background: #fef5f5;
}

.wwr-row-name {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 500;
  flex-shrink: 0;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wwr-row-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.wwr-row-stock {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.wwr-row-batch {
  font-size: 22rpx;
  color: #aaa;
}

.wwr-row-date {
  font-size: 22rpx;
  color: #999;
}

.wwr-row-deadline {
  font-size: 24rpx;
  color: #555;
}

.wwr-date--overdue {
  color: #e02020;
  font-weight: 600;
}

/* 风险标签 */
.wwr-risk-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-weight: 500;
  white-space: nowrap;
}

.wwr-tier--due {
  background: #fde8e8;
  color: #e02020;
}

.wwr-tier--warning {
  background: #fff3e0;
  color: #e8632d;
}

/* ========== 底部栏 ========== */
.wwr-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f5f5f5;
}

.wwr-footer-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.wwr-footer-text {
  font-size: 22rpx;
  color: #999;
}

.wwr-footer-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.wwr-footer-tag--due {
  background: #fde8e8;
  color: #e02020;
}

.wwr-footer-tag--warning {
  background: #fff3e0;
  color: #e8632d;
}

.wwr-footer-right {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 18rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
}

.wwr-expand-text { font-size: 23rpx; color: #4a90d9; }
.wwr-expand-arrow { font-size: 20rpx; color: #4a90d9; }
