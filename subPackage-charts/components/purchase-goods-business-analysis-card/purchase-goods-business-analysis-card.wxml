<view class="biz-card biz-pba" wx:if="{{visible}}">

  <!-- ===== 卡片头部 ===== -->
  <view class="pba-header">
    <view class="pba-header-left">
      <text class="pba-header-icon-text">📊</text>
      <text class="pba-header-title">{{title}}</text>
    </view>
    <view class="pba-header-right" wx:if="{{subtitle}}">
      <text class="pba-header-date">{{subtitle}}</text>
    </view>
  </view>

  <!-- ===== 商品与库存 ===== -->
  <view class="pba-goods-row">
    <view class="pba-goods-info">
      <view class="pba-goods-name-row">
        <text class="pba-goods-name">{{goodsName}}</text>
      </view>
    </view>
    <view class="pba-stock-card">
      <view class="pba-stock-head">
        <text class="pba-stock-icon">📦</text>
        <text class="pba-stock-label">当前库存</text>
      </view>
      <view class="pba-stock-value-row">
        <text class="pba-stock-num">{{stockQty}}</text>
        <text class="pba-stock-unit" wx:if="{{stockUnit}}">{{stockUnit}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 三列核心指标 ===== -->
  <view class="pba-metrics-row">
    <!-- 采购量（单据数量，无单位码） -->
    <view class="pba-metric-col">
      <view class="pba-metric-icon-wrap pba-icon-green">
        <text class="pba-metric-icon">🛒</text>
      </view>
      <view class="pba-metric-body">
        <text class="pba-metric-label">采购量</text>
        <view class="pba-metric-value-row">
          <text class="pba-metric-value pba-val-green">{{purchaseQty}}</text>
        </view>
        <text class="pba-metric-sub">{{purchaseCount}} 次采购 · 单据数量（无单位码）</text>
      </view>
    </view>
    <!-- 理论消耗（base 单位） -->
    <view class="pba-metric-col">
      <view class="pba-metric-icon-wrap pba-icon-orange">
        <text class="pba-metric-icon">📈</text>
      </view>
      <view class="pba-metric-body">
        <text class="pba-metric-label">理论消耗</text>
        <view class="pba-metric-value-row">
          <text class="pba-metric-value pba-val-orange">{{theoryQty}}</text>
          <text class="pba-metric-unit" wx:if="{{theoryUnit}}">{{theoryUnit}}</text>
        </view>
      </view>
    </view>
    <!-- 库存可支撑（仅在预测完整时展示天数） -->
    <view class="pba-metric-col">
      <view class="pba-metric-icon-wrap pba-icon-purple">
        <text class="pba-metric-icon">🕐</text>
      </view>
      <view class="pba-metric-body">
        <text class="pba-metric-label">库存可支撑</text>
        <view class="pba-metric-value-row">
          <text class="pba-metric-value pba-val-purple {{coverAvailable ? '' : 'pba-val-dim'}}">{{coverAvailable ? coverDaysText : coverBadgeText}}</text>
          <text class="pba-metric-unit" wx:if="{{coverAvailable}}">天</text>
        </view>
        <text class="pba-metric-sub" wx:if="{{stockNote}}">{{stockNote}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 用量匹配（采购量无单位码，与理论消耗不可同单位比较） ===== -->
  <view class="pba-panels-row" wx:if="{{purchaseAmount || theoryQty || purchaseQty}}">
    <view class="pba-panel pba-panel-left">
      <view class="pba-panel-head">
        <text class="pba-panel-icon">🛍️</text>
        <text class="pba-panel-title">采购金额</text>
      </view>
      <view class="pba-source-row">
        <view class="pba-source-item">
          <text class="pba-source-name">采购总金额</text>
          <text class="pba-source-val pba-src-green">￥{{purchaseAmount}}</text>
        </view>
      </view>
    </view>
    <view class="pba-panel pba-panel-right">
      <view class="pba-panel-head">
        <text class="pba-panel-icon">⚖️</text>
        <text class="pba-panel-title">用量匹配</text>
      </view>
      <view class="pba-match-row">
        <view class="pba-match-item">
          <text class="pba-match-name">实际采购</text>
          <text class="pba-match-val pba-mat-blue">{{purchaseQty}}</text>
          <text class="pba-match-unit">单据</text>
        </view>
        <view class="pba-match-item">
          <text class="pba-match-name">理论消耗</text>
          <text class="pba-match-val pba-mat-dark">{{theoryQty}}</text>
          <text class="pba-match-unit">{{theoryUnit}}</text>
        </view>
        <view class="pba-match-item">
          <text class="pba-match-name">采购/理论</text>
          <view class="pba-match-ratio-row">
            <text class="pba-match-val pba-mat-gray">{{ratioDisplay}}</text>
            <text class="pba-tag pba-tag-blue-sm" wx:if="{{ratioTag}}">{{ratioTag}}</text>
          </view>
        </view>
      </view>
      <text class="pba-theory-note" wx:if="{{theoryNote}}">{{theoryNote}}</text>
    </view>
  </view>

  <!-- ===== 关联菜品 ===== -->
  <view class="pba-dish-section" wx:if="{{dishRows.length > 0}}">
    <view class="pba-section-head">
      <text class="pba-section-icon">🔗</text>
      <text class="pba-section-title">关联菜品（原料日消耗 = 每份用量 × 日均销量）</text>
    </view>
    <!-- 表头 -->
    <view class="pba-table-head">
      <text class="pba-th pba-th-dish">菜品名称</text>
      <text class="pba-th pba-th-recipe">每份用量</text>
      <text class="pba-th pba-th-sales">周期销量</text>
      <text class="pba-th pba-th-daily">日均销量</text>
      <text class="pba-th pba-th-days">原料日消耗</text>
    </view>
    <!-- 表体 -->
    <view class="pba-table-body">
      <view class="pba-tr {{item.rowClass}}" wx:for="{{dishRows}}" wx:key="dishId">
        <view class="pba-td pba-td-dish">
          <text class="pba-dish-cell-name">{{item.dishName}}</text>
          <text class="pba-row-note" wx:if="{{item.note}}">{{item.note}}</text>
        </view>
        <text class="pba-td pba-td-recipe">{{item.recipeTxt}}</text>
        <text class="pba-td pba-td-sales">{{item.salesTxt}}</text>
        <text class="pba-td pba-td-daily">{{item.dailyTxt}}</text>
        <text class="pba-td pba-td-days">{{item.usageTxt}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 判断信号标签 ===== -->
  <view class="pba-signal-list" wx:if="{{signalTexts.length > 0}}">
    <view class="pba-signal-pill pba-signal-info" wx:for="{{signalTexts}}" wx:key="*this">
      <text class="pba-signal-prefix">ℹ️</text>
      <text class="pba-signal-text">{{item}}</text>
    </view>
  </view>

  <!-- ===== 能力边界提示 ===== -->
  <view class="pba-gap-list" wx:if="{{gapTexts.length > 0}}">
    <text class="pba-gap-item" wx:for="{{gapTexts}}" wx:key="*this">💡 {{item}}</text>
  </view>

</view>
