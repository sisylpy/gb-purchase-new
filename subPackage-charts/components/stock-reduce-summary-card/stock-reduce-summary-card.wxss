/* stock-reduce-summary-card — 出库/核销汇总卡（紧凑） */
.srs-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #eef0f2;
  padding: 24rpx 24rpx;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
}

/* 第一层：业务名称 */
.srs-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.srs-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.srs-entity {
  font-size: 22rpx;
  color: #6b7280;
}

/* 第二层：金额（最醒目） */
.srs-amount {
  font-size: 48rpx;
  font-weight: 800;
  color: #059669;
  line-height: 1.15;
  letter-spacing: 0.5rpx;
}

.srs-amount--empty {
  color: #9ca3af;
}

.srs-unavailable {
  font-size: 28rpx;
  font-weight: 600;
  color: #ea580c;
  line-height: 1.3;
}

/* 第三层：时间范围 · 门店范围 */
.srs-scope {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
  line-height: 1.4;
}

/* 补充事实行 */
.srs-rows {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f2f4;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.srs-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.srs-row-label {
  font-size: 24rpx;
  color: #6b7280;
}

.srs-row-amount {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
}
