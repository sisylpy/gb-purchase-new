/* ========== 采购异常卡片 ========== */
.pa-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 24rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* ========== 头部 ========== */
.pa-header {
  margin-bottom: 24rpx;
}

.pa-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.pa-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
}

.pa-time {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}

.pa-scope {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

/* ========== 分区标签 ========== */
.pa-section {
  margin-bottom: 24rpx;
}

.pa-section-label {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

.pa-section-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fa5151;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.pa-section-dot--secondary {
  background: #ff9900;
}

.pa-section-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
}

/* ========== 行外层容器 ========== */
.pa-row-item {
  border-radius: 14rpx;
  padding: 20rpx 22rpx 18rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.pa-row-item:last-child {
  margin-bottom: 0;
}

.pa-row-item--focus {
  background: rgba(250, 81, 81, 0.04);
  border: 1rpx solid rgba(250, 81, 81, 0.12);
}

.pa-row-item--secondary {
  background: #fafafa;
  border: 1rpx solid #f0f0f0;
}

/* ========== 行头部：商品名 + 变动标签 ========== */
.pa-row-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.pa-row-goods {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.5;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pa-row-goods--dim {
  font-weight: 500;
  color: #666;
}

/* 变动标签 */
.pa-row-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.6;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.pa-badge--warn {
  background: rgba(250, 81, 81, 0.12);
  color: #fa5151;
}

.pa-badge--ok {
  background: rgba(255, 153, 0, 0.1);
  color: #ff9900;
}

.pa-badge--neutral {
  background: #f5f5f5;
  color: #999;
}

/* ========== 价格对比行 ========== */
.pa-row-price-cmp {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 14rpx;
}

.pa-price-old {
  font-size: 26rpx;
  color: #bbb;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Mono', 'Menlo', monospace;
}

.pa-price-arrow {
  font-size: 24rpx;
  color: #ccc;
  margin: 0 12rpx;
}

.pa-price-new {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Mono', 'Menlo', monospace;
}

/* ========== 批次对比 ========== */
.pa-batch-compare {
  margin-top: 6rpx;
}

.pa-batch-label {
  font-size: 22rpx;
  color: #bbb;
  margin-bottom: 10rpx;
  padding-left: 2rpx;
}

.pa-batch-cols {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.pa-batch-col {
  flex: 1;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
}

.pa-batch-col--current {
  background: #f0faf5;
  border: 1rpx solid #d4f0e0;
}

.pa-batch-col--prev {
  background: #f5f5f5;
  border: 1rpx solid #e8e8e8;
}

.pa-batch-role {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #666;
  margin-bottom: 6rpx;
}

.pa-batch-col--current .pa-batch-role {
  color: #2bb07a;
}

.pa-batch-date {
  display: block;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

.pa-batch-qty,
.pa-batch-price,
.pa-batch-amount {
  display: block;
  font-size: 24rpx;
  color: #555;
  line-height: 1.6;
}

.pa-batch-price {
  font-family: -apple-system, BlinkMacSystemFont, 'SF Mono', 'Menlo', monospace;
}

.pa-batch-amount {
  font-weight: 500;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Mono', 'Menlo', monospace;
}

.pa-batch-source {
  display: block;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ========== 库存耗尽日期 ========== */
.pa-row-expire {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #e8e8e8;
}

.pa-expire-text {
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

/* ========== 空态 ========== */
.pa-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 24rpx;
}

.pa-empty-text {
  font-size: 26rpx;
  color: #999;
}
