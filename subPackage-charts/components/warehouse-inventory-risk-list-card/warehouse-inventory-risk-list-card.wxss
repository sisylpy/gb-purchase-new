.wir-card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #eaeaea;
  box-sizing: border-box;
}

/* 头部 */
.wir-header {
  margin-bottom: 4rpx;
}

.wir-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  line-height: 1.3;
}

.wir-subtitle {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
  line-height: 1.4;
}

/* 摘要 */
.wir-summary {
  background: #f5f7fa;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
}

.wir-summary-text {
  font-size: 24rpx;
  color: #555;
  line-height: 1.6;
}

/* ========== 紧凑行列表 ========== */
.wir-list {
  margin-top: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #f0f0f0;
}

.wir-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f7f7f7;
}

.wir-row:last-child {
  border-bottom: none;
}

.wir-row-name {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 500;
  flex-shrink: 0;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wir-row-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.wir-row-stock {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.wir-row-daily {
  font-size: 22rpx;
  color: #999;
}

.wir-row-idle {
  font-size: 22rpx;
  color: #e8632d;
  background: #fff3e0;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.wir-row-support {
  font-size: 22rpx;
  color: #2e7d32;
  background: #e8f5e9;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

/* 风险标签 */
.wir-risk-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-weight: 500;
  white-space: nowrap;
}

.wir-risk-high {
  background: #fde8e8;
  color: #e02020;
}

.wir-risk-medium {
  background: #fef0e6;
  color: #e8632d;
}

.wir-risk-low {
  background: #e8f8e8;
  color: #389e0d;
}

/* 记入工作记录按钮 */
.wir-record-btn {
  font-size: 24rpx;
  flex-shrink: 0;
}
