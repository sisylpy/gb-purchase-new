<view class="wir-card" wx:if="{{visible}}">
  <!-- 头部 -->
  <view class="wir-header">
    <text class="wir-title">{{title}}</text>
    <text class="wir-subtitle">{{subtitle}}</text>
  </view>

  <!-- 摘要描述 -->
  <view class="wir-summary" wx:if="{{narrative}}">
    <text class="wir-summary-text">{{narrative}}</text>
  </view>

  <!-- 紧凑列表 -->
  <view class="wir-list" wx:if="{{riskItems.length > 0}}">
    <view
      class="wir-row"
      wx:for="{{riskItems}}"
      wx:key="*this"
    >
      <text class="wir-row-name">{{item.goodsName}}</text>
      <view class="wir-row-right">
        <text class="wir-row-stock">{{item.restWeight}}{{item.weightUnit}}</text>
        <text class="wir-row-daily" wx:if="{{item.dailyOutboundWeight > 0}}">日均{{item.dailyOutboundWeight}}{{item.weightUnit}}</text>
        <text class="wir-row-idle" wx:if="{{item.periodOutboundWeight == 0 && item.dailyOutboundWeight == 0}}">近期无动销</text>
        <text class="wir-row-support" wx:if="{{item.hasSupportDays}}">可支撑{{item.supportDays}}天</text>
        <text class="wir-risk-tag {{item.riskLevelClass}}" wx:if="{{item.hasRiskLevel}}">{{item.riskLevelLabel}}</text>
        <!-- 行级「记入工作记录」按钮（非只读模式显示） -->
        <text class="wir-record-btn" wx:if="{{!readonly}}" catchtap="onRecordItem" data-index="{{index}}">📝</text>
      </view>
    </view>
  </view>
</view>
