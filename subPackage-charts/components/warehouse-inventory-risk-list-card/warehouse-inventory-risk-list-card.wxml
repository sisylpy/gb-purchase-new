<view class="wir-card" wx:if="{{visible}}">
  <!-- 头部 -->
  <view class="wir-header">
    <text class="wir-title">{{title}}</text>
    <text class="wir-subtitle">{{subtitle}}</text>
  </view>

  <!-- 摘要描述 -->
  <view class="wir-summary" wx:if="{{narrative}}">
    <text class="wir-summary-text">{{narrative}}</text>
  </view>

  <!-- 风险项列表 -->
  <view class="wir-list">
    <view
      class="wir-item"
      wx:for="{{riskItems}}"
      wx:key="goodsName"
    >
      <view class="wir-item-head">
        <text class="wir-item-name">{{item.goodsName}}</text>
        <text class="wir-item-level {{item.riskLevelClass}}">{{item.riskLevelLabel}}</text>
      </view>

      <view class="wir-item-stats">
        <view class="wir-stat">
          <text class="wir-stat-label">剩余库存</text>
          <text class="wir-stat-value">{{item.restWeight}} {{item.weightUnit}}</text>
        </view>
        <view class="wir-stat">
          <text class="wir-stat-label">区间出库</text>
          <text class="wir-stat-value">{{item.periodOutboundWeight}} {{item.weightUnit}}</text>
        </view>
        <view class="wir-stat">
          <text class="wir-stat-label">日均出库</text>
          <text class="wir-stat-value">{{item.dailyOutboundWeight}} {{item.weightUnit}}</text>
        </view>
      </view>

      <view class="wir-item-reason" wx:if="{{item.riskReason}}">
        <text class="wir-reason-label">原因：</text>
        <text class="wir-reason-text">{{item.riskReason}}</text>
      </view>
    </view>
  </view>
</view>
