/* ========== 卡片容器 ========== */
.dicd-card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #eaeaea;
  box-sizing: border-box;
}

.dicd-card--empty {
  padding: 48rpx 24rpx;
  text-align: center;
}

.dicd-empty-text {
  font-size: 26rpx;
  color: #bbb;
}

/* ========== 头部 ========== */
.dicd-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.dicd-header-left {
  flex: 1;
  min-width: 0;
}

.dicd-dish-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.3;
  display: block;
}

.dicd-subtitle {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
  margin-top: 6rpx;
  display: block;
}

.dicd-header-right {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  padding: 10rpx 20rpx;
  background: #f6f8fb;
  border-radius: 12rpx;
}

.dicd-header-right--danger {
  background: #fef0f0;
}

.dicd-cover-days-label {
  font-size: 24rpx;
  color: #888;
  margin-right: 6rpx;
}

.dicd-cover-days-num {
  font-size: 38rpx;
  font-weight: 800;
  color: #333;
  line-height: 1;
}

.dicd-cover-days-num--danger {
  color: #e02020;
}

.dicd-cover-days-unit {
  font-size: 24rpx;
  color: #888;
  margin-left: 4rpx;
}

/* ========== 摘要统计 ========== */
.dicd-summary {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
}

.dicd-summary-text {
  font-size: 24rpx;
  color: #666;
}

.dicd-summary-bold {
  font-weight: 700;
  color: #333;
}

.dicd-summary-div {
  margin: 0 16rpx;
  color: #ddd;
  font-size: 22rpx;
}

/* ========== 瓶颈提示 ========== */
.dicd-bottleneck {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 14rpx 20rpx;
  background: linear-gradient(135deg, #fff5f5, #ffeded);
  border-radius: 10rpx;
  border-left: 6rpx solid #e02020;
}

.dicd-bn-dot {
  width: 12rpx;
  height: 12rpx;
  background: #e02020;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 10rpx;
}

.dicd-bn-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

.dicd-bn-name {
  font-weight: 700;
  color: #e02020;
}

.dicd-bn-days {
  font-size: 28rpx;
  font-weight: 700;
  color: #e02020;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ========== 表格 ========== */
.dicd-table {
  margin-top: 4rpx;
}

/* 表头 */
.dicd-thead {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.dicd-th {
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
  line-height: 1.4;
  text-align: center;
}

.dicd-th--ing {
  flex: 1;
  min-width: 0;
  text-align: left;
  padding-left: 8rpx;
}

.dicd-th--recipe,
.dicd-th--stock,
.dicd-th--daily {
  width: 120rpx;
  flex-shrink: 0;
}

.dicd-th--days {
  width: 130rpx;
  flex-shrink: 0;
}

/* 数据行 */
.dicd-tr {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
}

.dicd-tr:last-child {
  border-bottom: none;
}

.dicd-tr--bottleneck {
  background: #fffbfb;
  margin: 0 -12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
  border-radius: 8rpx;
}

/* 单元格 */
.dicd-td {
  display: flex;
  align-items: center;
}

.dicd-td--ing {
  flex: 1;
  min-width: 0;
  padding-left: 8rpx;
}

.dicd-td--recipe,
.dicd-td--stock,
.dicd-td--daily {
  width: 120rpx;
  flex-shrink: 0;
  justify-content: center;
}

.dicd-td--days {
  width: 130rpx;
  flex-shrink: 0;
  justify-content: center;
}

/* ---------- 配料名称 ---------- */
.dicd-ing-name {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
  line-height: 1.4;
}

.dicd-ing-bn-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #e02020;
  background: #fef0f0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
  line-height: 1.6;
}

/* ---------- 数值 ---------- */
.dicd-td-val {
  font-size: 26rpx;
  color: #555;
  font-weight: 400;
  line-height: 1.4;
}

/* ---------- 可支撑天数 ---------- */
.dicd-days-val {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  line-height: 1.4;
}

.dicd-days-val--danger {
  color: #e02020;
}

.dicd-days-val--warning {
  color: #e8632d;
}

.dicd-days-unit {
  font-size: 22rpx;
  color: #aaa;
  margin-left: 4rpx;
}
