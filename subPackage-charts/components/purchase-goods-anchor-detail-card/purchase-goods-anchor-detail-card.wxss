/* ===== 公共基础样式（复用经营卡片样式体系）===== */

.biz-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #eef0f2;
  padding: 28rpx 24rpx;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.biz-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.biz-header-right {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.biz-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #e8f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.biz-icon {
  font-size: 28rpx;
  line-height: 1;
}

.biz-icon-blue {
  background: #e3f2fd;
}

.biz-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.biz-scope-bar {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.biz-scope-name {
  font-size: 22rpx;
  color: #6b7280;
}

/* ===== KPI 三列 ===== */
.biz-kpi-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.biz-kpi-col {
  flex: 1;
  min-width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: #f8fafb;
  border-radius: 14rpx;
  padding: 18rpx 16rpx;
}

.biz-kpi-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
  white-space: nowrap;
}

.biz-kpi-value-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.biz-kpi-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #059669;
  line-height: 1.2;
}

.biz-kpi-amount {
  color: #059669;
}

.biz-kpi-unit {
  font-size: 22rpx;
  color: #6b7280;
  font-weight: 500;
}

.biz-kpi-normal {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

/* ===== 范围说明 ===== */
.biz-scope-notice {
  background: #f8fafb;
  border-radius: 10rpx;
  padding: 10rpx 16rpx;
  margin-bottom: 16rpx;
}

.biz-scope-notice-text {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.5;
}

/* ===== 空状态 ===== */
.biz-empty {
  padding: 40rpx 16rpx;
  text-align: center;
}

.biz-empty-text {
  font-size: 26rpx;
  color: #9ca3af;
  line-height: 1.5;
}

/* ===== 采购明细列表 ===== */
.biz-lines-section {
  border-top: 1rpx solid #f3f4f6;
  padding-top: 12rpx;
}

.biz-lines-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #374151;
  margin-bottom: 12rpx;
}

.biz-line-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f9fafb;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.biz-line-row:last-child {
  border-bottom: none;
}

/* 头部：日期 + 来源标签 + 采购人 */
.biz-line-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.biz-line-date {
  font-size: 24rpx;
  color: #374151;
  font-weight: 600;
}

.biz-line-source-tag {
  font-size: 20rpx;
  color: #6d28d9;
  background: #f5f3ff;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-weight: 500;
  white-space: nowrap;
}

.biz-line-purchaser {
  font-size: 20rpx;
  color: #9ca3af;
  margin-left: auto;
}

/* 内容：数量 × 单价 = 金额 */
.biz-line-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.biz-line-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.biz-line-qty {
  font-size: 28rpx;
  color: #111827;
  font-weight: 600;
}

.biz-line-multiply {
  font-size: 24rpx;
  color: #d1d5db;
}

.biz-line-price {
  font-size: 26rpx;
  color: #6b7280;
}

.biz-line-amount {
  font-size: 30rpx;
  font-weight: 800;
  color: #059669;
  flex-shrink: 0;
}
