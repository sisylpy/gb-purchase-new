/* ========== 卡片容器 ========== */
.dpcr-card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #eaeaea;
  box-sizing: border-box;
}

/* ========== 标题行 ========== */
.dpcr-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.dpcr-header-left {
  display: flex;
  align-items: center;
}

.dpcr-title-icon {
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.dpcr-icon-crown {
  font-size: 24rpx;
  color: #43a047;
}

.dpcr-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.3;
}

.dpcr-info-icon {
  font-size: 24rpx;
  color: #b0b0b0;
  margin-left: 8rpx;
}

.dpcr-date-range {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #888;
  line-height: 1.3;
  margin-left: 16rpx;
}

/* 副标题 */
.dpcr-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
  padding-left: 56rpx;
  line-height: 1.4;
}

/* ========== 空数据 ========== */
.dpcr-empty {
  padding: 48rpx 0;
  text-align: center;
}
.dpcr-empty-text { font-size: 26rpx; color: #bbb; }

/* ========== 表格 ========== */
.dpcr-table { margin-top: 4rpx; }

/* 表头 */
.dpcr-thead {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.dpcr-th {
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
  line-height: 1.4;
}
.dpcr-th--rank { width: 100rpx; flex-shrink: 0; text-align: center; }
.dpcr-th--dish { flex: 1; min-width: 0; padding-left: 16rpx; }
.dpcr-th--sales { width: 120rpx; flex-shrink: 0; text-align: right; }
.dpcr-th--cost { width: 140rpx; flex-shrink: 0; text-align: right; }
.dpcr-th--margin { width: 160rpx; flex-shrink: 0; text-align: right; padding-right: 4rpx; }

/* 数据行 */
.dpcr-tr {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
}
.dpcr-tr:last-child { border-bottom: none; }

/* 第1名高亮 */
.dpcr-tr--first {
  background: linear-gradient(90deg, #fffbeb, transparent);
  margin: 0 -12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
  border-radius: 8rpx;
}

/* 单元格 */
.dpcr-td { display: flex; align-items: center; }

.dpcr-td--rank { width: 100rpx; flex-shrink: 0; justify-content: center; }
.dpcr-td--dish { flex: 1; min-width: 0; padding-left: 16rpx; }
.dpcr-td--sales { width: 120rpx; flex-shrink: 0; justify-content: flex-end; }
.dpcr-td--cost { width: 140rpx; flex-shrink: 0; justify-content: flex-end; }
.dpcr-td--margin { width: 160rpx; flex-shrink: 0; justify-content: flex-end; padding-right: 4rpx; }

/* ---------- 奖牌徽标 ---------- */
.dpcr-medal {
  width: 48rpx;
  height: 52rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.dpcr-medal::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 10rpx;
  border-radius: 0 0 14rpx 14rpx;
}

/* 金牌 */
.dpcr-medal--gold {
  background: linear-gradient(135deg, #ffd54f, #ffb300);
}
.dpcr-medal--gold .dpcr-medal-num { color: #fff; font-weight: 800; font-size: 26rpx; }
.dpcr-medal--gold::after { background: linear-gradient(135deg, #ff8a65, #e64a19); }

/* 银牌 */
.dpcr-medal--silver {
  background: linear-gradient(135deg, #e0e0e0, #bdbdbd);
}
.dpcr-medal--silver .dpcr-medal-num { color: #666; font-weight: 700; font-size: 26rpx; }
.dpcr-medal--silver::after { background: linear-gradient(135deg, #90a4ae, #607d8b); }

/* 铜牌 */
.dpcr-medal--bronze {
  background: linear-gradient(135deg, #d4a574, #b8865c);
}
.dpcr-medal--bronze .dpcr-medal-num { color: #fff; font-weight: 700; font-size: 26rpx; }
.dpcr-medal--bronze::after { background: linear-gradient(135deg, #bc8a5c, #9a7044); }

/* 普通名次 */
.dpcr-medal--normal {
  background: #f5f5f5;
  border-radius: 50%;
  width: 40rpx;
  height: 40rpx;
}
.dpcr-medal--normal .dpcr-medal-num { color: #999; font-weight: 600; font-size: 22rpx; }
.dpcr-medal--normal::after { display: none; }

/* ---------- 菜品名称 ---------- */
.dpcr-dish-name {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 销量 ---------- */
.dpcr-sales-num {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  line-height: 1.4;
}
.dpcr-sales-num--top { color: #e8632d; }
.dpcr-sales-unit {
  font-size: 22rpx;
  color: #aaa;
  margin-left: 4rpx;
  line-height: 1.4;
}

/* ---------- 出库分摊成本 ---------- */
.dpcr-cost-val {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
}
.dpcr-cost-val--red {
  color: #e02020;
}

/* 表头成本列红字 */
.dpcr-th--cost-red {
  color: #e02020;
}

/* ---------- 毛利率 ---------- */
.dpcr-margin-val {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  line-height: 1.4;
}
.dpcr-margin-val--top { color: #e8632d; }
.dpcr-margin-val--red { color: #e02020; }

/* 表头毛利率列红字 */
.dpcr-th--margin-red { color: #e02020; }

/* ========== 底部栏 ========== */
.dpcr-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.dpcr-footer-left {
  display: flex;
  align-items: center;
}

.dpcr-footer-icon { font-size: 24rpx; margin-right: 6rpx; }
.dpcr-footer-text { font-size: 23rpx; color: #999; }

.dpcr-footer-right {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: #fafafa;
  border-radius: 8rpx;
}

.dpcr-expand-text { font-size: 23rpx; color: #555; }
.dpcr-expand-arrow { font-size: 20rpx; color: #999; margin-left: 6rpx; }
