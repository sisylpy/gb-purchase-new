/* ===== 公共基础样式（复用经营卡片样式体系）===== */

.biz-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #eef0f2;
  padding: 28rpx 24rpx;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.biz-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.biz-header-right {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.biz-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #e8f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.biz-icon {
  font-size: 28rpx;
  line-height: 1;
}

.biz-icon-blue {
  background: #e3f2fd;
}

.biz-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.biz-scope-bar {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.biz-scope-name {
  font-size: 22rpx;
  color: #6b7280;
}

/* ===== 商品 / 范围标签 ===== */
.biz-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.biz-meta-chip {
  font-size: 22rpx;
  color: #374151;
  background: #f3f6f8;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

/* ===== 空状态 ===== */
.biz-empty {
  padding: 40rpx 16rpx;
  text-align: center;
}

.biz-empty-text {
  font-size: 26rpx;
  color: #9ca3af;
  line-height: 1.5;
}

/* ===== 供货商明细列表 ===== */
.biz-supplier-section {
  border-top: 1rpx solid #f3f4f6;
  padding-top: 12rpx;
}

.biz-lines-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #374151;
  margin-bottom: 12rpx;
}

.biz-supplier-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f9fafb;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.biz-supplier-row:last-child {
  border-bottom: none;
}

.biz-supplier-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.biz-supplier-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.biz-supplier-focus {
  font-size: 20rpx;
  color: #b45309;
  background: #fff7ed;
  border: 1rpx solid #fde68a;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  font-weight: 600;
  white-space: nowrap;
}

.biz-supplier-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.biz-metric {
  flex: 1;
  min-width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: #f8fafb;
  border-radius: 14rpx;
  padding: 16rpx 16rpx;
}

.biz-metric-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
  white-space: nowrap;
}

.biz-metric-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.2;
}

.biz-metric-amount {
  color: #059669;
}
