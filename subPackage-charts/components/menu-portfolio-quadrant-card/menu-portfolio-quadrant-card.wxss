/* ============================================================
   菜品分类分布 - 经营看板卡片
   ============================================================ */

/* ---------- 卡片容器 ---------- */
.mpq-card {
  margin: 20rpx 0;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

/* ---------- 标题区 ---------- */
.mpq-header {
  padding: 28rpx 28rpx 12rpx;
}

.mpq-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 1rpx;
}

.mpq-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa0a6;
  line-height: 1.4;
}

/* ---------- 图表 + 图例 ---------- */
.mpq-top-section {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 28rpx 24rpx;
}

.mpq-chart-wrap {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.mpq-chart-wrap .ec-canvas {
  width: 100%;
  height: 100%;
}

.mpq-legend-list {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.mpq-legend-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.mpq-legend-icon-wrap {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.mpq-legend-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mpq-legend-icon-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.mpq-legend-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.mpq-legend-title-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
}

.mpq-legend-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.mpq-legend-count {
  font-size: 24rpx;
  color: #5f6368;
}

/* ---------- 经营结论 ---------- */
.mpq-insight {
  margin: 0 28rpx 20rpx;
  padding: 16rpx 20rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
  border-left: 6rpx solid #4A90D9;
}

.mpq-insight-text {
  font-size: 26rpx;
  color: #1a1a1a;
  line-height: 1.5;
  font-weight: 500;
}

/* ---------- 分类纵向列表 ---------- */
.mpq-cat-list {
  padding: 0 28rpx 16rpx;
}

.mpq-cat-section {
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #eef0f3;
  overflow: hidden;
}

.mpq-cat-header {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 24rpx 20rpx;
  position: relative;
}

.mpq-cat-header:active {
  background: #f8f9fb;
}

.mpq-cat-color-bar {
  width: 6rpx;
  border-radius: 3rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  align-self: stretch;
}

.mpq-cat-header-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.mpq-cat-title-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
}

.mpq-cat-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.mpq-cat-count {
  font-size: 24rpx;
  color: #5f6368;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.mpq-cat-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa0a6;
  line-height: 1.4;
}

.mpq-cat-arrow {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #bdc1c6;
  flex-shrink: 0;
  align-self: center;
}

/* ---------- 展开详情 ---------- */
.mpq-cat-detail {
  padding: 0 20rpx 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.mpq-dish-table {
  margin-top: 16rpx;
}

.mpq-dish-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.mpq-dish-row:last-child {
  border-bottom: none;
}

.mpq-dish-header {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #e8eaed;
}

.mpq-dish-header .mpq-dish-col {
  font-size: 22rpx;
  color: #9aa0a6;
  font-weight: 500;
}

.mpq-dish-col {
  font-size: 26rpx;
  color: #1a1a1a;
}

.mpq-dish-col-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mpq-dish-col-num {
  width: 120rpx;
  text-align: right;
  flex-shrink: 0;
  color: #5f6368;
}

.mpq-cat-empty {
  padding: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #bdc1c6;
}

/* ---------- 底部提示 ---------- */
.mpq-footer {
  padding: 16rpx 28rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.mpq-footer-text {
  font-size: 22rpx;
  color: #bdc1c6;
}
