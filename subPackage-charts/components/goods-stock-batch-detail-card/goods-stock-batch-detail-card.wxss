/* ===== 公共基础样式（复用经营卡片样式体系）===== */

.biz-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #eef0f2;
  padding: 28rpx 24rpx;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.biz-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.biz-header-right {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.biz-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #e8f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.biz-icon {
  font-size: 28rpx;
  line-height: 1;
}

.biz-icon-orange {
  background: #fff3e0;
}

.biz-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.biz-subtitle {
  font-size: 22rpx;
  color: #6b7280;
}

/* ===== KPI ===== */
.biz-kpi-row {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.biz-kpi-col {
  flex: 1;
  min-width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: #f8fafb;
  border-radius: 14rpx;
  padding: 18rpx 16rpx;
}

.biz-kpi-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
  white-space: nowrap;
}

.biz-kpi-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #059669;
  line-height: 1.2;
}

.biz-kpi-normal {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

/* ===== 空状态 ===== */
.biz-empty {
  padding: 40rpx 16rpx;
  text-align: center;
}

.biz-empty-text {
  font-size: 26rpx;
  color: #9ca3af;
  line-height: 1.5;
}

/* ===== 单位分组 ===== */
.biz-groups {
  border-top: 1rpx solid #f3f4f6;
  padding-top: 12rpx;
}

.biz-group {
  margin-bottom: 16rpx;
}

.biz-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 12rpx 0;
  margin-bottom: 4rpx;
}

.biz-group-unit {
  font-size: 26rpx;
  font-weight: 700;
  color: #374151;
}

.biz-group-count {
  font-size: 22rpx;
  color: #9ca3af;
  background: #f3f4f6;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

/* ===== 批次卡片 ===== */
.biz-batch-row {
  background: #f8fafb;
  border-radius: 14rpx;
  padding: 18rpx 16rpx;
  margin-bottom: 12rpx;
}

.biz-batch-row:last-child {
  margin-bottom: 0;
}

.biz-batch-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.biz-batch-date {
  font-size: 24rpx;
  color: #374151;
  font-weight: 600;
}

.biz-batch-id {
  font-size: 20rpx;
  color: #9ca3af;
}

.biz-batch-balance-tag {
  margin-left: auto;
  flex-shrink: 0;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.biz-balance-ok {
  background: #e8f5e9;
}

.biz-balance-ok text {
  font-size: 20rpx;
  color: #059669;
  font-weight: 500;
}

.biz-balance-warn {
  background: #fff3e0;
}

.biz-balance-warn text {
  font-size: 20rpx;
  color: #e65100;
  font-weight: 500;
}

/* ===== 批次 KPI 行：入库/剩余/单价 ===== */
.biz-batch-kpi-line {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.biz-batch-kpi-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  border-radius: 10rpx;
  padding: 10rpx 8rpx;
}

.biz-batch-kpi-label {
  font-size: 20rpx;
  color: #9ca3af;
  margin-bottom: 4rpx;
}

.biz-batch-kpi-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
}

.biz-batch-rest {
  color: #059669;
}

/* ===== 消耗明细 ===== */
.biz-batch-consume {
  border-top: 1rpx solid #eef0f2;
  padding-top: 10rpx;
}

.biz-batch-consume-title {
  font-size: 20rpx;
  color: #9ca3af;
  display: block;
  margin-bottom: 8rpx;
}

.biz-batch-consume-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
}

.biz-consume-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #ffffff;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  border: 1rpx solid #eef0f2;
}

.biz-consume-chip-label {
  font-size: 20rpx;
  color: #6b7280;
}

.biz-consume-chip-val {
  font-size: 22rpx;
  font-weight: 600;
  color: #374151;
}
