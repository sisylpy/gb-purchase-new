/* ========== 卡片容器 ========== */
.wner-card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #eaeaea;
  box-sizing: border-box;
}

/* ========== 标题区 ========== */
.wner-header {
  margin-bottom: 4rpx;
}

.wner-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  line-height: 1.3;
}

.wner-subtitle {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
  line-height: 1.4;
}

/* ========== 摘要 ========== */
.wner-summary {
  background: #fef7f0;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
  border-left: 6rpx solid #f5a623;
}

.wner-summary-text {
  font-size: 24rpx;
  color: #8b6914;
  line-height: 1.6;
}

/* ========== 空数据 ========== */
.wner-empty {
  padding: 48rpx 0;
  text-align: center;
}
.wner-empty-text { font-size: 26rpx; color: #bbb; }

/* ========== 紧凑行列表 ========== */
.wner-list {
  margin-top: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #f0f0f0;
}

.wner-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f7f7f7;
}

.wner-row:last-child {
  border-bottom: none;
}

.wner-row--expired {
  background: #fef5f5;
}

.wner-row--due-today {
  background: #fffdf5;
}

.wner-row-name {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 500;
  flex-shrink: 0;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wner-row-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.wner-row-batch {
  font-size: 22rpx;
  color: #aaa;
}

.wner-row-stock {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.wner-row-date {
  font-size: 24rpx;
  color: #555;
}

.wner-date--expired {
  color: #e02020;
  font-weight: 600;
}

.wner-date--today {
  color: #e8632d;
  font-weight: 600;
}

/* 风险标签 */
.wner-risk-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-weight: 500;
  white-space: nowrap;
}

.wner-tier--expired {
  background: #fde8e8;
  color: #e02020;
}

.wner-tier--due-today {
  background: #fff3e0;
  color: #e8632d;
}

.wner-tier--near {
  background: #fef7f0;
  color: #b8860b;
}

/* ========== 底部栏 ========== */
.wner-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f5f5f5;
}

.wner-footer-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.wner-footer-text {
  font-size: 22rpx;
  color: #999;
}

.wner-footer-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.wner-footer-tag--expired {
  background: #fde8e8;
  color: #e02020;
}

.wner-footer-tag--today {
  background: #fff3e0;
  color: #e8632d;
}

.wner-footer-tag--near {
  background: #fef7f0;
  color: #b8860b;
}

.wner-footer-right {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 18rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
}

.wner-expand-text { font-size: 23rpx; color: #4a90d9; }
.wner-expand-arrow { font-size: 20rpx; color: #4a90d9; }
