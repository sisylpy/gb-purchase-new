/* ===== 公共基础样式（与经营四卡共用）===== */

.biz-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #eef0f2;
  padding: 28rpx 24rpx;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.biz-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.biz-header-right {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.biz-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #e8f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.biz-icon {
  font-size: 28rpx;
  line-height: 1;
}

.biz-icon-blue {
  background: #e3f2fd;
}

.biz-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.biz-scope-bar {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.biz-scope-tag {
  font-size: 22rpx;
  color: #1a73e8;
  background: #e8f0fe;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.biz-scope-name {
  font-size: 22rpx;
  color: #6b7280;
}

.biz-kpi-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.biz-kpi-col {
  flex: 1;
  min-width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: #f8fafb;
  border-radius: 14rpx;
  padding: 18rpx 16rpx;
}

.biz-kpi-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
  white-space: nowrap;
}

.biz-kpi-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #059669;
  line-height: 1.2;
}

.biz-kpi-normal {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

/* ===== 空状态 ===== */
.biz-empty {
  padding: 40rpx 16rpx;
  text-align: center;
}

.biz-empty-text {
  font-size: 26rpx;
  color: #9ca3af;
  line-height: 1.5;
}

/* ===== 明细列表 ===== */
.biz-items-section {
  border-top: 1rpx solid #f3f4f6;
  padding-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.biz-item-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}

.biz-item-row:last-child {
  border-bottom: none;
}

/* 商品名 + 来源标签 行 */
.biz-item-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.biz-item-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.3;
}

.biz-item-source {
  font-size: 20rpx;
  color: #6d28d9;
  background: #f5f3ff;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 数量 + 单价 + 金额 行 */
.biz-item-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.biz-item-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.biz-item-qty {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}

.biz-item-price {
  font-size: 24rpx;
  color: #9ca3af;
}

.biz-item-amount {
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
  flex-shrink: 0;
}

/* 供货商行 */
.biz-item-foot {
  margin-top: 6rpx;
}

.biz-item-supplier {
  font-size: 22rpx;
  color: #6b7280;
}

/* 行级「记入工作记录」按钮 */
.biz-item-record-row {
  display: flex;
  justify-content: flex-end;
  padding-top: 10rpx;
  margin-top: 6rpx;
  border-top: 1rpx dashed #eee;
}

.biz-item-record-text {
  font-size: 22rpx;
  color: #576b95;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: #f0f4ff;
}

/* ===== 警告提示 ===== */
.biz-warn-list {
  border-top: 1rpx solid #f3f4f6;
  padding-top: 14rpx;
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.biz-warn-item {
  display: flex;
  align-items: flex-start;
}

.biz-warn-text {
  font-size: 22rpx;
  color: #b45309;
  line-height: 1.45;
}
