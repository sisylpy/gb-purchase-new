

page{
  background-color: rgb(243, 243, 243);
}

/* 底部购买栏固定在屏幕底部，避免被长内容顶出可视区 */
.pay-page-bottom-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  box-sizing: border-box;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.pay-page-bottom-inner {
  /* 与 _syncLayoutMetrics 中 bottomFixedBarRpx + safe 预留一致，兼容全面屏 */
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.navbar {
  display: flex;
  position: relative;
  z-index: 100;
  /* top: 0; */
  /* width: 100%; */
  /* border-bottom: 1rpx solid #e5e5e5; */
  /* background-color: #0d4d43; */
  height: 80rpx;
}

.navbar .navbar-item {
  position: relative;
  display: block;
  flex: 1;
  /* padding: 13px 0; */
  text-align: center;
  font-size: 30rpx;
  line-height: 80rpx;
  color: #425042;
}

.navbar .bar-item-on {
  color: #187e6e;
  
}

.navbar .navbar-title {
  display: inline-block;
  font-size: 32rpx;
  width: auto;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  
}

.navbar .bar-item-on .navbar-title {
  color: #187e6e;
  font-weight: 600;
}


.navbar .navbar-slider {
  position: absolute;
  content: " ";
  left: 0;
  bottom: 10rpx;
  width: 100rpx;
  height: 8rpx;
  background-color: #187e6e;
  -webkit-transition: -webkit-transform 0.3s;
  transition: -webkit-transform 0.3s;
  transition: transform 0.3s, -webkit-transform 0.3s;
}


.orderItem{
  border: 1px solid rgb(182, 182, 182);
