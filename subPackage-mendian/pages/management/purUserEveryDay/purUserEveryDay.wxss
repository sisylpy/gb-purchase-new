/* ============ 采购统计信息卡片样式 ============ */

/* 采购统计信息卡片 */
.purchase-stats-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 20rpx 20rpx 0 0;
  padding: 30rpx;
  margin: 20rpx 20rpx 0 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10rpx);
  position: relative;
  overflow: hidden;
}

.purchase-stats-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #4A90E2 0%, #05c0a7 50%, #FF9800 100%);
  border-radius: 20rpx 20rpx 0 0;
}

/* 统计项 */
.stats-item {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 16rpx;
}

/* 统计图标 */
.stats-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.3s ease;
}

.stats-icon-image {
  width: 32rpx;
  height: 32rpx;
  filter: brightness(0) saturate(100%);
  transition: all 0.3s ease;
}

/* 采购天数图标 */
.purchase-days-icon {
  background: linear-gradient(135deg, rgba(74, 144, 226, 0.15) 0%, rgba(74, 144, 226, 0.1) 100%);
  border: 1rpx solid rgba(74, 144, 226, 0.2);
}

.purchase-days-icon .stats-icon-image {
  filter: brightness(0) saturate(100%) invert(27%) sepia(96%) saturate(1352%) hue-rotate(201deg) brightness(97%) contrast(89%);
}

/* 采购总额图标 */
.purchase-total-icon {
  background: linear-gradient(135deg, rgba(5, 192, 167, 0.15) 0%, rgba(5, 192, 167, 0.1) 100%);
  border: 1rpx solid rgba(5, 192, 167, 0.2);
}

.purchase-total-icon .stats-icon-image {
  filter: brightness(0) saturate(100%) invert(60%) sepia(96%) saturate(1352%) hue-rotate(140deg) brightness(97%) contrast(89%);
}

/* 退货总额图标 */
.return-total-icon {
  background: linear-gradient(135deg, rgba(255, 152, 0, 0.15) 0%, rgba(255, 87, 34, 0.1) 100%);
  border: 1rpx solid rgba(255, 152, 0, 0.2);
}

.return-total-icon .stats-icon-image {
  filter: brightness(0) saturate(100%) invert(55%) sepia(90%) saturate(1200%) hue-rotate(360deg) brightness(98%) contrast(92%);
}

.return-value {
  color: #FF5722;
}

/* 统计内容 */
.stats-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.stats-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.2;
}

/* 分隔线 */
.stats-divider {
  width: 2rpx;
  height: 60rpx;
  background: linear-gradient(180deg, transparent 0%, #e0e0e0 50%, transparent 100%);
  margin: 0 12rpx;
  flex-shrink: 0;
}

/* 悬停效果 */
.purchase-stats-card:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.purchase-stats-card:hover .stats-icon {
  transform: scale(1.05);
}

/* ============ 日采购列表美化样式 ============ */

/* 日采购列表容器 */
.purchase-list-container1 {
  margin: 0 20rpx 30rpx 20rpx;
}

/* 日采购列表项 */
.purchase-day-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  cursor: pointer;
}

/* 每个日采购项的彩色线条 - 多彩渐变 */
.purchase-day-item:nth-child(1)::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #4A90E2 0%, #05c0a7 50%, #FF9800 100%);
  border-radius: 16rpx 16rpx 0 0;
}

.purchase-day-item:nth-child(2)::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #E91E63 0%, #9C27B0 50%, #4CAF50 100%);
  border-radius: 16rpx 16rpx 0 0;
}

.purchase-day-item:nth-child(3)::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #FF5722 0%, #FF9800 50%, #4CAF50 100%);
  border-radius: 16rpx 16rpx 0 0;
}

.purchase-day-item:nth-child(4)::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #9C27B0 0%, #E91E63 50%, #FF5722 100%);
  border-radius: 16rpx 16rpx 0 0;
}

.purchase-day-item:nth-child(5)::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #4CAF50 0%, #05c0a7 50%, #4A90E2 100%);
  border-radius: 16rpx 16rpx 0 0;
}

.purchase-day-item:nth-child(6)::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #FF9800 0%, #FF5722 50%, #E91E63 100%);
  border-radius: 16rpx 16rpx 0 0;
}

.purchase-day-item:nth-child(7)::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #05c0a7 0%, #4CAF50 50%, #FF9800 100%);
  border-radius: 16rpx 16rpx 0 0;
}

/* 超过7个时循环使用多彩渐变 */
.purchase-day-item:nth-child(n+8)::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #607D8B 0%, #9C27B0 50%, #4A90E2 100%);
  border-radius: 16rpx 16rpx 0 0;
}

.purchase-day-item:last-child {
  margin-bottom: 0;
}

/* 悬停效果 */
.purchase-day-item:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  border-color: rgba(74, 144, 226, 0.2);
}

/* 激活效果 */
.purchase-day-item:active {
  transform: scale(0.98);
}

/* 左侧日期信息 */
.purchase-day-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
}

.purchase-day-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
  line-height: 1.2;
}

.purchase-day-weekday {
  font-size: 22rpx;
  color: #666;
  background: rgba(74, 144, 226, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

/* 右侧金额信息和按钮 */
.purchase-day-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 0 0 auto;
}

.purchase-day-info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.purchase-day-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A90E2;
  margin-bottom: 4rpx;
  text-shadow: 0 2rpx 4rpx rgba(74, 144, 226, 0.1);
}

.purchase-day-label {
  font-size: 20rpx;
  color: #666;
  font-weight: 500;
}

/* 进入下一页按钮 */
.purchase-day-button {
  width: 50rpx;
  height: 50rpx;
  background: rgba(74, 144, 226, 0.1);
  border: 1rpx solid rgba(74, 144, 226, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.purchase-day-button:hover {
  background: rgba(74, 144, 226, 0.15);
  border-color: rgba(74, 144, 226, 0.3);
  transform: scale(1.05);
}

.purchase-day-button:active {
  transform: scale(0.98);
}

.purchase-day-arrow {
  width: 20rpx;
  height: 20rpx;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  opacity: 0.6;
  z-index: 1;
  position: relative;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .purchase-list-container1 {
    margin: 20rpx 15rpx;
    padding: 20rpx;
  }
  
  .purchase-day-item {
    padding: 20rpx 16rpx;
  }
  
  .purchase-day-date {
    font-size: 26rpx;
  }
  
  .purchase-day-amount {
    font-size: 28rpx;
  }
}
