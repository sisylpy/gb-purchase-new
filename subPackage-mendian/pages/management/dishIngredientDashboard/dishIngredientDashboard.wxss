page {
  background: #f0f2f5;
  height: 100%;
  box-sizing: border-box;
}

.dga-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 100vh;
  box-sizing: border-box;
}

.dga-topbar {
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #e8eaef;
}

.dga-topbar .icon {
  width: 44rpx;
  height: 44rpx;
}

.dga-hanzi {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.3;
  margin-bottom: 4rpx;
}

.dga-topbar .flex-column .small,
.dga-topbar .flex-column > .flex-row text,
.dga-topbar .flex-column .flex-row text {
  font-size: 28rpx;
  line-height: 1.4;
  color: #4b5563;
}

.dga-scroll {
  flex: 1;
  min-height: 0;
  /* padding: 0 28rpx 48rpx; */
  box-sizing: border-box;
}

.dga-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.dga-state--err .dga-state__txt {
  color: #c44f4f;
}

.dga-state__txt {
  font-size: 32rpx;
  color: #6b7280;
  font-weight: 500;
}

/* 用量偏差说明：自定义轻量弹层 */
.dga-tip-wrap {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}

.dga-tip-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.48);
}

.dga-tip-panel {
  position: relative;
  width: 100%;
  max-width: 600rpx;
  max-height: 72vh;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 64rpx rgba(15, 23, 42, 0.18);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.dga-tip__title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  text-align: center;
  line-height: 1.35;
  margin-bottom: 24rpx;
}

.dga-tip__body {
  flex: 1;
  min-height: 0;
  max-height: 46vh;
  margin-bottom: 28rpx;
}

.dga-tip__line {
  font-size: 28rpx;
  line-height: 1.65;
  color: #475569;
  font-weight: 400;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.dga-tip__body .dga-tip__line:first-child {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: 0.02em;
}

.dga-tip__line:last-child {
  border-bottom: none;
}

.dga-tip__btn {
  align-self: center;
  min-width: 240rpx;
  padding: 20rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  text-align: center;
  background: linear-gradient(180deg, #22c55e 0%, #16a34a 100%);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.dga-tip__btn--hover {
  opacity: 0.9;
}

.dga-hero {
  margin-top: 16rpx;
  padding: 24rpx 0 0;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e8eaef;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
  overflow: hidden;
}

.dga-hero__title-row {
  padding: 0 22rpx 0;
  margin-bottom: 12rpx;
}

.dga-hero__name-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx 12rpx;
}

.dga-hero__name {
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.3;
  letter-spacing: 0.02em;
  flex: 1;
  min-width: 0;
}

.dga-hero__tag {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #16a34a;
  background: #ecfdf3;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(22, 163, 74, 0.2);
  box-sizing: border-box;
}

.dga-hero__subline {
  padding: 0 22rpx;
  margin-bottom: 8rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 0 4rpx;
}

.dga-hero__sub {
  font-size: 28rpx;
  line-height: 1.5;
  color: #4b5563;
  font-weight: 500;
}

.dga-hero__date {
  align-items: flex-start;
  padding: 0 22rpx 20rpx;
  margin-top: 4rpx;
}

.dga-hero__date-cal {
  padding: 0 8rpx 0 0;
  flex-shrink: 0;
}

.dga-hero__date-cal .icon {
  width: 44rpx;
  height: 44rpx;
}

.dga-hero__date-hanzi {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
}

.dga-hero__dash {
  padding: 0 8rpx;
}

.dga-hero__kpi-scroll {
  width: 100%;
  border-top: 1rpx solid #e8eaef;
  background: #fcfcfd;
  box-sizing: border-box;
}

.dga-hero__kpi {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: stretch;
  padding: 0;
  background: #fcfcfd;
  min-width: 100%;
  width: max-content;
  box-sizing: border-box;
}

.dga-hero__kpi--row {
  min-width: 860rpx;
}

.dga-hero__kdiv {
  width: 1rpx;
  background: #e2e4e8;
  flex: none;
  margin: 18rpx 0 16rpx;
  align-self: stretch;
  flex-shrink: 0;
}

.dga-hero__kcell {
  flex: 0 0 168rpx;
  width: 168rpx;
  min-width: 168rpx;
  padding: 22rpx 8rpx 22rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
  justify-content: center;
  vertical-align: top;
}

.dga-hero__kpi-lab {
  display: block;
  font-size: 22rpx;
  line-height: 1.35;
  color: #4b5563;
  font-weight: 600;
  margin-bottom: 10rpx;
  max-width: 100%;
  padding: 0 2rpx;
  word-break: break-all;
}

.dga-hero__kpi-val-wrap {
  display: block;
  line-height: 1.15;
}

.dga-hero__kpi-val--em {
  font-size: 36rpx;
  font-weight: 800;
  color: #16a34a;
  letter-spacing: 0.02em;
}

.dga-hero__kpi-pct {
  font-size: 26rpx;
  font-weight: 700;
  color: #16a34a;
  margin-left: 2rpx;
}

.dga-hero__kpi-val {
  font-size: 36rpx;
  font-weight: 700;
  color: #16a34a;
  line-height: 1.15;
}

.dga-hero__kpi-amt {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.2;
  letter-spacing: 0.02em;
}

.dga-hero__kpi-val.is-muted,
.dga-hero__kpi-amt--muted {
  color: #9ca3af;
  font-size: 30rpx;
  font-weight: 600;
}

.dga-hero__kpi-val--em.is-profit {
  font-size: 36rpx;
  font-weight: 800;
  color: #16a34a;
  letter-spacing: 0.02em;
}

/* 类别毛利率标准（与 depFoodList 口径一致，数据在 dish 根上） */
.dga-hero__margin {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 16rpx 22rpx 18rpx;
  border-top: 1rpx solid #e8eaef;
  background: #fafbfc;
  box-sizing: border-box;
}

.dga-hero__margin-range {
  font-size: 22rpx;
  font-weight: 400;
  color: #64748b;
  line-height: 1.45;
  text-align: center;
  margin-bottom: 10rpx;
}

.dga-hero__margin-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  max-width: 100%;
}

.dga-hero__margin-emoji {
  margin-right: 10rpx;
  font-size: 40rpx;
  line-height: 1;
  flex-shrink: 0;
}

.dga-hero__margin-txt {
  font-size: 24rpx;
  font-weight: 600;
  color: #15803d;
  line-height: 1.35;
}

.dga-hero__margin--ok .dga-hero__margin-txt {
  color: #15803d;
}

.dga-hero__margin--warn .dga-hero__margin-txt {
  color: #b45309;
}

.dga-hero__margin--good .dga-hero__margin-txt {
  color: #0f766e;
}

.dga-hero__margin--muted .dga-hero__margin-txt {
  color: #64748b;
  font-weight: 500;
}

.dga-hero__hint {
  padding: 18rpx 22rpx 22rpx;
  background: #f0fdf4;
  border-top: 1rpx solid #dcfce4;
  box-sizing: border-box;
}

.dga-hero__hint-txt {
  display: block;
  font-size: 28rpx;
  line-height: 1.55;
  color: #15803d;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.dga-sec {
  margin-top: 20rpx;
  padding: 0 0 8rpx;
}

.dga-sec__bar {
  margin-bottom: 16rpx;
}

.dga-sec__tit {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.dga-tbl-x {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e0e4eb;
  overflow: hidden;
  box-shadow: 0 1rpx 0 rgba(15, 23, 42, 0.04);
}

.dga-tbl {
  min-width: 100%;
  border-collapse: separate;
  border-spacing: 0;
}

.dga-tbl__tr--head {
  background: #f1f3f6;
  border-bottom: 1rpx solid #dce0e6;
}

.dga-tbl__tr--head,
.dga-tbl__tr {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e8ebef;
  /* 与列间竖线对齐拉满行高 */
  align-items: stretch;
  min-width: 2080rpx;
  box-sizing: border-box;
}

/* 列间竖线（微信 WXSS 不支持 * 通配符，用 dga-tbl__cell） */
.dga-tbl__cell {
  box-sizing: border-box;
  border-right: 1rpx solid #eceff2;
}

.dga-tbl__tr--head .dga-tbl__cell {
  border-right-color: #e3e7ec;
}

.dga-tbl__tr--head .dga-tbl__cell--last,
.dga-tbl__tr .dga-tbl__cell--last {
  border-right: 0;
}

.dga-tbl__tr--head .dga-tbl__cell.flex-column {
  flex: 0 0 220rpx;
  min-width: 220rpx;
  align-items: center;
  justify-content: center;
  text-align: center;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 4rpx 0;
}

.dga-tbl__tr:last-child {
  border-bottom: none;
}

.dga-tbl__th,
.dga-td {
  flex: 0 0 auto;
  display: block;
  font-size: 30rpx;
  color: #1f2937;
  padding: 0 10rpx;
  box-sizing: border-box;
  line-height: 1.5;
  word-break: break-all;
  text-align: center;
}

.tbl__th_sub {
  font-size: 24rpx;
  line-height: 1.2;
  color: #5c6570;
  font-weight: 500;
  margin-top: 2rpx;
}

.dga-td--ing,
.dga-tbl__th.dga-td--ing {
  width: 250rpx;
  flex: none;
  box-sizing: border-box;
}

.dga-td--ing {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0 8rpx;
}

.dga-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  margin-right: 12rpx;
  border: 1rpx solid #e5e7eb;
  flex-shrink: 0;
  background: #f9fafb;
}

.dga-ing-name {
  flex: 1;
  min-width: 0;
}

.dga-ing-name__main {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.35;
  text-align: center;
}

/* 表头 th 与表体 td 用同一组 dga-td--* 类，列宽成对写，避免 th 用通配 200/220 冲突 */
.dga-td.dga-td--stack,
.dga-tbl__th.dga-td--stack {
  width: 220rpx;
  flex: none;
}

.dga-td--stack {
  text-align: center;
  align-items: center;
}

/* 行撑满后，列内内容上下+水平居中 */
.dga-tbl__tr .dga-td--stack,
.dga-tbl__tr .dga-td--dev,
.dga-tbl__tr .dga-td--bar,
.dga-tbl__tr .dga-td--sug {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 0;
  box-sizing: border-box;
  text-align: center;
}

.dga-tbl__tr > .dga-td--cost,
.dga-tbl__tr > .dga-td--gp {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 0;
  box-sizing: border-box;
}

.dga-td--dev,
.dga-tbl__th.dga-td--dev {
  width: 240rpx;
  flex: none;
}

.dga-td--bar,
.dga-tbl__th.dga-td--bar {
  width: 220rpx;
  flex: none;
}

.dga-td--cost,
.dga-tbl__th.dga-td--cost {
  width: 200rpx;
  flex: none;
}

.dga-td.dga-td--cost {
  text-align: center;
  color: #1f2937;
  font-weight: 600;
}

.dga-td--gp,
.dga-tbl__th.dga-td--gp {
  width: 170rpx;
  flex: none;
}

.dga-td.dga-td--gp {
  color: #16a34a;
  font-weight: 700;
  text-align: center;
}

.dga-td--sug,
.dga-tbl__th.dga-td--sug {
  width: 340rpx;
  flex: none;
}

.dga-td--sug {
  text-align: center;
}

.dga-td--dev {
  text-align: center;
}

.dga-td__line {
  display: block;
  width: 100%;
  text-align: center;
}

.dga-td__sub {
  display: block;
  margin-top: 4rpx;
  font-size: 25rpx;
  color: #525a63;
  text-align: center;
  font-weight: 500;
}

.dga-td--stack .dga-td__line {
  font-size: 28rpx;
}

.dga-td--stack .dga-td__sub {
  text-align: center;
  margin-top: 6rpx;
}

.dga-dev-nums {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 4rpx;
  margin-bottom: 6rpx;
}

.dga-dev-nums__pct {
  font-size: 28rpx;
  font-weight: 700;
}

.dga-dev-nums__arrow {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 700;
}

.dga-dev-nums__arrow.is-down {
  color: #64748b;
}

.dga-tbl__tr--head .dga-th--tap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.dga-th--underline {
  border-bottom: 1rpx dashed #94a3b8;
}

.dga-th--tap-hover {
  opacity: 0.82;
}

.dga-td--dev-tap-hover {
  background: rgba(148, 163, 184, 0.12);
  border-radius: 8rpx;
}

.dga-ing-util-tag {
  display: inline-block;
  margin-top: 4rpx;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
}

.dga-pill {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1.1;
  padding: 5rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.dga-pill--bad {
  color: #fff;
  background: #ff4d4f;
}

.dga-pill--ok {
  color: #fff;
  background: #d1d5db;
}

.dga-bar {
  height: 16rpx;
  width: 100%;
  max-width: 220rpx;
  border-radius: 8rpx;
  background: #e2e5ea;
  overflow: hidden;
  margin-bottom: 4rpx;
}

.dga-bar__in {
  height: 100%;
  max-width: 100%;
  border-radius: 6rpx;
}

.dga-bar__in.is-ok {
  background: #52c41a;
}

.dga-bar__in.is-warn {
  background: #ff4d4f;
}

.dga-sug__tag {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1.2;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  color: #fff;
  background: #ff4d4f;
  font-weight: 600;
}

.dga-sug__tag--opt {
  color: #ad6800;
  background: #fff2e0;
  border: 1rpx solid #ffd8a8;
}

.dga-sug__txt {
  display: block;
  font-size: 27rpx;
  line-height: 1.5;
  color: #374151;
  font-weight: 400;
  text-align: center;
  width: 100%;
}

.dga-tbl__th {
  text-align: center;
  color: #374151;
  font-size: 26rpx;
  font-weight: 700;
  padding: 0 6rpx;
  box-sizing: border-box;
  /* 列宽只由 dga-td--* 与 dga-td--sug 等决定，勿写死 200rpx */
  flex: none;
}

.dga-tbl__th.dga-td--ing {
  text-align: center;
  padding: 0 8rpx;
  font-size: 27rpx;
}

.dga-empty {
  text-align: center;
  color: #6b7280;
  padding: 36rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.dga-charts {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dga-chart-card {
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e0e4eb;
  padding: 24rpx 24rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.05);
  box-sizing: border-box;
}

.dga-chart-card__tit {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 14rpx;
}

.dga-donut {
  position: relative;
  width: 100%;
  min-height: 400rpx;
  margin: 0 auto 8rpx;
  z-index: 0;
}

.dga-donut__ec {
  display: block;
  width: 100%;
  height: 400rpx;
  position: relative;
  z-index: 0;
}

.dga-donut__cent {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  width: 220rpx;
  margin-top: -4rpx;
  pointer-events: none;
}

.dga-donut__amt {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.2;
}

.dga-donut__sub {
  display: block;
  font-size: 26rpx;
  color: #525a63;
  font-weight: 500;
  margin-top: 2rpx;
}

.dga-legend {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 8rpx;
}

.dga-legend__row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  font-size: 27rpx;
  line-height: 1.5;
  color: #1f2937;
}

.dga-legend__left {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
  flex: 1;
  gap: 0;
}

.dga-legend__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.dga-legend__name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dga-legend__val {
  color: #4b5563;
  font-size: 25rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.dga-foot {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
  font-weight: 500;
}

.dga-line__ec {
  display: block;
  width: 100%;
  height: 360rpx;
  margin: 0 auto;
}

.dga-trend-hint {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  background: #fff0f0;
  border: 1rpx solid #ffd0d0;
  border-radius: 10rpx;
}

.dga-trend-hint__txt {
  font-size: 27rpx;
  line-height: 1.5;
  color: #b91c1c;
  font-weight: 600;
}

.dga-disclaimer {
  margin-top: 10rpx;
  padding: 0 0 4rpx;
}

.dga-disclaimer__txt {
  font-size: 26rpx;
  line-height: 1.55;
  color: #6b7280;
  font-weight: 500;
}

.dga-pad {
  height: 40rpx;
}

/* ================================================================
   以下样式合并自 dishIngredientAudit.wxss（配料消耗排查区块）
   ================================================================ */

/* ===== 菜品汇总卡片 ===== */
.dia-margin-card0 {
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-top: 12rpx;
  border: 1rpx solid #e8eaef;
}

.dia-margin-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.dia-margin-cell {
  flex: 1;
  text-align: center;
}

.dia-margin-label {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.dia-margin-val {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
}

.dia-margin-val--actual {
  color: #ff6b35;
}

.dia-margin-val--theory {
  color: #52c41a;
}

.dia-margin-val--warn {
  color: #e74c3c;
}

/* ===== 汇总网格 ===== */
.dia-summary-grid {
  display: flex;
}

.dia-summary-cell {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
}

.dia-summary-label {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.dia-summary-val {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.dia-summary-val--blue {
  color: #1890ff;
}

.dia-summary-val--green {
  color: #52c41a;
}

.dia-summary-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #999;
  margin-left: 4rpx;
}

/* ===== 配料卡片 ===== */
.dia-ingredient-card {
  background: #fff;
  margin-top: 12rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.dia-ing-head1 {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.dia-ing-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.dia-ing-info {
  flex: 1;
  margin-left: 18rpx;
}

.dia-ing-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.dia-ing-price {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.dia-ing-weight {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 2rpx;
  display: block;
}

.dia-ing-status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.dia-ing-status--warn {
  background: #fff2e8;
  color: #fa541c;
}

.dia-ing-status--ok {
  background: #f0fff0;
  color: #52c41a;
}

.dia-arrow {
  width: 24rpx;
  height: 24rpx;
  transition: transform 0.2s;
}

.dia-arrow--up {
  transform: rotate(180deg);
}

/* ===== 配料展开内容 ===== */
.dia-ing-body {
  padding: 0 24rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* ===== 核心指标 4列 ===== */
.dia-core-metrics1 {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #f8fafc;
  border-radius: 10rpx;
}

.dcm-cell {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.dcm-label {
  font-size: 21rpx;
  color: #999;
  display: block;
  margin-bottom: 6rpx;
  white-space: nowrap;
}

.dcm-val {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  white-space: nowrap;
}

.dcm-val--orange {
  color: #fa8c16;
}

.dcm-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #888;
  margin-left: 2rpx;
}

/* ===== 理论和实际对比条 ===== */
.dia-bar-chart {
  margin-top: 20rpx;
  padding: 16rpx 20rpx 12rpx;
  background: #fafbfc;
  border-radius: 12rpx;
}

.dia-bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.dia-bar-label {
  font-size: 22rpx;
  font-weight: 600;
  width: 64rpx;
  flex-shrink: 0;
  text-align: right;
  padding-right: 12rpx;
}

.dia-bar-label--theory {
  color: #1890ff;
}

.dia-bar-label--actual {
  color: #e74c3c;
}

.dia-bar-track {
  flex: 1;
  height: 28rpx;
  background: #f0f0f0;
  border-radius: 14rpx;
  overflow: hidden;
  margin-right: 12rpx;
  min-width: 0;
}

.dia-bar-fill {
  height: 100%;
  border-radius: 14rpx;
  transition: width 0.3s ease;
  min-width: 4rpx;
}

.dia-bar-fill--blue {
  background: linear-gradient(90deg, #69c0ff, #1890ff);
}

.dia-bar-fill--red {
  background: linear-gradient(90deg, #ff9c6e, #e74c3c);
}

.dia-bar-val {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  white-space: nowrap;
  flex-shrink: 0;
  text-align: right;
  min-width: 140rpx;
}

.dia-bar-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #999;
  margin-left: 2rpx;
}

.dia-bar-scale {
  position: relative;
  height: 36rpx;
  margin-left: 76rpx;
}

.dia-bar-scale-inner {
  display: flex;
  justify-content: space-between;
  height: 100%;
  align-items: flex-start;
}

.dia-scale-tick {
  font-size: 18rpx;
  color: #bbb;
  text-align: center;
  min-width: 60rpx;
}

.dia-scale-unit {
  font-size: 18rpx;
  color: #bbb;
  margin-left: 2rpx;
}

/* ===== 子区块 ===== */
.dia-subsection {
  margin-top: 16rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
}

.dia-subsection-header {
  display: flex;
  align-items: center;
  padding: 18rpx 16rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #f0f0f0;
}

.dia-subsection-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #555;
  flex: 1;
}

.dia-extra-label {
  font-size: 28rpx;
  color: #999;
  display: block;
}

.dia-extra-val {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.dia-extra-val--blue {
  color: #1890ff;
}

.dia-extra-unit {
  font-size: 28rpx;
  font-weight: 400;
  color: #999;
  margin-left: 2rpx;
}

/* ===== 实际消耗记录 - 横向滚动6列表格 ===== */
.dia-records-wrap {
  margin: 8rpx 0 16rpx;
  overflow: hidden;
  border-radius: 10rpx;
  border: 1rpx solid #eee;
}

.dia-recs-scroll {
  overflow-x: auto;
  overflow-y: hidden;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 8rpx;
}

.dia-recs-header {
  display: flex;
  background: #fafafa;
  border-bottom: 2rpx solid #eee;
}

.dia-recs-th {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  padding: 14rpx 8rpx;
  min-width: 180rpx;
  flex-shrink: 0;
}

.dia-recs-th--date {
  min-width: 200rpx;
}

.dia-recs-row {
  display: flex;
  border-bottom: 1rpx solid #f5f5f5;
}

.dia-recs-row:last-child {
  border-bottom: none;
}

.dia-recs-td {
  font-size: 28rpx;
  color: #333;
  text-align: center;
  padding: 14rpx 8rpx;
  min-width: 180rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.dia-recs-td--date {
  min-width: 180rpx;
}

.dia-recs-val {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  white-space: nowrap;
}

.dia-recs-val--blue {
  color: #1890ff;
  font-weight: 600;
}

.dia-recs-val--orange {
  color: #fa8c16;
  font-weight: 600;
}

.dia-recs-sub {
  font-size: 26rpx;
  color: #999;
  margin-top: 2rpx;
  white-space: nowrap;
}

.dia-rec-type {
  font-size: 18rpx;
  padding: 1rpx 10rpx;
  border-radius: 6rpx;
  margin-top: 4rpx;
}

.dia-rec-type--make {
  background: #e6f7ff;
  color: #1890ff;
}

.dia-rec-type--loss {
  background: #fff7e6;
  color: #fa8c16;
}

.dia-rec-type--waste {
  background: #fff2f0;
  color: #e74c3c;
}

/* ===== 关联菜品累计分摊 - 卡片式 ===== */
.dia-related-card {
  background: #fafbfc;
  border-radius: 12rpx;
  margin: 8rpx 0;
  overflow: hidden;
}

.dia-related-card--current {
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(24,144,255,0.08);
  border: 1rpx solid #d6eaff;
}

.related-card-head {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.related-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-left: 14rpx;
  flex: 1;
}

.related-card-tag {
  font-size: 20rpx;
  color: #fa541c;
  background: #fff7e6;
  border-radius: 8rpx;
  padding: 3rpx 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.related-card-link {
  font-size: 22rpx;
  color: #1890ff;
  flex-shrink: 0;
}

.related-card-metrics {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 12rpx 20rpx;
}

.rcm-cell {
  flex: 1;
  text-align: center;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.rcm-label {
  font-size: 19rpx;
  color: #999;
  margin-bottom: 6rpx;
  white-space: nowrap;
}

.rcm-val {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  white-space: nowrap;
}

.rcm-unit {
  font-size: 19rpx;
  font-weight: 400;
  color: #999;
  margin-left: 2rpx;
}

.rcm-val--green {
  color: #52c41a;
}

.rcm-val--orange {
  color: #fa8c16;
}

.rcm-val--red {
  color: #e74c3c;
}

/* ===== 排查空状态提示 ===== */
.dia-empty-tip {
  padding: 30rpx;
  text-align: center;
}

.dia-empty-tip text {
  font-size: 24rpx;
  color: #bbb;
}
