page{background:#f3fafc;color:#132039}.page{min-height:100vh;background:linear-gradient(180deg,#f8fdff,#f0f8fa)}
.date-toolbar{min-height:104rpx;padding:10rpx 24rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #e5efed;background:#fff;box-sizing:border-box}.date-selector{display:flex;align-items:center;min-width:245rpx;flex-shrink:0}.date-selector-hover{opacity:.72}.date-calendar{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.date-calendar image{width:34rpx;height:34rpx}.date-copy{display:flex;flex-direction:column;min-width:0}.date-title{font-size:28rpx;line-height:34rpx;color:#26354b}.date-values{display:flex;align-items:center;margin-top:2rpx;color:#26354b;font-size:24rpx;line-height:30rpx;white-space:nowrap}.date-divider{padding:0 8rpx}.date-actions{flex:1}
.overview{margin:18rpx 22rpx;padding:23rpx 15rpx 18rpx;border-radius:25rpx;background:linear-gradient(120deg,#dffbec,#ecfff4);box-shadow:0 4rpx 16rpx rgba(19,151,99,.08)}.overview-head{display:flex;align-items:center;padding:0 9rpx 20rpx;position:relative}.overview-icon{width:66rpx;height:66rpx;border-radius:15rpx;background:linear-gradient(145deg,#35cf8c,#078f61);display:flex;align-items:center;justify-content:center;margin-right:14rpx}.overview-icon image{width:39rpx;height:39rpx;filter:brightness(0) invert(1)}.overview-title{display:block;font-size:32rpx;font-weight:900}.overview-sub{display:block;font-size:22rpx;color:#64758a;margin-top:3rpx}.overview-slogan{position:absolute;right:7rpx;top:5rpx;text-align:center;font-size:21rpx;color:#078956;transform:rotate(-5deg)}.overview-slogan text{display:block}.overview-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9rpx}.overview-item{height:132rpx;background:rgba(255,255,255,.94);border-radius:18rpx;padding:13rpx 11rpx;display:flex;flex-direction:column;box-sizing:border-box;font-size:21rpx;color:#53647a}.item-icon{width:39rpx;height:39rpx;border-radius:12rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:900;margin-bottom:4rpx}.green{background:#e6faf0;color:#08aa70}.blue{background:#e8f4ff;color:#267ee4}.orange{background:#fff1d7;color:#df8a00}.red{background:#ffeaed;color:#e84a58}.item-value{font-size:30rpx;color:#111d31;font-weight:900;margin-top:4rpx;white-space:nowrap}.item-value text{font-size:20rpx}.profit{color:#e75908!important}.danger-text{color:#ea303c!important}.margin{color:#07975f!important}
.rank-panel{margin:0 22rpx;background:#fff;border-radius:24rpx;padding:18rpx 13rpx;box-sizing:border-box}.rank-head{display:flex;justify-content:space-between;align-items:center;padding:0 8rpx 15rpx}.rank-head>view{display:flex;flex-direction:column}.rank-title{font-size:31rpx;font-weight:900;color:#18243a}.rank-note{font-size:21rpx;color:#6a7b90;margin-top:4rpx}.view-all{font-size:22rpx;color:#65768b}.dish-card{min-height:174rpx;border:1rpx solid #e2eaed;border-radius:19rpx;margin-bottom:13rpx;padding:17rpx 16rpx 16rpx 62rpx;position:relative;box-sizing:border-box;box-shadow:0 3rpx 10rpx rgba(32,76,70,.04)}.medal{position:absolute;left:10rpx;top:16rpx;z-index:2;width:40rpx;height:48rpx;line-height:40rpx;text-align:center;border-radius:50% 50% 8rpx 8rpx;background:#dde5ee;color:#34465d;font-size:22rpx;font-weight:900}.medal-1{background:#ffd35b;color:#8b5700}.medal-2{background:#cdd9e7}.medal-3{background:#efa66c;color:#7a360d}.dish-main{min-width:0;width:100%}.dish-title-row{display:flex;align-items:center;min-width:0}.dish-name{font-size:29rpx;font-weight:900;max-width:245rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.tag{font-size:20rpx;border-radius:18rpx;padding:6rpx 12rpx;margin-left:10rpx;white-space:nowrap}.tag.king{background:#fff2d9;color:#de8400}.tag.stable{background:#e7faf0;color:#079e67}.tag.danger{background:#ffebee;color:#ec3c49}.diagnosis-btn{margin-left:auto;background:#e8faef;color:#078e5c;border-radius:30rpx;padding:10rpx 16rpx;font-size:21rpx;font-weight:800;white-space:nowrap}.dish-desc{display:block;font-size:21rpx;color:#718196;margin:9rpx 0 10rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.dish-metrics{display:grid;grid-template-columns:repeat(3,1fr);border-radius:13rpx;background:#f7fafb;padding:9rpx 0}.dish-metrics>view{display:flex;flex-direction:column;border-right:1rpx solid #e3eaec;padding-left:17rpx}.dish-metrics>view:first-child{padding-left:12rpx}.dish-metrics>view:last-child{border:0}.dish-metrics>view>text:first-child{font-size:20rpx;color:#728297}.dish-metrics>view>text:nth-child(2){font-size:27rpx;font-weight:900;margin-top:3rpx}.dish-metrics text text{font-size:18rpx}.empty{height:600rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#63758b;font-size:27rpx}.empty image{width:210rpx;height:210rpx}.empty text:last-child{margin-top:14rpx;color:#08a96f}.bottom{height:36rpx}
