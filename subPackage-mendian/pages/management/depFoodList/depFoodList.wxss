


@import '../food-common.wxss';

.dfl-search-top-ico {
  opacity: 0.72;
}

.dfl-search-top-ico--on {
  opacity: 1;
}

.dfl-search-panel {
  padding: 12rpx 24rpx 16rpx;
}

.dfl-search-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #f3f4f6;
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
  min-height: 72rpx;
  box-sizing: border-box;
}

.dfl-search-inner-ico {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  opacity: 0.45;
}

.dfl-search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #111827;
  height: 44rpx;
  line-height: 44rpx;
}

.dfl-search-clear {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 40rpx;
  color: #9ca3af;
  margin-left: 8rpx;
}

.dfl-list-empty {
  padding: 48rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--gb-text-muted);
  line-height: 1.5;
}

.food-page {
  min-height: 100vh;
  background: var(--gb-bg-page);
}

.food-page--boss {
  background: linear-gradient(180deg, #f0f4f8 0%, var(--gb-bg-page) 320rpx);
}

