.dfl-tool-chip {
  padding: 10rpx 18rpx;
  margin-left: 10rpx;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.dfl-tool-chip--blue {
  color: #007aff;
  background: #f0f7ff;
  border: 1rpx solid rgba(0, 122, 255, 0.35);
}

.dfl-tool-chip--green {
  color: #1a7f4b;
  background: #ecf9f1;
  border: 1rpx solid rgba(26, 127, 75, 0.35);
}

.dfl-hero__footnote {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--gb-text-muted);
  line-height: 1.5;
}

.dfl-hero__upload-hint {
  margin-top: 10rpx;
  padding-right: 8rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--gb-text-muted);
}

.dfl-hero__upload-hint--em {
  font-weight: 600;
  color: var(--gb-text-secondary);
}

/* ---------- 区间 KPI ---------- */
.dfl-banner {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.dfl-banner__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.dfl-banner__info {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #e8eaef;
}

.dfl-banner__info-icon {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1;
}

.dfl-banner__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

/* ---------- 区块分组（A/B/C） ---------- */
.dfl-section-block {
  margin-top: 16rpx;
}

.dfl-section-block:first-child {
  margin-top: 0;
}

.dfl-section-block__tag {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 6rpx 16rpx 6rpx 10rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
  gap: 6rpx;
}

.dfl-section-block__tag-letter {
  width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  flex-shrink: 0;
}

.dfl-section-block__tag-label {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}

.dfl-section-block__tag--green {
  background: #ecfdf5;
}
.dfl-section-block__tag--green .dfl-section-block__tag-letter {
  background: #16a34a;
}
.dfl-section-block__tag--green .dfl-section-block__tag-label {
  color: #166534;
}

.dfl-section-block__tag--blue {
  background: #eff6ff;
}
.dfl-section-block__tag--blue .dfl-section-block__tag-letter {
  background: #2563eb;
}
.dfl-section-block__tag--blue .dfl-section-block__tag-label {
  color: #1e40af;
}

.dfl-section-block__tag--orange {
  background: #fff7ed;
}
.dfl-section-block__tag--orange .dfl-section-block__tag-letter {
  background: #f97316;
}
.dfl-section-block__tag--orange .dfl-section-block__tag-label {
  color: #c2410c;
}

/* ---------- 经营概览行 ---------- */
.dfl-overview-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.dfl-overview-row--4col .dfl-overview-cell2,
.dfl-overview-row--3col .dfl-overview-cell2 {
  flex: 1;
  min-width: 0;
}

/* ---------- 概览卡片 v2（销售/毛利） ---------- */
.dfl-overview-cell2 {
  padding: 20rpx 14rpx 16rpx;
  border-radius: 14rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.dfl-overview-cell2--wide {
  padding: 20rpx 16rpx 18rpx;
}

.dfl-overview-cell2__lab {
  display: block;
  font-size: 22rpx;
  font-weight: 500;
  color: #6b7280;
  line-height: 1.4;
}

.dfl-overview-cell2__val {
  display: block;
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.15;
  color: #111827;
  letter-spacing: -0.02em;
}

.dfl-overview-cell2__val--lg {
  font-size: 40rpx;
}

.dfl-overview-cell2__val--green {
  color: #16a34a;
}

.dfl-overview-cell2__val--blue {
  color: #2563eb;
}

.dfl-overview-cell2__trend {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9ca3af;
  line-height: 1.35;
  gap: 4rpx;
}

.dfl-overview-cell2__pct {
  font-weight: 600;
  margin-left: 2rpx;
}

.dfl-overview-cell2__pct.is-up {
  color: #ef4444;
}

.dfl-overview-cell2__pct.is-down {
  color: #16a34a;
}

.dfl-overview-cell2__pct.is-flat {
  color: #6b7280;
  margin-left: 4rpx;
}

.dfl-overview-cell2__arrow {
  font-weight: 700;
  font-size: 20rpx;
  line-height: 1;
}

.dfl-overview-cell2__arrow.is-up {
  color: #ef4444;
}

.dfl-overview-cell2__arrow.is-down {
  color: #16a34a;
}

.dfl-overview-cell2__desc {
  display: block;
  margin-top: 6rpx;
  font-size: 19rpx;
  color: #9ca3af;
  line-height: 1.4;
}

/* ---------- 制作成本公式布局 ---------- */
.dfl-cost-formula {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 12rpx;
}

.dfl-cost-formula__item {
  flex: 1;
  min-width: 0;
}

.dfl-cost-formula__op {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #9ca3af;
  padding: 0 4rpx;
  min-width: 40rpx;
}

.dfl-cost-card {
  padding: 20rpx 14rpx 16rpx;
  border-radius: 14rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.dfl-cost-card__lab {
  display: block;
  font-size: 22rpx;
  font-weight: 500;
  color: #6b7280;
  line-height: 1.4;
}

.dfl-cost-card__val {
  display: block;
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.15;
  color: #111827;
  letter-spacing: -0.02em;
}

.dfl-cost-card__val--blue {
  color: #2563eb;
}

.dfl-cost-card__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9ca3af;
  line-height: 1.4;
}

.dfl-cost-card__trend {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9ca3af;
  line-height: 1.35;
  gap: 4rpx;
}

.dfl-cost-card__pct {
  font-weight: 600;
  color: #ef4444;
}

/* ========== 菜品统计区域（dish-insight） ========== */
.dish-insight {
  margin-top: 20rpx;
}

.dish-section-block {
  margin-bottom: 16rpx;
}

.dish-section-block:last-child {
  margin-bottom: 0;
}

.dish-section-label {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 10rpx;
}

.dish-section-label--green {
  background: #ecfdf5;
  color: #166534;
}

.dish-section-label--blue {
  background: #eff6ff;
  color: #1e40af;
}

.dish-section-label--orange {
  background: #fff7ed;
  color: #c2410c;
}

/* 菜品行 */
.dish-overview-row {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.dish-cell {
  flex: 1;
  min-width: 0;
  padding: 16rpx 12rpx 14rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.dish-cell__lab {
  display: block;
  font-size: 21rpx;
  font-weight: 500;
  color: #6b7280;
  line-height: 1.35;
}

.dish-cell__val {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.15;
  color: #111827;
  letter-spacing: -0.02em;
}

.dish-cell__val--green {
  color: #16a34a;
}

.dish-cell__sub {
  display: block;
  margin-top: 4rpx;
  font-size: 19rpx;
  line-height: 1.3;
  color: #9ca3af;
}

/* 菜品成本公式 */
.dish-cost-formula {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 10rpx;
}

.dish-cost-formula__item {
  flex: 1;
  min-width: 0;
}

.dish-cost-formula__op {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #9ca3af;
  padding: 0 2rpx;
  min-width: 36rpx;
}

.dish-cost-card {
  padding: 16rpx 12rpx 14rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.dish-cost-card__lab {
  display: block;
  font-size: 21rpx;
  font-weight: 500;
  color: #6b7280;
  line-height: 1.35;
}

.dish-cost-card__val {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.15;
  color: #111827;
  letter-spacing: -0.02em;
}

.dish-cost-card__val--blue {
  color: #2563eb;
}

.dfl-banner__meta {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #eef0f4;
  font-size: 20rpx;
  line-height: 1.5;
  color: #9ca3af;
}

/* 旧样式保留（兼容菜品卡内小 KPI） */
.dfl-boss-card .dfl-banner__grid--dish {
  margin: 12rpx -4rpx 0;
  padding: 12rpx 8rpx 4rpx;
  border-radius: 14rpx;
  background: #f3f4f6;
  border: 1rpx solid var(--gb-border-soft);
}

.dfl-boss-card .dfl-banner__grid--dish .dfl-kpi__val {
  color: var(--gb-text);
}

.dfl-boss-card .dfl-banner__grid--dish .dfl-kpi__val--accent {
  color: #187e6e;
}

.dfl-boss-card .dfl-banner__grid--dish .dfl-kpi__lab {
  color: var(--gb-text-muted);
}

/* ---------- 吸顶容器（标题 + 排序栏） ---------- */
.dfl-section-sticky {
  position: sticky;
  z-index: 20;
  padding: 20rpx 24rpx 0;
  background: var(--gb-bg-page);
}

/* ---------- 列表区块 ---------- */
.dfl-section {
  padding: 12rpx 24rpx 40rpx;
}

.dfl-section__bar {
  align-items: center;
  margin-bottom: 16rpx;
}

.dfl-section__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--gb-text);
}

.dfl-section__tag {
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #a94442;
  background: #fdeaea;
  border-radius: 8rpx;
}

.dfl-section__tip {
  font-size: 22rpx;
  color: var(--gb-text-muted);
}

/* ---------- 列表排序（与 depGeFoodBusiness sortBy/sortOrder 一致） ---------- */
.dfl-sort-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 4rpx 0 8rpx;
  background: var(--gb-bg-page);
  border-radius: 12rpx;
}

.dfl-sort-left {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 12rpx;
}

.dfl-sort-arrows {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 10rpx;
  gap: 2rpx;
}

.dfl-sort-arrow {
  font-size: 30rpx;
  color: #c5cdd6;
  line-height: 1;
  font-weight: 700;
  padding: 0 2rpx;
}

.dfl-sort-arrow.is-on {
  color: #187e6e;
}

.dfl-sort-label {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--gb-text-secondary);
  font-weight: 500;
}

.dfl-sort-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.dfl-sort-chips {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 2rpx 0;
  gap: 12rpx;
}

.dfl-sort-chip {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--gb-text-secondary);
  background: var(--gb-bg-white);
  border: 1rpx solid var(--gb-border-soft);
}

.dfl-sort-chip-ico {
  margin-right: 6rpx;
  font-size: 24rpx;
}

.dfl-sort-chip.is-on {
  font-weight: 600;
}

.dfl-sort-chip--sales.is-on {
  color: #1d4ed8;
  background: #eff6ff;
  border-color: #bfdbfe;
}

.dfl-sort-chip--margin.is-on {
  color: #166534;
  background: #ecfdf5;
  border-color: #a7f3d0;
}

.dfl-sort-chip--profit.is-on {
  color: #c2410c;
  background: #fff7ed;
  border-color: #fed7aa;
}

.dfl-list {
  display: flex;
  flex-direction: column;
}

.dfl-boss-card {
  margin-bottom: 20rpx;
  padding: 22rpx 22rpx 18rpx;
  background: var(--gb-bg-white);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.dfl-boss-card__head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  gap: 8rpx;
}

/* ---------- 菜品卡顶栏（稿图：菜名/单价 + 圆图占位 + 销量） ---------- */
.dfl-dish-head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.dfl-dish-head__main {
  display: flex;
  flex-direction: row;
  flex: 1;
  min-width: 0;
  align-items: flex-start;
}

.dfl-dish-head__idx {
  flex-shrink: 0;
  width: 40rpx;
  margin-right: 8rpx;
  font-size: 32rpx;
  color: var(--gb-text-muted);
  line-height: 44rpx;
  text-align: center;
}

.dfl-dish-head__titles {
  flex: 1;
  min-width: 0;
}

.dfl-dish-head__name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.35;
}

.dfl-dish-head__price {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.dfl-dish-head__aside {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 20rpx;
}

.dfl-dish-head__photo-wrap {
  flex-shrink: 0;
}

.dfl-dish-head__photo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f3f4f6;
  display: block;
}

.dfl-dish-head__photo--placeholder {
  border: 1rpx dashed #e5e7eb;
  box-sizing: border-box;
}

.dfl-dish-head__sales {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  min-width: 100rpx;
}

.dfl-dish-head__sales-lab {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.3;
}

.dfl-dish-head__sales-val {
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #07c160;
  letter-spacing: -0.02em;
}

/* ---------- 左右布局：综合毛利率(左) + 四指标网格(右) ---------- */
.dfl-insight-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  margin-top: 24rpx;
  gap: 16rpx;
}

/* ---------- 综合毛利率主卡（左侧栏） ---------- */
.dfl-blend-hero {
  flex-shrink: 0;
  width: 220rpx;
  padding: 24rpx 16rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 2rpx solid rgba(7, 193, 96, 0.45);
  box-sizing: border-box;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.dfl-blend-hero__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.dfl-blend-hero__value-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
  margin-top: 12rpx;
}

.dfl-blend-hero__num {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.05;
  color: #07c160;
  letter-spacing: -0.03em;
}

.dfl-blend-hero__pct {
  margin-left: 2rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #07c160;
}

.dfl-blend-hero__hint {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  margin-top: 12rpx;
  padding: 10rpx 8rpx 0;
  border-top: 1rpx solid #eef6f1;
  box-sizing: border-box;
}

.dfl-blend-hero__hint-range {
  font-size: 18rpx;
  font-weight: 400;
  color: var(--gb-text-secondary, #666);
  line-height: 1.45;
  text-align: center;
  margin-bottom: 6rpx;
  padding: 0 4rpx;
}

.dfl-blend-hero__hint-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  max-width: 100%;
}

.dfl-blend-hero__hint-emoji {
  margin-right: 6rpx;
  font-size: 28rpx;
  line-height: 1;
  flex-shrink: 0;
}

.dfl-blend-hero__hint-txt {
  font-size: 20rpx;
  font-weight: 500;
  color: #07c160;
  line-height: 1.35;
  text-align: left;
}

.dfl-blend-hero__hint--ok .dfl-blend-hero__hint-txt {
  color: #07c160;
}

.dfl-blend-hero__hint--warn .dfl-blend-hero__hint-txt {
  color: #c97a00;
}

.dfl-blend-hero__hint--good .dfl-blend-hero__hint-txt {
  color: #0d7a4d;
}

.dfl-blend-hero__hint--muted .dfl-blend-hero__hint-txt {
  color: var(--gb-text-muted, #999);
  font-weight: 400;
}

/* ---------- 双列指标白卡片 ---------- */
.dfl-stat-dual {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  margin-top: 20rpx;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #eef0f4;
  box-sizing: border-box;
}

.dfl-stat-dual--tight {
  margin-top: 16rpx;
}

.dfl-stat-dual__col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.dfl-stat-dual__divider {
  width: 1rpx;
  margin: 0 8rpx;
  align-self: stretch;
  background: #eef0f4;
  flex-shrink: 0;
}

.dfl-stat-dual__icon-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

.dfl-stat-ico {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.dfl-stat-ico__img {
  width: 40rpx;
  height: 40rpx;
}

.dfl-stat-ico__fallback {
  font-size: 28rpx;
  font-weight: 700;
  color: #07c160;
  line-height: 1;
}

.dfl-stat-ico--cost {
  background: #e8f8f0;
}

.dfl-stat-ico--theory {
  background: #e8f8f0;
}

.dfl-stat-ico--revenue {
  background: #e8f8f0;
}

.dfl-stat-ico--wallet {
  background: #fff4e8;
}

.dfl-stat-ico--wallet .dfl-stat-ico__fallback {
  color: #e67e22;
}

.dfl-stat-dual__text {
  flex: 1;
  min-width: 0;
}

.dfl-stat-dual__lab {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #333333;
  line-height: 1.35;
}

.dfl-stat-dual__val {
  display: block;
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
}

.dfl-stat-dual__val-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: nowrap;
}

.dfl-stat-dual__pct-suffix {
  margin-left: 2rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.dfl-stat-dual__val--dark {
  color: #333333;
}

.dfl-stat-dual__val--green {
  color: #07c160;
}

.dfl-stat-dual__sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #999999;
}

/* ---------- 右侧四指标 2x2 网格 ---------- */
.dfl-stat-grid {
  flex: 1;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  align-content: flex-start;
}

.dfl-stat-grid__cell {
  width: calc(50% - 6rpx);
  padding: 18rpx 14rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #eef0f4;
  box-sizing: border-box;
}

.dfl-stat-grid__icon-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 10rpx;
}

.dfl-stat-grid__text {
  flex: 1;
  min-width: 0;
}

.dfl-stat-grid__lab {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #333333;
  line-height: 1.35;
}

.dfl-stat-grid__val {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.25;
  color: #333333;
}

.dfl-stat-grid__val--green {
  color: #07c160;
}

.dfl-stat-grid__val-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: nowrap;
}

.dfl-stat-grid__pct-suffix {
  margin-left: 2rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.dfl-stat-grid__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #999999;
}

/* 网格内图标缩小 */
.dfl-stat-grid .dfl-stat-ico {
  width: 48rpx;
  height: 48rpx;
}

.dfl-stat-grid .dfl-stat-ico__img {
  width: 30rpx;
  height: 30rpx;
}

.dfl-stat-grid .dfl-stat-ico__fallback {
  font-size: 24rpx;
}

/* ---------- 配料成本分析 CTA ---------- */
.dfl-ingredient-cta {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  border: 2rpx solid rgba(7, 193, 96, 0.55);
  background: #ffffff;
  box-sizing: border-box;
}

.dfl-ingredient-cta__ico {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.dfl-ingredient-cta__ico-slot {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  border-radius: 6rpx;
  border: 2rpx solid rgba(7, 193, 96, 0.35);
  box-sizing: border-box;
}

.dfl-ingredient-cta__txt {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #07c160;
}

.dfl-ingredient-cta__chev {
  flex-shrink: 0;
  font-size: 34rpx;
  font-weight: 500;
  color: #07c160;
  line-height: 1;
  margin-left: 8rpx;
}

.dfl-data-disclaimer {
  display: block;
  margin-top: 16rpx;
  margin-bottom: 4rpx;
  font-size: 20rpx;
  line-height: 1.45;
  color: #bbbbbb;
}

.dfl-boss-card__method--below-chart {
  margin-top: 16rpx;
  padding-top: 0;
  border-top: none;
}

.dfl-boss-card__top {
  align-items: flex-start;
}

.dfl-boss-card__left {
  display: flex;
  flex: 1;
  flex-direction: row;
  align-items: flex-start;
  min-width: 0;
}

.dfl-boss-card__idx {
  flex-shrink: 0;
  width: 40rpx;
  margin-right: 10rpx;
  font-size: 22rpx;
  color: var(--gb-text-muted);
  line-height: 44rpx;
  text-align: center;
}

.dfl-boss-card__titles {
  flex: 1;
  min-width: 0;
}

.dfl-boss-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gb-text);
  line-height: 1.4;
}

.dfl-boss-card__sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.dfl-boss-card__price {
  color: var(--gb-primary);
  font-weight: 600;
}

.dfl-boss-card__price--emph,
.dfl-boss-card__qty--emph {
  font-size: 30rpx;
  font-weight: 600;
}

.dfl-boss-card__dot {
  margin: 0 8rpx;
  color: var(--gb-text-muted);
}

.dfl-boss-card__qty {
  color: var(--gb-text-secondary);
}

.dfl-boss-card__margin-wrap {
  flex-shrink: 0;
  margin-left: 16rpx;
  text-align: right;
}

.dfl-boss-card__margin-lab {
  display: block;
  font-size: 24rpx;
  line-height: 1.3;
  color: var(--gb-text-secondary);
}

.dfl-boss-card__revenue-val {
  display: block;
  margin-top: 6rpx;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.02em;
  color: #1a4d6e;
}

/* 两列毛利率卡（与稿：白底细边框、大号绿色百分比、底栏提示） */
.dfl-gm-card {
  margin-top: 18rpx;
  padding: 26rpx 22rpx 20rpx;
  border: 1rpx solid #e8eaef;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.dfl-gm-card__body {
  display: flex;
  flex-direction: row;
  align-items: stretch;
}

.dfl-gm-col {
  flex: 1;
  min-width: 0;
  padding-right: 8rpx;
  box-sizing: border-box;
}

.dfl-gm-col--r {
  padding: 0 0 0 20rpx;
  border-left: 1rpx solid #e8eaef;
  text-align: right;
}

.dfl-gm-card__lab {
  display: block;
  font-size: 24rpx;
  line-height: 1.4;
  color: #6b7280;
  font-weight: 500;
}

.dfl-gm-card__lab--r {
  text-align: right;
}

.dfl-gm-card__val-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: nowrap;
  margin-top: 10rpx;
  min-height: 64rpx;
}

.dfl-gm-card__val-row--r {
  justify-content: flex-end;
}

.dfl-gm-card__num {
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: #16a34a;
}

.dfl-gm-card__pct {
  margin-left: 4rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #16a34a;
  vertical-align: baseline;
}

.dfl-gm-card__sub {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #6b7280;
  font-weight: 400;
}

.dfl-gm-card__sub--r {
  text-align: right;
}

.dfl-gm-card__foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef0f4;
}

.dfl-gm-card__icon {
  flex-shrink: 0;
  font-size: 32rpx;
  line-height: 1;
  margin-right: 8rpx;
  filter: grayscale(0) saturate(1.2);
}

.dfl-gm-card__hint {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  line-height: 1.45;
  color: #16a34a;
  font-weight: 500;
}

.dfl-metrics-grid {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--gb-border-soft);
}

.dfl-metric-cell--end {
  text-align: right;
}

.dfl-metrics-pair {
  margin-bottom: 14rpx;
}

.dfl-metrics-pair:last-child {
  margin-bottom: 0;
}

.dfl-metric-cell {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
  box-sizing: border-box;
}

.dfl-metric-cell:last-child {
  padding-right: 0;
  padding-left: 12rpx;
  border-left: 1rpx solid var(--gb-border-soft);
}

.dfl-metric__pct {
  font-weight: 700;
}

.dfl-metric__pct--high {
  color: #187e6e;
}

.dfl-metric__pct--mid {
  color: #b07a1e;
}

.dfl-metric__pct--low {
  color: #c44f4f;
}

.dfl-metric__pct--none {
  color: var(--gb-text-muted);
  font-weight: 600;
}

.dfl-metric__pct--theory-high {
  color: #2a6f9e;
}

.dfl-metric__pct--theory-mid {
  color: #8a6d3a;
}

.dfl-metric__pct--theory-low {
  color: #b94a48;
}

.dfl-metric__pct--theory-none {
  color: var(--gb-text-muted);
  font-weight: 600;
}

.dfl-metric__lab {
  display: block;
  font-size: 24rpx;
  line-height: 1.3;
  color: var(--gb-text-secondary);
}

.dfl-metric__val {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
  color: var(--gb-text);
}

.dfl-boss-card__no-insight {
  margin-top: 14rpx;
  padding: 12rpx 0 0;
  border-top: 1rpx dashed var(--gb-border-soft);
  font-size: 22rpx;
  color: var(--gb-text-muted);
}

.dfl-boss-card__foot {
  align-items: flex-end;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--gb-border-soft);
}

.dfl-boss-card__method {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--gb-text-secondary);
}

.dfl-boss-card__method--muted {
  color: var(--gb-text-muted);
}

.dfl-boss-card__link {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--gb-primary);
  border: 1rpx solid rgba(24, 126, 110, 0.35);
  border-radius: 999rpx;
}

/* ---------- 周内销量 ec-canvas ---------- */
.dfl-week-chart {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--gb-border-soft);
}

.dfl-boss-card .dfl-week-chart {
  margin-top: 20rpx;
  padding: 20rpx 16rpx 12rpx;
  border-top: none;
  border: 1rpx solid #eef0f4;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.dfl-week-chart__head {
  align-items: center;
  margin-bottom: 8rpx;
}

.dfl-week-chart__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.dfl-week-chart__muted {
  font-size: 22rpx;
  color: var(--gb-text-muted);
}

.dfl-week-chart__canvas-wrap {
  width: 100%;
  height: 220rpx;
}

.dfl-week-ec {
  display: block;
  width: 100%;
  height: 220rpx;
}

.food-toolbar {
  padding: 18rpx 24rpx 6rpx;
  background: var(--gb-bg-white);
  border-bottom: 1rpx solid var(--gb-border-soft);
}

.dfl-group {
  margin-bottom: 22rpx;
}

.dfl-group__header {
  align-items: center;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.dfl-group__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gb-text);
}

.dfl-group__count {
  font-size: 22rpx;
  color: var(--gb-text-muted);
}

.dfl-list-card {
  overflow: hidden;
  background: var(--gb-bg-white);
  border-radius: 18rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.dfl-item {
  align-items: flex-start;
  padding: 20rpx;
  border-bottom: 1rpx solid var(--gb-border-soft);
}

.dfl-item:last-child {
  border-bottom: none;
}

.dfl-item__main {
  display: flex;
  flex: 1;
  min-width: 0;
}

.dfl-item__index {
  flex-shrink: 0;
  width: 36rpx;
  margin-right: 12rpx;
  font-size: 22rpx;
  color: var(--gb-text-muted);
  line-height: 40rpx;
  text-align: center;
}

.dfl-item__image-wrap {
  flex-shrink: 0;
}

.dfl-item__img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 14rpx;
}

.dfl-item__body {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.dfl-item__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gb-text);
  line-height: 1.45;
}

.dfl-item__meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.dfl-item__price {
  margin-right: 16rpx;
  color: var(--gb-primary);
  font-weight: 600;
}

.dfl-item__sales {
  color: var(--gb-text-secondary);
}

.dfl-item__method {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--gb-text-secondary);
}

.dfl-item__method--empty {
  color: var(--gb-text-muted);
}

.dfl-item__action {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  width: 146rpx;
  margin-left: 12rpx;
}

.dfl-action-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 62rpx;
  border-radius: 14rpx;
}

.dfl-action-btn--on {
  background: var(--gb-bg-light);
  border: 1rpx solid rgba(24, 126, 110, 0.2);
}

.dfl-action-btn--off {
  background: #eef4ff;
  border: 1rpx solid #d6e3ff;
}

.dfl-action-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.dfl-action-text {
  font-size: 22rpx;
  line-height: 1;
  color: var(--gb-text-secondary);
}

.dfl-action-btn--off .dfl-action-text {
  color: #3567d7;
}

.dfl-dep-name {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--gb-text-muted);
  text-align: right;
}

.dfl-empty {
  margin-top: 80rpx;
  padding: 0 40rpx;
  font-size: 26rpx;
  color: var(--gb-text-muted);
  text-align: center;
}

/* ========== 菜品摘要行（综合毛利率 + 实际利润 + 展开按钮） ========== */
.dish-summary-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  margin-top: 20rpx;
  gap: 16rpx;
}

.dish-summary-card {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 18rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  gap: 14rpx;
}

.dish-summary-card--green {
  background: #f0fdf6;
  border: 1rpx solid #bbf7d0;
}

.dish-summary-card--orange {
  background: #fffbeb;
  border: 1rpx solid #fde68a;
}

.dish-summary-card__icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #dcfce7;
}

.dish-summary-card__icon--yen {
  background: #fef3c7;
}

.dish-summary-card__bar-ico {
  font-size: 32rpx;
  font-weight: 800;
  color: #16a34a;
  line-height: 1;
}

.dish-summary-card__yen-txt {
  font-size: 28rpx;
  font-weight: 700;
  color: #d97706;
  line-height: 1;
}

.dish-summary-card__body {
  flex: 1;
  min-width: 0;
}

.dish-summary-card__lab {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #6b7280;
  line-height: 1.35;
}

.dish-summary-card__val {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -0.02em;
}

.dish-summary-card__val--green {
  color: #16a34a;
}

.dish-summary-card__val--orange {
  color: #d97706;
}

/* 展开/收起按钮 */
.dish-expand-btn {
  flex-shrink: 0;
  width: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.dish-expand-btn__arrow {
  font-size: 28rpx;
  font-weight: 600;
  color: #ef4444;
  line-height: 1;
}

/* 展开详情面板（默认隐藏，保留 DOM 供图表初始化） */
.dish-detail-panel {
  display: none;
  margin-top: 20rpx;
}

.dish-detail-panel.is-open {
  display: block;
}

/* 绿色按钮 */
.dfl-action-btn--green {
  background: #e8f8f0;
  border: 1rpx solid rgba(24, 126, 110, 0.25);
  margin-top: 8rpx;
  padding: 10rpx 10rpx;
  font-size: 30rpx;
}

.dfl-action-btn--green .dfl-action-text {
  color: #187e6e;
}
