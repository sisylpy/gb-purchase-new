<wxs src="/wxs/format.wxs" module="tool" />
<view class="page">
  <back-navbar title="菜品经营" avatar="/images/back.png" bindnavbuttontap="toBack"></back-navbar>
  <view class="nav-spacer" style="height:{{navBarHeight}}rpx"></view>
  <view class="date-toolbar"><view class="date-selector" bindtap="toDatePage" hover-class="date-selector-hover"><view class="date-calendar"><image src="/images/calender.png"></image></view><view class="date-copy"><view class="date-title">{{hanzi}}</view><view class="date-values" wx:if="{{startDate == stopDate}}"><text>{{tool.transferDateString(startDate)}}</text></view><view class="date-values" wx:else><text>{{tool.transferDateString(startDate)}}</text><text class="date-divider">-</text><text>{{tool.transferDateString(stopDate)}}</text></view></view></view><view class="date-actions"></view></view>
  <view wx:if="{{hasData}}">
    <view class="overview">
      <view class="overview-head"><view class="overview-icon"><image src="/images/goods.png"></image></view><view><text class="overview-title">本区间经营总览</text><text class="overview-sub">先看结果，再逐层找原因</text></view><view class="overview-slogan"><text>用数据让每一道菜</text><text>更赚钱！</text></view></view>
      <view class="overview-grid">
        <view class="overview-item"><text class="item-icon green">♜</text><text>销售菜品</text><text class="item-value">{{summary.dishCount}}<text> 道</text></text></view>
        <view class="overview-item"><text class="item-icon blue">▤</text><text>总销量</text><text class="item-value">{{summary.totalSales}}<text> 份</text></text></view>
        <view class="overview-item"><text class="item-icon orange">￥</text><text>实际利润</text><text class="item-value profit">￥{{summary.totalProfit}}</text></view>
        <view class="overview-item"><text class="item-icon red">!</text><text>需关注</text><text class="item-value danger-text">{{summary.attentionCount}}<text> 道</text></text></view>
      </view>
    </view>
    <view class="rank-panel">
      <view class="rank-head"><view><text class="rank-title">♛ 赚钱排行榜</text><text class="rank-note">按实际利润从高到低，看看哪些菜最赚钱</text></view><text class="view-all" bindtap="toggleAll">{{showAll?'收起':'查看全部'}} ›</text></view>
      <view class="dish-card" wx:for="{{visibleRows}}" wx:key="foodId" data-item="{{item}}" bindtap="toDiagnosis">
        <view class="medal medal-{{item.rank}}">{{item.rank}}</view>
        <image wx:if="{{item.image}}" class="dish-image" src="{{item.image}}" mode="aspectFill"></image><view wx:else class="dish-image placeholder">{{item.initial}}</view>
        <view class="dish-main"><view class="dish-title-row"><text class="dish-name">{{item.foodName}}</text><text class="tag {{item.tagClass}}">{{item.tag}}</text></view><text class="dish-desc">{{item.description}}</text><view class="dish-metrics"><view><text>销量</text><text>{{item.salesCount}}<text> 份</text></text></view><view><text>实际利润</text><text class="profit">￥{{item.profitDisplay}}</text></view><view><text>毛利率</text><text class="{{item.needsAttention?'danger-text':'margin'}}">{{item.marginDisplay}}%</text></view></view></view>
        <view class="diagnosis-btn">查看诊断 ›</view>
      </view>
    </view>
  </view>
  <view wx:elif="{{!loading}}" class="empty"><image src="/images/goods.png" mode="aspectFit"></image><text>当前日期范围暂无菜品经营数据</text><text bindtap="toDatePage">切换日期查看</text></view>
  <view class="bottom"></view>
</view>
