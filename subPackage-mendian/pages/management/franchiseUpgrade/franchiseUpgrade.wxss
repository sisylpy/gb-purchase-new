.page { min-height: 100vh; background: #f5f6f8; color: #1f2933; }
.content { padding: 24rpx; }
.card { margin-bottom: 24rpx; padding: 32rpx; background: #fff; border-radius: 22rpx; box-shadow: 0 6rpx 24rpx rgba(23, 35, 45, .06); }
.title { font-size: 36rpx; font-weight: 700; line-height: 1.45; }
.desc, .steps { margin-top: 20rpx; color: #66717d; font-size: 28rpx; line-height: 1.75; }
.primary { margin-top: 34rpx; background: #1b8878; color: #fff; border-radius: 14rpx; font-size: 30rpx; }
.code-card { text-align: center; }
.label { color: #66717d; font-size: 26rpx; }
.code { margin: 20rpx 0 12rpx; color: #b52637; font-size: 58rpx; font-weight: 800; letter-spacing: 8rpx; }
.expiry { color: #8a949e; font-size: 24rpx; }
.steps { text-align: left; padding-top: 22rpx; border-top: 1rpx solid #edf0f2; }
.error { padding: 24rpx; color: #b52637; background: #fff2f3; border-radius: 14rpx; font-size: 27rpx; }
