/* ===== 页面背景 ===== */
.page-bg {
  background: #F5F6F8;
}

/* ===== 分组卡片 ===== */
.group-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 24rpx 24rpx 0;
  padding: 28rpx 24rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.02);
}

.group-card:last-of-type {
  margin-bottom: 24rpx;
}

/* ===== 分组标题 ===== */
.group-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.group-bar {
  width: 6rpx;
  height: 28rpx;
  background: #34C759;
  border-radius: 4rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.group-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2329;
  letter-spacing: 1rpx;
}

.group-arrow {
  font-size: 32rpx;
  color: #C9CDD4;
  line-height: 1;
}

/* ===== 菜单网格 ===== */
.menu-grid {
  display: flex;
  flex-wrap: wrap;
}

.menu-grid.cols-4 .menu-item {
  width: 25%;
}
.menu-grid.cols-3 .menu-item {
  width: 33.3333%;
}
.menu-grid.cols-5 .menu-item {
  width: 20%;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 8rpx;
  box-sizing: border-box;
}

.menu-item-hover {
  opacity: 0.6;
}

/* ===== 图标方块 ===== */
.menu-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.menu-emoji {
  font-size: 48rpx;
  line-height: 1;
}

/* ===== 文字 ===== */
.menu-name {
  font-size: 26rpx;
  color: #1F2329;
  font-weight: 500;
  margin-top: 16rpx;
  text-align: center;
}

.menu-sub {
  font-size: 22rpx;
  color: #8F959E;
  margin-top: 6rpx;
  text-align: center;
  line-height: 1.2;
}

/* ===== 底部安全区 ===== */
.bottom-safe {
  height: 40rpx;
}

/* ===== 原有：选择分店标签 ===== */
.current-tag {
  font-size: 22rpx;
  color: #5ab464;
  background: rgba(90, 180, 100, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.flex-1 {
  flex: 1;
}
