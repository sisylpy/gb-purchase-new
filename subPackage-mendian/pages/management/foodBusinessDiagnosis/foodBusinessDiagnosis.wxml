<wxs src="/wxs/format.wxs" module="tool" />
<view class="page">
  <back-navbar title="单品经营分析" avatar="/images/back.png" bindnavbuttontap="toBack"></back-navbar>
  <view class="nav-spacer" style="height:{{navBarHeight}}rpx"></view>

  <view class="date-bar" bindtap="toDatePage">
    <image src="/images/calender.png"></image>
    <text class="date-name">{{hanzi}}</text>
    <text wx:if="{{startDate && stopDate}}" class="date-range">{{tool.transferDateString(startDate)}} - {{tool.transferDateString(stopDate)}}</text>
    <text class="date-arrow">›</text>
  </view>

  <view wx:if="{{hasData}}">
    <view class="hero-card">
      <image class="hero-background" src="/images/dish-business/banner.png" mode="widthFix"></image>
      <view class="hero-main">
        <image wx:if="{{food.image}}" class="food-image" src="{{food.image}}" mode="aspectFill"></image>
        <view wx:else class="food-placeholder">菜</view>
        <view class="hero-copy">
          <text class="food-name">{{food.name}}</text>
          <text class="food-tag {{food.tone}}">↗　{{food.status}}</text>
          <text class="food-method">{{food.method}}</text>
        </view>
        <view class="hero-slogan"><text>用数据看清</text><text>每一道菜的经营价值！</text></view>
      </view>

      <view class="margin-grid">
        <view class="margin-card actual"><text class="margin-icon">▂</text><view><text>实际毛利率</text><text>{{food.margin}}<text wx:if="{{food.margin != '—'}}">%</text></text></view></view>
        <view class="margin-card target"><text class="margin-icon">◎</text><view><text>目标区间</text><text>{{food.targetRange}}</text></view></view>
        <view class="margin-card deviation {{food.tone}}"><text class="margin-icon">↗</text><view><text>偏离值</text><text>{{food.deviationLabel}} {{food.deviationValue}}</text></view></view>
      </view>
      <view class="hero-tip"><text>💡</text><text>{{food.conclusion}}</text></view>
    </view>

    <view class="summary panel">
      <view class="section-head"><text class="section-title">▥　经营摘要</text><text class="section-link" bindtap="toCostProblem">查看全部 ›</text></view>
      <view class="summary-grid">
        <view class="summary-card profit-card"><text class="summary-icon">¥</text><text>实际毛利</text><text class="summary-value profit">¥{{food.profit}}</text><text>这道菜赚了</text></view>
        <view class="summary-card cost-card"><text class="summary-icon">▤</text><text>菜品总成本</text><text class="summary-value blue-text">¥{{food.totalCost}}</text><text>制作加损耗</text></view>
        <view class="summary-card waste-card"><text class="summary-icon">◔</text><text>损耗成本</text><text class="summary-value margin">¥{{food.wasteCost}}</text><text>损耗和废弃</text></view>
        <view class="summary-card rhythm-card"><text class="summary-icon">份</text><text>总出品份数</text><text class="summary-value blue-text">{{food.sales}}份</text><text>销售/折扣/赠送/员工餐</text></view>
      </view>
    </view>

    <view class="finance panel">
      <view class="section-head finance-head">
        <text class="section-title">¥　收入与成本</text>
        <text class="section-note">这道菜的钱是怎么算出来的</text>
      </view>

      <view class="finance-step income-step">
        <view class="finance-step-head"><text class="step-number">1</text><text>先算清楚实际收了多少钱</text></view>
        <text class="step-explain">原价应收 − 打折和赠送少收 − 员工餐未收 = 实际收到</text>
        <view class="revenue-detail-grid">
          <view><text>按原价应收</text><text>¥{{food.listRevenue}}</text></view>
          <view class="discount-detail"><text>打折/赠送少收</text><text>−¥{{food.discountConcession}}</text></view>
          <view class="meal-detail"><text>员工餐未收</text><text>−¥{{food.employeeMealConcession}}</text><text>{{food.employeeMealQty}}份</text></view>
          <view class="received-detail"><text>实际收到</text><text>¥{{food.revenue}}</text></view>
        </view>
        <view class="profit-rule"><text>再算利润：</text><text>实际收到 − 做菜总成本 = 最后赚到</text></view>
        <view class="finance-equation three-part">
          <view class="finance-metric revenue-metric"><text class="metric-icon">▤</text><view><text>卖菜收到</text><text>¥{{food.revenue}}</text></view></view>
          <text class="equation-sign">−</text>
          <view class="finance-metric cost-metric"><text class="metric-icon">▣</text><view><text>做菜花掉</text><text>¥{{food.totalCost}}</text></view></view>
          <text class="equation-sign">=</text>
          <view class="finance-metric profit-metric"><text class="metric-icon">▥</text><view><text>最后赚到</text><text>¥{{food.profit}}</text></view></view>
        </view>
        <view wx:if="{{food.employeeMealQty > 0}}" class="employee-meal-tip">
          <text>员工餐做了 {{food.employeeMealQty}}份：少收 ¥{{food.employeeMealConcession}}，做菜还花了 {{food.employeeMealCostText}}，这笔成本已算在总成本里。</text>
        </view>
      </view>

      <view class="finance-step total-step">
        <view class="finance-step-head"><text class="step-number">2</text><text>做菜的钱花在哪里</text></view>
        <text class="step-explain">食材和配料 + 损耗和废弃 = 做菜总成本</text>
        <view class="finance-equation two-part">
          <view class="finance-metric production-metric"><text class="metric-icon">▣</text><view><text>食材和配料</text><text>¥{{food.productionCost}}</text></view></view>
          <text class="equation-sign">+</text>
          <view class="finance-metric waste-metric"><text class="metric-icon">◇</text><view><text>损耗和废弃</text><text>¥{{food.wasteCost}}</text></view></view>
        </view>
        <text class="formula-caption">¥{{food.productionCost}} + ¥{{food.wasteCost}} = 总成本 ¥{{food.totalCost}}</text>
      </view>

      <view class="finance-step portion-step">
        <view class="finance-step-head"><text class="step-number">3</text><text>平均卖出1份要花多少钱</text></view>
        <text class="step-explain">每份食材配料 + 每份损耗废弃 = 一份的总成本</text>
        <view class="finance-equation three-part portion-equation">
          <view class="finance-metric production-metric"><text class="metric-icon">▣</text><view><text>食材配料</text><text>¥{{food.productionPer}}/份</text></view></view>
          <text class="equation-sign">+</text>
          <view class="finance-metric waste-metric"><text class="metric-icon">◇</text><view><text>损耗废弃</text><text>¥{{food.wastePer}}/份</text></view></view>
          <text class="equation-sign">=</text>
          <view class="finance-metric unit-metric"><text class="metric-icon">▤</text><view><text>一份总成本</text><text>¥{{food.costPer}}/份</text></view></view>
        </view>
      </view>
      <view class="cost-detail-btn" bindtap="toCostProblem">查看成本明细 <text>›</text></view>
    </view>

    <view class="chart-panel panel">
      <view class="section-head"><text class="section-title">▥　按星期销售表现</text><text class="section-note">单位：份</text></view>
      <ec-canvas id="weekChart" canvas-id="food-week-chart" ec="{{ecWeek}}" class="week-chart"></ec-canvas>
    </view>

    <view class="advice panel">
      <view class="section-head"><text class="section-title">●　经营建议</text><text class="section-note">基于数据的可执行建议</text></view>
      <view class="advice-grid"><view class="advice-item {{item.tone}}" wx:for="{{recommendations}}" wx:key="title"><text class="advice-icon">{{item.icon}}</text><view><text>{{item.title}}</text><text>{{item.text}}</text></view></view></view>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="empty"><text>本期暂无该菜品诊断数据</text><text bindtap="toDatePage">切换日期查看</text></view>
  <view class="bottom"></view>
</view>
