page{background:#f4fafc;color:#132038}.page{min-height:100vh;background:linear-gradient(180deg,#f9fdff,#f2f9fb)}.date-bar{margin:10rpx 22rpx 16rpx;height:70rpx;border:1rpx solid #d9e6ea;background:#fff;border-radius:13rpx;padding:0 17rpx;display:flex;align-items:center}.date-bar image{width:34rpx;height:34rpx;margin-right:13rpx}.date-name{font-size:27rpx;font-weight:800;margin-right:15rpx}.date-range{font-size:24rpx;color:#53667f;flex:1}.date-bar>text:last-child{font-size:38rpx;color:#5c7189}
.food-card,.section,.diagnosis,.advice{margin:0 22rpx 15rpx;background:#fff;border-radius:22rpx;padding:17rpx;box-sizing:border-box}.food-head{display:flex;align-items:center}.food-head>image,.food-placeholder{width:150rpx;height:100rpx;border-radius:15rpx;margin-right:18rpx;flex-shrink:0}.food-placeholder{display:flex;align-items:center;justify-content:center;background:#e7f8ef;color:#079a66;font-size:37rpx}.food-info{flex:1;min-width:0}.food-info>view{display:flex;align-items:center}.food-name{font-size:32rpx;font-weight:900}.food-tag{margin-left:13rpx;padding:7rpx 12rpx;border-radius:17rpx;background:#fff0d7;color:#dd7100;font-size:20rpx}.food-info>text{display:block;margin-top:11rpx;font-size:23rpx;color:#64758a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.top-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7rpx;margin-top:13rpx}.top-grid>view{height:104rpx;border:1rpx solid #e0e8ec;border-radius:14rpx;padding:12rpx;display:flex;flex-direction:column;box-sizing:border-box}.top-grid>view>text:first-child{font-size:20rpx;color:#53657b}.top-grid>view>text:nth-child(2){font-size:31rpx;font-weight:900;margin-top:8rpx}.top-grid .unit{font-size:19rpx}.profit{color:#ed341e!important}.margin{color:#078a50!important}.blue-text{color:#1767df!important}
.diagnosis{border:2rpx solid #70e5ad}.section-head{display:flex;align-items:center;position:relative;margin-bottom:14rpx}.section-title{font-size:29rpx;font-weight:900}.section-note{font-size:21rpx;color:#6a7b91;margin-left:18rpx}.section-note.right{margin-left:auto}.status{margin-left:auto;background:#e4faec;color:#058b57;border-radius:22rpx;padding:8rpx 15rpx;font-size:20rpx;font-weight:800}.diagnosis-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8rpx}.diagnosis-item{height:180rpx;border-radius:17rpx;padding:14rpx 12rpx;display:flex;flex-direction:column;box-sizing:border-box}.diagnosis-item>text:first-child{font-size:21rpx;font-weight:800}.diagnosis-item .big{font-size:30rpx;font-weight:900;margin:15rpx 0 4rpx}.diagnosis-item>text:nth-child(3){font-size:20rpx}.diagnosis-item>text:last-child{font-size:18rpx;color:#65768a;margin-top:auto}.diagnosis-item.orange{background:#fff6ea}.diagnosis-item.blue{background:#eef8ff}.diagnosis-item.green{background:#edfbf5}.diagnosis-item.purple{background:#f2f1ff}
.income-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8rpx}.income-grid>view{height:88rpx;background:#f7fafc;border:1rpx solid #e4eaee;border-radius:12rpx;display:flex;flex-direction:column;align-items:center;justify-content:center}.income-grid text:first-child{font-size:20rpx;color:#68798d}.income-grid text:last-child{font-size:27rpx;font-weight:900;margin-top:7rpx}.formula{display:grid;grid-template-columns:1fr 36rpx 1fr 36rpx 1fr;align-items:center;border:1rpx solid #e2eaed;border-radius:13rpx;margin-top:10rpx;padding:12rpx}.formula>view{display:flex;flex-direction:column}.formula>view text:first-child{font-size:20rpx;color:#66778c}.formula>view text:last-child{font-size:27rpx;font-weight:900;margin-top:6rpx}.formula>text{text-align:center;font-size:29rpx;color:#8996a7}.week-chart{display:block;width:100%;height:260rpx}.chart-section{padding-bottom:9rpx}
.cost-detail-btn{height:66rpx;margin-top:14rpx;border:2rpx solid #18bd75;border-radius:14rpx;color:#08a55f;font-size:26rpx;font-weight:800;display:flex;align-items:center;justify-content:center;background:#f4fff9}.cost-detail-btn text{font-size:38rpx;margin-left:12rpx;line-height:1}
.advice{border:2rpx solid #75e4ad;background:linear-gradient(110deg,#f0fff7,#fbfffd)}.advice-slogan{margin-left:auto;color:#258f69;font-size:20rpx}.advice-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:11rpx}.advice-item{min-height:118rpx;border-radius:14rpx;padding:13rpx;display:flex}.advice-item.green{background:#edfbf5}.advice-item.orange{background:#fff6e9}.advice-item.yellow{background:#fffbea}.advice-icon{font-size:31rpx;margin-right:10rpx;color:#0ca76d}.advice-item>view{display:flex;flex-direction:column}.advice-item>view text:first-child{font-size:22rpx;font-weight:900}.advice-item>view text:last-child{font-size:19rpx;color:#607188;margin-top:8rpx;line-height:1.45}.empty{height:500rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#64758b;font-size:28rpx}.empty text:last-child{color:#079d66;margin-top:16rpx}.bottom{height:35rpx}
