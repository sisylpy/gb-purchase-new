/* 采购批次行基础样式 */
.purchase-row {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  position: relative;
  justify-content: space-between;
}

.purchase-row::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 6rpx;
  height: 60%;
  background: linear-gradient(180deg, #e3f2fd 0%, #e3f2fd 100%);
  border-radius: 0 6rpx 6rpx 0;
  transform: translateY(-50%);
  transition: all 0.3s ease;
}

/* 激活状态的采购行 */
.purchase-row-active {
  border-color: #4A90E2;
  border-radius: 16rpx 16rpx 0 0 !important;
  border-bottom: none !important;
  box-shadow: none !important;
  transform: translateY(0);
}

.purchase-row-active::before {
  background: linear-gradient(180deg, #4A90E2 0%, #2E7CE6 100%);
}

/* 采购信息卡片 */
.purchase-info-card {
  background: #ffffff !important;
  border: 2rpx solid #4A90E2 !important;
  border-top: none !important;
  border-radius: 0 0 16rpx 16rpx !important;
  padding: 20rpx;
  margin-top: 0 !important;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08) !important;
  position: relative;
  overflow: hidden;
}

/* 采购详细信息区域 */
.purchase-detail-section {
  background: #ffffff;
  border-radius: 8rpx;
  margin-top: 10rpx;
  transition: all 0.3s ease;
  position: relative;
}

/* 采购信息项样式 */
.purchase-info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #e9ecef;
  transition: background-color 0.2s ease;
}

.purchase-info-item:last-child {
  border-bottom: none;
}

.purchase-info-value-amount {
  color: #4A90E2;
  font-weight: 700;
}

/* 箭头动画 */
.arrow-icon {
  transition: transform 0.3s ease-in-out;
}

.arrow-icon.expanded {
  transform: rotate(90deg);
}

.arrow-icon.collapsed {
  transform: rotate(0deg);
}

/* 采购行布局样式 */
.purchase-row .flex-row-default {
  flex: 0 0 120rpx;
  display: flex;
  align-items: center;
}

.purchase-row .flex-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 20rpx;
}

.purchase-row .flex-column-center {
  flex: 0 0 60rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(74, 144, 226, 0.1);
  border-radius: 50%;
  transition: all 0.3s ease;
}

.purchase-row-active .flex-column-center {
  background: rgba(74, 144, 226, 0.2);
}

/* 展开内容动画 */
.expandable-content {
  overflow: hidden;
  transition: all 0.3s ease-in-out;
  opacity: 0;
  max-height: 0;
  transform: translateY(-5rpx);
  margin-top: 0 !important;
  padding-top: 0 !important;
}

.expandable-content.expanded {
  opacity: 1;
  max-height: 2000rpx;
  transform: translateY(0);
  margin-top: 0 !important;
}

/* 库存信息行布局 */
.stock-info-row {
  display: flex;
  align-items: center;
  background: transparent;
  border-radius: 0;
  padding: 16rpx 0;
  margin-bottom: 0;
  box-shadow: none;
  border: none;
}

/* 部门信息区域 */
.stock-department-info {
  flex: 0 0 160rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 12rpx;
  border-right: 1rpx solid #e0e0e0;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 6rpx;
  margin-right: 12rpx;
  min-height: 80rpx;
}

/* 对比容器 */
.stock-comparison-container {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx;
  background: transparent;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

/* 信息列 */
.stock-info-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  border-radius: 6rpx;
  min-height: 80rpx;
}

/* 入库列样式 */
.stock-inbound {
  background: rgba(76, 175, 80, 0.05);
}

/* 剩余列样式 */
.stock-rest {
  background: rgba(255, 152, 0, 0.08);
}

/* 列标签 */
.column-label {
  font-size: 20rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  text-align: center;
}

/* 入库列标签 */
.stock-inbound .column-label {
  color: #4CAF50;
}

/* 剩余列标签 */
.stock-rest .column-label {
  color: #FF9800;
  font-weight: 700;
  font-size: 22rpx;
}

/* 列内容 */
.column-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

/* 金额文本 */
.amount-text {
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.2;
}

.stock-inbound .amount-text {
  color: #4CAF50;
}

.rest-amount {
  color: #FF9800 !important;
  font-size: 24rpx !important;
  font-weight: 600 !important;
}

/* 重量文本 */
.weight-text {
  font-size: 20rpx;
  text-align: center;
  font-weight: 500;
  line-height: 1.2;
}

.stock-inbound .weight-text {
  color: #4CAF50;
}

.rest-weight {
  color: #FF9800 !important;
  font-size: 20rpx !important;
  font-weight: 500 !important;
}

/* 分隔线 */
.comparison-divider {
  width: 1rpx;
  height: 50rpx;
  background: #e0e0e0;
  margin: 0 8rpx;
}

/* 订单信息卡片样式 */
.order-info-card {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 20rpx;
  margin: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  overflow: hidden;
  position: relative;
  backdrop-filter: blur(10rpx);
}

.order-info-header {
  position: relative;
  padding: 20rpx 30rpx 15rpx 30rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
}

.order-info-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #FF6B6B 0%, #4ECDC4 50%, #45B7D1 100%);
  border-radius: 20rpx 20rpx 0 0;
}

.order-info-title {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10rpx;
}

.order-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  position: relative;
  padding-bottom: 8rpx;
}

.order-title-text::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 3rpx;
  background: linear-gradient(90deg, transparent 0%, #4A90E2 50%, transparent 100%);
}

/* 订单信息内容区域 */
.order-info-content {
  padding: 0 30rpx 30rpx 30rpx;
}

/* 订单信息项 */
.order-info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.order-info-item:last-child {
  border-bottom: none;
}

.order-info-item:hover {
  background: rgba(74, 144, 226, 0.03);
  border-radius: 12rpx;
  padding: 20rpx 15rpx;
  margin: 0 -15rpx;
}

/* 高亮项 */
.order-info-item.highlight-item {
  background: linear-gradient(135deg, rgba(74, 144, 226, 0.05) 0%, rgba(74, 144, 226, 0.02) 100%);
  border-radius: 12rpx;
  padding: 25rpx 15rpx;
  margin: 10rpx -15rpx;
  border: 1rpx solid rgba(74, 144, 226, 0.1);
}

.order-info-label {
  flex: 0 0 140rpx;
  display: flex;
  align-items: center;
}

.label-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.order-info-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.supplier-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.supplier-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.supplier-avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(74, 144, 226, 0.2);
}

.time-value {
  font-size: 26rpx;
  color: #4A90E2;
  font-weight: 500;
}

.amount-value {
  font-size: 36rpx;
  color: #4A90E2;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(74, 144, 226, 0.1);
}

.bill-type-text {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  background: #f8f9fa;
  color: #6c757d;
  border: 1rpx solid #e9ecef;
}

/* 商品价格区域 */
.goods-price-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.price-container {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  background: linear-gradient(135deg, #f8f9ff 0%, #e6f0ff 100%);
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(74, 144, 226, 0.1);
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 226, 0.05);
  transition: all 0.3s ease;
}

.price-label {
  font-size: 20rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.price-value {
  font-size: 28rpx;
  color: #4A90E2;
  font-weight: 700;
  line-height: 1.2;
}

.arrow-container {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(74, 144, 226, 0.1);
  border-radius: 50%;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.arrow-container:hover {
  background: rgba(74, 144, 226, 0.2);
  border-color: rgba(74, 144, 226, 0.3);
  transform: scale(1.05);
}

.arrow-container.expanded {
  background: rgba(74, 144, 226, 0.2);
  border-color: rgba(74, 144, 226, 0.3);
}

.arrow-container .arrow-icon {
  transition: transform 0.3s ease-in-out;
}

.arrow-container.expanded .arrow-icon {
  transform: rotate(90deg);
}

.arrow-container.collapsed .arrow-icon {
  transform: rotate(0deg);
}

/* 商品图片 */
.goods-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background-color: #f5f5f5;
}

/* 采购日期 */
.purchase-date {
  font-size: 24rpx;
  color: #666;
}

.purchase-type {
  font-size: 24rpx;
  color: #666;
  background-color: #e3f2fd;
  border-radius: 25rpx;
  text-align: center;
}

/* 采购批次行容器 */
.purchase-row-container {
  transition: all 0.3s ease-in-out;
  position: relative;
}
