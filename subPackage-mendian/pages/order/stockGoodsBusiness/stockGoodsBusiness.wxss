.sgb-page {
  min-height: 100vh;
  background: #f3f4f6;
}

.sgb-filter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #ececec;
}

.sgb-filter__left {
  display: flex;
  align-items: center;
  flex: 1;
}

.sgb-filter__icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.sgb-filter__text {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.sgb-filter__hint {
  color: #999;
}

.sgb-filter__search {
  padding: 12rpx;
}

.sgb-scroll {
  width: 100%;
}

.sgb-list {
  padding: 20rpx 24rpx 0;
}

.sgb-scroll__foot {
  height: 40rpx;
}

.sgb-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.sgb-empty__img {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.6;
}

.sgb-empty__text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

.sgb-card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.sgb-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 20rpx;
}

.sgb-card__title {
  display: flex;
  align-items: baseline;
}

.sgb-card__title-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.sgb-card__title-date {
  margin-left: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.sgb-card__tag {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #1890ff;
  background: #e6f4ff;
  border-radius: 24rpx;
}

.sgb-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 24rpx 20rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 16rpx;
  overflow: hidden;
}

.sgb-grid__cell {
  box-sizing: border-box;
  width: 50%;
  padding: 20rpx 24rpx;
  border-right: 1rpx solid #e8e8e8;
  border-bottom: 1rpx solid #e8e8e8;
}

.sgb-grid__cell:nth-child(2n) {
  border-right: none;
}

.sgb-grid__cell:nth-child(3),
.sgb-grid__cell:nth-child(4) {
  border-bottom: none;
}

.sgb-grid__label {
  display: block;
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

.sgb-grid__val {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.2;
}

.sgb-grid__val--active {
  color: #05c0a7;
}

.sgb-waste-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 16rpx;
  padding: 12rpx 20rpx;
  font-size: 22rpx;
  color: #f58d8d;
  background: #fff5f5;
  border-radius: 12rpx;
}

.sgb-waste-tip__time {
  color: #999;
}

.sgb-section {
  padding: 8rpx 24rpx 24rpx;
}

.sgb-section__title {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.sgb-section__bar {
  width: 6rpx;
  height: 28rpx;
  margin-right: 12rpx;
  background: #1890ff;
  border-radius: 3rpx;
}

.sgb-outcome {
  border: 1rpx solid #ececec;
  border-radius: 16rpx;
  overflow: hidden;
}

.sgb-outcome__row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.sgb-outcome__row--last {
  border-bottom: none;
}

.sgb-outcome__label {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  width: 140rpx;
  font-size: 26rpx;
  color: #333;
}

.sgb-outcome__dot {
  width: 20rpx;
  height: 20rpx;
  margin-right: 12rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.sgb-outcome__dot--sale {
  background: #05c0a7;
}

.sgb-outcome__dot--loss {
  background: #d4f34c;
}

.sgb-outcome__dot--waste {
  background: #f58d8d;
}

.sgb-outcome__dot--meal {
  background: #ff9f43;
}

.sgb-outcome__dot--return {
  background: #bda6e2;
}

.sgb-outcome__content {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  min-height: 40rpx;
}

.sgb-outcome__empty {
  font-size: 24rpx;
  color: #bbb;
}

.sgb-pill-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  margin: 0 16rpx 12rpx 0;
}

.sgb-pill {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  border-radius: 32rpx;
  line-height: 1.3;
}

.sgb-pill--sale {
  color: #058f7c;
  background: #e6faf7;
}

.sgb-pill--loss {
  color: #7a9200;
  background: #f4fce0;
}

.sgb-pill--waste {
  color: #d9534f;
  background: #fff0f0;
}

.sgb-pill--meal {
  color: #e67e22;
  background: #fff4e6;
}

.sgb-pill--return {
  color: #8e6bb8;
  background: #f3ecfa;
}

.sgb-pill__del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sgb-pill__del-icon {
  width: 36rpx;
  height: 36rpx;
}

.sgb-pill__del--hover {
  opacity: 0.7;
}
