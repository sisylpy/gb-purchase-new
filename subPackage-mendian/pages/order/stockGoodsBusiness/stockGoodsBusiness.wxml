<wxs src="/wxs/format.wxs" module="tool" />

<view class="sgb-page flex flex-column">
  <back-navbar
    style="height: {{navBarHeight}}rpx;"
    title="{{navTitle || goodsName}}"
    avatar="/images/back-gray.png"
    button-text="设置"
    bindnavbuttontap="toBack"
  />

  <view class="sgb-filter">
    <view class="sgb-filter__left" bindtap="toDatePage">
      <image src="/images/calender.png" class="sgb-filter__icon" mode="aspectFit" />
      <view class="sgb-filter__text">
        <text wx:if="{{dateFilterActive && startDate == stopDate}}">{{tool.transferDateString(startDate)}}</text>
        <text wx:elif="{{dateFilterActive}}">{{tool.transferDateString(startDate)}} - {{tool.transferDateString(stopDate)}}</text>
        <text wx:else class="sgb-filter__hint">有库存批次</text>
      </view>
    </view>
    <view class="sgb-filter__search" bindtap="toDate">
      <image src="/images/search-3.png" class="sgb-filter__icon" mode="aspectFit" />
    </view>
  </view>

  <scroll-view
    scroll-y
    class="sgb-scroll"
    style="height: {{windowHeight - navBarHeight - 88}}rpx;"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view wx:if="{{stockArr.length == 0}}" class="sgb-empty">
      <image class="sgb-empty__img" src="/images/cart-Empty.png" mode="aspectFill" />
      <text class="sgb-empty__text">暂无库存批次</text>
    </view>

    <view class="sgb-list" wx:else>
      <view class="sgb-card" wx:for="{{stockArr}}" wx:key="gbDepartmentGoodsStockId">
        <view class="sgb-card__head">
          <view class="sgb-card__title">
            <text class="sgb-card__title-label">入库批次</text>
            <text class="sgb-card__title-date">{{tool.getAttrDateString(item.gbDgsDate)}}</text>
          </view>
          <view class="sgb-card__tag" wx:if="{{item.nxJrdhSupplierEntity}}">
            订货 · {{item.nxJrdhSupplierEntity.nxJrdhsSupplierName}}
          </view>
          <view class="sgb-card__tag" wx:else>自采 · {{mendianName}}</view>
        </view>

        <view class="sgb-grid">
          <view class="sgb-grid__cell">
            <text class="sgb-grid__label">单价 (元/{{goodsUnit}})</text>
            <text class="sgb-grid__val">{{item.gbDgsPrice}}元/{{goodsUnit}}</text>
          </view>
          <view class="sgb-grid__cell">
            <text class="sgb-grid__label">进货 ({{goodsUnit}})</text>
            <text class="sgb-grid__val">{{item.gbDgsWeight}}{{goodsUnit}}</text>
          </view>
          <view class="sgb-grid__cell">
            <text class="sgb-grid__label">金额 (元)</text>
            <text class="sgb-grid__val">{{item.gbDgsSubtotal}}元</text>
          </view>
          <view class="sgb-grid__cell">
            <text class="sgb-grid__label">库存 ({{goodsUnit}})</text>
            <text class="sgb-grid__val {{item.gbDgsRestWeight > 0 ? 'sgb-grid__val--active' : ''}}">{{item.gbDgsRestWeight}}{{goodsUnit}}</text>
          </view>
        </view>

        <view
          class="sgb-waste-tip"
          wx:if="{{item.gbDgsWasteFullTime !== null && item.gbDgsWasteFullTime !== ''}}"
        >
          <text>废弃剩余 {{tool.getRestTime(item.gbDgsWasteFullTime, nowTime)}} 小时</text>
          <text class="sgb-waste-tip__time">{{tool.getAttrFullTime(item.gbDgsWasteFullTime)}}</text>
        </view>

        <view class="sgb-section">
          <view class="sgb-section__title">
            <view class="sgb-section__bar"></view>
            <text>本批次去向</text>
          </view>

          <view class="sgb-outcome">
            <view class="sgb-outcome__row">
              <view class="sgb-outcome__label">
                <view class="sgb-outcome__dot sgb-outcome__dot--sale"></view>
                <text>销售</text>
              </view>
              <view class="sgb-outcome__content">
                <block wx:if="{{item._produceList.length > 0}}">
                  <view
                    class="sgb-pill-wrap"
                    wx:for="{{item._produceList}}"
                    wx:for-item="reduce"
                    wx:key="gbDepartmentGoodsStockReduceId"
                  >
                    <view class="sgb-pill sgb-pill--sale">
                      <text>{{tool.getAttrDateString(reduce.gbDgsrDate)}} {{reduce.gbDgsrWeight}}{{goodsUnit}}</text>
                    </view>
                    <view
                      wx:if="{{today == reduce.gbDgsrDate}}"
                      class="sgb-pill__del"
                      bindtap="deleteReduce"
                      data-id="{{reduce.gbDepartmentGoodsStockReduceId}}"
                      data-date="{{reduce.gbDgsrDate}}"
                      hover-class="sgb-pill__del--hover"
                    >
                      <image class="sgb-pill__del-icon" src="/images/delok.png" mode="aspectFill" />
                    </view>
                  </view>
                </block>
                <text wx:else class="sgb-outcome__empty">暂无</text>
              </view>
            </view>

            <view class="sgb-outcome__row">
              <view class="sgb-outcome__label">
                <view class="sgb-outcome__dot sgb-outcome__dot--loss"></view>
                <text>损耗</text>
              </view>
              <view class="sgb-outcome__content">
                <block wx:if="{{item._lossList.length > 0}}">
                  <view
                    class="sgb-pill-wrap"
                    wx:for="{{item._lossList}}"
                    wx:for-item="reduce"
                    wx:key="gbDepartmentGoodsStockReduceId"
                  >
                    <view class="sgb-pill sgb-pill--loss">
                      <text>{{tool.getAttrDateString(reduce.gbDgsrDate)}} {{reduce.gbDgsrWeight}}{{goodsUnit}}</text>
                    </view>
                    <view
                      wx:if="{{today == reduce.gbDgsrDate}}"
                      class="sgb-pill__del"
                      bindtap="deleteReduce"
                      data-id="{{reduce.gbDepartmentGoodsStockReduceId}}"
                      data-date="{{reduce.gbDgsrDate}}"
                      hover-class="sgb-pill__del--hover"
                    >
                      <image class="sgb-pill__del-icon" src="/images/delok.png" mode="aspectFill" />
                    </view>
                  </view>
                </block>
                <text wx:else class="sgb-outcome__empty">暂无</text>
              </view>
            </view>

            <view class="sgb-outcome__row">
              <view class="sgb-outcome__label">
                <view class="sgb-outcome__dot sgb-outcome__dot--waste"></view>
                <text>废弃</text>
              </view>
              <view class="sgb-outcome__content">
                <block wx:if="{{item._wasteList.length > 0}}">
                  <view
                    class="sgb-pill-wrap"
                    wx:for="{{item._wasteList}}"
                    wx:for-item="reduce"
                    wx:key="gbDepartmentGoodsStockReduceId"
                  >
                    <view class="sgb-pill sgb-pill--waste">
                      <text>{{tool.getAttrDateString(reduce.gbDgsrDate)}} {{reduce.gbDgsrWeight}}{{goodsUnit}}</text>
                    </view>
                    <view
                      wx:if="{{today == reduce.gbDgsrDate}}"
                      class="sgb-pill__del"
                      bindtap="deleteReduce"
                      data-id="{{reduce.gbDepartmentGoodsStockReduceId}}"
                      data-date="{{reduce.gbDgsrDate}}"
                      hover-class="sgb-pill__del--hover"
                    >
                      <image class="sgb-pill__del-icon" src="/images/delok.png" mode="aspectFill" />
                    </view>
                  </view>
                </block>
                <text wx:else class="sgb-outcome__empty">暂无</text>
              </view>
            </view>

            <view class="sgb-outcome__row">
              <view class="sgb-outcome__label">
                <view class="sgb-outcome__dot sgb-outcome__dot--meal"></view>
                <text>员工餐</text>
              </view>
              <view class="sgb-outcome__content">
                <block wx:if="{{item._mealList.length > 0}}">
                  <view
                    class="sgb-pill-wrap"
                    wx:for="{{item._mealList}}"
                    wx:for-item="reduce"
                    wx:key="gbDepartmentGoodsStockReduceId"
                  >
                    <view class="sgb-pill sgb-pill--meal">
                      <text>{{tool.getAttrDateString(reduce.gbDgsrDate)}} {{reduce.gbDgsEmployeeMealWeight || reduce.gbDgsrWeight}}{{goodsUnit}}</text>
                    </view>
                    <view
                      wx:if="{{today == reduce.gbDgsrDate}}"
                      class="sgb-pill__del"
                      bindtap="deleteReduce"
                      data-id="{{reduce.gbDepartmentGoodsStockReduceId}}"
                      data-date="{{reduce.gbDgsrDate}}"
                      hover-class="sgb-pill__del--hover"
                    >
                      <image class="sgb-pill__del-icon" src="/images/delok.png" mode="aspectFill" />
                    </view>
                  </view>
                </block>
                <text wx:else class="sgb-outcome__empty">暂无</text>
              </view>
            </view>

            <view class="sgb-outcome__row sgb-outcome__row--last">
              <view class="sgb-outcome__label">
                <view class="sgb-outcome__dot sgb-outcome__dot--return"></view>
                <text>退货</text>
              </view>
              <view class="sgb-outcome__content">
                <block wx:if="{{item._returnList.length > 0}}">
                  <view
                    class="sgb-pill-wrap"
                    wx:for="{{item._returnList}}"
                    wx:for-item="reduce"
                    wx:key="gbDepartmentGoodsStockReduceId"
                  >
                    <view class="sgb-pill sgb-pill--return">
                      <text>{{tool.getAttrDateString(reduce.gbDgsrDate)}} {{reduce.gbDgsrWeight}}{{goodsUnit}}</text>
                    </view>
                    <view
                      wx:if="{{reduce.gbDgsrStatus == '-1' || reduce.gbDgsrStatus == '2'}}"
                      class="sgb-pill__del"
                      bindtap="deleteReduce"
                      data-id="{{reduce.gbDepartmentGoodsStockReduceId}}"
                      data-date="{{reduce.gbDgsrDate}}"
                      hover-class="sgb-pill__del--hover"
                    >
                      <image class="sgb-pill__del-icon" src="/images/delok.png" mode="aspectFill" />
                    </view>
                  </view>
                </block>
                <text wx:else class="sgb-outcome__empty">暂无</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="sgb-scroll__foot"></view>
  </scroll-view>
</view>

<stockGoods
  show="{{showStock}}"
  bindconfirm="confirmStock"
  bindupdateStars="updateStars"
  item="{{item}}"
  disGoods="{{disGoods}}"
  bindcancle="cancle"
  windowHeight="{{windowHeight}}"
  windowWidth="{{windowWidth}}"
  consultItem="{{item}}"
  nowTime="{{nowTime}}"
  src="{{src}}"
  reason="{{reason}}"
  canWaste="{{canWaste}}"
  canSure="{{canSure}}"
  showType="{{showType}}"
  resultTime="{{resultTime}}"
  url="{{url}}"
/>

<stockStar
  show="{{showStar}}"
  bindconfirm="confirmStar"
  bindupdateStars="updateStars"
  binddelAttem="delAttem"
  item="{{item}}"
  disGoods="{{disGoods}}"
  bindcancle="cancle"
  windowHeight="{{windowHeight}}"
  windowWidth="{{windowWidth}}"
  consultItem="{{item}}"
  nowTime="{{nowTime}}"
  src="{{src}}"
  reason="{{reason}}"
  canWaste="{{canWaste}}"
  canSure="{{canSure}}"
  showType="{{showType}}"
  resultTime="{{resultTime}}"
  url="{{url}}"
/>
