



.ai-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #fff6df;
}

.ai-bubble {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ai-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}




.goods_url{
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  
}

.bg_back{
  background-color: #fff6df;

}

.empty-bg {
  background-image: url('https://grainservice.club:8443/nongxinle/uploadImage/ChatLogo3.png');
  background-size: cover;
  background-repeat: no-repeat;
}

/* 左侧缩略图 + 右侧详情：详情区可收缩，长文案自动换行 */
.customer-ai-card-inner {
  width: 100%;
  box-sizing: border-box;
}

.customer-ai-thumb-wrap {
  flex-shrink: 0;
}

.customer-ai-detail {
  flex: 1;
  min-width: 0;
  width: 0;
}

.customer-ai-title-name {
  flex: 1;
  min-width: 0;
}

.customer-ai-title-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  width: 100%;
}

.customer-ai-wrap-text {
  word-break: break-word;
  overflow-wrap: break-word;
}

.customer-ai-remind-chip {
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  background: #ffe4e1;
  color: #c0392b;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.customer-ai-line {
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  width: 100%;
}

.customer-ai-line-prefix {
  flex-shrink: 0;
  margin-right: 20rpx;
  line-height: 1.5;
}

.customer-ai-line-body {
  flex: 1;
  min-width: 0;
  line-height: 1.5;
  word-break: break-word;
  overflow-wrap: break-word;
}

/* 补货参考内整行文案（无左侧图标） */
.customer-ai-block-line {
  width: 100%;
  box-sizing: border-box;
  line-height: 1.5;
  word-break: break-word;
  overflow-wrap: break-word;
}

.goods_back{
  background-color: rgb(255, 251, 242);
  border: 2px solid rgb(214, 210, 191);
  border-radius: 30rpx;
}

.save_btn{
  background-color: #f08308;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 20rpx;
  padding: 10rpx 40rpx;
}

.pack-spec {
  color: #888;
  font-size: 28rpx;
  margin-left: 6rpx;
}