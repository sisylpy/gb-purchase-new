<wxs src="../../../../utils/orderGoodsFmt.wxs" module="fmt" />

<view class="flex flex-column">


  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{depInfo.gbDepartmentName || depInfo.nxDepartmentName}}-订货习惯" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>


  <block wx:if="{{depGoodsArr.length == 0}}">

    <view class="flex-column center-content" style="height: {{windowHeight  - navBarHeight}}rpx; background:#fff6df">

      <view wx:if="{{showSkeleton}}" class="ai-loading">
        <view animation="{{fadeAnimation}}" class="ai-bubble">
          <text class="loading-text">分析订货习惯中{{dots}}</text>
        </view>
      </view>
      <view class="flex flex-column center-content" wx:else="">
        <image class="empty-bg" style="width: {{windowWidth / 3}}rpx; height: {{windowHeight / 5}}rpx; margin-bottom: 40rpx;"></image>
        <text class="font-xl " style="padding: 0 60rpx;">根据历史到货周期、商品稳定度和相似订货篮子推算今天优先补货的商品</text>
        <text class=" darktext-secondary mt-10">到货完成订单越多，补货状态推断越稳</text>
        <text class=" darktext-secondary">有未收货订单的商品不会出现在此列表</text>
        <text class=" darktext-secondary mt-10">推荐数量会参考相似历史订单的商品数量动态收敛</text>
        <text class=" darktext-secondary mt-10">历史不足时，可能附带「单次到货+库存偏紧」的安全提醒</text>
      </view>

    </view>
  </block>
  <view wx:else="" class="flex-column p-20">

    <view class="flex-row goods_back mb-10" wx:for="{{depGoodsArr}}" wx:key="gbDepartmentDisGoodsId">
      <view class="flex-row-default p-20 customer-ai-card-inner">

        <view class="flex-row-default mr-20 customer-ai-thumb-wrap">
          <image class="goods_url" src="{{url + item.gbDistributerGoodsEntity.gbDgNxFatherImg}}" mode="aspectFit" />
           </view>

        <view class="flex-column font-lg customer-ai-detail">
          <view class="customer-ai-title-row">
            <text class="font-lg-2 customer-ai-wrap-text customer-ai-title-name">{{item.gbDdgDepGoodsName}}</text>
            <text class="font-md gray pack-spec" wx:if="{{item.gbDistributerGoodsEntity && fmt.packSpec(item.gbDistributerGoodsEntity)}}">{{fmt.packSpec(item.gbDistributerGoodsEntity)}}</text>
            <text wx:if="{{item.aiShouldRemindToday === 'true'}}" class="font-sl customer-ai-remind-chip">今日提醒</text>
          </view>
          <view class="customer-ai-line font-sl">
            <text class="customer-ai-line-prefix">🛒</text>
            <view class="customer-ai-line-body">
              <text class="mr-10">{{item.aiPredictionState ? '建议订货量:' : '习惯参考订货量:'}}</text>
              <text style="font-weight:bold; color:#FF8C00">{{item.aiOrderQuantity}}</text>
              <text style="font-weight:bold; color:#FF8C00"> {{item.aiOrderStandard}}</text>
            </view>
          </view>
          <view class="customer-ai-line font-sl" wx:if="{{item.aiPredictionState}}">
            <text class="customer-ai-line-prefix">🎯</text>
            <view class="customer-ai-line-body">
              <text class="customer-ai-wrap-text">{{item.aiPredictionStateText}}</text>
              <text wx:if="{{item.aiIntervalRangeDays}}"> · 周期范围 {{item.aiIntervalRangeDays}}</text>
              <text wx:if="{{item.aiPredictionRank}}"> · 优先 {{item.aiPredictionRank}}/{{item.aiPredictionBasketCapacity}}</text>
              <text wx:if="{{item.aiPredictionConfidence}}"> · 匹配度 {{item.aiPredictionConfidence}}%</text>
            </view>
          </view>
          <view class="customer-ai-line font-sl" wx:if="{{item.aiStockEstimateDailyUsage}}">
            <text class="customer-ai-line-prefix">📐</text>
            <view class="customer-ai-line-body">
              <text class="mr-10">单次到货·估算日均消耗:</text>
              <text class="customer-ai-wrap-text">{{item.aiStockEstimateDailyUsage}}</text>
            </view>
          </view>
          <view class="customer-ai-line font-sl">
            <text class="customer-ai-line-prefix">🕓</text>
            <view class="customer-ai-line-body">
              <text class="mr-10">上次到货:</text>
              <text>{{item.aiLastOrderDate || '—'}}</text>
              <text class="ml-10" wx:if="{{item.aiLastOrderQuantity}}">{{item.aiLastOrderQuantity}}{{item.aiLastOrderUnit}}</text>
              <text class="ml-10" wx:if="{{item.aiDaysSinceLastOrder !== '' && item.aiDaysSinceLastOrder != null}}">（{{item.aiDaysSinceLastOrder}} 天前）</text>
            </view>
          </view>
          <view class="customer-ai-line font-sl">
            <text class="customer-ai-line-prefix">📦</text>
            <view class="customer-ai-line-body">
              <text class="mr-10">现在库存:</text>
              <text>{{item.aiCurrentStock || item.gbDdgStockTotalWeight}}{{item.gbDdgOrderStandard}}</text>
            </view>
          </view>
          <view class="flex-column font-sl mt-10" wx:if="{{item.aiAuxHints && item.aiAuxHints.length}}">
            <view class="customer-ai-line" wx:for="{{item.aiAuxHints}}" wx:for-item="hint" wx:for-index="hintIdx" wx:key="hintIdx">
              <text class="customer-ai-line-prefix">💡</text>
              <view class="customer-ai-line-body">
                <text class="customer-ai-wrap-text" style="color:#856404;">{{hint.message}}</text>
              </view>
            </view>
          </view>

          <view class="flex-row-reverse p-10">

            <view class="save_btn text-center" bind:tap="applyGoodsDep" data-index="{{index}}" data-depgoods="{{item}}" data-disgoods="{{item.gbDistributerGoodsEntity}}">
              <text>订货</text>
            </view>

          </view>
        </view>

      </view>


    </view>
    <view class="p-20 flex-column-center" style="height: 100rpx;" wx:if="{{!hasMore}}">没有更多数据了！</view>
  </view>
</view>

 
<myDismodal show="{{show}}" bindconfirm="confirm" bindcancle="cancle" binddelApply="delApply" binddelStandard="delStandard" bindconfirmStandard="confirmStandard" applyStandardName="{{applyStandardName}}" applyNumber="{{applyNumber}}" hasStock="{{hasStock}}" applySubtotal="{{applySubtotal}}" applyRemark="{{applyRemark}}" editApply="{{editApply}}" expectPrice="{{expectPrice}}" navBarHeight="{{navBarHeight}}" windowWidth="{{windowWidth}}" bindchangeStandard="changeStandard" applyGoodsName="{{applyGoodsName}}" item="{{itemDis}}" canSave="{{canSave}}" windowHeight="{{windowHeight}}" />

<!--  -->
