.table{
  border: 1px solid rgb(201, 201, 201);
  border-radius: 10rpx;
  background-color: #fff;
  
}

.sentence{
  border: 1px solid lightgray;
  border-radius: 20rpx;
  font-size: 32rpx;
  line-height: 60rpx;

}

.sentence.is-active{

  border: 1px solid #147062;
}


textarea {
  border: 2rpx solid #00c48c;
  border-radius: 18rpx;
  background: #f8fefc;
}

/* 在 WXSS 文件中 */
.bg-color-even {
  background-color: #f9f9f9; /* 偶数行背景色 */
}

.bg-color-odd {
  background-color: #ffffff; /* 奇数行背景色 */
}

.input{
  border: 1px solid rgb(190, 190, 190);
  border-radius: 10rpx;
  padding: 10rpx 10rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.10);
  height: 180rpx;
  padding: 0;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
}

.bottom-btn {
  flex: 1;
  margin: 0 8rpx;
  background: #00c48c;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.10);
  padding: 0;
  height: 80rpx;
  line-height: 80rpx;
  border: none;
  font-weight: 500;
  letter-spacing: 2rpx;
  transition: background 0.2s, color 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-btn.main {
  background: #0091FF;
}

.bottom-btn:active {
  background: #009e6d;
}

.middle-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin: 32rpx 0 16rpx 0;
}

.middle-btn {
  flex: 1;
  margin: 0 16rpx;
  background: #fff;
  color: #00c48c;
  font-size: 30rpx;
  border-radius: 40rpx;
  border: 2rpx solid #00c48c;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  padding: 18rpx 0;
  transition: background 0.2s, color 0.2s;
}

.middle-btn.main {
  background: #00c48c;
  color: #fff;
  border: none;
}

.middle-btn:active {
  background: #009e6d;
  color: #fff;
}

.page-bg {
  min-height: 100vh;
  background-image: url('https://grainservice.club:8443/nongxinle/uploadImage/ChatVoice.png');
  background-size: cover;
  background-repeat: no-repeat;
  background-position: center;
  box-sizing: border-box;
}

.paste-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 20rpx;
  box-sizing: border-box;
  min-height: 0;
}

.bottom-btns {
  display: flex;
  flex-direction: row;
  /* justify-content: space-around; */
  /* align-items: center; */
  margin: 32rpx 0;

}

.circle-btn-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pulse-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 140rpx;   /* 比按钮略大 */
  height: 140rpx;
  margin-left: -70rpx;
  margin-top: -70rpx;
  border-radius: 50%;
  background: rgba(92,36,117,0.15);
  animation: pulse-breath 1.2s infinite;
  pointer-events: none; /* 关键：不拦截点击 */
  z-index: 1;
}
@keyframes pulse-breath {
  0%   { transform: scale(1); opacity: 0.7; }
  50%  { transform: scale(1.15); opacity: 0.25; }
  100% { transform: scale(1); opacity: 0.7; }
}
.circle-btn {
  position: relative;
  z-index: 2;
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eee;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.10);
}

.circle-btn.orange { background: #FF9800; }
.circle-btn.green  { background: #4CAF50; }
.circle-btn.yellow { background: #FFD600; }
.circle-btn.red    { background: #F44336; }
.circle-btn.blue    { background: #009e6d; }

.circle-btn.white    { background: #ffffff; border: 1px solid gray; }
.btn-icon {
  width: 72rpx;
  height: 72rpx;
}

.input-area {
  display: flex;
  flex-direction: column;
}

/* 解析后订单列表 */
.order-list-scroll {
  width: 100%;
  box-sizing: border-box;
}

.order-list-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #e3ebe8;
}

.order-list-head {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(180deg, #f3faf8 0%, #edf6f3 100%);
  border-bottom: 1rpx solid #dce8e4;
}

.order-list-head-index,
.order-list-head-name,
.order-list-head-qty,
.order-list-head-unit,
.order-list-head-op {
  font-size: 28rpx;
  font-weight: 600;
  color: #147062;
}

.order-list-head-index {
  width: 48rpx;
  flex-shrink: 0;
  text-align: center;
}

.order-list-head-name {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.order-list-head-qty {
  width: 112rpx;
  flex-shrink: 0;
  text-align: center;
  margin-right: 12rpx;
}

.order-list-head-unit {
  width: 96rpx;
  flex-shrink: 0;
  text-align: center;
}

.order-list-head-op {
  width: 96rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  text-align: center;
}

.order-list-item {
  border-bottom: 1rpx solid #f0f3f2;
}

.order-list-item:last-child {
  border-bottom: none;
}

.order-list-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  min-height: 104rpx;
  box-sizing: border-box;
}

.order-list-index {
  width: 48rpx;
  flex-shrink: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: #8aa39c;
  text-align: center;
  line-height: 1;
}

.order-list-input {
  font-size: 38rpx;
  font-weight: 500;
  color: #1a1a1a;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 16rpx;
  background: #f8fbf9;
  border: 1rpx solid #d8e5e0;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.order-list-input-name {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.order-list-input-qty {
  width: 112rpx;
  flex-shrink: 0;
  text-align: center;
  margin-right: 12rpx;
}

.order-list-input-unit {
  width: 96rpx;
  flex-shrink: 0;
  text-align: center;
}

.order-list-more {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef3f1;
  border-radius: 50%;
}

.order-list-more-icon {
  width: 32rpx;
  height: 32rpx;
}

.order-list-remark {
  display: flex;
  align-items: center;
  padding: 0 24rpx 20rpx 72rpx;
}

.order-list-remark-label {
  flex-shrink: 0;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #888;
}

.order-list-input-remark {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
}

.order-list-tip {
  padding: 24rpx 8rpx 8rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
  line-height: 1.6;
}

.order-list-tip--saved {
  padding: 24rpx 8rpx 8rpx;
}

/* 匹配保存后的只读列表 */
.order-list-row--saved {
  min-height: 112rpx;
}

.order-list-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 500;
  color: #1a1a1a;
  text-align: center;
  line-height: 1.3;
}

.order-list-cell-name {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  justify-content: flex-start;
  flex-direction: column;
  align-items: flex-start;
}

.order-list-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #1a1a1a;
  word-break: break-all;
}

.order-list-badge {
  display: inline-block;
  margin-bottom: 6rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #e65100;
  background: #fff3e0;
  border-radius: 8rpx;
}

.order-list-cell-qty {
  width: 112rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.order-list-cell-unit {
  width: 96rpx;
  flex-shrink: 0;
}

.order-list-cell-op {
  width: 96rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.order-list-find-btn {
  padding: 10rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: #ff7043;
  border-radius: 999rpx;
  line-height: 1.2;
}

.order-list-find-btn--active {
  opacity: 0.85;
}

.order-list-matched-tag {
  font-size: 24rpx;
  font-weight: 600;
  color: #2e7d32;
}

.order-list-item--unmatched {
  background: #fffaf7;
}

.order-list-item--matched {
  background: #fff;
}

.order-list-remark--saved {
  padding-top: 0;
  padding-left: 72rpx;
}

.order-list-remark-text {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  color: #666;
  word-break: break-all;
}

.bottom-btn-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.parsing-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.parsing-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 60rpx;
  font-size: 30rpx;
  color: #333;
}

/* 说明弹窗样式 */
.explanation-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 600rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
  z-index: 1001;
}

.explanation-content {
  max-height: 400rpx;
  overflow-y: auto;
  line-height: 1.6;
}

.btn {
  padding: 20rpx 40rpx;
  border-radius: 10rpx;
  text-align: center;
  font-size: 28rpx;
  border: none;
  cursor: pointer;
}

.btn-primary {
  background: #00c48c;
  color: white;
}

.btn-secondary {
  background: #f5f5f5;
  color: #666;
  border: 1rpx solid #ddd;
}

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: none; /* 默认隐藏 */
  align-items: center;
  justify-content: center;
}

.overlay.show {
  display: flex; /* 显示overlay */
  opacity: 1;
  visibility: visible;
}

.overlay.hide {
  opacity: 0;
  visibility: hidden;
}
