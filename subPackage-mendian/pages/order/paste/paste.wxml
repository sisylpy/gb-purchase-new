<view class="flex flex-column page-bg">

  <back-navbar style="height: {{navBarHeight}}rpx;" title="文字下单" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view class="paste-content">

    <block wx:if="{{orderArr.length == 0}}">
      <view class="input-area {{isRecording ? 'recording' : ''}}">
        <view wx:if="{{isRecording}}" class="recording-tip">正在录音，请说话...</view>
        <textarea
          class="p-20 sentence {{hasInput || isRecording ? 'is-active' : ''}}"
          value="{{isRecording ? sentence : inputContent}}"
          style="width: {{windowWidth - 80}}rpx; font-size: 40rpx; min-height: {{windowHeight / 3}}rpx; max-height: {{windowHeight - navBarHeight - bottomHeight - 280}}rpx;"
          bindinput="onInput"
          maxlength="-1"
          auto-height="false"
          placeholder-style="font-size: 32rpx;"
          placeholder="请输入商品名称、数量和单位，每行一条或用逗号分隔"
          confirm-type="done"
          show-confirm-bar="{{false}}"
        />
      </view>
    </block>

    <view class="bottom-bar" wx:if="{{!orderSubmitted}}">
      <block wx:if="{{orderArr.length == 0}}">
        <view class="flex-row" style="width: 100%;">
          <view class="flex-column-center half-row" wx:if="{{isRecording}}">
            <view class="circle-btn-wrapper">
              <view class="circle-btn red" bindtap="toggleRecord">
                <image src="/images/chat_record.svg" class="btn-icon" />
              </view>
            </view>
            <text class="bottom-btn-label">停止</text>
          </view>
          <view class="flex-column-center half-row" wx:elif="{{!hasInput}}">
            <view class="circle-btn-wrapper">
              <view class="pulse-ring" wx:if="{{!isRecording}}"></view>
              <view class="circle-btn green" bindtap="toggleRecord">
                <image src="/images/chat_record.svg" class="btn-icon" />
              </view>
            </view>
            <text class="bottom-btn-label">录音</text>
          </view>
          <view class="flex-column-center half-row" wx:else>
            <view class="circle-btn-wrapper">
              <view class="circle-btn orange" bindtap="clearSentence">
                <image src="/images/delete.svg" class="btn-icon" />
              </view>
            </view>
            <text class="bottom-btn-label">清空</text>
          </view>

          <view class="flex-column-center half-row">
            <view class="circle-btn green" bindtap="parseOrder">
              <image src="/images/zhuanhuan.svg" class="btn-icon" />
            </view>
            <text class="bottom-btn-label">识别订单</text>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="flex-row-between" style="width: {{windowWidth - 40}}rpx;">
          <view class="flex-column-center half-row">
            <view class="circle-btn orange" bindtap="{{hasAiRecognized ? 'againPaste' : 'backBegin'}}">
              <image src="/images/delete.svg" class="btn-icon" />
            </view>
            <text class="bottom-btn-label">{{hasAiRecognized ? '重新粘贴' : '重新输入'}}</text>
          </view>

          <view class="flex-column-center half-row">
            <view class="circle-btn green" bindtap="depPasteSearchGoods">
              <image src="/images/correct.svg" class="btn-icon" />
            </view>
            <text class="bottom-btn-label">匹配商品</text>
          </view>
        </view>
      </block>
    </view>

    <scroll-view
      scroll-y="true"
      style="height: {{listScrollHeight}}rpx;"
      wx:if="{{orderArr.length > 0}}"
      class="order-list-scroll"
    >
      <view class="order-list-card" style="min-height: {{listCardMinHeight}}rpx;">
        <view class="order-list-head">
          <text class="order-list-head-index">#</text>
          <text class="order-list-head-name">商品名称</text>
          <text class="order-list-head-qty">数量</text>
          <text class="order-list-head-unit">单位</text>
          <text class="order-list-head-op">{{orderSubmitted ? '操作' : ''}}</text>
        </view>

        <view
          class="order-list-item {{orderSubmitted && item.gbDoStatus == -2 ? 'order-list-item--unmatched' : ''}} {{orderSubmitted && item.gbDoStatus != -2 ? 'order-list-item--matched' : ''}}"
          wx:for="{{orderArr}}"
          wx:for-index="orderIndex"
          wx:key="orderIndex"
        >
          <block wx:if="{{!orderSubmitted}}">
            <view class="order-list-row">
              <text class="order-list-index">{{orderIndex + 1}}</text>
              <input
                class="order-list-input order-list-input-name"
                type="text"
                bindinput="editOrder"
                data-type="name"
                data-index="{{orderIndex}}"
                value="{{item.gbDoGoodsName}}"
              />
              <input
                class="order-list-input order-list-input-qty"
                type="digit"
                bindinput="editOrder"
                data-type="quantity"
                data-index="{{orderIndex}}"
                value="{{item.gbDoQuantity}}"
              />
              <input
                class="order-list-input order-list-input-unit"
                type="text"
                bindinput="editOrder"
                data-type="standard"
                data-index="{{orderIndex}}"
                value="{{item.gbDoStandard}}"
              />
              <view class="order-list-more" bindtap="showPasteOperation" data-index="{{orderIndex}}">
                <image src="/images/points.png" mode="aspectFill" class="order-list-more-icon" />
              </view>
            </view>

            <view class="order-list-remark" wx:if="{{item.gbDoAddRemark}}">
              <text class="order-list-remark-label">备注</text>
              <input
                class="order-list-input order-list-input-remark"
                type="text"
                bindinput="editOrder"
                data-type="remark"
                data-index="{{orderIndex}}"
                value="{{item.gbDoRemark}}"
              />
            </view>
          </block>

          <block wx:else>
            <view class="order-list-row order-list-row--saved">
              <text class="order-list-index">{{orderIndex + 1}}</text>
              <view class="order-list-cell order-list-cell-name">
                <text class="order-list-badge" wx:if="{{item.gbDoStatus == -2}}">未匹配</text>
                <text class="order-list-name">{{item.gbDoGoodsName}}</text>
              </view>
              <text class="order-list-cell order-list-cell-qty">{{item.gbDoQuantity}}</text>
              <text class="order-list-cell order-list-cell-unit">{{item.gbDoStandard}}</text>
              <view class="order-list-cell order-list-cell-op">
                <view
                  wx:if="{{item.gbDoStatus == -2}}"
                  class="order-list-more"
                  bindtap="openOperationLinshi"
                  data-order="{{item}}"
                  data-index="{{orderIndex}}"
                >
                  <image src="/images/points.png" mode="aspectFill" class="order-list-more-icon" />
                </view>
                <text wx:else class="order-list-matched-tag">已匹配</text>
              </view>
            </view>

            <view class="order-list-remark order-list-remark--saved" wx:if="{{item.gbDoRemark}}">
              <text class="order-list-remark-label">备注</text>
              <text class="order-list-remark-text">{{item.gbDoRemark}}</text>
            </view>
          </block>
        </view>
      </view>
    </scroll-view>

  </view>
</view>

<view class='overlay {{showOperationPaste ? "show" : "hide"}}' catchtouchmove="true" catchtap="hideMask">
  <view class="nnn bg-white font-lg">
    <view class="center-content border-bottom font-bold">
      <text class="p-30">{{orderItem.gbDoGoodsName}}</text>
      <text class="p-30">{{orderItem.gbDoQuantity}}{{orderItem.gbDoStandard}}</text>
    </view>
    <view class="flex-column">
      <view class="flex-row p-30 border-bottom" catchtap="delOrder" hover-class="hover">
        <image src="/images/ashbin.png" class="icon mr-20"></image>
        <text>删除订单</text>
      </view>
      <view class="flex-row p-30" catchtap="addRemark" hover-class="hover">
        <image src="/images/edit.png" class="icon mr-20"></image>
        <text>添加备注</text>
      </view>
    </view>
    <view style="height: 20rpx;"></view>
  </view>
</view>

<view class='overlay {{showOperationLinshi ? "show" : "hide"}}' catchtouchmove="true" catchtap="hideMaskLinshi">
  <view class="flex-column nnn bg-white font-lg" catchtap="">
    <view class="flex-row p-30 border-bottom" catchtap="toPasteFromGoods" hover-class="hover">
      <image src="/images/search-3.png" class="icon mr-20"></image>
      <text>查找</text>
    </view>
    <view class="flex-row p-30" catchtap="delApplyPaste" hover-class="hover">
      <image src="/images/del.png" class="icon mr-20"></image>
      <text>删除</text>
    </view>
    <view style="height: 20rpx;"></view>
  </view>
</view>
