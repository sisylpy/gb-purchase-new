


  <view class="flex flex-column ">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="添加临时商品" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view class="flex-column center-content text-center">
  <text class="p-20 sub-title mt-10" >临时商品会被系统客服整理正确的商品类别</text>
  </view>
  <view class="p-20 flex-row-reverse" >
      <view class="addBtn {{canSave ? 'is-active' : ''}}" bindtap="saveDisGoods">添加
      </view>

  </view>

  <view class="flex-column font-lg font-md">

      <view class="flex-column bg-white pt-10">
        <view class="flex-row p-30">
          <view class="flex-row flex-shrink-0 ">
            <image src="/images/Star.png" mode="aspectFill" class="icon mr-10" />
            <text class="text-secondary mr-10">商品名称:</text>
          </view>
          <input class="inputAddGoods" bindinput="getDisGoodsContent" data-type="0" value="{{goods.gbDgGoodsName}}"></input>
        </view>

        <view class="flex-row p-30 mb-20">
          <view class="flex-row flex-shrink-0 ">
            <image src="/images/Star.png" mode="aspectFill" class="icon mr-10" />
            <text class="text-secondary mr-10">规格:</text>
          </view>
          <input class="inputAddGoods pt-20 pb-20" value="{{goods.gbDgGoodsStandardname}}" bindinput="getDisGoodsContent" data-type="1"></input>
        </view>

        <view class="flex-row p-30 mb-20">
          <text class="text-secondary flex-shrink-0 mr-10">规格重量:</text>
          <input class="inputAddGoods pt-20 pb-20" placeholder="请输入规格重量" value="{{goods.gbDgGoodsStandardWeight}}" bindinput="getDisGoodsContent" data-type="2"></input>
        </view>

        <view class="flex-row p-30 mb-20">
          <text class="text-secondary flex-shrink-0 mr-10">大包装:</text>
          <input class="inputAddGoods pt-20 pb-20" placeholder="请输入大包装单位，如：箱、盒等" value="{{goods.gbDgCartonUnit}}" bindinput="getDisGoodsContent" data-type="6"></input>
        </view>

        <view class="flex-row p-30 mb-20">
          <text class="text-secondary flex-shrink-0 mr-10">大包装数量:</text>
          <input class="inputAddGoods pt-20 pb-20" placeholder="请输入每箱/盒包含的数量" value="{{goods.gbDgItemsPerCarton}}" bindinput="getDisGoodsContent" data-type="7"></input>
        </view>

        <view class="flex-row p-30 mb-20">
          <text class="text-secondary flex-shrink-0 mr-10">品牌:</text>
          <input class="inputAddGoods pt-20 pb-20" placeholder="请输入商品品牌" value="{{goods.gbDgGoodsBrand}}" bindinput="getDisGoodsContent" data-type="3"></input>
        </view>

        <view class="flex-row p-30 mb-20">
          <text class="text-secondary flex-shrink-0 mr-10">产地:</text>
          <input class="inputAddGoods pt-20 pb-20" placeholder="请输入商品产地" value="{{goods.gbDgGoodsPlace}}" bindinput="getDisGoodsContent" data-type="4"></input>
        </view>

        <view class="flex-column p-30 mb-20">
          <text class="text-secondary mb-15">说明:</text>
          <textarea class="inputAddGoods-textarea" placeholder="请输入商品详细说明" value="{{goods.gbDgGoodsDetail}}" bindinput="getDisGoodsContent" data-type="5" auto-height maxlength="200"></textarea>
        </view>
      </view>

      <!-- 商品大图 -->
      <view class="flex-column bg-white p-20 mt-20">
        <text class="text-center text-secondary mb-15">商品大图</text>
        <view class="flex-column center-content">
          <image class='goods_item_lg' wx:if="{{src.length > 0}}" src="{{src.length > 0 ? src : '/images/photo.png' }}"></image>
          <image class='goods_item_lg' wx:else="" src="/images/Photo.png" bind:tap="choiceImg"></image>
          <view wx:if="{{src.length > 0}}" bindtap="delPic" style="margin-left: 180rpx;margin-top: -200rpx;">
            <image src="../../../images/del.png" mode="aspectFill" class="icon" />
          </view>
        </view>
      </view>

    <view style="height: 100rpx;"></view>

  </view>



</view>