/* ============ 页面容器 ============ */
/* .page-content 已迁移到 app.wxss，全局统一处理导航栏高度 */

/* ============ 商品列表 ============ */
.goods-list {
  padding: 20rpx;
}

/* ============ 商品卡片 ============ */
.goods-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.goods-header {
  display: flex;
  flex-flow: row nowrap;
  padding: 24rpx 24rpx 16rpx;
  align-items: flex-start;
}

.goods-index {
  font-size: 32rpx;
  font-weight: 600;
  color: #3d4341;
  margin-right: 12rpx;
  align-self: flex-start;
  line-height: 76rpx;
  flex-shrink: 0;
}

.goods-image {
  width: 88rpx;
  height: 88rpx;
  margin-right: 20rpx;
  border-radius: 14rpx;
  background: #f2f5f3;
  flex-shrink: 0;
}

.goods-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
}

.goods-title-row {
  display: flex;
  flex-flow: row wrap;
  align-items: center;
  width: 100%;
  min-height: 44rpx;
}

.goods-brand {
  display: inline-block;
  font-size: 22rpx;
  padding: 2rpx 8rpx;
  border: 1px solid rgb(192, 250, 202);
  border-radius: 6rpx;
  color: #187e6e;
  margin-right: 8rpx;
}

.goods-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-right: 12rpx;
}


.goods-detail {
  font-size: 28rpx;
  color: #666;
  margin-left: 12rpx;
}

.goods-weight {
  font-size: 28rpx;
  color: #999;
}

/* ============ 订单列表 ============ */
.order-list {
  width: 100%;
  margin-top: 12rpx;
}

.order-item {
  padding: 2rpx 0;
}

.order-summary {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  color: #4f5653;
  font-size: 30rpx;
  line-height: 42rpx;
}

.order-label {
  margin-right: 10rpx;
  color: #6f7673;
}

.order-department {
  display: flex;
  flex-flow: column;
}

.order-department-row {
  font-size: 28rpx;
  color: #666;
}

.order-quantity {
  display: flex;
  flex-flow: row nowrap;
  font-size: 28rpx;
  color: #333;
}

/* ============ 操作按钮 ============ */
.action-area {
  padding: 24rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border: 1rpx solid #c7e4db;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.action-btn.primary {
  background: #edf7f3;
  color: #187e6e;
  box-shadow: none;
}

.action-btn.primary:active {
  background: #dfeee9;
  border-color: #aed7cb;
  box-shadow: none;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
}
