/* ============ 页面容器 ============ */
/* .page-content 已迁移到 app.wxss，全局统一处理导航栏高度 */

/* ============ 商品列表 ============ */
.goods-list {
  padding: 20rpx;
}

/* ============ 商品卡片 ============ */
.goods-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.goods-header {
  display: flex;
  flex-flow: row nowrap;
  padding: 24rpx 24rpx 16rpx;
  align-items: flex-start;
}

.goods-index {
  font-size: 32rpx;
  color: #999;
  margin-right: 12rpx;
  line-height: 1.6;
}

.goods-info {
  display: flex;
  flex-flow: row wrap;
  align-items: center;
  flex: 1;
}

.goods-brand {
  display: inline-block;
  font-size: 22rpx;
  padding: 2rpx 8rpx;
  border: 1px solid rgb(192, 250, 202);
  border-radius: 6rpx;
  color: #187e6e;
  margin-right: 8rpx;
}

.goods-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-right: 12rpx;
}

.goods-standard {
  font-size: 28rpx;
  color: #999;
}

.goods-detail {
  font-size: 28rpx;
  color: #666;
  margin-left: 12rpx;
}

.goods-weight {
  font-size: 28rpx;
  color: #999;
}

/* ============ 订单列表 ============ */
.order-list {
  padding: 0 24rpx;
}

.order-item {
  padding: 8rpx 0;
}

.order-department {
  display: flex;
  flex-flow: column;
}

.order-department-row {
  font-size: 28rpx;
  color: #666;
}

.order-quantity {
  display: flex;
  flex-flow: row nowrap;
  font-size: 28rpx;
  color: #333;
}

/* ============ 操作按钮 ============ */
.action-area {
  padding: 24rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.action-btn.primary {
  background: linear-gradient(135deg, #187e6e 0%, #0f6b5d 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(24, 126, 110, 0.3);
}

.action-btn.primary:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, #0f6b5d 0%, #0a5a4d 100%);
  box-shadow: 0 2rpx 8rpx rgba(24, 126, 110, 0.4);
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
}
