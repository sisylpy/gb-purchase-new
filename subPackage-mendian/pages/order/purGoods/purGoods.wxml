<wxs src="../../../../utils/orderGoodsFmt.wxs" module="fmt" />

<back-navbar style="height: {{navBarHeight}}rpx;" title="自采商品" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

<!-- 商品列表 -->
<scroll-view scroll-y class="page-content">
  <view class="goods-list mt-30">
    <view class="goods-card" wx:for="{{displayPurArr}}" wx:key="gbDistributerPurchaseGoodsId" wx:for-index="index">
      <view class="goods-header">
        <view class="goods-index">{{index + 1}}.</view>
        <image
          class="goods-image"
          mode="aspectFill"
          src="{{fmt.goodsImageUrl(item.gbDistributerGoodsEntity, url)}}"
        />
        <view class="goods-info">
          <view class="goods-title-row">
            <text class="goods-brand" wx:if="{{item.gbDistributerGoodsEntity && item.gbDistributerGoodsEntity.gbDgGoodsBrand}}">{{item.gbDistributerGoodsEntity.gbDgGoodsBrand}}</text>
            <text class="goods-name">{{item.gbDistributerGoodsEntity ? item.gbDistributerGoodsEntity.gbDgGoodsName : ''}}</text>
            <text class="goods-detail" wx:if="{{item.gbDistributerGoodsEntity && item.gbDistributerGoodsEntity.gbDgGoodsDetail && item.gbDistributerGoodsEntity.gbDgGoodsDetail !== 'null'}}">{{item.gbDistributerGoodsEntity.gbDgGoodsDetail}}</text>
            <text wx:if="{{item.gbDistributerGoodsEntity && item.gbDistributerGoodsEntity.gbDgGoodsStandardWeight && item.gbDistributerGoodsEntity.gbDgGoodsStandardWeight !== 'null'}}">
              <text>({{item.gbDistributerGoodsEntity.gbDgGoodsStandardWeight}}/{{item.gbDistributerGoodsEntity.gbDgGoodsStandardname}})</text>
            </text>
            <text wx:else="">{{item.gbDistributerGoodsEntity.gbDgGoodsStandardname}}</text>
          </view>

          <view class="order-list">
            <view class="order-item" wx:for="{{item.gbDepartmentOrdersEntities}}" wx:key="gbDepartmentOrdersId" wx:for-item="orders" wx:if="{{orders.isNotice}}">
              <block wx:if="{{subDepAmount == 1}}">
                <view class="order-summary">
                  <text class="order-label">订货:</text>
                  <text>{{orders.gbDoQuantity}}{{orders.gbDoStandard}}</text>
                  <text wx:if="{{orders.gbDoDsStandardScale && orders.gbDoDsStandardScale !== '-1'}}" class="text-secondary font-sl">({{orders.gbDoDsStandardScale}}{{item.gbDistributerGoodsEntity.gbDgGoodsStandardname}}/{{orders.gbDoStandard}})</text>
                </view>
              </block>
              <block wx:else>
                <view class="order-department">
                  <view class="order-department-row">
                    <text class="mr-30">{{orders.gbDoParentDepartmentName}}.{{orders.gbDoOrderDepartmentName}}</text>
                    <text class="order-label">订货:</text>
                    <text>{{orders.gbDoQuantity}}{{orders.gbDoStandard}}</text>
                    <text wx:if="{{orders.gbDoDsStandardScale && orders.gbDoDsStandardScale !== '-1'}}" class="text-secondary font-sl">({{orders.gbDoDsStandardScale}}{{item.gbDistributerGoodsEntity.gbDgGoodsStandardname}}/{{orders.gbDoStandard}})</text>
                  </view>
                </view>
              </block>
            </view>
          </view>
        </view>
      </view>

      <view class="action-area">
        <view class="action-btn primary" bindtap="showInputOrder" data-item="{{item}}" data-finish="true">
          <text class="btn-text">录入单价和数量</text>
        </view>
      </view>
    </view>
  </view>
</scroll-view>

<inputOrder show="{{show}}" bindconfirm="confirm" bindcancle="cancle" bindfinish="markGbPurGoodsFinish" item="{{item}}" orderListCount="{{orderListCount}}" maskHeight="{{maskHeight > windowHeight ? maskHeight : windowHeight}}" scrollViewTop="{{scrollViewTop}}" scaleInput="{{scaleInput}}" cartonInput="{{cartonInput}}" foucusWeight="{{foucusWeight}}" foucusPrice="{{foucusPrice}}" canSave="{{canSave}}" windowHeight="{{windowHeight}}" windowWidth="{{windowWidth}}" disInfo="{{disInfo}}" />
