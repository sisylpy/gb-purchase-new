/**
 * 菜品模块共用样式（index / foodList / addFood）
 * 依赖 app.wxss 中的 CSS 变量与 flex 工具类。
 */

/* -------------------------------------------------------------------------- */
/* 页面骨架 */
/* -------------------------------------------------------------------------- */

.food-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

.food-page-body {
  flex: 1;
  padding: 8rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.content.food-page-body {
  padding-top: 12rpx;
}

/* -------------------------------------------------------------------------- */
/* 顶部操作条 + 主按钮 */
/* -------------------------------------------------------------------------- */

.food-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 20rpx;
}

/* 多操作：下载 / 上传 / 菜品类别 */
.food-toolbar--wrap {
  flex-wrap: wrap;
  justify-content: flex-start;
}

.food-toolbar--wrap .food-tool-link,
.food-toolbar--wrap .food-add-btn {
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.food-tool-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 22rpx;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.food-tool-link--blue {
  color: #007aff;
  background: #fff;
  border: 1rpx solid #007aff;
}

.food-tool-link--green {
  color: #34c759;
  background: #fff;
  border: 1rpx solid #34c759;
}

.food-tool-link .icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

/* 菜品销量模板：日期范围弹窗（参考营业额 addTurnover） */
.food-tpl-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1100;
}

.food-tpl-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.5);
}

.food-tpl-panel {
  position: absolute;
  top: 50%;
  left: 50%;
  box-sizing: border-box;
  width: 600rpx;
  max-width: 90%;
  padding: 36rpx 32rpx 32rpx;
  background: var(--gb-bg-white);
  border-radius: 20rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
  transform: translate(-50%, -50%);
}

.food-tpl-title {
  margin-bottom: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gb-text);
  text-align: center;
}

.food-tpl-form {
  margin-bottom: 28rpx;
}

.food-tpl-form-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--gb-border-soft);
}

.food-tpl-form-item:last-child {
  border-bottom: none;
}

.food-tpl-form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--gb-text-secondary);
}

.food-tpl-form-input {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--gb-bg-page);
  border: 1rpx solid var(--gb-border);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--gb-text);
}

.food-tpl-actions {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.food-tpl-actions .food-tpl-btn {
  box-sizing: border-box;
  width: 47%;
  margin: 0;
  padding: 20rpx 0;
  font-size: 28rpx;
  line-height: 1.35;
  text-align: center;
  border-radius: 44rpx;
}

.food-tpl-btn--ghost {
  color: var(--gb-text-secondary);
  background: var(--gb-bg-gray);
}

.food-tpl-btn--primary {
  font-weight: 500;
  color: var(--gb-text-inverse);
  background: #007aff;
}

.food-add-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 26rpx;
  background: var(--gb-bg-light);
  border: 1rpx solid rgba(24, 126, 110, 0.22);
  border-radius: 999rpx;
  color: var(--gb-primary);
  font-size: 28rpx;
  font-weight: 500;
}

.food-add-btn .icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.food-add-btn--hover {
  opacity: 0.88;
  transform: scale(0.98);
}

/* 菜单列表页：通栏白底分类块 + 列表头操作（微信常规链接色） */

.food-menu-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #ededed;
}

.food-menu-scroll {
  flex: 1;
  height: 0;
  box-sizing: border-box;
}

.food-menu-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #e5e5e5;
}

.food-menu-head__label {
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
}

/* 菜单页：新建分类（浅灰描边） / 添加菜品（绿描边 + 极淡绿底） */
.food-menu-action-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.food-menu-action-btn__txt {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.2;
}

.food-menu-action-btn--cat {
  padding: 12rpx 28rpx;
  background: #f5f5f5;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.food-menu-action-btn--cat .food-menu-action-btn__txt {
  font-size: 28rpx;
  color: #333;
}

.food-menu-action-btn--dish {
  padding: 10rpx 24rpx;
  background: rgba(24, 126, 110, 0.07);
  border: 1rpx solid var(--gb-primary);
}

.food-menu-action-btn--dish .food-menu-action-btn__txt {
  color: var(--gb-primary);
}

.food-menu-action-btn--hover {
  opacity: 0.86;
}

/* 与微信原生列表辅助操作色一致 */
.food-menu-link {
  font-size: 28rpx;
  color: #576b95;
  padding: 8rpx 4rpx;
}

.food-menu-link--muted {
  color: #888;
}

.food-menu-divider {
  margin: 0 16rpx;
  font-size: 24rpx;
  color: #d0d0d0;
}

.food-menu-list {
  padding: 12rpx 0 40rpx;
}

.food-cat-section {
  margin: 0 0 16rpx;
  background: #fff;
  border-radius: 0;
  overflow: hidden;
}

.food-cat-section__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 32rpx 14rpx;
  background: #f6f7f8;
}

.food-cat-section__head-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  margin-left: 8rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--gb-primary);
  background: rgba(24, 126, 110, 0.07);
}

.food-cat-section__head-toggle--hover {
  opacity: 0.86;
}

.food-cat-section__chev {
  width: 28rpx;
  height: 28rpx;
  transform: rotate(0deg);
}

.food-cat-section__chev--collapsed {
  transform: rotate(-90deg);
}

.food-cat-section__margin {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 32rpx 20rpx;
  background: #f6f7f8;
  border-bottom: 1rpx solid #e5e5e5;
}

.food-cat-section__margin-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: nowrap;
  flex: 1;
  min-width: 0;
  column-gap: 0;
  padding-right: 8rpx;
  box-sizing: border-box;
}

.food-cat-section__margin-edit {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 8rpx 4rpx;
  column-gap: 8rpx;
}

.food-cat-section__margin-edit-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.food-cat-section__margin-edit-txt {
  font-size: 28rpx;
  font-weight: 500;
  color: #576b95;
}

.food-cat-section__margin-edit--hover {
  opacity: 0.72;
}

.food-cat-section__margin-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.food-cat-section__margin-gap {
  flex-shrink: 0;
  width: 1rpx;
  align-self: stretch;
  min-height: 28rpx;
  margin: 0 14rpx;
  background: #ddd;
}

.food-cat-section__margin-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.food-cat-section__margin-label {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #888;
  margin-right: 6rpx;
}

.food-cat-section__margin-val {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  white-space: nowrap;
}

.food-cat-section__head-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.food-cat-section__name-line {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: nowrap;
}

.food-cat-section__name-line .food-cat-section__name {
  flex: 0 1 auto;
  min-width: 0;
}

.food-cat-section__fold-count {
  flex-shrink: 0;
  margin-left: 4rpx;
  font-size: 26rpx;
  color: #999;
  font-weight: 400;
}

.food-cat-section__idx {
  flex-shrink: 0;
  min-width: 40rpx;
  margin-right: 12rpx;
  font-size: 28rpx;
  color: #888;
}

.food-cat-section__name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-cat-section__head-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  column-gap: 8rpx;
}

.food-cat-section__dishes {
  background: #fff;
}

.food-cat-section__dishes--nested {
  margin-left: 24rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid rgba(24, 126, 110, 0.28);
  box-sizing: border-box;
  background: #f9fbf9;
}

.food-cat-section__dishes--nested .food-dish-cell:not(:first-child) {
  margin-top: 10rpx;
}

.food-dish-cell {
  border-top: 1rpx solid #e5e5e5;
}

.food-dish-cell:first-child {
  border-top: none;
}

.food-dish-cell__inner {
  padding: 24rpx 20rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.food-dish-cell__content {
  display: flex;
  flex-direction: column;
  width: 100%;
}

/* 左：菜名 + 售出方法（纵向）；右：单价可多行，顶部对齐 */
.food-dish-cell__main-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  width: 100%;
}

.food-dish-cell__main-left {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  flex: 1;
  min-width: 0;
  margin-right: 8rpx;
}

.food-dish-cell__main-left .food-dish-cell__title-left {
  margin-right: 0;
  width: 100%;
}

.food-dish-cell__method-row {
  margin-top: 10rpx;
  align-items: flex-start;
  line-height: 1.45;
}

.food-dish-cell__method-row .ml-10 {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.food-dish-cell__extra {
  width: 100%;
}

.food-dish-cell__actions {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: stretch;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #ebebeb;
  column-gap: 8rpx;
}

.food-dish-act--icon {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex: 1;
  flex-basis: 0;
  min-width: 0;
  height: 72rpx;
  padding: 0 4rpx;
  margin: 0;
  background: transparent;
  border-radius: 8rpx;
  box-sizing: border-box;
  column-gap: 6rpx;
}

.food-dish-act__icon {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
}

.food-dish-act__txt {
  flex-shrink: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #666;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.food-dish-act--hover {
  background: rgba(0, 0, 0, 0.05);
}

.food-dish-cell__no-inline {
  flex-shrink: 0;
  margin-right: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #888;
  line-height: 1.4;
}

.food-dish-cell__title-name {
  flex: 1;
  min-width: 0;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-dish-cell__title-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.food-dish-cell__name-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
  flex-wrap: nowrap;
}

.food-dish-cell__name-wrap .food-cat-item__badge {
  flex-shrink: 0;
  margin-left: 8rpx;
}

/* 单价靠右，可换行，不与左侧售出方法抢纵向位置 */
.food-dish-cell__price-inline {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: flex-end;
  flex-shrink: 0;
  max-width: 46%;
  box-sizing: border-box;
}

.food-dish-cell__price-lab {
  flex-shrink: 0;
  margin-right: 6rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #16a34a;
  line-height: 1.2;
}

.food-dish-cell__price-sym {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #07c160;
  margin-right: 2rpx;
  line-height: 1;
}

.food-dish-cell__price-num {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #07c160;
  line-height: 1.15;
}

.food-dish-cell__price-suffix {
  flex-shrink: 0;
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #16a34a;
  line-height: 1.2;
}

.food-dish-cell__raw {
  align-items: flex-start;
}

.food-dish-cell__raw-label {
  flex-shrink: 0;
  margin-right: 12rpx;
}

.food-raw-chips--in-cell {
  flex: 1;
  min-width: 0;
}

.food-raw-chips--in-cell .food-raw-chip {
  font-size: 28rpx;
  padding: 6rpx 14rpx;
}

.food-cell-hover {
  opacity: 0.92;
}

/* -------------------------------------------------------------------------- */
/* 菜品类别列表（index） */
/* -------------------------------------------------------------------------- */

.food-cat-list {
  display: flex;
  flex-direction: column;
}

.food-cat-list > .food-cat-item + .food-cat-item {
  margin-top: 16rpx;
}

.food-cat-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  background: var(--gb-bg-white);
  border-radius: 18rpx;
  box-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.05);
}

.food-cat-item__left {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.food-cat-item__index {
  flex-shrink: 0;
  min-width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  font-size: 24rpx;
  line-height: 48rpx;
  color: var(--gb-primary);
  text-align: center;
  background: var(--gb-bg-light);
  border-radius: 12rpx;
}

.food-cat-item__name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--gb-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-cat-item__badge {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.35;
  border-radius: 8rpx;
}

.food-cat-item__badge--off {
  color: #8e6a2a;
  background: rgba(255, 193, 7, 0.22);
  border: 1rpx solid rgba(255, 193, 7, 0.45);
}

.food-cat-item .icon {
  flex-shrink: 0;
  margin-left: 16rpx;
  opacity: 0.4;
}

/* -------------------------------------------------------------------------- */
/* 菜品卡片列表（foodList） */
/* -------------------------------------------------------------------------- */

.food-dish-list {
  display: flex;
  flex-direction: column;
  padding-bottom: 48rpx;
}

.food-dish-list > .food-dish-card + .food-dish-card {
  margin-top: 20rpx;
}

.food-dish-card {
  padding: 24rpx 24rpx 28rpx;
  background: var(--gb-bg-white);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.food-dish-card__main {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.food-dish-card__no {
  flex-shrink: 0;
  min-width: 44rpx;
  margin-right: 16rpx;
  font-size: 24rpx;
  line-height: 40rpx;
  color: var(--gb-text-muted);
}

.food_img,
.food-dish-card__img {
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  background: var(--gb-bg-gray);
}

.food-dish-card__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.food-dish-card__title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gb-text);
  line-height: 1.45;
}

.food-dish-card__title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
  margin-bottom: 8rpx;
}

.food-dish-card__title-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gb-text);
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-meta-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.food-meta-label {
  flex-shrink: 0;
  margin-right: 8rpx;
  color: var(--gb-text-muted);
}

.food-meta-value {
  color: var(--gb-text-secondary);
}

.food-raw-block {
  margin-top: 12rpx;
}

.food-raw-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: flex-start;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--gb-text-secondary);
}

.food-raw-label {
  flex-shrink: 0;
  width: 140rpx;
  margin-right: 8rpx;
  color: var(--gb-text-muted);
}

.food-raw-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  flex: 1;
  align-items: flex-start;
}

.food-raw-chips .food-raw-chip {
  margin-right: 16rpx;
  margin-bottom: 10rpx;
}

.food-raw-chip {
  padding: 8rpx 18rpx;
  font-size: 30rpx;
  color: var(--gb-text-secondary);
  background: var(--gb-bg-page);
  border-radius: 10rpx;
}

/* -------------------------------------------------------------------------- */
/* 遮罩 + 操作弹窗（index / foodList） */
/* -------------------------------------------------------------------------- */

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: none;
  background: rgba(0, 0, 0, 0.45);
}

.mask.is-active {
  display: block;
}

.popup {
  position: fixed;
  top: 50%;
  left: 50%;
  z-index: 1000;
  width: 620rpx;
  max-width: 90%;
  overflow: hidden;
  background: var(--gb-bg-white);
  border-radius: 20rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.18);
  transform: translate(-50%, -50%);
}

.popup-item {
  padding: 30rpx 32rpx;
  font-size: 30rpx;
  line-height: 1.45;
  color: var(--gb-text);
  text-align: center;
  border-bottom: 1rpx solid var(--gb-border-soft);
}

.popup-item:last-child {
  border-bottom: none;
}

.popup-item--danger {
  color: var(--gb-danger);
  font-weight: 500;
}

/* -------------------------------------------------------------------------- */
/* 部门相关底表：选部门 + 设价（foodList 等共用 food-dep-sheet） */
/* -------------------------------------------------------------------------- */

.food-dep-sheet {
  position: fixed;
  top: 50%;
  left: 50%;
  z-index: 1000;
  box-sizing: border-box;
  width: 640rpx;
  max-width: 92%;
  overflow: hidden;
  background: var(--gb-bg-white);
  border-radius: 24rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
  transform: translate(-50%, -50%);
}

.food-dep-sheet__header {
  padding: 36rpx 32rpx 32rpx;
  background: linear-gradient(135deg, var(--gb-primary) 0%, #0f5f52 100%);
}

.food-dep-sheet__title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--gb-text-inverse);
  word-break: break-all;
}

.food-dep-sheet__subtitle {
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.85);
}

.food-dep-sheet__body {
  padding: 32rpx 32rpx 8rpx;
}

.food-dep-sheet__field {
  margin-bottom: 28rpx;
}

.food-dep-sheet__field:last-child {
  margin-bottom: 0;
}

.food-dep-sheet__label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--gb-text-secondary);
}

.food-dep-sheet__input-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 0 24rpx;
  background: var(--gb-bg-page);
  border: 1rpx solid var(--gb-border);
  border-radius: 16rpx;
}

.food-dep-sheet__currency {
  flex-shrink: 0;
  margin-right: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gb-primary);
}

.food-dep-sheet__input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 96rpx;
  color: var(--gb-text);
}

.food-dep-sheet__placeholder {
  color: var(--gb-text-muted);
  font-size: 28rpx;
  font-weight: 400;
}

.food-dep-sheet__unit {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 26rpx;
  color: var(--gb-text-muted);
}

.food-dep-sheet__dep-chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 16rpx 22rpx;
  background: var(--gb-bg-light);
  border: 1rpx solid rgba(24, 126, 110, 0.18);
  border-radius: 16rpx;
}

.food-dep-sheet__dep-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--gb-text);
  word-break: break-all;
}

/* 选部门列表 */
.food-dep-sheet__scroll {
  box-sizing: border-box;
  width: 100%;
  background: var(--gb-bg-white);
}

.food-dep-sheet__item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--gb-border-soft);
}

.food-dep-sheet__item:last-child {
  border-bottom: none;
}

.food-dep-sheet__item--hover {
  background: var(--gb-bg-page);
}

.food-dep-sheet__item-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
  font-size: 30rpx;
  line-height: 1.45;
  color: var(--gb-text);
  word-break: break-all;
}

.food-dep-sheet__item-arrow {
  flex-shrink: 0;
  font-size: 34rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--gb-text-muted);
}

.food-dep-sheet__footer {
  padding: 20rpx 32rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--gb-border-soft);
}

.food-dep-sheet__footer--borderless {
  border-top: none;
  padding-top: 12rpx;
}

.food-dep-sheet__actions {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  justify-content: space-between;
}

.food-dep-sheet__actions--single .food-dep-sheet__btn {
  flex: 1;
  margin-left: 0;
}

.food-dep-sheet__btn {
  box-sizing: border-box;
  flex: 1;
  padding: 24rpx 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.35;
  text-align: center;
  border-radius: 44rpx;
}

.food-dep-sheet__btn + .food-dep-sheet__btn {
  margin-left: 20rpx;
}

.food-dep-sheet__actions--single .food-dep-sheet__btn + .food-dep-sheet__btn {
  margin-left: 0;
}

.food-dep-sheet__btn--ghost {
  color: var(--gb-text-secondary);
  background: var(--gb-bg-gray);
}

.food-dep-sheet__btn--primary {
  color: var(--gb-text-inverse);
  background: var(--gb-primary);
  box-shadow: 0 8rpx 24rpx rgba(24, 126, 110, 0.28);
}

.food-dep-sheet__btn--hover {
  opacity: 0.88;
}

/* -------------------------------------------------------------------------- */
/* 添加/编辑菜品表单（addFood） */
/* -------------------------------------------------------------------------- */

.food-form-card {
  padding: 8rpx 0 32rpx;
  margin-top: 8rpx;
  overflow: hidden;
  background: var(--gb-bg-white);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 22rpx rgba(0, 0, 0, 0.06);
}

.food-form-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid var(--gb-border-soft);
}

.food-form-row:last-child {
  border-bottom: none;
}

.food-form-row--top {
  align-items: center;
  justify-content: space-between;
}

.food-form-row--multiline {
  align-items: flex-start;
}

.food-form-label {
  flex-shrink: 0;
  width: 168rpx;
  margin-right: 16rpx;
  font-size: 34rpx;
  color: var(--gb-text-secondary);
}

.food-form-label--narrow {
  width: auto;
  min-width: 140rpx;
}

.food-form-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--gb-text);
}

.food-save {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  line-height: 1.3;
  color: var(--gb-text-inverse);
  text-align: center;
  background: #c8d5d2;
  border-radius: 999rpx;
}

.food-save.is-active {
  background: var(--gb-primary);
}

.numberInput {
  min-height: 72rpx;
  padding: 12rpx 16rpx;
  font-size: 38rpx;
  line-height: 1.4;
  color: var(--gb-text);
  background: var(--gb-bg-page);
  border: 1rpx solid var(--gb-border);
  border-radius: 12rpx;
}

.numberText {
  min-height: 140rpx;
  padding: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--gb-text);
  background: var(--gb-bg-page);
  border: 1rpx solid var(--gb-border);
  border-radius: 12rpx;
}

.class_img {
  display: block;
  border: 1rpx solid var(--gb-border);
  border-radius: 16rpx;
  background: var(--gb-bg-gray);
}

/* -------------------------------------------------------------------------- */
/* 原料搜索弹窗（addFood / addRaw）；整体上移与列表高度由页面内联 style（rpx）控制，勿依赖 vh */
/* -------------------------------------------------------------------------- */

.food-search-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 0 32rpx 32rpx;
  box-sizing: border-box;
  background-color: rgba(0, 0, 0, 0.45);
}

.food-search-modal__panel {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-height: 0;
  overflow: hidden;
  background: var(--gb-bg-white);
  border-radius: 24rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.food-search-modal__head {
  flex-shrink: 0;
  padding: 28rpx 32rpx;
  background-color: var(--gb-primary);
}

.food-search-modal__title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--gb-text-inverse);
  word-break: break-all;
}

.food-search-modal__hint {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.88);
}

.food-search-modal__body {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
  padding: 20rpx 24rpx 12rpx;
}

.food-search-modal__section {
  flex-shrink: 0;
  margin-bottom: 16rpx;
}

.food-search-modal__scroll-wrap {
  flex: 1;
  min-height: 120rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
  border: 1rpx solid var(--gb-border-soft);
  border-radius: 14rpx;
}

.searchPart {
  display: none;
  width: 100%;
}

.searchPart.is-active {
  display: block;
}

.searchList {
  width: 100%;
}

.searchList.is-active {
  display: flex;
  flex-direction: column;
}

.food-search-hit {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 20rpx;
  border-bottom: 1rpx solid var(--gb-border-soft);
}

.food-search-hit:last-child {
  border-bottom: none;
}

.food-search-hit--hover {
  background: var(--gb-bg-page);
}

.food-search-modal__footer {
  flex-shrink: 0;
  padding: 16rpx 24rpx 24rpx;
  border-top: 1rpx solid var(--gb-border-soft);
}

.food-search-modal__actions {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.cancel-btn,
.confirm-btn {
  box-sizing: border-box;
  width: 47%;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.3;
  text-align: center;
  border-radius: 14rpx;
}

.cancel-btn {
  color: var(--gb-text-secondary);
  background: var(--gb-bg-gray);
}

.confirm-btn {
  font-weight: 500;
  color: var(--gb-text-inverse);
  background: var(--gb-primary);
}

.hoverBtn {
  opacity: 0.88;
}

/* -------------------------------------------------------------------------- */
/* 简单表单页：区块标题、说明文案、底部主按钮（addFoodFather 等） */
/* -------------------------------------------------------------------------- */

.food-form-section-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--gb-text);
}

.food-form-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--gb-text-muted);
}

.food-footer-cta {
  flex-shrink: 0;
  padding: 8rpx 24rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.food-submit-btn {
  padding: 28rpx 32rpx;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.35;
  color: var(--gb-text-inverse);
  text-align: center;
  background: #c8d5d2;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.food-submit-btn.is-active {
  background: var(--gb-primary);
  box-shadow: 0 8rpx 28rpx rgba(24, 126, 110, 0.28);
}

.food-submit-btn--hover {
  opacity: 0.9;
}

/* 兼容旧结构类名（addFood 内联布局） */
.goods_contents {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
}
