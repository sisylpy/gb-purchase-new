<view class="flex flex-column ">
  <back-navbar title="{{fatherFood !== null ? '修改' : '添加'}}菜品类别" avatar="/images/back.png" style="height: {{navBarHeight}}rpx;" bindnavbuttontap="toBack"></back-navbar>

  <view class="content">
    <scroll-view scroll-y class='with-padding' style='height: {{windowHeight - 340}}rpx; background:white;'>
      <view class='with-padding'>
        <view class="with-tb-padding" style="font-size: 38rpx; font-weight: 500;">菜品类别名称:</view>
        <view class="flex-column">
          <input class="numInput mainColor" style="width:{{windowWidth/2}}rpx; font-size: 40rpx; height: 80rpx; line-height: 80rpx; padding-left: 10rpx; margin-bottom:10rpx;" bindblur="getRestrauntName" value="{{fatherFood !== null ? fatherFood.gbDfFoodName: resName}}"></input>
        </view>
        <view class="extremeSmall mainColor">菜品按类别分类</view>
      </view>
    </scroll-view>
    <view class='btn_main {{addFinished ? "next" : ""}}' catchtap='{{addFinished ? "saveFoodFather" : ""}}' style="width: {{windowWidth - 40}}rpx; margin-left:20rpx;" hover-class='hover'>保存</view>
  </view>
</view>
