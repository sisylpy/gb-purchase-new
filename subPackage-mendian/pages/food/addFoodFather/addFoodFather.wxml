<view class="flex flex-column food-page">
  <back-navbar title="{{fatherFood !== null ? '修改' : '添加'}}菜品类别" avatar="/images/back.png" style="height: {{navBarHeight}}rpx;" bindnavbuttontap="toBack"></back-navbar>

  <view class="food-page-body flex-column flex-1">
    <view class="food-form-card">
      <view class="food-form-row food-form-row--multiline">
        <view class="flex-column" style="width: 100%; min-width: 0;">
          <text class="food-form-section-title">菜品类别名称</text>
          <input
            class="numberInput"
            style="width: {{windowWidth - 120}}rpx; margin-top: 20rpx; font-size: 32rpx; min-height: 88rpx;"
            bindinput="getRestrauntName"
            value="{{resName}}"
            placeholder="例如：热菜、凉菜、主食"
            placeholder-style="color: #bbb; font-size: 28rpx;"
          />
          <text class="food-form-hint">按类别整理菜品，列表更清晰，后续统计也更方便。</text>
        </view>
      </view>

      <view class="food-form-row food-form-row--multiline">
        <view class="flex-column" style="width: 100%; min-width: 0;">
          <text class="food-form-section-title">目标毛利率（%）</text>
          <input
            class="numberInput"
            type="digit"
            style="width: {{windowWidth - 120}}rpx; margin-top: 20rpx; font-size: 32rpx; min-height: 88rpx;"
            bindinput="onTargetGrossMarginRateInput"
            value="{{targetGrossMarginRate}}"
            placeholder="例如：60"
            placeholder-style="color: #bbb; font-size: 28rpx;"
          />
          <text class="food-form-hint">该类别菜品的期望毛利率，用于参考或统计。</text>
        </view>
      </view>

      <view class="food-form-row food-form-row--multiline">
        <view class="flex-column" style="width: 100%; min-width: 0;">
          <text class="food-form-section-title">毛利率浮动（绝对值）</text>
          <input
            class="numberInput"
            type="digit"
            style="width: {{windowWidth - 120}}rpx; margin-top: 20rpx; font-size: 32rpx; min-height: 88rpx;"
            bindinput="onGrossMarginFloatAbsInput"
            value="{{grossMarginFloatAbs}}"
            placeholder="例如：3"
            placeholder-style="color: #bbb; font-size: 28rpx;"
          />
          <text class="food-form-hint">允许的毛利率波动范围（与目标毛利率同单位语境）。</text>
        </view>
      </view>
    </view>
  </view>

  <view class="food-footer-cta">
    <view
      class="food-submit-btn {{addFinished ? 'is-active' : ''}}"
      catchtap="{{addFinished ? 'saveFoodFather' : ''}}"
      hover-class="food-submit-btn--hover"
    >
      保存
    </view>
  </view>
</view>
