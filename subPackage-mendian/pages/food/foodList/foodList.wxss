page {
  background: #f5f5f5;
}

.page-container {
  min-height: 100vh;
  background: #f5f5f5;
}

.content {
  padding-top: 20rpx;
}

.food_img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
}

/* 遮罩层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: none;
}

.mask.is-active {
  display: block;
}

/* 弹窗 */
.popup {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 500rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.popup-item {
  padding: 30rpx;
  text-align: center;
}
