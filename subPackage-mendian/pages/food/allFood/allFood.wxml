<view class="flex flex-column ">
  <back-navbar title="集团菜品" avatar="/images/back.png" style="height: {{navBarHeight}}rpx;" bindnavbuttontap="toBack"></back-navbar>

  <view class="content">
    <view class="flex-column" wx:for="{{foodArr}}" wx:for-item="dep">
      <view class="flex-row">
        <text class="with-padding">{{dep.gbDfFoodName}}</text>
      </view>

      <view class="flex-column whiteBack">
        <view class="with-border-bottom with-padding flex-row-between" wx:for="{{dep.foodEntityList}}" wx:for-item="food" wx:key="{{food.gbDistributerFoodId}}">
          <view class="flex-row-default">
            <text class="margin-right">{{index + 1}}.</text>
            <view class="margin-l-right">
              <image class="food_img" src="{{url + food.gbDistributerFoodImg}}"></image>
            </view>
            <view class='flex-column normal'>
              <text class="margin-right">{{food.gbDfFoodName}}</text>
              <text>{{food.gbDfFoodPrice}}元/份</text>
              <text wx:if="{{food.gbDfFoodMethod !== null}}">{{food.gbDfFoodMethod}}</text>
            </view>
          </view>

          <view>
            <block wx:if="{{food.gbDepFoodEntity !== null}}">
              <view class="flex-row">
                <text class="margin-l-right">{{food.gbDepFoodEntity.gbDepartmentEntity.gbDepartmentName}}</text>
                <view class="felx-column-center iconClick" bindtap="cancleDownloadFood" data-item="{{food.gbDepFoodEntity}}" hover-class="hover">
                  <image class="icon" src="/images/duihao.png"></image>
                </view>
              </view>
            </block>
            <block wx:else>
              <view class="felx-column-center iconClick" bindtap="showDownloadFood" data-item="{{food}}" hover-class="hover">
                <image class="icon" src="/images/download.png"></image>
              </view>
            </block>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 下载弹窗 -->
<view class='mask {{showOperation ? "is-active" : ""}}' catchtap="hideMask">
  <view class="popup whiteBack">
    <view class="popup-title mainBack big with-padding">{{item.gbDfFoodName}}</view>
    <view class="popup-content with-padding">
      <view class="flex-row">
        <text class="gray shrink_fix margin-right with-tb-padding middle">销售价格:</text>
        <input class="input_number" bindinput="getNewPrice" type='digit' value="{{price}}" />
      </view>

      <view class="flex-row-default">
        <text class="gray shrink_fix margin-right with-tb-padding middle">销售部门:</text>
        <view class="showDeps flex-column" wx:if="{{depItem.gbDepartmentSubAmount > 0}}">
          <view class="flex-row with-border-bottom with-padding" wx:for="{{depArr}}" wx:for-item="pur" wx:for-index="purIndex" data-id="{{pur.gbDepartmentId}}" data-index="{{purIndex}}" catchtap="selectItem" data-type="pur">
            <image src="{{pur.isSelected ? '/images/all_selects.png' : '/images/radiobuttonunselect.png'}}" class="icon margin-right"></image>
            <text>{{pur.gbDepartmentName}}</text>
          </view>
        </view>
        <view class="flex-row with-border-bottom with-padding" wx:else>{{depItem.gbDepartmentName}}</view>
      </view>

      <view class="btn_row">
        <text class='cancel-btn' bindtap="hideMask" hover-class="hoverBtn">取消</text>
        <text class='confirm-btn' catchtap='downLoadGoods' hover-class="hoverBtn">确定</text>
      </view>
    </view>
  </view>
</view>
