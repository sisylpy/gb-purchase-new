


@import '../food-common.wxss';

.food-page {
  min-height: 100vh;
  background: var(--gb-bg-page);
}

.food-toolbar {
  padding: 18rpx 24rpx 6rpx;
  background: var(--gb-bg-white);
  border-bottom: 1rpx solid var(--gb-border-soft);
}

.dfl-group {
  margin-bottom: 22rpx;
}

.dfl-group__header {
  align-items: center;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.dfl-group__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gb-text);
}

.dfl-group__count {
  font-size: 22rpx;
  color: var(--gb-text-muted);
}

.dfl-list-card {
  overflow: hidden;
  background: var(--gb-bg-white);
  border-radius: 18rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.dfl-item {
  align-items: flex-start;
  padding: 20rpx;
  border-bottom: 1rpx solid var(--gb-border-soft);
}

.dfl-item:last-child {
  border-bottom: none;
}

.dfl-item__main {
  display: flex;
  flex: 1;
  min-width: 0;
}

.dfl-item__index {
  flex-shrink: 0;
  width: 36rpx;
  margin-right: 12rpx;
  font-size: 22rpx;
  color: var(--gb-text-muted);
  line-height: 40rpx;
  text-align: center;
}

.dfl-item__image-wrap {
  flex-shrink: 0;
}

.dfl-item__img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 14rpx;
}

.dfl-item__body {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.dfl-item__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gb-text);
  line-height: 1.45;
}

.dfl-item__meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.dfl-item__price {
  margin-right: 16rpx;
  color: var(--gb-primary);
  font-weight: 600;
}

.dfl-item__sales {
  color: var(--gb-text-secondary);
}

.dfl-item__method {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--gb-text-secondary);
}

.dfl-item__method--empty {
  color: var(--gb-text-muted);
}

.dfl-item__action {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  width: 146rpx;
  margin-left: 12rpx;
}

.dfl-action-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 62rpx;
  border-radius: 14rpx;
}

.dfl-action-btn--on {
  background: var(--gb-bg-light);
  border: 1rpx solid rgba(24, 126, 110, 0.2);
}

.dfl-action-btn--off {
  background: #eef4ff;
  border: 1rpx solid #d6e3ff;
}

.dfl-action-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.dfl-action-text {
  font-size: 22rpx;
  line-height: 1;
  color: var(--gb-text-secondary);
}

.dfl-action-btn--off .dfl-action-text {
  color: #3567d7;
}

.dfl-dep-name {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--gb-text-muted);
  text-align: right;
}

.dfl-empty {
  margin-top: 80rpx;
  font-size: 26rpx;
  color: var(--gb-text-muted);
  text-align: center;
}

/* 配料弹窗 */
.ingredients-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.ingredients-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.ingredients-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--gb-bg-white);
  border-radius: 32rpx 32rpx 0 0;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
}

.ingredients-header {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 32rpx 24rpx 20rpx;
  border-bottom: 1rpx solid var(--gb-border-soft);
}

.ingredients-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gb-text);
}

.ingredients-close {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--gb-text-muted);
}

.ingredients-info {
  padding: 24rpx 32rpx 16rpx;
  border-bottom: 1rpx solid var(--gb-border-soft);
}

.ingredients-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gb-text);
  display: block;
}

.ingredients-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.ingredients-price {
  font-size: 26rpx;
  color: var(--gb-primary);
  font-weight: 600;
  margin-right: 20rpx;
}

.ingredients-sales {
  font-size: 24rpx;
  color: var(--gb-text-secondary);
}

.ingredients-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.ingredients-table-header {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: var(--gb-bg-page);
  border-bottom: 1rpx solid var(--gb-border-soft);
}

.ingredients-table-header text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--gb-text-secondary);
}

.th-name {
  flex: 2;
}

.th-amount {
  flex: 1;
  text-align: center;
}

.th-unit {
  flex: 1;
  text-align: center;
}

.ingredients-scroll {
  flex: 1;
  max-height: 50vh;
}

.ingredients-row {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--gb-border-soft);
}

.ingredients-row text {
  font-size: 26rpx;
  color: var(--gb-text);
}

.td-name {
  flex: 2;
}

.td-amount {
  flex: 1;
  text-align: center;
}

.td-unit {
  flex: 1;
  text-align: center;
}

.ingredients-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--gb-text-muted);
}

/* 绿色按钮 */
.dfl-action-btn--green {
  background: #e8f8f0;
  border: 1rpx solid rgba(24, 126, 110, 0.25);
  margin-top: 8rpx;
  padding: 10rpx 10rpx;
  font-size: 30rpx;
}

.dfl-action-btn--green .dfl-action-text {
  color: #187e6e;
}
