page {
  background: #f5f5f5;
}

.page-container {
  min-height: 100vh;
  background: #f5f5f5;
}

.content {
  padding-top: 20rpx;
}

/* 弹窗 */
.nnn {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 9999;
}

.modal-content {
  width: 90%;
  height: 35%;
  left: 5%;
  top: 20%;
  background-color: #fff;
  position: fixed;
}

.top {
  height: 20%;
  width: 100%;
  background: #187e6e;
  color: #fff;
  display: flex;
  flex-flow: column nowrap;
  justify-items: center;
  justify-content: center;
}

.goodsTitle {
  font-size: 60rpx;
  display: flex;
  flex-flow: row nowrap;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 20rpx;
}

.body {
  display: flex;
  flex-flow: column nowrap;
  height: 80%;
  align-content: stretch;
}

.numberInput {
  border-bottom: 1px solid gray;
  line-height: 70rpx;
  height: 70rpx;
  padding-left: 20rpx;
  font-size: 38rpx;
}

.searchPart {
  z-index: 9999;
  display: none;
}

.searchPart.is-active {
  display: block;
}
