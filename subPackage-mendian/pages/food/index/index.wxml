<view class="flex flex-column">
  <back-navbar title="菜单" avatar="/images/back.png" style="height: {{navBarHeight}}rpx;" bindnavbuttontap="toBack"></back-navbar>

  <view class="flex-column p-20">
    <view class="flex-row-reverse">
      
      <view class="food-add-btn flex-row-items-center" hover-class="food-add-btn--hover" bindtap="addFood">
        <image src="/images/add-fill.png" class="icon" mode="aspectFit"></image>
        <text>菜品类别</text>
      </view>
    </view>

    <view class="flex-column mt-30">
      <view
        class="food-cat-item"
        wx:for="{{storeArr}}"
        wx:for-item="dep"
        wx:key="gbDistributerFoodId"
        hover-class="food-cell-hover"
        bindtap="toFoodList"
        data-id="{{dep.gbDistributerFoodId}}"
        data-name="{{dep.gbDfFoodName}}"
        bindlongpress="showEdit"
        data-item="{{dep}}"
      >
        <view class="food-cat-item__left">
          <text class="food-cat-item__index">{{index + 1}}</text>
          <text class="food-cat-item__name">{{dep.gbDfFoodName}}</text>
        </view>
        <image src="/images/arrow-right-3.png" class="icon" mode="aspectFit"></image>
      </view>
    </view>
  </view>
</view>


<view class="mask {{showOperation ? 'is-active' : ''}}" catchtap="hideMask">
  <view class="popup" catchtap="noop">
    <view class="popup-item" bindtap="editFatherFood">
      <text>编辑「{{item.gbDfFoodName}}」</text>
    </view>
    <view class="popup-item popup-item--danger" bindtap="deleteFatherFood">删除「{{item.gbDfFoodName}}」</view>
  </view>
</view>
