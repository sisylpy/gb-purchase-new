/* ========== 基础变量 ========== */
page {
  background: #f5f7fa;
}

/* ========== 页面容器 ========== */
.page-container {
  min-height: 100vh;
  padding: 0 24rpx 40rpx;
  box-sizing: border-box;
}

/* ========== 区块卡片 ========== */
.section-card {
  background: #fff;
  border-radius: 20rpx;
  margin-top: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* ========== 卡片头部 ========== */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 16rpx;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-icon {
  width: 38rpx;
  height: 38rpx;
  margin-right: 12rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-right: 12rpx;
}

.store-name-row {
  display: flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(90, 180, 100, 0.06);
  border: 1rpx solid rgba(90, 180, 100, 0.15);
}

.store-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #5ab464;
}

.store-edit-icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 10rpx;
  opacity: 0.6;
}

.store-edit-text {
  font-size: 22rpx;
  color: #5ab464;
  margin-left: 6rpx;
  opacity: 0.7;
}

.badge-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  background: rgba(90, 180, 100, 0.1);
  color: #5ab464;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 0 10rpx;
}

/* ========== 操作按钮 ========== */
.action-btn {
  display: flex;
  align-items: center;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 30rpx;
  font-size: 25rpx;
  font-weight: 500;
  background: none;
  border: none;
  margin: 0;
}

.action-btn::after {
  border: none;
}

.btn-icon {
  font-size: 30rpx;
  font-weight: 700;
  margin-right: 6rpx;
  line-height: 1;
}

.invite-btn {
  background: linear-gradient(135deg, #5ab464 0%, #4aa354 100%);
  color: #fff !important;
  box-shadow: 0 4rpx 12rpx rgba(90, 180, 100, 0.3);
}

.invite-btn .btn-icon {
  font-size: 26rpx;
}

.add-btn {
  background: #f0f6f1;
  color: #5ab464 !important;
  border: 1rpx solid #c3e2c8;
}

.mini-share-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  padding: 10rpx 25rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #5ab464;
  background: rgba(90, 180, 100, 0.08);
  border: none;
  margin: 0;
  line-height: 58rpx;
}

.mini-share-btn::after {
  border: none;
}

.mini-share-btn:active {
  background: rgba(90, 180, 100, 0.18);
}

/* ========== 用户列表 ========== */
.user-list {
  padding: 0 16rpx 20rpx;
}

.user-item {
  display: flex;
  align-items: center;
  padding: 20rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background-color 0.15s;
}

.user-item:last-child {
  border-bottom: none;
}

.user-item:active {
  background-color: #fafafa;
  border-radius: 14rpx;
}

.user-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f0f0f0;
}

.user-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.user-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.arrow-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.3;
  flex-shrink: 0;
}

/* ========== 子部门 ========== */
.sub-dep-item {
  border-top: 1rpx solid #f0f0f0;
  margin-left: 28rpx;
  margin-right: 28rpx;
}

.sub-dep-item:first-child {
  border-top: none;
}

.sub-dep-header {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.sub-dep-tag {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #e8f5ec 0%, #d9eddF 100%);
  color: #5ab464;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.sub-dep-name {
  font-size: 29rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

.edit-dot {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  flex-shrink: 0;
}

.edit-dot::before,
.edit-dot::after {
  content: '';
  position: absolute;
  background: #ccc;
  border-radius: 50%;
}

.edit-dot::before {
  width: 10rpx;
  height: 10rpx;
  left: 10rpx;
  top: 17rpx;
}

.edit-dot::after {
  width: 10rpx;
  height: 10rpx;
  right: 10rpx;
  top: 17rpx;
}

.sub-dep-body {
  background: #fafbfc;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.invite-order-section {
  padding: 0 28rpx 16rpx;
}

.invite-order-section .sub-users-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.sub-users-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sub-users-label {
  font-size: 25rpx;
  color: #888;
  font-weight: 400;
}

.sub-user-list {
  display: flex;
  flex-wrap: wrap;
}

.sub-user-item {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
  margin-bottom: 12rpx;
}

.sub-user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
}

.sub-user-name {
  font-size: 24rpx;
  color: #555;
  margin-left: 12rpx;
  max-width: 140rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.empty-tip {
  text-align: center;
  font-size: 25rpx;
  color: #bbb;
  padding: 16rpx 0 8rpx;
}

/* ========== 空状态 ========== */
.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 36rpx;
}

.empty-img {
  width: 160rpx;
  height: 140rpx;
  opacity: 0.4;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #bbb;
}


/* ========== 用户操作菜单蒙版 ========== */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 999;
  opacity: 0;
  visibility: hidden;
  transition: all 0.25s ease;
}

.overlay.show {
  opacity: 1;
  visibility: visible;
}

.user-menu-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #fff;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.1);
  max-height: 70vh;
}

.overlay.show .user-menu-panel {
  transform: translateY(0);
}

.menu-panel-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 16rpx;
}

.menu-panel-title {
  font-size: 28rpx;
  color: #999;
  font-weight: 400;
  margin-bottom: 16rpx;
}

.menu-close-line {
  width: 64rpx;
  height: 8rpx;
  background: #ddd;
  border-radius: 4rpx;
}

/* 菜单项 - 横排带图标+文字+箭头 */
.user-menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background-color 0.15s;
}

.user-menu-item:last-of-type {
  border-bottom: none;
}

.user-menu-item:active {
  background-color: #f9f9f9;
}

.menu-item-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.menu-icon-blue {
  background: #eef5ff;
  color: #4a90d9;
}

.menu-icon-green {
  background: #eaf7ee;
  color: #5ab464;
}

.menu-icon-orange {
  background: #fef6ed;
  color: #e88b3d;
}

.menu-item-iconfont {
  font-size: 34rpx;
  font-weight: 700;
}

.menu-item-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.menu-item-title {
  font-size: 29rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.3;
}

.menu-item-desc {
  font-size: 23rpx;
  color: #aaa;
  margin-top: 4rpx;
}

.arrow-sm {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.3;
  flex-shrink: 0;
}

/* ========== 修改门店名称弹窗 ========== */
.edit-name-modal {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 36rpx 30rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.edit-name-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
}

.edit-name-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
  background: #f5f7fa;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.edit-name-btns {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
  gap: 24rpx;
}

.edit-name-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.cancel-btn {
  background: #f5f5f5;
  color: #999;
}

.confirm-btn {
  background: linear-gradient(135deg, #5ab464 0%, #4aa354 100%);
  color: #fff;
}
