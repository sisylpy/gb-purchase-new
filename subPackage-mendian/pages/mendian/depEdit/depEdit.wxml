

<wxs src="/wxs/format.wxs" module="tool" />

<view class="flex flex-column">

  <back-navbar style="height: {{navBarHeight}}rpx;" title="部门修改" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view wx:if="{{isCentralKitchen}}" class="central-entry" bindtap="openCentralPreparation">
    <view class="central-entry-icon">🍳</view>
    <view class="central-entry-text">
      <text class="central-entry-title">中央厨房配料</text>
      <text class="central-entry-desc">生产批次、领料、库存与成本追踪</text>
    </view>
    <text class="central-entry-arrow">›</text>
  </view>

  <view wx:else class="central-entry store-entry" bindtap="openStorePreparation">
    <view class="central-entry-icon">🥣</view>
    <view class="central-entry-text">
      <text class="central-entry-title">普通备料</text>
      <text class="central-entry-desc">备料品列表、添加与操作</text>
    </view>
    <text class="central-entry-arrow">›</text>
  </view>

  <view class="flex-column bg-white mt-10">
 
  <view class="p-20 flex-row font-lg">
        <text class="form-label" >部门名称:</text>
        <input class="form-input" placeholder="请输入门店名称" bindblur="bindKeyInput" value="{{depInfo.gbDepartmentName}}" />
   </view>

    <view class="p-20 text-secondary font-md">部门用户:</view>
   <scroll-view class="p-30" scroll-y="true" style="height: {{windowHeight - 580}}rpx; ">
        <view  class="flex-row-between  p-10 border-bottom" wx:for="{{depInfo.gbDepartmentUserEntities}}" wx:for-item="user"  style="width: {{windowWidth - 80}}rpx;">
         <view class="flex-row font-lg">
          <text class="mr-20">{{index + 1}}.</text>
          <image src="{{url + user.gbDuWxAvartraUrl}}" mode="aspectFill" class="icon mr-30"/>
             <text class="font-sl mr-30">{{user.gbDuWxNickName}}</text>
             <text wx:if="{{depInfo.gbDepartmentEntityList.length  > 0}}">{{user.gbDepartmentEntity.gbDepartmentName}}</text>
         </view>
          <view class="button-container-white" bind:tap="delUser" data-id="{{user.gbDepartmentUserId}}" hover-class="hover">
          <image src="/images/del.png" mode="aspectFill" class="icon"/>
          </view>
           </view>

            <view  class="flex-column text-secondary font-sl center-content" style="height: 200rpx;">没有数据了!</view>
      </scroll-view>

  </view>

  <view class="popup-footer">
      <button class="save-btn" style="width: {{windowWidth - 80}}rpx;" bindtap="toSave">保存设置</button>

       <view class="flex-column center-content ">
        <view class="flex-column text-danger p-30" bind:tap="deleteItem"> 删除</view>
       </view>
    </view>
</view>

<!--  操作  -->
<view class='overlay {{showOperationUser ? "show" : "hide"}}' catchtouchmove='ture' catchtap="hideMask" catchtouchmove='ture' catchtap="hideUserMask">
  <view class="flex-column nnn bg-white">

    <view class="flex-row  p-30 operation_row " bindtap="delUser">
      <image src="../../../images/del.png" class="icon mr-10"></image>
      <text class=" margin-right">删除用户</text>
    </view>
    <view style="height: 20rpx;"></view>
  </view>
</view>


<delWarnModal wx:if="{{showPopupWarn}}" type="{{popupType}}" warnContent="{{warnContent}}" bind:closeWarn="closeWarn" bind:confirmWarn="confirmWarn" />