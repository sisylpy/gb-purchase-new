
.form-label {
  font-size: 32rpx;
  color: #666;
  width: 200rpx;
}

.form-input {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  padding: 0 20rpx;
  border: 1px solid #ddd;
  border-radius: 10rpx;
}


/* 中央厨房配料入口 */
.central-entry {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 20rpx;
  padding: 28rpx 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.central-entry-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eaf6f3;
  color: #187e6e;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.store-entry .central-entry-icon {
  background: #eef3ff;
  color: #3a6df0;
}

.central-entry-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.central-entry-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.central-entry-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.central-entry-arrow {
  font-size: 44rpx;
  color: #ccc;
}

/* 底部按钮 */
.popup-footer {
  position: fixed;
  bottom: 40rpx;
  width: 100%;
}

.save-btn {
  /* width: 100%; */
  height: 80rpx;
  background-color: #187e6e;
  color: #fff;
  font-size: 32rpx;
  border-radius: 10rpx;
  text-align: center;
  line-height: 80rpx;
  margin-bottom: 20rpx;

}
