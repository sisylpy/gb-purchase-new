// 根据日期字符串计算星期几
function getWeekDay(dateString) {
  if (!dateString) {
    return '';
  }
  
  // 将日期字符串转换为Date对象
  // 格式: "2025-08-01"
  var dateFormat = dateString.replace(getRegExp('-','g'),'/');
  var date = getDate(dateFormat);
  
  // 获取星期几 (0-6, 0是星期日)
  var dayOfWeek = date.getDay();
  
  // 转换为中文星期
  var weekDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];
  
  return weekDays[dayOfWeek];
}

// 从日期字符串中提取日期号数
function getDayNumber(dateString) {
  if (!dateString) {
    return '';
  }
  
  // 格式: "2025-08-01" -> 提取 "01"
  var day = dateString.substring(8, 10);
  
  // 去掉前导零，如 "01" -> "1"
  if (day.charAt(0) === '0') {
    day = day.charAt(1);
  }
  
  return day;
}

// 获取月日格式，如 "9月1日"
function getMonthDay(dateString) {
  if (!dateString) {
    return '';
  }
  
  // 格式: "2025-08-01" -> 提取月份和日期
  var month = dateString.substring(5, 7);
  var day = dateString.substring(8, 10);
  
  // 去掉前导零
  if (month.charAt(0) === '0') {
    month = month.charAt(1);
  }
  if (day.charAt(0) === '0') {
    day = day.charAt(1);
  }
  
  return month + '月' + day + '日';
}

// 获取日期范围
function getDateRange(rangeType) {
  if (!rangeType) {
    return { startDate: '', stopDate: '' };
  }
  
  var today = getDate();
  var year = today.getFullYear();
  var month = today.getMonth() + 1; // 0-11 转为 1-12
  var date = today.getDate();
  
  // 格式化日期为 YYYY-MM-DD
  function formatDate(d) {
    var y = d.getFullYear();
    var m = d.getMonth() + 1;
    var day = d.getDate();
    return y + '-' + (m < 10 ? '0' + m : m) + '-' + (day < 10 ? '0' + day : day);
  }
  
  var startDate = '';
  var stopDate = '';
  
  switch (rangeType) {
    case 'today':
      startDate = stopDate = formatDate(today);
      break;
      
    case 'yesterday':
      var yesterday = getDate(today.getTime() - 24 * 60 * 60 * 1000);
      startDate = stopDate = formatDate(yesterday);
      break;
      
    case 'thisWeek':
      // 获取本周一
      var dayOfWeek = today.getDay();
      var daysToMonday = dayOfWeek === 0 ? -6 : 1 - dayOfWeek; // 周日为0，需要-6天到周一
      var thisWeekStart = getDate(today.getTime() + daysToMonday * 24 * 60 * 60 * 1000);
      startDate = formatDate(thisWeekStart);
      
      // 获取本周日（本周最后一天）
      var daysToSunday = dayOfWeek === 0 ? 0 : 7 - dayOfWeek; // 如果今天是周日，则不需要调整
      var thisWeekEnd = getDate(today.getTime() + daysToSunday * 24 * 60 * 60 * 1000);
      stopDate = formatDate(thisWeekEnd);
      break;
      
    case 'lastWeek':
      // 获取上周一
      var dayOfWeek = today.getDay();
      var daysToLastMonday = dayOfWeek === 0 ? -13 : -6 - dayOfWeek;
      var lastWeekStart = getDate(today.getTime() + daysToLastMonday * 24 * 60 * 60 * 1000);
      startDate = formatDate(lastWeekStart);
      
      // 获取上周日
      var lastWeekEnd = getDate(lastWeekStart.getTime() + 6 * 24 * 60 * 60 * 1000);
      stopDate = formatDate(lastWeekEnd);
      break;
      
    case 'lastSevenDays':
      // 过去7天（不包括今天）
      var sevenDaysAgo = getDate(today.getTime() - 7 * 24 * 60 * 60 * 1000);
      startDate = formatDate(sevenDaysAgo);
      
      var yesterday = getDate(today.getTime() - 24 * 60 * 60 * 1000);
      stopDate = formatDate(yesterday);
      break;
      
    case 'thisMonth':
      // 本月第一天
      var thisMonthStart = getDate(year + '-' + (month < 10 ? '0' + month : month) + '-01');
      startDate = formatDate(thisMonthStart);
      
      // 结束时间是今天
      stopDate = formatDate(today);
      break;
      
    case 'lastMonth':
      // 上月第一天
      var lastMonth = month === 1 ? 12 : month - 1;
      var lastYear = month === 1 ? year - 1 : year;
      var lastMonthStart = getDate(lastYear + '-' + (lastMonth < 10 ? '0' + lastMonth : lastMonth) + '-01');
      startDate = formatDate(lastMonthStart);
      
      // 上月最后一天 - 使用本月第一天减去一天
      var thisMonthFirst = getDate(year + '-' + (month < 10 ? '0' + month : month) + '-01');
      var lastMonthEnd = getDate(thisMonthFirst.getTime() - 24 * 60 * 60 * 1000);
      stopDate = formatDate(lastMonthEnd);
      break;
      
    case 'lastThirtyDays':
      // 从上个月的今天到今天的日期
      var lastMonthToday = getDate(today.getTime());
      lastMonthToday.setMonth(lastMonthToday.getMonth() - 1);
      startDate = formatDate(lastMonthToday);
      
      stopDate = formatDate(today);
      break;
      
    default:
      startDate = stopDate = '';
  }
  
  // 获取中文名称
  var chineseName = '';
  switch (rangeType) {
    case 'today':
      chineseName = '今天';
      break;
    case 'yesterday':
      chineseName = '昨天';
      break;
    case 'thisWeek':
      chineseName = '本周';
      break;
    case 'lastWeek':
      chineseName = '上周';
      break;
    case 'lastSevenDays':
      chineseName = '过去7天';
      break;
    case 'thisMonth':
      chineseName = '本月';
      break;
    case 'lastMonth':
      chineseName = '上月';
      break;
    case 'lastThirtyDays':
      chineseName = '过去30天';
      break;
    default:
      chineseName = rangeType;
  }

  return {
    startDate: startDate,
    stopDate: stopDate,
    name: chineseName
  };
}

// 计算从指定日期到今天多少天
function getHowManyDays(targetDate) {
  if (!targetDate) {
    return 0;
  }
  
  // 处理不同格式的日期字符串
  var dateStr = targetDate.toString();
  
  // 如果是 YYYY-MM-DD 格式，直接使用
  if (dateStr.match(getRegExp('^\\d{4}-\\d{2}-\\d{2}$'))) {
    var target = getDate(dateStr);
  } else {
    // 尝试解析其他格式
    target = getDate(dateStr);
  }
  
  // 检查日期是否有效
  if (isNaN(target.getTime())) {
    return 0;
  }
  
  var today = getDate();
  
  // 重置时间为00:00:00，只比较日期部分
  today.setHours(0, 0, 0, 0);
  target.setHours(0, 0, 0, 0);
  
  // 计算时间差（毫秒）
  var timeDiff = today.getTime() - target.getTime();
  
  // 转换为天数
  var daysDiff = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
  
  return daysDiff;
}

// 将日期时间字符串转换为"9月30日23点39分"格式
function formatDateTimeToChinese(dateTimeString) {
  if (!dateTimeString) {
    return '';
  }
  
  // 处理格式: "2025-09-30 23:39"
  var dateTimeStr = dateTimeString.toString();
  
  // 分割日期和时间部分
  var parts = dateTimeStr.split(' ');
  if (parts.length !== 2) {
    return '';
  }
  
  var datePart = parts[0]; // "2025-09-30"
  var timePart = parts[1];  // "23:39"
  
  // 分割日期
  var dateArray = datePart.split('-');
  if (dateArray.length !== 3) {
    return '';
  }
  
  var year = dateArray[0];
  var month = dateArray[1];
  var day = dateArray[2];
  
  // 分割时间
  var timeArray = timePart.split(':');
  if (timeArray.length < 2) {
    return '';
  }
  
  var hour = timeArray[0];
  var minute = timeArray[1];
  
  // 去掉前导零
  if (month.charAt(0) === '0') {
    month = month.charAt(1);
  }
  if (day.charAt(0) === '0') {
    day = day.charAt(1);
  }
  if (hour.charAt(0) === '0') {
    hour = hour.charAt(1);
  }
  if (minute.charAt(0) === '0') {
    minute = minute.charAt(1);
  }
  
  // 组合成中文格式
  return month + '月' + day + '日' + hour + '点' + minute + '分';
}




function formatDistance(meters) {
  if (!meters) return '';
  if (meters < 1000) return meters + 'm';
  var km = Math.round(meters / 100) / 10;
  return km + 'km';
}

// 格式化数字：整数不加小数点，小数保留合适位数
function formatNumber(num) {
  if (num === null || num === undefined) return '0';
  var n = +num || 0;
  // 整数直接返回
  if (n === Math.floor(n)) return n.toString();
  // 一位小数
  var rounded = Math.round(n * 10) / 10;
  return rounded.toString();
}

/** 实际每份用量 = 实际用量 / 销售份数（无效份数返回 —） */
function actualUsagePerPortion(actualUsage, salesPortions) {
  var u = +actualUsage;
  var p = +salesPortions;
  if (p !== p || p <= 0) {
    return '—';
  }
  if (u !== u) {
    u = 0;
  }
  return formatNumber(u / p);
}

/** 进度条宽度：value 已为 0～100 百分数（如毛利率），与 WXML 「xx%」一致，直接映射到 track 百分比 */
function healthBarWidthPercent(percentVal) {
  var m = +percentVal;
  if (m !== m || m <= 0) return 0;
  if (m >= 100) return 100;
  return +m.toFixed(1);
}

/** 看板利润率文字颜色 */
function marginTextColor(margin) {
  var m = parseFloat(margin) || 0;
  if (m < 1) return '#eb3349';
  if (m < 5) return '#f45c43';
  if (m < 10) return '#ffd700';
  return '#38ef7d';
}

/** 经营净利率等可负的百分数字体色 */
function signedPercentRateColor(val) {
  var n = +val;
  if (n !== n) return '#8892b0';
  if (n >= 10) return '#38ef7d';
  if (n > 0) return '#a7f3d0';
  if (n === 0) return '#8892b0';
  return '#eb3349';
}

/** 健康卡 KPI 数值颜色 */
function healthKpiValueColor(rowKey, val) {
  rowKey = rowKey + '';
  if (rowKey === '经营净利率') return signedPercentRateColor(val);
  if (rowKey.indexOf('毛利率') >= 0) return marginTextColor(val);
  return '#cbd5f5';
}

/** scaleBase.healthCard 行右侧百分数字符串（净利率带正号，其余正数不带 +） */
function healthPercentText(val, rowKey) {
  var n = +val;
  if (n !== n) return '—';
  var s = (+n.toFixed(1)).toString();
  rowKey = rowKey + '';
  if (rowKey === '经营净利率' && n > 0) s = '+' + s;
  return s + '%';
}

/** 仅对占比类 KPI 展示 0～100 进度条（净利率不参与条形） */
function healthKpiUsePercentBar(rowKey) {
  rowKey = rowKey + '';
  if (rowKey === '经营净利率') return false;
  var n = rowKey.indexOf('占比');
  if (n >= 0) return true;
  if (rowKey.indexOf('毛利率') >= 0) return true;
  return false;
}

/** 条形填充色（占比类用渐变主色片段，毛利率沿用 margin 色谱） */
function healthKpiBarColor(rowKey, value) {
  rowKey = rowKey + '';
  if (rowKey.indexOf('毛利率') >= 0) return marginTextColor(value);
  return '#667eea';
}

/** scaleBase.monthForecast.rows 明细值展示 */
function scaleBaseForecastCellValue(rowKey, value) {
  rowKey = rowKey + '';
  var n = +value;
  if (n !== n) return value + '';
  if (rowKey.indexOf('进度') >= 0) return formatNumber(n) + '%';
  if (rowKey.indexOf('天数') >= 0) {
    return formatNumber(n) + ' 天';
  }
  if (rowKey.indexOf('盈亏') >= 0) {
    if (rowKey.indexOf('绝对值') >= 0) return '¥' + formatNumber(Math.abs(n));
    var sign = n >= 0 ? '+' : '-';
    return sign + '¥' + formatNumber(Math.abs(n));
  }
  return formatNumber(n);
}

/** forecast 明细行是否为金额类（右对齐字体略大） */
function scaleBaseForecastCellIsMoney(rowKey) {
  rowKey = rowKey + '';
  return rowKey.indexOf('盈亏') >= 0;
}

/** 经营分析行展示（按 key 简单区分金额/百分比/天数/状态） */
function analysisRowDisplay(key, value) {
  key = key + '';
  if (key === '状态') return value + '';
  if (key === '统计天数') return value + ' 天';
  if (key === '利润率') return value + '%';
  var n = +value;
  if (n !== n) return value + '';
  return '¥' + formatNumber(n);
}

function analysisTrendClass(key, value) {
  key = key + '';
  if (key !== '每日盈亏' && key !== '利润率') return '';
  var n = +value;
  if (n !== n) return '';
  return n >= 0 ? 'analysis-trend-up' : 'analysis-trend-down';
}

/** 毛利率小数字符串列展示；空/未返回时「—」，否则「xx.xx%」（与 GbDepFoodBusinessInsight 口径的字符串一致） */
function marginRateStringForCell(s) {
  if (s == null) return '—';
  s = s + '';
  if (s === '') return '—';
  return s + '%';
}

/** 订货弹窗：批发商规格展示，有系数时如 2斤*箱 */
function dsStandardLabel(standard, baseStandardName) {
  if (!standard || !standard.gbDsStandardName) {
    return '';
  }
  var name = standard.gbDsStandardName;
  var scale = standard.gbDsStandardScale;
  var base = baseStandardName != null ? baseStandardName + '' : '';
  var scaleStr = scale != null ? scale + '' : '';
  if (scaleStr && scaleStr !== 'null' && scaleStr !== '-1') {
    var n = +scale;
    if (!isNaN(n) && n > 0) {
      return scaleStr + base + '*' + name;
    }
  }
  return name;
}

// ===== 以下函数原分散于历史 wxs，已统一并入本文件作为唯一逻辑源 =====

function trimStrForNum(v) {
  if (v === undefined || v === null) {
    return '';
  }
  var s = '' + v;
  var start = 0;
  var end = s.length - 1;
  var ws = ' \n\r\t';
  while (start <= end && ws.indexOf(s.charAt(start)) >= 0) {
    start++;
  }
  while (end >= start && ws.indexOf(s.charAt(end)) >= 0) {
    end--;
  }
  return start > end ? '' : s.substring(start, end + 1);
}

function _marginLevel(ins) {
  if (!ins) {
    return 'UNKNOWN';
  }
  var level = ins.grossMarginLevel;
  if (level === undefined || level === null || level === '') {
    return 'UNKNOWN';
  }
  return '' + level;
}

function getWasteRemainHours(wasteFullTime, nowTime) {
  var hours = getRestTime(wasteFullTime, nowTime);
  return hours < 0 ? -hours : 0;
}

function isSupplierMatch(supplierId, selectedSupplierIds) {
  if (!supplierId || !selectedSupplierIds || selectedSupplierIds === -1) {
    return false;
  }
  var supplierIdArray = selectedSupplierIds.toString().split(',');
  for (var i = 0; i < supplierIdArray.length; i++) {
    if (supplierIdArray[i] == supplierId) {
      return true;
    }
  }
  return false;
}

function isPurchaseUserMatch(purchaseUserId, selectedPurchaseUserIds) {
  if (!purchaseUserId || !selectedPurchaseUserIds || selectedPurchaseUserIds === -1) {
    return false;
  }
  var purchaseUserIdArray = selectedPurchaseUserIds.toString().split(',');
  for (var i = 0; i < purchaseUserIdArray.length; i++) {
    if (purchaseUserIdArray[i] == purchaseUserId) {
      return true;
    }
  }
  return false;
}

function getDay(dateString) {
  if (!dateString) {
    return '';
  }
  var day = dateString.substring(8, 10);
  if (day.charAt(0) === '0') {
    day = day.charAt(1);
  }
  return day;
}

function getMonth(dateString) {
  if (!dateString) {
    return '';
  }
  var month = dateString.substring(5, 7);
  if (month.charAt(0) === '0') {
    month = month.charAt(1);
  }
  return month;
}

function getWeekDayName(weekday) {
  if (weekday === undefined || weekday === null) {
    return '';
  }
  var weekDays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
  return weekDays[weekday] || '';
}

function pricePerPortion(totalAmount, soldPortions) {
  if (totalAmount === undefined || totalAmount === null || soldPortions === undefined || soldPortions === null) {
    return '—';
  }
  var sa = trimStrForNum(totalAmount);
  var sp = trimStrForNum(soldPortions);
  if (sa === '' || sp === '') {
    return '—';
  }
  var t = parseFloat(sa);
  var p = parseFloat(sp);
  if (t !== t || p !== p || !(p > 0)) {
    return '—';
  }
  var per = t / p;
  return per.toFixed(2);
}

function marginPerformanceHint(actualGrossStr) {
  if (actualGrossStr == null) {
    return '';
  }
  var s = trimStrForNum(actualGrossStr);
  if (s === '') {
    return '';
  }
  var n = parseFloat(s);
  if (n !== n) {
    return '持续优化成本与毛利';
  }
  if (n >= 50) {
    return '表现优秀，继续保持！';
  }
  if (n >= 30) {
    return '表现良好，可继续优化';
  }
  if (n >= 0) {
    return '建议关注成本与售价';
  }
  return '建议核查经营数据';
}

function marginStandardMetaLine(ins) {
  if (!ins) {
    return '';
  }
  var T = ins.grossMarginStandardTarget;
  var F = ins.grossMarginStandardFloatAbs;
  var lo = ins.grossMarginStandardBandLower;
  var hi = ins.grossMarginStandardBandUpper;
  var hasT = T !== undefined && T !== null && trimStrForNum(T) !== '';
  var hasF = F !== undefined && F !== null && trimStrForNum(F) !== '';
  var hasLo = lo !== undefined && lo !== null && trimStrForNum(lo) !== '';
  var hasHi = hi !== undefined && hi !== null && trimStrForNum(hi) !== '';
  if (!hasT && !hasF && !(hasLo && hasHi)) {
    return '';
  }
  var parts = [];
  if (hasT) {
    parts.push('目标 ' + trimStrForNum(T) + '%');
  }
  if (hasF) {
    parts.push('浮动 ±' + trimStrForNum(F) + '%');
  }
  if (hasLo && hasHi) {
    parts.push('标准范围 ' + trimStrForNum(lo) + '%～' + trimStrForNum(hi) + '%');
  }
  if (parts.length === 0) {
    return '';
  }
  return parts.join(' · ');
}

function marginStandardHint(ins) {
  if (!ins) {
    return '';
  }
  var level = _marginLevel(ins);
  if (level === 'UNKNOWN') {
    return '无对照标准';
  }
  if (level === 'IN_BAND') {
    return '在目标区间内';
  }
  if (level === 'BELOW') {
    return '低于目标区间';
  }
  if (level === 'ABOVE') {
    return '高于目标区间';
  }
  return '';
}

function marginStandardShowBlock(ins) {
  if (!ins) {
    return '';
  }
  var m = marginStandardMetaLine(ins);
  var h = marginStandardHint(ins);
  return (m !== '' || h !== '') ? '1' : '';
}

function marginStandardHintMod(ins) {
  var level = _marginLevel(ins);
  if (level === 'IN_BAND') {
    return 'dfl-blend-hero__hint--ok';
  }
  if (level === 'BELOW') {
    return 'dfl-blend-hero__hint--warn';
  }
  if (level === 'ABOVE') {
    return 'dfl-blend-hero__hint--good';
  }
  return 'dfl-blend-hero__hint--muted';
}

function marginStandardHintModDga(ins) {
  var level = _marginLevel(ins);
  if (level === 'IN_BAND') {
    return 'dga-hero__margin--ok';
  }
  if (level === 'BELOW') {
    return 'dga-hero__margin--warn';
  }
  if (level === 'ABOVE') {
    return 'dga-hero__margin--good';
  }
  return 'dga-hero__margin--muted';
}

function calcActualProfit(actualRevenue, actualCostTotalAmount123) {
  var rev = parseFloat(actualRevenue);
  var cost = parseFloat(actualCostTotalAmount123);
  if (rev !== rev || cost !== cost) {
    return '—';
  }
  var profit = rev - cost;
  return profit.toFixed(2);
}

function perPortionDisplay(standardWeight, recipeUsagePerPortion, unit, portionAmount, portionUnit) {
  if (standardWeight != null && standardWeight !== '' && standardWeight !== undefined) {
    var s = '' + recipeUsagePerPortion;
    var dot = s.indexOf('.');
    if (dot >= 0) {
      var decimals = s.substring(dot + 1);
      if (decimals.length > 2) {
        for (var i = 2; i < decimals.length; i++) {
          if (decimals.charAt(i) !== '0') {
            if (portionAmount != null && portionAmount !== '' && portionUnit) {
              return portionAmount + portionUnit + '';
            }
            return recipeUsagePerPortion + unit + '';
          }
        }
      }
    }
  }
  return recipeUsagePerPortion + unit + '';
}

function perPortionDeviation(recipeUsagePerPortion, actualPerPortion, unit) {
  if (recipeUsagePerPortion == null || actualPerPortion == null || recipeUsagePerPortion === '' || actualPerPortion === '') {
    return '--';
  }
  var dev = recipeUsagePerPortion - actualPerPortion;
  dev = Math.round(dev * 100) / 100;
  var str = '' + dev;
  var dot = str.indexOf('.');
  if (dot < 0) str = str + '.00';
  else if (str.length - dot === 2) str = str + '0';
  if (dev > 0) return '+' + str + unit + '/份';
  return str + unit + '/份';
}

function remainingAfterOutbound(remainingBeforeOutbound, quantity) {
  if (remainingBeforeOutbound == null || quantity == null || remainingBeforeOutbound === '' || quantity === '') {
    return '--';
  }
  var r = parseFloat(remainingBeforeOutbound) - parseFloat(quantity);
  r = Math.round(r * 100) / 100;
  return '' + r;
}

function transferDateTimeShort(datetime){
  if (datetime == null || datetime === '' || datetime === undefined) return '';
  var month = datetime.substring(5, 7);
  var day = datetime.substring(8, 10);
  var time = datetime.length >= 16 ? datetime.substring(11, 16) : '';
  if (month.charAt(0) === '0') month = month.charAt(1);
  if (day.charAt(0) === '0') day = day.charAt(1);
  var result = month + '月' + day + '日';
  if (time !== '') result = result + ' ' + time;
  return result;
}

// ===== 独有函数并入结束 =====

module.exports = {
  getGongli:getGongli,
  getPercent: getPercent,
  getProfitPercent:getProfitPercent,
  getAttrName: getAttrName,
  getAttrDate: getAttrDate,
  getAttrFullTime: getAttrFullTime,
  transferDateString: transferDateString,
  transferDateTimeString: transferDateTimeString,
  transferFullTimeString: transferFullTimeString,
  getAttrString: getAttrString,
  getAttrDateString: getAttrDateString,
  getProducePercent: getProducePercent,
  getCompareTime: getCompareTime,
  getHoursUntilWaste: getHoursUntilWaste,
  getRestTime: getRestTime,
  getHaveWasteHours: getHaveWasteHours,
  getDifferentPrice: getDifferentPrice,
  changeDateStyleDot: changeDateStyleDot,
  transferCouponTimeString: transferCouponTimeString,
  transferCouponDateString: transferCouponDateString,
  getSupplierPriceColor: getSupplierPriceColor,
  getPurchaseUserColor: getPurchaseUserColor,
  getPriceColor: getPriceColor,
  getCostTotal: getCostTotal,
  getCompareTimeSecond: getCompareTimeSecond,
  getWeekDay: getWeekDay,
  getDayNumber: getDayNumber,
  getMonthDay: getMonthDay,
  getDateRange: getDateRange,
  getHowManyDays: getHowManyDays,
  formatDateTimeToChinese: formatDateTimeToChinese,
  formatDistance: formatDistance,
  formatNumber: formatNumber,
  actualUsagePerPortion: actualUsagePerPortion,
  healthBarWidthPercent: healthBarWidthPercent,
  marginTextColor: marginTextColor,
  signedPercentRateColor: signedPercentRateColor,
  healthKpiValueColor: healthKpiValueColor,
  healthPercentText: healthPercentText,
  healthKpiUsePercentBar: healthKpiUsePercentBar,
  healthKpiBarColor: healthKpiBarColor,
  scaleBaseForecastCellValue: scaleBaseForecastCellValue,
  scaleBaseForecastCellIsMoney: scaleBaseForecastCellIsMoney,
  analysisRowDisplay: analysisRowDisplay,
  analysisTrendClass: analysisTrendClass,
  marginRateStringForCell: marginRateStringForCell,
  dsStandardLabel: dsStandardLabel,
  getWasteRemainHours: getWasteRemainHours,
  isSupplierMatch: isSupplierMatch,
  isPurchaseUserMatch: isPurchaseUserMatch,
  getDay: getDay,
  getMonth: getMonth,
  getWeekDayName: getWeekDayName,
  pricePerPortion: pricePerPortion,
  marginPerformanceHint: marginPerformanceHint,
  marginStandardMetaLine: marginStandardMetaLine,
  marginStandardHint: marginStandardHint,
  marginStandardShowBlock: marginStandardShowBlock,
  marginStandardHintMod: marginStandardHintMod,
  marginStandardHintModDga: marginStandardHintModDga,
  calcActualProfit: calcActualProfit,
  perPortionDisplay: perPortionDisplay,
  perPortionDeviation: perPortionDeviation,
  remainingAfterOutbound: remainingAfterOutbound,
  transferDateTimeShort: transferDateTimeShort

}