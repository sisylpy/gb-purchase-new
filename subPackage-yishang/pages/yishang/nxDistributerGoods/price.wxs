function parsePrice(price) {
  if (price === null || price === undefined || price === '') return -1;
  var n = parseFloat(price);
  return isNaN(n) ? -1 : n;
}

function isValidDisplayPrice(price) {
  var n = parsePrice(price);
  return n > 0.1;
}

module.exports = {
  isValidDisplayPrice: isValidDisplayPrice
};
