@import "../../styles/platform-tab-page.wxss";

.page-snapshot-goods {
  background-color: #fdf9ee;
}

.snapshot-title-block {
  padding-top: 0;
  padding-bottom: 16rpx;
}

.snapshot-loading,
.snapshot-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #999;
  font-size: 28rpx;
}

.snapshot-empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.snapshot-empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.snapshot-empty-hint {
  font-size: 24rpx;
  color: #aaa;
  text-align: center;
}

.product-item {
  margin: 0 20rpx 20rpx;
  border: 1rpx solid #f3c853;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx 10rpx;
}

.goods_item {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.brand {
  border: 1rpx solid lightgray;
  font-size: 24rpx;
  padding: 2rpx 8rpx;
  color: #187e6e;
  border-radius: 8rpx;
  margin-right: 8rpx;
}

.snapshot-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #187e6e;
}

.snapshot-date {
  margin-left: 12rpx;
  color: #999;
}

.save_btn {
  background-color: #f08308;
  color: #fff;
  font-size: 28rpx;
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
}

.save_btn.has_order {
  background-color: #187e6e;
}

.list-footer,
.list-loading {
  padding: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.image-modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 80%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
}

.modal-image {
  width: 100%;
  height: 400rpx;
}

.flex-row-default { display: flex; flex-direction: row; align-items: flex-start; }
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-column { display: flex; flex-direction: column; }
.flex-1 { flex: 1; min-width: 0; }
.middle { align-items: center; }
.font-xl { font-size: 32rpx; }
.font-sl { font-size: 26rpx; }
.gray { color: #999; }
.text-secondary { color: #888; }
.p-10 { padding: 10rpx; }
.mr-20 { margin-right: 20rpx; }
.five-weight { font-weight: 500; }
