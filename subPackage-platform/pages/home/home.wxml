<view class="platform-tab-page page-home">
  <!-- 顶部区域（固定） -->
  <view class="platform-tab-header header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-inner">
      <view class="header-top">
        <text class="market-title">{{market.marketName}}</text>
        <view class="dept-picker" bindtap="onDepartmentTap" hover-class="dept-picker-hover">
          <image class="dept-icon" src="/images/house_alt.png" mode="aspectFit" />
          <text class="dept-name">{{currentDepartment.departmentName}}</text>
          <text class="dept-arrow">▼</text>
        </view>
      </view>
      <view class="search-bar" bindtap="onSearchTap" hover-class="search-bar-hover">
        <image class="search-icon" src="/images/search.png" mode="aspectFit" />
        <text class="search-placeholder">{{searchPlaceholder}}</text>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="platform-tab-scroll main-scroll" style="padding-top: {{scrollTopPadding}}px;">
    <!-- 待支付 Banner -->
    <view class="outstanding-banner" wx:if="{{hasOutstandingBill && outstandingBanner}}" bindtap="onOutstandingBannerTap" hover-class="outstanding-banner-hover">
      <text class="outstanding-banner-text">{{outstandingBanner.text}}</text>
      <text class="outstanding-banner-arrow">›</text>
    </view>

    <!-- 市场公告 -->
    <view class="notice-card">
      <view class="notice-badge">{{market.notice || '今日市场'}}</view>
      <view class="notice-body">
        <text class="notice-main">{{market.noticeSub}}</text>
        <text class="notice-sub">平台统一分配配送商</text>
      </view>
    </view>

    <!-- 市场批发商 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">市场批发商</text>
        <text class="section-hint">平台统一配送</text>
      </view>
      <scroll-view scroll-x class="supplier-scroll" enable-flex wx:if="{{suppliers.length > 0}}">
        <view
          class="supplier-card"
          wx:for="{{suppliers}}"
          wx:key="distributerId"
          bindtap="onSupplierTap"
          data-id="{{item.distributerId}}"
          data-name="{{item.distributerName}}"
          data-active="{{item.isActive}}"
          data-count="{{item.goodsCount}}"
          data-categories="{{item.mainCategories}}"
          data-address="{{item.address}}"
          data-logo="{{item.logo}}"
          hover-class="supplier-card-hover"
        >
          <view class="supplier-avatar">{{item.distributerName[0]}}</view>
          <text class="supplier-name">{{item.distributerName}}</text>
          <text class="supplier-meta">{{item.mainCategories}}</text>
          <text class="supplier-count">{{item.goodsCount}} 种商品</text>
        </view>
      </scroll-view>
      <view class="supplier-empty" wx:if="{{suppliersLoading}}">批发商加载中...</view>
      <view class="supplier-empty" wx:elif="{{suppliers.length === 0}}">暂无批发商数据</view>
    </view>

    <!-- 商品类别九宫格 -->
    <view class="section section-last">
      <view class="section-head">
        <text class="section-title">采购分类</text>
      </view>
      <view class="category-grid" wx:if="{{categories.length > 0}}">
        <view
          class="category-item"
          wx:for="{{categories}}"
          wx:key="categoryId"
          bindtap="onCategoryTap"
          data-id="{{item.categoryId}}"
          data-name="{{item.categoryName}}"
          hover-class="category-item-hover"
        >
          <view class="category-icon-wrap">
            <image class="category-icon" src="{{item.icon}}" mode="aspectFit" />
          </view>
          <text class="category-name">{{item.categoryName}}</text>
        </view>
      </view>
      <view class="supplier-empty" wx:if="{{categoriesLoading}}">分类加载中...</view>
      <view class="supplier-empty" wx:elif="{{categories.length === 0}}">暂无分类数据</view>
    </view>

    <view class="platform-tab-bottom-spacer"></view>
  </scroll-view>
  <platform-tab-bar active="home" cartBadge="{{cartBadge}}" />
</view>
