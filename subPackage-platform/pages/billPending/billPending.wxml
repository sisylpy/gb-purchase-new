<view class="page-bill" wx:if="{{bill}}">
  <view class="bill-card">
    <text class="bill-state">{{statusText || billPayState}}</text>
    <text class="bill-supplier" wx:if="{{supplierName}}">{{supplierName}}</text>
    <text class="bill-id">采购单 #{{bill.billId}}</text>

    <view class="bill-amount-row">
      <text class="bill-amount-label">已知价格合计</text>
      <text class="bill-amount bill-amount-known">¥{{knownTotal}}</text>
    </view>
    <view class="bill-amount-row bill-amount-row-compact">
      <text class="bill-amount-label">已支付已知金额</text>
      <text class="bill-amount bill-amount-paid">¥{{paidTotal}}</text>
    </view>

    <view class="bill-meta-row bill-meta-row-pending" wx:if="{{pendingPriceItemCount > 0}}">
      <text>{{pendingPriceItemCount}} 项未知价格商品 · 待称重确认</text>
    </view>
    <view class="bill-meta-row bill-meta-row-pending" wx:if="{{pendingNotice}}">
      <text>{{pendingNotice}}</text>
    </view>

    <view class="bill-supplement-row" wx:if="{{showSupplementBtn}}">
      <text class="bill-amount-label">待补款金额</text>
      <text class="bill-amount bill-amount-supplement">¥{{supplementDue}}</text>
    </view>
  </view>

  <view class="bill-lines-card" wx:if="{{billLines.length}}">
    <text class="bill-lines-title">采购单商品</text>
    <view class="bill-line" wx:for="{{billLines}}" wx:key="index">
      <view class="bill-line-main">
        <text class="bill-line-name">{{item.goodsName}}</text>
        <text class="bill-line-qty">{{item.quantity}}{{item.standard}}</text>
        <text class="bill-line-assign">{{item.assignText}}</text>
      </view>
      <text class="bill-line-price {{item.priceConfirmStatus === 'PENDING' ? 'bill-line-price-pending' : ''}}">{{item.priceText}}</text>
    </view>
  </view>

  <view class="pay-btn" wx:if="{{showSupplementBtn}}" bindtap="onMockSupplementPay">去补款</view>
  <view class="link-btn" bindtap="onViewFormalOrders">查看今日正式订货</view>

  <view class="mock-hint" wx:if="{{showMockHint}}">
    补款支付功能即将接入，当前为测试意图（mockPay=true）
  </view>
</view>

<view class="page-bill page-bill-empty" wx:else>
  <text>暂无采购单信息</text>
</view>
