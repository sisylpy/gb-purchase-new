.page-bill {
  min-height: 100vh;
  background: #f4f6f5;
  padding: 32rpx 28rpx;
}

.bill-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.bill-state {
  display: inline-block;
  font-size: 22rpx;
  color: #187e6e;
  background: #e8f5f2;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.bill-supplier {
  display: block;
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
}

.bill-id {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.bill-amount-row {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.bill-amount-row-compact {
  margin-top: 16rpx;
  padding-top: 0;
  border-top: none;
}

.bill-amount-label {
  font-size: 26rpx;
  color: #666;
}

.bill-amount {
  display: block;
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #187e6e;
}

.bill-amount-known {
  font-size: 40rpx;
  color: #333;
}

.bill-amount-paid {
  font-size: 48rpx;
  color: #187e6e;
}

.bill-amount-supplement {
  font-size: 44rpx;
  color: #e6a23c;
}

.bill-supplement-row {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.bill-meta-row {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.bill-meta-row-pending {
  color: #e6a23c;
}

.bill-lines-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.bill-lines-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.bill-line {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.bill-line-main {
  flex: 1;
  min-width: 0;
}

.bill-line-name {
  display: block;
  font-size: 28rpx;
  color: #222;
  font-weight: 600;
}

.bill-line-qty,
.bill-line-assign {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #888;
}

.bill-line-price {
  font-size: 26rpx;
  color: #187e6e;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.bill-line-price-pending {
  color: #e6a23c;
}

.pay-btn {
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #187e6e;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.link-btn {
  margin-top: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #187e6e;
}

.mock-hint {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #fff8e6;
  color: #b88230;
  font-size: 24rpx;
  border-radius: 12rpx;
  line-height: 1.5;
}

.page-bill-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}
