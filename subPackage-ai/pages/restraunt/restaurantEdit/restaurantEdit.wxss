/* ======================== */
/* 页面基础样式 */
/* ======================== */

.page-bg {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.scroll-content {
  min-height: 0;
  padding: 0 24rpx;
}

/* ======================== */
/* 空状态 & 加载中 */
/* ======================== */

.loading-state,
.empty-state {
  padding: 40rpx;
}

.empty-icon-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #fff3e0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.empty-icon-text {
  font-size: 60rpx;
}

.create-btn {
  background: #e94560;
  color: #fff;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* ======================== */
/* 卡片样式 */
/* ======================== */

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

/* ======================== */
/* 字段行 */
/* ======================== */

.field-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.field-row:last-child {
  border-bottom: none;
}

.field-label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.field-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  flex: 1;
  word-break: break-all;
}

.field-grid-2 {
  display: flex;
  gap: 20rpx;
}

.field-grid-2 .field-row {
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
}

.field-grid-3 {
  display: flex;
  gap: 12rpx;
}

.field-grid-3 .field-row {
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
}

/* ======================== */
/* 经营概况统计格 */
/* ======================== */

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 16rpx;
}

.stat-grid-2 {
  grid-template-columns: 1fr 1fr;
}

.stat-box {
  text-align: center;
  padding: 24rpx 12rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #e94560;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

/* ======================== */
/* 老板画像标签 */
/* ======================== */

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: #e3f2fd;
  color: #1565c0;
  border-radius: 8rpx;
  font-size: 24rpx;
}

/* ======================== */
/* 编辑模式样式 */
/* ======================== */

.edit-field {
  margin-bottom: 32rpx;
}

.edit-field .field-label {
  margin-bottom: 12rpx;
  display: block;
  font-size: 28rpx;
  color: #666;
}

.edit-input {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333;
  background: #fafbfc;
  box-sizing: border-box;
  line-height: 1.6;
  min-height: 80rpx;
}

.edit-input:focus {
  border-color: #07c160;
}

.picker-input {
  display: flex;
  align-items: center;
}

.placeholder {
  color: #ccc;
}

.edit-grid-2 {
  display: flex;
  gap: 16rpx;
}

.edit-grid-2 .edit-field {
  flex: 1;
}

.edit-grid-3 {
  display: flex;
  gap: 12rpx;
}

.edit-grid-3 .edit-field {
  flex: 1;
}

/* ======================== */
/* 底部操作按钮 */
/* ======================== */

.bottom-actions {
  padding: 30rpx 0;
}

.action-row {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.btn {
  padding: 20rpx 50rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  text-align: center;
}

.btn-primary {
  background: #e94560;
  color: #fff;
}

.btn-secondary {
  background: #f0f0f0;
  color: #333;
}

.btn-cancel {
  background: #f0f0f0;
  color: #999;
}

/* ======================== */
/* 文字颜色辅助类 */
/* ======================== */

.text-danger {
  color: #e94560;
}

.text-secondary {
  color: #999;
}

.mb-40 {
  margin-bottom: 40rpx;
}
