/* ======================== */
/* 页面基础 - 暗色游戏主题 */
/* ======================== */

.dashboard-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  color: #fff;
}

/* ======================== */
/* 加载状态 */
/* ======================== */

.loading-state {
  padding: 60rpx
}

.loading-dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.loading-dots .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #667eea;
  animation: dot-bounce 1.4s ease-in-out infinite;
}

.loading-dots .dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dots .dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dot-bounce {
  0%, 60%, 100% { transform: translateY(0); }
  30% { transform: translateY(-20rpx); }
}

.loading-text {
  color: #8892b0;
  font-size: 28rpx;
}

/* ======================== */
/* 空状态 */
/* ======================== */

.empty-state {
  padding: 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  text-align: center;
  margin-bottom: 20rpx;
}

.create-btn {
  background: #667eea;
  color: #fff;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin-top: 20rpx;
}

.text-secondary {
  color: #8892b0;
}

.font-sl {
  font-size: 28rpx;
}

.mb-40 {
  margin-bottom: 40rpx;
}

.p-30 {
  padding: 30rpx 0;
}

/* ======================== */
/* 餐厅信息卡片 */
/* ======================== */

.restaurant-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 36rpx 40rpx;
  margin-top: 20rpx;
  text-align: center;
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
}

.restaurant-name {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  color: #fff;
  padding-right: 140rpx;
  box-sizing: border-box;
}

.restaurant-info {
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
  padding-right: 140rpx;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-btn {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* ======================== */
/* 天平区域 */
/* ======================== */

.scale-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-top: 20rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.scale-beam {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
  overflow: hidden;
}

/* ======================== */
/* 收入/支出面板 */
/* ======================== */

.panel {
  flex: 1;
  min-width: 0;
  border-radius: 20rpx;
  padding: 24rpx;
  min-height: 360rpx;
  box-sizing: border-box;
}

.income-panel {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
}

.expense-panel {
  background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%);
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.panel-icon {
  font-size: 36rpx;
}

.big-value {
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  letter-spacing: -2rpx;
}

.value-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 20rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.15);
  font-size: 24rpx;
  min-width: 0;
}

.detail-key, .detail-val {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-row:last-of-type {
  border-bottom: none;
}

.detail-key {
  opacity: 0.9;
}

.detail-val {
  font-weight: 600;
}

.ratio-bar-wrap {
  margin-top: 16rpx;
}

.ratio-bar-header {
  font-size: 22rpx;
  display: flex;
  justify-content: space-between;
  margin-bottom: 6rpx;
  opacity: 0.9;
}

.ratio-bar-track {
  height: 14rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 7rpx;
  overflow: hidden;
}

.ratio-bar-fill {
  height: 100%;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 7rpx;
  transition: width 0.8s ease;
}

/* ======================== */
/* 天平指针 */
/* ======================== */

.scale-center {
  flex: 0 0 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.pointer-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pointer-triangle {
  width: 0;
  height: 0;
  border-left: 30rpx solid transparent;
  border-right: 30rpx solid transparent;
  border-top: 50rpx solid #ffd700;
  transition: all 0.5s ease;
}

.pointer-glow {
  border-radius: 50%;
  position: absolute;
  top: -30rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 80rpx;
  opacity: 0;
  transition: all 0.5s ease;
}

.status-label {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  transition: all 0.3s ease;
}

/* 盈利状态 */
.status-label-profit {
  background: linear-gradient(135deg, #38ef7d, #11998e);
  color: #1a1a2e;
  box-shadow: 0 0 30rpx rgba(56, 239, 125, 0.5);
}

.anim-status-profit .pointer-triangle {
  border-top-color: #38ef7d;
  animation: profit-bounce 2s ease-in-out infinite;
}

.anim-status-profit .pointer-glow {
  background: radial-gradient(circle, rgba(56, 239, 125, 0.6) 0%, transparent 70%);
  animation: glow-pulse 2s ease-in-out infinite;
}

/* 亏损状态 */
.status-label-loss {
  background: linear-gradient(135deg, #eb3349, #c0392b);
  color: #fff;
  animation: danger-flash 1s ease-in-out infinite;
}

.anim-status-loss .pointer-triangle {
  border-top-color: #eb3349;
  animation: loss-shake 0.5s ease-in-out infinite;
}

.anim-status-loss .pointer-glow {
  background: radial-gradient(circle, rgba(235, 51, 73, 0.6) 0%, transparent 70%);
  animation: danger-pulse 1s ease-in-out infinite;
}

/* 保本状态 */
.status-label-breakeven {
  background: linear-gradient(135deg, #ffd700, #f39c12);
  color: #1a1a2e;
}

.anim-status-breakeven .pointer-triangle {
  border-top-color: #ffd700;
  animation: breakeven-swing 3s ease-in-out infinite;
}

.anim-status-breakeven .pointer-glow {
  background: radial-gradient(circle, rgba(255, 215, 0, 0.4) 0%, transparent 70%);
}

@keyframes profit-bounce {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-12rpx) scale(1.05); }
}

@keyframes glow-pulse {
  0%, 100% { opacity: 0.3; transform: translateX(-50%) scale(0.8); }
  50% { opacity: 0.8; transform: translateX(-50%) scale(1.2); }
}

@keyframes loss-shake {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  25% { transform: translateY(4rpx) rotate(-3deg); }
  75% { transform: translateY(4rpx) rotate(3deg); }
}

@keyframes danger-pulse {
  0%, 100% { opacity: 0.2; transform: translateX(-50%) scale(0.8); }
  50% { opacity: 0.9; transform: translateX(-50%) scale(1.3); }
}

@keyframes danger-flash {
  0%, 100% { opacity: 1; box-shadow: 0 0 10rpx rgba(235, 51, 73, 0.5); }
  50% { opacity: 0.7; box-shadow: 0 0 30rpx rgba(235, 51, 73, 0.8); }
}

@keyframes breakeven-swing {
  0%, 100% { transform: translateY(0) rotate(-4deg); }
  50% { transform: translateY(0) rotate(4deg); }
}

/* ======================== */
/* 天平底座 */
/* ======================== */

.scale-base {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

/* —— scaleBase 全量卡片（底座） —— */
.sb-stack-card {
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.18);
}

.sb-card-head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.sb-card-head-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.35;
}

.sb-card-head-meta {
  font-size: 20rpx;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding-top: 4rpx;
}

.sb-date-card {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.sb-date-card-left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.sb-date-main {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.sb-date-week {
  font-size: 26rpx;
  color: #8892b0;
}

.sb-date-card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 12rpx;
}

.sb-date-badge {
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.sb-date-month-chip {
  font-size: 22rpx;
  color: #94a3b8;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.06);
}

.sb-kpi-item {
  background: rgba(0, 0, 0, 0.2);
  border-radius: 20rpx;
  padding: 24rpx 22rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.sb-kpi-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.sb-kpi-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.35;
}

.sb-kpi-num {
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.sb-kpi-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #8892b0;
}

.sb-kpi-track-wrap {
  margin-top: 20rpx;
}

.sb-kpi-track {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  overflow: hidden;
}

.sb-kpi-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.85s cubic-bezier(0.22, 1, 0.36, 1);
}

.sb-divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.1);
  margin: 26rpx 0 22rpx;
}

.sb-safety-block {
  margin-bottom: 20rpx;
}

.sb-safety-caption {
  display: block;
  font-size: 22rpx;
  color: #8892b0;
  margin-bottom: 12rpx;
}

.safety-tag-full {
  max-width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
  padding: 16rpx 22rpx;
  align-self: stretch;
}

.safety-tag-line1 {
  font-size: 28rpx;
  font-weight: 700;
}

.safety-tag-line2 {
  font-size: 24rpx;
  font-weight: 400;
  opacity: 0.95;
  line-height: 1.45;
}

.sb-risk-compact {
  padding-top: 8rpx;
  border-top: none;
}

.sb-month-progress .sb-progress-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.sb-progress-percent {
  font-size: 30rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
  font-variant-numeric: tabular-nums;
}

.sb-progress-track-xl {
  height: 18rpx;
}

.sb-progress-fill-brand {
  background: linear-gradient(90deg, #667eea, #38ef7d);
}

.sb-forecast .sb-month-progress {
  margin-bottom: 28rpx;
}

.sb-forecast-hero {
  margin-bottom: 28rpx;
}

.sb-subtitle-row {
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.sb-subtitle-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #64748b;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.sb-detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.sb-detail-row:last-of-type {
  border-bottom: none;
}

.sb-detail-left {
  flex: 1;
  min-width: 0;
}

.sb-detail-key {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}

.sb-detail-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #8892b0;
}

.sb-detail-val {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #cbd5f5;
  font-variant-numeric: tabular-nums;
}

.sb-detail-val--money {
  font-size: 30rpx;
  font-weight: 700;
}

.sb-hint-soft {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  color: #8892b0;
  line-height: 1.5;
}

.sb-strategy-tip {
  margin-top: 16rpx !important;
  text-align: left;
}

.sb-industry-vs {
  text-align: left;
}

/* 日期头部 — 旧版类名兼容（若别处引用） */
.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.date-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.date-text {
  font-size: 32rpx;
  font-weight: 600;
}

.date-week {
  font-size: 26rpx;
  color: #8892b0;
}

.month-badge {
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

/* ======================== */
/* 经营健康度 */
/* ======================== */

.health-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.health-card-title {
  font-size: 28rpx;
  color: #8892b0;
  margin-bottom: 24rpx;
}

.health-bar-wrap {
  margin-bottom: 20rpx;
}

.health-bar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.health-bar-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.health-bar-value {
  font-size: 32rpx;
  font-weight: 700;
}

.health-bar-track {
  height: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 10rpx;
  overflow: hidden;
}

.health-bar-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.8s ease;
  position: relative;
}

/* 安全等级 */
.safety-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.safety-tag {
  padding: 8rpx 22rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.safety-tag-safe {
  background: rgba(56, 239, 125, 0.2);
  color: #38ef7d;
}

.safety-tag-warning {
  background: rgba(255, 215, 0, 0.2);
  color: #ffd700;
}

.safety-tag-low {
  background: rgba(249, 115, 22, 0.2);
  color: #f97316;
}

.safety-tag-danger {
  background: rgba(235, 51, 73, 0.2);
  color: #eb3349;
}

.safety-tag-critical {
  background: rgba(235, 51, 73, 0.4);
  color: #ff6b6b;
  animation: critical-flash 1s infinite;
}

@keyframes critical-flash {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 抗风险倍数 */
.risk-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.risk-label {
  font-size: 26rpx;
  color: #8892b0;
  display: block;
}

.risk-desc {
  font-size: 20rpx;
  color: #8892b0;
  display: block;
  margin-top: 4rpx;
}

.risk-value {
  font-size: 40rpx;
  font-weight: 700;
}

.risk-value-profit {
  color: #38ef7d;
}

.risk-value-loss {
  color: #eb3349;
}

/* ======================== */
/* 月度预测 */
/* ======================== */

.forecast-card {
  background: rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
  padding: 28rpx;
}

.forecast-title {
  font-size: 28rpx;
  color: #8892b0;
  margin-bottom: 20rpx;
}

.month-progress-wrap {
  margin-bottom: 20rpx;
}

.month-progress-track {
  height: 14rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 7rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.month-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 7rpx;
  transition: width 0.8s ease;
}

.month-progress-label {
  font-size: 22rpx;
  color: #8892b0;
  text-align: center;
  display: block;
}

.forecast-result {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
}

.forecast-result-label {
  font-size: 24rpx;
  color: #8892b0;
  display: block;
  margin-bottom: 10rpx;
}

.forecast-result-value {
  font-size: 52rpx;
  font-weight: 700;
  display: block;
}

.forecast-value-profit {
  color: #38ef7d;
}

.forecast-value-loss {
  color: #eb3349;
}

.forecast-vs {
  font-size: 24rpx;
  color: #8892b0;
  margin-top: 14rpx;
  display: block;
}

.vs-highlight {
  color: #667eea;
  font-weight: 600;
}

.forecast-vs-danger {
  color: #eb3349;
}

/* 风险提示 */
.risk-alert {
  background: rgba(235, 51, 73, 0.15);
  border: 1rpx solid rgba(235, 51, 73, 0.3);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.risk-alert-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.risk-alert-text {
  font-size: 24rpx;
  color: #eb3349;
  line-height: 1.6;
}

/* ======================== */
/* 核心指标 */
/* ======================== */

.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.metric-card {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  text-align: center;
}

.metric-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 10rpx;
}

.metric-value {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 6rpx;
}

.metric-label {
  font-size: 22rpx;
  color: #8892b0;
  display: block;
}

/* ======================== */
/* 盈亏分析 */
/* ======================== */

.analysis-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-top: 20rpx;
}

.analysis-title {
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

.analysis-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 28rpx;
}

.analysis-row:last-child {
  border-bottom: none;
}

.analysis-label {
  color: #8892b0;
}

.analysis-value {
  font-weight: 600;
}

.analysis-trend-up {
  color: #38ef7d;
}

.analysis-trend-down {
  color: #eb3349;
}

.status-badge {
  display: inline-block;
  padding: 8rpx 22rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.status-badge-status-profit {
  background: #38ef7d;
  color: #1a1a2e;
}

.status-badge-status-loss {
  background: #eb3349;
  color: #fff;
}

.status-badge-status-breakeven {
  background: #ffd700;
  color: #1a1a2e;
}

/* ======================== */
/* 底部导航 */
/* ======================== */

.bottom-nav {
  display: flex;
  gap: 20rpx;
  justify-content: center;
  margin-top: 30rpx;
}

.nav-link {
  padding: 22rpx 40rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  color: #fff;
  font-size: 28rpx;
  text-align: center;
}

.nav-link-chat {
  background: linear-gradient(135deg, #667eea, #764ba2);
}

/* ======================== */
/* 成本明细 */
/* ======================== */

.cost-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-top: 20rpx;
  border-left: 6rpx solid #eb3349;
}

.cost-title {
  font-size: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.cost-section {
  margin-bottom: 20rpx;
}

.cost-section-title {
  font-size: 24rpx;
  color: #8892b0;
  margin-bottom: 12rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #f45c43;
}

.cost-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  font-size: 26rpx;
}

.cost-row-subtotal {
  border-bottom: none;
  padding-top: 16rpx;
  margin-top: 8rpx;
  border-top: 2rpx dashed rgba(255, 255, 255, 0.15);
}

.cost-label {
  color: #8892b0;
}

.cost-value {
  font-weight: 600;
}

.cost-row-subtotal .cost-label,
.cost-row-subtotal .cost-value {
  color: #f45c43;
}

.cost-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-top: 10rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.15);
  font-size: 30rpx;
}

.cost-total-label {
  font-weight: 600;
  color: #fff;
}

.cost-total-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #eb3349;
}
