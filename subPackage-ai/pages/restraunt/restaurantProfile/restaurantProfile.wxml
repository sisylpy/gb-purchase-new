<wxs module="fmt" src="../../../../wxs/format.wxs" />


<navbar title="经营看板" show-back="{{true}}" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></navbar>

<view class="dashboard-page {{dashboard && dashboard.scaleBeam && dashboard.scaleBeam.pointer ? dashboard.scaleBeam.pointer.statusClass : ''}}">


  <scroll-view scroll-y="true" class="" style="padding-top: {{navBarHeight}}rpx;" show-scrollbar="true">
    <view class="create-btn" bindtap="toEditProfile" wx:if="{{errorMsg == '餐厅画像不存在'}}">
      <text>创建画像</text>
    </view>

    <view class="loading-state" wx:if="{{isLoading}}">
      <view class="flex-column-center" style="height: 400rpx;">
        <view class="loading-dots">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
        <text class="loading-text">加载经营数据...</text>
      </view>
    </view>

    <view class="empty-state" wx:elif="{{!hasData}}">
      <view class="flex-column-center" style="padding-top: 120rpx;">
        <text class="empty-icon">📊</text>
        <view class="font-bold p-30"><text>{{errorMsg}}</text></view>
        <view class="text-secondary font-sl mb-40">
          <text wx:if="{{errorMsg == '餐厅画像不存在'}}">请先创建餐厅画像，系统将根据画像数据生成看板</text>
          <text wx:elif="{{errorMsg == '暂无营业额数据'}}">暂无营业额记录，无法生成看板</text>
          <text wx:else>请检查网络连接后重试</text>
        </view>
        <view class="create-btn" bindtap="toEditProfile" wx:if="{{errorMsg == '餐厅画像不存在'}}">
          <text>创建画像</text>
        </view>
      </view>
    </view>

    <block wx:else>

      <view class="flex-column p-20" wx:if="{{profile}}">
        <view class="restaurant-card">
          <view class="restaurant-name">{{profile.gbAiRestaurantProfileRestaurantName || '我的餐厅'}}</view>
          <view class="restaurant-info">{{profile.gbAiRestaurantProfileCuisineType || ''}} · {{profile.gbAiRestaurantProfileBusinessDistrict || ''}} · {{profile.gbAiRestaurantProfileBusinessHours || ''}}</view>
          <view class="edit-btn" bindtap="toEditProfile">经营</view>
        </view>
      </view>

      <view wx:if="{{!dashboard || !dashboard.scaleBeam}}" class="p-30 text-secondary">
        <text>接口未返回 dashboard 模块，无法渲染看板。</text>
      </view>

      <block wx:else>

        <view class="scale-section">
          <view class="scale-beam">

            <view class="panel income-panel" wx:if="{{dashboard.scaleBeam.income}}">
              <view class="panel-title">
                <text class="panel-icon">💰</text>
                <text>{{dashboard.scaleBeam.income.title}}</text>
              </view>
              <view class="big-value" wx:if="{{dashboard.scaleBeam.income.rows[0]}}">¥{{fmt.formatNumber(dashboard.scaleBeam.income.rows[0].value)}}</view>
              <view class="value-label" wx:if="{{dashboard.scaleBeam.income.rows[0]}}">{{dashboard.scaleBeam.income.rows[0].label}}</view>
              <view class="detail-row" wx:if="{{dashboard.scaleBeam.income.rows[1]}}">
                <text class="detail-key">{{dashboard.scaleBeam.income.rows[1].key}}</text>
                <text class="detail-val">¥{{fmt.formatNumber(dashboard.scaleBeam.income.rows[1].value)}}</text>
              </view>
              <view class="detail-row" wx:if="{{dashboard.scaleBeam.income.rows[2]}}">
                <text class="detail-key">{{dashboard.scaleBeam.income.rows[2].key}}</text>
                <text class="detail-val">¥{{fmt.formatNumber(dashboard.scaleBeam.income.rows[2].value)}}</text>
              </view>
              <view class="ratio-bar-wrap" wx:if="{{dashboard.scaleBeam.income.ratioBar}}">
                <view class="ratio-bar-header">
                  <text>{{dashboard.scaleBeam.income.ratioBar.label}}</text>
                  <text>{{fmt.formatNumber(dashboard.scaleBeam.income.ratioBar.percent)}}%</text>
                </view>
                <view class="ratio-bar-track">
                  <view class="ratio-bar-fill" style="width: {{dashboard.scaleBeam.income.ratioBar.percent}}%"></view>
                </view>
              </view>
            </view>

            <view class="scale-center" wx:if="{{dashboard.scaleBeam.pointer}}">
              <view class="pointer-wrap {{animReady ? 'anim-status-' + dashboard.scaleBeam.pointer.statusClass : ''}}">
                <view class="pointer-triangle"></view>
                <view class="pointer-glow"></view>
              </view>
              <view class="status-label status-label-{{dashboard.scaleBeam.pointer.statusClass}}">
                <text>⚖️ {{dashboard.scaleBeam.pointer.statusLabel}}</text>
              </view>
            </view>

            <view class="panel expense-panel" wx:if="{{dashboard.scaleBeam.expense}}">
              <view class="panel-title">
                <text class="panel-icon">📊</text>
                <text>{{dashboard.scaleBeam.expense.title}}</text>
              </view>
              <view class="big-value" wx:if="{{dashboard.scaleBeam.expense.summary}}">¥{{fmt.formatNumber(dashboard.scaleBeam.expense.summary.value)}}</view>
              <view class="value-label" wx:if="{{dashboard.scaleBeam.expense.summary}}">{{dashboard.scaleBeam.expense.summary.label}}</view>
              <block wx:for="{{dashboard.scaleBeam.expense.rows}}" wx:key="key">
                <view class="detail-row">
                  <text class="detail-key">{{item.key}}</text>
                  <text class="detail-val">¥{{fmt.formatNumber(item.value)}}</text>
                </view>
              </block>
            </view>

          </view>

          <view class="scale-base" wx:if="{{dashboard.scaleBase}}">

            <view class="date-header" wx:if="{{dashboard.scaleBase.dateHeader}}">
              <view class="date-left">
                <text class="date-text">📅 {{dashboard.scaleBase.dateHeader.dateStr}}</text>
                <text class="date-week">{{dashboard.scaleBase.dateHeader.weekdayStr}}</text>
              </view>
              <view class="month-badge">🌙 {{dashboard.scaleBase.dateHeader.badge}}</view>
            </view>

            <view class="health-card" wx:if="{{dashboard.scaleBase.healthCard}}">
              <view class="health-card-title">💪 {{dashboard.scaleBase.healthCard.title}}</view>

              <view class="health-bar-wrap" wx:if="{{dashboard.scaleBase.healthCard.rows[0]}}">
                <view class="health-bar-header">
                  <text class="health-bar-label">{{dashboard.scaleBase.healthCard.rows[0].label}}</text>
                  <text class="health-bar-value" style="color: {{fmt.marginTextColor(dashboard.scaleBase.healthCard.rows[0].value)}}">{{dashboard.scaleBase.healthCard.rows[0].value}}%</text>
                </view>
                <view class="health-bar-track">
                  <view class="health-bar-fill {{animReady ? 'anim-shimmer' : ''}}" style="width: {{fmt.healthBarWidthPercent(dashboard.scaleBase.healthCard.rows[0].value)}}%; background: {{fmt.marginTextColor(dashboard.scaleBase.healthCard.rows[0].value)}}"></view>
                </view>
              </view>

              <view class="safety-row" wx:if="{{dashboard.scaleBase.healthCard.safety}}">
                <text class="health-bar-label">安全等级</text>
                <view class="safety-tag safety-tag-{{dashboard.scaleBase.healthCard.safety.level}}">
                  <text>{{dashboard.scaleBase.healthCard.safety.text}} · {{dashboard.scaleBase.healthCard.safety.desc}}</text>
                </view>
              </view>

              <view class="risk-row" wx:if="{{dashboard.scaleBase.healthCard.riskMultiple}}">
                <view class="risk-left">
                  <text class="risk-label">🔥 {{dashboard.scaleBase.healthCard.riskMultiple.label}}</text>
                  <text class="risk-desc">{{dashboard.scaleBase.healthCard.riskMultiple.hint}}</text>
                </view>
                <text class="risk-value risk-value-{{dashboard.scaleBase.healthCard.riskMultiple.isProfit ? 'profit' : 'loss'}}">{{dashboard.scaleBase.healthCard.riskMultiple.value}}{{dashboard.scaleBase.healthCard.riskMultiple.unit}}</text>
              </view>
            </view>

            <view class="forecast-card" wx:if="{{dashboard.scaleBase.monthForecast}}">
              <view class="forecast-title">🌙 {{dashboard.scaleBase.monthForecast.title}}</view>

              <view class="month-progress-wrap" wx:if="{{dashboard.scaleBase.monthForecast.rows[0]}}">
                <view class="month-progress-track">
                  <view class="month-progress-fill {{animReady ? 'anim-shimmer' : ''}}" style="width: {{dashboard.scaleBase.monthForecast.rows[0].value}}%"></view>
                </view>
                <text class="month-progress-label" wx:if="{{dashboard.scaleBase.monthForecast.rows[1] && dashboard.scaleBase.monthForecast.rows[2]}}">已过 {{dashboard.scaleBase.monthForecast.rows[1].value}}/{{dashboard.scaleBase.monthForecast.rows[2].value}} 天</text>
              </view>

              <view class="forecast-result">
                <text class="forecast-result-label">预计{{dashboard.scaleBase.dateHeader.currentMonth}}月{{dashboard.scaleBase.monthForecast.isProfit ? '盈利' : '亏损'}}</text>
                <text class="forecast-result-value forecast-value-{{dashboard.scaleBase.monthForecast.isProfit ? 'profit' : 'loss'}}">
                  {{dashboard.scaleBase.monthForecast.isProfit ? '+' : '-'}}¥{{fmt.formatNumber(dashboard.scaleBase.monthForecast.rows[4] ? dashboard.scaleBase.monthForecast.rows[4].value : dashboard.scaleBase.monthForecast.rows[3].value)}}
                </text>

                <view class="forecast-vs" wx:if="{{dashboard.scaleBase.monthForecast.isProfit && dashboard.scaleBase.monthForecast.hasIndustryCompare}}">
                  <text>vs 行业平均（接口开启对标时展示）</text>
                </view>
                <view class="forecast-vs text-secondary font-sl" wx:elif="{{dashboard.scaleBase.monthForecast.vsIndustryHint}}">
                  <text>{{dashboard.scaleBase.monthForecast.vsIndustryHint}}</text>
                </view>
                <view class="forecast-vs forecast-vs-danger" wx:elif="{{!dashboard.scaleBase.monthForecast.isProfit}}">
                  <text>⚠️ 建议调整经营策略</text>
                </view>
              </view>

              <view class="risk-alert" wx:if="{{!dashboard.scaleBase.monthForecast.isProfit}}">
                <text class="risk-alert-icon">⚠️</text>
                <text class="risk-alert-text">按当前趋势，本月预计亏损 ¥{{fmt.formatNumber(dashboard.scaleBase.monthForecast.rows[4] ? dashboard.scaleBase.monthForecast.rows[4].value : dashboard.scaleBase.monthForecast.rows[3].value)}}，建议提升收入或降低开支</text>
              </view>
            </view>

          </view>
        </view>

        <view class="flex-column p-20" wx:if="{{dashboard.coreMetrics && dashboard.coreMetrics.rows}}">
          <view class="metrics-grid">
            <block wx:for="{{dashboard.coreMetrics.rows}}" wx:key="key">
              <view class="metric-card">
                <text class="metric-icon" wx:if="{{index === 0}}">👨‍🍳</text>
                <text class="metric-icon" wx:elif="{{index === 1}}">🪑</text>
                <text class="metric-icon" wx:elif="{{index === 2}}">🏠</text>
                <text class="metric-icon" wx:else>💵</text>
                <text class="metric-value" wx:if="{{index === 3}}">¥{{fmt.formatNumber(item.value)}}</text>
                <text class="metric-value" wx:else>{{item.value}}</text>
                <text class="metric-label">{{item.key}}</text>
              </view>
            </block>
          </view>
        </view>

        <view class="flex-column p-20" wx:if="{{dashboard.operationAnalysis && dashboard.operationAnalysis.rows}}">
          <view class="analysis-card">
            <view class="analysis-title">📈 {{dashboard.operationAnalysis.title}}</view>
            <block wx:for="{{dashboard.operationAnalysis.rows}}" wx:key="key">
              <view class="analysis-row">
                <text class="analysis-label">{{item.label}}</text>
                <text class="analysis-value {{fmt.analysisTrendClass(item.key, item.value)}}" wx:if="{{item.key != '状态'}}">{{fmt.analysisRowDisplay(item.key, item.value)}}</text>
                <view class="status-badge status-badge-status-{{dashboard.scaleBeam.pointer.statusClass}}" wx:else>
                  <text>{{item.value}}</text>
                </view>
              </view>
            </block>
          </view>
        </view>

        <view class="flex-column p-20" wx:if="{{dashboard.costBreakdown}}">
          <view class="cost-card">
            <view class="cost-title">💰 {{dashboard.costBreakdown.title}}</view>
            <view class="cost-section" wx:if="{{dashboard.costBreakdown.production}}">
              <view class="cost-section-title">{{dashboard.costBreakdown.production.title}}</view>
              <block wx:for="{{dashboard.costBreakdown.production.rows}}" wx:key="key">
                <view class="cost-row {{item.key == '制作成本合计' ? 'cost-row-subtotal' : ''}}">
                  <text class="cost-label">{{item.label}}</text>
                  <text class="cost-value">¥{{fmt.formatNumber(item.value)}}</text>
                </view>
              </block>
            </view>
            <view class="cost-section" wx:if="{{dashboard.costBreakdown.other}}">
              <view class="cost-section-title">{{dashboard.costBreakdown.other.title}}</view>
              <block wx:for="{{dashboard.costBreakdown.other.rows}}" wx:key="key">
                <view class="cost-row">
                  <text class="cost-label">{{item.label}}</text>
                  <text class="cost-value">¥{{fmt.formatNumber(item.value)}}</text>
                </view>
              </block>
            </view>
            <view class="cost-total-row" wx:if="{{dashboard.costBreakdown.total}}">
              <text class="cost-total-label">{{dashboard.costBreakdown.total.label}}</text>
              <text class="cost-total-value">¥{{fmt.formatNumber(dashboard.costBreakdown.total.value)}}</text>
            </view>
          </view>
        </view>

      </block>

      <view style="height: 60rpx;"></view>

    </block>

  </scroll-view>

</view>
