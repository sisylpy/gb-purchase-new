/* ============================================
   AI 对话页面样式
   ============================================ */

/* 聊天容器 */
.chat-container {
  background: #f5f5f5;
  padding-left: 24rpx;
  padding-right: 24rpx;
  box-sizing: border-box;
}

/* 加载状态 */
.loading-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}
.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 欢迎卡片 */
.welcome-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  margin-top: 60rpx;
}
.welcome-avatar {
  width: 120rpx;
  height: 120rpx;
  background: #e94560;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-bottom: 24rpx;
}
.welcome-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}
.welcome-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
}

/* 消息行 */
.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
  gap: 16rpx;
}
.msg-user {
  flex-direction: row-reverse;
}

/* 头像 */
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.avatar-user {
  background: #4a90d9;
}
.avatar-ai {
  background: #e94560;
}

/* 气泡 */
.bubble {
  max-width: 70%;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}
.bubble-user {
  background: #e94560;
  color: #fff;
  border-bottom-right-radius: 6rpx;
}
.bubble-ai {
  background: #fff;
  color: #333;
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 打字机动画 */
.typing {
  display: flex;
  gap: 8rpx;
  padding: 8rpx 0;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  background: #999;
  border-radius: 50%;
  animation: dotBounce 1.4s infinite;
}
.dot:nth-child(2) {
  animation-delay: 0.2s;
}
.dot:nth-child(3) {
  animation-delay: 0.4s;
}
@keyframes dotBounce {
  0%, 60%, 100% {
    transform: translateY(0);
  }
  30% {
    transform: translateY(-10rpx);
  }
}

/* 底部留白（避免输入框遮挡） */
.bottom-spacer {
  height: 140rpx;
}

/* ============================================
   底部输入区域
   ============================================ */
.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

/* 快捷问题按钮 */
.quick-tags {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
  overflow-x: auto;
}
.quick-tag {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  background: #fff0f3;
  color: #e94560;
  border: 1rpx solid #ffd6de;
  border-radius: 30rpx;
  font-size: 24rpx;
  white-space: nowrap;
}
.quick-tag:active {
  background: #e94560;
  color: #fff;
}
.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.input-box {
  flex: 1;
  height: 72rpx;
  padding: 0 28rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #333;
}
.send-btn {
  height: 72rpx;
  padding: 0 36rpx;
  background: #e94560;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.send-btn-disabled {
  background: #ccc;
}
