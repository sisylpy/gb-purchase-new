<wxs module="imgUrl" src="/wxs/imgUrl.wxs" />

<view class='modal-mask' wx:if='{{show}}' catchtouchmove='ture' bindtap="cancle">
	<view class='modal-dialog'>

			<view class='modal-title'>
				<text>{{item.gbDgGoodsName}}</text>
			</view>
	

		<view class="modal-content">

     <image style="height: {{windowHeight / 3}}rpx;width: {{windowWidth - 280}}rpx;"  mode="widthFix"  src="{{(imgUrl.resolve(url, item.gbDgNxFatherImgLarge) || '/images/logo.jpg')}}" mode=""/>

		</view>

	</view>
</view>