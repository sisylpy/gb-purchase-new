/* purchase-check-card — 采购卡 */

/* ===== 公共基础样式 ===== */

.biz-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #eef0f2;
  padding: 28rpx 24rpx;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.biz-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.biz-header-right {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.biz-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #e8f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.biz-icon {
  font-size: 28rpx;
  line-height: 1;
}

.biz-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.biz-scope-bar {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.biz-scope-tag {
  font-size: 22rpx;
  color: #1a73e8;
  background: #e8f0fe;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.biz-scope-name {
  font-size: 22rpx;
  color: #6b7280;
}

.biz-kpi-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.biz-kpi-col {
  flex: 1;
  min-width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: #f8fafb;
  border-radius: 14rpx;
  padding: 18rpx 16rpx;
}

.biz-kpi-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
  white-space: nowrap;
}

.biz-kpi-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #059669;
  line-height: 1.2;
}

.biz-kpi-normal {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.biz-kpi-warn {
  font-size: 28rpx;
  font-weight: 700;
  color: #ea580c;
}

.biz-agent-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #d1fae5;
  margin-top: 8rpx;
}

.biz-agent-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #dcfce7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.biz-agent-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #166534;
  white-space: nowrap;
  flex-shrink: 0;
}

.biz-agent-text {
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.45;
}

/* ===== 采购卡独有 ===== */

.biz-icon-green { background: #e8f5e9; }

/* 表格区域 */
.biz-table-section {
  border-top: 1rpx solid #e5e7eb;
  padding-top: 20rpx;
  margin-bottom: 12rpx;
}

.biz-table-subtitle {
  font-size: 28rpx;
  font-weight: 700;
  color: #c2410c;
  background: #fff7ed;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  display: inline-block;
  margin-bottom: 8rpx;
}

.biz-table-desc {
  font-size: 24rpx;
  color: #6b7280;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.45;
}

/* 表头 */
.biz-table-header {
  display: flex;
  align-items: center;
  padding: 12rpx 8rpx;
  background: #f8fafb;
  border-radius: 10rpx 10rpx 0 0;
  border-bottom: 2rpx solid #e5e7eb;
}

.biz-th {
  font-size: 26rpx;
  font-weight: 700;
  color: #6b7280;
  text-align: left;
}

.biz-th-name { flex: 2; min-width: 160rpx; }
.biz-th-price { flex: 1.2; min-width: 100rpx; }
.biz-th-change { flex: 1; min-width: 90rpx; text-align: right; }

/* 表体 */
.biz-table-body {
  display: flex;
  flex-direction: column;
}

.biz-tr {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.biz-tr:last-child {
  border-bottom: none;
}

.biz-td {
  font-size: 28rpx;
  color: #374151;
}

.biz-td-name {
  flex: 2;
  min-width: 160rpx;
  font-weight: 600;
  color: #111827;
}

.biz-td-price {
  flex: 1.2;
  min-width: 100rpx;
  font-weight: 500;
}

.biz-td-change {
  flex: 1;
  min-width: 90rpx;
  text-align: right;
  font-weight: 700;
  font-size: 28rpx;
}

/* 无异常提示 */
.biz-ok-section {
  border-top: 1rpx dashed #e5e7eb;
  padding-top: 14rpx;
  margin-bottom: 12rpx;
}

.biz-ok-text {
  font-size: 26rpx;
  color: #059669;
  font-weight: 500;
}

/* 完全无数据 */
.biz-empty-section {
  border-top: 1rpx dashed #e5e7eb;
  padding-top: 14rpx;
  margin-bottom: 12rpx;
}

.biz-empty-text {
  font-size: 26rpx;
  color: #9ca3af;
  font-weight: 500;
}

/* Agent 变体 */
.biz-agent-green { background: #dcfce7; }

/* change 颜色 */
.change-warn { color: #ea580c; }
.change-ok { color: #059669; }
.change-neutral { color: #6b7280; }
