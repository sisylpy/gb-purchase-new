/* ============================================================
   畅销低利菜 - 经营看板卡片
   ============================================================ */

/* ---------- 卡片容器 ---------- */
.hsml-card {
  margin: 20rpx 0;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

/* ---------- 标题区 ---------- */
.hsml-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx 28rpx 20rpx;
}

.hsml-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 1rpx;
}

.hsml-tag {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #D0021B;
  background: #FFF0F0;
  border-radius: 8rpx;
}

/* ---------- 空态 ---------- */
.hsml-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 28rpx;
}

.hsml-empty-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.hsml-empty-text {
  font-size: 28rpx;
  color: #9aa0a6;
  line-height: 1.5;
}

/* ---------- 概览 ---------- */
.hsml-summary {
  margin: 0 28rpx 20rpx;
  padding: 20rpx 24rpx;
  background: #FFF8F0;
  border-radius: 12rpx;
  border-left: 6rpx solid #F5A623;
}

.hsml-summary-text {
  font-size: 26rpx;
  color: #5f4a3a;
  line-height: 1.6;
}

/* ---------- 菜品列表 ---------- */
.hsml-dish-list {
  padding: 0 28rpx 16rpx;
}

.hsml-dish-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: #fafbfc;
  border-radius: 16rpx;
  border: 1rpx solid #eef0f3;
}

.hsml-dish-card:last-child {
  margin-bottom: 0;
}

/* --- 菜品名行 --- */
.hsml-dish-name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20rpx;
}

.hsml-dish-index {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  background: #4A90D9;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.hsml-dish-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* --- 指标行 (3列) --- */
.hsml-dish-metrics {
  display: flex;
  flex-direction: row;
  margin-bottom: 12rpx;
}

.hsml-metric {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.hsml-metric-label {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-bottom: 6rpx;
}

.hsml-metric-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.hsml-metric-warn {
  color: #D0021B;
}

/* --- 风险原因 --- */
.hsml-dish-reason {
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  background: #FFF5F5;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
}

.hsml-reason-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #D0021B;
  margin-bottom: 6rpx;
}

.hsml-reason-text {
  font-size: 24rpx;
  color: #5f4a3a;
  line-height: 1.5;
}

/* --- 建议动作 --- */
.hsml-dish-action {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #F0F7FF;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
}

.hsml-action-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #4A90D9;
  margin-bottom: 6rpx;
}

.hsml-action-text {
  font-size: 24rpx;
  color: #3a4a5f;
  line-height: 1.5;
}

/* ---------- 底部提示 ---------- */
.hsml-footer {
  padding: 16rpx 28rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.hsml-footer-text {
  font-size: 22rpx;
  color: #bdc1c6;
}
