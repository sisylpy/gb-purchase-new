<view
  class="dual-host"
  style="height: {{navBarFullHeightPx}}px; padding-top: {{statusBarHeight}}px;"
>

  <view class="dual-row" style="height: {{navBarContentHeight}}px;">
    <!-- 左侧条：图标 + 门店 + 设置 -->
    <view class="dual-left-bar">
      <view class="dual-icon" bindtap="onNavTap">
        <live-pulse wx:if="{{livePulse && !showBack}}" />
        <image
          wx:elif="{{avatar && !showBack}}"
          class="dual-avatar"
          src="{{avatar}}"
          mode="aspectFill"
        />
        <image
          wx:if="{{showBack}}"
          class="dual-back"
          src="{{avatar}}"
          mode="aspectFit"
        />
      </view>
      <view class="dual-actions1">
        <view class="dual-link-hit dual-link-hit--minor" catchtap="onSecondaryTap">
          <image src="/images/points.png" mode="aspectFill" class="dual-back" />
        </view>
        
      </view>
    </view>
    
    <view class="dual-title-layer">
      <view
        class="dual-title-center"
        style="max-width: {{titleMaxWidthPx}}px;"
      >
        <text class="dual-title-text">{{title}}</text>
      </view>
    </view>

   
  </view>
</view>
