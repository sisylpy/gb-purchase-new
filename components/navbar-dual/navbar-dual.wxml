<view
  class="dual-host"
  style="height: {{navBarFullHeightPx}}px; padding-top: {{statusBarHeight}}px;"
>

  <view class="dual-row" style="height: {{navBarContentHeight}}px;">
    <!-- 左侧条：图标 + 门店 + 设置 -->
    <view class="dual-left-bar">
      <view class="dual-icon" bindtap="onNavTap">
        <image
        
          class="dual-avatar"
          src="{{avatar}}"
          mode="aspectFill"
        />
       
      </view>
    
    </view>
    
    <view class="dual-title-layer">
      <view
        class="dual-title-center"
        style="max-width: {{titleMaxWidthPx}}px;"
      >
        <text class="dual-title-text">{{title}}</text>
      </view>
    </view>

   
  </view>
</view>
