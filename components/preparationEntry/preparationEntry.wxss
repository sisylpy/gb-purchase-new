.prep-entry {
  align-items: center;
  background: linear-gradient(135deg, #e9f7f2 0%, #ffffff 100%);
  border: 1rpx solid #cce9df;
  border-radius: 18rpx;
  display: flex;
  margin: 14rpx 20rpx 0;
  min-height: 112rpx;
  padding: 18rpx 22rpx;
}

.prep-entry--pressed {
  opacity: 0.68;
}

.prep-entry__icon {
  align-items: center;
  background: #d9f0e8;
  border-radius: 16rpx;
  display: flex;
  font-size: 42rpx;
  height: 76rpx;
  justify-content: center;
  width: 76rpx;
}

.prep-entry__text {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 18rpx;
  min-width: 0;
}

.prep-entry__title {
  color: #173b34;
  font-size: 30rpx;
  font-weight: 600;
}

.prep-entry__description {
  color: #66817a;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 6rpx;
}

.prep-entry__arrow {
  color: #6b9389;
  font-size: 46rpx;
  margin-left: 12rpx;
}

.prep-entry-error {
  align-items: center;
  background: #fff1f1;
  border-radius: 14rpx;
  color: #b42318;
  display: flex;
  font-size: 24rpx;
  justify-content: space-between;
  margin: 14rpx 20rpx 0;
  padding: 18rpx 20rpx;
}

.prep-entry-error__retry {
  color: #187e6e;
  flex-shrink: 0;
  margin-left: 20rpx;
}
