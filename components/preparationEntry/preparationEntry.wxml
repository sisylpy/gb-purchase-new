<view class="prep-entry" wx:if="{{visible}}" bindtap="openPreparation" hover-class="prep-entry--pressed">
  <view class="prep-entry__icon">料</view>
  <view class="prep-entry__text">
    <text class="prep-entry__title">{{title}}</text>
    <text class="prep-entry__description">{{description}}</text>
  </view>
  <text class="prep-entry__arrow">›</text>
</view>

<view class="prep-entry-error" wx:if="{{error}}" bindtap="checkAccess">
  <text>{{error}}</text>
  <text class="prep-entry-error__retry">重新校验</text>
</view>
