/* ===== 公共基础样式（与经营四卡共用）===== */

.biz-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #eef0f2;
  padding: 28rpx 24rpx;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.biz-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.biz-header-right {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.biz-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #e8f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.biz-icon {
  font-size: 28rpx;
  line-height: 1;
}

.biz-icon-blue {
  background: #e3f2fd;
}

.biz-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.biz-scope-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.biz-scope-name {
  font-size: 22rpx;
  color: #6b7280;
}

/* ===== 空状态 ===== */
.biz-empty {
  padding: 40rpx 16rpx;
  text-align: center;
}

.biz-empty-text {
  font-size: 26rpx;
  color: #9ca3af;
  line-height: 1.5;
}

/* ===== KPI 行 ===== */
.biz-kpi-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.biz-kpi-col {
  flex: 1;
  min-width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: #f8fafb;
  border-radius: 14rpx;
  padding: 18rpx 16rpx;
}

.biz-kpi-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
  white-space: nowrap;
}

.biz-kpi-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #059669;
  line-height: 1.2;
}

.biz-kpi-normal {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.biz-kpi-ratio {
  font-size: 30rpx;
  font-weight: 700;
  color: #d97706;
}

/* ===== Section 区块 ===== */
.biz-section {
  border-top: 1rpx solid #f3f4f6;
  padding-top: 18rpx;
  margin-top: 8rpx;
}

.biz-section-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.biz-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.biz-section-sub {
  font-size: 22rpx;
  color: #9ca3af;
  margin-left: auto;
}

.biz-section-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 500;
  white-space: nowrap;
}

.biz-badge-blue {
  background: #e8f0fe;
  color: #1a73e8;
}

.biz-badge-gray {
  background: #f3f4f6;
  color: #6b7280;
}

/* ===== 采购来源 Pills ===== */
.biz-pill-row {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.biz-pill-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f8fafb;
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
}

.biz-pill-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
}

.biz-pill-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
}

/* ===== 库存快照 ===== */
.biz-inventory-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.biz-inventory-main {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.biz-inventory-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #059669;
  line-height: 1;
}

.biz-inventory-unit {
  font-size: 24rpx;
  color: #6b7280;
}

.biz-inventory-dish {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.biz-inventory-dish-label {
  font-size: 22rpx;
  color: #6b7280;
}

.biz-inventory-dish-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.biz-inventory-dish-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.biz-inventory-dish-days {
  font-size: 22rpx;
  color: #d97706;
  background: #fef3c7;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

/* ===== 价格趋势 ===== */
.biz-trend-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.biz-trend-value {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1;
}

.biz-trend-up {
  color: #dc2626;
}

.biz-trend-down {
  color: #059669;
}

.biz-trend-neutral {
  color: #6b7280;
}

.biz-trend-detail {
  background: #f8fafb;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
}

.biz-trend-detail-text {
  font-size: 24rpx;
  color: #374151;
}

/* ===== 关联菜品列表 ===== */
.biz-dish-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.biz-dish-row {
  background: #f8fafb;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
}

.biz-dish-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.biz-dish-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.biz-dish-recipe {
  font-size: 22rpx;
  color: #6b7280;
}

.biz-dish-body {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.biz-dish-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.biz-dish-stat-label {
  font-size: 20rpx;
  color: #9ca3af;
  margin-bottom: 4rpx;
}

.biz-dish-stat-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
}

.biz-dish-days {
  color: #d97706;
}

/* ===== 判断信号标签 ===== */
.biz-signal-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f3f4f6;
}

.biz-signal-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.biz-signal-info {
  background: #e8f0fe;
  color: #1a73e8;
}

.biz-signal-warn {
  background: #fef3c7;
  color: #b45309;
}

/* ===== 能力边界提示 ===== */
.biz-gap-list {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #e5e7eb;
}

.biz-gap-label {
  font-size: 20rpx;
  color: #9ca3af;
  line-height: 1.4;
}
