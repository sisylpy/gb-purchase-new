<view class="biz-card biz-pba" wx:if="{{cardData}}">

  <!-- 卡片标题 -->
  <view class="biz-header">
    <view class="biz-icon-wrap biz-icon-blue">
      <text class="biz-icon">📊</text>
    </view>
    <view class="biz-header-right">
      <text class="biz-title">{{_title}}</text>
      <view class="biz-scope-bar" wx:if="{{_scopeLabel || _timeLabel}}">
        <text class="biz-scope-name" wx:if="{{_scopeLabel}}">{{_scopeLabel}}</text>
        <text class="biz-scope-name" wx:if="{{_timeLabel}}">{{_timeLabel}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="biz-empty" wx:if="{{_isEmpty}}">
    <text class="biz-empty-text">{{_emptyReason}}</text>
  </view>

  <!-- 有数据 -->
  <block wx:else>
    <!-- KPI 核心数字 -->
    <view class="biz-kpi-row">
      <view class="biz-kpi-col">
        <text class="biz-kpi-label">采购总金额</text>
        <text class="biz-kpi-value">¥{{_totalAmount}}</text>
      </view>
      <view class="biz-kpi-col">
        <text class="biz-kpi-label">采购总数量</text>
        <text class="biz-kpi-value biz-kpi-normal">{{_totalQuantity}}</text>
      </view>
      <view class="biz-kpi-col">
        <text class="biz-kpi-label">采购笔数</text>
        <text class="biz-kpi-value biz-kpi-normal">{{_totalLineCount}} 笔</text>
      </view>
      <view class="biz-kpi-col">
        <text class="biz-kpi-label">采购/理论消耗比</text>
        <text class="biz-kpi-value biz-kpi-ratio">{{_pvRatioPercent}}%</text>
      </view>
    </view>

    <!-- 采购来源分析 -->
    <view class="biz-section">
      <view class="biz-section-head">
        <text class="biz-section-title">📥 采购来源</text>
        <text class="biz-section-badge biz-badge-blue">{{_dominantSourceLabel}}</text>
      </view>
      <view class="biz-pill-row">
        <view class="biz-pill-item" wx:for="{{_sourcePills}}" wx:key="label" wx:for-item="sp">
          <text class="biz-pill-label">{{sp.label}}</text>
          <text class="biz-pill-value">¥{{sp.amount}} / {{sp.quantity}}</text>
        </view>
      </view>
    </view>

    <!-- 库存快照 -->
    <view class="biz-section" wx:if="{{_currentStockQty != null}}">
      <view class="biz-section-head">
        <text class="biz-section-title">📦 库存快照</text>
        <text class="biz-section-sub" wx:if="{{_inventoryLabel}}">{{_inventoryLabel}}</text>
      </view>
      <view class="biz-inventory-row">
        <view class="biz-inventory-main">
          <text class="biz-inventory-num">{{_currentStockQty}}</text>
          <text class="biz-inventory-unit" wx:if="{{_stockUnit}}">{{_stockUnit}}</text>
        </view>
        <view class="biz-inventory-dish" wx:if="{{_firstImpactedDishName}}">
          <text class="biz-inventory-dish-label">首道受影响的菜品</text>
          <view class="biz-inventory-dish-info">
            <text class="biz-inventory-dish-name">{{_firstImpactedDishName}}</text>
            <text class="biz-inventory-dish-days">可支撑 {{_firstImpactedCoverDays}} 天</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 价格趋势 -->
    <view class="biz-section">
      <view class="biz-section-head">
        <text class="biz-section-title">💹 价格趋势</text>
        <text class="biz-section-sub" wx:if="{{_priceCompareLabel}}">对比 {{_priceCompareLabel}}</text>
      </view>
      <view class="biz-trend-row">
        <text class="biz-trend-value {{_priceTrend === 'UP' ? 'biz-trend-up' : _priceTrend === 'DOWN' ? 'biz-trend-down' : 'biz-trend-neutral'}}">{{_priceTrendLabel}}</text>
        <block wx:if="{{_hasPriceChange}}">
          <view class="biz-trend-detail" wx:for="{{_priceChangeRows}}" wx:key="index" wx:for-item="row">
            <text class="biz-trend-detail-text">{{row}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 关联菜品 -->
    <view class="biz-section" wx:if="{{_linkedDishCount > 0}}">
      <view class="biz-section-head">
        <text class="biz-section-title">🍽️ 关联菜品</text>
        <text class="biz-section-badge biz-badge-gray">{{_linkedDishCount}} 道</text>
        <text class="biz-section-sub" wx:if="{{_salesBaselineLabel}}">{{_salesBaselineLabel}}</text>
      </view>
      <view class="biz-dish-list">
        <view class="biz-dish-row" wx:for="{{_dishRows}}" wx:key="dishId" wx:for-item="dish">
          <view class="biz-dish-head">
            <text class="biz-dish-name">{{dish.dishName}}</text>
            <text class="biz-dish-recipe">配方用量 {{dish.recipeUnitPerDish}}/份</text>
          </view>
          <view class="biz-dish-body">
            <view class="biz-dish-stat">
              <text class="biz-dish-stat-label">日均销量</text>
              <text class="biz-dish-stat-value">{{dish.dailySalesPortions}} 份</text>
            </view>
            <view class="biz-dish-stat">
              <text class="biz-dish-stat-label">库存可支持</text>
              <text class="biz-dish-stat-value">{{dish.supportedPortionsFromStock}} 份</text>
            </view>
            <view class="biz-dish-stat">
              <text class="biz-dish-stat-label">覆盖天数</text>
              <text class="biz-dish-stat-value biz-dish-days">{{dish.coverDays}} 天</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 判断信号 -->
    <view class="biz-signal-list" wx:if="{{_signalTags.length > 0}}">
      <text class="biz-signal-tag biz-signal-{{sig.severity === 'WARN' ? 'warn' : 'info'}}" wx:for="{{_signalTags}}" wx:key="code" wx:for-item="sig">
        {{sig.label}}
      </text>
    </view>

    <!-- 能力边界提示 -->
    <view class="biz-gap-list" wx:if="{{_gapLabels.length > 0}}">
      <text class="biz-gap-label" wx:for="{{_gapLabels}}" wx:key="*this" wx:for-item="gap">💡 {{gap}}</text>
    </view>
  </block>

</view>
