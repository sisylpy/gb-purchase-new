/* ============ 弹窗动画效果 ============ */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 9999;
  padding-left: 5%;
  padding-right: 5%;
  opacity: 0;
  animation: fadeIn 0.3s ease-out forwards;
}

.modal-content {
  background-color: #fff;
  margin-top: 180rpx;
  border-radius: 16rpx 16rpx 0 0;
  transform: translateY(100%);
  animation: slideUp 0.3s ease-out forwards;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.15);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes fadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes slideDown {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}

.mask.closing {
  animation: fadeOut 0.3s ease-in forwards;
}

.modal-content.closing {
  animation: slideDown 0.3s ease-in forwards;
}

/* 头部 */
.modal-header {
  height: 20%;
  width: 100%;
  background: linear-gradient(135deg, #187e6e 0%, #0f6b5d 100%);
  color: #fff;
  display: flex;
  flex-flow: column nowrap;
  justify-items: center;
  justify-content: center;
}

.goods-title {
  font-size: 60rpx;
  display: flex;
  flex-flow: row nowrap;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 20rpx;
}

.brand {
  border: 1px solid rgba(255,255,255,0.6);
  color: #fff;
  font-weight: 300;
  padding: 0 6rpx;
  border-radius: 10rpx;
  font-size: 35rpx;
  margin-right: 4rpx;
}

/* 内容区 */
.modal-body {
  display: flex;
  flex-flow: column nowrap;
  height: 80%;
  align-content: stretch;
}

.goods-contents {
  width: 100%;
  display: flex;
  flex-flow: column nowrap;
  flex-basis: 75%;
  justify-content: space-around;
  padding-top: 10rpx;
  font-size: 38rpx;
}

/* 输入框 */
.input {
  padding: 5rpx 10rpx;
  font-size: 38rpx;
}

.input-view {
  border: 1px solid #ddd;
  border-radius: 10rpx;
  height: 60rpx;
  line-height: 60rpx;
}

/* 行布局 */
.flex-row {
  display: flex;
  flex-flow: row nowrap;
  justify-content: flex-start;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-flow: column nowrap;
  justify-content: flex-start;
}

.row-between {
  display: flex;
  flex-flow: row nowrap;
  align-items: center;
  justify-content: space-between;
}

.p-20 {
  padding: 20rpx;
}

.mr-10 {
  margin-right: 10rpx;
}

.margin-right {
  margin-right: 20rpx;
}

.with-tbl-padding {
  padding-top: 10rpx;
  padding-bottom: 10rpx;
}

/* 价格异常原因 */
.reason {
  display: none;
}

.reason.is-active {
  display: block;
}

/* 底部按钮 */
.modal-footer {
  flex: 1;
  display: flex;
  align-items: flex-end;
}

.btn-row {
  width: 100%;
  display: flex;
  flex-flow: row nowrap;
  justify-content: center;
  font-size: 36rpx;
  align-items: center;
  padding: 24rpx 20rpx;
  gap: 24rpx;
  box-sizing: border-box;
}

.confirm-btn {
  flex: 1;
  height: 80rpx;
  line-height: 78rpx;
  background: #f1f4f3;
  color: #a1aaa7;
  text-align: center;
  border: 1rpx solid #e1e7e4;
  border-radius: 8rpx;
  font-weight: 600;
  font-size: 32rpx;
  box-sizing: border-box;
  box-shadow: none;
  transition: all 0.2s ease;
}

.confirm-btn.is-active {
  background: #edf7f3;
  color: #187e6e;
  border-color: #c7e4db;
  box-shadow: none;
}

.cancel-btn {
  flex: 1;
  height: 80rpx;
  line-height: 78rpx;
  background: #ffffff;
  color: #4f6760;
  text-align: center;
  border-radius: 8rpx;
  font-weight: 600;
  font-size: 32rpx;
  border: 1rpx solid #cfddd8;
  box-sizing: border-box;
  box-shadow: none;
  transition: all 0.2s ease;
}

.cancel-btn:active {
  background: #f3f8f6;
  border-color: #b9d2ca;
  box-shadow: none;
}

.confirm-btn.is-active:active {
  background: #dfeee9;
  border-color: #aed7cb;
  box-shadow: none;
}
