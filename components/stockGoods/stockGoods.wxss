/* 处理库存批次弹窗 */
.sg-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: stretch;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: rgba(0, 0, 0, 0.45);
}

.sg-mask--keyboard {
  justify-content: flex-end;
}

.sg-panel {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 88vh;
  overflow: hidden;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.sg-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: #187e6e;
}

.sg-head__title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.sg-head__close {
  width: 56rpx;
  height: 56rpx;
  font-size: 40rpx;
  line-height: 56rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.9);
}

.sg-head__close--hover {
  opacity: 0.7;
}

.sg-body {
  flex: 1;
  min-height: 0;
  max-height: calc(88vh - 200rpx);
  padding: 24rpx 28rpx 12rpx;
  box-sizing: border-box;
}

.sg-product {
  display: flex;
  flex-direction: row;
  padding: 20rpx;
  background: #f8faf9;
  border-radius: 16rpx;
}

.sg-product__img {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
  background: #eee;
}

.sg-product__info {
  flex: 1;
  min-width: 0;
}

.sg-product__name {
  display: block;
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.sg-product__meta {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: #666;
}

.sg-product__meta--stock {
  margin-top: 4rpx;
  color: #187e6e;
  font-weight: 500;
}

.sg-batch-bar {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 16rpx 0 20rpx;
  padding: 16rpx 20rpx;
  background: #eef8f5;
  border-radius: 12rpx;
}

.sg-batch-bar__item {
  font-size: 24rpx;
  color: #187e6e;
}

.sg-tabs {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.sg-tab {
  position: relative;
  flex: 1;
  min-width: 120rpx;
  padding: 18rpx 12rpx;
  font-size: 26rpx;
  text-align: center;
  color: #666;
  background: #f5f5f5;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
}

.sg-tab--active {
  color: #187e6e;
  font-weight: 600;
  background: #eef8f5;
  border-color: #187e6e;
}

.sg-tab__check {
  position: absolute;
  top: 4rpx;
  right: 8rpx;
  font-size: 20rpx;
  color: #187e6e;
}

.sg-section-head {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 12rpx;
}

.sg-section-head__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.sg-section-head__tag {
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  color: #187e6e;
  background: #eef8f5;
  border-radius: 8rpx;
}

.sg-hint {
  display: block;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #999;
}

.sg-input-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 12rpx;
  overflow: hidden;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
}

.sg-input-row__input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #187e6e;
}

.sg-input-row__unit {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
  height: 88rpx;
  font-size: 28rpx;
  color: #333;
  background: #f5f5f5;
  border-left: 2rpx solid #e0e0e0;
}

.sg-input-row__unit--pick {
  color: #187e6e;
  background: #e8f5f2;
}

.sg-input-row__arrow {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.sg-input-row__unit--pick .sg-input-row__arrow {
  color: #187e6e;
}

.sg-equiv {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #888;
}

.sg-compare {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #eef8f5;
  border-radius: 12rpx;
}

.sg-compare__cell {
  flex: 1;
  text-align: center;
}

.sg-compare__cell--after .sg-compare__val {
  color: #187e6e;
  font-weight: 600;
}

.sg-compare__label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.sg-compare__val {
  font-size: 28rpx;
  color: #333;
}

.sg-compare__arrow {
  padding: 0 16rpx;
  font-size: 28rpx;
  color: #187e6e;
}

.sg-calc {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.sg-calc__title {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.sg-calc__i {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #187e6e;
}

.sg-calc__row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.sg-calc__label {
  font-size: 26rpx;
  color: #666;
}

.sg-calc__val {
  font-size: 28rpx;
  font-weight: 600;
}

.sg-calc__val--warn {
  color: #e67e22;
}

.sg-calc__val--ok {
  color: #187e6e;
}

.sg-tip-banner {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 20rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8a6d3b;
  background: #fff9e6;
  border-radius: 12rpx;
}

.sg-tip-banner__icon {
  margin-right: 10rpx;
}

.sg-reason-block {
  margin: 20rpx 0;
  padding: 20rpx 24rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.sg-reason-block .sg-reason-title {
  margin: 0 0 12rpx;
}

.sg-reason-block .sg-reason-tags {
  margin-bottom: 0;
}

.sg-reason-block .sg-note-row {
  margin-top: 16rpx;
  margin-bottom: 0;
}

.sg-reason-title {
  margin: 20rpx 0 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.sg-reason-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.sg-reason-tag {
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
}

.sg-reason-tag--active {
  color: #187e6e;
  font-weight: 600;
  background: #eef8f5;
  border-color: #187e6e;
}

.sg-photo-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.sg-photo-row__label {
  width: 80rpx;
  padding-top: 20rpx;
  font-size: 28rpx;
  color: #666;
}

.sg-photo-row__box {
  position: relative;
}

.sg-photo-row__img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.sg-photo-row__del {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
}

.sg-photo-row__del-icon {
  width: 40rpx;
  height: 40rpx;
}

.sg-note-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

.sg-note-row__label {
  width: 80rpx;
  font-size: 28rpx;
  color: #666;
}

.sg-note-row__input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
}

.sg-waste-wait {
  padding: 40rpx 20rpx;
  font-size: 28rpx;
  text-align: center;
  color: #e67e22;
}

.sg-footer {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  padding: 20rpx 28rpx 28rpx;
  border-top: 1rpx solid #eee;
}

.sg-footer__btn {
  flex: 1;
  padding: 24rpx;
  font-size: 30rpx;
  text-align: center;
  border-radius: 12rpx;
}

.sg-footer__btn--cancel {
  color: #333;
  background: #fff;
  border: 2rpx solid #ddd;
}

.sg-footer__btn--confirm {
  color: #fff;
  font-weight: 600;
  background: #187e6e;
}

.sg-footer__btn--disabled {
  opacity: 0.45;
}

.sg-footer__btn--hover {
  opacity: 0.85;
}
