.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: #ffffff;
  border-bottom: 1rpx solid #e0e0e0;
  z-index: 999;
}

.nav-container {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-left: 20rpx;
  border: 1px solid rgb(233, 233, 233);
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
  margin-left: 20rpx;
}

.nav-left, .nav-right {
  display: flex;
  align-items: center;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
}

.nav-button-text {
  font-size: 28rpx;
  color: #187e6e;
  padding: 0 20rpx;
}
