/* stock-reconcile-card — 库存/销货核对卡 */

/* ===== 公共基础样式 ===== */

.biz-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #eef0f2;
  padding: 28rpx 24rpx;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.biz-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.biz-header-right {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.biz-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #e8f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.biz-icon {
  font-size: 28rpx;
  line-height: 1;
}

.biz-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.biz-scope-bar {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.biz-scope-tag {
  font-size: 22rpx;
  color: #1a73e8;
  background: #e8f0fe;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.biz-scope-name {
  font-size: 22rpx;
  color: #6b7280;
}

.biz-kpi-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.biz-kpi-col {
  flex: 1;
  min-width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: #f8fafb;
  border-radius: 14rpx;
  padding: 18rpx 16rpx;
}

.biz-kpi-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
  white-space: nowrap;
}

.biz-kpi-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #059669;
  line-height: 1.2;
}

.biz-kpi-normal {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.biz-kpi-warn {
  font-size: 28rpx;
  font-weight: 700;
  color: #ea580c;
}

.biz-kpi-unit {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 2rpx;
}

.biz-agent-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #d1fae5;
  margin-top: 8rpx;
}

.biz-agent-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #dcfce7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.biz-agent-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #166534;
  white-space: nowrap;
  flex-shrink: 0;
}

.biz-agent-text {
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.45;
}

/* ===== 库存核对卡独有 ===== */

.biz-icon-teal { background: #e0f2fe; }

.biz-kpi-ok { color: #059669 !important; }

/* 出库成本 & 毛利率汇总 */
.biz-stock-summary {
  margin-bottom: 16rpx;
}

/* 表格区域 */
.biz-table-section {
  border-top: 1rpx solid #e5e7eb;
  padding-top: 20rpx;
  margin-bottom: 12rpx;
}

.biz-table-subtitle {
  font-size: 28rpx;
  font-weight: 700;
  color: #374151;
  display: inline-block;
  margin-bottom: 12rpx;
}

/* 表头 */
.biz-table-header {
  display: flex;
  align-items: center;
  padding: 12rpx 8rpx;
  background: #f8fafb;
  border-radius: 10rpx 10rpx 0 0;
  border-bottom: 2rpx solid #e5e7eb;
}

.biz-th {
  font-size: 26rpx;
  font-weight: 700;
  color: #6b7280;
  text-align: left;
}

.biz-th-name { flex: 1.5; min-width: 140rpx; }
.biz-th-price { flex: 2.2; min-width: 220rpx; }
.biz-th-change { flex: 1; min-width: 100rpx; text-align: right; }

/* 表体 */
.biz-table-body {
  display: flex;
  flex-direction: column;
}

.biz-tr {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.biz-tr:last-child {
  border-bottom: none;
}

.biz-td {
  font-size: 28rpx;
  color: #374151;
}

.biz-td-name {
  flex: 1.5;
  min-width: 140rpx;
  font-weight: 600;
  color: #111827;
}

.biz-td-price {
  flex: 2.2;
  min-width: 220rpx;
  font-weight: 500;
  color: #6b7280;
}

.biz-td-change {
  flex: 1;
  min-width: 100rpx;
  text-align: right;
  font-weight: 700;
  font-size: 28rpx;
  color: #ef4444;
}

/* 右侧利润 */
.biz-profit-right {
  flex: 1;
  min-width: 200rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
  border-radius: 14rpx;
  padding: 16rpx;
  border: 1rpx solid #d1fae5;
}

.biz-profit-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.biz-profit-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #bbf7d0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.biz-profit-icon {
  font-size: 22rpx;
}

.biz-profit-label {
  font-size: 22rpx;
  color: #6b7280;
  flex-shrink: 0;
}

.biz-profit-value {
  font-size: 30rpx;
  font-weight: 800;
  color: #059669;
  margin-left: auto;
}

.biz-profit-green {
  color: #059669;
}

/* 小字提示 */
.biz-note {
  margin-bottom: 8rpx;
}

.biz-note-text {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.45;
}

/* 无差异 / 完全无数据 */
.biz-ok-section {
  border-top: 1rpx dashed #e5e7eb;
  padding-top: 14rpx;
  margin-bottom: 12rpx;
}

.biz-ok-text {
  font-size: 26rpx;
  color: #059669;
  font-weight: 500;
}

.biz-empty-section {
  border-top: 1rpx dashed #e5e7eb;
  padding-top: 14rpx;
  margin-bottom: 12rpx;
}

.biz-empty-text {
  font-size: 26rpx;
  color: #9ca3af;
  font-weight: 500;
}

/* Agent 变体 */
.biz-agent-teal { background: #cffafe; }
