// 公共基础层：与 utils/orderGoodsFmt.wxs 共享的纯函数已抽至 /wxs/orderGoodsFmt.base.wxs
var base = require('../../wxs/orderGoodsFmt.base.wxs');

// 复用公共基础层函数，避免重复实现
var isValid = base.isValid;
var isPositiveNum = base.isPositiveNum;
var hasText = base.hasText;
var smallPackSpec = base.smallPackSpec;
var cartonPackSpec = base.cartonPackSpec;
var packSpec = base.packSpec;
var resolveOrderQty = base.resolveOrderQty;
var orderQtyLabel = base.orderQtyLabel;
var hasOrderStandardScale = base.hasOrderStandardScale;
var formatQtyNum = base.formatQtyNum;
var isScalePurGoods = base.isScalePurGoods;
var purGoodsScaleUnit = base.purGoodsScaleUnit;
var purGoodsScaleFactor = base.purGoodsScaleFactor;
var buildPurItem = base.buildPurItem;
var resolveOrderScalePrice = base.resolveOrderScalePrice;
var resolveOrderScaleQty = base.resolveOrderScaleQty;
var orderUnitPriceForCompare = base.orderUnitPriceForCompare;
var isOrderPriceHigh = base.isOrderPriceHigh;

function cartonPackSpecInner(goods) {
  if (!goods) {
    return '';
  }
  var weight = goods.gbDgGoodsStandardWeight;
  var count = goods.gbDgItemsPerCarton;
  var unit = goods.gbDgGoodsStandardname;
  var carton = goods.gbDgCartonUnit;
  if (!hasText(carton) || !hasText(count)) {
    return '';
  }
  var inner = '';
  if (hasText(weight) && unit !== '斤') {
    inner = weight + '*' + count + unit;
  } else if (hasText(unit)) {
    inner = count + unit;
  } else {
    inner = count + '';
  }
  return '(' + inner + ')';
}

/** 商品标题行规格：箱规只显示内包装，如 (10L*2桶)，不重复外层 (箱) */
function titlePackSpec(goods) {
  var cartonInner = cartonPackSpecInner(goods);
  if (cartonInner) {
    return cartonInner;
  }
  return smallPackSpec(goods);
}

function hasTitlePackSpec(goods) {
  return hasText(titlePackSpec(goods));
}

/** 商品详情：与 packSpec 重复时不展示 */
function goodsDetailLabel(goods) {
  if (!goods) {
    return '';
  }
  var detail = goods.gbDgGoodsDetail;
  if (!hasText(detail) || detail + '' === 'null') {
    return '';
  }
  var d = (detail + '').trim();
  var spec = packSpec(goods);
  var titleSpec = titlePackSpec(goods);
  if (spec && spec.indexOf(d) >= 0) {
    return '';
  }
  if (titleSpec && titleSpec.indexOf(d) >= 0) {
    return '';
  }
  return '(' + d + ')';
}

function hasGoodsDetailLabel(goods) {
  return hasText(goodsDetailLabel(goods));
}

function hasCartonPackSpec(goods) {
  return !!cartonPackSpec(goods);
}

function goodsStandardInline(goods) {
  if (!goods || hasCartonPackSpec(goods)) {
    return '';
  }
  var unit = goods.gbDgGoodsStandardname;
  if (!hasText(unit)) {
    return '';
  }
  return '(' + unit + ')';
}

function depPackUnit(depGoods) {
  if (!depGoods) {
    return '';
  }
  if (hasText(depGoods.gbDdgDepGoodsStandardname)) {
    return depGoods.gbDdgDepGoodsStandardname;
  }
  return '';
}

function depPackWeight(depGoods) {
  if (!depGoods) {
    return '';
  }
  return depGoods.gbDgGoodsStandardWeight;
}

function depSmallPackSpec(depGoods) {
  var unit = depPackUnit(depGoods);
  var weight = depPackWeight(depGoods);
  if (!hasText(unit)) {
    return '';
  }
  if (hasText(weight) && unit !== '斤') {
    return '(' + weight + '/' + unit + ')';
  }
  return '';
}

function depCartonPackSpec(depGoods) {
  if (!depGoods) {
    return '';
  }
  var weight = depPackWeight(depGoods);
  var count = depGoods.gbDgItemsPerCarton;
  var unit = depPackUnit(depGoods);
  var carton = depGoods.gbDgCartonUnit;
  if (!hasText(carton) || !hasText(count)) {
    return '';
  }
  var inner = '';
  if (hasText(weight) && unit !== '斤') {
    inner = weight + '*' + count + unit;
  } else if (hasText(unit)) {
    inner = count + unit;
  } else {
    inner = count + '';
  }
  return '(' + inner + ')(' + carton + ')';
}

function depShowRawWeight(depGoods) {
  var weight = depPackWeight(depGoods);
  if (!hasText(weight)) {
    return false;
  }
  return !depSmallPackSpec(depGoods);
}

function returnQtyLabel(item) {
  var label = orderQtyLabel(item);
  if (!label) {
    return '';
  }
  return label.replace('订:', '退:');
}

function orderUnitMatchesProductSpec(orders, item) {
  if (!orders || !orders.gbDoStandard || !item || !item.gbDistributerGoodsEntity) {
    return false;
  }
  var orderStd = (orders.gbDoStandard + '').trim();
  var baseUnit = item.gbDistributerGoodsEntity.gbDgGoodsStandardname
    ? (item.gbDistributerGoodsEntity.gbDgGoodsStandardname + '').trim()
    : '';
  if (baseUnit && orderStd === baseUnit) {
    return true;
  }
  var cartonUnit = resolveCartonUnit(item);
  if (hasText(cartonUnit) && orderStd === (cartonUnit + '').trim()) {
    return true;
  }
  return false;
}

/** 供货商列表：出库数量（大包装显示箱数等；最小单位订货则显示 gbDpgBuyQuantity） */
function purGoodsOutQty(item) {
  if (!item) {
    return '';
  }
  if (!useCartonPrice(item)) {
    var ordersBase = item.gbDepartmentOrdersEntities || [];
    var totalBase = 0;
    var hasBaseWeight = false;
    for (var b = 0; b < ordersBase.length; b++) {
      if (isPositiveNum(ordersBase[b].gbDoWeight)) {
        totalBase += parseFloat(ordersBase[b].gbDoWeight);
        hasBaseWeight = true;
      }
    }
    if (hasBaseWeight) {
      var baseUnit = item.gbDistributerGoodsEntity ? item.gbDistributerGoodsEntity.gbDgGoodsStandardname : '';
      return formatQtyNum(totalBase) + baseUnit;
    }
    var totalOrderQty = 0;
    var hasOrderQty = false;
    var allOrderUnitMatch = ordersBase.length > 0;
    for (var c = 0; c < ordersBase.length; c++) {
      if (!orderUnitMatchesProductSpec(ordersBase[c], item)) {
        allOrderUnitMatch = false;
        break;
      }
      if (isPositiveNum(ordersBase[c].gbDoQuantity)) {
        totalOrderQty += parseFloat(ordersBase[c].gbDoQuantity);
        hasOrderQty = true;
      }
    }
    if (allOrderUnitMatch && hasOrderQty) {
      var baseUnit3 = item.gbDistributerGoodsEntity ? item.gbDistributerGoodsEntity.gbDgGoodsStandardname : '';
      return formatQtyNum(totalOrderQty) + baseUnit3;
    }
    if (isPositiveNum(item.gbDpgBuyQuantity) && allOrderUnitMatch) {
      var baseUnit2 = item.gbDistributerGoodsEntity ? item.gbDistributerGoodsEntity.gbDgGoodsStandardname : '';
      return item.gbDpgBuyQuantity + baseUnit2;
    }
    return '';
  }
  var scaleUnit = purGoodsScaleUnit(item);
  if (isPositiveNum(item.gbDpgBuyScaleQuantity)) {
    return item.gbDpgBuyScaleQuantity + scaleUnit;
  }
  var orders = item.gbDepartmentOrdersEntities || [];
  var totalScale = 0;
  var hasScaleWeight = false;
  for (var i = 0; i < orders.length; i++) {
    if (isPositiveNum(orders[i].gbDoScaleWeight)) {
      totalScale = totalScale + parseFloat(orders[i].gbDoScaleWeight);
      hasScaleWeight = true;
    }
  }
  if (hasScaleWeight) {
    return formatQtyNum(totalScale) + scaleUnit;
  }
  var factor = purGoodsScaleFactor(item);
  if (isPositiveNum(item.gbDpgBuyQuantity) && factor > 0) {
    return formatQtyNum(parseFloat(item.gbDpgBuyQuantity) / factor) + scaleUnit;
  }
  return '';
}

function hasPurGoodsOutQty(item) {
  return hasText(purGoodsOutQty(item));
}

function isOrderBaseUnit(orders, item) {
  if (!orders || !orders.gbDoStandard) {
    return false;
  }
  var goods = item && item.gbDistributerGoodsEntity;
  if (!goods || !goods.gbDgGoodsStandardname) {
    return false;
  }
  var orderStd = (orders.gbDoStandard + '').trim();
  var baseUnit = (goods.gbDgGoodsStandardname + '').trim();
  return orderStd === baseUnit;
}

function isCartonOrderLine(orders, item) {
  if (!orders || !orders.gbDoStandard) {
    return false;
  }
  var cartonUnit = resolveCartonUnit(item);
  if (!hasText(cartonUnit)) {
    return false;
  }
  return (orders.gbDoStandard + '').trim() === (cartonUnit + '').trim();
}

/** 订单行出库数量 */
function orderOutQty(orders, item) {
  if (!orders) {
    return '';
  }
  var goods = item && item.gbDistributerGoodsEntity;
  var weighUnit = goods ? goods.gbDgGoodsStandardname : '';
  var orderStd = orders.gbDoStandard ? (orders.gbDoStandard + '').trim() : '';

  if (isCartonOrderLine(orders, item)) {
    if (isPositiveNum(orders.gbDoScaleWeight)) {
      return formatQtyNum(parseFloat(orders.gbDoScaleWeight)) + orderStd;
    }
    if (hasOrderStandardScale(orders) && isPositiveNum(orders.gbDoWeight)) {
      var factor = parseFloat(orders.gbDoDsStandardScale);
      if (factor > 0) {
        return formatQtyNum(parseFloat(orders.gbDoWeight) / factor) + orderStd;
      }
    }
    return '';
  }

  if (isOrderBaseUnit(orders, item)) {
    if (isPositiveNum(orders.gbDoWeight)) {
      return formatQtyNum(parseFloat(orders.gbDoWeight)) + orderStd;
    }
    return '';
  }

  if (isPositiveNum(orders.gbDoWeight) && weighUnit) {
    return formatQtyNum(parseFloat(orders.gbDoWeight)) + weighUnit;
  }
  return '';
}

function hasOrderOutQty(orders, item) {
  return hasText(orderOutQty(orders, item));
}

function orderOriginalQty(orders) {
  if (!orders || !isPositiveNum(orders.gbDoQuantity)) {
    return '';
  }
  var qty = formatQtyNum(parseFloat(orders.gbDoQuantity));
  if (hasText(orders.gbDoStandard)) {
    return qty + orders.gbDoStandard;
  }
  return qty;
}

/** 门店行数量：已出库用出库数；与订货规格不一致时前缀 (订货数)，如 (3颗) 6斤 */
function orderQtyDisplay(orders, item) {
  if (!orders) {
    return '';
  }
  var originalQty = orderOriginalQty(orders);
  var outQty = orderOutQty(orders, item);
  if (hasText(outQty)) {
    if (hasText(originalQty) && originalQty !== outQty) {
      return '(' + originalQty + ') ' + outQty;
    }
    return outQty;
  }
  if (hasText(originalQty)) {
    return originalQty;
  }
  return '';
}

function hasOrderQtyDisplay(orders, item) {
  return hasText(orderQtyDisplay(orders, item));
}

/** 采购行 + 商品实体（pur/goods 分开传参的页面） */
function purRowOutQty(pur, goods) {
  var item = buildPurItem(pur, goods);
  return item ? purGoodsOutQty(item) : '';
}

function hasPurRowOutQty(pur, goods) {
  return hasText(purRowOutQty(pur, goods));
}

/** 单条部门订单出货数量（厨师收货等页面） */
function singleOrderOutQty(order) {
  if (!order) {
    return '';
  }
  var item = {
    gbDpgStandard: order.gbDoStandard,
    gbDistributerGoodsEntity: order.gbDistributerGoodsEntity,
  };
  return orderOutQty(order, item);
}

function hasSingleOrderOutQty(order) {
  return hasText(singleOrderOutQty(order));
}

function orderOutPriceLabel(orders, item) {
  if (!orders) {
    return '';
  }
  if (isOrderBaseUnit(orders, item)) {
    if (isPositiveNum(orders.gbDoPrice)) {
      return orders.gbDoPrice + '元/' + orders.gbDoStandard;
    }
    return '';
  }
  if (isCartonOrderLine(orders, item) && hasOrderStandardScale(orders)) {
    var scalePrice = resolveOrderScalePrice(orders, item);
    if (isPositiveNum(scalePrice)) {
      var unit = orders.gbDoStandard || purGoodsScaleUnit(item);
      return scalePrice + '元/' + unit;
    }
    return '';
  }
  if (isPositiveNum(orders.gbDoPrice)) {
    var baseUnit = item && item.gbDistributerGoodsEntity
      ? item.gbDistributerGoodsEntity.gbDgGoodsStandardname
      : '';
    return orders.gbDoPrice + '元/' + baseUnit;
  }
  return '';
}

function hasOrderOutPrice(orders, item) {
  return hasText(orderOutPriceLabel(orders, item));
}

function orderOutSubtotal(orders, item) {
  if (!orders) {
    return '';
  }
  if (isOrderBaseUnit(orders, item)) {
    if (isPositiveNum(orders.gbDoSubtotal)) {
      return orders.gbDoSubtotal;
    }
    if (isPositiveNum(orders.gbDoPrice) && isPositiveNum(orders.gbDoWeight)) {
      return (parseFloat(orders.gbDoPrice) * parseFloat(orders.gbDoWeight)).toFixed(1);
    }
    return '';
  }
  if (!isCartonOrderLine(orders, item)) {
    if (isPositiveNum(orders.gbDoSubtotal)) {
      return orders.gbDoSubtotal;
    }
    if (isPositiveNum(orders.gbDoPrice) && isPositiveNum(orders.gbDoWeight)) {
      return (parseFloat(orders.gbDoPrice) * parseFloat(orders.gbDoWeight)).toFixed(1);
    }
    return '';
  }
  // 箱规：小计 = 箱价 × 箱数，避免 gbDoPrice(8.3) × gbDoWeight(24) 舍入成 199.x
    if (hasOrderStandardScale(orders)) {
    var scalePrice = resolveOrderScalePrice(orders, item);
    var scaleQty = resolveOrderScaleQty(orders);
    if (isPositiveNum(scalePrice) && isPositiveNum(scaleQty)) {
      return (parseFloat(scalePrice) * parseFloat(scaleQty)).toFixed(2);
    }
  }
  if (isPositiveNum(orders.gbDoSubtotal)) {
    return orders.gbDoSubtotal;
  }
  if (isPositiveNum(orders.gbDoPrice) && isPositiveNum(orders.gbDoWeight)) {
    return (parseFloat(orders.gbDoPrice) * parseFloat(orders.gbDoWeight)).toFixed(1);
  }
  return '';
}

function hasOrderOutSubtotal(orders, item) {
  return hasText(orderOutSubtotal(orders, item));
}

function resolveCartonUnit(item) {
  var goods = item && item.gbDistributerGoodsEntity;
  if (goods && hasText(goods.gbDgCartonUnit)) {
    return goods.gbDgCartonUnit;
  }
  var baseUnit = goods && goods.gbDgGoodsStandardname;
  if (item && hasText(item.gbDpgStandard) && item.gbDpgStandard !== baseUnit && isPositiveNum(item.gbDpgBuyScale)) {
    return item.gbDpgStandard;
  }
  return '';
}

function useCartonPrice(item) {
  if (!item) {
    return false;
  }
  var goods = item.gbDistributerGoodsEntity;
  var cartonUnit = resolveCartonUnit(item);
  if (!hasText(cartonUnit)) {
    return false;
  }
  var orders = item.gbDepartmentOrdersEntities || [];
  var hasCartonOrder = false;
  for (var i = 0; i < orders.length; i++) {
    var o = orders[i];
    if (!o) {
      continue;
    }
    if (hasText(o.gbDoStandard) && o.gbDoStandard + '' === cartonUnit + '') {
      hasCartonOrder = true;
      break;
    }
  }
  if (!hasCartonOrder) {
    return false;
  }
  if (isPositiveNum(item.gbDpgBuyScale)) {
    return true;
  }
  for (var j = 0; j < orders.length; j++) {
    if (hasOrderStandardScale(orders[j])) {
      return true;
    }
  }
  return goods && isPositiveNum(goods.gbDgItemsPerCarton);
}

function cartonPriceUnit(item) {
  var unit = resolveCartonUnit(item);
  if (hasText(unit)) {
    return unit;
  }
  return purGoodsScaleUnit(item);
}

function useCartonWeight(order, item) {
  if (!order || !item) {
    return false;
  }
  if (hasOrderStandardScale(order)) {
    return true;
  }
  var cartonUnit = resolveCartonUnit(item);
  if (!hasText(cartonUnit) || !hasText(order.gbDoStandard)) {
    return false;
  }
  if (order.gbDoStandard + '' !== cartonUnit + '') {
    return false;
  }
  if (isPositiveNum(item.gbDpgBuyScale)) {
    return true;
  }
  var goods = item.gbDistributerGoodsEntity;
  return goods && isPositiveNum(goods.gbDgItemsPerCarton);
}

function cartonWeightUnit(order, item) {
  if (useCartonWeight(order, item)) {
    if (hasText(order.gbDoStandard)) {
      return order.gbDoStandard;
    }
    return resolveCartonUnit(item);
  }
  var goods = item && item.gbDistributerGoodsEntity;
  if (goods && hasText(goods.gbDgGoodsStandardname)) {
    return goods.gbDgGoodsStandardname;
  }
  return '';
}

function orderScalePerUnit(orders, item) {
  var goods = item && item.gbDistributerGoodsEntity;
  var baseUnit = goods ? goods.gbDgGoodsStandardname : '';
  if (goods && hasText(goods.gbDgCartonUnit)) {
    return goods.gbDgCartonUnit;
  }
  if (item && hasText(item.gbDpgStandard) && hasText(baseUnit) && item.gbDpgStandard + '' !== baseUnit + '' && isPositiveNum(item.gbDpgBuyScale)) {
    return item.gbDpgStandard;
  }
  if (orders && hasText(orders.gbDoStandard)) {
    return orders.gbDoStandard;
  }
  return '';
}

function resolvePurGoodsOrderUnit(item) {
  if (item && hasText(item.gbDpgStandard)) {
    return item.gbDpgStandard + '';
  }
  var orders = item && item.gbDepartmentOrdersEntities ? item.gbDepartmentOrdersEntities : [];
  for (var i = 0; i < orders.length; i++) {
    if (hasText(orders[i].gbDoStandard)) {
      return orders[i].gbDoStandard + '';
    }
  }
  return '';
}

/** 订货单位换算说明，如 (2斤/袋)：gbDpgBuyScale 为每订货单位含基础单位重量 */
function buyScaleHint(orders, item) {
  if (!item) {
    return '';
  }
  var scale = 0;
  var orderUnit = '';
  if (orders && hasOrderStandardScale(orders)) {
    scale = parseFloat(orders.gbDoDsStandardScale);
    orderUnit = orders.gbDoStandard ? orders.gbDoStandard + '' : '';
  } else if (isPositiveNum(item.gbDpgBuyScale)) {
    scale = parseFloat(item.gbDpgBuyScale);
    if (orders && hasText(orders.gbDoStandard)) {
      orderUnit = orders.gbDoStandard + '';
    } else {
      orderUnit = resolvePurGoodsOrderUnit(item);
    }
  }
  if (!scale || scale <= 0 || !hasText(orderUnit)) {
    return '';
  }
  var goods = item.gbDistributerGoodsEntity;
  var baseUnit = goods && goods.gbDgGoodsStandardname ? goods.gbDgGoodsStandardname + '' : '';
  if (!hasText(baseUnit) || orderUnit === baseUnit) {
    return '';
  }
  return '(' + formatQtyNum(scale) + baseUnit + '/' + orderUnit + ')';
}

function hasBuyScaleHint(orders, item) {
  return hasText(buyScaleHint(orders, item));
}

/** 采购行汇总：订货单位换算说明 */
function purGoodsBuyScaleHint(item) {
  if (!item || !isPositiveNum(item.gbDpgBuyScale)) {
    return '';
  }
  var orderUnit = resolvePurGoodsOrderUnit(item);
  var goods = item.gbDistributerGoodsEntity;
  var baseUnit = goods && goods.gbDgGoodsStandardname ? goods.gbDgGoodsStandardname + '' : '';
  if (!hasText(orderUnit) || !hasText(baseUnit) || orderUnit === baseUnit) {
    return '';
  }
  return '(' + formatQtyNum(parseFloat(item.gbDpgBuyScale)) + baseUnit + '/' + orderUnit + ')';
}

function hasPurGoodsBuyScaleHint(item) {
  return hasText(purGoodsBuyScaleHint(item));
}

/** 箱规/订货换算说明，如 (2斤/袋) */
function orderScaleSpecLabel(orders, item) {
  return buyScaleHint(orders, item);
}

function hasOrderScaleSpecLabel(orders, item) {
  return hasText(orderScaleSpecLabel(orders, item));
}

module.exports = {
  isValid: isValid,
  isPositiveNum: isPositiveNum,
  hasText: hasText,
  smallPackSpec: smallPackSpec,
  cartonPackSpec: cartonPackSpec,
  cartonPackSpecInner: cartonPackSpecInner,
  titlePackSpec: titlePackSpec,
  hasTitlePackSpec: hasTitlePackSpec,
  goodsDetailLabel: goodsDetailLabel,
  hasGoodsDetailLabel: hasGoodsDetailLabel,
  packSpec: packSpec,
  hasCartonPackSpec: hasCartonPackSpec,
  goodsStandardInline: goodsStandardInline,
  depSmallPackSpec: depSmallPackSpec,
  depCartonPackSpec: depCartonPackSpec,
  depShowRawWeight: depShowRawWeight,
  orderQtyLabel: orderQtyLabel,
  returnQtyLabel: returnQtyLabel,
  purGoodsOutQty: purGoodsOutQty,
  hasPurGoodsOutQty: hasPurGoodsOutQty,
  orderOutQty: orderOutQty,
  hasOrderOutQty: hasOrderOutQty,
  orderQtyDisplay: orderQtyDisplay,
  hasOrderQtyDisplay: hasOrderQtyDisplay,
  purRowOutQty: purRowOutQty,
  hasPurRowOutQty: hasPurRowOutQty,
  singleOrderOutQty: singleOrderOutQty,
  hasSingleOrderOutQty: hasSingleOrderOutQty,
  orderOutPriceLabel: orderOutPriceLabel,
  hasOrderOutPrice: hasOrderOutPrice,
  orderOutSubtotal: orderOutSubtotal,
  hasOrderOutSubtotal: hasOrderOutSubtotal,
  isOrderPriceHigh: isOrderPriceHigh,
  useCartonPrice: useCartonPrice,
  cartonPriceUnit: cartonPriceUnit,
  useCartonWeight: useCartonWeight,
  cartonWeightUnit: cartonWeightUnit,
  orderScaleSpecLabel: orderScaleSpecLabel,
  hasOrderScaleSpecLabel: hasOrderScaleSpecLabel,
  buyScaleHint: buyScaleHint,
  hasBuyScaleHint: hasBuyScaleHint,
  purGoodsBuyScaleHint: purGoodsBuyScaleHint,
  hasPurGoodsBuyScaleHint: hasPurGoodsBuyScaleHint,
};
