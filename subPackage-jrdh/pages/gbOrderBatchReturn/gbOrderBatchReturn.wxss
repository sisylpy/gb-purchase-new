page {
  background: #f7f7f7;
  height: 100%;
}

.page-root {
  box-sizing: border-box;
}

.page-wrap {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.page-inner {
  flex: 1;
  min-height: 0;
  padding: 10rpx 10rpx 10rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.body {
  flex: 1;
  min-height: 0;
  border: 1px solid lightgray;
  border-radius: 20rpx;
  background: rgb(250, 250, 250);
  padding: 0 10rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.body-return {
  border-color: rgba(245, 87, 108, 0.22);
  background: #fff;
}

.form_body {
  border: 1px solid rgb(226, 225, 225);
  flex: 1;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background-color: #fff;
}

.form_body-return {
  border-color: rgba(245, 87, 108, 0.12);
}

.return-summary {
  flex-shrink: 0;
  padding: 20rpx 24rpx 24rpx;
  background: linear-gradient(180deg, #fffafa 0%, #fff5f5 100%);
  border-top: 1rpx solid rgba(245, 87, 108, 0.12);
}

.return-summary-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.return-summary-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.return-summary-label {
  font-size: 24rpx;
  color: #999;
}

.return-summary-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.return-summary-total {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx dashed rgba(245, 87, 108, 0.25);
}

.return-summary-total-label {
  font-size: 28rpx;
  color: #666;
  font-weight: 600;
}

.return-summary-total-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #f5576c;
}

.return-action-bar {
  flex-shrink: 0;
  display: flex;
  justify-content: flex-end;
  padding: 0 10rpx 24rpx;
}

.return-btn-wrap {
  width: 320rpx;
  height: 100rpx;
  line-height: 100rpx;
}

.save_btn_return {
  width: 300rpx;
  line-height: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #f5576c 100%);
  box-shadow: 0 4rpx 16rpx rgba(245, 87, 108, 0.28);
}

.numHover {
  border: 1px solid #f5576c;
  color: #fff;
}

.btn_container {
  background-color: #dddddd;
  border-radius: 50rpx;
}

.save_btn {
  background-color: #0f78b4;
  color: #fff;
  text-align: center;
  font-size: 36rpx;
  margin-top: 10rpx;
  margin-left: 10rpx;
  border-radius: 40rpx;
}

.return-modal-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #f5576c 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(245, 87, 108, 0.25);
}

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.overlay.show {
  opacity: 1;
  visibility: visible;
}

.overlay.hide {
  opacity: 0;
  visibility: hidden;
}

.overlay.show .cancel-modal-container {
  transform: translateX(-50%) translateY(-50%) scale(1);
}

.cancel-modal-container {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  margin: 0 40rpx;
  max-width: 400rpx;
  width: 100%;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  position: absolute;
  left: 50%;
  transform: translateX(-50%) translateY(-50%) scale(0.9);
  transition: transform 0.3s ease;
}

.cancel-icon-container {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.cancel-icon {
  width: 80rpx;
  height: 80rpx;
}

.cancel-content {
  text-align: center;
}

.cancel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.cancel-message {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
}

.modal-container {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  position: relative;
  overflow: hidden;
  animation: modalSlideIn 0.3s ease-out;
}

@keyframes modalSlideIn {
  from {
    transform: translateY(-50rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-icon-container {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
}

.modal-icon-bg {
  background: #f8f9fa;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 2rpx solid #e9ecef;
}

.modal-icon {
  border-radius: 50%;
}

.modal-content {
  padding: 80rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.modal-header {
  text-align: center;
  margin-top: 20rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.modal-subtitle {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
}

.payment-section {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  border: 1rpx solid #e9ecef;
}

.payment-label {
  margin-bottom: 20rpx;
}

.payment-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #495057;
}

.radio-group {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  width: 100%;
}

.radio-option {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 20rpx 16rpx;
  background: #ffffff;
  border-radius: 12rpx;
  border: 2rpx solid #e9ecef;
}

.radio-text {
  font-size: 28rpx;
  color: #495057;
  margin-left: 16rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  text-align: center;
}

.secondary-btn {
  background: #f8f9fa;
  color: #6c757d;
  border: 2rpx solid #e9ecef;
}

.primary-btn {
  background: #007bff;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 123, 255, 0.2);
}

.disabled-btn {
  background: #e9ecef;
  color: #adb5bd;
}

.btn-text {
  font-size: 30rpx;
  font-weight: 600;
}

.btn-hover {
  transform: scale(0.98);
}
