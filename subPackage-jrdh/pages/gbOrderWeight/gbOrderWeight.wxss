page {
  background: #f7f7f7;
}

.body {
  border: 1px solid lightgray;
  border-radius: 20rpx;
  background: rgb(250, 250, 250);
  padding: 0 10rpx;
}

.form_top {
  margin-top: 20rpx;
}

.face_view {
  position: absolute;
  left: 40rpx;
  top: 180rpx;
  width: 120rpx;
  height: 100rpx;
  border-radius: 50%;
}

.share_face_view {
  position: absolute;
  right: 40rpx;
  top: 180rpx;
  width: 120rpx;
  height: 100rpx;
  border-radius: 50%;
}

.face_img {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
}

.form_body {
  border: 1px solid rgb(226, 225, 225);
  background-color: #fff;
}

.section_body {
  width: 100%;
  height: calc(100% - 156rpx);
  position: fixed;
  bottom: 0;
  left: 0;
}

.tui-city-scroll-y {
  height: 100%;
  box-sizing: border-box;
}

.order_bottom {
  padding: 20rpx 20rpx;
}

.inputWeight {
  border-radius: 10rpx;
  padding: 6rpx 10rpx;
  border: 1px solid lightgray;
}

.inputWeightPart {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
  background: #e1e3e4;
  box-sizing: border-box;
}

.inputWeightPart.hidden {
  display: none;
}

.weight-input-body {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.weight-keyboard-bottom {
  flex-shrink: 0;
  width: 100%;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.customize_key_board {
  background: #e1e3e4;
  padding-top: 20rpx;
}

.input_number_part {
  display: flex;
  flex-flow: row wrap;
}

.finish_btn {
  position: fixed;
  bottom: 20rpx;
  color: #fff;
  background: #0f78b4;
  padding: 20rpx 20rpx;
  text-align: center;
  font-size: 38rpx;
  border-radius: 10rpx;
}

.num_container {
  background-color: #f0f0f0;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  border: 1px solid rgb(223, 222, 222);
}

.double_num_container {
  background-color: #f0f0f0;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  border: 1px solid rgb(223, 222, 222);
}

.num {
  text-align: center;
  font-size: 60rpx;
  border-radius: 20rpx;
  background-color: #f5f5f5;
  color: #0b669b;
}

.numHover {
  border: 1px solid #0f78b4;
  color: #3c93c5;
}

.save_btn_container {
  border-radius: 20rpx;
  background-color: #dddddd;
}

.save_btn {
  background-color: #0f78b4;
  color: #fff;
  text-align: center;
  font-size: 36rpx;
  margin-top: 10rpx;
  margin-left: 10rpx;
  border-radius: 40rpx;
}

.save_double_btn {
  background-color: #0f78b4;
  color: #fff;
  text-align: center;
  font-size: 50rpx;
  border-radius: 10rpx;
}

.double_num {
  text-align: center;
  font-size: 50rpx;
  box-sizing: border-box;
  background-color: #f5f5f5;
  color: #0b669b;
}

.weightInput {
  border-radius: 20rpx;
  line-height: 120rpx;
  height: 120rpx;
  text-align: center;
  font-size: 60rpx;
  padding: 0 10rpx;
  background-color: #fff;
  color: #0f78b4;
}

.input_number {
  margin-right: 6rpx;
}

.analog_cursor {
  height: 70rpx;
  width: 4rpx;
  background: rgb(31, 31, 190);
  display: none;
}

.analog_cursor.is-active {
  display: block;
}

.bottom_place {
