  background-color: #dddddd;
}

.circle_item_gray {
  font-size: 34rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  margin-left: 10rpx;
  line-height: 80rpx;
  text-align: center;
}

.btn_item_gray {
  color: rgb(88, 87, 87);
  font-size: 32rpx;
  background-color: #e9e9e9;
  margin-top: 10rpx;
  margin-left: 10rpx;
  border-radius: 40rpx;
}

.btn_item {
  text-align: center;
  font-size: 34rpx;
  background-color: #e9e9e9;
  margin-top: 10rpx;
  margin-left: 10rpx;
  border-radius: 40rpx;
  color: #2380a5;
}

button.btn_item_gray {
  background: none;
  font-weight: 400;
  border: none;
  background-color: none;
  margin-left: 0;
  margin-right: 0;
  padding: 0;
  text-align: center;
  border-radius: 40rpx;
  font-size: 34rpx;
  background-color: #e9e9e9;
}

button.iknow {
  background: none;
  font-weight: 400;
  border: none;
  background-color: none;
  margin-left: 0;
  margin-right: 0;
  padding: 0;
  text-align: center;
  border-radius: 40rpx;
  font-size: 34rpx;
  background-color: #1378a0;
}

.sendBtn {
  background: #1378a0;
  color: #fff;
  border-left: 1px solid #1378a0;
  border-right: 1px solid #1378a0;
}

.btn_icon {
  width: 50rpx;
  height: 50rpx;
}

.btn_icon_big {
  width: 80rpx;
  height: 80rpx;
}

.icon_word {
  line-height: 50rpx;
  font-size: 30rpx;
}

.share_btn {
  font-size: 32rpx;
}

button.share_btn {
  background: none;
  font-weight: 400;
  border: none;
  background-color: none;
  margin-left: 0;
  margin-right: 0;
  padding: 0;
  text-align: center;
  border-radius: 40rpx;
  border: 5rpx solid gray;
  background-color: #0d7aa5;
  color: #fff;
}

.fixed {
  position: fixed;
  bottom: 20rpx;
}

.three_btn {
  font-size: 32rpx;
  text-align: center;
  border-radius: 40rpx;
  border: 5rpx solid gray;
  margin-right: 20rpx;
}

.cancleBtn {
  border-color: rgb(189, 189, 189);
  background-color: rgb(235, 235, 235);
  color: #6f7070;
  padding: 15rpx 0;
}

.bill_btn {
  border-radius: 20rpx;
  padding: 10rpx;
  width: 100rpx;
  border: 1px solid #fff;
  background-color: #0f78b4;
}

.avatar-wrapper {
  border-radius: 8px;
  margin-top: 40px;
  margin-bottom: 40px;
}

.avatar {
  display: block;
  width: 56px;
  height: 56px;
}

.weui-input {
  border-bottom: 1px solid gray;
  width: 100%;
  padding: 20rpx 20rpx;
}

.register-btn {
  display: inline-block;
  background-color: #5c5c5c;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 8rpx;
  width: 90%;
}

.register-btn.is-active {
  background-color: rgb(7, 182, 7);
  color: #fff;
}

button {
  background: none;
  border: none;
  background-color: none;
  line-height: 50rpx;
  border-radius: 40rpx;
}

button::after {
  border: none;
}

/* 确认弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-content {
  width: 85%;
  max-height: 80%;
  background-color: #fff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1px solid #f0f0f0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.modal-close {
  font-size: 60rpx;
  color: #999;
  line-height: 1;
  margin-left: 20rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
  max-height: 500rpx;
}

.content-preview {
  display: flex;
  flex-direction: column;
}

.preview-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.preview-content {
  background-color: #f5f5f5;
  padding: 20rpx;
  border-radius: 10rpx;
  min-height: 200rpx;
}

.preview-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  word-break: break-all;
  white-space: pre-wrap;
}

.modal-footer {
  padding: 30rpx;
  border-top: 1px solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.cancel-btn {
  background-color: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background-color: #0f78b4;
  color: #fff;
}

.pack-spec {
  color: #888;
  font-size: 28rpx;
  margin-left: 6rpx;
}

.pack-spec-line {
  color: #888;
  font-size: 28rpx;
  margin-top: 8rpx;
}

.weight-goods-name {
  font-size: 80rpx;
}