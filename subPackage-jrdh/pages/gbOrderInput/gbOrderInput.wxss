page{
  background: #f7f7f7;
}

.retName{
  position: absolute;
  left: 20rpx;
  top: 70rpx;
  color:#fff;
  font-size: 40rpx;
  font-weight: 500;
}
.body{
  border: 1px solid lightgray;
  border-radius: 20rpx;
  background: rgb(250, 250, 250);
  padding: 0 20rpx;
}

.form_top{
  margin-top: 20rpx;
}

.face_view{
  position: absolute;
  left: 40rpx;
  top: 160rpx;
  width: 120rpx;
  height: 100rpx;
  border-radius: 50%;
}

.share_face_view{
  position: absolute;
  right: 40rpx;
  top: 160rpx;
  width: 120rpx;
  height: 100rpx;
  border-radius: 50%;
}

.face_img{
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
}
.form_body{
  border: 1px solid rgb(184, 184, 184);
  background-color: #fff;
}

/* input_window */
.section_body{
  /* width: 100%; */
  height: calc(100% - 156rpx);
  position: fixed;
  bottom: 0;
  left: 0;
  } 

.tui-city-scroll-y{
  height: 100%;
  box-sizing: border-box;
}

.order_bottom{
  padding: 20rpx 20rpx;
}

/*  */

.customize_key_board{
  position: fixed;
  bottom: 0;
  left: 0;
  z-index: 998;
  background: #e1e3e4;
  padding-top: 20rpx;
}
.customize_key_board.hidden{
  display: none;
}

.input_number_part{
  display: flex;
  flex-flow: row wrap;
}

.num_container{
  background-color: #f0f0f0;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
    box-sizing:border-box;
    border: 1px solid rgb(223, 222, 222);
}

.double_num_container{
  background-color: #f0f0f0;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
    box-sizing:border-box;
    border: 1px solid rgb(223, 222, 222);
}

.num{
  text-align: center;
  font-size: 50rpx;
  /* box-sizing:border-box; */
  border-radius: 20rpx;
  background-color: #f5f5f5;  
}
.numHover{
  border: 1px solid #0f78b4;
  color: #0f78b4;
  /* background: #f0f7fa; */
}

.double_num{
  text-align: center;
  font-size: 50rpx;
  box-sizing:border-box;
  background-color: #f5f5f5;  

}

.weightInput{
  /* width: 100%; */
  /* border: 1px solid rgba(223, 223, 223, 0.575); */
  border-radius: 20rpx;
  line-height: 80rpx;
  height: 80rpx;
  text-align: center;
  font-size: 50rpx;
  padding: 0 10rpx;
  background-color: #fff;
  color: #0f78b4;
}
.inputTotal{
  border-radius: 20rpx;
  line-height: 80rpx;
  height: 80rpx;
  text-align: center;
  font-size: 50rpx;
  padding: 0 10rpx;
  background-color: #fff;
  color: #0f78b4;
  border: 1px solid #b8b8b8;
}
.input_number{
  margin-right: 6rpx;
}
.analog_cursor{
  height: 50rpx;
  width: 4rpx;
  background: blue;
  display: none;
}
.analog_cursor.is-active{
  display: block;
}

.bottom_place{
  width: 100%;
}

.save_double_btn{
  background-color: #0f78b4;
  color: #fff;
  text-align: center;
  font-size: 50rpx;
  border-radius: 10rpx;
}

.hoverItem{
  background-color: #d8eff8;
  border-radius: 40rpx;
}

.btn_container{
  background-color: #dddddd;
  border-radius: 50rpx;
}
.btn_item{
  text-align: center;
  font-size: 40rpx;
  background-color: #e9e9e9;  
  margin-top: 10rpx;
  margin-left: 10rpx;
  border-radius: 40rpx;
}
.sendBtn{
  background: #1378a0;
  color: #fff;
  border-left: 1px solid #1378a0;
  border-right: 1px solid #1378a0;
}
.btn_icon{
  width: 50rpx;
  height: 50rpx;
}
.btn_icon_big{
  width: 80rpx;
  height: 80rpx;
}
.icon_word{
  line-height: 50rpx;
  font-size: 30rpx;
}

.input_item{
  border: 1px solid lightgray;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  padding: 16rpx 12rpx 12rpx;
}
.input_item.is-active{
  background: #0f78b4;
  border: 1px solid #0f78b4;
  color: #fff;
}

.input-goods-card {
  font-size: 34rpx;
}

.input-goods-title {
  align-items: center;
  line-height: 1.35;
  padding: 0 4rpx 8rpx;
}

.goods-index {
  padding: 0 8rpx 0 4rpx;
  font-weight: 600;
}

.goods-name-text {
  font-weight: 600;
}

.input_item.is-active .pack-spec,
.input_item.is-active .gray.pack-spec {
  color: rgba(255, 255, 255, 0.85);
}

.input-detail-block {
  padding: 0 4rpx;
}

.input-price-row {
  padding: 8rpx 0 12rpx 36rpx;
  align-items: center;
}

.input-total-row {
  padding: 12rpx 8rpx 4rpx;
}

.text-danger {
  color: #e64340;
  font-weight: 600;
}

.input_item.is-active .text-danger {
  color: #ffe0e0;
}

.dept-order-table-wrap {
  margin-top: 0;
  padding: 8rpx 0 0;
  box-sizing: border-box;
  width: 100%;
  border-top: 1rpx solid #efefef;
}

.input_item.is-active .dept-order-table-wrap {
  border-top-color: rgba(255, 255, 255, 0.35);
}

.dept-order-table-wrap.dept-order-table-lg {
  padding: 8rpx 0 0;
}

.dept-order-table-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 4rpx;
  padding-top: 6rpx;
  font-size: 24rpx;
  color: #888;
  font-weight: 500;
}

.input_item.is-active .dept-order-table-title {
  color: rgba(255, 255, 255, 0.85);
}

.dept-order-table-title-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
  opacity: 0.75;
}

.dept-order-table-head,
.dept-order-table-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
}

.dept-order-table-head {
  padding: 4rpx 0 8rpx;
  color: #999;
  font-size: 26rpx;
  border-bottom: 1rpx solid #eee;
}

.input_item.is-active .dept-order-table-head {
  color: rgba(255, 255, 255, 0.75);
  border-bottom-color: rgba(255, 255, 255, 0.35);
}

.dept-order-table-row {
  padding: 10rpx 0 12rpx;
  font-size: 32rpx;
  color: #333;
  border-bottom: 1rpx solid #f5f5f5;
  line-height: 1.35;
}

.input_item.is-active .dept-order-table-row {
  color: #fff;
  border-bottom-color: rgba(255, 255, 255, 0.2);
}

.dept-order-table-row.is-last {
  border-bottom: none;
}

.dept-col-name {
  flex: 2.4;
  min-width: 0;
  padding-right: 8rpx;
  font-weight: 500;
}

.dept-col-qty,
.dept-col-price,
.dept-col-sub {
  flex: 1.4;
  min-width: 0;
  text-align: center;
}

.dept-col-sub,
.dept-order-table-head .dept-col-sub {
  text-align: right;
}

.pack-spec {
  color: #888;
  font-size: 28rpx;
  margin-left: 6rpx;
}
