:host {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  height: 100%;
}

.goods-list-root {
  flex: 1;
  min-height: 0;
  height: 100%;
}

.goods-list-auto {
  flex: none;
  height: auto;
}

.tui-city-scroll-y {
  height: 100%;
  box-sizing: border-box;
}

.seller-goods-main {
  flex: 1;
  min-width: 0;
}

.seller-goods-card {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 12rpx 12rpx;
}

.seller-goods-title-row {
  width: 100%;
  align-items: center;
  padding-right: 0;
  box-sizing: border-box;
  line-height: 1.35;
}

.seller-title-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: 8rpx;
}

.seller-op-btn {
  flex-shrink: 0;
}

.seller-goods-name {
  flex: 1;
  min-width: 0;
  align-items: center;
  font-size: 34rpx;
}

.goods-name-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

.goods-index {
  padding: 0 8rpx 0 4rpx;
  font-weight: 600;
  color: #222;
}

.goods-index-num {
  font-weight: 600;
  color: #222;
}

.seller-order-qty-wrap {
  flex-shrink: 0;
  margin-left: 20rpx;
  text-align: right;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.pack-spec {
  color: #888;
  font-size: 28rpx;
  margin-left: 6rpx;
}

.seller-order-qty {
  font-size: 34rpx;
  font-weight: 600;
  color: #0f78b4;
  white-space: nowrap;
}

.seller-order-qty-return {
  color: #f5576c;
}

.return-goods-row {
  background: linear-gradient(135deg, #fff8f8 0%, #ffffff 100%);
}

.return-subtotal {
  color: #f5576c;
  font-weight: 700;
}

.seller-check-icon {
  flex-shrink: 0;
  margin-left: 4rpx;
}

.seller-check-icon .icon {
  width: 44rpx;
  height: 44rpx;
}

.seller-op-btn.button-container-white {
  width: 64rpx;
  height: 64rpx;
}

.seller-price-row {
  font-size: 30rpx;
  margin-top: 16rpx;
}

.field-label {
  color: #666;
  margin-right: 6rpx;
}

.text-danger {
  color: #e64340;
  font-weight: 600;
}

.priced-item-done {
  padding-top: 12rpx;
  padding-bottom: 4rpx;
}

.priced-goods-name {
  line-height: 1.35;
  margin-bottom: 0;
  font-size: 34rpx;
  align-items: center;
}

.priced-order-block {
  padding-top: 8rpx;
}

.priced-dept-line {
  flex-wrap: wrap;
  line-height: 1.6;
  margin-bottom: 6rpx;
}

.priced-meta-wrap {
  width: 100%;
  padding-bottom: 20rpx;
}

.priced-sub-indent {
  padding-left: 36rpx;
  box-sizing: border-box;
}

.priced-meta-row-done {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  box-sizing: border-box;
  gap: 8rpx;
  font-size: 30rpx;
  line-height: 1.35;
}

.priced-meta-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  box-sizing: border-box;
}

.priced-meta-col .field-label {
  flex-shrink: 0;
  white-space: nowrap;
  margin-right: 4rpx;
}

.priced-meta-value {
  flex: 1;
  min-width: 0;
  /* word-break: break-all; */
  font-size: 30rpx;
}

.seller-dept-table-slot {
  width: 100%;
  margin-top: 12rpx;
  box-sizing: border-box;
}

.dept-order-table-wrap {
  margin-top: 0;
  padding: 8rpx 0 0;
  box-sizing: border-box;
  width: 100%;
  border-top: 1rpx solid #efefef;
}

.dept-order-table-wrap.dept-order-table-lg {
  padding: 8rpx 0 0;
}

.dept-order-table-wrap.dept-order-table-lg .dept-order-table-title {
  font-size: 24rpx;
  margin-bottom: 4rpx;
  color: #888;
  font-weight: 500;
}

.dept-order-table-wrap.dept-order-table-lg .dept-order-table-title-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.75;
}

.dept-order-table-wrap.dept-order-table-lg .dept-order-table-head {
  font-size: 26rpx;
  padding: 4rpx 0 8rpx;
  color: #999;
}

.dept-order-table-wrap.dept-order-table-lg .dept-order-table-row {
  font-size: 32rpx;
  padding: 10rpx 0 12rpx;
  color: #333;
}

.dept-order-table-wrap.dept-order-table-lg .dept-col-name {
  flex: 2.4;
  font-weight: 500;
}

.dept-order-table-wrap.dept-order-table-lg .dept-col-qty,
.dept-order-table-wrap.dept-order-table-lg .dept-col-price,
.dept-order-table-wrap.dept-order-table-lg .dept-col-sub {
  flex: 1.4;
}

.dept-order-table-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 4rpx;
  padding-top: 6rpx;
  font-size: 24rpx;
  color: #888;
  font-weight: 500;
}

.dept-order-table-title-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
  opacity: 0.75;
}

.dept-order-table-head,
.dept-order-table-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
}

.dept-order-table-head {
  padding: 4rpx 0 8rpx;
  color: #999;
  font-size: 26rpx;
  border-bottom: 1rpx solid #eee;
}

.dept-order-table-row {
  padding: 10rpx 0 12rpx;
  font-size: 32rpx;
  color: #333;
  border-bottom: 1rpx solid #f5f5f5;
  line-height: 1.35;
}

.dept-order-table-row.is-last {
  border-bottom: none;
}

.dept-col-name {
  flex: 2.2;
  min-width: 0;
  padding-right: 8rpx;
}

.dept-col-qty,
.dept-col-price {
  flex: 1.2;
  min-width: 0;
  text-align: center;
}

.dept-col-sub {
  flex: 1.2;
  min-width: 0;
  text-align: right;
}

.dept-order-table-head .dept-col-sub {
  text-align: right;
}
