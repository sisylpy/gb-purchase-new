:host {
  flex-shrink: 0;
}

.batch-summary-bar {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  background: #fff;
  border-radius: 16rpx;
  margin: 12rpx 8rpx 8rpx;
  padding: 20rpx 0;
  box-sizing: border-box;
  border: 1rpx solid #eee;
}

.batch-summary-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.batch-summary-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  margin-right: 10rpx;
}

.batch-summary-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.batch-summary-label {
  font-size: 24rpx;
  color: #666;
  line-height: 1.3;
  white-space: nowrap;
}

.batch-summary-value {
  font-size: 30rpx;
  color: #222;
  font-weight: 600;
  line-height: 1.35;
  margin-top: 4rpx;
  white-space: nowrap;
}

.batch-summary-value.is-total {
  color: #0f78b4;
}

.batch-summary-divider {
  width: 1rpx;
  align-self: stretch;
  background: #ececec;
  flex-shrink: 0;
}
