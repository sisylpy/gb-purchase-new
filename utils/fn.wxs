function getWeekDay(dateString) {
  if (!dateString) {
    return '';
  }
  var dateFormat = dateString.replace(getRegExp('-','g'),'/');
  var date = getDate(dateFormat);
  var dayOfWeek = date.getDay();
  var weekDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];
  return weekDays[dayOfWeek];
}

function getDayNumber(dateString) {
  if (!dateString) {
    return '';
  }
  var day = dateString.substring(8, 10);
  if (day.charAt(0) === '0') {
    day = day.charAt(1);
  }
  return day;
}

function getMonthDay(dateString) {
  if (!dateString) {
    return '';
  }
  var month = dateString.substring(5, 7);
  var day = dateString.substring(8, 10);
  if (month.charAt(0) === '0') {
    month = month.charAt(1);
  }
  if (day.charAt(0) === '0') {
    day = day.charAt(1);
  }
  return month + '月' + day + '日';
}

function getDateRange(rangeType) {
  if (!rangeType) {
    return { startDate: '', stopDate: '' };
  }
  var today = getDate();
  var year = today.getFullYear();
  var month = today.getMonth() + 1;
  var date = today.getDate();
  function formatDate(d) {
    var y = d.getFullYear();
    var m = d.getMonth() + 1;
    var day = d.getDate();
    return y + '-' + (m < 10 ? '0' + m : m) + '-' + (day < 10 ? '0' + day : day);
  }
  var startDate = '';
  var stopDate = '';
  switch (rangeType) {
    case 'today':
      startDate = stopDate = formatDate(today);
      break;
    case 'yesterday':
      var yesterday = getDate(today.getTime() - 24 * 60 * 60 * 1000);
      startDate = stopDate = formatDate(yesterday);
      break;
    case 'thisWeek':
      var dayOfWeek = today.getDay();
      var daysToMonday = dayOfWeek === 0 ? -6 : 1 - dayOfWeek;
      var thisWeekStart = getDate(today.getTime() + daysToMonday * 24 * 60 * 60 * 1000);
      startDate = formatDate(thisWeekStart);
      var daysToSunday = dayOfWeek === 0 ? 0 : 7 - dayOfWeek;
      var thisWeekEnd = getDate(today.getTime() + daysToSunday * 24 * 60 * 60 * 1000);
      stopDate = formatDate(thisWeekEnd);
      break;
    case 'lastWeek':
      var dayOfWeek = today.getDay();
      var daysToLastMonday = dayOfWeek === 0 ? -13 : -6 - dayOfWeek;
      var lastWeekStart = getDate(today.getTime() + daysToLastMonday * 24 * 60 * 60 * 1000);
      startDate = formatDate(lastWeekStart);
      var lastWeekEnd = getDate(lastWeekStart.getTime() + 6 * 24 * 60 * 60 * 1000);
      stopDate = formatDate(lastWeekEnd);
      break;
    case 'lastSevenDays':
      var sevenDaysAgo = getDate(today.getTime() - 7 * 24 * 60 * 60 * 1000);
      startDate = formatDate(sevenDaysAgo);
      var yesterday = getDate(today.getTime() - 24 * 60 * 60 * 1000);
      stopDate = formatDate(yesterday);
      break;
    case 'thisMonth':
      var thisMonthStart = getDate(year + '-' + (month < 10 ? '0' + month : month) + '-01');
      startDate = formatDate(thisMonthStart);
      stopDate = formatDate(today);
      break;
    case 'lastMonth':
      var lastMonth = month === 1 ? 12 : month - 1;
      var lastYear = month === 1 ? year - 1 : year;
      var lastMonthStart = getDate(lastYear + '-' + (lastMonth < 10 ? '0' + lastMonth : lastMonth) + '-01');
      startDate = formatDate(lastMonthStart);
      var thisMonthFirst = getDate(year + '-' + (month < 10 ? '0' + month : month) + '-01');
      var lastMonthEnd = getDate(thisMonthFirst.getTime() - 24 * 60 * 60 * 1000);
      stopDate = formatDate(lastMonthEnd);
      break;
    case 'lastThirtyDays':
      var lastMonthToday = getDate(today.getTime());
      lastMonthToday.setMonth(lastMonthToday.getMonth() - 1);
      startDate = formatDate(lastMonthToday);
      stopDate = formatDate(today);
      break;
    default:
      startDate = stopDate = '';
  }
  var chineseName = '';
  switch (rangeType) {
    case 'today': chineseName = '今天'; break;
    case 'yesterday': chineseName = '昨天'; break;
    case 'thisWeek': chineseName = '本周'; break;
    case 'lastWeek': chineseName = '上周'; break;
    case 'lastSevenDays': chineseName = '过去7天'; break;
    case 'thisMonth': chineseName = '本月'; break;
    case 'lastMonth': chineseName = '上月'; break;
    case 'lastThirtyDays': chineseName = '过去30天'; break;
    default: chineseName = rangeType;
  }
  return {
    startDate: startDate,
    stopDate: stopDate,
    name: chineseName
  };
}

function getHowManyDays(targetDate) {
  if (!targetDate) {
    return 0;
  }
  var dateStr = targetDate.toString();
  if (dateStr.match(getRegExp('^\\d{4}-\\d{2}-\\d{2}$'))) {
    var target = getDate(dateStr);
  } else {
    target = getDate(dateStr);
  }
  if (isNaN(target.getTime())) {
    return 0;
  }
  var today = getDate();
  today.setHours(0, 0, 0, 0);
  target.setHours(0, 0, 0, 0);
  var timeDiff = today.getTime() - target.getTime();
  var daysDiff = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
  return daysDiff;
}

function formatDateTimeToChinese(dateTimeString) {
  if (!dateTimeString) {
    return '';
  }
  var dateTimeStr = dateTimeString.toString();
  var parts = dateTimeStr.split(' ');
  if (parts.length !== 2) {
    return '';
  }
  var datePart = parts[0];
  var timePart = parts[1];
  var dateArray = datePart.split('-');
  if (dateArray.length !== 3) {
    return '';
  }
  var month = dateArray[1];
  var day = dateArray[2];
  var timeArray = timePart.split(':');
  if (timeArray.length < 2) {
    return '';
  }
  var hour = timeArray[0];
  var minute = timeArray[1];
  if (month.charAt(0) === '0') {
    month = month.charAt(1);
  }
  if (day.charAt(0) === '0') {
    day = day.charAt(1);
  }
  if (hour.charAt(0) === '0') {
    hour = hour.charAt(1);
  }
  if (minute.charAt(0) === '0') {
    minute = minute.charAt(1);
  }
  return month + '月' + day + '日' + hour + '点' + minute + '分';
}

function getDay(dateString) {
  if (!dateString) {
    return '';
  }
  var day = dateString.substring(8, 10);
  if (day.charAt(0) === '0') {
    day = day.charAt(1);
  }
  return day;
}

function getMonth(dateString) {
  if (!dateString) {
    return '';
  }
  var month = dateString.substring(5, 7);
  if (month.charAt(0) === '0') {
    month = month.charAt(1);
  }
  return month;
}

function getWeekDayName(weekday) {
  if (weekday === undefined || weekday === null) {
    return '';
  }
  var weekDays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
  return weekDays[weekday] || '';
}

function trimStrForNum(v) {
  if (v === undefined || v === null) {
    return '';
  }
  var s = '' + v;
  var start = 0;
  var end = s.length - 1;
  var ws = ' \n\r\t';
  while (start <= end && ws.indexOf(s.charAt(start)) >= 0) {
    start++;
  }
  while (end >= start && ws.indexOf(s.charAt(end)) >= 0) {
    end--;
  }
  return start > end ? '' : s.substring(start, end + 1);
}

/**
 * 总额 ÷ 销售份数 → 元/份（保留两位小数）。份数≤0 或无法解析时返回「—」。
 * 注意：WXS 不支持正则字面量，trim 用手写循环。
 */
function pricePerPortion(totalAmount, soldPortions) {
  if (totalAmount === undefined || totalAmount === null || soldPortions === undefined || soldPortions === null) {
    return '—';
  }
  var sa = trimStrForNum(totalAmount);
  var sp = trimStrForNum(soldPortions);
  if (sa === '' || sp === '') {
    return '—';
  }
  var t = parseFloat(sa);
  var p = parseFloat(sp);
  if (t !== t || p !== p || !(p > 0)) {
    return '—';
  }
  var per = t / p;
  return per.toFixed(2);
}

/**
 * 根据综合实际毛利率字符串给出运营提示（用于菜品卡底部条）。
 */
function marginPerformanceHint(actualGrossStr) {
  if (actualGrossStr == null) {
    return '';
  }
  var s = trimStrForNum(actualGrossStr);
  if (s === '') {
    return '';
  }
  var n = parseFloat(s);
  if (n !== n) {
    return '持续优化成本与毛利';
  }
  if (n >= 50) {
    return '表现优秀，继续保持！';
  }
  if (n >= 30) {
    return '表现良好，可继续优化';
  }
  if (n >= 0) {
    return '建议关注成本与售价';
  }
  return '建议核查经营数据';
}

/** 归一化 grossMarginLevel（接口：IN_BAND / BELOW / ABOVE / UNKNOWN） */
function _marginLevel(ins) {
  if (!ins) {
    return 'UNKNOWN';
  }
  var level = ins.grossMarginLevel;
  if (level === undefined || level === null || level === '') {
    return 'UNKNOWN';
  }
  return '' + level;
}

/**
 * 类别标准文字：目标 T、浮动 F、标准范围 [T−F, T+F]（接口字段为字符串 %）。
 */
function marginStandardMetaLine(ins) {
  if (!ins) {
    return '';
  }
  var T = ins.grossMarginStandardTarget;
  var F = ins.grossMarginStandardFloatAbs;
  var lo = ins.grossMarginStandardBandLower;
  var hi = ins.grossMarginStandardBandUpper;
  var hasT = T !== undefined && T !== null && trimStrForNum(T) !== '';
  var hasF = F !== undefined && F !== null && trimStrForNum(F) !== '';
  var hasLo = lo !== undefined && lo !== null && trimStrForNum(lo) !== '';
  var hasHi = hi !== undefined && hi !== null && trimStrForNum(hi) !== '';
  if (!hasT && !hasF && !(hasLo && hasHi)) {
    return '';
  }
  var parts = [];
  if (hasT) {
    parts.push('目标 ' + trimStrForNum(T) + '%');
  }
  if (hasF) {
    parts.push('浮动 ±' + trimStrForNum(F) + '%');
  }
  if (hasLo && hasHi) {
    parts.push('标准范围 ' + trimStrForNum(lo) + '%～' + trimStrForNum(hi) + '%');
  }
  if (parts.length === 0) {
    return '';
  }
  return parts.join(' · ');
}

/**
 * 相对类别标准（grossMarginLevel）的短文案（与图标同区展示）。
 */
function marginStandardHint(ins) {
  if (!ins) {
    return '';
  }
  var level = _marginLevel(ins);
  if (level === 'UNKNOWN') {
    return '无对照标准';
  }
  if (level === 'IN_BAND') {
    return '在目标区间内';
  }
  if (level === 'BELOW') {
    return '低于目标区间';
  }
  if (level === 'ABOVE') {
    return '高于目标区间';
  }
  return '';
}

function marginStandardShowBlock(ins) {
  if (!ins) {
    return '';
  }
  var m = marginStandardMetaLine(ins);
  var h = marginStandardHint(ins);
  return (m !== '' || h !== '') ? '1' : '';
}

/** 附加 class：dfl-blend-hero__hint--ok / --warn / --good / --muted */
function marginStandardHintMod(ins) {
  var level = _marginLevel(ins);
  if (level === 'IN_BAND') {
    return 'dfl-blend-hero__hint--ok';
  }
  if (level === 'BELOW') {
    return 'dfl-blend-hero__hint--warn';
  }
  if (level === 'ABOVE') {
    return 'dfl-blend-hero__hint--good';
  }
  return 'dfl-blend-hero__hint--muted';
}

/** 配料看板页：与 marginStandardHintMod 同级逻辑，class 前缀 dga-hero__margin-- */
function marginStandardHintModDga(ins) {
  var level = _marginLevel(ins);
  if (level === 'IN_BAND') {
    return 'dga-hero__margin--ok';
  }
  if (level === 'BELOW') {
    return 'dga-hero__margin--warn';
  }
  if (level === 'ABOVE') {
    return 'dga-hero__margin--good';
  }
  return 'dga-hero__margin--muted';
}

/**
 * 实际总利润 = 销售收入 - 实际总成本
 */
function calcActualProfit(actualRevenue, actualCostTotalAmount123) {
  var rev = parseFloat(actualRevenue);
  var cost = parseFloat(actualCostTotalAmount123);
  if (rev !== rev || cost !== cost) {
    return '—';
  }
  var profit = rev - cost;
  return profit.toFixed(2);
}

/**
 * 判断关联菜品的「单份理论」是否应使用小单位显示（而非长小数）。
 * @param {any} standardWeight - 配料的 gbDgGoodsStandardWeight
 * @param {number} recipeUsagePerPortion - 配方每份用量（如 0.18888889）
 * @param {string} unit - 配料的大单位（如 斤）
 * @param {number|string} portionAmount - 小单位用量数值（如 50）
 * @param {string} portionUnit - 小单位（如 g）
 * @returns {string} 格式化后的显示文本，如 "50g/份" 或 "0.19斤/份"
 */
function perPortionDisplay(standardWeight, recipeUsagePerPortion, unit, portionAmount, portionUnit) {
  if (standardWeight != null && standardWeight !== '' && standardWeight !== undefined) {
    var s = '' + recipeUsagePerPortion;
    var dot = s.indexOf('.');
    if (dot >= 0) {
      var decimals = s.substring(dot + 1);
      if (decimals.length > 2) {
        for (var i = 2; i < decimals.length; i++) {
          if (decimals.charAt(i) !== '0') {
            if (portionAmount != null && portionAmount !== '' && portionUnit) {
              return portionAmount + portionUnit + '';
            }
            return recipeUsagePerPortion + unit + '';
          }
        }
      }
    }
  }
  return recipeUsagePerPortion + unit + '';
}

/**
 * 每份差异 = 单份理论 − 每份实际，带符号格式化
 * @param {number} recipeUsagePerPortion - 单份理论用量
 * @param {number} actualPerPortion - 每份实际用量
 * @param {string} unit - 单位（如 斤）
 * @returns {string} 如 "+0.12斤/份" / "-0.05斤/份" / "--"
 */
function perPortionDeviation(recipeUsagePerPortion, actualPerPortion, unit) {
  if (recipeUsagePerPortion == null || actualPerPortion == null || recipeUsagePerPortion === '' || actualPerPortion === '') {
    return '--';
  }
  var dev = recipeUsagePerPortion - actualPerPortion;
  // 保留两位小数
  dev = Math.round(dev * 100) / 100;
  // 补齐两位小数（1 → 1.00, -0.5 → -0.50）
  var str = '' + dev;
  var dot = str.indexOf('.');
  if (dot < 0) str = str + '.00';
  else if (str.length - dot === 2) str = str + '0';
  if (dev > 0) return '+' + str + unit + '/份';
  return str + unit + '/份';
}

/**
 * 消耗后剩余 = 出库前剩余 − 本次消耗
 */
function remainingAfterOutbound(remainingBeforeOutbound, quantity) {
  if (remainingBeforeOutbound == null || quantity == null || remainingBeforeOutbound === '' || quantity === '') {
    return '--';
  }
  var r = parseFloat(remainingBeforeOutbound) - parseFloat(quantity);
  r = Math.round(r * 100) / 100;
  return '' + r;
}

