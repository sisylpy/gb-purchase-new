    yue  =  Number(yue);
    ri  =  Number(ri);
    dateString = yue + "月" + ri +"日"
  }
  return  dateString ;
}

/**
 * 将 yyyy-MM-dd HH:mm 转为 X月X日 HH:mm 短格式
 */
function transferDateTimeShort(datetime){
  if (datetime == null || datetime === '' || datetime === undefined) return '';
  // yyyy-MM-dd HH:mm → 截取月份、日期、时间
  var month = datetime.substring(5, 7);
  var day = datetime.substring(8, 10);
  var time = datetime.length >= 16 ? datetime.substring(11, 16) : ''; // HH:mm
  // 去除前导0
  if (month.charAt(0) === '0') month = month.charAt(1);
  if (day.charAt(0) === '0') day = day.charAt(1);
  var result = month + '月' + day + '日';
  if (time !== '') result = result + ' ' + time;
  return result;
}

function getProducePercent(a,b){
  if(b !== 0){
    var  abc = (a / b * 100).toFixed(2);
    return  abc;
  }else{
    return 0;
  }
}

function getCostTotal(a,b,c){
  var numA = +a || 0;
  var numB = +b || 0;
  var numC = +c || 0;
  var total = numA + numB + numC;
  if (isNaN(total)) {
    return '0.0';
  }
  var rounded = Math.round(total * 100) / 100;
  var str = rounded.toString();
  var dotIndex = str.indexOf('.');
  if (dotIndex === -1) {
    str = str + '.0';
  } else if (dotIndex === str.length - 2) {
    // already 1 decimal
  } else if (dotIndex === str.length - 1) {
    str = str + '0';
  }
  return str;
}

