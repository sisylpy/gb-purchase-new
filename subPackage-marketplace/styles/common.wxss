page{background:#f5f6f4;color:#172b25;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif}.page{min-height:100vh;padding-bottom:140rpx}.top-safe{height:env(safe-area-inset-top)}.nav{height:92rpx;padding:0 28rpx;display:flex;align-items:center;background:#fff;position:sticky;top:0;z-index:10}.nav-title{font-size:34rpx;font-weight:700}.back{font-size:52rpx;margin-right:24rpx}.card{margin:24rpx;background:#fff;border-radius:24rpx;padding:28rpx;box-shadow:0 8rpx 24rpx rgba(26,52,42,.06)}.empty{padding:100rpx 30rpx;text-align:center;color:#87938e}.button{height:84rpx;border-radius:42rpx;background:#79cf29;color:#173316;display:flex;align-items:center;justify-content:center;font-weight:700}.muted{color:#8a9691}.price{color:#ed3f32;font-weight:700}.pill{display:inline-flex;background:#ecf9dc;color:#579c1c;border-radius:24rpx;padding:6rpx 16rpx;font-size:22rpx}.input{height:76rpx;background:#f2f4f2;border-radius:38rpx;padding:0 28rpx;display:flex;align-items:center}.section-title{font-size:34rpx;font-weight:800;margin:32rpx 24rpx 18rpx}.row{display:flex;align-items:center}.grow{flex:1}.danger{color:#d74237}
