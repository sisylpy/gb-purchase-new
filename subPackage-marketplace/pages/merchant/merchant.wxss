@import "../../styles/common.wxss";
.merchant-page{padding-bottom:150rpx}.hero{background:linear-gradient(145deg,#c6f66f,#95dc3f);padding:18rpx 28rpx 34rpx}.hero-actions{display:flex;justify-content:space-between}.circle{width:72rpx;height:72rpx;border-radius:36rpx;background:rgba(255,255,255,.75);display:flex;align-items:center;justify-content:center;font-size:40rpx}.merchant-summary{display:flex;align-items:center;gap:22rpx;margin-top:34rpx}.hero-logo{width:112rpx;height:112rpx;border-radius:24rpx}.hero-name{font-size:40rpx;font-weight:900}.hero-intro{font-size:23rpx;color:#39532c;margin-top:10rpx}.identity-note{margin:20rpx 24rpx;background:#fff7dd;color:#765d20;padding:18rpx 22rpx;border-radius:16rpx;font-size:22rpx}.goods-search{display:flex;gap:12rpx;padding:0 24rpx}.search-button{height:76rpx;line-height:76rpx;padding:0 28rpx;border-radius:38rpx;background:#83d333}.goods-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;padding:22rpx 24rpx}.goods-card{background:#fff;border-radius:20rpx;overflow:hidden}.goods-image{width:100%;height:290rpx}.goods-image.fallback{display:flex;align-items:center;justify-content:center;background:#ecf7df;color:#69983d;font-weight:700}.goods-body{padding:18rpx}.goods-name{font-weight:800;font-size:27rpx;height:72rpx;overflow:hidden}.goods-spec{font-size:21rpx;color:#8a948f;margin-top:8rpx}.owner{font-size:20rpx;color:#5e9c2c;margin-top:9rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.goods-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:14rpx}.add{width:58rpx;height:58rpx;border-radius:29rpx;background:#9ae542;display:flex;align-items:center;justify-content:center;font-size:38rpx}.add.disabled{opacity:.5}.cart-float{position:fixed;right:26rpx;bottom:38rpx;background:#173d33;color:#fff;border-radius:42rpx;padding:22rpx 32rpx;font-weight:700;box-shadow:0 8rpx 22rpx rgba(0,0,0,.2)}
