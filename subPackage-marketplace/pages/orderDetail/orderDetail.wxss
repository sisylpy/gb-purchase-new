@import "../../styles/common.wxss";
.master-card{margin:20rpx 24rpx;padding:28rpx;border-radius:24rpx;background:linear-gradient(145deg,#cdf582,#92d944)}.status{font-size:38rpx;font-weight:900}.master-no{font-size:23rpx;margin-top:12rpx}.master-explain{font-size:22rpx;color:#3f5e28;margin-top:18rpx}.master-total{font-size:34rpx;font-weight:900;margin-top:20rpx}.pending{font-size:20rpx;background:rgba(255,255,255,.65);padding:12rpx;border-radius:10rpx;margin-top:16rpx}.child-card{margin:20rpx 24rpx;background:#fff;border-radius:22rpx;padding:24rpx}.child-head{display:flex;justify-content:space-between;align-items:center;padding-bottom:18rpx;border-bottom:1rpx solid #edf0ee}.merchant-name{font-size:29rpx;font-weight:800}.child-no{font-size:20rpx;color:#939d98;margin-top:5rpx}.line{display:flex;padding:18rpx 0;border-bottom:1rpx solid #f0f2f0;font-size:24rpx}.spec{font-size:21rpx;margin-top:5rpx}.child-total{text-align:right;padding-top:18rpx;font-weight:800}.remark{margin-top:10rpx}
