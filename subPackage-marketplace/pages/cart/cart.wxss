@import "../../styles/common.wxss";
.cart-page{padding-bottom:250rpx}.cart-explain{margin:18rpx 24rpx;padding:20rpx 22rpx;background:#edf9dc;color:#527a2b;border-radius:18rpx;font-size:22rpx}.empty-icon{font-size:80rpx;margin-bottom:18rpx}.empty-link{display:inline-block;margin-top:26rpx;color:#5ea620;font-weight:700}.cart-group{margin:20rpx 24rpx;background:#fff;border-radius:24rpx;overflow:hidden}.group-head{display:flex;align-items:center;padding:22rpx;border-bottom:1rpx solid #edf0ee}.merchant-badge{width:50rpx;height:50rpx;border-radius:16rpx;background:#e9f8d8;color:#5fa329;display:flex;align-items:center;justify-content:center;font-weight:800}.group-name{font-size:28rpx;font-weight:800;flex:1;margin-left:14rpx}.cart-line{display:flex;gap:18rpx;padding:22rpx;border-bottom:1rpx solid #f0f1f0}.line-image{width:140rpx;height:140rpx;border-radius:16rpx}.line-image.fallback{display:flex;align-items:center;justify-content:center;background:#f0f7e8;color:#6d9b48}.line-name{font-size:27rpx;font-weight:800}.line-spec{font-size:21rpx;color:#8a9490;margin:8rpx 0}.quantity{display:flex;align-items:center;align-content:flex-end;flex-wrap:wrap;width:168rpx;justify-content:flex-end}.q-button{width:48rpx;height:48rpx;border-radius:24rpx;background:#edf7e5;display:flex;align-items:center;justify-content:center}.q-number{width:58rpx;text-align:center}.remove{width:100%;text-align:right;color:#b1b7b4;font-size:21rpx;margin-top:16rpx}.summary-card{margin:20rpx 24rpx;background:#fff;border-radius:20rpx;padding:24rpx}.total{font-size:34rpx;font-weight:800;margin-top:10rpx}.pending{font-size:21rpx;color:#967b31;background:#fff7df;padding:12rpx;margin-top:16rpx;border-radius:10rpx}.checkout-bar{position:fixed;left:0;right:0;bottom:112rpx;background:#fff;padding:18rpx 24rpx;display:flex;align-items:center;box-shadow:0 -4rpx 16rpx rgba(0,0,0,.06);z-index:18}.bar-total{font-size:36rpx;color:#e84136;font-weight:800}.bar-sub{font-size:20rpx;color:#8a9490}.checkout-button{background:#80d22e;padding:22rpx 38rpx;border-radius:38rpx;font-weight:800}
