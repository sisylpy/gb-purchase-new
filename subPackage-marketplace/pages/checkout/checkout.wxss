@import "../../styles/common.wxss";
.checkout-page{padding-bottom:150rpx}.safety-notice{margin:20rpx 24rpx;background:#fff4d8;color:#72591e;padding:22rpx;border-radius:18rpx;font-size:22rpx}.notice-title{font-size:27rpx;font-weight:800;margin-bottom:8rpx}.order-group{margin:20rpx 24rpx;background:#fff;border-radius:22rpx;padding:24rpx}.order-head{font-size:29rpx;font-weight:800;padding-bottom:18rpx;border-bottom:1rpx solid #edf0ee}.order-head text{float:right;font-size:22rpx;color:#8a9490;font-weight:400}.order-line{display:flex;padding:18rpx 0;border-bottom:1rpx solid #f2f3f2;font-size:25rpx}.group-total{text-align:right;font-weight:700;padding-top:18rpx}.field-label{font-weight:800;margin-bottom:14rpx}.remark{width:100%;box-sizing:border-box;background:#f5f7f5;border-radius:14rpx;padding:18rpx;height:150rpx}.total-card{font-size:23rpx}.amount{font-size:36rpx;color:#e34035;font-weight:800;margin-top:14rpx}.amount.small{margin:0}.submit-bar{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));display:flex;align-items:center;box-shadow:0 -3rpx 16rpx rgba(0,0,0,.06)}.submit-button{background:#80d22f;border-radius:40rpx;padding:22rpx 38rpx;font-weight:800}.disabled{opacity:.55}.tiny{font-size:20rpx}
