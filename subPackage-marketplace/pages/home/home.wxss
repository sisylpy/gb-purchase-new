@import "../../styles/common.wxss";
.home-page{background:linear-gradient(180deg,#d9ff90 0,#f5f6f4 410rpx)}.home-head{padding:18rpx 30rpx 30rpx}.market-row{display:flex;align-items:center;margin:8rpx 0 24rpx}.market-dot{font-size:38rpx}.market-name{font-size:34rpx;font-weight:800;margin-left:12rpx}.search-row{display:flex;gap:14rpx}.search-input{flex:1;height:76rpx;background:#fff;border-radius:38rpx;padding:0 28rpx}.search-button{height:76rpx;line-height:76rpx;padding:0 32rpx;background:#7acb26;border-radius:38rpx;font-weight:700}.category-card{margin:0 24rpx 24rpx;background:#fff;border-radius:26rpx;padding:28rpx 16rpx 12rpx;display:flex;flex-wrap:wrap}.category-item{width:25%;display:flex;flex-direction:column;align-items:center;margin-bottom:28rpx}.category-icon,.category-icon-image{width:88rpx;height:88rpx;border-radius:28rpx}.category-icon{display:flex;align-items:center;justify-content:center;background:#eff9dd;color:#5c9d23;font-size:38rpx;font-weight:800}.category-name{font-size:25rpx;font-weight:700;margin-top:12rpx;max-width:150rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.category-count{font-size:20rpx;color:#9aa29f;margin-top:4rpx}.notice{margin:20rpx 24rpx;padding:18rpx 22rpx;border-radius:16rpx;background:#fff7dc;color:#84671b;font-size:22rpx}.section-head{display:flex;align-items:flex-end;justify-content:space-between;margin:30rpx 24rpx 18rpx}.section-title.reset{margin:0}.section-sub{font-size:22rpx;color:#909b96;margin-top:6rpx}.more{color:#5da51f;font-size:24rpx}.merchant-grid{margin:0 24rpx;display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.merchant-card{background:#fff;border-radius:22rpx;overflow:hidden}.merchant-cover{width:100%;height:210rpx}.merchant-cover.placeholder{display:flex;align-items:center;justify-content:center;background:#eaf7da;color:#68ac2a;font-size:38rpx;font-weight:800}.merchant-info{padding:20rpx}.merchant-name{font-weight:800;font-size:28rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.merchant-intro{color:#727d78;font-size:22rpx;height:62rpx;margin-top:8rpx;overflow:hidden}.merchant-meta{font-size:21rpx;color:#64a728;margin-top:12rpx}.empty.small{width:100%;padding:40rpx}
