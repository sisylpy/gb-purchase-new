@import "../../styles/common.wxss";
.detail-scroll { box-sizing: border-box; height: calc(100vh - 130rpx); padding: 22rpx; }
.section-link { align-items: center; display: flex; justify-content: space-between; }
.compact { margin-bottom: 8rpx; }
.cost-main { color: #187e6e; font-size: 48rpx; font-weight: 700; margin-bottom: 12rpx; }
.cost-main text { color: #758078; font-size: 24rpx; font-weight: 400; margin-left: 8rpx; }
.quick-grid { display: grid; gap: 14rpx; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.quick-card { align-items: center; background: #fff; border-radius: 18rpx; display: flex; flex-direction: column; font-size: 26rpx; gap: 12rpx; justify-content: center; min-height: 136rpx; }
.quick-icon { font-size: 38rpx; }
.detail-actions { display: flex; gap: 16rpx; justify-content: flex-end; padding: 24rpx 0 40rpx; }
