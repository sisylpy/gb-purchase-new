<view class="prep-page">
  <back-navbar title="中间料详情" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <view class="prep-navbar-spacer" style="height: {{navBarHeight}}rpx;"></view>
  <view class="prep-loading" wx:if="{{loading}}">正在加载…</view>
  <scroll-view wx:else scroll-y class="detail-scroll">
    <view class="prep-section summary-card">
      <view class="prep-card-head"><view class="prep-card-title">{{product.productName}}</view><text class="prep-status {{product.displayStateClass}}">{{product.displayStateLabel}}</text></view>
      <view class="summary-grid">
        <view class="summary-item"><text class="summary-label">使用单位</text><text class="summary-value">{{product.usageUnitLabel}}</text></view>
        <view class="summary-item"><text class="summary-label">标准产出</text><text class="summary-value">{{recipe.standardOutputText}}</text></view>
        <view class="summary-item"><text class="summary-label">组成原料</text><text class="summary-value">{{recipe.components.length || 0}} 种</text></view>
        <view class="summary-item"><text class="summary-label">配方状态</text><text class="summary-value">{{product.recipeStateText}}</text></view>
      </view>
      <view class="ratio-note">菜品使用本中间料时，系统按标准配方比例自动展开到底层采购原料。</view>
    </view>

    <view class="prep-section">
      <view class="section-head">
        <view><view class="prep-section-title no-margin">标准配方（{{recipe.components.length || 0}}）</view><text class="prep-muted">对应标准产出 {{recipe.standardOutputText}}</text></view>
        <view class="edit-link" bindtap="toRecipe">{{product.recipeConfigured ? '编辑' : '配置'}} ›</view>
      </view>
      <view class="prep-empty compact" wx:if="{{recipe.components.length === 0}}">尚未添加组成原料</view>
      <view class="ingredient-line" wx:for="{{visibleComponents}}" wx:key="rawGoodsId">
        <text class="ingredient-name">{{item.rawGoodsName}}</text>
        <text class="ingredient-amount">{{item.inputQuantityText}} {{item.inputUnitLabel}}</text>
        <text class="ingredient-ratio">{{item.ratioText}}</text>
      </view>
      <view class="view-all" wx:if="{{recipe.components.length > 6}}" bindtap="toRecipe">查看全部 {{recipe.components.length}} 种原料 ›</view>
    </view>

    <view class="prep-section operation-section">
      <view class="prep-section-title">制作与损耗</view>
      <view wx:if="{{canOperate}}">
        <view class="quick-grid">
          <view class="quick-card primary" bindtap="toProduction"><text>记录制作</text></view>
          <view class="quick-card" bindtap="toLoss"><text>记录损耗</text></view>
        </view>
        <view class="record-links">
          <text bindtap="toProductionRecords">查看制作记录 ›</text>
          <text bindtap="toLossRecords">查看损耗记录 ›</text>
        </view>
      </view>
      <view class="blocked-operation" wx:else>
        <text>{{blockedOperationText}}</text>
        <text class="warning-action" bindtap="handleBlockedAction">{{blockedActionText}}</text>
      </view>
    </view>

    <view class="basic-actions"><view class="prep-small-button" bindtap="toEdit">编辑基本信息</view></view>
    <view class="danger-zone"><view class="danger-button" bindtap="toggleStatus">{{product.status === 'ENABLED' ? '停用该中间料' : '重新启用'}}</view></view>
  </scroll-view>
</view>
