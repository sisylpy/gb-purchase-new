@import "../../styles/common.wxss";
.discard-scroll { height: calc(100vh - 150rpx); }
.unit-input { flex: none !important; width: 180rpx; }
.photo-box { align-items: center; background: #f7f8fa; border: 1rpx dashed #aeb5bc; border-radius: 14rpx; color: #6e7680; display: flex; height: 160rpx; justify-content: center; width: 220rpx; }
.photo-delete { margin-top: 10rpx; width: fit-content; }
.photo-warning { color: #b16b1d; font-size: 22rpx; line-height: 1.5; margin-top: 14rpx; }
