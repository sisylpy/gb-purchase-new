@import "../../styles/common.wxss";
.recipe-scroll { box-sizing: border-box; height: calc(100vh - 240rpx); padding: 18rpx 22rpx 180rpx; }
.version-tab { background: #f1f3f4; border-radius: 12rpx; display: inline-flex; flex-direction: column; margin-right: 12rpx; padding: 10rpx 22rpx; }
.version-active { background: #e3f3ef; color: #187e6e; }
.version-state { font-size: 20rpx; margin-top: 4rpx; }
.section-head, .component-head, .goods-row { align-items: center; display: flex; justify-content: space-between; }
.no-margin { margin: 0; }
.component-card { border-top: 1rpx solid #edf0f2; padding: 22rpx 0; }
.component-head { font-size: 28rpx; font-weight: 500; }
.component-inputs { margin: 16rpx 0 10rpx; }
.unit-input, .unit-box { flex: none !important; width: 210rpx; }
.delete-link { color: #d34b4b; font-size: 24rpx; }
.goods-row { border-bottom: 1rpx solid #edf0f2; min-height: 100rpx; }
.compact { min-height: 100rpx; padding: 20rpx; }
