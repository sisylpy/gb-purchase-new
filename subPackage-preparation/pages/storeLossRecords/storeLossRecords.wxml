<view class="prep-page">
  <back-navbar title="历史损耗记录" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <view class="prep-navbar-spacer" style="height: {{navBarHeight}}rpx;"></view>
  <view class="history-notice">以下为旧入口已经产生的原料损耗记录，仅供查询。当前版本不再新增中间料损耗或废弃。</view>
  <view class="prep-loading" wx:if="{{loading}}">正在加载损耗记录…</view>
  <view class="prep-empty" wx:elif="{{rows.length === 0}}"><view class="prep-empty-title">暂无历史损耗记录</view><text>当前版本不提供中间料损耗或废弃录入。</text></view>
  <scroll-view wx:else scroll-y class="records-scroll">
    <view class="prep-list-card" wx:for="{{rows}}" wx:key="rawLossRecordId"><view class="prep-card-head"><view><view class="prep-card-title">{{item.rawGoodsName}}</view><view class="prep-muted">历史关联中间料：{{item.productName}}</view></view><view class="quantity">{{item.lossQuantity}} {{item.unitLabel || item.unitCode}}</view></view><view class="record-meta"><text>{{item.reasonLabel}}</text><text>{{item.costText}}</text><text>{{item.timeText}}</text></view><view class="note" wx:if="{{item.note}}">{{item.note}}</view></view>
  </scroll-view>
</view>
