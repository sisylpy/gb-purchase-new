@import "../../styles/common.wxss";
.history-notice { background: #f5f7f6; color: #65716d; font-size: 22rpx; line-height: 1.55; margin: 18rpx 22rpx 0; padding: 16rpx 18rpx; }
.records-scroll { box-sizing: border-box; height: calc(100vh - 245rpx); padding: 18rpx 22rpx 22rpx; }
.quantity { color: #d05b42; font-size: 30rpx; font-weight: 600; }
.record-meta { color: #727a84; display: flex; flex-wrap: wrap; font-size: 23rpx; gap: 20rpx; margin-top: 18rpx; }
.note { background: #f7f8fa; border-radius: 10rpx; color: #555e67; font-size: 24rpx; line-height: 1.5; margin-top: 16rpx; padding: 14rpx; }
