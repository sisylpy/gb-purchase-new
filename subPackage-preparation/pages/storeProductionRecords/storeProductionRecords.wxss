@import "../../styles/common.wxss";
.records-scroll { box-sizing: border-box; height: calc(100vh - 130rpx); padding: 22rpx; }
.output { color: #187e6e; font-size: 28rpx; font-weight: 600; }
.record-grid { display: grid; gap: 14rpx; grid-template-columns: 1fr 1fr; margin-top: 20rpx; }
.record-grid view { background: #f6f8f7; border-radius: 12rpx; display: flex; flex-direction: column; padding: 16rpx; }
.record-grid text { color: #7b8481; font-size: 22rpx; }
.record-value { color: #26322f; font-size: 25rpx; font-weight: 600; margin-top: 8rpx; }
.record-time { margin-top: 16rpx; text-align: right; }
