<view class="prep-page">
  <back-navbar title="制作记录" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <view class="prep-navbar-spacer" style="height: {{navBarHeight}}rpx;"></view>
  <view class="prep-loading" wx:if="{{loading}}">正在加载制作记录…</view>
  <view class="prep-empty" wx:elif="{{rows.length === 0}}"><view class="prep-empty-title">暂无制作记录</view><text>记录实际制作后，这里会展示产出和冻结的实际单位成本。</text></view>
  <scroll-view wx:else scroll-y class="records-scroll">
    <view class="prep-list-card" wx:for="{{rows}}" wx:key="productionId">
      <view class="prep-card-head"><view><view class="prep-card-title">{{item.productName}}</view><view class="prep-muted">{{item.productionNo}}</view></view><view class="output">{{item.actualOutputQuantity}} {{item.outputUnitCode}}</view></view>
      <view class="record-grid"><view><text>原料总成本</text><text class="record-value">{{item.totalCostText}}</text></view><view><text>实际单位成本</text><text class="record-value">{{item.unitCostText}} / {{item.outputUnitCode}}</text></view></view>
      <view class="prep-muted record-time">{{item.timeText}}</view>
    </view>
  </scroll-view>
</view>
