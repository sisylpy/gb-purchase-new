<view class="prep-page">
  <back-navbar title="中间料" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <view class="prep-navbar-spacer" style="height: {{navBarHeight}}rpx;"></view>

  <view class="list-tools">
    <view class="search-row">
      <view class="search-box">
        <image class="search-icon" src="/images/search-3.png" mode="aspectFit"></image>
        <input class="search-input" placeholder="搜索中间料名称" placeholder-class="search-placeholder" value="{{keyword}}" bindinput="onSearch" />
      </view>
      <view class="create-button" bindtap="toCreate" hover-class="create-button-hover"><text>＋</text></view>
    </view>
    <view class="status-tabs">
      <view wx:for="{{tabs}}" wx:key="value" class="status-tab {{filter === item.value ? 'status-tab-active' : ''}}" data-value="{{item.value}}" bindtap="onTabTap">{{item.label}}</view>
    </view>
  </view>

  <view class="prep-loading" wx:if="{{loading}}">正在加载中间料…</view>
  <view class="prep-empty list-empty" wx:elif="{{filteredProducts.length === 0}}">
    <view class="prep-empty-title">{{keyword || filter ? '没有符合条件的中间料' : '还没有中间料'}}</view>
    <text>{{keyword || filter ? '请更换搜索或筛选条件。' : '先创建基本信息，然后继续配置标准配方。'}}</text>
  </view>

  <scroll-view wx:else scroll-y class="product-list">
    <view class="product-card" wx:for="{{filteredProducts}}" wx:key="id" data-id="{{item.id}}" bindtap="toDetail" hover-class="product-card-hover">
      <view class="product-card-head">
        <view class="product-name">{{item.productName}}</view>
        <view class="product-card-actions">
          <text class="prep-status {{item.displayStateClass}}">{{item.displayStateLabel}}</text>
          <text class="delete-button {{item.deletable === false ? 'delete-button-disabled' : ''}}" data-id="{{item.id}}" catchtap="deleteProduct">{{deletingId === item.id ? '删除中' : '删除'}}</text>
        </view>
      </view>
      <view class="product-meta">
        <text>{{item.ingredientCount}} 种原料 · 标准产出 {{item.standardOutputText}}</text>
      </view>
      <image class="card-arrow" src="/images/arrow-right-3.png" mode="aspectFit"></image>
      <view class="recipe-line {{item.statusSummaryClass}}">
        <text class="summary-icon">{{item.statusSummaryIcon}}</text>
        <text>{{item.statusSummaryText}}</text>
      </view>
    </view>
  </scroll-view>
</view>
