@import "../../styles/common.wxss";
.scope-wrap { padding: 80rpx 28rpx; }
.scope-card { align-items: center; background: #fff; border-radius: 18rpx; display: flex; flex-direction: column; padding: 52rpx 36rpx 40rpx; text-align: center; }
.scope-mark { align-items: center; background: #eef2f1; border-radius: 50%; color: #71807c; display: flex; font-size: 40rpx; height: 88rpx; justify-content: center; width: 88rpx; }
.scope-title { color: #26302d; font-size: 31rpx; font-weight: 600; margin-top: 26rpx; }
.scope-desc { color: #6f7875; font-size: 24rpx; line-height: 1.7; margin-top: 18rpx; }
.scope-button { margin-top: 38rpx; width: 260rpx; }
