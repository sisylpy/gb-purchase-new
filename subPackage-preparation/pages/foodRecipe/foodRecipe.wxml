<view class="prep-page">
  <back-navbar title="{{foodName || '菜品配方'}}" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <view class="prep-navbar-spacer" style="height: {{navBarHeight}}rpx;"></view>

  <view class="prep-loading" wx:if="{{loading}}">正在加载菜品配方…</view>
  <view class="prep-error" wx:elif="{{error}}">
    <text>{{error}}</text>
    <view class="prep-small-button retry-button" bindtap="retry">重新加载</view>
  </view>

  <scroll-view wx:else scroll-y class="recipe-scroll">
    <view class="prep-tip prep-tip-warning" wx:if="{{migrationMode}}">
      当前菜品仍使用旧配方。首次保存备料后，现有 {{legacyRawCount}} 项配料会完整带入新版配方，之后配料和备料统一在这里维护。
    </view>
    <view class="prep-tip prep-tip-green" wx:else>
      当前为新版菜品配方。保存时会发布新版本，原已发布版本会自动保留为历史版本。
    </view>

    <view class="prep-section" wx:if="{{version}}">
      <view class="prep-row">
        <text class="prep-label">当前编辑版本</text>
        <text class="prep-value">V{{version.versionNo}} · {{version.status}}</text>
      </view>
      <view class="prep-row">
        <text class="prep-label">配方模式</text>
        <text class="prep-value prep-success-text">{{recipeModel}}</text>
      </view>
    </view>

    <view class="prep-section">
      <view class="section-head">
        <view>
          <view class="prep-section-title no-margin">菜品组成</view>
          <text class="prep-muted">原料和已有备料品的每份用量</text>
        </view>
        <view class="section-actions">
          <view class="prep-small-button prep-small-button-secondary" bindtap="openProductPicker">添加备料</view>
          <view class="prep-small-button" bindtap="openGoodsPicker">添加配料</view>
        </view>
      </view>

      <view class="prep-empty compact" wx:if="{{components.length === 0}}">尚未添加配料或备料</view>
      <view class="component-card" wx:for="{{components}}" wx:key="_key">
        <view class="component-head">
          <view class="component-title">
            <text class="kind-tag {{item.kindClass}}">{{item.kindLabel}}</text>
            <text>{{index + 1}}. {{item.displayName}}</text>
          </view>
          <text class="delete" data-index="{{index}}" bindtap="deleteComponent">删除</text>
        </view>
        <view class="prep-inline">
          <input
            class="prep-input"
            type="digit"
            placeholder="每份用量"
            value="{{item.quantityText}}"
            data-index="{{index}}"
            bindinput="onQuantityInput"
          />
          <picker
            range="{{item.unitOptions}}"
            value="{{item.unitIndex}}"
            data-index="{{index}}"
            bindchange="onUnitChange"
          >
            <view class="prep-picker unit-picker">{{item.unitOptions[item.unitIndex]}}</view>
          </picker>
        </view>
      </view>
    </view>
    <view class="page-bottom-pad"></view>
  </scroll-view>

  <view class="prep-actions" wx:if="{{!loading && !error}}">
    <button
      class="prep-button prep-button-primary"
      loading="{{submitting}}"
      disabled="{{submitting || !dirty}}"
      bindtap="submit"
    >保存并发布配方</button>
  </view>

  <view class="prep-modal-mask" wx:if="{{showProductPicker}}" bindtap="closeProductPicker">
    <view class="prep-modal" catchtap="noop">
      <view class="prep-section-title">选择已有备料</view>
      <input
        class="prep-input"
        placeholder="搜索备料名称或编码"
        value="{{productKeyword}}"
        bindinput="onProductKeyword"
      />
      <scroll-view scroll-y class="prep-modal-list">
        <view
          class="picker-row {{item.eligible ? '' : 'picker-row-disabled'}}"
          wx:for="{{filteredProducts}}"
          wx:key="id"
          data-item="{{item}}"
          bindtap="chooseProduct"
        >
          <view>
            <view>{{item.productName}}</view>
            <view class="prep-muted">{{item.productCode || '未设置编码'}} · {{item.recipeStatusText}}</view>
          </view>
          <text class="prep-arrow">›</text>
        </view>
        <view class="prep-empty compact" wx:if="{{filteredProducts.length === 0}}">暂无可选备料品</view>
      </scroll-view>
    </view>
  </view>

  <view class="prep-modal-mask" wx:if="{{showGoodsPicker}}" bindtap="closeGoodsPicker">
    <view class="prep-modal" catchtap="noop">
      <view class="prep-section-title">选择配料</view>
      <view class="prep-inline">
        <input
          class="prep-input"
          placeholder="输入配料名称"
          value="{{goodsKeyword}}"
          bindinput="onGoodsKeyword"
          bindconfirm="searchGoods"
          confirm-type="search"
        />
        <view class="prep-small-button" bindtap="searchGoods">搜索</view>
      </view>
      <view class="prep-loading compact" wx:if="{{goodsLoading}}">搜索中…</view>
      <scroll-view wx:else scroll-y class="prep-modal-list">
        <view
          class="picker-row"
          wx:for="{{goodsResults}}"
          wx:key="gbDistributerGoodsId"
          data-item="{{item}}"
          bindtap="chooseGoods"
        >
          <view>
            <view>{{item.gbDgGoodsName}}</view>
            <view class="prep-muted">{{item.gbDgGoodsStandardname || '未标规格'}}</view>
          </view>
          <text class="prep-arrow">›</text>
        </view>
        <view class="prep-empty compact" wx:if="{{goodsResults.length === 0}}">输入名称后搜索现有配料</view>
      </scroll-view>
    </view>
  </view>
</view>
