@import "../../styles/common.wxss";

.recipe-scroll {
  box-sizing: border-box;
  height: calc(100vh - 130rpx);
  padding: 22rpx 22rpx 180rpx;
}

.section-head,
.component-head,
.component-title,
.picker-row {
  align-items: center;
  display: flex;
}

.section-head,
.component-head,
.picker-row {
  justify-content: space-between;
}

.section-head {
  gap: 18rpx;
}

.section-actions {
  align-items: center;
  display: flex;
  flex-shrink: 0;
  gap: 10rpx;
}

.prep-small-button-secondary {
  background: #e8f5f2;
  border: 1rpx solid #b9dfd6;
  color: #187e6e;
}

.no-margin {
  margin-bottom: 5rpx;
}

.component-card {
  border-top: 1rpx solid #edf0f2;
  padding: 22rpx 0;
}

.component-head {
  font-size: 28rpx;
  font-weight: 600;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.component-title {
  min-width: 0;
}

.kind-tag {
  border-radius: 999rpx;
  flex-shrink: 0;
  font-size: 21rpx;
  font-weight: 500;
  margin-right: 10rpx;
  padding: 4rpx 12rpx;
}

.kind-raw {
  background: #eef2f5;
  color: #64707c;
}

.kind-preparation {
  background: #e8f5f2;
  color: #187e6e;
}

.delete {
  color: #d94b4b;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 400;
}

.unit-picker {
  min-width: 140rpx;
}

.picker-row {
  border-bottom: 1rpx solid #edf0f2;
  gap: 18rpx;
  min-height: 104rpx;
}

.picker-row-disabled {
  color: #9ea4aa;
  opacity: 0.7;
}

.compact {
  min-height: 150rpx;
  padding: 30rpx;
}

.retry-button {
  margin-top: 24rpx;
}

.page-bottom-pad {
  height: 40rpx;
}
