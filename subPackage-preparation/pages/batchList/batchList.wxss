@import "../../styles/common.wxss";
.batch-list { box-sizing: border-box; height: calc(100vh - 350rpx); padding: 16rpx 22rpx 150rpx; }
.batch-no { color: #7f8790; font-size: 24rpx; margin-top: 7rpx; }
.batch-bottom { align-items: center; border-top: 1rpx solid #edf0f2; display: flex; justify-content: space-between; margin-top: 16rpx; padding-top: 16rpx; }
.batch-bottom > view { display: flex; flex-direction: column; gap: 4rpx; }
.draft-note { color: #a1651b; font-size: 23rpx; margin-top: 14rpx; }
