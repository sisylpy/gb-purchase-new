<view class="prep-page">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="备料损耗分析" show-back="{{true}}" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <view class="prep-loading" wx:if="{{loading}}">正在加载中间制品…</view>
  <scroll-view wx:else scroll-y class="loss-scroll">
    <view class="prep-section"><view class="prep-form-row"><text class="prep-form-label prep-required">中间制品</text><picker range="{{products}}" range-key="productName" value="{{productIndex < 0 ? 0 : productIndex}}" bindchange="onProductChange"><view class="prep-picker {{productIndex < 0 ? 'prep-placeholder' : ''}}">{{productIndex < 0 ? '请选择中间制品' : products[productIndex].productName}}</view></picker></view><view class="prep-form-row"><text class="prep-form-label prep-required">分析期间</text><view class="prep-inline"><picker mode="date" value="{{startDate}}" bindchange="onStartDate"><view class="prep-picker">{{startDate}}</view></picker><text>至</text><picker mode="date" value="{{endDate}}" bindchange="onEndDate"><view class="prep-picker">{{endDate}}</view></picker></view></view><button class="prep-button prep-button-primary analyze-button" disabled="{{analyzing}}" bindtap="analyze">{{analyzing ? '分析中…' : '查看损耗分析'}}</button></view>
    <block wx:if="{{analysis}}">
      <view class="loss-card process"><view class="loss-head"><view><view class="loss-title">加工损耗分析</view><view class="loss-sub">只用于分析 · 已被单位成本吸收</view></view><view class="loss-amount">{{analysis.processAmountText}}</view></view><view class="prep-row"><text class="prep-label">分析数量</text><text class="prep-value">{{analysis.processQuantityText}} {{analysis.baseUnitCode}}</text></view><view class="prep-tip">加工损耗不再次计入菜品成本。</view></view>
      <view class="loss-card discard"><view class="loss-head"><view><view class="loss-title">实际废弃</view><view class="loss-sub">真实废弃成本 · 归属备料部门</view></view><view class="loss-amount">{{analysis.discardCostText}}</view></view><view class="prep-row"><text class="prep-label">实际废弃数量</text><text class="prep-value">{{analysis.discardQuantityText}} {{analysis.baseUnitCode}}</text></view><view class="prep-tip">实际废弃不分摊到某一道菜。</view><view class="reason-row" wx:for="{{analysis.reasons}}" wx:key="reasonCode"><text>{{item.label}}</text><text>{{item.discardedQuantity}} {{analysis.baseUnitCode}} · {{item.costText}}</text></view></view>
      <view class="prep-section"><view class="prep-section-title">生产与守恒</view><view class="prep-row"><text class="prep-label">完成批次数</text><text class="prep-value">{{analysis.producedBatchCount}}</text></view><view class="prep-row"><text class="prep-label">生产成本</text><text class="prep-value">{{analysis.productionCostText}}</text></view><view class="prep-row"><text class="prep-label">使用成本</text><text class="prep-value">{{analysis.usedCostText}}</text></view><view class="prep-row"><text class="prep-label">剩余成本</text><text class="prep-value">{{analysis.remainingCostText}}</text></view><view class="prep-row"><text class="prep-label">数量守恒</text><text class="prep-value">{{analysis.quantityBalanced ? '守恒' : '不守恒（差异 ' + analysis.quantityDifference + '）'}}</text></view><view class="prep-row"><text class="prep-label">成本守恒</text><text class="prep-value">{{analysis.costBalanced ? '守恒' : '不守恒（差异 ' + analysis.costDifference + '）'}}</text></view></view>
    </block>
  </scroll-view>
</view>
