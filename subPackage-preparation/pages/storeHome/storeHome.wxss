@import "../../styles/common.wxss";

.store-home-scroll { box-sizing: border-box; height: calc(100vh - 130rpx); padding: 22rpx 22rpx 60rpx; }
.mode-tip { background: #eaf6f2; border-radius: 16rpx; color: #256f64; font-size: 24rpx; line-height: 1.6; padding: 20rpx; }
.stats-grid { display: grid; gap: 14rpx; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 20rpx 0; }
.stat-card { background: #fff; border-radius: 18rpx; display: flex; flex-direction: column; min-height: 124rpx; padding: 22rpx; }
.stat-value { color: #187e6e; font-size: 42rpx; font-weight: 700; }
.stat-value.money { font-size: 34rpx; }
.stat-label { color: #727a84; font-size: 24rpx; margin-top: 10rpx; }
.action-section { margin-bottom: 0; }
.action-grid { display: grid; gap: 14rpx; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.action-item { align-items: center; background: #f6f8f8; border-radius: 16rpx; display: flex; flex-direction: column; font-size: 27rpx; gap: 10rpx; justify-content: center; min-height: 142rpx; }
.action-item.primary { background: #187e6e; color: #fff; }
.action-icon { font-size: 40rpx; }
.retry { margin-top: 24rpx; }
