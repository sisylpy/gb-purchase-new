<view class="prep-page">
  <back-navbar title="门店备料" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <view class="prep-navbar-spacer" style="height: {{navBarHeight}}rpx;"></view>

  <view class="prep-loading" wx:if="{{loading && !stats}}">正在加载备料数据…</view>
  <view class="prep-error" wx:elif="{{error}}">
    <view class="prep-empty-title">暂时无法进入</view>
    <text>{{error}}</text>
    <view class="prep-small-button retry" bindtap="loadHome">重新加载</view>
  </view>

  <scroll-view wx:else scroll-y class="store-home-scroll">
    <view class="mode-tip">普通门店备料不产生生产批次。制作时仍会真实扣减原料并形成备料参考成本。</view>
    <view class="stats-grid">
      <view class="stat-card"><text class="stat-value">{{stats.productCount || 0}}</text><text class="stat-label">备料品</text></view>
      <view class="stat-card"><text class="stat-value">{{stats.enabledRecipeCount || 0}}</text><text class="stat-label">已启用配方</text></view>
      <view class="stat-card"><text class="stat-value money">{{stats.todayLossText}}</text><text class="stat-label">今日原料损耗</text></view>
      <view class="stat-card"><text class="stat-value money">{{stats.monthLossText}}</text><text class="stat-label">本月原料损耗</text></view>
    </view>
    <view class="prep-section action-section">
      <view class="prep-section-title">常用操作</view>
      <view class="action-grid">
        <view class="action-item primary" data-target="create" bindtap="go"><text class="action-icon">＋</text><text>新增备料</text></view>
        <view class="action-item" data-target="products" bindtap="go"><text class="action-icon">🥣</text><text>备料品</text></view>
        <view class="action-item primary-soft" data-target="production" bindtap="go"><text class="action-icon">✓</text><text>记录制作</text></view>
        <view class="action-item" data-target="loss" bindtap="go"><text class="action-icon">✎</text><text>记录损耗</text></view>
        <view class="action-item" data-target="records" bindtap="go"><text class="action-icon">📋</text><text>损耗记录</text></view>
      </view>
    </view>
  </scroll-view>
</view>
