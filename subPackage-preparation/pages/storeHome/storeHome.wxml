<view class="prep-page">
  <back-navbar title="门店中间料" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <view class="prep-navbar-spacer" style="height: {{navBarHeight}}rpx;"></view>

  <view class="prep-loading" wx:if="{{loading && !stats}}">正在加载中间料数据…</view>
  <view class="prep-error" wx:elif="{{error}}">
    <view class="prep-empty-title">暂时无法进入</view>
    <text>{{error}}</text>
    <view class="prep-small-button retry" bindtap="loadHome">重新加载</view>
  </view>

  <scroll-view wx:else scroll-y class="store-home-scroll">
    <view class="mode-tip">中间料只维护标准配比；实际制作会扣减原料库存，菜品经营成本按期间采购原料统一核算。</view>
    <view class="stats-grid">
      <view class="stat-card"><text class="stat-value">{{stats.productCount || 0}}</text><text class="stat-label">中间料</text></view>
      <view class="stat-card"><text class="stat-value">{{stats.enabledRecipeCount || 0}}</text><text class="stat-label">已启用配方</text></view>
    </view>
    <view class="prep-section action-section">
      <view class="prep-section-title">常用操作</view>
      <view class="action-grid">
        <view class="action-item primary" data-target="create" bindtap="go"><text class="action-icon">＋</text><text>新建中间料</text></view>
        <view class="action-item" data-target="products" bindtap="go"><text class="action-icon">料</text><text>中间料</text></view>
      </view>
    </view>
  </scroll-view>
</view>
