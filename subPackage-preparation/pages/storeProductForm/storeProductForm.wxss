@import "../../styles/common.wxss";
.form-scroll { height: calc(100vh - 130rpx); }
.switch-row { align-items: center; display: flex; justify-content: space-between; }
.switch-row > view { display: flex; flex: 1; flex-direction: column; }
.flow-tip { background: #eaf6f2; border-radius: 18rpx; display: flex; flex-direction: column; margin-bottom: 18rpx; padding: 24rpx; }
.flow-step { color: #187e6e; font-size: 23rpx; font-weight: 600; }
.flow-title { color: #20332f; font-size: 31rpx; font-weight: 650; margin-top: 8rpx; }
.flow-desc, .field-help { color: #7a8481; display: block; font-size: 23rpx; line-height: 1.6; margin-top: 12rpx; }
