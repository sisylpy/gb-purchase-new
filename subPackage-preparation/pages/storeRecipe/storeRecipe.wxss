@import "../../styles/common.wxss";
.recipe-scroll { box-sizing: border-box; height: calc(100vh - 130rpx); padding: 22rpx 22rpx 170rpx; }
.section-head, .component-head, .goods-row { align-items: center; display: flex; justify-content: space-between; }
.no-margin { margin-bottom: 5rpx; }
.component-card { border-top: 1rpx solid #edf0f2; padding: 22rpx 0; }
.component-head { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.delete { color: #d94b4b; font-size: 24rpx; font-weight: 400; }
.unit-picker { min-width: 130rpx; }
.goods-row { border-bottom: 1rpx solid #edf0f2; min-height: 100rpx; }
.compact { min-height: 150rpx; padding: 30rpx; }
