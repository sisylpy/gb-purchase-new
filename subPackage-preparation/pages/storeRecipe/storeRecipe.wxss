@import "../../styles/common.wxss";

.prep-page { height: 100vh; }
.recipe-scroll { box-sizing: border-box; height: calc(100vh - 130rpx); padding: 18rpx 14rpx 180rpx; }
.recipe-name { color: #171c20; font-size: 40rpx; font-weight: 700; line-height: 1.35; padding: 2rpx 10rpx 23rpx; text-align: center; }

.output-row { align-items: center; display: flex; justify-content: space-between; padding: 0 10rpx 15rpx; }
.output-label { align-items: center; color: #20262b; display: flex; font-size: 28rpx; font-weight: 600; }
.info-icon { align-items: center; border: 1rpx solid #9ca4a8; border-radius: 50%; color: #81898e; display: inline-flex; font-size: 19rpx; font-weight: 500; height: 27rpx; justify-content: center; margin-left: 13rpx; width: 27rpx; }
.output-control { align-items: center; border: 1rpx solid #dae5e1; border-radius: 9rpx; display: flex; height: 64rpx; overflow: hidden; }
.output-input { background: #fff; box-sizing: border-box; color: #151a1e; font-size: 34rpx; font-weight: 500; height: 64rpx; min-height: 64rpx; padding: 0 15rpx; text-align: center; width: 155rpx; }
.output-unit { align-items: center; background: #eff6f3; border-left: 1rpx solid #dce7e3; color: #68726e; display: flex; font-size: 24rpx; height: 64rpx; justify-content: center; min-width: 72rpx; padding: 0 12rpx; }
.recipe-hint { align-items: center; background: #eef7f4; border-radius: 8rpx; color: #168573; display: flex; font-size: 23rpx; line-height: 1.5; margin-bottom: 17rpx; padding: 12rpx 20rpx; }
.hint-dot { background: #1dbd96; border-radius: 50%; flex-shrink: 0; height: 12rpx; margin-right: 13rpx; width: 12rpx; }

.ingredient-panel { background: #fff; border-radius: 16rpx; box-sizing: border-box; padding: 17rpx 13rpx 5rpx; }
.ingredient-head, .goods-row, .selected-goods, .modal-head { align-items: center; display: flex; justify-content: space-between; }
.ingredient-head { padding: 0 5rpx 15rpx; }
.ingredient-title { color: #1c2226; font-size: 30rpx; font-weight: 600; }
.add-ingredient { background: #edf7f4; border-radius: 999rpx; color: #138b76; font-size: 25rpx; font-weight: 500; padding: 10rpx 19rpx; }
.component-table { border-top: 1rpx solid #e9ecee; }
.component-table-head, .component-row { align-items: center; display: grid; grid-template-columns: minmax(250rpx, 1.55fr) minmax(210rpx, 1.25fr) 90rpx 40rpx; }
.component-table-head { color: #7d858b; font-size: 20rpx; height: 48rpx; }
.component-table-head text:first-child { padding-left: 13rpx; }
.component-table-head text:not(:first-child) { text-align: center; }
.component-row { border-top: 1rpx solid #eceff0; box-sizing: border-box; min-height: 90rpx; padding: 9rpx 0; }
.component-material { align-items: center; display: flex; min-width: 0; }
.component-index { color: #767f84; flex-shrink: 0; font-size: 21rpx; margin-right: 6rpx; text-align: center; width: 20rpx; }
.component-image { background: #eef1f1; border-radius: 7rpx; flex-shrink: 0; height: 62rpx; margin-right: 11rpx; width: 62rpx; }
.component-placeholder { align-items: center; color: #8b9491; display: flex; font-size: 22rpx; justify-content: center; }
.component-info { display: flex; flex-direction: column; min-width: 0; }
.component-name { color: #20262a; font-size: 24rpx; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.component-spec { color: #8c9499; font-size: 19rpx; margin-top: 5rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.quantity-cell { align-items: center; display: flex; justify-content: center; min-width: 0; }
.quantity-stepper { align-items: center; border: 1rpx solid #dfe4e5; border-radius: 7rpx; display: flex; height: 48rpx; overflow: hidden; }
.quantity-button { align-items: center; background: #fff; color: #0f8b75; display: flex; flex-shrink: 0; font-size: 29rpx; height: 48rpx; justify-content: center; width: 43rpx; }
.quantity-button.minus { border-right: 1rpx solid #e3e7e8; color: #6e777b; }
.quantity-button.plus { border-left: 1rpx solid #e3e7e8; }
.quantity-input { box-sizing: border-box; color: #1c2226; font-size: 26rpx; height: 48rpx; min-height: 48rpx; padding: 0 4rpx; text-align: center; width: 65rpx; }
.row-unit { color: #68716e; font-size: 20rpx; margin-left: 7rpx; min-width: 42rpx; padding: 12rpx 0; text-align: center; }
.component-rate { color: #20262a; font-size: 22rpx; text-align: center; }
.delete { align-items: center; border: 1rpx solid #b9c0c3; border-radius: 50%; color: #8d9599; display: flex; font-size: 26rpx; height: 28rpx; justify-content: center; line-height: 1; margin: auto; width: 28rpx; }

.input-summary { background: #fff; border: 1rpx solid #e1e5e6; border-radius: 13rpx; margin-top: 14rpx; padding: 13rpx 17rpx 0; }
.summary-values { display: grid; grid-template-columns: repeat(3, 1fr); }
.summary-cell { align-items: center; display: flex; flex-direction: column; min-width: 0; padding: 0 8rpx 14rpx; }
.summary-cell + .summary-cell { border-left: 1rpx solid #e6e9ea; }
.summary-label { color: #343b3f; font-size: 22rpx; }
.summary-value { color: #20262a; font-size: 28rpx; margin-top: 8rpx; }
.summary-value.primary { color: #138a74; }
.summary-value.warning { color: #ee6b2d; }
.summary-warning { align-items: center; border-top: 1rpx solid #e9ecee; color: #5c6367; display: flex; font-size: 21rpx; line-height: 1.45; padding: 12rpx 4rpx 14rpx; }
.summary-warning.muted { color: #8a9296; }
.warning-triangle { color: #f07a39; font-size: 20rpx; margin-right: 11rpx; }
.save-hint { color: #7b8581; font-size: 20rpx; padding: 15rpx 12rpx 6rpx; text-align: right; }
.recipe-actions { padding: 13rpx 16rpx calc(13rpx + env(safe-area-inset-bottom)); }
.recipe-actions .prep-button { border-radius: 8rpx; min-height: 72rpx; }

.ingredient-picker-mask { align-items: center; background: rgba(0,0,0,.46); bottom: 0; box-sizing: border-box; display: flex; justify-content: center; left: 0; padding: 30rpx; position: fixed; right: 0; top: 0; z-index: 100; }
.ingredient-dialog { background: #fff; border-radius: 18rpx; box-shadow: 0 20rpx 60rpx rgba(0,0,0,.22); display: flex; flex-direction: column; max-height: 86vh; overflow: hidden; width: 100%; }
.ingredient-dialog-head { background: #168b78; color: #fff; flex-shrink: 0; font-size: 31rpx; font-weight: 600; line-height: 1.4; padding: 24rpx 28rpx; }
.ingredient-dialog-scroll { box-sizing: border-box; flex: 1; max-height: calc(86vh - 190rpx); min-height: 0; padding: 0 24rpx 12rpx; }
.raw-add-modal__search { align-items: center; background: #f5f6f8; border: 1rpx solid #eee; border-radius: 12rpx; display: flex; height: 72rpx; margin: 16rpx 0 20rpx; padding: 0 20rpx; }
.raw-add-modal__search-icon { flex-shrink: 0; height: 32rpx; margin-right: 12rpx; opacity: .45; width: 32rpx; }
.raw-add-modal__search-input { color: #333; flex: 1; font-size: 28rpx; height: 72rpx; min-width: 0; }
.raw-add-modal__search-clear { align-items: center; color: #999; display: flex; font-size: 36rpx; height: 44rpx; justify-content: center; width: 44rpx; }
.dialog-loading, .dialog-no-result { color: #8a9290; flex-shrink: 0; font-size: 24rpx; padding: 31rpx 0; text-align: center; }
.dialog-results { border-top: 1rpx solid #edf0ef; margin-top: 14rpx; max-height: 430rpx; min-height: 95rpx; }
.food-raw-search-row { align-items: center; border-bottom: 1rpx solid #eee; display: flex; padding: 20rpx 16rpx 20rpx 20rpx; }
.food-raw-search-row__idx { color: #333; flex-shrink: 0; font-size: 29rpx; margin-right: 12rpx; width: 38rpx; }
.food-raw-search-row__content { flex: 1; min-width: 0; }
.food-raw-search-row__line { align-items: center; display: flex; flex-wrap: wrap; font-size: 29rpx; }
.food-raw-search-row__name { color: #333; }
.food-raw-search-row__spec { color: #777; font-size: 24rpx; margin-left: 4rpx; }
.food-raw-search-row__price { color: #777; font-size: 23rpx; margin-top: 6rpx; }
.food-raw-search-row__select-btn { background: rgba(24,126,110,.08); border: 1rpx solid #187e6e; border-radius: 999rpx; color: #187e6e; flex-shrink: 0; font-size: 25rpx; margin-left: 12rpx; padding: 10rpx 24rpx; }
.raw-add-modal__picked { align-items: center; background: #fff; border: 2rpx solid #187e6e; border-radius: 16rpx; display: flex; margin: 20rpx 0; padding: 20rpx; position: relative; }
.raw-add-modal__picked-check { background: #187e6e; border-radius: 50%; color: #fff; font-size: 22rpx; height: 36rpx; left: 12rpx; line-height: 36rpx; position: absolute; text-align: center; top: 12rpx; width: 36rpx; z-index: 1; }
.raw-add-modal__picked-img { background: #f0f0f0; border-radius: 12rpx; flex-shrink: 0; height: 96rpx; margin: 0 16rpx 0 8rpx; width: 96rpx; }
.raw-add-modal__picked-placeholder { align-items: center; color: #8b9491; display: flex; justify-content: center; }
.raw-add-modal__picked-info { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.raw-add-modal__picked-name { color: #333; font-size: 30rpx; font-weight: 600; }
.raw-add-modal__picked-spec { color: #666; font-size: 24rpx; margin-top: 6rpx; }
.raw-add-modal__picked-price { color: #187e6e; font-size: 26rpx; font-weight: 500; margin-top: 6rpx; }
.raw-add-modal__form { margin-bottom: 20rpx; }
.raw-add-modal__row { align-items: center; border-bottom: 1rpx solid #f0f0f0; display: flex; padding: 22rpx 0; }
.raw-add-modal__row--link { border-radius: 12rpx; }
.raw-add-modal__row--warning { background: #fff8f2; padding-left: 12rpx; padding-right: 12rpx; }
.raw-add-modal__row--picker { border-bottom: 0; padding-bottom: 8rpx; }
.raw-add-modal__row--conversion { align-items: flex-start; }
.raw-add-modal__label { color: #333; flex-shrink: 0; font-size: 28rpx; width: 160rpx; }
.raw-add-modal__value { color: #666; flex: 1; font-size: 28rpx; min-width: 0; text-align: right; }
.raw-add-modal__value--price { color: #187e6e; font-weight: 500; }
.raw-add-modal__value--warning { color: #d96b17; font-weight: 600; }
.raw-add-modal__arrow { color: #ccc; flex-shrink: 0; font-size: 32rpx; margin-left: 8rpx; }
.raw-add-modal__price-note { color: #999; display: block; font-size: 22rpx; line-height: 1.5; margin: -8rpx 0 10rpx 160rpx; }
.raw-add-modal__dosage { align-items: center; display: flex; flex: 1; justify-content: flex-end; min-width: 0; }
.raw-add-modal__stepper { align-items: center; display: flex; margin-right: 16rpx; }
.raw-add-modal__step-btn { align-items: center; background: rgba(24,126,110,.08); border-radius: 10rpx; color: #187e6e; display: flex; font-size: 32rpx; height: 56rpx; justify-content: center; width: 56rpx; }
.raw-add-modal__step-input { background: #f5f6f8; border-radius: 10rpx; color: #333; font-size: 30rpx; font-weight: 600; height: 56rpx; margin: 0 8rpx; text-align: center; width: 88rpx; }
.raw-add-modal__unit-pick { align-items: center; background: #f5f6f8; border: 1rpx solid #eee; border-radius: 10rpx; color: #333; display: flex; font-size: 28rpx; min-width: 100rpx; padding: 12rpx 20rpx; }
.raw-add-modal__unit-pick--wide { flex: 1; justify-content: space-between; }
.raw-add-modal__unit-arrow { color: #999; font-size: 22rpx; margin-left: 8rpx; }
.raw-add-modal__hint { color: #999; display: block; font-size: 22rpx; line-height: 1.45; padding: 0 0 16rpx 160rpx; }
.raw-add-modal__required { color: #e74c3c; margin-left: 4rpx; }
.raw-add-modal__conversion-col { align-items: flex-end; display: flex; flex: 1; flex-direction: column; min-width: 0; }
.raw-add-modal__conversion-edit { align-items: center; display: flex; flex-wrap: wrap; justify-content: flex-end; min-width: 0; }
.raw-add-modal__conversion-prefix, .raw-add-modal__conversion-suffix { color: #187e6e; font-size: 28rpx; font-weight: 500; }
.raw-add-modal__conversion-input { background: #fff; border: 1rpx solid #187e6e; border-radius: 10rpx; color: #333; font-size: 30rpx; font-weight: 600; height: 56rpx; margin: 0 12rpx; text-align: center; width: 120rpx; }
.raw-add-modal__conversion-edit--warn .raw-add-modal__conversion-input { border-color: #e74c3c; }
.raw-add-modal__conversion-warn { color: #e74c3c; font-size: 22rpx; line-height: 1.4; margin-top: 6rpx; text-align: right; }
.raw-add-modal__conversion-sub { color: #999; font-size: 22rpx; margin-top: 6rpx; text-align: right; }
.raw-add-modal__summary { background: #f5f6f8; border-radius: 16rpx; margin-bottom: 20rpx; padding: 24rpx 20rpx; }
.raw-add-modal__summary-top { align-items: stretch; display: flex; }
.raw-add-modal__summary-cell { align-items: flex-start; display: flex; flex: 1; min-width: 0; }
.raw-add-modal__summary-icon { flex-shrink: 0; font-size: 28rpx; line-height: 1.3; margin-right: 10rpx; }
.raw-add-modal__summary-text { display: flex; flex-direction: column; min-width: 0; }
.raw-add-modal__summary-label { color: #666; font-size: 22rpx; line-height: 1.4; }
.raw-add-modal__summary-num { color: #187e6e; font-size: 34rpx; font-weight: 700; margin-top: 6rpx; }
.raw-add-modal__summary-divider { background: #ddd; margin: 0 16rpx; width: 1rpx; }
.raw-add-modal__summary-demo { border-top: 1rpx dashed #ddd; color: #666; font-size: 24rpx; line-height: 1.5; margin-top: 20rpx; padding-top: 20rpx; }
.raw-add-modal__summary-tip { align-items: center; color: #999; display: flex; font-size: 22rpx; margin-top: 16rpx; }
.raw-add-modal__summary-tip-i { align-items: center; border: 1rpx solid #ccc; border-radius: 50%; display: flex; flex-shrink: 0; font-family: serif; font-size: 18rpx; height: 28rpx; justify-content: center; margin-right: 8rpx; width: 28rpx; }
.raw-add-modal__quick { align-items: center; display: flex; flex-wrap: wrap; margin-bottom: 12rpx; }
.raw-add-modal__quick-label { color: #666; flex-shrink: 0; font-size: 26rpx; margin-right: 16rpx; }
.raw-add-modal__quick-tags { display: flex; flex: 1; flex-wrap: wrap; }
.raw-add-modal__quick-tag { background: #fff; border: 1rpx solid #ddd; border-radius: 999rpx; color: #666; font-size: 26rpx; margin: 0 12rpx 8rpx 0; padding: 10rpx 24rpx; }
.raw-add-modal__quick-tag.is-active { background: rgba(24,126,110,.06); border-color: #187e6e; color: #187e6e; }
.ingredient-dialog-footer { border-top: 1rpx solid #ecefef; display: flex; flex-shrink: 0; gap: 28rpx; padding: 16rpx 22rpx 22rpx; }
.dialog-cancel, .dialog-confirm { align-items: center; border-radius: 11rpx; display: flex; flex: 1; font-size: 27rpx; height: 68rpx; justify-content: center; }
.dialog-cancel { background: #f0f1f2; color: #5e6764; }
.dialog-confirm { background: #168b78; color: #fff; font-weight: 500; }
.compact { min-height: 88rpx; padding: 20rpx; }

/* 本页统一使用较大的小程序阅读字号，保留标题、正文、辅助信息三级层级。 */
.prep-loading,
.prep-empty.compact { font-size: 28rpx; }

.recipe-name { font-size: 42rpx; }
.output-label { font-size: 32rpx; }
.info-icon { font-size: 21rpx; height: 30rpx; width: 30rpx; }
.output-input { font-size: 36rpx; }
.output-unit { font-size: 28rpx; }
.recipe-hint { font-size: 27rpx; }

.ingredient-title { font-size: 34rpx; }
.add-ingredient { font-size: 29rpx; }
.component-table-head { font-size: 24rpx; }
.component-row { min-height: 100rpx; }
.component-index { font-size: 24rpx; }
.component-placeholder { font-size: 25rpx; }
.component-name { font-size: 28rpx; }
.component-spec { font-size: 23rpx; }
.quantity-stepper,
.quantity-button,
.quantity-input { height: 54rpx; }
.quantity-button { font-size: 32rpx; }
.quantity-input { font-size: 30rpx; min-height: 54rpx; }
.row-unit { font-size: 24rpx; }
.component-rate { font-size: 25rpx; }
.delete { font-size: 28rpx; height: 32rpx; width: 32rpx; }

.summary-label { font-size: 25rpx; }
.summary-value { font-size: 32rpx; }
.summary-warning { font-size: 24rpx; }
.warning-triangle { font-size: 23rpx; }
.save-hint { font-size: 23rpx; }
.recipe-actions .prep-button { font-size: 32rpx; }

.ingredient-dialog-head { font-size: 35rpx; }
.dialog-loading,
.dialog-no-result { font-size: 27rpx; }
.dialog-cancel,
.dialog-confirm { font-size: 31rpx; height: 74rpx; }
