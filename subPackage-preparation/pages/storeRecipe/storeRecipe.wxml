<view class="prep-page">
  <back-navbar title="标准配方" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <view class="prep-navbar-spacer" style="height: {{navBarHeight}}rpx;"></view>
  <view class="prep-loading" wx:if="{{loading}}">正在加载配方…</view>
  <scroll-view wx:else scroll-y class="recipe-scroll">
    <view class="recipe-name">{{productName}}</view>

    <view class="output-row">
      <view class="output-label"><text>标准产出</text><text class="info-icon">i</text></view>
      <view class="output-control"><input class="output-input" type="digit" placeholder="500" value="{{standardOutputQuantity}}" bindinput="onStandardOutputInput" /><view class="output-unit">{{usageUnitLabel}}</view></view>
    </view>
    <view class="recipe-hint"><text class="hint-dot"></text><text>以下所有投料量，均对应制作 {{standardOutputQuantity || '—'}} {{usageUnitLabel}}{{productName}}</text></view>

    <view class="ingredient-panel">
      <view class="ingredient-head"><view class="ingredient-title">组成原料（{{components.length}}）</view><view class="add-ingredient" bindtap="openGoodsPicker">＋ 添加原料</view></view>
      <view class="prep-empty compact" wx:if="{{components.length === 0}}">还没有组成原料，请从已有采购原料中添加。</view>
      <view class="component-table" wx:else>
        <view class="component-table-head"><text>原料</text><text>标准投料量</text><text>配比</text><text></text></view>
        <view class="component-row" wx:for="{{components}}" wx:key="rawGoodsId">
          <view class="component-material">
            <text class="component-index">{{index + 1}}</text>
            <image wx:if="{{item.imageUrl}}" class="component-image" src="{{item.imageUrl}}" mode="aspectFill"></image>
            <view wx:else class="component-image component-placeholder">原</view>
            <view class="component-info"><text class="component-name">{{item.rawGoodsName}}</text><text class="component-spec">{{item.specText}}</text></view>
          </view>
          <view class="quantity-cell">
            <view class="quantity-stepper">
              <view class="quantity-button minus" data-index="{{index}}" data-direction="-1" bindtap="stepComponentQuantity">−</view>
              <input class="quantity-input" type="digit" value="{{item.quantityText}}" data-index="{{index}}" bindinput="onQuantityInput" />
              <view class="quantity-button plus" data-index="{{index}}" data-direction="1" bindtap="stepComponentQuantity">＋</view>
            </view>
            <picker range="{{unitNames}}" value="{{item.unitIndex}}" data-index="{{index}}" bindchange="onUnitChange"><view class="row-unit">{{unitNames[item.unitIndex]}}</view></picker>
          </view>
          <text class="component-rate">{{item.ratioText}}</text>
          <view class="delete" data-index="{{index}}" bindtap="deleteComponent">×</view>
        </view>
      </view>
    </view>

    <view class="input-summary">
      <view class="summary-values">
        <view class="summary-cell"><text class="summary-label">当前总投料量</text><text class="summary-value primary">{{totalInputText}}</text></view>
        <view class="summary-cell"><text class="summary-label">标准产出</text><text class="summary-value">{{standardOutputQuantity || '—'}} {{usageUnitLabel}}</text></view>
        <view class="summary-cell"><text class="summary-label">投料 / 产出比</text><text class="summary-value {{inputOutputWarning ? 'warning' : 'primary'}}">{{inputOutputRateText}}</text></view>
      </view>
      <view class="summary-warning" wx:if="{{inputOutputWarning}}"><text class="warning-triangle">▲</text><text>当前总投料量高于标准产出，请确认是否存在正常加工损耗</text></view>
      <view class="summary-warning muted" wx:elif="{{inputOutputRateValue === null}}">不同计量维度无法直接汇总投料与产出比例</view>
    </view>

    <view class="save-hint" wx:if="{{hasUnsavedChanges}}">配比已更新，保存后将用于菜品原料展开</view>
  </scroll-view>

  <view class="prep-actions recipe-actions"><button class="prep-button prep-button-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">保存配方</button></view>

  <view class="ingredient-picker-mask" wx:if="{{showGoodsPicker}}" bindtap="closeGoodsPicker" catchtouchmove="noop">
    <view class="ingredient-dialog" catchtap="noop">
      <view class="ingredient-dialog-head">添加原料</view>
      <scroll-view scroll-y class="ingredient-dialog-scroll" bindscroll="dismissKeyboard">
        <view class="raw-add-modal__search">
          <image class="raw-add-modal__search-icon" src="/images/search-3.png" mode="aspectFit"></image>
          <input class="raw-add-modal__search-input" placeholder="搜索商品名称、简拼或全拼" placeholder-style="color:#999;font-size:28rpx;" adjust-position="{{false}}" value="{{goodsKeyword}}" bindinput="onGoodsKeyword" bindconfirm="searchGoods" confirm-type="search" />
          <view class="raw-add-modal__search-clear" wx:if="{{goodsKeyword}}" bindtap="clearGoodsKeyword">×</view>
        </view>

        <view class="dialog-loading" wx:if="{{goodsLoading}}">正在搜索原料…</view>
        <view wx:elif="{{goodsSearchActive && goodsResults.length}}" class="dialog-results">
          <view class="food-raw-search-row" wx:for="{{goodsResults}}" wx:key="gbDistributerGoodsId">
            <text class="food-raw-search-row__idx">{{index + 1}}.</text>
            <view class="food-raw-search-row__content">
              <view class="food-raw-search-row__line">
                <text class="food-raw-search-row__name">{{item.gbDgGoodsName}}</text>
                <text class="food-raw-search-row__spec">（{{item.specText}}）</text>
              </view>
              <view class="food-raw-search-row__price">{{item.searchPriceTitle}}：{{item.searchPriceText}}</view>
            </view>
            <view class="food-raw-search-row__select-btn" data-item="{{item}}" bindtap="chooseGoods">选择</view>
          </view>
        </view>
        <view class="dialog-no-result" wx:elif="{{goodsSearchActive && goodsKeyword}}">没有找到匹配的原料</view>

        <block wx:if="{{selectedGoods && !goodsSearchActive}}">
          <view class="raw-add-modal__picked">
            <view class="raw-add-modal__picked-check">✓</view>
            <image wx:if="{{selectedImageUrl}}" class="raw-add-modal__picked-img" src="{{selectedImageUrl}}" mode="aspectFill"></image>
            <view wx:else class="raw-add-modal__picked-img raw-add-modal__picked-placeholder">原</view>
            <view class="raw-add-modal__picked-info">
              <text class="raw-add-modal__picked-name">{{selectedGoods.gbDgGoodsName}}</text>
              <text class="raw-add-modal__picked-spec">{{selectedPackLabel}}</text>
              <text class="raw-add-modal__picked-price">{{selectedPackPriceTitle}} {{selectedPackPriceLabel}}</text>
            </view>
          </view>

          <view class="raw-add-modal__form">
            <view class="raw-add-modal__row raw-add-modal__row--link {{selectedGoodsSpecMissing ? 'raw-add-modal__row--warning' : ''}}" bindtap="toEditSelectedGoodsSpecification">
              <text class="raw-add-modal__label">采购包装</text>
              <text class="raw-add-modal__value {{selectedGoodsSpecMissing ? 'raw-add-modal__value--warning' : ''}}">{{selectedGoodsSpecMissing ? '规格不完整，去补充' : selectedPackLabel}}</text>
              <text class="raw-add-modal__arrow">›</text>
            </view>
            <view class="raw-add-modal__row">
              <text class="raw-add-modal__label">{{selectedPackPriceTitle}}</text>
              <text class="raw-add-modal__value raw-add-modal__value--price">{{selectedPackPriceLabel}}</text>
              <text class="raw-add-modal__arrow">›</text>
            </view>
            <text class="raw-add-modal__price-note" wx:if="{{selectedPriceReferenceOnly}}">商品参考价仅用于本页估算；正式历史理论成本仍按营业日的入库批次和单位换算证据核算。</text>
            <view class="raw-add-modal__row raw-add-modal__row--dosage">
              <text class="raw-add-modal__label">标准投料量</text>
              <view class="raw-add-modal__dosage">
                <view class="raw-add-modal__stepper">
                  <view class="raw-add-modal__step-btn" data-direction="-1" bindtap="stepSelectedQuantity">−</view>
                  <input class="raw-add-modal__step-input" type="digit" value="{{selectedQuantity}}" bindinput="onSelectedQuantity" bindconfirm="dismissKeyboard" confirm-type="done" />
                  <view class="raw-add-modal__step-btn" data-direction="1" bindtap="stepSelectedQuantity">＋</view>
                </view>
                <picker range="{{selectedUnitNames}}" value="{{selectedUnitIndex}}" bindtap="dismissKeyboard" bindchange="onSelectedUnit">
                  <view class="raw-add-modal__unit-pick"><text>{{selectedUnitNames[selectedUnitIndex]}}</text><text class="raw-add-modal__unit-arrow">▾</text></view>
                </picker>
              </view>
            </view>
            <view class="raw-add-modal__row raw-add-modal__row--picker">
              <text class="raw-add-modal__label">最小单位</text>
              <picker range="{{selectedUnitNames}}" value="{{selectedUnitIndex}}" bindtap="dismissKeyboard" bindchange="onSelectedUnit">
                <view class="raw-add-modal__unit-pick raw-add-modal__unit-pick--wide"><text>{{selectedUnitNames[selectedUnitIndex]}}</text><text class="raw-add-modal__unit-arrow">▾</text></view>
              </picker>
            </view>
            <text class="raw-add-modal__hint" wx:if="{{selectedBulkWeightPack}}">大包装默认按“斤”计投料量，也可改选 g，系统按 1斤=500g 换算。</text>
            <text class="raw-add-modal__hint" wx:else>支持使用 g、ml、张、个等最小单位。</text>
            <view class="raw-add-modal__row raw-add-modal__row--conversion" wx:if="{{selectedPackUnit && selectedUnitNames[selectedUnitIndex] !== selectedPackUnit}}">
              <text class="raw-add-modal__label">换算关系<text class="raw-add-modal__required" wx:if="{{selectedConversionRequired}}">*</text></text>
              <view class="raw-add-modal__conversion-col">
                <view class="raw-add-modal__conversion-edit {{selectedConversionRequired ? 'raw-add-modal__conversion-edit--warn' : ''}}">
                  <text class="raw-add-modal__conversion-prefix">1{{selectedPackUnit}} =</text>
                  <input class="raw-add-modal__conversion-input" type="digit" placeholder="{{selectedConversionPlaceholder}}" value="{{selectedPackQtyInMin}}" disabled="{{selectedGoodsSpecMissing}}" bindinput="onSelectedConversionInput" bindconfirm="dismissKeyboard" confirm-type="done" />
                  <text class="raw-add-modal__conversion-suffix">{{selectedUnitNames[selectedUnitIndex]}}</text>
                </view>
                <text class="raw-add-modal__conversion-warn" wx:if="{{selectedGoodsSpecMissing}}">商品未配置可用规格，请点击上方“采购包装”补充规格重量</text>
                <text class="raw-add-modal__conversion-sub" wx:elif="{{selectedPackEquivalentText}}">{{selectedPackEquivalentText}}</text>
              </view>
            </view>
          </view>

          <view class="raw-add-modal__summary">
            <view class="raw-add-modal__summary-top">
              <view class="raw-add-modal__summary-cell"><text class="raw-add-modal__summary-icon">🧮</text><view class="raw-add-modal__summary-text"><text class="raw-add-modal__summary-label">本次投料参考成本 ≈</text><text class="raw-add-modal__summary-num">¥ {{selectedCostText}}</text></view></view>
              <view class="raw-add-modal__summary-divider"></view>
              <view class="raw-add-modal__summary-cell"><text class="raw-add-modal__summary-icon">📦</text><view class="raw-add-modal__summary-text"><text class="raw-add-modal__summary-label">1{{selectedPackUnit}}约可配</text><text class="raw-add-modal__summary-num">{{selectedUsesPerPack}} 次</text></view></view>
            </view>
            <view class="raw-add-modal__summary-demo">{{selectedDemoText}}</view>
            <view class="raw-add-modal__summary-tip"><text class="raw-add-modal__summary-tip-i">i</text><text>参考价只帮助配置标准投料，正式成本仍按营业日价格证据核算</text></view>
          </view>

          <view class="raw-add-modal__quick" wx:if="{{selectedQuickTags.length}}">
            <text class="raw-add-modal__quick-label">常用用量</text>
            <view class="raw-add-modal__quick-tags">
              <view wx:for="{{selectedQuickTags}}" wx:key="value" class="raw-add-modal__quick-tag {{item.active ? 'is-active' : ''}}" data-value="{{item.value}}" bindtap="onSelectedQuickQuantity">{{item.label}}</view>
            </view>
          </view>
        </block>
      </scroll-view>
      <view class="ingredient-dialog-footer">
        <view class="dialog-cancel" bindtap="closeGoodsPicker">取消</view>
        <view class="dialog-confirm" bindtap="confirmSelectedGoods">确认添加</view>
      </view>
    </view>
  </view>
</view>
