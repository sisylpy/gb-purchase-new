@import "../../styles/common.wxss";

.product-list {
  box-sizing: border-box;
  height: calc(100vh - 350rpx);
  padding: 16rpx 22rpx 150rpx;
}

.product-code {
  color: #8a919a;
  font-size: 23rpx;
  margin-top: 8rpx;
}

.product-summary {
  display: grid;
  gap: 12rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 22rpx;
}

.product-summary > view {
  display: flex;
  flex-direction: column;
  font-size: 27rpx;
  gap: 6rpx;
}
