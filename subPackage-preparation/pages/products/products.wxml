<view class="prep-page">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="中间制品" show-back="{{true}}" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <scroll-view scroll-x class="prep-tabs">
    <view wx:for="{{tabs}}" wx:key="value" class="prep-tab {{status === item.value ? 'prep-tab-active' : ''}}" data-value="{{item.value}}" bindtap="onTabTap">{{item.label}}</view>
  </scroll-view>
  <view class="prep-search"><input class="prep-input" placeholder="搜索名称或编码" value="{{keyword}}" bindinput="onSearch" /></view>

  <view class="prep-loading" wx:if="{{loading}}">正在加载中间制品…</view>
  <view class="prep-empty" wx:elif="{{filteredProducts.length === 0}}">
    <view class="prep-empty-title">暂无中间制品</view>
    <text>可新建母馅、酱料等中间制品。</text>
  </view>
  <scroll-view wx:else scroll-y class="product-list">
    <view class="prep-list-card" wx:for="{{filteredProducts}}" wx:key="id" data-item="{{item}}" bindtap="toDetail">
      <view class="prep-card-head">
        <view>
          <view class="prep-card-title">{{item.productName}}</view>
          <view class="product-code">{{item.productCode}}</view>
        </view>
        <text class="prep-status {{item.statusClass}}">{{item.statusLabel}}</text>
      </view>
      <view class="product-summary">
        <view><text class="prep-muted">基础单位</text><text>{{item.baseUnitCode}}</text></view>
        <view><text class="prep-muted">保质期</text><text>{{item.shelfLifeText}}</text></view>
        <view><text class="prep-muted">当前配方</text><text>{{item.currentRecipeText}}</text></view>
      </view>
    </view>
  </scroll-view>

  <view class="prep-actions"><button class="prep-button prep-button-primary" bindtap="toCreate">新建中间制品</button></view>
</view>
