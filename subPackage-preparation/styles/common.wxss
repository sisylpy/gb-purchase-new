page {
  background: #f5f6f8;
  color: #202429;
  font-size: 28rpx;
}

.prep-page {
  min-height: 100vh;
  background: #f5f6f8;
}

.prep-scroll {
  box-sizing: border-box;
  padding: 20rpx 22rpx 170rpx;
}

.prep-card,
.prep-section {
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 18rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.prep-section-title {
  color: #202429;
  font-size: 31rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.prep-section-subtitle {
  color: #8b929b;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: -10rpx;
  margin-bottom: 20rpx;
}

.prep-row {
  align-items: center;
  border-bottom: 1rpx solid #edf0f2;
  display: flex;
  justify-content: space-between;
  min-height: 74rpx;
}

.prep-row:last-child {
  border-bottom: 0;
}

.prep-label {
  color: #6f7781;
  flex-shrink: 0;
  font-size: 26rpx;
  margin-right: 24rpx;
}

.prep-value {
  color: #202429;
  flex: 1;
  font-size: 28rpx;
  min-width: 0;
  text-align: right;
  word-break: break-all;
}

.prep-value-important {
  color: #187e6e;
  font-size: 34rpx;
  font-weight: 600;
}

.prep-muted {
  color: #8b929b;
  font-size: 24rpx;
}

.prep-danger-text {
  color: #d94b4b;
}

.prep-warning-text {
  color: #c56c12;
}

.prep-success-text {
  color: #187e6e;
}

.prep-status {
  border-radius: 999rpx;
  display: inline-block;
  font-size: 22rpx;
  line-height: 34rpx;
  padding: 0 14rpx;
}

.status-success {
  background: #e6f5f0;
  color: #187e6e;
}

.status-warning {
  background: #fff2df;
  color: #b76512;
}

.status-danger {
  background: #fdeaea;
  color: #d34242;
}

.status-muted {
  background: #eef0f2;
  color: #6e7680;
}

.prep-form-row {
  border-bottom: 1rpx solid #edf0f2;
  padding: 20rpx 0;
}

.prep-form-row:last-child {
  border-bottom: 0;
}

.prep-form-label {
  color: #454c55;
  display: block;
  font-size: 27rpx;
  margin-bottom: 14rpx;
}

.prep-required::before {
  color: #d94b4b;
  content: '*';
  margin-right: 6rpx;
}

.prep-input,
.prep-picker,
.prep-textarea {
  background: #f7f8fa;
  border: 1rpx solid #e3e6e9;
  border-radius: 12rpx;
  box-sizing: border-box;
  color: #202429;
  font-size: 29rpx;
  min-height: 76rpx;
  padding: 18rpx 20rpx;
  width: 100%;
}

.prep-textarea {
  height: 150rpx;
  line-height: 1.5;
}

.prep-placeholder {
  color: #a8aeb5;
}

.prep-inline {
  align-items: center;
  display: flex;
  gap: 14rpx;
}

.prep-inline > .prep-input,
.prep-inline > .prep-picker {
  flex: 1;
  min-width: 0;
}

.prep-tabs {
  background: #fff;
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  padding: 18rpx 22rpx;
  white-space: nowrap;
}

.prep-tab {
  background: #f1f3f4;
  border-radius: 999rpx;
  color: #646c75;
  flex-shrink: 0;
  font-size: 25rpx;
  padding: 12rpx 22rpx;
}

.prep-tab-active {
  background: #187e6e;
  color: #fff;
}

.prep-list-card {
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 16rpx;
  padding: 22rpx;
}

.prep-card-title {
  color: #202429;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.35;
}

.prep-card-meta {
  color: #727a84;
  font-size: 25rpx;
  line-height: 1.7;
  margin-top: 12rpx;
}

.prep-card-head {
  align-items: flex-start;
  display: flex;
  gap: 18rpx;
  justify-content: space-between;
}

.prep-summary-grid {
  display: grid;
  gap: 14rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.prep-summary-item {
  background: #f7f8fa;
  border-radius: 14rpx;
  padding: 18rpx;
}

.prep-summary-label {
  color: #7b838d;
  font-size: 23rpx;
}

.prep-summary-value {
  color: #202429;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.prep-empty,
.prep-error,
.prep-loading {
  align-items: center;
  color: #7d858e;
  display: flex;
  flex-direction: column;
  justify-content: center;
  line-height: 1.65;
  min-height: 360rpx;
  padding: 50rpx;
  text-align: center;
}

.prep-error {
  color: #b34747;
}

.prep-empty-title {
  color: #4f565f;
  font-size: 31rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.prep-actions {
  align-items: center;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #e7eaed;
  bottom: 0;
  box-sizing: border-box;
  display: flex;
  gap: 16rpx;
  left: 0;
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  position: fixed;
  right: 0;
  z-index: 30;
}

.prep-button {
  align-items: center;
  border-radius: 14rpx;
  box-sizing: border-box;
  display: flex;
  font-size: 29rpx;
  font-weight: 500;
  justify-content: center;
  line-height: 1;
  min-height: 84rpx;
  padding: 0 28rpx;
}

.prep-button::after {
  border: none;
}

.prep-button-primary {
  background: #187e6e;
  color: #fff;
  flex: 1;
}

.prep-button-secondary {
  background: #eef6f4;
  color: #187e6e;
}

.prep-button-danger {
  background: #fff0f0;
  color: #d04444;
}

.prep-button[disabled] {
  background: #cfd4d7;
  color: #fff;
}

.prep-small-button {
  border: 1rpx solid #187e6e;
  border-radius: 10rpx;
  color: #187e6e;
  display: inline-flex;
  font-size: 24rpx;
  line-height: 54rpx;
  padding: 0 18rpx;
}

.prep-small-button-danger {
  border-color: #d94b4b;
  color: #d94b4b;
}

.prep-tip {
  background: #fff7e8;
  border-radius: 12rpx;
  color: #8e641f;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 18rpx;
  padding: 18rpx 20rpx;
}

.prep-tip-green {
  background: #eaf6f2;
  color: #256f64;
}

.prep-divider {
  background: #edf0f2;
  height: 1rpx;
  margin: 20rpx 0;
}

.prep-arrow {
  color: #adb2b8;
  font-size: 36rpx;
  margin-left: 12rpx;
}

.prep-search {
  background: #fff;
  padding: 16rpx 22rpx;
}

.prep-search .prep-input {
  min-height: 68rpx;
  padding-bottom: 12rpx;
  padding-top: 12rpx;
}

.prep-modal-mask {
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.42);
  bottom: 0;
  display: flex;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 50;
}

.prep-modal {
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
  max-height: 78vh;
  padding: 26rpx 22rpx calc(26rpx + env(safe-area-inset-bottom));
  width: 100%;
}

.prep-modal-list {
  max-height: 56vh;
}

.prep-photo {
  border-radius: 14rpx;
  height: 170rpx;
  object-fit: cover;
  width: 170rpx;
}

.prep-nowrap {
  white-space: nowrap;
}
