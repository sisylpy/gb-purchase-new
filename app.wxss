/**
 * app.wxss - 全局样式（单文件便于微信开发者工具 class 补全）
 *
 * 区块：1.设计变量与 page  2.基础重置  3.布局  4.尺寸与省略
 *       5.间距  6.排版与文字色  7.背景  8.边框圆角阴影  9.通用组件
 *
 * 说明：.show / .hide 用于显隐切换；与 .overlay 组合时用 .overlay.show。
 * 页面 wxss 中可覆盖同名类（如个别页的 .bg-mainColor）。
 */

/* -------------------------------------------------------------------------- */
/* 1. 设计变量 + 页面根样式 */
/* -------------------------------------------------------------------------- */

page {
  /* 品牌与语义色 */
  --gb-primary: #187e6e;
  --gb-success: #07c160;
  --gb-warning: #fa9d3b;
  --gb-danger: #fa5151;
  --gb-text: #333333;
  --gb-text-secondary: #666666;
  --gb-text-muted: #999999;
  --gb-text-inverse: #ffffff;
  /* 背景 */
  --gb-bg-page: #f5f5f5;
  --gb-bg-white: #ffffff;
  --gb-bg-light: #e5f8f6;
  --gb-bg-gray: #f0f0f0;
  /* 线框 */
  --gb-border: #e0e0e0;
  --gb-border-input: #dddddd;
  --gb-border-soft: #f0f0f0;

  /* 食材利用率等级（与「利用率分布」图例一致；文案 / 圆点 / 图表 segment 共用色值）
   * 后端 level：LOW | NORMAL | HIGH | CRITICAL */
  --gb-util-low: #38bdf8;
  --gb-util-normal: #34d399;
  --gb-util-high: #fb923c;
  --gb-util-critical: #ef4444;

  height: 100%;
  background-color: var(--gb-bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--gb-text);
  line-height: 1.6;
}

/* 制作率等级 — 公共文案色（配合 /wxs/utilizationLevel.wxs 的 textClass） */
.util-text {
  font-weight: 600;
}

.util-text--low {
  color: var(--gb-util-low);
}

.util-text--normal {
  color: var(--gb-util-normal);
}

.util-text--high {
  color: var(--gb-util-high);
}

.util-text--critical {
  color: var(--gb-util-critical);
}

.util-text--unknown {
  color: var(--gb-text-muted);
  font-weight: 500;
}

/* 图例圆点、环形 segment、进度条底等（fillClass） */
.util-fill--low {
  background-color: var(--gb-util-low);
}

.util-fill--normal {
  background-color: var(--gb-util-normal);
}

.util-fill--high {
  background-color: var(--gb-util-high);
}

.util-fill--critical {
  background-color: var(--gb-util-critical);
}

.util-fill--unknown {
  background-color: var(--gb-text-muted);
}

/* 仅描边场景（如 canvas 辅助线） */
.util-stroke--low {
  border-color: var(--gb-util-low);
}

.util-stroke--normal {
  border-color: var(--gb-util-normal);
}

.util-stroke--high {
  border-color: var(--gb-util-high);
}

.util-stroke--critical {
  border-color: var(--gb-util-critical);
}

/* -------------------------------------------------------------------------- */
/* 2. 基础重置 */
/* -------------------------------------------------------------------------- */

::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

view,
text,
image,
input,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}

button::after {
  border: none;
}

/* -------------------------------------------------------------------------- */
/* 3. 布局（flex）— 保留老项目类名；单属性类需与 .flex-row / .flex-column 等组合使用 */
/* -------------------------------------------------------------------------- */

/* —— 导航栏适配 —— */
/* navbar 组件会自动设置 --nav-height，页面使用此类自动避开导航栏 */
.page-content {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding-top: var(--nav-height, 64px);
  box-sizing: border-box;
}

/* —— 横向一行 ——
   .flex-row / .flex：主轴横向，交叉轴默认 stretch（子项同一行排布，便于再叠 .items-* / .flex-between）
   .flex-row-default：同一行 + 交叉轴从顶部对齐（align-items: flex-start） */
.flex,
.flex-row1 {
  display: flex;
  flex-direction: row;
}


.flex-row {
  flex-direction: row;
  display: flex;
  flex-flow: row nowrap;
  justify-content: flex-start;
  align-items: center; 
}

.flex-row-default {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

/* —— 纵向一列 ——（.popup-container 与之共享 flex 方向，见文件末尾「弹层」补充规则） */
.flex-col,
.flex-column,
.popup-container {
  display: flex;
  flex-direction: column;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

.flex-nowrap {
  flex-wrap: nowrap;
}

.flex-1 {
  flex: 1;
}

.flex-shrink-0 {
  flex-shrink: 0;
}

/* —— 主轴（单属性，配合 .flex-row / .flex 使用）—— */
.flex-start {
  justify-content: flex-start;
}

.flex-center {
  justify-content: center;
}

.flex-end {
  justify-content: flex-end;
}

.flex-between {
  justify-content: space-between;
}

.flex-around {
  justify-content: space-around;
}

/* —— 交叉轴（单属性）—— */
.items-start {
  align-items: flex-start;
}

.items-center,
.align-center {
  align-items: center;
}

.items-end {
  align-items: flex-end;
}

.items-stretch {
  align-items: stretch;
}


.button-container-white {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  /* overflow: hidden; */
}


.button-container {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  /* overflow: hidden; */
}


.standard {
  margin-right: 20rpx;
 border-radius: 10rpx;
 padding: 4rpx 14rpx;
 border: 1px solid lightgray;
 font-size: 28rpx;
}

.nnn {
  position: fixed;
  bottom: 0;
  width: 100%;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
}

.popup {
  width: 90%;
  background-color: #fff;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 0 20rpx rgba(0, 0, 0, 0.3);
  position: absolute; /* 使用绝对定位 */
  top: 30%; /* 使弹出窗口距离顶部30% */
  left: 50%;
  transform: translate(-50%, 0); /* 水平居中 */
}

.center-content {
  display: flex;
  justify-content: center; /* 水平居中 */
  align-items: center; /* 垂直居中 */
  width: 100%; /* 确保占满整个行 */
}

/* —— 双轴居中（空状态、遮罩层等与 .center-content 等价，合并一处）—— */
.center-content,
.empty-container,
.overlay.show {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* —— 横向组合类（老项目常用，勿删类名）—— */
.flex-row-items-center {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-row-items-end {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
}

.flex-row-justify-center {
  display: flex;
  flex-direction: row;
  justify-content: center;
}

.flex-row-between,
.popup-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-row-between-default {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.flex-row-around {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
}

.flex-row-reverse {
  display: flex;
  flex-direction: row-reverse;
  align-items: center;
}

.flex-row-wrap {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.flex-stretch {
  display: flex;
  flex-direction: row;
  align-items: stretch;
}

.flex-column-center {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

