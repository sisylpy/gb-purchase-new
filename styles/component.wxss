/* styles/component.wxss - 通用组件样式 */

/* 按钮 */
.btn { height: 60rpx; width: 170rpx; background: rgb(68, 108, 170); padding: 10rpx 20rpx; color: #fff; border-radius: 5rpx; }

/* 角标 */
.badge {
  position: absolute;
  top: -5rpx;
  right: -5rpx;
  min-width: 40rpx;
  height: 40rpx;
  background-color: #187e6e;
  color: white;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 50%;
  z-index: 1;
}
.badge.is-gray { background-color: gray; }

/* 显示隐藏 */
.show { display: block; }
.hide { display: none; }

/* 空状态 */
.empty_image { width: 100rpx; height: 100rpx; }
.empty-container { display: flex; justify-content: center; align-items: center; }

/* 商品图片 */
.goods_item { height: 140rpx; width: 140rpx; border-radius: 10rpx; }
.goods_item_small { height: 40rpx; width: 40rpx; }
.goods_item_lg { width: 80rpx; height: 80rpx; }
.url { height: 80rpx; width: 80rpx; float: left; border-radius: 50%; }

/* 头像 */
.top_img { width: 80rpx; height: 80rpx; border-radius: 50%; margin-right: 20rpx; margin-left: 20rpx; }
.face_img { width: 60rpx; height: 60rpx; border-radius: 50%; }

/* 图标 */
.icon { width: 40rpx; height: 40rpx; }
.icon-sm { width: 30rpx; height: 30rpx; }
.icon-md { width: 50rpx; height: 50rpx; }
.wx_icon { width: 80rpx; height: 80rpx; }

/* 输入框 */
.input { border-radius: 10rpx; height: 70rpx; line-height: 70rpx; }
.form-label { font-size: 32rpx; color: #666; width: 200rpx; }
.form-input { flex: 1; height: 80rpx; line-height: 80rpx; font-size: 28rpx; padding: 0 20rpx; border: 1px solid #ddd; border-radius: 10rpx; }
.flex-input { flex: 1; height: 80rpx; line-height: 80rpx; font-size: 28rpx; padding: 0 20rpx; border: 1px solid #ddd; border-radius: 10rpx; }

/* 悬浮操作栏 */
.wx_part { width: 100%; padding: 20rpx; position: fixed; bottom: 0; background-color: rgb(190, 190, 190); }
.orderBottom { position: fixed; bottom: 0; z-index: 99998; padding-bottom: 200rpx; width: 100%; background-color: rgb(216, 229, 233); }

/* 选中状态 */
.dot { border: 1px solid gray; width: 40rpx; height: 40rpx; display: block; }
.dotSelected { width: 46rpx; height: 46rpx; }
.dotWx { position: absolute; line-height: 40rpx; width: 46rpx; border-radius: 40rpx; background: #1ba0e5; margin-top: -30rpx; margin-left: 40rpx; text-align: center; color: #fff; font-size: 24rpx; }

/* 弹窗相关 */
.overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); display: flex; align-items: center; justify-content: center; z-index: 1000; display: none; }
.overlay.show { display: flex; }

/* 弹出层 */
.popup-mask { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); z-index: 999; }
.popup-container { position: fixed; bottom: 0; left: 0; width: 100%; height: 80%; background-color: #ffffff; box-shadow: 0px -10px 30px rgba(0, 0, 0, 0.1); border-top-left-radius: 20rpx; border-top-right-radius: 20rpx; z-index: 1000; display: flex; flex-direction: column; }
.popup-header { padding: 20rpx; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f0f0f0; }
.popup-title { font-size: 36rpx; font-weight: bold; color: #333; }
.popup-content { flex: 1; padding: 20rpx; overflow-y: auto; }
.popup-footer { padding: 20rpx; border-top: 1px solid #f0f0f0; }
.save-btn { width: 100%; height: 80rpx; background-color: #187e6e; color: #fff; font-size: 32rpx; border-radius: 10rpx; text-align: center; line-height: 80rpx; }
.close-icon { width: 40rpx; height: 40rpx; }

/* hover 效果 */
.hover { opacity: 0.7; }
.hoverBar { background-color: #ffffff; border-radius: 10rpx; }
.hoverBtn { background-color: #a0defd; }

/* 点数提示 */
.small { font-size: 24rpx; }
