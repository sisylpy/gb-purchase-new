<back-navbar style="height: {{navBarHeight}}rpx;" title="{{supplierName}}" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>

<scroll-view scroll-y="true" class="coupon-page" style="top: {{navBarHeight}}rpx;">
  <view class="section" wx:if="{{ownedCoupons.length > 0}}">
    <view class="section-title">我的优惠券</view>
    <view class="coupon-card owned" wx:for="{{ownedCoupons}}" wx:key="userCouponId">
      <view class="coupon-value">
        <text class="amount">{{item.amountText}}</text>
        <text class="threshold">{{item.thresholdText}}</text>
      </view>
      <view class="coupon-info">
        <text class="coupon-name">{{item.couponName}}</text>
        <text class="coupon-meta">{{item.scopeText}} · {{item.validPeriodText}}</text>
        <text class="coupon-status">下单结算时自动使用最优惠的一张</text>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{claimableCoupons.length > 0}}">
    <view class="section-title">可领取</view>
    <view class="coupon-card" wx:for="{{claimableCoupons}}" wx:key="couponId">
      <view class="coupon-value">
        <text class="amount">{{item.amountText}}</text>
        <text class="threshold">{{item.thresholdText}}</text>
      </view>
      <view class="coupon-info">
        <text class="coupon-name">{{item.couponName}}</text>
        <text class="coupon-meta">{{item.scopeText}} · {{item.validPeriodText}}</text>
      </view>
      <button class="claim-btn" loading="{{claimingCouponId == item.couponId}}" data-id="{{item.couponId}}" bindtap="claimCoupon">领取</button>
    </view>
  </view>

  <view class="empty" wx:if="{{loaded && ownedCoupons.length == 0 && claimableCoupons.length == 0}}">
    <text class="empty-title">暂无优惠券</text>
    <text class="empty-desc">配送商发布精彩账本专用券后，会显示在这里。</text>
  </view>
</scroll-view>
