.coupon-page { position: fixed; left: 0; right: 0; bottom: 0; background: #f5f6f8; }
.section { padding: 24rpx; }
.section-title { margin: 8rpx 0 20rpx; font-size: 32rpx; font-weight: 600; color: #222; }
.coupon-card { display: flex; align-items: center; min-height: 176rpx; margin-bottom: 20rpx; padding: 20rpx; box-sizing: border-box; border-radius: 18rpx; background: #fff; border-left: 8rpx solid #f15a24; }
.coupon-card.owned { border-left-color: #16a36a; }
.coupon-value { width: 190rpx; display: flex; flex-direction: column; align-items: center; color: #e84b1c; }
.amount { font-size: 46rpx; font-weight: 700; }
.threshold { margin-top: 8rpx; font-size: 22rpx; color: #777; }
.coupon-info { flex: 1; min-width: 0; display: flex; flex-direction: column; padding: 0 20rpx; border-left: 1rpx dashed #ddd; }
.coupon-name { font-size: 30rpx; font-weight: 600; color: #222; }
.coupon-meta { margin-top: 14rpx; font-size: 23rpx; color: #777; }
.coupon-status { margin-top: 12rpx; font-size: 22rpx; color: #16a36a; }
.claim-btn { width: 122rpx; height: 64rpx; line-height: 64rpx; padding: 0; border-radius: 32rpx; font-size: 26rpx; color: #fff; background: #f15a24; }
.claim-btn::after { border: 0; }
.empty { height: 480rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #999; }
.empty-title { font-size: 34rpx; color: #555; }
.empty-desc { margin-top: 18rpx; padding: 0 70rpx; font-size: 25rpx; line-height: 1.6; text-align: center; }
