page {
  background: #f0f2f5;
  height: 100%;
  box-sizing: border-box;
}

.dga-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 100vh;
  box-sizing: border-box;
}

.dga-topbar {
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #e8eaef;
}

.dga-topbar .icon {
  width: 44rpx;
  height: 44rpx;
}

.dga-hanzi {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.3;
  margin-bottom: 4rpx;
}

.dga-topbar .flex-column .small,
.dga-topbar .flex-column > .flex-row text,
.dga-topbar .flex-column .flex-row text {
  font-size: 28rpx;
  line-height: 1.4;
  color: #4b5563;
}

.dga-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 28rpx 48rpx;
  box-sizing: border-box;
}

.dga-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.dga-state--err .dga-state__txt {
  color: #c44f4f;
}

.dga-state__txt {
  font-size: 32rpx;
  color: #6b7280;
  font-weight: 500;
}

/* 用量偏差说明：自定义轻量弹层 */
.dga-tip-wrap {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}

.dga-tip-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.48);
}

.dga-tip-panel {
  position: relative;
  width: 100%;
  max-width: 600rpx;
  max-height: 72vh;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 64rpx rgba(15, 23, 42, 0.18);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.dga-tip__title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  text-align: center;
  line-height: 1.35;
  margin-bottom: 24rpx;
}

.dga-tip__body {
  flex: 1;
  min-height: 0;
  max-height: 46vh;
  margin-bottom: 28rpx;
}

.dga-tip__line {
  font-size: 28rpx;
  line-height: 1.65;
  color: #475569;
  font-weight: 400;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.dga-tip__body .dga-tip__line:first-child {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: 0.02em;
}

.dga-tip__line:last-child {
  border-bottom: none;
}

.dga-tip__btn {
  align-self: center;
  min-width: 240rpx;
  padding: 20rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  text-align: center;
  background: linear-gradient(180deg, #22c55e 0%, #16a34a 100%);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.dga-tip__btn--hover {
  opacity: 0.9;
}

.dga-hero {
  margin-top: 16rpx;
  padding: 24rpx 0 0;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e8eaef;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
  overflow: hidden;
}

.dga-hero__title-row {
  padding: 0 22rpx 0;
  margin-bottom: 12rpx;
}

.dga-hero__name-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx 12rpx;
}

.dga-hero__name {
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.3;
  letter-spacing: 0.02em;
  flex: 1;
  min-width: 0;
}

.dga-hero__tag {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #16a34a;
  background: #ecfdf3;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(22, 163, 74, 0.2);
  box-sizing: border-box;
}

.dga-hero__subline {
  padding: 0 22rpx;
  margin-bottom: 8rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 0 4rpx;
}

.dga-hero__sub {
  font-size: 28rpx;
  line-height: 1.5;
  color: #4b5563;
  font-weight: 500;
}

.dga-hero__date {
  align-items: flex-start;
  padding: 0 22rpx 20rpx;
  margin-top: 4rpx;
}

.dga-hero__date-cal {
  padding: 0 8rpx 0 0;
  flex-shrink: 0;
}

.dga-hero__date-cal .icon {
  width: 44rpx;
  height: 44rpx;
}

.dga-hero__date-hanzi {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
}

.dga-hero__dash {
  padding: 0 8rpx;
}

.dga-hero__kpi-scroll {
  width: 100%;
  border-top: 1rpx solid #e8eaef;
  background: #fcfcfd;
  box-sizing: border-box;
}

.dga-hero__kpi {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: stretch;
  padding: 0;
  background: #fcfcfd;
  min-width: 100%;
  width: max-content;
  box-sizing: border-box;
}

.dga-hero__kpi--row {
  min-width: 860rpx;
}

.dga-hero__kdiv {
  width: 1rpx;
  background: #e2e4e8;
  flex: none;
  margin: 18rpx 0 16rpx;
  align-self: stretch;
  flex-shrink: 0;
}

.dga-hero__kcell {
  flex: 0 0 168rpx;
  width: 168rpx;
  min-width: 168rpx;
  padding: 22rpx 8rpx 22rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
  justify-content: center;
  vertical-align: top;
}

.dga-hero__kpi-lab {
  display: block;
  font-size: 22rpx;
  line-height: 1.35;
  color: #4b5563;
  font-weight: 600;
  margin-bottom: 10rpx;
  max-width: 100%;
  padding: 0 2rpx;
  word-break: break-all;
}

.dga-hero__kpi-val-wrap {
  display: block;
  line-height: 1.15;
}

.dga-hero__kpi-val--em {
  font-size: 36rpx;
  font-weight: 800;
  color: #16a34a;
  letter-spacing: 0.02em;
}

.dga-hero__kpi-pct {
  font-size: 26rpx;
  font-weight: 700;
  color: #16a34a;
  margin-left: 2rpx;
}

.dga-hero__kpi-val {
  font-size: 36rpx;
  font-weight: 700;
  color: #16a34a;
  line-height: 1.15;
}

.dga-hero__kpi-amt {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.2;
  letter-spacing: 0.02em;
}

.dga-hero__kpi-val.is-muted,
.dga-hero__kpi-amt--muted {
  color: #9ca3af;
  font-size: 30rpx;
  font-weight: 600;
}

.dga-hero__kpi-val--em.is-profit {
  font-size: 36rpx;
  font-weight: 800;
  color: #16a34a;
  letter-spacing: 0.02em;
}

/* 类别毛利率标准（与 depFoodList 口径一致，数据在 dish 根上） */
.dga-hero__margin {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 16rpx 22rpx 18rpx;
  border-top: 1rpx solid #e8eaef;
  background: #fafbfc;
  box-sizing: border-box;
}

.dga-hero__margin-range {
  font-size: 22rpx;
  font-weight: 400;
  color: #64748b;
  line-height: 1.45;
  text-align: center;
  margin-bottom: 10rpx;
}

.dga-hero__margin-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  max-width: 100%;
}

.dga-hero__margin-emoji {
  margin-right: 10rpx;
  font-size: 40rpx;
  line-height: 1;
  flex-shrink: 0;
}

.dga-hero__margin-txt {
  font-size: 24rpx;
  font-weight: 600;
  color: #15803d;
  line-height: 1.35;
}

.dga-hero__margin--ok .dga-hero__margin-txt {
  color: #15803d;
}

.dga-hero__margin--warn .dga-hero__margin-txt {
  color: #b45309;
}

.dga-hero__margin--good .dga-hero__margin-txt {
  color: #0f766e;
}

.dga-hero__margin--muted .dga-hero__margin-txt {
  color: #64748b;
  font-weight: 500;
}

.dga-hero__hint {
  padding: 18rpx 22rpx 22rpx;
  background: #f0fdf4;
  border-top: 1rpx solid #dcfce4;
  box-sizing: border-box;
}

.dga-hero__hint-txt {
  display: block;
  font-size: 28rpx;
  line-height: 1.55;
  color: #15803d;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.dga-sec {
  margin-top: 20rpx;
  padding: 0 0 8rpx;
}

.dga-sec__bar {
  margin-bottom: 16rpx;
}

.dga-sec__tit {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.dga-tbl-x {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e0e4eb;
  overflow: hidden;
  box-shadow: 0 1rpx 0 rgba(15, 23, 42, 0.04);
}

.dga-tbl {
  min-width: 100%;
  border-collapse: separate;
  border-spacing: 0;
}

.dga-tbl__tr--head {
  background: #f1f3f6;
  border-bottom: 1rpx solid #dce0e6;
}

.dga-tbl__tr--head,
.dga-tbl__tr {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e8ebef;
  /* 与列间竖线对齐拉满行高 */
  align-items: stretch;
  min-width: 2080rpx;
  box-sizing: border-box;
}

/* 列间竖线（微信 WXSS 不支持 * 通配符，用 dga-tbl__cell） */
.dga-tbl__cell {
  box-sizing: border-box;
  border-right: 1rpx solid #eceff2;
}

.dga-tbl__tr--head .dga-tbl__cell {
  border-right-color: #e3e7ec;
}

.dga-tbl__tr--head .dga-tbl__cell--last,
.dga-tbl__tr .dga-tbl__cell--last {
  border-right: 0;
}

.dga-tbl__tr--head .dga-tbl__cell.flex-column {
  flex: 0 0 220rpx;
  min-width: 220rpx;
  align-items: center;
  justify-content: center;
  text-align: center;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 4rpx 0;
}

.dga-tbl__tr:last-child {
  border-bottom: none;
}

.dga-tbl__th,
.dga-td {
  flex: 0 0 auto;
  display: block;
  font-size: 30rpx;
  color: #1f2937;
  padding: 0 10rpx;
  box-sizing: border-box;
  line-height: 1.5;
  word-break: break-all;
  text-align: center;
}

.tbl__th_sub {
  font-size: 24rpx;
  line-height: 1.2;
  color: #5c6570;
  font-weight: 500;
  margin-top: 2rpx;
}

.dga-td--ing,
.dga-tbl__th.dga-td--ing {
  width: 250rpx;
  flex: none;
  box-sizing: border-box;
}

.dga-td--ing {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0 8rpx;
}

.dga-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  margin-right: 12rpx;
  border: 1rpx solid #e5e7eb;
  flex-shrink: 0;
  background: #f9fafb;
}

.dga-ing-name {
  flex: 1;
  min-width: 0;
}

.dga-ing-name__main {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.35;
  text-align: center;
}

/* 表头 th 与表体 td 用同一组 dga-td--* 类，列宽成对写，避免 th 用通配 200/220 冲突 */
.dga-td.dga-td--stack,
.dga-tbl__th.dga-td--stack {
  width: 220rpx;
  flex: none;
}

.dga-td--stack {
  text-align: center;
  align-items: center;
}

/* 行撑满后，列内内容上下+水平居中 */
.dga-tbl__tr .dga-td--stack,
.dga-tbl__tr .dga-td--dev,
.dga-tbl__tr .dga-td--bar,
.dga-tbl__tr .dga-td--sug {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 0;
  box-sizing: border-box;
  text-align: center;
}

.dga-tbl__tr > .dga-td--cost,
.dga-tbl__tr > .dga-td--gp {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 0;
  box-sizing: border-box;
}

.dga-td--dev,
.dga-tbl__th.dga-td--dev {
  width: 240rpx;
  flex: none;
}

.dga-td--bar,
.dga-tbl__th.dga-td--bar {
  width: 220rpx;
  flex: none;
}

.dga-td--cost,
.dga-tbl__th.dga-td--cost {
  width: 200rpx;
  flex: none;
}

.dga-td.dga-td--cost {
  text-align: center;
  color: #1f2937;
  font-weight: 600;
}

.dga-td--gp,
.dga-tbl__th.dga-td--gp {
  width: 170rpx;
  flex: none;
}

.dga-td.dga-td--gp {
  color: #16a34a;
  font-weight: 700;
  text-align: center;
}

.dga-td--sug,
.dga-tbl__th.dga-td--sug {
  width: 340rpx;
  flex: none;
}

.dga-td--sug {
  text-align: center;
}

.dga-td--dev {
  text-align: center;
}

.dga-td__line {
  display: block;
  width: 100%;
  text-align: center;
}

.dga-td__sub {
  display: block;
  margin-top: 4rpx;
  font-size: 25rpx;
  color: #525a63;
  text-align: center;
  font-weight: 500;
}

.dga-td--stack .dga-td__line {
  font-size: 28rpx;
}

.dga-td--stack .dga-td__sub {
  text-align: center;
  margin-top: 6rpx;
}

.dga-dev-nums {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 4rpx;
  margin-bottom: 6rpx;
}

.dga-dev-nums__pct {
  font-size: 28rpx;
  font-weight: 700;
}

.dga-dev-nums__arrow {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 700;
}

.dga-dev-nums__arrow.is-down {
  color: #64748b;
}

.dga-tbl__tr--head .dga-th--tap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.dga-th--underline {
  border-bottom: 1rpx dashed #94a3b8;
}

.dga-th--tap-hover {
  opacity: 0.82;
}

.dga-td--dev-tap-hover {
  background: rgba(148, 163, 184, 0.12);
  border-radius: 8rpx;
}

.dga-ing-util-tag {
  display: inline-block;
  margin-top: 4rpx;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
}

.dga-pill {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1.1;
  padding: 5rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.dga-pill--bad {
  color: #fff;
  background: #ff4d4f;
}

.dga-pill--ok {
  color: #fff;
  background: #d1d5db;
}

.dga-bar {
  height: 16rpx;
  width: 100%;
  max-width: 220rpx;
  border-radius: 8rpx;
  background: #e2e5ea;
  overflow: hidden;
  margin-bottom: 4rpx;
}

.dga-bar__in {
  height: 100%;
  max-width: 100%;
  border-radius: 6rpx;
}

.dga-bar__in.is-ok {
  background: #52c41a;
}

.dga-bar__in.is-warn {
  background: #ff4d4f;
}

.dga-sug__tag {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1.2;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  color: #fff;
  background: #ff4d4f;
  font-weight: 600;
}

.dga-sug__tag--opt {
  color: #ad6800;
  background: #fff2e0;
  border: 1rpx solid #ffd8a8;
}

.dga-sug__txt {
  display: block;
  font-size: 27rpx;
  line-height: 1.5;
  color: #374151;
  font-weight: 400;
  text-align: center;
  width: 100%;
}

.dga-tbl__th {
  text-align: center;
  color: #374151;
  font-size: 26rpx;
  font-weight: 700;
  padding: 0 6rpx;
  box-sizing: border-box;
  /* 列宽只由 dga-td--* 与 dga-td--sug 等决定，勿写死 200rpx */
  flex: none;
}

.dga-tbl__th.dga-td--ing {
  text-align: center;
  padding: 0 8rpx;
  font-size: 27rpx;
}

.dga-empty {
  text-align: center;
  color: #6b7280;
  padding: 36rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.dga-charts {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dga-chart-card {
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e0e4eb;
  padding: 24rpx 24rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.05);
  box-sizing: border-box;
}

.dga-chart-card__tit {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 14rpx;
}

.dga-donut {
  position: relative;
  width: 100%;
  min-height: 400rpx;
  margin: 0 auto 8rpx;
  z-index: 0;
}

.dga-donut__ec {
  display: block;
  width: 100%;
  height: 400rpx;
  position: relative;
  z-index: 0;
}

.dga-donut__cent {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  width: 220rpx;
  margin-top: -4rpx;
  pointer-events: none;
}

.dga-donut__amt {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.2;
}

.dga-donut__sub {
  display: block;
  font-size: 26rpx;
  color: #525a63;
  font-weight: 500;
  margin-top: 2rpx;
}

.dga-legend {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 8rpx;
}

.dga-legend__row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  font-size: 27rpx;
  line-height: 1.5;
  color: #1f2937;
}

.dga-legend__left {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
  flex: 1;
  gap: 0;
}

.dga-legend__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.dga-legend__name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dga-legend__val {
  color: #4b5563;
  font-size: 25rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.dga-foot {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
  font-weight: 500;
}

.dga-line__ec {
  display: block;
  width: 100%;
  height: 360rpx;
  margin: 0 auto;
}

.dga-trend-hint {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  background: #fff0f0;
