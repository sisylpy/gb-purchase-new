<view class="flex flex-column food-page">
  <back-navbar title="{{type == 'edit' ? '修改' : '添加'}}菜品" avatar="/images/back.png" style="height: {{navBarHeight}}rpx;" bindnavbuttontap="toBack"></back-navbar>

  <view class="content food-page-body">
    <view class="food-form-card">
      <view class="food-form-row food-form-row--top">
        <view class="flex-row-items-center flex-1" style="min-width: 0;">
          <text class="food-form-label">菜品类别</text>
          <view class="flex-1" style="min-width: 0;">
            <text class="food-form-value ellipsis">{{fatherName}}</text>
          </view>
        </view>
        <view class="food-save {{canSave ? 'is-active' : ''}}" catchtap="{{canSave ? 'addFood' : 'showTishi'}}">保存菜品</view>
      </view>

      <view class="food-form-row flex-row-items-center">
        <text class="food-form-label">菜品名称</text>
        <input
          class="numberInput"
          style="width: {{windowWidth / 2}}rpx; font-size: 32rpx; min-height: 80rpx;"
          bindinput="getFoodName"
          value="{{type == 'edit' ? foodItem.gbDfFoodName : foodName}}"
        />
      </view>

      <view class="food-form-row flex-row-items-center">
        <text class="food-form-label">菜品售价</text>
        <view class="flex-row-items-center flex-1" style="min-width: 0;">
          <input
            class="numberInput"
            style="width: {{windowWidth / 2}}rpx;"
            placeholder-style="color: #999; font-size: 26rpx;"
            type="digit"
            value="{{type == 'edit' ? foodItem.gbDfFoodPrice : price}}"
            bindinput="getPrice"
          />
          <text class="ml-sm text-secondary" style="flex-shrink: 0;">元/份</text>
        </view>
      </view>

      <view class="food-form-row flex-row-items-center">
        <text class="food-form-label">目标毛利率</text>
        <view class="flex-row-items-center flex-1" style="min-width: 0;">
          <input
            class="numberInput"
            style="width: {{windowWidth / 2}}rpx;"
            placeholder-style="color: #999; font-size: 26rpx;"
            placeholder="请输入"
            type="digit"
            value="{{type == 'edit' && foodItem ? foodItem.gbDfTargetGrossMarginRate || '' : targetGrossMarginRate}}"
            bindinput="getTargetGrossMarginRate"
          />
          <text class="ml-sm text-secondary" style="flex-shrink: 0;">%</text>
        </view>
      </view>

      <view class="food-form-row flex-row-items-center">
        <text class="food-form-label">浮动百分点</text>
        <view class="flex-row-items-center flex-1" style="min-width: 0;">
          <input
            class="numberInput"
            style="width: {{windowWidth / 2}}rpx;"
            placeholder-style="color: #999; font-size: 26rpx;"
            placeholder="请输入"
            type="digit"
            value="{{type == 'edit' && foodItem ? foodItem.gbDfGrossMarginFloatAbs || '' : grossMarginFloatAbs}}"
            bindinput="getGrossMarginFloatAbs"
          />
          <text class="ml-sm text-secondary" style="flex-shrink: 0;">%</text>
        </view>
      </view>

      <view class="food-form-row food-form-row--multiline">
        <text class="food-form-label" style="padding-top: 8rpx;">菜品图片</text>
        <image
          class="class_img"
          src="{{type == 'edit' && !isSelectImg && foodItem ? url + foodItem.gbDfFoodImg : src}}"
          bindtap="choiceImg"
          mode="aspectFill"
          style="width: {{windowWidth / 3}}rpx; height: {{windowWidth / 3}}rpx;"
        />
      </view>

      <view class="food-form-row food-form-row--multiline">
        <text class="food-form-label" style="padding-top: 12rpx;">制作要求</text>
        <textarea
          class="numberText"
          style="width: {{windowWidth - 260}}rpx;"
          bindinput="getFoodMethod"
          value="{{type == 'edit' ? foodItem.gbDfFoodMethod : foodMethod}}"
          auto-height
        />
      </view>


    </view>

    <view wx:if="{{type == 'edit'}}" class="food-delete-btn" catchtap="deleteFood">
      <text>删除菜品</text>
    </view>
  </view>

 
</view>
