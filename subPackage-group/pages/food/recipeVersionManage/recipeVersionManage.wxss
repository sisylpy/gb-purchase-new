@import '../food-common.wxss';

.version-page { display: flex; flex-direction: column; height: 100vh; min-height: 0; color: #2b3234; background: #f4f5f6; }
.version-page__scroll { flex: 1; box-sizing: border-box; height: 0; min-height: 0; padding: 20rpx 24rpx 0; }
.version-summary, .version-card, .timeline-card, .adjustment-card { background: #fff; border-radius: 18rpx; }
.version-summary { padding: 24rpx 22rpx; }
.version-summary__top, .version-card__head, .version-card__identity, .version-list-head, .version-periods__head, .version-period-row, .version-recipe__head, .version-recipe__columns, .version-ingredient, .version-ingredient__main, .interval-panel__head, .interval-form-row, .interval-actions, .interval-preview__row { display: flex; align-items: center; }
.version-summary__top, .version-card__head, .version-list-head, .version-periods__head, .version-period-row, .version-recipe__head, .version-recipe__columns, .version-ingredient, .interval-panel__head, .interval-form-row, .interval-preview__row { justify-content: space-between; }
.version-summary__dish, .version-summary__meta, .version-summary__tip, .version-period-row__text, .version-period-row__hint, .version-ingredient__spec, .interval-panel__title, .interval-panel__sub, .interval-form-row__label, .interval-form-row__hint, .interval-preview__title, .interval-preview__line, .interval-preview__warning { display: block; }
.version-summary__dish { font-size: 34rpx; font-weight: 650; }
.version-summary__meta { margin-top: 6rpx; color: #7f8987; font-size: 24rpx; }
.version-summary__current, .version-summary__missing { padding: 8rpx 16rpx; font-size: 23rpx; border-radius: 999rpx; }
.version-summary__current { color: #117765; background: #e7f5f1; }
.version-summary__missing { color: #aa620f; background: #fff0db; }
.version-summary__tip { margin-top: 18rpx; color: #65706e; font-size: 25rpx; line-height: 1.55; }
.version-summary__create { height: 76rpx; margin-top: 20rpx; color: #fff; font-size: 28rpx; font-weight: 600; line-height: 76rpx; text-align: center; background: #168d79; border-radius: 12rpx; }
.timeline-card { margin-top: 18rpx; padding: 22rpx; }
.timeline-card__head, .timeline-row__top, .adjustment-row__top, .cost-impact__head { display: flex; align-items: center; justify-content: space-between; }
.timeline-card__title { display: block; color: #273230; font-size: 29rpx; font-weight: 650; }
.timeline-card__sub { display: block; margin-top: 5rpx; color: #87908e; font-size: 21rpx; }
.timeline-card__state { flex-shrink: 0; margin-left: 12rpx; padding: 7rpx 13rpx; font-size: 21rpx; border-radius: 999rpx; }
.timeline-card__state.is-current { color: #117765; background: #e4f5f0; }
.timeline-card__state.is-missing { color: #a96010; background: #fff0db; }
.timeline-empty { margin-top: 16rpx; padding: 18rpx; color: #8a9391; font-size: 23rpx; line-height: 1.5; background: #f5f7f6; border-radius: 10rpx; }
.timeline-row { display: flex; min-height: 82rpx; margin-top: 12rpx; padding: 12rpx 14rpx 12rpx 0; background: #f7f9f8; border-radius: 12rpx; }
.timeline-row.is-today { background: #eaf7f3; box-shadow: inset 0 0 0 1rpx #8ecdbc; }
.timeline-row.is-gap { background: #fff7ec; }
.timeline-row__rail { position: relative; width: 42rpx; flex-shrink: 0; }
.timeline-row__rail::after { position: absolute; top: 24rpx; bottom: -28rpx; left: 20rpx; width: 2rpx; content: ''; background: #d7e5e1; }
.timeline-row:last-child .timeline-row__rail::after { display: none; }
.timeline-row__dot { position: absolute; z-index: 1; top: 10rpx; left: 14rpx; width: 14rpx; height: 14rpx; background: #79bcae; border: 4rpx solid #edf7f4; border-radius: 50%; }
.timeline-row.is-gap .timeline-row__dot { background: #e5a04e; border-color: #fff3e2; }
.timeline-row__main { flex: 1; min-width: 0; }
.timeline-row__version { color: #2c3734; font-size: 26rpx; font-weight: 650; }
.timeline-row__today { padding: 3rpx 9rpx; color: #137966; font-size: 19rpx; background: #fff; border-radius: 999rpx; }
.timeline-row__period, .timeline-row__reason { display: block; margin-top: 5rpx; color: #65716e; font-size: 22rpx; }
.timeline-row__reason { color: #87908e; }
.version-list-head { padding: 26rpx 4rpx 14rpx; }
.version-list-head__title { font-size: 31rpx; font-weight: 650; }
.version-list-head__hint, .version-card__date { color: #909896; font-size: 23rpx; }
.version-loading, .version-empty { padding: 70rpx 0; color: #8a9391; font-size: 27rpx; text-align: center; }
.version-card { margin-bottom: 18rpx; padding: 22rpx; border: 1rpx solid #e6e9e8; }
.version-card--current { border-color: #9ed3c7; box-shadow: 0 4rpx 14rpx rgba(22,141,121,.08); }
.version-card__number { font-size: 35rpx; font-weight: 700; }
.version-card__use { display: flex; justify-content: flex-end; margin-top: 14rpx; }
.version-card__use-button, .version-card__use-current, .version-card__use-disabled { padding: 10rpx 18rpx; font-size: 24rpx; border-radius: 999rpx; }
.version-card__use-button { color: #fff; background: #168d79; }
.version-card__use-current { color: #117765; background: #e4f5f0; }
.version-card__use-disabled { color: #818b88; background: #eff2f1; }
.version-card__reason { display: block; margin-top: 12rpx; color: #6f7a77; font-size: 22rpx; line-height: 1.45; }
.version-status { margin-left: 14rpx; padding: 5rpx 14rpx; color: #717a78; font-size: 22rpx; background: #eef1f0; border-radius: 999rpx; }
.version-status--current, .version-status--published { color: #117765; background: #e5f5f0; }
.version-status--draft { color: #506879; background: #eaf0f5; }
.version-status--retired { color: #777f7d; background: #eff1f0; }
.version-section-title { font-size: 28rpx; font-weight: 650; }
.version-periods, .version-recipe { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #e7eae9; }
.version-periods__add { padding: 8rpx 14rpx; color: #168d79; font-size: 24rpx; border: 1rpx solid #9fd7ca; border-radius: 999rpx; }
.version-periods__empty { margin-top: 14rpx; padding: 16rpx; color: #7d8784; font-size: 24rpx; line-height: 1.5; background: #f5f7f6; border-radius: 10rpx; }
.version-period-row { min-height: 78rpx; margin-top: 12rpx; padding: 8rpx 14rpx; background: #f3f8f6; border-radius: 10rpx; }
.version-period-row__text { color: #35423f; font-size: 25rpx; font-weight: 550; }
.version-period-row__hint { margin-top: 4rpx; color: #8a9390; font-size: 21rpx; }
.version-period-row__remove { margin-left: 18rpx; color: #c74d4d; font-size: 23rpx; }
.version-period-row__actions { display: flex; align-items: center; flex-shrink: 0; margin-left: 15rpx; }
.version-period-row__edit { color: #168d79; font-size: 23rpx; }
.version-recipe__count { color: #87908e; font-size: 23rpx; }
.version-recipe__columns { margin-top: 15rpx; padding: 12rpx 8rpx; color: #929a98; font-size: 22rpx; border-bottom: 1rpx solid #e8ebea; }
.version-ingredient { min-height: 94rpx; padding: 10rpx 4rpx; border-bottom: 1rpx solid #eef0ef; }
.version-ingredient__main { flex: 1; min-width: 0; }
.version-ingredient__index { width: 30rpx; color: #a0a7a5; font-size: 22rpx; }
.version-ingredient__image { width: 62rpx; height: 62rpx; flex-shrink: 0; margin-right: 14rpx; border-radius: 10rpx; background: #f0f2f1; }
.version-ingredient__image--intermediate, .version-ingredient__image--placeholder { display: flex; align-items: center; justify-content: center; color: #fff; font-size: 24rpx; font-weight: 650; background: #168d79; }
.version-ingredient__image--placeholder { color: #99a19f; background: #edf0ef; }
.version-ingredient__identity { min-width: 0; }
.version-ingredient__name-line { display: flex; align-items: center; flex-wrap: wrap; }
.version-ingredient__kind { margin-right: 8rpx; padding: 3rpx 8rpx; color: #137d6c; font-size: 19rpx; background: #e5f4f0; border-radius: 6rpx; }
.version-ingredient__name { color: #2d3533; font-size: 27rpx; font-weight: 600; }
.version-ingredient__spec { margin-top: 5rpx; color: #7e8885; font-size: 23rpx; }
.version-ingredient__amount { margin-left: 14rpx; color: #137d6c; font-size: 27rpx; font-weight: 650; white-space: nowrap; }
.version-recipe__empty { padding: 25rpx 0 5rpx; color: #8b9491; font-size: 24rpx; text-align: center; }
.version-card__actions { display: flex; gap: 14rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #e7eae9; }
.version-card__action { flex: 1; height: 66rpx; color: #53615d; font-size: 24rpx; line-height: 66rpx; text-align: center; background: #f0f3f2; border-radius: 10rpx; }
.version-card__action--history { color: #147966; background: #eaf7f3; }
.adjustment-card { margin-top: 18rpx; padding: 0 20rpx 10rpx; }
.adjustment-card__head { padding-left: 0; padding-right: 0; }
.adjustment-row { padding: 16rpx 2rpx; border-top: 1rpx solid #edf0ef; }
.adjustment-row__operation { color: #35413e; font-size: 25rpx; font-weight: 600; }
.adjustment-row__time { color: #929a98; font-size: 21rpx; }
.adjustment-row__range, .adjustment-row__reason { display: block; margin-top: 6rpx; color: #66726f; font-size: 22rpx; }
.adjustment-row__reason { color: #89918f; }
.version-page__safe { height: calc(30rpx + env(safe-area-inset-bottom)); }

.interval-mask { position: fixed; z-index: 1000; inset: 0; display: flex; align-items: flex-end; background: rgba(0,0,0,.46); }
.interval-panel { box-sizing: border-box; width: 100%; max-height: 88vh; padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); overflow-y: auto; background: #fff; border-radius: 28rpx 28rpx 0 0; }
.interval-panel__head { margin-bottom: 18rpx; }
.interval-panel__title { color: #232b2e; font-size: 33rpx; font-weight: 650; }
.interval-panel__sub { margin-top: 5rpx; color: #78827f; font-size: 23rpx; }
.interval-panel__close { color: #6f7976; font-size: 25rpx; }
.interval-form-row { min-height: 92rpx; border-top: 1rpx solid #edf0ef; }
.interval-form-row__label { color: #303836; font-size: 27rpx; font-weight: 600; }
.interval-form-row__hint { margin-top: 4rpx; color: #89928f; font-size: 21rpx; font-weight: 400; }
.interval-form-row__value { padding: 16rpx 0 16rpx 24rpx; color: #158773; font-size: 27rpx; }
.interval-duration { padding: 20rpx 0; border-top: 1rpx solid #edf0ef; }
.interval-duration__options { display: flex; gap: 14rpx; margin-top: 14rpx; }
.interval-duration__option { flex: 1; box-sizing: border-box; padding: 16rpx 18rpx; border: 2rpx solid #e5e9e7; border-radius: 12rpx; background: #f7f8f8; }
.interval-duration__option.is-selected { border-color: #67bcae; background: #edf8f5; }
.interval-duration__title, .interval-duration__hint { display: block; }
.interval-duration__title { color: #303836; font-size: 25rpx; font-weight: 600; }
.interval-duration__hint { margin-top: 5rpx; color: #89928f; font-size: 20rpx; }
.interval-duration__option.is-selected .interval-duration__title { color: #158773; }
.interval-batches { padding: 18rpx 0; border-top: 1rpx solid #edf0ef; }
.interval-batches__loading, .interval-batches__empty { margin-top: 12rpx; padding: 15rpx; color: #7a8481; font-size: 23rpx; line-height: 1.45; background: #f5f7f6; border-radius: 10rpx; }
.interval-batches__scroll { width: 100%; margin-top: 14rpx; white-space: nowrap; }
.interval-batches__track { display: inline-flex; gap: 12rpx; }
.interval-batch { box-sizing: border-box; width: 285rpx; padding: 15rpx; background: #f5f7f6; border: 1rpx solid transparent; border-radius: 12rpx; }
.interval-batch.is-selected { background: #eaf7f3; border-color: #64bca8; }
.interval-batch__goods, .interval-batch__date, .interval-batch__meta { display: block; overflow: hidden; text-overflow: ellipsis; }
.interval-batch__goods { color: #2e3734; font-size: 25rpx; font-weight: 600; }
.interval-batch__date { margin-top: 8rpx; color: #157c6b; font-size: 24rpx; }
.interval-batch__meta { margin-top: 5rpx; color: #858e8b; font-size: 21rpx; }
.replacement-box { padding: 18rpx; border-top: 1rpx solid #edf0ef; background: #f7faf9; border-radius: 12rpx; }
.replacement-box__switch { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.replacement-box__switch > view { flex: 1; min-width: 0; }
.replacement-box__route { display: flex; align-items: stretch; gap: 10rpx; margin-top: 16rpx; }
.replacement-box__goods { flex: 1; min-width: 0; padding: 14rpx; background: #fff; border: 1rpx solid #e4e9e7; border-radius: 10rpx; }
.replacement-box__goods--new { border-color: #a7d9ce; background: #eef8f5; }
.replacement-box__tag, .replacement-box__name, .replacement-box__spec, .replacement-box__note { display: block; }
.replacement-box__tag { color: #808a87; font-size: 20rpx; }
.replacement-box__name { margin-top: 5rpx; overflow: hidden; color: #2d3734; font-size: 25rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.replacement-box__spec { margin-top: 4rpx; color: #7b8582; font-size: 21rpx; }
.replacement-box__arrow { align-self: center; color: #168d79; font-size: 30rpx; font-weight: 650; }
.replacement-box__note { margin-top: 12rpx; color: #4b7168; font-size: 22rpx; line-height: 1.45; }
.interval-reason { padding: 16rpx 0; border-top: 1rpx solid #edf0ef; }
.interval-reason__input { box-sizing: border-box; height: 76rpx; margin-top: 12rpx; padding: 0 18rpx; color: #323a38; font-size: 25rpx; background: #f5f7f6; border-radius: 10rpx; }
.interval-preview { margin-top: 10rpx; padding: 18rpx; background: #f1f8f6; border-radius: 12rpx; }
.interval-preview__title { color: #176f61; font-size: 27rpx; font-weight: 650; }
.interval-preview__line, .interval-preview__warning { margin-top: 8rpx; color: #53615d; font-size: 23rpx; line-height: 1.45; }
.interval-preview__warning { color: #ad620f; }
.interval-preview__row { margin-top: 10rpx; padding-top: 10rpx; color: #5f6966; font-size: 21rpx; border-top: 1rpx solid #dcebe7; }
.cost-impact { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #cfe4de; }
.cost-impact__title { color: #176f61; font-size: 26rpx; font-weight: 650; }
.cost-impact__count { color: #61706c; font-size: 21rpx; }
.cost-impact__date, .cost-impact__note { display: block; margin-top: 8rpx; color: #60706b; font-size: 21rpx; line-height: 1.45; }
.cost-impact__grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 14rpx; overflow: hidden; background: #fff; border-radius: 10rpx; }
.cost-impact__grid > view { padding: 13rpx 8rpx; color: #7c8784; font-size: 20rpx; text-align: center; border-right: 1rpx solid #e8eeec; }
.cost-impact__grid > view:last-child { border-right: 0; }
.cost-impact__value { display: block; margin-top: 5rpx; color: #25332f; font-size: 26rpx; font-weight: 650; }
.cost-impact__value--diff { color: #137b68; }
.interval-actions { gap: 18rpx; margin-top: 24rpx; }
.interval-actions__secondary, .interval-actions__primary { flex: 1; height: 82rpx; font-size: 28rpx; font-weight: 600; line-height: 82rpx; text-align: center; border-radius: 12rpx; }
.interval-actions__secondary { color: #4f5a57; background: #edf0ef; }
.interval-actions__primary { color: #fff; background: #168d79; }
.interval-actions__primary.is-disabled { color: #9aa29f; background: #e5e8e7; }
