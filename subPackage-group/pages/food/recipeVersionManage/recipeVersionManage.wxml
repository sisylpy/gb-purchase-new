<view class="version-page">
  <back-navbar title="配方版本管理" avatar="/images/back.png" style="height: {{navBarHeight}}rpx;" bindnavbuttontap="toBack"></back-navbar>

  <scroll-view scroll-y class="version-page__scroll">
    <view class="version-list-head">
      <text class="version-list-head__title">全部版本</text>
      <view class="version-list-head__create" bindtap="createVersion">+ 添加新配方版本</view>
    </view>

    <view class="version-loading" wx:if="{{loading}}">正在读取配方版本…</view>
    <view class="version-empty" wx:elif="{{!versions.length}}">
      <text>还没有配方版本</text>
      <view class="version-empty__create" bindtap="createVersion">+ 新建第一个配方版本</view>
    </view>

    <block wx:else>
      <view wx:for="{{versions}}" wx:for-item="version" wx:key="id" class="version-card {{version._isCurrent ? 'version-card--current' : ''}}">
        <view class="version-card__head">
          <view class="version-card__identity">
            <text class="version-card__number">V{{version.versionNo}}</text>
            <text class="version-status version-status--{{version._statusClass}}">{{version._statusText}}</text>
          </view>
          <text class="version-card__date">{{version._publishedText ? version._publishedText + (version._isDraft ? ' 创建' : ' 发布') : ''}}</text>
        </view>
        <text class="version-card__content-id">内容修订 #{{version._contentVersionId}} · 第 {{version.revisionNo}} 次修订</text>
        <view class="version-card__warn" wx:if="{{version._latestNotApplied}}">
          <text>最新内容尚未被门店采用：下方适用时间与成本属于已采用的修订，不属于这份最新内容。</text>
        </view>
        <text class="version-card__cost-state" wx:if="{{version._costDetailText}}">核算状态：{{version._costDetailText}}</text>
        <view class="version-card__use" wx:if="{{version._isCurrent}}">
          <view class="version-card__use-current">✓ 今天正在使用</view>
        </view>
        <text class="version-card__reason" wx:if="{{version._changeReasonText}}">本版说明：{{version._changeReasonText}}</text>

        <view class="version-periods">
          <view class="version-periods__head"><text class="version-section-title">当前门店适用时间</text></view>
          <view wx:if="{{!version._intervals.length}}" class="version-periods__empty">
            {{version._isDraft ? '草稿不能用于成本核算' : '尚未设置，不会自动应用到任何营业日'}}
          </view>
          <view wx:for="{{version._intervals}}" wx:for-item="interval" wx:key="id" class="version-period-row">
            <view>
              <text class="version-period-row__text">{{interval._periodText}}</text>
              <text class="version-period-row__hint">结束日期当天不再使用本版本</text>
            </view>
          </view>
        </view>

        <view class="version-cost-summary">
          <view>
            <text class="version-cost-summary__label">该版本每份成本合计</text>
            <text class="version-cost-summary__hint">按适用期营业日销量加权的采购价计算</text>
          </view>
          <text class="version-cost-summary__value {{version._costComplete ? '' : 'is-empty'}}">{{version._costPerPortionText || '—'}}</text>
        </view>
        <text class="version-cost-summary__scope">{{version._costStatusText}}</text>

        <view class="version-recipe">
          <view class="version-recipe__head">
            <text class="version-section-title">配方内容</text>
            <text class="version-recipe__count">{{version._components.length}} 种配料 · 每份用量</text>
          </view>
          <view class="version-recipe__columns" wx:if="{{version._components.length}}">
            <text>配料与时期平均采购价</text>
            <text>用量 / 每份成本</text>
          </view>
          <view wx:for="{{version._components}}" wx:for-item="component" wx:key="_key" class="version-ingredient">
            <view class="version-ingredient__main">
              <text class="version-ingredient__index">{{component._index}}</text>
              <view class="version-ingredient__image version-ingredient__image--intermediate" wx:if="{{component._isIntermediate}}">中</view>
              <image class="version-ingredient__image" wx:elif="{{component._imageUrl}}" src="{{component._imageUrl}}" mode="aspectFill" />
              <view class="version-ingredient__image version-ingredient__image--placeholder" wx:else>原</view>
              <view class="version-ingredient__identity">
                <view class="version-ingredient__name-line">
                  <text class="version-ingredient__kind" wx:if="{{component._isIntermediate}}">中间料</text>
                  <text class="version-ingredient__name">{{component.name}}</text>
                </view>
                <text class="version-ingredient__spec" wx:if="{{component._specText}}">规格：{{component._specText}}</text>
                <text class="version-ingredient__price {{component._costComplete ? '' : 'is-empty'}}">{{component._averagePriceText || '—'}}</text>
                <text class="version-ingredient__base-price" wx:if="{{component._averageBasePriceText}}">{{component._averageBasePriceText}}</text>
              </view>
            </view>
            <view class="version-ingredient__figures">
              <text class="version-ingredient__amount">{{component._amountText}}</text>
              <text class="version-ingredient__cost {{component._costComplete ? '' : 'is-empty'}}">每份 {{component._portionCostText || '—'}}</text>
            </view>
          </view>
          <view class="version-recipe__empty" wx:if="{{!version._components.length}}">该版本没有可展示的配料快照</view>
        </view>
        <view class="version-revisions" wx:if="{{version._contentRevisions.length > 1}}">
          <view class="version-revisions__head"><text class="version-section-title">内容修订明细</text></view>
          <view wx:for="{{version._contentRevisions}}" wx:for-item="revision" wx:key="_contentVersionId" class="version-revision-row">
            <view class="version-revision-row__head">
              <text class="version-revision-row__title">修订 {{revision.revisionNo}} · #{{revision._contentVersionId}} · {{revision._statusText}}</text>
              <text class="version-revision-row__state">{{revision._isApplied ? '已被门店采用' : '未采用'}}</text>
            </view>
            <text class="version-revision-row__line">配料 {{revision._components.length}} 种</text>
            <text class="version-revision-row__line" wx:if="{{revision._intervals.length}}">适用时间：{{revision._intervals[0]._periodText}}</text>
            <text class="version-revision-row__line" wx:else>适用时间：尚未设置</text>
            <text class="version-revision-row__line">每份成本：{{revision._costPerPortionText}} · {{revision._costStatusText}}</text>
            <text class="version-revision-row__detail" wx:if="{{revision._costDetailText}}">{{revision._costDetailText}}</text>
            <view class="version-revision-row__actions">
              <text class="version-revision-row__action" data-content-version-id="{{revision._contentVersionId}}" data-interval-id="{{revision._firstIntervalId}}" bindtap="editVersion">编辑该修订</text>
              <text class="version-revision-row__action version-revision-row__action--danger" data-content-version-id="{{revision._contentVersionId}}" bindtap="deleteVersion">删除该修订</text>
            </view>
          </view>
        </view>
        <view class="version-card__actions">
          <view class="version-card__action version-card__action--primary" data-content-version-id="{{version._contentVersionId}}" data-interval-id="{{version._intervals[0].id}}" bindtap="editVersion">
            {{version._isDraft ? '编辑草稿' : '编辑'}}
          </view>
          <view class="version-card__action version-card__action--danger" data-content-version-id="{{version._contentVersionId}}" bindtap="deleteVersion">删除</view>
        </view>
      </view>
    </block>

    <view class="version-page__safe"></view>
  </scroll-view>

</view>
