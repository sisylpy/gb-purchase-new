@import '../food-common.wxss';

/* -------------------------------------------------------------------------- */
/* 页面基础 */
/* -------------------------------------------------------------------------- */

.page-bg {
  background: var(--gb-bg-page, #f5f6f8);
  height: 100vh;
}

.content-scroll {
  flex: 1;
  height: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.page-bottom-pad {
  height: 40rpx;
}

.page-bottom-pad--editor {
  height: 150rpx;
}

.version-editor-intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0 18rpx;
  padding: 18rpx 20rpx;
  background: #eaf6f2;
  border: 1rpx solid #c8e5dd;
  border-radius: 16rpx;
}

.version-editor-intro__dish,
.version-editor-intro__sub {
  display: block;
}

.version-editor-intro__dish {
  color: #25302e;
  font-size: 29rpx;
  font-weight: 600;
}

.version-editor-intro__sub {
  margin-top: 5rpx;
  color: #617672;
  font-size: 23rpx;
}

.version-editor-intro__status {
  margin-left: 18rpx;
  padding: 5rpx 14rpx;
  color: #117765;
  font-size: 22rpx;
  white-space: nowrap;
  background: #fff;
  border-radius: 999rpx;
}

.version-editor-footer {
  position: fixed;
  z-index: 80;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e3e7e5;
  box-shadow: 0 -5rpx 18rpx rgba(0, 0, 0, 0.06);
}

.version-editor-footer__title,
.version-editor-footer__sub {
  display: block;
}

.version-editor-footer__title {
  color: #303739;
  font-size: 26rpx;
  font-weight: 600;
}

.version-editor-footer__sub {
  margin-top: 4rpx;
  color: #858e8c;
  font-size: 21rpx;
}

.version-editor-footer__save {
  min-width: 220rpx;
  height: 76rpx;
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 76rpx;
  text-align: center;
  background: #168d79;
  border-radius: 12rpx;
}

.version-editor-footer__save.is-disabled {
  color: #9aa29f;
  background: #edf0ef;
}

/* -------------------------------------------------------------------------- */
/* 顶部状态栏 */
/* -------------------------------------------------------------------------- */

.status-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx;
}

.status-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--gb-primary, #187e6e);
  margin-right: 10rpx;
  animation: pulse-dot 2s infinite;
}

@keyframes pulse-dot {
  0% { opacity: 1; }
  50% { opacity: 0.5; }
  100% { opacity: 1; }
}

.status-text {
  font-size: 26rpx;
  color: var(--gb-primary, #187e6e);
  font-weight: 500;
}

.status-days {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: 16rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(24, 126, 110, 0.08);
  border: 1rpx solid rgba(24, 126, 110, 0.15);
}

.status-days text {
  font-size: 22rpx;
  color: var(--gb-primary, #187e6e);
}

.status-days-arrow {
  margin-left: 4rpx;
  font-size: 18rpx;
}

.status-days--hover {
  opacity: 0.75;
}

.status-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--gb-primary, #187e6e);
  background: #fff;
  border: 1rpx solid rgba(24, 126, 110, 0.25);
  border-radius: 999rpx;
}

.status-right--hover {
  opacity: 0.88;
  background: rgba(24, 126, 110, 0.05);
}

/* -------------------------------------------------------------------------- */
/* 售价/成本/毛利率卡片 */
/* -------------------------------------------------------------------------- */

.kpi-card {
  margin: 8rpx 0 20rpx;
  padding: 28rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.kpi-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.kpi-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.kpi-label {
  font-size: 24rpx;
  color: var(--gb-text-secondary, #666);
  margin-bottom: 12rpx;
}

.kpi-value-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-wrap: nowrap;
}

.kpi-symbol {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gb-text, #333);
  margin-right: 4rpx;
}

.kpi-symbol--cost {
  color: var(--gb-primary, #187e6e);
}

.kpi-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--gb-text, #333);
  line-height: 1.2;
}

.kpi-value--cost {
  color: var(--gb-primary, #187e6e);
}

.kpi-value--rate {
  color: var(--gb-primary, #187e6e);
}

.kpi-edit-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 10rpx;
  opacity: 0.5;
}

.kpi-divider {
  width: 1rpx;
  align-self: stretch;
  min-height: 60rpx;
  background: var(--gb-border-soft, #eee);
  margin: 0 8rpx;
}

/* -------------------------------------------------------------------------- */
/* 收益卡片 */
/* -------------------------------------------------------------------------- */

.profit-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.profit-left {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.profit-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 26rpx;
  color: var(--gb-text-secondary, #666);
  margin-bottom: 12rpx;
}

.profit-info-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  border: 1rpx solid var(--gb-border, #ccc);
  background: #fff;
}

.profit-info-i {
  font-size: 20rpx;
  color: var(--gb-text-muted, #999);
  font-style: italic;
  font-family: serif;
  line-height: 1;
}

.profit-amount {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.profit-symbol {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gb-primary, #187e6e);
  margin-right: 4rpx;
}

.profit-num {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--gb-primary, #187e6e);
  line-height: 1.1;
}

.profit-tag {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  align-self: flex-start;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.profit-tag--good {
  color: var(--gb-primary, #187e6e);
  background: rgba(24, 126, 110, 0.1);
}

.profit-tag--normal {
  color: #e6a23c;
  background: rgba(230, 162, 60, 0.12);
}

.profit-tag--bad {
  color: #f56c6c;
  background: rgba(245, 108, 108, 0.12);
}

.profit-tag-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.profit-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.donut-canvas {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
}

.donut-legend {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
  max-width: 220rpx;
}

.legend-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8rpx;
}

.legend-item:last-child {
  margin-bottom: 0;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.legend-name {
  flex: 1;
  font-size: 22rpx;
  color: var(--gb-text-secondary, #666);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.legend-ratio {
  font-size: 22rpx;
  color: var(--gb-text-muted, #999);
  margin-left: 8rpx;
  flex-shrink: 0;
}

/* -------------------------------------------------------------------------- */
/* 提示条 */
/* -------------------------------------------------------------------------- */

.hint-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  background: rgba(24, 126, 110, 0.06);
  border-radius: 12rpx;
  border: 1rpx solid rgba(24, 126, 110, 0.1);
}

.hint-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.hint-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.hint-text {
  font-size: 24rpx;
  color: var(--gb-text-secondary, #666);
}

.hint-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.hint-update {
  font-size: 22rpx;
  color: var(--gb-text-muted, #999);
  margin-right: 8rpx;
}

.hint-refresh {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
}

.hint-refresh-arrow {
  font-size: 24rpx;
  color: var(--gb-text-muted, #999);
  line-height: 1;
}

/* -------------------------------------------------------------------------- */
/* 配料清单区域 */
/* -------------------------------------------------------------------------- */

.raw-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 20rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.raw-section-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.raw-section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gb-text, #333);
  flex-shrink: 0;
}

.raw-section-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.raw-section-add {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 22rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #fff;
  background: var(--gb-primary, #187e6e);
  border-radius: 999rpx;
}

.raw-section-add--preparation {
  color: var(--gb-primary, #187e6e);
  background: #e8f5f2;
}

.raw-section-add--hover {
  opacity: 0.88;
}

.raw-section-add-plus {
  font-size: 30rpx;
  margin-right: 6rpx;
  line-height: 1;
}

.raw-section-version {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 9rpx 17rpx;
  color: var(--gb-primary, #187e6e);
  font-size: 24rpx;
  line-height: 1.4;
  background: #edf7f4;
  border: 1rpx solid #cbe7df;
  border-radius: 999rpx;
}

.raw-section-version__arrow {
  margin-left: 5rpx;
  font-size: 28rpx;
  line-height: 1;
}

.raw-section-version--hover {
  opacity: 0.75;
}

/* 空状态 */
.food-raw-empty {
  padding: 48rpx 36rpx 56rpx;
  text-align: center;
  background: var(--gb-bg-page, #f5f6f8);
  border-radius: 16rpx;
  border: 1rpx dashed var(--gb-border, #ddd);
  margin-bottom: 16rpx;
}

.food-raw-empty__text {
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--gb-text-muted, #999);
}

/* 配料列表 */
.raw-list {
  display: flex;
  flex-direction: column;
}

.raw-list-header {
  display: flex;
  flex-direction: column;
  padding: 12rpx 8rpx;
  border-bottom: 1rpx solid var(--gb-border-soft, #eee);
  margin-bottom: 8rpx;
}

.raw-list-header--readonly {
  flex-direction: row;
  align-items: center;
}

.raw-list-header--readonly .raw-header-cell--info {
  flex: 1;
  min-width: 0;
}

.raw-list-header--readonly .raw-header-cell--amount {
  width: 150rpx;
}

.raw-list-header--readonly .raw-header-cell--cost {
  width: 120rpx;
}

.raw-list-header--readonly .raw-header-cell--ratio {
  width: 75rpx;
}

.raw-list-header-top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.raw-list-header-bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
  padding-left: 96rpx;
}

.raw-list-header-bottom .raw-header-cell--amount {
  flex: 1;
  min-width: 0;
}

.raw-list-header-bottom .raw-header-cell--cost {
  width: 130rpx;
}

.raw-list-header-bottom .raw-header-cell--ratio {
  width: 90rpx;
}

.raw-header-cell {
  text-align: center;
}

.raw-header-cell--info {
  flex: 1;
  min-width: 0;
  text-align: left;
  padding-left: 8rpx;
}

.raw-header-cell--amount {
  width: 220rpx;
}

.raw-header-cell--cost {
  width: 130rpx;
}

.raw-header-cell--ratio {
  width: 90rpx;
}

.raw-header-cell--action {
  width: 100rpx;
}

.raw-header-text {
  display: block;
  font-size: 22rpx;
  color: var(--gb-text-secondary, #666);
}

.raw-header-sub {
  display: block;
  font-size: 20rpx;
  color: var(--gb-text-muted, #999);
  margin-top: 2rpx;
}

/* 配料行 */
.raw-item {
  display: flex;
  flex-direction: column;
  padding: 16rpx 8rpx;
  border-bottom: 1rpx solid var(--gb-border-soft, #f0f0f0);
}

.raw-item--readonly {
  flex-direction: row;
  align-items: center;
}

.raw-item--readonly .raw-item-top {
  flex: 1;
  min-width: 0;
}

.raw-item--readonly .raw-item-bottom {
  width: 345rpx;
  margin-top: 0;
  padding-left: 0;
  flex-shrink: 0;
}

.raw-item--readonly .raw-item-bottom .raw-item-amount {
  width: 150rpx;
  flex: none;
}

.raw-item--readonly .raw-item-bottom .raw-item-cost {
  width: 120rpx;
}

.raw-item--readonly .raw-item-bottom .raw-item-ratio {
  width: 75rpx;
}

.raw-item--readonly .stepper-unit {
  margin-right: 0;
}

.raw-item-top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.raw-item-bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 12rpx;
  padding-left: 96rpx;
}

.raw-item-bottom .raw-item-amount {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.raw-item-bottom .raw-item-cost {
  width: 130rpx;
  text-align: center;
  flex-shrink: 0;
}

.raw-item-bottom .raw-item-ratio {
  width: 90rpx;
  text-align: center;
  flex-shrink: 0;
}

.raw-item:last-child {
  border-bottom: none;
}

.raw-item-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.raw-item-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: var(--gb-bg-gray, #f0f0f0);
  flex-shrink: 0;
  margin-right: 16rpx;
}

.raw-item-img--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gb-text-tertiary, #9aa39f);
  font-size: 24rpx;
}

.raw-item-preparation-img {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  background: var(--gb-primary, #187e6e);
  flex-shrink: 0;
}

.raw-item-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.raw-item-name-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.raw-item-kind {
  margin-right: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  color: var(--gb-primary, #187e6e);
  font-size: 20rpx;
  line-height: 1.4;
  background: #e8f5f2;
  flex-shrink: 0;
}

.raw-item-name {
  display: block;
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--gb-text, #333);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.raw-item-price {
  font-size: 26rpx;
  color: var(--gb-text-muted, #999);
  margin-top: 4rpx;
}

.raw-item-amount {
  width: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stepper {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.stepper-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--gb-primary, #187e6e);
  background: rgba(24, 126, 110, 0.08);
}

.stepper-btn--minus {
  color: var(--gb-text-muted, #999);
  background: rgba(0, 0, 0, 0.04);
}

.stepper-btn--hover {
  opacity: 0.7;
}

.stepper-value {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--gb-text, #333);
  font-weight: 500;
  padding: 0 8rpx;
}

.stepper-unit {
  font-size: 22rpx;
  color: var(--gb-text-secondary, #666);
  margin-right: 8rpx;
}

.raw-item-cost {
  width: 130rpx;
  text-align: center;
  flex-shrink: 0;
}

.raw-cost-text {
  font-size: 26rpx;
  color: var(--gb-primary, #187e6e);
  font-weight: 500;
}

.raw-item-ratio {
  width: 90rpx;
  text-align: center;
  flex-shrink: 0;
}

.raw-ratio-text {
  font-size: 26rpx;
  color: var(--gb-text, #333);
  font-weight: 600;
}

.raw-item-action {
  width: 100rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-left: 4rpx;
  border-radius: 10rpx;
  background: var(--gb-bg-page, #f5f6f8);
}

.action-btn--delete {
  background: rgba(255, 59, 48, 0.06);
}

.action-btn--hover {
  opacity: 0.8;
}

.action-icon {
  width: 28rpx;
  height: 28rpx;
}

/* -------------------------------------------------------------------------- */
/* 原料列表主区域（兼容旧样式） */
/* -------------------------------------------------------------------------- */

.food-raw-section {
  padding: 8rpx 0 16rpx;
}

.food-raw-section__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx 12rpx;
}

.food-raw-section__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gb-text);
}

.food-raw-section__add {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--gb-primary);
  background: var(--gb-bg-light);
  border: 1rpx solid rgba(24, 126, 110, 0.25);
  border-radius: 999rpx;
}

.food-raw-section__add--hover {
  opacity: 0.88;
}

.food-raw-section__add-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.food-raw-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid var(--gb-border-soft);
}

.food-raw-row:last-child {
  border-bottom: none;
}

.food-raw-row__body {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
