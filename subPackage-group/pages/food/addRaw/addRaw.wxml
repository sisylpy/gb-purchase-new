<view class="flex flex-column page-bg">

  <back-navbar title="{{versionEditorMode ? (currentRecipeVersionView ? '编辑配方版本' : '新建配方版本') : foodItem.dishName}}" avatar="/images/back.png" style="height: {{navBarHeight}}rpx;" bindnavbuttontap="toBack"></back-navbar>

  <scroll-view scroll-y class="content-scroll">
    <!-- 售价/成本/毛利率卡片 -->
    <view class="kpi-card">
      <view class="kpi-row">
        <view class="kpi-cell">
          <text class="kpi-label">当前售价</text>
          <view class="kpi-value-wrap">
            <text class="kpi-symbol">¥</text>
            <text class="kpi-value">{{foodItem.salePrice || '0.00'}}</text>
            <image src="/images/edit.png" class="kpi-edit-icon" mode="aspectFit" bindtap="toChangePrice"></image>
          </view>
        </view>
        <view class="kpi-divider"></view>
        <view class="kpi-cell">
          <text class="kpi-label">当前配方成本（每份）</text>
          <view class="kpi-value-wrap">
            <text class="kpi-symbol kpi-symbol--cost">¥</text>
            <text class="kpi-value kpi-value--cost">{{totalCostComplete === false ? '—' : (totalCost || '0.00')}}</text>
          </view>
        </view>
        <view class="kpi-divider"></view>
        <view class="kpi-cell">
          <text class="kpi-label">理论毛利率</text>
          <view class="kpi-value-wrap">
            <text class="kpi-value kpi-value--rate">{{grossMarginRate === '—' ? '—' : (grossMarginRate || '0.0') + '%'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="hint-bar cost-missing-hint" wx:if="{{totalCostComplete === false}}">
      <view class="hint-left"><text class="hint-text">{{costMissingReason || '部分配料缺少可靠成本依据'}}，完整理论成本和毛利暂不显示为 0。</text></view>
    </view>

    <!-- 收益卡片 -->
    <view class="profit-card">
      <view class="profit-left">
        <view class="profit-title">
          <text>每份大约能赚</text>
          <view class="profit-info-icon" bindtap="showProfitHint">
            <text class="profit-info-i">i</text>
          </view>
        </view>
        <view class="profit-amount">
          <text class="profit-symbol">¥</text>
          <text class="profit-num">{{totalCostComplete === false ? '—' : (profit || '0.00')}}</text>
        </view>
        <view class="profit-tag {{profitLevelClass}}">
          <text class="profit-tag-icon">👍</text>
          <text class="profit-tag-text">{{profitHint || '做得好！毛利表现优秀'}}</text>
        </view>
      </view>
      <view class="profit-right">
        <!-- <canvas type="2d" id="donutChart" class="donut-canvas"></canvas> -->
        <view class="donut-legend">
          <view class="legend-item" wx:for="{{rawArr}}" wx:for-item="raw" wx:for-index="idx" wx:key="gbDistributerFoodGoodsId" wx:if="{{idx < 4}}">
            <view class="legend-dot" style="background-color: {{pieColors[idx % pieColors.length]}};"></view>
            <text class="legend-name">{{raw.gbDfgGoodsName}}</text>
            <text class="legend-ratio">{{raw._ratio === '—' ? '—' : raw._ratio + '%'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 提示条 -->
    <view class="hint-bar" wx:if="{{versionEditorMode}}">
      <view class="hint-left">
        <image src="/images/icon.png" class="hint-icon" mode="aspectFit"></image>
        <text class="hint-text">按适用时间 {{versionCostScopeText}} 内的真实入库加权测算；有效期内无入库则不显示成本</text>
      </view>
      <view class="hint-right" bindtap="refreshData">
        <text class="hint-update">上次更新：刚刚</text>
        <view class="hint-refresh">
          <view class="hint-refresh-arrow">↻</view>
        </view>
      </view>
    </view>

    <view class="unified-edit-card" wx:if="{{versionEditorMode}}">
      <view class="unified-edit-card__head">
        <view>
          <text class="unified-edit-card__title">门店使用时间</text>
          <text class="unified-edit-card__sub">选择一段现有时间进行修改，或为该版本设置新时间</text>
        </view>
        <text class="unified-edit-card__version">V{{currentRecipeVersionView.versionNo || '-'}}</text>
      </view>

      <scroll-view scroll-x class="managed-intervals" wx:if="{{managedVersionIntervals.length}}">
        <view class="managed-intervals__track">
          <view wx:for="{{managedVersionIntervals}}" wx:key="id"
            class="managed-interval {{managedIntervalId == item.id ? 'is-selected' : ''}}"
            data-interval-id="{{item.id}}" bindtap="selectManagedInterval">
            <text class="managed-interval__label">适用时间</text>
            <text class="managed-interval__period">{{item._periodText}}</text>
          </view>
        </view>
      </scroll-view>
      <text class="managed-intervals__empty" wx:else>该版本尚未设置门店使用时间</text>

      <view class="version-usage-row">
        <text class="version-usage-row__label">开始营业日</text>
        <picker mode="date" value="{{versionUsageStart}}"
          start="{{!manageVersionId ? minimumNewVersionStart : ''}}"
          bindchange="onVersionUsageStartChange">
          <view class="version-usage-row__value">{{versionUsageStart}} ›</view>
        </picker>
      </view>
      <view class="version-usage-duration">
        <text class="version-usage-row__label">使用期限</text>
        <view class="version-usage-duration__options">
          <view class="version-usage-duration__option {{!versionUsageHasEnd ? 'is-selected' : ''}}"
            data-has-end="0" bindtap="chooseVersionUsageDuration">
            <text class="version-usage-duration__title">持续使用</text>
            <text class="version-usage-duration__hint">不设置停止日期</text>
          </view>
          <view class="version-usage-duration__option {{versionUsageHasEnd ? 'is-selected' : ''}}"
            data-has-end="1" bindtap="chooseVersionUsageDuration">
            <text class="version-usage-duration__title">设置停止日期</text>
            <text class="version-usage-duration__hint">停止日当天不再使用</text>
          </view>
        </view>
      </view>
      <view class="version-usage-row" wx:if="{{versionUsageHasEnd}}">
        <text class="version-usage-row__label">停止营业日</text>
        <picker mode="date" value="{{versionUsageEnd}}" bindchange="onVersionUsageEndChange">
          <view class="version-usage-row__value">{{versionUsageEnd}} ›</view>
        </picker>
      </view>
      <view class="version-usage-reason">
        <text class="version-usage-row__label">修改原因</text>
        <input class="version-usage-reason__input" value="{{versionUsageReason}}" maxlength="200"
          bindinput="onVersionUsageReasonInput" placeholder="例如：从今天起加入盐" />
      </view>
      <view class="unified-impact" wx:if="{{versionUsagePreview}}">
        <text class="unified-impact__title">影响预览</text>
        <text class="unified-impact__line">影响营业日：{{versionUsagePreview._affectedText}}</text>
        <text class="unified-impact__line">将替换 {{versionUsagePreview.supersededIntervalIds.length}} 段旧区间，调整后共 {{versionUsagePreview._afterTimeline.length}} 段有效时间</text>
        <text class="unified-impact__line" wx:if="{{versionUsageReplacementPreview}}">采购商品包装替换已一并预览，将与配方时间在同一次确认中保存。</text>
        <text class="unified-impact__warning" wx:if="{{versionUsagePreview._gapCount}}">调整后存在 {{versionUsagePreview._gapCount}} 个时间空档，空档日期的完整成本保持“—”。</text>
        <view class="unified-impact__timeline" wx:for="{{versionUsagePreview._afterTimeline}}" wx:key="_key">
          <text>{{item._versionLabel}}</text><text>{{item._periodText}}</text>
        </view>
        <view class="unified-impact__cost" wx:if="{{versionUsagePreview.costImpact}}">
          <view class="unified-impact__cost-head">
            <text>历史理论成本</text>
            <text>{{versionUsagePreview.costImpact.affectedSalesRecordCount}} 条销量记录</text>
          </view>
          <text class="unified-impact__date">{{versionUsagePreview.costImpact._dateText}} · {{versionUsagePreview.costImpact._salesText}}</text>
          <view class="unified-impact__grid">
            <view><text>原完整成本</text><text>{{versionUsagePreview.costImpact._oldCostText}}</text></view>
            <view><text>新完整成本</text><text>{{versionUsagePreview.costImpact._newCostText}}</text></view>
            <view><text>成本差额</text><text>{{versionUsagePreview.costImpact._differenceText}}</text></view>
          </view>
          <text class="unified-impact__warning" wx:if="{{versionUsagePreview.costImpact._hasIncomplete}}">部分日期缺少配方、价格或换算，不会按0元计算。</text>
        </view>
      </view>
    </view>

    <!-- 配料清单 -->
    <view class="raw-section">
      <view class="raw-section-header" bindtap="onRecipeHeaderTap"
        hover-class="{{!versionEditorMode ? 'raw-section-header--hover' : 'none'}}">
        <view class="raw-section-title-wrap">
          <text class="raw-section-title">{{versionEditorMode ? '配方内容（' + rawArr.length + '）' : (versionedMode ? (currentRecipeVersionView ? '当前配方 V' + currentRecipeVersionView.versionNo : '当前无适用配方') : '原配料清单（' + rawArr.length + '）')}}</text>
          <text class="raw-section-period" wx:if="{{!versionEditorMode && versionedMode && currentRecipeVersionView && versionCostBasisDate}}">开始日期：{{versionCostBasisDate}}</text>
        </view>
        <view class="raw-section-actions" wx:if="{{versionEditorMode}}">
          <view class="raw-section-add raw-section-add--preparation" bindtap="toAddPreparation" hover-class="raw-section-add--hover">
            <text class="raw-section-add-plus">+</text>
            <text>添加中间料</text>
          </view>
          <view class="raw-section-add" bindtap="toAddGoods" data-type="raw" hover-class="raw-section-add--hover">
            <text class="raw-section-add-plus">+</text>
            <text>添加配料</text>
          </view>
        </view>
        <view
          class="raw-section-version"
          wx:elif="{{versionedMode}}"
          hover-class="raw-section-version--hover"
        >
          <text>配方版本管理</text>
          <text class="raw-section-version__arrow">›</text>
        </view>
        <view
          class="raw-section-version"
          wx:else
          hover-class="raw-section-version--hover"
        >
          <text>建立配方版本</text>
          <text class="raw-section-version__arrow">›</text>
        </view>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{!rawArr.length}}" class="food-raw-empty">
        <text class="food-raw-empty__text">{{versionEditorMode ? '暂无配方内容，可添加采购原料或已完成的中间料' : '当前版本暂无配方内容'}}</text>
      </view>

      <!-- 配料列表 -->
      <view wx:else class="raw-list {{versionEditorMode ? 'raw-list--editor' : 'raw-list--readonly'}}">
        <!-- 表头 -->
        <view class="raw-list-header {{versionEditorMode ? '' : 'raw-list-header--readonly'}}">
          <block wx:if="{{versionEditorMode}}">
            <view class="raw-list-header-top">
              <view class="raw-header-cell raw-header-cell--info">
                <text class="raw-header-text">配料信息</text>
              </view>
              <view class="raw-header-cell raw-header-cell--action"></view>
            </view>
            <view class="raw-list-header-bottom">
              <view class="raw-header-cell raw-header-cell--amount">
                <text class="raw-header-text">用量（每份）</text>
              </view>
              <view class="raw-header-cell raw-header-cell--cost">
                <text class="raw-header-text">成本（每份）</text>
              </view>
              <view class="raw-header-cell raw-header-cell--ratio">
                <text class="raw-header-text">占比</text>
              </view>
            </view>
          </block>
          <block wx:else>
            <view class="raw-header-cell raw-header-cell--info">
              <text class="raw-header-text">配料信息</text>
            </view>
            <view class="raw-header-cell raw-header-cell--amount">
              <text class="raw-header-text">每份用量</text>
            </view>
            <view class="raw-header-cell raw-header-cell--cost">
              <text class="raw-header-text">每份成本</text>
            </view>
            <view class="raw-header-cell raw-header-cell--ratio">
              <text class="raw-header-text">占比</text>
            </view>
          </block>
        </view>

        <!-- 数据行 -->
        <view wx:for="{{rawArr}}" wx:for-item="raw" wx:for-index="rawIdx" wx:key="gbDistributerFoodGoodsId" class="raw-item {{versionEditorMode ? 'raw-item--editor' : 'raw-item--readonly'}}">
          <!-- 第一行：图片 + 名称/单价 + 操作 -->
          <view class="raw-item-top">
            <view class="raw-item-main">
              <view class="raw-item-preparation-img" wx:if="{{raw._isPreparation}}">中</view>
              <image
                wx:elif="{{raw._imageUrl}}"
                class="raw-item-img"
                src="{{raw._imageUrl}}"
                mode="aspectFill"
              />
              <view wx:else class="raw-item-img raw-item-img--placeholder">原</view>
              <view class="raw-item-info">
                <view class="raw-item-name-line">
                  <text class="raw-item-kind" wx:if="{{raw._isPreparation}}">中间料</text>
                  <text class="raw-item-name">{{raw.gbDfgGoodsName}}</text>
                </view>
                <text class="raw-item-price">{{raw._isPreparation || raw._isVersioned ? raw._packPriceLabel : (raw._packPriceLabel === '成本待计算' ? raw._packPriceLabel : '¥' + raw._packPriceLabel)}}</text>
              </view>
            </view>
            <view class="raw-item-action" wx:if="{{versionEditorMode}}">
              <!-- <view class="action-btn" bindtap="editGoods" data-item="{{raw}}" hover-class="action-btn--hover">
                <image src="/images/edit.png" class="action-icon" mode="aspectFit"></image>
              </view> -->
              <view class="action-btn action-btn--delete" bindtap="deleteGoods" data-index="{{rawIdx}}" hover-class="action-btn--hover">
                <image src="/images/del.png" class="action-icon" mode="aspectFit"></image>
              </view>
            </view>
          </view>

          <!-- 第二行：用量 + 成本 + 占比 -->
          <view class="raw-item-bottom">
            <view class="raw-item-amount">
              <view class="stepper">
                <view wx:if="{{versionEditorMode}}" class="stepper-btn stepper-btn--minus" bindtap="onMinusAmount" data-index="{{rawIdx}}" hover-class="stepper-btn--hover">-</view>
                <text class="stepper-value">{{raw._displayAmount}}</text>
                <text class="stepper-unit">{{raw._displayUnit}}</text>
                <view wx:if="{{versionEditorMode}}" class="stepper-btn stepper-btn--plus" bindtap="onPlusAmount" data-index="{{rawIdx}}" hover-class="stepper-btn--hover">+</view>
              </view>
            </view>
            <view class="raw-item-cost">
              <text class="raw-cost-text">{{raw._costAvailable === false ? '—' : '¥' + raw._cost}}</text>
            </view>
            <view class="raw-item-ratio">
              <text class="raw-ratio-text">{{raw._ratio === '—' ? '—' : raw._ratio + '%'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="version-delete-card" wx:if="{{versionEditorMode && manageVersionId}}">
      <view>
        <text class="version-delete-card__title">删除这个版本</text>
        <text class="version-delete-card__hint">用于删除尚未投入使用的误建版本；已被新版本完整覆盖的旧版本会在成本重算成功后自动清理。</text>
      </view>
      <view class="version-delete-card__button {{versionDeleting ? 'is-disabled' : ''}}" bindtap="deleteRecipeVersion">
        {{versionDeleting ? '删除中…' : '删除版本'}}
      </view>
    </view>
    <view class="page-bottom-pad {{versionEditorMode ? 'page-bottom-pad--editor' : ''}}"></view>
  </scroll-view>
  <view class="version-editor-footer" wx:if="{{versionEditorMode}}">
    <view class="version-editor-footer__summary">
      <text class="version-editor-footer__title">{{versionUsagePreview ? '影响已预览' : '编辑配方 V' + (currentRecipeVersionView.versionNo || '-')}}</text>
      <text class="version-editor-footer__sub">{{rawArr.length}} 项配料{{versionDraftDirty ? ' · 内容已修改，将保存为本版本的新修订' : ' · 可只修改使用时间'}}</text>
    </view>
    <view class="version-editor-footer__save" bindtap="saveNewRecipeVersion">
      {{versionUsageConfirming ? '确认中…' : (recipeSaving ? '预览中…' : (versionUsagePreview ? '确认保存' : '预览并保存'))}}
    </view>
  </view>
</view>

<!-- 添加 / 编辑中间料：中间料作为一个整体使用，只填写菜品每份用量 -->
<view class="food-search-modal" wx:if="{{showPreparation}}" catchtouchmove="stopMove" bindtap="dismissKeyboard">
  <view class="food-search-modal__panel preparation-modal__panel" catchtap="stopTap">
    <view class="food-search-modal__head">
      <text class="food-search-modal__title">{{preparationModalType == 'edit' ? '编辑中间料用量' : '添加中间料'}}</text>
    </view>

    <scroll-view scroll-y class="preparation-modal__scroll" catchtouchmove="stopMove" bindscroll="dismissKeyboard">
      <block wx:if="{{!selectedPreparation}}">
        <view class="raw-add-modal__search">
          <image class="raw-add-modal__search-icon" src="/images/search-3.png" mode="aspectFit" />
          <input
            class="raw-add-modal__search-input"
            placeholder="搜索中间料名称"
            placeholder-style="color: #999; font-size: 28rpx;"
            bindinput="onPreparationKeywordInput"
            bindconfirm="dismissKeyboard"
            confirm-type="done"
            value="{{preparationKeyword}}"
          />
        </view>

        <view class="preparation-modal__loading" wx:if="{{preparationLoading}}">正在加载中间料…</view>
        <view class="preparation-modal__empty" wx:elif="{{!filteredPreparationProducts.length}}">
          {{preparationKeyword ? '没有找到匹配的中间料' : '暂无已完成标准配方的中间料'}}
        </view>
        <view wx:else class="preparation-modal__list">
          <view
            wx:for="{{filteredPreparationProducts}}"
            wx:for-item="product"
            wx:key="id"
            class="preparation-modal__item"
            data-item="{{product}}"
            bindtap="selectPreparation"
            hover-class="preparation-modal__item--hover"
          >
            <view class="preparation-modal__item-icon">中</view>
            <view class="preparation-modal__item-info">
              <text class="preparation-modal__item-name">{{product.productName}}</text>
              <text class="preparation-modal__item-code">标准配方 {{product.ingredientCount}} 种原料 · 标准产出 {{product.standardOutputText}}</text>
            </view>
            <text class="preparation-modal__item-status">选择</text>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="preparation-modal__picked">
          <view class="preparation-modal__picked-icon">中</view>
          <view class="preparation-modal__picked-info">
            <text class="preparation-modal__picked-name">{{selectedPreparation.productName}}</text>
            <text class="preparation-modal__picked-code">{{selectedPreparation.ingredientCount}} 种原料 · 标准产出 {{selectedPreparation.standardOutputText}}</text>
          </view>
          <text
            class="preparation-modal__reselect"
            wx:if="{{preparationModalType != 'edit'}}"
            bindtap="clearSelectedPreparation"
          >重选</text>
        </view>

        <view class="preparation-modal__form">
          <text class="preparation-modal__label">每份用量</text>
          <view class="preparation-modal__amount">
            <view class="preparation-modal__step-btn" bindtap="onPreparationAmountMinus" hover-class="preparation-modal__step-btn--hover">-</view>
            <input
              class="preparation-modal__amount-input"
              type="digit"
              value="{{preparationAmount}}"
              bindinput="onPreparationAmountInput"
              bindconfirm="dismissKeyboard"
              confirm-type="done"
            />
            <text class="preparation-modal__unit">{{preparationAmountUnitLabel}}</text>
            <view class="preparation-modal__step-btn" bindtap="onPreparationAmountPlus" hover-class="preparation-modal__step-btn--hover">+</view>
          </view>
        </view>

        <view class="preparation-modal__hint">
          <text class="preparation-modal__hint-icon">i</text>
          <text>菜品只填写每份中间料用量；经营分析会按中间料配比自动展开到底层采购原料。</text>
        </view>
      </block>
    </scroll-view>

    <view class="food-search-modal__footer">
      <view class="food-search-modal__actions">
        <view class="cancel-btn" bindtap="cancelPreparation" hover-class="hoverBtn">取消</view>
        <view class="confirm-btn" catchtap="confirmPreparation" hover-class="hoverBtn">
          {{preparationModalType == 'edit' ? '确认保存' : '确认添加'}}
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 添加 / 编辑原料（支持最小单位用量与包装换算） -->
<view class="food-search-modal" wx:if="{{showFood}}" catchtouchmove="stopMove" bindtap="dismissKeyboard">
  <view
    class="food-search-modal__panel raw-add-modal__panel"
    style="margin-top: {{foodSearchModalPadTopRpx}}rpx; max-height: {{foodSearchModalPanelMaxRpx}}rpx;"
    catchtap="stopTap"
  >
    <view class="food-search-modal__head">
      <text class="food-search-modal__title">{{modalType == 'edit' ? '编辑原料' : '添加原料'}}</text>
    </view>

    <scroll-view scroll-y class="raw-add-modal__scroll" catchtouchmove="stopMove" bindscroll="dismissKeyboard">
      <!-- 搜索（仅添加原料；编辑时不允许换商品） -->
      <block wx:if="{{modalType != 'edit'}}">
        <view class="raw-add-modal__search">
          <image class="raw-add-modal__search-icon" src="/images/search-3.png" mode="aspectFit" />
          <input
            class="raw-add-modal__search-input"
            placeholder="搜索商品名称、简拼或全拼"
            placeholder-style="color: #999; font-size: 28rpx;"
            adjust-position="{{false}}"
            confirm-type="{{searchKeyword ? 'search' : 'done'}}"
            bindinput="onSearchKeywordInput"
            bindconfirm="onSearchConfirm"
            value="{{searchKeyword}}"
          />
          <view
            wx:if="{{searchKeyword}}"
            class="raw-add-modal__search-clear"
            bindtap="clearSearchKeyword"
            hover-class="raw-add-modal__search-clear--hover"
          >×</view>
        </view>

        <!-- 搜索结果 -->
        <view class="food-search-modal__scroll-wrap searchPart {{isSearching ? 'is-active' : ''}}" wx:if="{{isSearching}}">
        <scroll-view
          scroll-y
          class="searchList is-active"
          catchtouchmove="stopMove"
          bindscroll="dismissKeyboard"
          style="height: {{strArr.length ? (strArr.length < 6 ? strArr.length * 108 : foodSearchScrollRpx) : 120}}rpx;"
        >
          <view
            class="food-raw-search-row"
            wx:for="{{strArr}}"
            wx:for-item="goods"
            wx:key="gbDistributerGoodsId"
          >
            <text class="food-raw-search-row__idx">{{index + 1}}.</text>
            <view class="food-raw-search-row__content">
              <view class="food-raw-search-row__line">
                <text class="brand" wx:if="{{goods.gbDgGoodsBrand && goods.gbDgGoodsBrand.length > 0 && goods.gbDgGoodsBrand !== 'null'}}">{{goods.gbDgGoodsBrand}}</text>
                <text class="gray" wx:if="{{goods.gbDgPullOff == 1}}">(下架) {{goods.gbDgGoodsName}}</text>
                <text wx:else class="food-raw-search-row__name">{{goods.gbDgGoodsName}}</text>
                <block wx:if="{{goods.gbDgGoodsStandardWeight !== 'null' && goods.gbDgGoodsStandardWeight.length > 0}}">
                  <text class="food-raw-search-row__spec">（{{goods.gbDgGoodsStandardWeight}}/{{goods.gbDgGoodsStandardname}}）</text>
                </block>
                <block wx:else>
                  <text wx:if="{{goods.gbDgGoodsStandardname}}" class="food-raw-search-row__spec">（{{goods.gbDgGoodsStandardname}}）</text>
                </block>
              </view>
              <view class="flex-row">
                <text class="text-secondary">{{goods._searchPriceLabel}}:</text>
                <text wx:if="{{goods._searchPriceText}}">{{goods._searchPriceText}}</text>
                <text wx:else class="text-secondary">暂无单价</text>
              </view>
            </view>
            <view
              class="food-raw-search-row__select-btn"
              catchtap="applyGoods"
              data-item="{{goods}}"
              hover-class="food-raw-search-row__select-btn--hover"
            >选择</view>
          </view>
        </scroll-view>
        </view>
      </block>

      <!-- 已选商品 + 用量配置 -->
      <block wx:if="{{modalGoods && !isSearching}}">
        <view class="raw-add-modal__picked">
          <view class="raw-add-modal__picked-check">✓</view>
          <image
            class="raw-add-modal__picked-img"
            src="{{modalGoodsImg}}"
            mode="aspectFill"
          />
          <view class="raw-add-modal__picked-info">
            <text class="raw-add-modal__picked-name">{{modalGoods.gbDgGoodsName}}</text>
            <text class="raw-add-modal__picked-spec">{{modalPackLabel}}</text>
            <text class="raw-add-modal__picked-price">{{modalPackPriceTitle}} {{modalPackPriceLabel}}</text>
          </view>
        </view>

        <view class="raw-add-modal__form">
          <view
            class="raw-add-modal__row raw-add-modal__row--link {{modalGoodsSpecMissing ? 'raw-add-modal__row--warning' : ''}}"
            bindtap="toEditModalGoodsSpecification"
            hover-class="raw-add-modal__row--link-hover"
          >
            <text class="raw-add-modal__label">采购包装</text>
            <text class="raw-add-modal__value {{modalGoodsSpecMissing ? 'raw-add-modal__value--warning' : ''}}">
              {{modalGoodsSpecMissing ? '规格不完整，去补充' : modalPackLabel}}
            </text>
            <text class="raw-add-modal__arrow">›</text>
          </view>
          <view class="raw-add-modal__row">
            <text class="raw-add-modal__label">{{modalPackPriceTitle || '采购单价'}}</text>
            <text class="raw-add-modal__value raw-add-modal__value--price">{{modalPackPriceLabel}}</text>
            <text class="raw-add-modal__arrow">›</text>
          </view>
          <text class="raw-add-modal__price-note" wx:if="{{modalPriceReferenceOnly}}">商品参考价仅用于本页估算；正式历史理论成本仍按营业日的入库批次和单位换算证据核算。</text>
          <view class="raw-add-modal__row raw-add-modal__row--dosage">
            <text class="raw-add-modal__label">每份用量</text>
            <view class="raw-add-modal__dosage">
              <view class="raw-add-modal__stepper">
                <view class="raw-add-modal__step-btn" bindtap="onModalPortionMinus" hover-class="raw-add-modal__step-btn--hover">-</view>
                <input
                  class="raw-add-modal__step-input"
                  type="digit"
                  value="{{modalPortionAmount}}"
                  bindinput="onModalPortionInput"
                  bindconfirm="dismissKeyboard"
                  confirm-type="done"
                />
                <view class="raw-add-modal__step-btn" bindtap="onModalPortionPlus" hover-class="raw-add-modal__step-btn--hover">+</view>
              </view>
              <picker mode="selector" range="{{minUnitOptions}}" value="{{modalMinUnitIndex}}" bindtap="dismissKeyboard" bindchange="onMinUnitChange">
                <view class="raw-add-modal__unit-pick">
                  <text>{{modalMinUnit}}</text>
                  <text class="raw-add-modal__unit-arrow">▾</text>
                </view>
              </picker>
            </view>
          </view>
          <view class="raw-add-modal__row raw-add-modal__row--picker">
            <text class="raw-add-modal__label">最小单位</text>
            <picker mode="selector" range="{{minUnitOptions}}" value="{{modalMinUnitIndex}}" bindtap="dismissKeyboard" bindchange="onMinUnitChange">
              <view class="raw-add-modal__unit-pick raw-add-modal__unit-pick--wide">
                <text>{{modalMinUnit}}</text>
                <text class="raw-add-modal__unit-arrow">▾</text>
              </view>
            </picker>
          </view>
          <text class="raw-add-modal__hint" wx:if="{{modalBulkWeightPack}}">大包装（如 {{modalPackLabel}}）默认按「斤」计用量；也可改选 g，系统按 1斤=500g 换算</text>
          <text class="raw-add-modal__hint" wx:else>支持使用：g / ml / 张 / 个等；按斤买、按个用时请填「1斤=几个」</text>
          <view class="raw-add-modal__row raw-add-modal__row--conversion" wx:if="{{modalPackUnit && modalMinUnit !== modalPackUnit}}">
            <text class="raw-add-modal__label">换算关系<text class="raw-add-modal__required" wx:if="{{modalConversionRequired}}">*</text></text>
            <view class="raw-add-modal__conversion-col">
              <view class="raw-add-modal__conversion-edit {{modalConversionRequired && !modalPackQtyInMin ? 'raw-add-modal__conversion-edit--warn' : ''}}">
                <text class="raw-add-modal__conversion-prefix">1{{modalPackUnit}} =</text>
                <input
                  class="raw-add-modal__conversion-input"
                  type="digit"
                  placeholder="{{modalGoodsSpecMissing ? '先完善商品规格' : modalConversionPlaceholder}}"
                  value="{{modalPackQtyInMin}}"
                  disabled="{{modalGoodsSpecMissing}}"
                  bindinput="onConversionCountInput"
                  bindconfirm="dismissKeyboard"
                  confirm-type="done"
                />
                <text class="raw-add-modal__conversion-suffix">{{modalMinUnit}}</text>
              </view>
              <text class="raw-add-modal__conversion-warn" wx:if="{{modalGoodsSpecMissing}}">商品未配置可用规格，请点击上方“采购包装”进入商品详情补充规格重量</text>
              <text class="raw-add-modal__conversion-sub" wx:elif="{{modalPackEquivText}}">保存为 {{modalPackEquivText}}</text>
            </view>
          </view>
        </view>

        <view class="raw-add-modal__summary">
          <view class="raw-add-modal__summary-top">
            <view class="raw-add-modal__summary-cell">
              <text class="raw-add-modal__summary-icon">🧮</text>
              <view class="raw-add-modal__summary-text">
                <text class="raw-add-modal__summary-label">{{modalPriceReferenceOnly ? '每份参考成本 ≈' : '每份成本 ≈'}}</text>
                <text class="raw-add-modal__summary-num">¥ {{modalCostPerPortion}}</text>
              </view>
            </view>
            <view class="raw-add-modal__summary-divider"></view>
            <view class="raw-add-modal__summary-cell">
              <text class="raw-add-modal__summary-icon">📦</text>
              <view class="raw-add-modal__summary-text">
                <text class="raw-add-modal__summary-label">1{{modalPackUnit}}约可做</text>
                <text class="raw-add-modal__summary-num">{{modalPortionsPerPack}} 份</text>
              </view>
            </view>
          </view>
          <view class="raw-add-modal__summary-demo">{{modalDemoText}}</view>
          <view class="raw-add-modal__summary-tip">
            <text class="raw-add-modal__summary-tip-i">i</text>
            <text>{{modalBulkWeightPack ? '大包装按斤录入，成本按 1袋规格自动折算' : '支持大包装按最小单位自动折算成本'}}</text>
          </view>
        </view>

        <view class="raw-add-modal__quick" wx:if="{{modalQuickTags.length}}">
          <text class="raw-add-modal__quick-label">常用用量</text>
          <view class="raw-add-modal__quick-tags">
            <view
              wx:for="{{modalQuickTags}}"
              wx:for-item="tag"
              wx:key="value"
              class="raw-add-modal__quick-tag {{tag.active ? 'is-active' : ''}}"
              data-value="{{tag.value}}"
              bindtap="onQuickDosage"
              hover-class="raw-add-modal__quick-tag--hover"
            >{{tag.label}}</view>
          </view>
        </view>
      </block>
    </scroll-view>

    <view class="food-search-modal__footer">
      <view class="food-search-modal__actions">
        <view class="cancel-btn" bindtap="cancle" hover-class="hoverBtn">取消</view>
        <view class="confirm-btn" catchtap="confirm" hover-class="hoverBtn">{{modalType == 'edit' ? '确认保存' : '确认添加'}}</view>
      </view>
    </view>
  </view>
</view>
