<wxs src="../../../../utils/fn.wxs" module="tool" />

<!-- ========== 分类菜品经营列表（从分类卡片进入） ========== -->
<view wx:if="{{foodManageMode}}" class="dcl-page1 flex-column flex">
 
  <back-navbar title="{{manageFatherName}}" avatar="/images/back.png" style="height: {{navBarHeight}}rpx;" bindnavbuttontap="toBackManage"></back-navbar>

  <view class="food-menu-head">
      <view class="food-menu-head__left">
        <text class="food-menu-link" catchtap="renameFather">修改名称</text>
        <block wx:if="{{!dishes.length}}">
          <text class="food-menu-divider">|</text>
          <text class="food-menu-link" style="color: #ff3b30;" catchtap="deleteFather">删除父类</text>
        </block>
      </view>
      <view class="food-menu-action-btn food-menu-action-btn--cat" hover-class="food-menu-action-btn--hover" catchtap="addDishFromCategory">
        <text class="food-menu-action-btn__txt">添加菜品</text>
      </view>
    </view>
    
  <scroll-view scroll-y class="dcl-scroll mt-10" >

    <!-- 分类摘要条（突出毛利、成本差异、角色分布） -->
    <view class="dcl-summary-bar">
      <view class="dcl-summary-cell">
        <text class="dcl-summary-cell__label">菜品数</text>
        <text class="dcl-summary-cell__value">{{categorySummary.foodCount}}</text>
      </view>
      <view class="dcl-summary-cell">
        <text class="dcl-summary-cell__label">实际毛利率</text>
        <text class="dcl-summary-cell__value dcl-summary-cell__value--green">{{categorySummary.actualAverageGrossMarginRate}}</text>
      </view>
      <view class="dcl-summary-cell">
        <text class="dcl-summary-cell__label">理论毛利率</text>
        <text class="dcl-summary-cell__value dcl-summary-cell__value--blue">{{categorySummary.theoreticalAverageGrossMarginRate}}</text>
      </view>
      <view class="dcl-summary-cell">
        <text class="dcl-summary-cell__label">毛利率差</text>
        <text class="dcl-summary-cell__value dcl-summary-cell__value--warn">{{categorySummary.grossMarginGapRate}}</text>
      </view>
      <view class="dcl-summary-cell">
        <text class="dcl-summary-cell__label">实收额</text>
        <text class="dcl-summary-cell__value">¥{{categorySummary.totalSalesAmount}}</text>
      </view>
      <view class="dcl-summary-cell">
        <text class="dcl-summary-cell__label">实际利润</text>
        <text class="dcl-summary-cell__value">¥{{categorySummary.actualProfitAmount}}</text>
      </view>
      <!-- 角色分布 -->
      <view class="dcl-summary-cell dcl-summary-cell--wide" wx:if="{{categorySummary.starCount || categorySummary.trafficCount || categorySummary.potentialCount || categorySummary.watchCount}}">
        <text class="dcl-summary-cell__label">角色分布</text>
        <text class="dcl-role-mini dcl-role-mini--star" wx:if="{{categorySummary.starCount}}">★{{categorySummary.starCount}}</text>
        <text class="dcl-role-mini dcl-role-mini--traffic" wx:if="{{categorySummary.trafficCount}}">●{{categorySummary.trafficCount}}</text>
        <text class="dcl-role-mini dcl-role-mini--potential" wx:if="{{categorySummary.potentialCount}}">◆{{categorySummary.potentialCount}}</text>
        <text class="dcl-role-mini dcl-role-mini--watch" wx:if="{{categorySummary.watchCount}}">○{{categorySummary.watchCount}}</text>
      </view>
      <view class="dcl-summary-cell dcl-summary-cell--wide" wx:if="{{categorySummary.periodLabel}}">
        <text class="dcl-summary-cell__label">统计周期</text>
        <text class="dcl-summary-cell__period">{{categorySummary.periodLabel}} · 近30天</text>
      </view>
    </view>

    <!-- 搜索栏 -->
    <view class="dcl-search-bar">
      <image class="dcl-search-icon" src="/images/search-3.png" mode="aspectFit" />
      <input
        class="dcl-search-input"
        value="{{searchKeyword}}"
        placeholder="搜索菜品名称"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <text class="dcl-search-clear" wx:if="{{searchKeyword}}" bindtap="onSearchClear">×</text>
    </view>

    <!-- 角色筛选 -->
    <scroll-view scroll-x class="dcl-role-scroll" show-scrollbar="{{false}}">
      <view class="dcl-role-chips">
        <view
          class="dcl-role-chip {{activeRole === '' ? 'dcl-role-chip--on' : ''}}"
          bindtap="onRoleFilter"
          data-role=""
          hover-class="dcl-role-chip--hover"
        >
          <text>全部角色</text>
        </view>
        <view
          class="dcl-role-chip dcl-role-chip--star {{activeRole === 'STAR' ? 'dcl-role-chip--on' : ''}}"
          bindtap="onRoleFilter"
          data-role="STAR"
          hover-class="dcl-role-chip--hover"
        >
          <text>明星菜</text>
        </view>
        <view
          class="dcl-role-chip dcl-role-chip--traffic {{activeRole === 'TRAFFIC' ? 'dcl-role-chip--on' : ''}}"
          bindtap="onRoleFilter"
          data-role="TRAFFIC"
          hover-class="dcl-role-chip--hover"
        >
          <text>引流菜</text>
        </view>
        <view
          class="dcl-role-chip dcl-role-chip--potential {{activeRole === 'POTENTIAL' ? 'dcl-role-chip--on' : ''}}"
          bindtap="onRoleFilter"
          data-role="POTENTIAL"
          hover-class="dcl-role-chip--hover"
        >
          <text>潜力菜</text>
        </view>
        <view
          class="dcl-role-chip dcl-role-chip--watch {{activeRole === 'WATCH' ? 'dcl-role-chip--on' : ''}}"
          bindtap="onRoleFilter"
          data-role="WATCH"
          hover-class="dcl-role-chip--hover"
        >
          <text>观察菜</text>
        </view>
      </view>
    </scroll-view>

    <!-- 排序 -->
    <view class="dcl-sort-wrap">
      <text class="dcl-sort-label">排序</text>
      <scroll-view scroll-x class="dcl-sort-scroll" show-scrollbar="{{false}}">
        <view class="dcl-sort-chips">
          <view
            class="dcl-sort-chip {{sortBy === 'sales' ? 'dcl-sort-chip--on' : ''}}"
            bindtap="onSortBy"
            data-sort="sales"
            hover-class="dcl-sort-chip--hover"
          >
            <text>销量</text>
          </view>
          <view
            class="dcl-sort-chip {{sortBy === 'amount' ? 'dcl-sort-chip--on' : ''}}"
            bindtap="onSortBy"
            data-sort="amount"
            hover-class="dcl-sort-chip--hover"
          >
            <text>销售额</text>
          </view>
          <view
            class="dcl-sort-chip {{sortBy === 'profit' ? 'dcl-sort-chip--on' : ''}}"
            bindtap="onSortBy"
            data-sort="profit"
            hover-class="dcl-sort-chip--hover"
          >
            <text>实际利润</text>
          </view>
          <view
            class="dcl-sort-chip {{sortBy === 'margin' ? 'dcl-sort-chip--on' : ''}}"
            bindtap="onSortBy"
            data-sort="margin"
            hover-class="dcl-sort-chip--hover"
          >
            <text>毛利率</text>
          </view>
          <view
            class="dcl-sort-chip {{sortBy === 'costGap' ? 'dcl-sort-chip--on' : ''}}"
            bindtap="onSortBy"
            data-sort="costGap"
            hover-class="dcl-sort-chip--hover"
          >
            <text>成本异常</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 空状态 -->
    <view class="dcl-empty" wx:if="{{!dishes.length}}">
      <text>暂无符合条件的菜品</text>
    </view>

    <!-- 菜品卡片列表 -->
    <view class="dcl-list" wx:if="{{dishes.length}}">
      <view
        class="dcl-card"
        wx:for="{{dishes}}"
        wx:for-item="dish"
        wx:key="foodId"
      >
        <!-- 顶部：图片 + 信息 -->
        <view class="dcl-card__top">
          <view class="dcl-card__img-wrap">
            <image
              wx:if="{{dish.imageUrl}}"
              class="dcl-card__img"
              src="{{dish.imageUrl}}"
              mode="aspectFill"
            />
            <view wx:else class="dcl-card__img-placeholder">
              <text class="dcl-card__img-ph-icon">🍽</text>
            </view>
          </view>

          <view class="dcl-card__head-info">
            <view class="dcl-card__name-row">
              <text class="dcl-card__name">{{dish.dishName}}</text>
              <view
                class="dcl-role-tag dcl-role-tag--{{dish.roleCode === 'STAR' ? 'star' : dish.roleCode === 'TRAFFIC' ? 'traffic' : dish.roleCode === 'POTENTIAL' ? 'potential' : 'watch'}}"
              >
                <text>{{dish.roleName}}</text>
              </view>
            </view>

            <view class="dcl-card__role-reason" wx:if="{{dish.roleReason}}">
              <text>{{dish.roleReason}}</text>
            </view>

            <view class="dcl-card__price-sales">
              <text class="dcl-card__price">¥{{dish.currentPrice}}/{{dish.saleUnitName || '份'}}</text>
              <text class="dcl-card__divider">·</text>
              <text class="dcl-card__sales">本期销量 <text class="dcl-card__sales-num">{{dish.soldPortionsTotal}}</text> 份</text>
              <text class="dcl-card__divider" wx:if="{{dish.marginChangePoint}}">·</text>
              <text wx:if="{{dish.marginChangePoint}}" class="dcl-card__change-tag {{dish.marginChangeClass}}">{{dish.marginChangePoint}}pp</text>
            </view>
          </view>
        </view>

        <!-- 核心指标区 -->
        <view class="dcl-card__metrics">
          <!-- 实际毛利率 + 理论毛利率 并排 -->
          <view class="dcl-metrics-dual">
            <view class="dcl-metrics-dual__col">
              <text class="dcl-metrics-dual__label">实际毛利率</text>
              <view class="dcl-metrics-dual__val-row">
                <text class="dcl-metrics-dual__num dcl-metrics-dual__num--actual">{{dish.actualGrossMarginRateDisplay}}</text>
                <text class="dcl-metrics-dual__pct">%</text>
              </view>
            </view>
            <view class="dcl-metrics-dual__divider"></view>
            <view class="dcl-metrics-dual__col dcl-metrics-dual__col--right">
              <text class="dcl-metrics-dual__label">理论毛利率</text>
              <view class="dcl-metrics-dual__val-row dcl-metrics-dual__val-row--r">
                <text class="dcl-metrics-dual__num dcl-metrics-dual__num--theory">{{dish.theoreticalGrossMarginRateDisplay}}</text>
                <text class="dcl-metrics-dual__pct dcl-metrics-dual__pct--theory">%</text>
              </view>
            </view>
          </view>

          <!-- 成本指标三列 -->
          <view class="dcl-cost-grid">
            <view class="dcl-cost-cell">
              <text class="dcl-cost-cell__label">实际成本</text>
              <text class="dcl-cost-cell__value">¥{{dish.actualCostPerUnit}}/份</text>
            </view>
            <view class="dcl-cost-cell">
              <text class="dcl-cost-cell__label">理论成本</text>
              <text class="dcl-cost-cell__value">¥{{dish.theoreticalCostPerUnit}}/份</text>
            </view>
            <view class="dcl-cost-cell">
              <text class="dcl-cost-cell__label">成本差异</text>
              <text class="dcl-cost-cell__value {{dish.costGapClass}}">{{dish.costGapPerUnitDisplay}}/份</text>
            </view>
          </view>

          <!-- 实际利润 -->
          <view class="dcl-profit-row">
            <text class="dcl-profit-row__label">实际利润</text>
            <text class="dcl-profit-row__value">¥{{dish.actualProfitAmount}}</text>
          </view>
        </view>

        <!-- 经营诊断条（核心卖点：突出展示 title + message + 建议） -->
        <view class="dcl-card__hint {{dish.hintClass}}" wx:if="{{dish.diagnosisMessage}}">
          <text class="dcl-card__hint-icon">{{dish.hintIcon}}</text>
          <view class="dcl-card__hint-body">
            <text class="dcl-card__hint-title">{{dish.diagnosisTitle}}</text>
            <text class="dcl-card__hint-text">{{dish.diagnosisMessage}}</text>
            <text class="dcl-card__hint-action" wx:if="{{dish.diagnosisAction}}">💡 {{dish.diagnosisAction}}</text>
          </view>
        </view>

        <!-- 底部操作 -->
        <view class="dcl-card__actions">
          <view
            class="dcl-action-btn"
            hover-class="dcl-action-btn--hover"
            catchtap="onDishEdit"
            data-dish="{{dish}}"
          >
            <image class="dcl-action-btn__icon" src="/images/MapEditing.png" mode="aspectFit" />
            <text>编辑</text>
          </view>
          <view
            class="dcl-action-btn"
            hover-class="dcl-action-btn--hover"
            catchtap="onDishIngredients"
            data-dish="{{dish}}"
          >
            <image class="dcl-action-btn__icon" src="/images/Cost.png" mode="aspectFit" />
            <text>原料</text>
          </view>
          <view
            class="dcl-action-btn dcl-action-btn--primary"
            hover-class="dcl-action-btn--hover"
            catchtap="onDishBusiness"
            data-dish="{{dish}}"
          >
            <text>经营</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部安全区 -->
    <view class="dcl-bottom-safe"></view>
  </scroll-view>
</view>

<block wx:if="{{!foodManageMode}}">
<view class="food-page food-page--boss">
  <back-navbar title="菜品经营" avatar="/images/back.png" style="height: {{navBarHeight}}rpx;" bindnavbuttontap="toBack">
  </back-navbar>


  <!--  top -->
  <view class=" flex-row-between pl-20 pr-20 border-bottom bg-white">
    <view class="flex-row">
      <view class="p-20" bindtap="toDatePage">
        <image src="../../../../images/calender.png" class="icon"></image>
      </view>
      <view class="flex-column pt-10">
        <view class="font-yuan">{{hanzi}}</view>
        <view class="flex-row" wx:if="{{startDate == stopDate}}">
          <view class=" small" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
        </view>
        <view class="flex-row" wx:else>
          <view class="" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
          <text class="plr-10">-</text>
          <view class="" wx:if="{{stopDate}}">{{tool.transferDateString(stopDate)}}</view>
        </view>
      </view>
    </view>

    <view class="flex-row">
      <view class="flex-row p-20" bindtap="onToggleSearchBar">
      <image src="/images/search-3.png" class="icon mr-20 dfl-search-top-ico {{foodNameSearch ? 'dfl-search-top-ico--on' : ''}}"></image>
    </view>
    
    <picker
      wx:if="{{subDepPickerRange.length > 1}}"
      mode="selector"
      range="{{subDepPickerRange}}"
      range-key="gbDepartmentName"
      value="{{activeSubDepIndex}}"
      bindchange="onSubDepChange"
    >
      <view class="flex-row p-20">
        <image src="/images/search-3.png" class="icon mr-20 dfl-search-top-ico"></image>
        <text class="small">{{activeSubDepName ? activeSubDepName : '子部门'}}</text>
      </view>
    </picker>
    
    </view>

   

  </view>

  <view class="dfl-search-panel bg-white border-bottom" wx:if="{{searchBarOpen}}">
    <view class="dfl-search-inner">
      <image class="dfl-search-inner-ico" src="/images/search-3.png" mode="aspectFit" />
      <input
        class="dfl-search-input"
        value="{{foodNameSearchDraft}}"
        placeholder="搜索菜品名称"
        confirm-type="search"
        focus="{{searchInputFocus}}"
        bindinput="onFoodNameSearchInput"
        bindconfirm="onFoodNameSearchConfirm"
      />
      <text class="dfl-search-clear" wx:if="{{foodNameSearchDraft}}" catchtap="onFoodNameSearchClear">×</text>
    </view>
  </view>

  <view class="dfl-banner" wx:if="{{scopeOutboundSubtotals || businessInsightSummary}}">
    <view class="dfl-banner__head">
      <text class="dfl-banner__title">本区间经营概览</text>
      <!-- <text class="dfl-banner__badge">经营口径</text> -->
    </view>

    <view class="dfl-banner__hero" wx:if="{{businessInsightSummary}}">
      <view class="dfl-banner__hero-main">
        <text class="dfl-banner__hero-lab">综合实际毛利率</text>
        <text class="dfl-banner__hero-val">{{businessInsightSummary.comprehensiveGrossMarginRateOnListPrice}}%</text>
        <text class="dfl-banner__hero-sub">销售总额 ¥{{businessInsightSummary.totalListPriceRevenue}}</text>
      </view>
      <view class="dfl-banner__hero-side">
        <text class="dfl-banner__hero-side-lab">配料毛利率</text>
        <text
          class="dfl-banner__hero-side-val">{{businessInsightSummary.blendedGrossMarginRateTheoryOnListPrice}}%</text>
        <text class="dfl-banner__hero-sub">后台返回 · 菜品毛利率（理论）</text>
      </view>
    </view>

    <view class="dfl-banner__grid" wx:if="{{scopeOutboundSubtotals}}">
      <view class="dfl-kpi">
        <text class="dfl-kpi__val dfl-kpi__val--accent">{{scopeOutboundSubtotals.wasteLossRatioInOutbound123}}%</text>
        <text class="dfl-kpi__lab">损耗率 (2+3)/(1+2+3)</text>
      </view>
      <view class="dfl-kpi">
        <view class="flex-row">
          <text class="dfl-kpi__val mr-30">¥{{scopeOutboundSubtotals.subtotalProduceType1}}</text>
          <text class="dfl-kpi__val">{{businessInsightSummary.blendedGrossMarginRateOnListPrice}}%</text>

        </view>
        <text class="dfl-kpi__lab">生产出库</text>
      </view>
      <view class="dfl-kpi">
        <text class="dfl-kpi__val">¥{{scopeOutboundSubtotals.wasteLossAmountType23}}</text>
        <text class="dfl-kpi__lab">损耗+损失</text>
      </view>
      <view class="dfl-kpi">
        <text class="dfl-kpi__val">¥{{scopeOutboundSubtotals.subtotalOutbound123}}</text>
        <text class="dfl-kpi__lab">出库合计 1+2+3</text>
      </view>
    </view>
    <!-- <text class="dfl-banner__hint"
      wx:if="{{bossColumnHintsZh && bossColumnHintsZh.scopeOutboundSubtotals && bossColumnHintsZh.scopeOutboundSubtotals.wasteLossRatioInOutbound123}}">{{bossColumnHintsZh.scopeOutboundSubtotals.wasteLossRatioInOutbound123}}</text> -->
    <view class="dfl-banner__meta" wx:if="{{businessInsightSummary}}">
      <text>菜品 {{businessInsightSummary.dishRowCount}} 道 · 标价收入 ¥{{businessInsightSummary.totalListPriceRevenue}} · 实际成本  ¥{{businessInsightSummary.totalActualCostAmount}} · 理论成本
        ¥{{businessInsightSummary.totalTheoryCostAmount}}</text>
    </view>
  </view>

  <view class="dfl-section" wx:if="{{foodRowsSourceCount > 0}}">
    <view class="dfl-section__bar">
      <text class="dfl-section__title">菜品销售与毛利</text>
    </view>
    <view class="dfl-sort-wrap">
      <view class="dfl-sort-left">
        <view class="dfl-sort-arrows">
          <text class="dfl-sort-arrow dfl-sort-arrow--up {{foodSortOrder === 'asc' ? 'is-on' : ''}}">↑</text>
          <text class="dfl-sort-arrow dfl-sort-arrow--down {{foodSortOrder === 'desc' ? 'is-on' : ''}}">↓</text>
        </view>
        <text class="dfl-sort-label">排序{{foodSortOrder === 'asc' ? '·升序' : '·降序'}}</text>
      </view>
      <scroll-view scroll-x class="dfl-sort-scroll" show-scrollbar="{{false}}">
        <view class="dfl-sort-chips">
          <view class="dfl-sort-chip dfl-sort-chip--sales {{foodSortBy === 'sales' ? 'is-on' : ''}}" bindtap="onFoodSort" data-sort="sales">
            <text class="dfl-sort-chip-ico">份</text>
            <text>销量</text>
          </view>
          <view class="dfl-sort-chip dfl-sort-chip--margin {{foodSortBy === 'margin' ? 'is-on' : ''}}" bindtap="onFoodSort" data-sort="margin">
            <text class="dfl-sort-chip-ico">%</text>
            <text>综合毛利率</text>
          </view>
          <view class="dfl-sort-chip dfl-sort-chip--profit {{foodSortBy === 'profit' ? 'is-on' : ''}}" bindtap="onFoodSort" data-sort="profit">
            <text class="dfl-sort-chip-ico">¥</text>
            <text>实际利润</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="dfl-list-empty" wx:if="{{!foodRows.length && foodNameSearch}}">
      <text>未找到「{{foodNameSearch}}」相关菜品</text>
    </view>

    <view class="dfl-list" wx:if="{{foodRows.length}}">
      <view class="dfl-boss-card" wx:for="{{foodRows}}" wx:for-item="food" wx:key="_rowKey">

        <!-- 顶栏：菜名 / 单价 | 占位图 | 销量（对齐稿图） -->
        <view class="dfl-dish-head">
          <view class="dfl-dish-head__main">
            <text class="dfl-dish-head__idx">{{index + 1}}.</text>
            <view class="dfl-dish-head__titles">
              <text class="dfl-dish-head__name">{{food.gbDfFoodName}}</text>
              <text class="dfl-dish-head__price text-secondary">单价 ¥{{food.gbDfFoodPrice}}/份</text>
            </view>
          </view>
          <view class="dfl-dish-head__aside">
            <!-- <view class="dfl-dish-head__photo-wrap">
              <image wx:if="{{food._dishCoverUrl}}" class="dfl-dish-head__photo" src="{{food._dishCoverUrl}}" mode="aspectFill" />
              <view wx:else class="dfl-dish-head__photo dfl-dish-head__photo--placeholder" />
            </view> -->
            <view class="dfl-dish-head__sales">
              <text class="dfl-dish-head__sales-lab">销量</text>
              <text class="dfl-dish-head__sales-val">{{food.gbDfBusinessInsight ? food.gbDfBusinessInsight.soldPortionsTotal : food.gbDfSalesAmount}}份</text>
            </view>
          </view>
        </view>

        <block wx:if="{{food.gbDfSalesAmount > 0}}">

          <block wx:if="{{food.gbDfBusinessInsight}}">
            <!-- 综合毛利率主卡 -->
            <view class="dfl-blend-hero">
              <text class="dfl-blend-hero__title">综合毛利率</text>
              <view class="dfl-blend-hero__value-row">
                <text class="dfl-blend-hero__num">{{food.gbDfBusinessInsight.blendedGrossMarginRateOnListPrice}}</text>
                <text class="dfl-blend-hero__pct">%</text>
              </view>
              <view
                class="dfl-blend-hero__hint {{tool.marginStandardHintMod(food.gbDfBusinessInsight)}}"
                wx:if="{{tool.marginStandardShowBlock(food.gbDfBusinessInsight)}}"
              >
                <text
                  class="dfl-blend-hero__hint-range"
                  wx:if="{{tool.marginStandardMetaLine(food.gbDfBusinessInsight)}}"
                >{{tool.marginStandardMetaLine(food.gbDfBusinessInsight)}}</text>
                <view class="dfl-blend-hero__hint-inner">
                  <text
                    wx:if="{{food.gbDfBusinessInsight.grossMarginLevel == 'IN_BAND'}}"
                    class="dfl-blend-hero__hint-emoji"
                    aria-hidden="true"
                  >👍</text>
                  <text
                    wx:elif="{{food.gbDfBusinessInsight.grossMarginLevel == 'BELOW'}}"
                    class="dfl-blend-hero__hint-emoji"
                    aria-hidden="true"
                  >😭</text>
                  <text
                    wx:elif="{{food.gbDfBusinessInsight.grossMarginLevel == 'ABOVE'}}"
                    class="dfl-blend-hero__hint-emoji"
                    aria-hidden="true"
                  >😢</text>
                  <text class="dfl-blend-hero__hint-txt">{{tool.marginStandardHint(food.gbDfBusinessInsight)}}</text>
                </view>
              </view>
            </view>

            <!-- 实际成本 | 配料毛利率（理论） -->
            <view class="dfl-stat-dual">
              <view class="dfl-stat-dual__col">
                <view class="dfl-stat-dual__icon-row">
                  <view class="dfl-stat-ico dfl-stat-ico--cost">
                    <image wx:if="{{food._icoActualCost}}" class="dfl-stat-ico__img" src="{{food._icoActualCost}}" mode="aspectFit" />
                    <text wx:else class="dfl-stat-ico__fallback">¥</text>
                  </view>
                  <view class="dfl-stat-dual__text">
                    <text class="dfl-stat-dual__lab">实际成本</text>
                    <text class="dfl-stat-dual__val dfl-stat-dual__val--dark">¥{{food.gbDfBusinessInsight.actualCostPerPortion123}}/份</text>
                    <text class="dfl-stat-dual__sub">占售价 {{tool.getProducePercent(food.gbDfBusinessInsight.actualCostPerPortion123, food.gbDfFoodPrice)}}%</text>
                  </view>
                </view>
              </view>
              <view class="dfl-stat-dual__divider" />
              <view class="dfl-stat-dual__col">
                <view class="dfl-stat-dual__icon-row">
                  <view class="dfl-stat-ico dfl-stat-ico--theory">
                    <image wx:if="{{food._icoTheoryMargin}}" class="dfl-stat-ico__img" src="{{food._icoTheoryMargin}}" mode="aspectFit" />
                    <text wx:else class="dfl-stat-ico__fallback">%</text>
                  </view>
                  <view class="dfl-stat-dual__text">
                    <text class="dfl-stat-dual__lab">配料毛利率 (理论)</text>
                    <view class="dfl-stat-dual__val dfl-stat-dual__val--green dfl-stat-dual__val-row">
                      <text>{{food.gbDfBusinessInsight.grossMarginRateTheoryOnListPrice != null && food.gbDfBusinessInsight.grossMarginRateTheoryOnListPrice !== '' ? food.gbDfBusinessInsight.grossMarginRateTheoryOnListPrice : '—'}}</text>
                      <text
                        class="dfl-stat-dual__pct-suffix"
                        wx:if="{{food.gbDfBusinessInsight.grossMarginRateTheoryOnListPrice != null && food.gbDfBusinessInsight.grossMarginRateTheoryOnListPrice !== ''}}"
                      >%</text>
                    </view>
                    <text class="dfl-stat-dual__sub">配料成本 ¥{{tool.pricePerPortion(food.gbDfBusinessInsight.theoryCostAmount, food.gbDfBusinessInsight.soldPortionsTotal)}}/份</text>
                  </view>
                </view>
              </view>
            </view>

            <!-- 销售收入 | 实际总成本 -->
            <view class="dfl-stat-dual dfl-stat-dual--tight">
              <view class="dfl-stat-dual__col">
                <view class="dfl-stat-dual__icon-row">
                  <view class="dfl-stat-ico dfl-stat-ico--revenue">
                    <image wx:if="{{food._icoRevenue}}" class="dfl-stat-ico__img" src="{{food._icoRevenue}}" mode="aspectFit" />
                    <text wx:else class="dfl-stat-ico__fallback">¥</text>
                  </view>
                  <view class="dfl-stat-dual__text">
                    <text class="dfl-stat-dual__lab">销售收入</text>
                    <text class="dfl-stat-dual__val dfl-stat-dual__val--dark">¥{{food.gbDfBusinessInsight.listPriceRevenue}}</text>
                  </view>
                </view>
              </view>
              <view class="dfl-stat-dual__divider" />
              <view class="dfl-stat-dual__col">
                <view class="dfl-stat-dual__icon-row">
                  <view class="dfl-stat-ico dfl-stat-ico--wallet">
                    <image wx:if="{{food._icoWallet}}" class="dfl-stat-ico__img" src="{{food._icoWallet}}" mode="aspectFit" />
                    <text wx:else class="dfl-stat-ico__fallback">¥</text>
                  </view>
                  <view class="dfl-stat-dual__text">
                    <text class="dfl-stat-dual__lab">实际总成本</text>
                    <text class="dfl-stat-dual__val dfl-stat-dual__val--dark">¥{{food.gbDfBusinessInsight.actualCostTotalAmount123}}</text>
                  </view>
                </view>
              </view>
            </view>

            <view class="dfl-week-chart" wx:if="{{food._hasInsightRow}}">
              <view class="dfl-week-chart__head flex-row-between">
                <text class="dfl-week-chart__title">近7天销量趋势</text>
                <text class="dfl-week-chart__muted" wx:if="{{!food._weekChartHasData}}">暂无分日销量</text>
              </view>
              <view class="dfl-week-chart__canvas-wrap">
                <ec-canvas id="{{food._weekChartDomId}}" canvas-id="{{food._weekChartDomId}}" ec="{{ weekEcLazy }}"
                  class="dfl-week-ec"></ec-canvas>
              </view>
            </view>

            <text class="dfl-boss-card__method dfl-boss-card__method--below-chart" wx:if="{{food.gbDfFoodMethod}}">{{food.gbDfFoodMethod}}</text>

            <view class="dfl-ingredient-cta" hover-class="food-add-btn--hover" catchtap="onOpenIngredients" data-food="{{food}}">
              <!-- <image wx:if="{{food._icoLedger}}" class="dfl-ingredient-cta__ico" src="{{food._icoLedger}}" mode="aspectFit" /> -->
              <!-- <view wx:else class="dfl-ingredient-cta__ico-slot" /> -->
              <text class="dfl-ingredient-cta__txt">查看配料成本分析</text>
              <text class="dfl-ingredient-cta__chev">›</text>
            </view>
            <text class="dfl-data-disclaimer">* 数据仅供参考，请以实际经营情况为准</text>
          </block>

        </block>

        <view class="dfl-boss-card__no-insight" wx:elif="{{businessInsightSummary || scopeOutboundSubtotals}}">
          <text>本菜暂无经营分析数据（无销售或未进成本分摊）</text>
        </view>

        <view class="dfl-boss-card__foot flex-row-between" wx:if="{{!(food.gbDfSalesAmount > 0 && food.gbDfBusinessInsight)}}">
          <text class="dfl-boss-card__method" wx:if="{{food.gbDfFoodMethod}}">{{food.gbDfFoodMethod}}</text>
          <text class="dfl-boss-card__method dfl-boss-card__method--muted" wx:else>暂无做法说明</text>
          <view class="dfl-boss-card__link" hover-class="food-add-btn--hover" catchtap="onOpenIngredients"
            data-food="{{food}}">
            配料详情
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="dfl-empty" wx:if="{{foodRowsSourceCount === 0}}">当前日期范围暂无菜品数据</view>
</view>
</block>

<!-- 菜品销量模板：日期范围 -->
<view class="food-tpl-modal" wx:if="{{!foodManageMode && showFoodSalesTemplateModal}}">
  <view class="food-tpl-mask" bindtap="onCloseFoodSalesTemplateModal"></view>
  <view class="food-tpl-panel">
    <view class="food-tpl-title">选择日期范围</view>
    <view class="food-tpl-form">
      <view class="food-tpl-form-item">
        <text class="food-tpl-form-label">开始日期</text>
        <picker mode="date" value="{{foodSalesTemplateStartDate}}" end="{{todayDate}}"
          bindchange="onFoodSalesTemplateStartChange">
          <view class="food-tpl-form-input flex-row-items-center">
            <text>{{foodSalesTemplateStartDate || '请选择'}}</text>
            <text class="text-secondary">›</text>
          </view>
        </picker>
      </view>
      <view class="food-tpl-form-item">
        <text class="food-tpl-form-label">结束日期</text>
        <picker mode="date" value="{{foodSalesTemplateEndDate}}" start="{{foodSalesTemplateStartDate}}"
          end="{{todayDate}}" bindchange="onFoodSalesTemplateEndChange">
          <view class="food-tpl-form-input flex-row-items-center">
            <text>{{foodSalesTemplateEndDate || '请选择'}}</text>
            <text class="text-secondary">›</text>
          </view>
        </picker>
      </view>
    </view>
    <view class="food-tpl-actions">
      <view class="food-tpl-btn food-tpl-btn--ghost" bindtap="onCloseFoodSalesTemplateModal">取消</view>
      <view class="food-tpl-btn food-tpl-btn--primary" bindtap="onConfirmDownloadFoodSales">确认下载</view>
    </view>
  </view>

  <!-- 修改类别名称弹窗 -->
  <view class="rename-overlay" wx:if="{{showRenamePopup}}" catchtap="cancelRename">
    <view class="rename-dialog" catchtap="">
      <view class="rename-dialog__title">修改类别名称</view>
      <input class="rename-dialog__input" 
             value="{{renameInputValue}}" 
             placeholder="请输入新名称"
             maxlength="20"
             focus="{{showRenamePopup}}"
             bindinput="onRenameInput"
             bindconfirm="confirmRename"/>
      <view class="rename-dialog__btns">
        <text class="rename-dialog__btn rename-dialog__btn--cancel" catchtap="cancelRename">取消</text>
        <text class="rename-dialog__btn rename-dialog__btn--confirm" catchtap="confirmRename">确定</text>
      </view>
    </view>
  </view>
</view>