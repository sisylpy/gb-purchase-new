.left {
  width: 18vw;
}

.dep_left_item{
  background-color: #eee;
  padding: 50rpx 20rpx;
  border-bottom: 1px solid lightgray;
  text-align: center;
}

.dep_left_item.left-active{
  background-color: #FFF;
}
.left-item {
  padding: 30rpx 20rpx;
  background-color: #eee;
}

.left-active {
  background-color: #fff;
  border-left: 6rpx solid #187e6e;
}


.chart-title-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.chart-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: bold;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.chart-unit {
  font-size: 24rpx;
  color: #999;
}

.chart-canvas-container {
  width: 100%;
  height: 300rpx;
}

/* goodsData.linkedDishList 每道菜一行 */
.linked-dish-table {
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  overflow: hidden;
}

.linked-dish-tr {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.linked-dish-tr:last-child {
  border-bottom: none;
}

.linked-dish-th {
  background: #f8f9fa;
  font-weight: 600;
}

.linked-dish-col-name {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
  word-break: break-all;
}


.linked-dish-col-ing {
  flex: 0 0 160rpx;
  text-align: right;
  color: #333;
}

/* 菜品用量表：独立圆角白底模块，与上方统计卡片区隔 */
.cog-sub-table {
  margin-top: 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #eee;
  overflow: hidden;
  box-sizing: border-box;
}

.cog-sub-table .cog-tr--head {
  border-radius: 0;
}

.cog-sub-table .cog-tr:last-child {
  border-bottom: none;
}

.cog-tr {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  border-bottom: 1rpx solid #f0f0f0;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
}

.cog-tr--head {
  padding: 10rpx 8rpx 12rpx;
  border-bottom: 1rpx solid #e5e7eb;
  background: #f9fafb;
  border-radius: 10rpx;
}

.cog-tr--head .cog-td {
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 600;
}

.cog-td {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  /* font-weight: 600; */
  color: #1f2937;
  line-height: 1.45;
  text-align: center;
  padding: 10rpx 16rpx;
  word-break: break-all;
}

.cog-td--name {
  flex: 1.35;
  text-align: left;
}

.cog-td--right {
  text-align: right;
}


/* 统计区：左侧圆底小图标（与稿一致：蓝 / 绿 / 橙） */
.goods-fenxi-stat-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  width: 100%;
}

.goods-fenxi-stat-icon {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 40rpx 40rpx;
}

.goods-fenxi-stat-text {
  min-width: 0;
}

/* 对比模式下 chip 与正文左对齐（跳过圆形图标占位） */
