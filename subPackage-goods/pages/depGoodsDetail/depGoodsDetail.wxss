page {
  background: #f5f5f5;
}

.half-row {
  width: 50%;
}

.shrink_change {
  flex-shrink: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.inputAddGoods {
  border-bottom: 1px solid rgb(233, 231, 231);
  width: 100%;
  padding-left: 10rpx;
  line-height: 80rpx;
  height: 80rpx;
}

.saveBtn {
  width: 80%;
  line-height: 80rpx;
  background: rgb(86, 87, 87);
  color: #fff;
  margin-left: 10%;
  border-radius: 10rpx;
  text-align: center;
}

.saveBtn.is-active {
  background: #15b5bb;
  color: #fff;
}

.standard {
  background: #f0f0f0;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  margin-right: 15rpx;
  margin-bottom: 10rpx;
  font-size: 26rpx;
}

.mainBack {
  background: #f5f5f5;
  border-radius: 16rpx 16rpx 0 0;
}

/* 废弃时间弹窗底部按钮 */
.fresh-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 8rpx 28rpx 36rpx;
  box-sizing: border-box;
}

.fresh-btn {
  flex: 1;
  box-sizing: border-box;
  padding: 24rpx 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.35;
  border-radius: 12rpx;
}

.fresh-btn--cancel {
  color: #425042;
  background: #f1f3f2;
  border: 2rpx solid #dfe3e1;
}

.fresh-btn--confirm {
  color: #9aa29a;
  background: #e8ebea;
  border: 2rpx solid #d5dad7;
}

.fresh-btn--confirm.is-active {
  color: #ffffff;
  background: linear-gradient(145deg, #1a8a78 0%, #187e6e 45%, #146b5c 100%);
  border-color: #146b5c;
  box-shadow: 0 6rpx 16rpx rgba(24, 126, 110, 0.28);
}

.fresh-btn-hover {
  opacity: 0.88;
}

.red {
  color: red;
}

/* 代采门店选择弹窗 */
.store-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.store-sheet {
  width: 100%;
  max-height: 60vh;
  background: #fff;
  border-radius: 16rpx 16rpx 0 0;
  display: flex;
  flex-direction: column;
}

.store-sheet-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1px solid #eee;
}

.store-sheet-cancel {
  color: #999;
  font-size: 28rpx;
}

.store-list {
  flex: 1;
  max-height: 50vh;
  padding: 0 28rpx;
}

.store-item {
  padding: 28rpx 0;
  border-bottom: 1px solid #f0f0f0;
  font-size: 30rpx;
}

.store-item-hover {
  background: #f5f5f5;
}
