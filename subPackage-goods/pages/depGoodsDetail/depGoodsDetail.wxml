<wxs module="packFmt" src="../../utils/packSpecFmt.wxs"></wxs>

<view class="page-wrap flex flex-column">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="修改部门商品" 
    avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view class="page-body">
    <!-- 商品信息卡片 -->
    <view class="card bg-white">
      <!-- 商品名称单独一行 -->
      <view class="info-row info-row--name">
        <text class="text-secondary label">商品:</text>
        <text class="font-bold goods-name">{{depGoods.gbDdgDepGoodsName}}</text>
      </view>

      <!-- 订货单位 -->
      <view class="info-row">
        <text class="text-secondary label">单位:</text>
        <text class="info-value">{{depGoods.gbDdgDepGoodsStandardname}}</text>
      </view>

      <!-- 规格重量，如 500ml/瓶 -->
      <view class="info-row" wx:if="{{packFmt.specWeight(depGoods)}}">
        <text class="text-secondary label">规格重量:</text>
        <text class="info-value">{{packFmt.specWeight(depGoods)}}</text>
      </view>

      <!-- 大包装，如 500ml*24瓶/箱 -->
      <view class="info-row" wx:if="{{packFmt.cartonSpec(depGoods)}}">
        <text class="text-secondary label">大包装:</text>
        <text class="info-value pack-spec-text">{{packFmt.cartonSpec(depGoods)}}</text>
      </view>

      <!-- 口味 -->
      <view class="info-row" wx:if="{{depGoods.gbDdgDepGoodsDetail}}">
        <text class="text-secondary label">口味:</text>
        <text class="info-value">{{depGoods.gbDdgDepGoodsDetail}}</text>
      </view>

      <!-- 部门采购方式 -->
      <view class="section-block">
        <text class="text-secondary section-label">部门采购方式:</text>
        <radio-group class="radio-group" bindchange="radioDepTypeChange">
          <label class="radio" wx:for="{{items}}" wx:key="name">
            <radio value="{{item.name}}" checked="{{depGoods.gbDdgGoodsType == item.name ? 'true' : ''}}" />{{item.value}}
          </label>
        </radio-group>
      </view>

      <!-- 代采门店 -->
      <view class="action-row" wx:if="{{canStoreProxyPurchase && depGoods.gbDdgGoodsType == 6}}" bind:tap="showStoreSelector" hover-class="hover">
        <view class="action-row-main">
          <text class="text-secondary action-label">代采门店:</text>
          <text class="action-value">{{selectedStoreName || '请选择代采门店'}}</text>
        </view>
        <image src="/images/arrow-right-3.png" mode="aspectFill" class="icon"/>
      </view>

      <!-- 自动订货供货商 -->
      <view class="action-row" wx:if="{{depGoods.gbDdgGoodsType == 21}}" bind:tap="toSupplier" hover-class="hover">
        <view class="action-row-main">
          <text class="text-secondary action-label">自动订货供货商:</text>
          <text class="action-value">{{depGoods.gbDepAppointSupplierEntity.nxJrdhsSupplierName || '请选择供货商'}}</text>
        </view>
        <image src="/images/arrow-right-3.png" mode="aspectFill" class="icon"/>
      </view>
    </view>

    <!-- 保存按钮（编辑模式） -->
    <view class="card-footer-inner" wx:if="{{showEdit}}">
      <view class="saveBtn {{canSave ? 'is-active' : ''}}" bindtap="updateComGoods">保存</view>
    </view>

    <!-- 管理区域 -->
    <view class="card bg-white card--mt">
      <text class="text-secondary section-title">商品下架</text>
      <view class="switch-row flex-row-between">
        <text class="text-secondary">停止订货(部门)</text>
        <switch checked="{{depGoods.gbDdgDepGoodsPullOff == 1 ? 'checked' : ''}}" bindchange="switchDepPullOff" />
      </view>
    </view>

    <view class="page-bottom-spacer" wx:if="{{depConfigChanged}}"></view>
  </view>

  <!-- 保存配置按钮固定底部 -->
  <view class="page-footer" wx:if="{{depConfigChanged}}">
    <view class="saveBtn is-active" bindtap="saveDepConfig">保存配置</view>
  </view>
</view>

<!-- 代采门店选择弹窗 -->
<view class="store-mask" wx:if="{{showStorePicker}}" bindtap="hideStoreSelector">
  <view class="store-sheet" catchtap="">
    <view class="store-sheet-header">
      <text class="font-md text-secondary">选择代采门店</text>
      <text class="store-sheet-cancel" bindtap="hideStoreSelector">取消</text>
    </view>
    <scroll-view scroll-y class="store-list mb-15">
      <view wx:for="{{storeList}}" wx:key="gbDepartmentId" class="flex-row-between p-20" bindtap="onSelectStore" data-id="{{item.gbDepartmentId}}" data-name="{{item.gbDepartmentName}}" hover-class="store-item-hover" style="width: {{windowWidth - 60}}rpx; ">
        <text class="font-lg">{{item.gbDepartmentName}}</text>
        <image wx:if="{{item.isSelected}}" src="/images/correct.png" mode="aspectFill" class="icon"/>
      </view>
      <view wx:if="{{storeList.length == 0}}" class="store-item">
        <text class="text-secondary">暂无可选门店</text>
      </view>
    </scroll-view>
  </view>
</view>
