@import "../../styles/platform-tab-page.wxss";

.page-home {
  background: #f4f6f5;
}

/* ---- 顶部 ---- */
.header {
  background: linear-gradient(165deg, #187e6e 0%, #145a50 72%, #0f4840 100%);
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(20, 90, 80, 0.18);
}

.header-inner {
  padding: 16rpx 28rpx 28rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.market-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.dept-picker {
  display: flex;
  align-items: center;
  max-width: 360rpx;
  padding: 10rpx 18rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
}

.dept-picker-hover {
  background: rgba(255, 255, 255, 0.24);
}

.dept-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  opacity: 0.9;
}

.dept-name {
  flex: 1;
  font-size: 26rpx;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dept-arrow {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-left: 6rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 28rpx;
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.search-bar-hover {
  background: #fafafa;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.45;
}

.search-placeholder {
  font-size: 28rpx;
  color: #999999;
}

/* ---- 主内容 ---- */

.search-bar-hover {
  opacity: 0.92;
}

.outstanding-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: linear-gradient(90deg, #fff4e6 0%, #ffe8cc 100%);
  border-radius: 16rpx;
  border: 1rpx solid #ffd591;
}

.outstanding-banner-hover {
  opacity: 0.9;
}

.outstanding-banner-text {
  flex: 1;
  font-size: 26rpx;
  color: #ad6800;
  line-height: 1.5;
}

.outstanding-banner-arrow {
  font-size: 36rpx;
  color: #ad6800;
  margin-left: 12rpx;
}

.notice-card {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  background: linear-gradient(135deg, #faf6eb 0%, #fff9ee 100%);
  border-radius: 24rpx;
  border: 1rpx solid rgba(212, 168, 83, 0.25);
  box-shadow: 0 4rpx 20rpx rgba(180, 140, 60, 0.08);
}

.notice-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #145a50;
  background: rgba(24, 126, 110, 0.12);
  border-radius: 999rpx;
}

.notice-body {
  display: flex;
  flex-direction: column;
}

.notice-main {
  font-size: 30rpx;
  font-weight: 600;
  color: #2a3a36;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.notice-sub {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.4;
}

.section {
  margin: 28rpx 24rpx 0;
}

.section-last {
  margin-bottom: 0;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #24302e;
}

.section-hint {
  font-size: 24rpx;
  color: #187e6e;
}

/* ---- 批发商横向列表 ---- */
.supplier-scroll {
  white-space: nowrap;
  width: 100%;
}

.supplier-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  padding: 24rpx 16rpx;
  margin-right: 16rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  vertical-align: top;
}

.supplier-card-hover {
  background: #f8fbfa;
}

.supplier-avatar {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #187e6e, #2a9d8f);
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.supplier-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 6rpx;
}

.supplier-meta {
  font-size: 22rpx;
  color: #888888;
  margin-bottom: 4rpx;
}

.supplier-count {
  font-size: 20rpx;
  color: #187e6e;
}

.supplier-empty {
  padding: 32rpx 24rpx;
  font-size: 26rpx;
  color: #999;
  background: #fff;
  border-radius: 24rpx;
}

/* ---- 分类九宫格 ---- */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 0 0;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.category-item {
  width: 33.333%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx;
  box-sizing: border-box;
}

.category-item-hover {
  background: rgba(24, 126, 110, 0.04);
  border-radius: 16rpx;
}

.category-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f7f5;
  border-radius: 24rpx;
  margin-bottom: 12rpx;
}

.category-icon {
  width: 52rpx;
  height: 52rpx;
}

.category-name {
  font-size: 26rpx;
  color: #333333;
  text-align: center;
  line-height: 1.3;
}

