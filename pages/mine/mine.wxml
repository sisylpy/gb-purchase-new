<view class="platform-tab-page page-mine">
  <view class="platform-tab-header platform-tab-header--fixed">
    <view class="platform-profile-header" style="padding-top: {{statusBarHeight}}px;">
      <view class="platform-profile-card">
        <view class="platform-profile-avatar-wrap">
          <image
            class="platform-profile-avatar"
            src="{{userInfo.gbDuWxAvartraUrl ? userInfo.gbDuWxAvartraUrl : '/images/user.png'}}"
            mode="aspectFill"
          />
        </view>
        <view class="platform-profile-info">
          <text class="platform-profile-name">{{userInfo.gbDuWxNickName || '饭店账号'}}</text>
          <text class="platform-profile-dept" wx:if="{{mendianInfo}}">{{mendianInfo.gbDepartmentName}}</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="platform-tab-scroll" style="padding-top: {{scrollTopPadding}}px;">
    <view class="menu-card">
      <view class="menu-item">
        <image class="menu-icon" src="/images/house_alt.png" mode="aspectFit" />
        <text class="menu-label">饭店信息</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item">
        <image class="menu-icon" src="/images/MapEditing.png" mode="aspectFit" />
        <text class="menu-label">收货地址</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item menu-item-last">
        <image class="menu-icon" src="/images/setup.png" mode="aspectFit" />
        <text class="menu-label">账号设置</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="coming-soon">
      <text>更多功能即将上线</text>
    </view>

    <view class="platform-tab-bottom-spacer"></view>
  </scroll-view>
</view>
