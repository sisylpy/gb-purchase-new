page {
  background-color: #FDF9EE;
}

@import "../../styles/platform-tab-page.wxss";

.page-category-goods {
  background-color: #FDF9EE;
}

.main-body {
  height: 100%;
}

.left {
  width: 18vw;
}

.left-item {
  padding: 50rpx 30rpx;
}

.left-active {
  color: red;
}

.right-panel {
  flex: 1;
  min-width: 0;
}

.subcat-row {
  align-items: center;
}

.goods-list {
  border-radius: 20rpx;
  padding: 10rpx;
  background-color: #fff;
}

.product-item {
  border: 1rpx solid #f3c853;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 30rpx 0;
}

.goods_item {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.brand {
  border: 1rpx solid lightgray;
  font-size: 24rpx;
  font-weight: 500;
  padding: 2rpx 8rpx;
  color: #187e6e;
  border-radius: 8rpx;
  margin-right: 8rpx;
}

.save_btn {
  background-color: #f08308;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
}

.save_btn.has_order {
  background-color: #187e6e;
}

.save_btn.finish {
  background-color: #5d5e5d;
}

.save_btn.is-gray {
  opacity: 0.6;
}

.subcat-popup {
  position: fixed;
  left: 5vw;
  right: 5vw;
  background: #fff;
  border-radius: 32rpx;
  z-index: 1001;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.10);
  padding-bottom: 32rpx;
  animation: popupIn 0.2s;
}

@keyframes popupIn {
  from { transform: translateY(-30rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.subcat-bar,
.subcat-bar.expand {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  padding: 30rpx 40rpx;
  box-sizing: border-box;
  width: 100%;
}

.subcat-bar-scroll {
  width: 100%;
  overflow-x: auto;
  white-space: nowrap;
  padding: 0 0 8rpx 0;
}

.subcat-tag {
  display: inline-block;
  vertical-align: middle;
  padding: 10rpx 20rpx;
  margin: 15rpx 20rpx 15rpx 10rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #333;
  font-size: 28rpx;
  border: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.subcat-tag.active {
  border: 1rpx solid #ff2d2d;
  color: #ff2d2d;
}

.subcat-toggle {
  display: inline-block;
  vertical-align: middle;
  height: 58rpx;
  width: 58rpx;
  text-align: center;
  line-height: 58rpx;
  background-color: #fff;
  border-radius: 50%;
}

.toggle-icon {
  width: 32rpx;
  height: 32rpx;
  vertical-align: middle;
}

.subcat-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 1000;
}

.list-footer {
  height: 200rpx;
  line-height: 200rpx;
}

.empty-hint {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.delBack {
  background: #b41e1e;
  color: #fff;
}

.confirm-btn {
  width: 40%;
  text-align: center;
  padding: 20rpx 0;
  background-color: #ffd208;
  color: #000;
  border-radius: 10rpx;
  margin-left: 10%;
}

.cancel-btn {
  width: 40%;
  text-align: center;
  padding: 20rpx 0;
  background-color: #e0e0e0;
  color: #000;
  border-radius: 10rpx;
  margin-left: 5%;
}

.delete-actions {
  padding-bottom: 40rpx;
  margin-top: 20rpx;
}

.image-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  z-index: 20000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-modal .modal-content {
  background: #fff;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80%;
  overflow: hidden;
}

.image-modal .modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.image-modal .modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
}

.image-modal .modal-body {
  padding: 30rpx;
  text-align: center;
}

.modal-image {
  width: 100%;
  height: 400rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.image-info {
  text-align: left;
}

.goods-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.goods-standard {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.flex-row-default {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-column-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.middle {
  align-items: center;
}

.font-xl {
  font-size: 32rpx;
}

.font-sl {
  font-size: 26rpx;
}

.text_center {
  text-align: center;
}

.text-secondary {
  color: #888;
}

.gray {
  color: #999;
}

.extremeSmall {
  font-size: 22rpx;
  color: #999;
}

.p-10 {
  padding: 10rpx;
}

.mr-20 {
  margin-right: 20rpx;
}

.ml-10 {
  margin-left: 10rpx;
}

.five-weight {
  font-weight: 500;
}

.half-row {
  display: inline-block;
}

.overlay.show {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
}

.overlay.hiede {
  display: none;
}
