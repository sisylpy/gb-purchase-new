<wxs src="../../wxs/format.wxs" module="tool" />
<wxs src="../../utils/orderGoodsFmt.wxs" module="fmt" />

<view class="flex flex-column">

  <navbar-dual
   
    title="{{mendianInfo.gbDepartmentName}}"
    live-pulse="{{true}}"
    button-text="设置"
  ></navbar-dual>

  <view class="flex-column" style="margin-top: {{navBarHeight}}rpx;">
    <view class="flex-row-between p-20">
      <view class="flex-column  mr-20" >
        <view class="dateGroup bg-white">
          <view id="week" class="">{{week}}</view>
          <view id="date">{{date}}</view>
        </view>
      </view>
      <view class="flex-row-around" >
        <view class="flex-column center-content p-20 mr-10" bindtap="toEditHome" hover-class="hoverBar" style="width: {{(windowWidth - 200)/6 + 20}}rpx;">
          <image src="../../images/setup.png" class="icon"></image>
          <text class="font-sl">管理</text>
        </view>
      
        <!-- <view class="flex-column center-content p-20 mr-10" bindtap="toResGoods" hover-class="hoverBar" style="width: {{(windowWidth - 200)/6 + 20}}rpx;">
          <image src="../../images/book.png" class="icon"></image>
          <text class="font-sl">商品</text>
        </view> -->

        <view class="flex-column center-content p-20 mr-10" bindtap="toWork" hover-class="hoverBar" style="width: {{(windowWidth - 200)/6 + 20}}rpx;">
          <image src="../../images/book.png" class="icon"></image>
          <text class="font-sl">笔记</text>
        </view>

        <view class="flex-column center-content p-20 mr-10" bindtap="toStoreAnnounce" hover-class="hoverBar" style="width: {{(windowWidth - 200)/6 + 20}}rpx;">
          <image src="../../images/pingjunjia.png" class="icon"></image>
          <text class="font-sl">公告</text>
        </view>

        <view class="flex-column center-content p-20 mr-10" bindtap="toAiOrders" hover-class="hoverBar" style="width: {{(windowWidth - 200)/6 + 20}}rpx;">
          <image src="../../images/edit-2.png" class="icon"></image>
          <text class="font-sl">下单</text>
        </view>
      </view>
    </view>

    <view class="navbar">
      <view class="tabs-container">
        <block wx:for="{{tabs}}" wx:key="index">
          <view class="tab-item-container">
            <view class="tab-item {{tab1Index === index ? 'active' : ''}}" data-index="{{index}}" id="tab-{{index}}" catchtap="onTab1Click">
              {{item.name}}
            </view>
            <view class="badge {{item.amount > 0 ? 'show' : 'hide'}} {{item.isGray ? 'is-gray' : ''}}">
              {{item.amount}}
            </view>
          </view>
        </block>
      </view>
      <view class="slider" style="width: {{sliderWidth}}px; transform: translateX({{sliderLeft}}px);"></view>
    </view>

    <swiper style="height: {{windowHeight - navBarHeight - 280}}rpx;" current="{{itemIndex}}" bindchange="swiperChange" data-index="{{itemIndex}}">

      <!-- swiper 1: 未采购 -->
      <swiper-item>
        <scroll-view scroll-y style="height:100%;" refresher-enabled refresher-triggered="{{purchaseRefreshing}}" bindrefresherrefresh="onPurchaseRefresh">
          <block wx:if="{{purArr.length > 0}}">
            <view class="flex-column bg-white" wx:for="{{purArr}}" wx:for-item="item" wx:for-index="index">

              <block wx:if="{{disInfo.mendianDepartmentList.length == 1 && mendianInfo && mendianInfo.gbDepartmentSubAmount == 1}}">
                <view class="flex-column font-lg">
                  <view class="flex-row-between p-20 border-bottom">
                    <view class="flex-row-default" style="width: {{windowWidth - 140}}rpx;">
                      <text class="mr-10">{{index + 1}}.</text>
                      <image class="order-goods-thumb" mode="aspectFill" src="{{fmt.goodsImageUrl(item.gbDistributerGoodsEntity, url)}}" />
                      <view class="flex-column" style="width: {{windowWidth - 250}}rpx;">
                        <view class="flex-row-wrap">
                          <text class="brand" wx:if="{{item.gbDistributerGoodsEntity.gbDgGoodsBrand !== null && item.gbDistributerGoodsEntity.gbDgGoodsBrand.length > 0}}">{{item.gbDistributerGoodsEntity.gbDgGoodsBrand}}</text>
                          <text>{{item.gbDistributerGoodsEntity.gbDgGoodsName}}</text>
                          <text class="font-md gray pack-spec" wx:if="{{fmt.packSpec(item.gbDistributerGoodsEntity)}}">{{fmt.packSpec(item.gbDistributerGoodsEntity)}}</text>
                          <text class="flex-row font-sl text-secondary" wx:if="{{item.gbDistributerGoodsEntity.gbDgGoodsDetail.length > 0 && item.gbDistributerGoodsEntity.gbDgGoodsDetail !== 'null'}}">{{item.gbDistributerGoodsEntity.gbDgGoodsDetail}}</text>
                        </view>
                      </view>
                      <view class="flex-row-default flex-shrink-0">
                        <text class="ml-10">{{item.gbDepartmentOrdersEntities[0].gbDoQuantity}}{{item.gbDepartmentOrdersEntities[0].gbDoStandard}}</text>
                      </view>
                    </view>
                    <block wx:if="{{item.gbDpgStatus !== -1}}">
                      <view class="button-container-white" bindtap="selectItem" data-index="{{index}}" data-id="{{item.gbDistributerPurchaseGoodsId}}">
                        <block wx:if="{{item.isSelected}}">
                          <image src="../../images/checkboxchecked.png" class="dotSelected"></image>
                        </block>
                        <block wx:else>
                          <view class="dot"></view>
                        </block>
                      </view>
                    </block>
                    <block wx:else="">
                      <view class="p-20" bindtap="showReturnType" data-item="{{item}}">
                        <text class="font-sl">退货</text>
                      </view>
                    </block>
                  </view>
                </view>
              </block>

              <!-- multiDep -->
              <block wx:else="">
                <block wx:if="{{item.gbDpgPurchaseType !== 9}}">
                  <view class="flex-row-default p-20 border-bottom font-lg">
                    <text class="mr-10 text-secondary">{{index + 1}}.</text>
                    <image class="order-goods-thumb" mode="aspectFill" src="{{fmt.goodsImageUrl(item.gbDistributerGoodsEntity, url)}}" />
                    <view class="flex-column" style="width: {{windowWidth - 250}}rpx;">
                      <view class="flex-row">
                        <text class="brand" wx:if="{{item.gbDistributerGoodsEntity.gbDgGoodsBrand !== null && item.gbDistributerGoodsEntity.gbDgGoodsBrand.length > 0}}">{{item.gbDistributerGoodsEntity.gbDgGoodsBrand}}</text>
                        <text class="mr-20">{{item.gbDistributerGoodsEntity.gbDgGoodsName}}</text>
                        <text class="font-md gray pack-spec" wx:if="{{fmt.packSpec(item.gbDistributerGoodsEntity)}}">{{fmt.packSpec(item.gbDistributerGoodsEntity)}}</text>
                        <text wx:if="{{item.gbDistributerGoodsEntity.gbDgGoodsDetail.length > 0 && item.gbDistributerGoodsEntity.gbDgGoodsDetail !== 'null'}}">{{item.gbDistributerGoodsEntity.gbDgGoodsDetail}}</text>
                      </view>
                      <view class="flex-column" style="width:{{windowWidth - 250}}rpx;">
                        <view class="flex-row-items-center" wx:for="{{item.gbDepartmentOrdersEntities}}" wx:for-item="orders" wx:for-index="orderIndex">
                          <image src="{{orders.isNotice ? '../../images/selected-2.png' : '../../images/radiobuttonunselect-2.png'}}" class="icon mr-10 flex-shrink-0 " mode="aspectFit" bindtap="selectOrders" data-index="{{index}}" data-orderindex="{{orderIndex}}"></image>
                            <text class="mr-30">{{orders.gbDoParentDepartmentName}}.{{orders.gbDoOrderDepartmentName}}</text>
                         
                          <text>{{orders.gbDoQuantity}}{{orders.gbDoStandard}}</text>
                          <block wx:if="{{orders.gbDoDsStandardScale !== null && orders.gbDoDsStandardScale.length > 0 && orders.gbDoDsStandardScale !== '-1'}}">
                            <text class="text-secondary font-sl">({{orders.gbDoDsStandardScale}}{{item.gbDistributerGoodsEntity.gbDgGoodsStandardname}}/{{orders.gbDoStandard}})</text>
                          </block>
                        </view>
                      </view>
                    </view>
                    <view class="button-container-white" bindtap="selectItem" data-index="{{index}}" data-id="{{item.gbDistributerPurchaseGoodsId}}" hover-class="hover">
                      <block wx:if="{{item.isSelected}}">
                        <image src="../../images/checkboxchecked.png" class="dotSelected"></image>
                      </block>
                      <block wx:else>
                        <view class="dot"></view>
                      </block>
                    </view>
                  </view>
                </block>
                <block wx:else="">
                  <view class="flex-row-default p-20 border-bottom font-lg">
                    <text class="mr-10 text-secondary">{{index + 1}}.</text>
                    <image class="order-goods-thumb" mode="aspectFill" src="{{fmt.goodsImageUrl(item.gbDistributerGoodsEntity, url)}}" />
                    <view class="flex-column" style="width: {{windowWidth - 250}}rpx;">
                      <view class="flex-row">
                        <text class="brand" wx:if="{{item.gbDistributerGoodsEntity.gbDgGoodsBrand !== null && item.gbDistributerGoodsEntity.gbDgGoodsBrand.length > 0}}">{{item.gbDistributerGoodsEntity.gbDgGoodsBrand}}</text>
                        <text class="mr-20">{{item.gbDistributerGoodsEntity.gbDgGoodsName}}</text>
                        <text class="font-md gray pack-spec" wx:if="{{fmt.packSpec(item.gbDistributerGoodsEntity)}}">{{fmt.packSpec(item.gbDistributerGoodsEntity)}}</text>
                        <text wx:if="{{item.gbDistributerGoodsEntity.gbDgGoodsDetail.length > 0 && item.gbDistributerGoodsEntity.gbDgGoodsDetail !== 'null'}}">{{item.gbDistributerGoodsEntity.gbDgGoodsDetail}}</text>
                      </view>
                      <view class="flex-row ">
                        <view class="flex-row third-row"><text>退货数量:</text><text>{{item.gbDpgQuantity}}</text></view>
                        <view class="flex-row third-row"><text>单价:</text><text>{{item.gbDpgBuyPrice}}</text></view>
                        <view class="flex-row third-row"><text>金额:</text><text>{{item.gbDpgBuySubtotal}}</text></view>
                      </view>
                    </view>
                    <view class="button-container-white" bindtap="showReturnType" data-index="{{index}}" data-item="{{item}}" hover-class="hover">
                      <text>退货</text>
                    </view>
                  </view>
                </block>
              </block>
            </view>
            <view style="height: 200rpx;" class="center-content font-sl gray with-l-margin-top p-20">没有数据啦!</view>
          </block>
          <block wx:else="">
            <view class="{{purArr.length == 0 ? 'show empty-container' : 'hide'}}" style="height: {{windowHeight - navBarHeight - 350}}rpx;">
              <view class="flex-column-center full-height">
                <image class="empty_image" mode="aspectFill" src="../../images/xiuxi.png"></image>
                <text class="font-xl p-20">暂时无订货商品</text>
                <text class="darktext-secondary">这里只显示没有完成采购的订单</text>
              </view>
            </view>
          </block>
        </scroll-view>
      </swiper-item>

      <!-- swiper 2: 订货 -->
      <swiper-item class="pageBack1">
        <scroll-view scroll-y style="height:{{windowHeight - navBarHeight - 280}}rpx;" refresher-enabled refresher-triggered="{{orderRefreshing}}" bindrefresherrefresh="onOrderRefresh">

        <block wx:if="{{batchArr.length > 0}}">
          <view class="flex-column p-10" wx:for="{{batchArr}}" wx:for-item="batch" wx:for-index="bIndex">
              <view class="flex-row-between" style="width: {{windowWidth - 20}}rpx;">
                <view class="time_back flex-column"><view class="flex-row"><text class="mr-10">日期: </text><text class="mr-10">{{tool.getAttrDate(batch.gbDpbDate)}}</text><text>{{batch.gbDpbTime}}</text></view></view>
              </view>
              <view class="flex-stretch">
                <view class="vline"></view>
                <view class="body bg-white" style="width:{{windowWidth - 60}}rpx; margin-left: 10rpx; ">
                  <view class="flex-row p-10 font-sl batch-header-row" style="width: {{windowWidth - 80}}rpx; ">
                    <view class="flex-column center-content batch-header-col" >
                      <image src="{{fmt.batchBuyerAvatarUrl(batch, url)}}" mode="aspectFill" class="face_img"></image>
                      <view><text>{{batch.nxJrdhPurEntity.gbDuWxNickName}}</text></view>
                    </view>
                    <view class="flex-column center-content batch-header-col" >
                      <view class="flex-row text-danger" wx:if="{{batch.gbDpbPurchaseType == 9}}"><text>{{batch.gbDpbPurchaseType == 9 ? '退货' : ''}}</text></view>
                      <view wx:elif="{{batch.gbDpbStatus < 2 && batch.gbDpbPurchaseType != 9 && !batch.isNxDistributerBatch}}" class="button-container-white" hover-class="hover" bindtap="onReceiptOcrTap" data-batch="{{batch}}" data-bindex="{{bIndex}}">
                        <image src="/images/Photo.png" mode="aspectFill" class="icon" />
                      </view>
                    </view>
                    
                    <view class="flex-row-between batch-header-col batch-seller-col" >
                      <view class="flex-column center-content batch-seller-info">
                        <image src="{{fmt.batchSellerAvatarUrl(batch, url)}}" mode="aspectFill" class="face_img"></image>
                        <view wx:if="{{fmt.batchSellerName(batch)}}" class="font-sl flex-row batch-seller-name">{{fmt.batchSellerName(batch)}}</view>
                        <view wx:if="{{fmt.isBatchSellerUnread(batch)}}" class="font-sl text-danger">卖家未读</view>
                    </view>

                    <view wx:if="{{fmt.canDeleteBatchOrder(batch) && !batch.hasSupplierOutbound}}" class="button-container-white batch-menu-btn" hover-class="hover" bindtap="onBatchMenuTap" data-batch="{{batch}}" data-bindex="{{bIndex}}">
                      <image src="/images/points.png" mode="aspectFill" class="icon" />
                    </view>
                    </view>
                   
                  </view>
                  <view class="flex-column form_body">
                    <view class="flex-column p-20 order-goods-card {{batch.gbDPGEntities.length - 1 == index ? '' : 'border-bottom'}} {{item.gbDpgStatus >= 4 ? 'order-goods-card--received' : (item.gbDpgOrdersFinishAmount == item.gbDpgOrdersAmount ? 'bg-light' : '')}}" wx:for="{{batch.gbDPGEntities}}" wx:key="gbDistributerPurchaseGoodsId" wx:for-index="gIndex">
                      <view class="flex-row-default order-goods-main">
                        <text class="p-10 font-md">{{gIndex + 1}}.</text>
                        <image class="order-goods-thumb" mode="aspectFill" src="{{fmt.goodsImageUrl(item.gbDistributerGoodsEntity, url)}}" />
                        <view class="flex-column" style="width:{{windowWidth - 240}}rpx; ">
                          <view class="flex-row-between">
                            <view class="flex-row">
                              <text class="brand" wx:if="{{item.gbDistributerGoodsEntity.gbDgGoodsBrand !== null && item.gbDistributerGoodsEntity.gbDgGoodsBrand.length > 0}}">{{item.gbDistributerGoodsEntity.gbDgGoodsBrand}}</text>
                              <text class="font-lg mr-10">{{item.gbDistributerGoodsName}}</text>
                              <image
                                wx:if="{{item.gbDgGbSupplierId > 0 && item.gbDgGbSupplierId == batch.gbDpbSupplierId}}"
                                class="auto-order-goods-icon"
                                src="/images/robot-solid.png"
                                mode="aspectFit"
                              />
                              <text class="font-md gray pack-spec" wx:if="{{fmt.packSpec(item.gbDistributerGoodsEntity)}}">{{fmt.packSpec(item.gbDistributerGoodsEntity)}}</text>
                              <block wx:if="{{mendianInfo && mendianInfo.gbDepartmentSubAmount == 1}}">
                                <view class="flex-row mr-10 font-lg">
                                  <text class="ml-20">{{item.gbDepartmentOrdersEntities[0].gbDoQuantity}}{{item.gbDepartmentOrdersEntities[0].gbDoStandard}}</text>
                                  <block wx:if="{{item.gbDpgStatus == 2 && batch.gbDpbStatus == 1}}"><text class="ml-20 text-success font-sl">出货中</text></block>
                                </view>
                              </block>
                              <block wx:if="{{item.gbDpgWasteFullTime}}">
                                <view class="flex-row ml-10 font-sl"><image src="../../images/toxicwaste.png" class="icon-sm mr-10"></image><text>{{tool.getAttrFullTime(item.gbDpgWasteFullTime)}}</text></view>
                              </block>
                            </view>
                            <view class="flex-row pr-10 pl-10" wx:if="{{batch.gbDpbPurchaseType !== 9}}">
                              <block wx:if="{{item.gbDpgOrdersFinishAmount !== item.gbDpgOrdersAmount}}">
                                <view class="button-container-white" hover-class="hover" bindtap="toEditPurGoods" data-item="{{item}}" data-supplier="{{batch.nxJrdhSupplierEntity}}" data-bindex="{{bIndex}}" data-gindex="{{gIndex}}" data-batch="{{batch}}">
                                  <image src="/images/points.png" mode="aspectFill" class="icon"/>
                                </view>
                              </block>
                              <view class="center-content p-10" wx:else=""><image src="/images/correct.png" mode="aspectFill" class="icon"/></view>
                            </view>
                            <view wx:else class="p-20" bindtap="delTuihuo" data-id="{{item.gbDistributerPurchaseGoodsId}}">
                              <image src="/images/del-2.png" mode="aspectFill" class="icon"/>
                            </view>
                          </view>
                        </view>
                      </view>
                      <view class="order-detail-block" wx:for-item="order" wx:for="{{item.gbDepartmentOrdersEntities}}" wx:for-index="orderIndex" wx:key="gbDepartmentOrdersId">
                        <block wx:if="{{mendianInfo && mendianInfo.gbDepartmentSubAmount > 1}}">
                          <view class="flex-row order-department-row">
                            <text>{{order.gbDoParentDepartmentName}}.</text>
                            <text class="mr-10">{{order.gbDoOrderDepartmentName}}</text>
                            <text class="ml-20">{{order.gbDoQuantity}}{{order.gbDoStandard}}</text>
                            <block wx:if="{{item.gbDpgStatus == 2 && batch.gbDpbStatus == 1}}"><text class="ml-20 text-success font-sl">出货中</text></block>
                          </view>
                        </block>
                        <view class="order-out-meta-row" wx:if="{{fmt.shouldShowOrderOutMeta(batch, order, item)}}">
                          <view class="order-out-meta-item order-out-meta-item--start"><text class="text-secondary flex-shrink-0">数量:</text><text wx:if="{{fmt.hasOrderOutQty(order, item)}}">{{fmt.orderOutQty(order, item)}}</text></view>
                          <view class="order-out-meta-item order-out-meta-item--center"><text class="text-secondary flex-shrink-0">单价:</text><text class="{{fmt.isOrderPriceHigh(order, item) ? 'text-danger' : ''}}" wx:if="{{fmt.hasOrderOutPrice(order, item)}}">{{fmt.orderOutPriceLabel(order, item)}}</text><text wx:else class="text-danger">-</text></view>
                          <view class="order-out-meta-item order-out-meta-item--end"><text class="text-secondary flex-shrink-0">小计:</text><text wx:if="{{fmt.hasOrderOutSubtotal(order, item)}}">{{fmt.orderOutSubtotal(order, item)}}元</text><text wx:else class="text-danger">-</text></view>
                        </view>
                      </view>
                    </view>
                    <view
                      wx:if="{{batch.nxBillAmount}}"
                      class="batch-amount-preview"
                    >
                      <view class="batch-amount-preview-body">
                        <view class="batch-amount-detail-row">
                          <text>商品金额</text>
                          <text>¥{{batch.nxBillAmount.goodsAmount}}</text>
                        </view>
                        <view class="batch-amount-detail-row" wx:if="{{batch.nxBillAmount.hasCouponDiscount}}">
                          <view class="batch-amount-detail-label">
                            <text>优惠券优惠</text>
                            <text class="batch-amount-detail-badge" wx:if="{{batch.nxBillAmount.couponName}}">{{batch.nxBillAmount.couponName}}</text>
                          </view>
                          <text class="batch-amount-detail-discount">-¥{{batch.nxBillAmount.discountAmount}}</text>
                        </view>
                        <view class="batch-amount-detail-row" wx:if="{{batch.nxBillAmount.showDeliveryFee}}">
                          <view class="batch-amount-detail-label">
                            <text>配送费</text>
                          </view>
                          <view class="batch-amount-detail-fee">
                            <text>¥{{batch.nxBillAmount.deliveryFee}}</text>
                          </view>
                        </view>
                      </view>
                      <view class="batch-amount-preview-footer">
                        <view class="batch-amount-total-row">
                          <text class="batch-amount-total-label">应付</text>
                          <text class="batch-amount-total-value">¥{{batch.nxBillAmount.payAmount}}</text>
                        </view>
                      </view>
                    </view>
                  </view>
                  <view class="flex-column  pb-10 pt-10" wx:if="{{batch.gbDpbStatus > 1}}">
                    <block wx:if="{{batch.gbDpbStatus == 2}}">
                      <view class="flex-column p-10" style="align-items:flex-end;" wx:if="{{!batch.nxBillAmount}}">
                        <text class="font-sl text-secondary">商品金额 ¥{{batch.gbDpbSubtotal}}</text>
                        <text class="font-sl" wx:if="{{batch.gbDpbNxDeliveryFee > 0}}">配送费 +¥{{batch.gbDpbNxDeliveryFee}}</text>
                        <text class="font-sl text-danger" wx:if="{{batch.gbDpbNxCouponDiscountAmount > 0}}">{{batch.gbDpbNxCouponName}} -¥{{batch.gbDpbNxCouponDiscountAmount}}</text>
                        <view><text class="mr-10">应付:</text><text class="big">¥{{batch.gbDpbPaySubtotal ? batch.gbDpbPaySubtotal : batch.gbDpbSubtotal}}元</text></view>
                      </view>
                      <view class="center-content p-20"><view class="finish_btn" style="width: {{windowWidth - 300}}rpx;" bindtap="showFinish" data-item="{{batch}}">一键收货</view></view>
                    </block>
                  </view>
                </view>
              </view>
            </view>
        </block>
        <block wx:else="">
          <view style="height: {{windowHeight - navBarHeight - 350}}rpx;">
            <view class="flex-column-center full-height">
              <image class="empty_image" src="../../images/xiuxi.png"></image>
              <text class="font-md p-30">微信订货</text>
              <text class="font-md text-secondary p-10">将订单转发给微信好友</text>
              <text class="font-md text-secondary">让他们直接接收订货需求。</text>
            </view>
          </view>
        </block>
        </scroll-view>
      </swiper-item>
    </swiper>
  </view>
</view>

<!-- 首页优惠券弹窗 -->
<view wx:if="{{homeCouponPopupVisible}}" class="home-coupon-mask" catchtouchmove="noopForSheet" bindtap="closeHomeCouponPopup">
  <view class="home-coupon-dialog" catchtap="noopForSheet">
    <view class="home-coupon-dialog-header">
      <view class="home-coupon-heading">
        <text class="home-coupon-eyebrow">SUPPLIER COUPONS</text>
        <view class="home-coupon-title-row">
          <text class="home-coupon-dialog-title">供货商优惠券</text>
          <text class="home-coupon-count">{{homeCouponViews.length}}张可领取</text>
        </view>
        <text class="home-coupon-dialog-desc">每张券均由下方对应的供货商提供</text>
      </view>
      <view class="home-coupon-close" bindtap="closeHomeCouponPopup" aria-label="关闭优惠券弹窗">×</view>
    </view>

    <scroll-view scroll-y class="home-coupon-scroll" show-scrollbar="false">
      <view
        class="home-coupon-card"
        wx:for="{{homeCouponViews}}"
        wx:key="couponId"
        data-item="{{item}}"
        bindtap="openHomeSupplierCoupons"
      >
        <view class="home-coupon-provider">
          <text class="home-coupon-provider-tag">供货商</text>
          <text class="home-coupon-provider-name">{{item.supplierName}}</text>
          <text class="home-coupon-provider-more">查看全部 ›</text>
        </view>

        <view class="home-coupon-ticket">
          <view class="home-coupon-value">{{item.amountText}}</view>
          <view class="home-coupon-divider"></view>
          <view class="home-coupon-info">
            <text class="home-coupon-name">{{item.couponName}}</text>
            <text class="home-coupon-meta">{{item.thresholdText}}{{item.scopeLabel ? ' · ' + item.scopeLabel : ''}}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="home-coupon-actions">
      <text class="home-coupon-footnote">接收后，下单结算时会自动使用最优惠的一张</text>
      <button
        class="home-coupon-claim-all"
        loading="{{claimingAllHomeCoupons}}"
        disabled="{{claimingAllHomeCoupons}}"
        catchtap="claimAllHomeCoupons"
      >一键接收全部 {{homeCouponViews.length}} 张</button>
    </view>
  </view>
</view>

<!-- 操作弹窗 -->
<view class="overlay {{showOperation ? 'show' : 'hide'}}" catchtouchmove="ture" catchtap="hideMask">
  <view class="nnn bg-white font-lg">
    <view class="flex-column-center border-bottom font-bold pt-20 pb-20">
      <view class="flex-row"><text class="mr-10">{{editPurGoods.gbDistributerGoodsName}}</text><text class="font-md gray pack-spec" wx:if="{{fmt.packSpec(editPurGoods.gbDistributerGoodsEntity)}}">{{fmt.packSpec(editPurGoods.gbDistributerGoodsEntity)}}</text><text wx:elif="{{editPurGoods.gbDgGoodsStandardname}}" class="text-secondary font-sl">({{editPurGoods.gbDgGoodsStandardname}})</text></view>
    </view>
    <view class="flex-column">
      <view wx:if="{{fmt.canDeleteBatchOrder(editBatch) && !editPurGoods.supplierOutbound}}" class="flex-row p-30 border-bottom" catchtap="cancelGbBatchItem" hover-class="hover">
        <image src="/images/ashbin.png" class="icon mr-20"></image>
        <text class="{{editPurGoods.gbDpgOrdersWeightAmount > 0 ? 'text-secondary' : ''}}">删除订货</text>
      </view>
      <block wx:if="{{batchSupplier.nxJrdhSupplierId !== null}}">
        <view class="flex-row p-30" catchtap="changeAutoGoods" hover-class="hover" 
        wx:if="{{editPurGoods.gbDgGbSupplierId == -1 }}">
          <image src="/images/zidongtianjia-2.png" class="icon mr-20"></image>
          <text>添加为"{{editBatch.nxJrdhSupplierEntity.nxJrdhsSupplierName}}"自动订货</text>
        </view>
        <view class="flex-row p-30" catchtap="changeAutoGoods" hover-class="hover" wx:else="">
          <image src="/images/delete-dep.png" class="icon mr-20"></image>
          <text>取消"{{editBatch.nxJrdhSupplierEntity.nxJrdhsSupplierName}}"自动订货</text>
        </view>
      </block>
      <view class="flex-row p-30" hover-class="hover" wx:else="">
        <text class="text-secondary">暂无供货商</text>
      </view>
    </view>
    <view style="height: 20rpx;"></view>
  </view>
</view>


<!-- 退货组件 -->
<return-type show="{{showReturn}}" item="{{returnItem}}" bindconfirmReturn="confirmReturn" bindcancle="cancle" bindtoSupplierReturn="toSupplierReturn"/>

<!-- 底部操作栏 -->
<view class="wx_part" wx:if="{{selectedArr.length > 0}}">
  <view class="flex-row">
    <view class="mr-40" bindtap="showCar">
      <view class="dotWx" wx:if="{{selectedArr.length > 0}}">{{selectedArr.length}}</view>
      <image class="wx_icon" src="/images/gouwuche-4.png"></image>
    </view>
    <view class="flex-row" style="width: {{windowWidth - 160}}rpx;">
      <view class="bg-primary mr-30 radius-20 third-row p-20 text-white" bindtap="toFinishPurGoods">自采完成</view>
      <view class="bg-success mr-30 radius-20 third-row p-10"><button open-type="share">微信订货</button></view>
      <view class="supplier-order-action mr-30 radius-20 third-row p-20 text-white" bindtap="toOrderApp">供货商</view>
    </view>
  </view>
</view>

<!-- 已选商品展示 -->
<view class="{{selectedArr.length > 0 && showGoods ? 'show' : 'hide'}}" catchtouchmove="ture" catchtap="hideMaskWx" style="height:{{maskHeight > windowHeight ? maskHeight + 320 : windowHeight + 320}}rpx;">
  <view class="flex-column orderBottom pb-20 pt-20" animation="{{animationData}}">
    <view class="flex-row-between">
      <view class="text-secondary font-md p-20">选择的商品:</view>
      <view class="p-20" bindtap="closeGoods"><image src="/images/del.png" mode="aspectFill" class="icon"/></view>
    </view>
    <view class="flex-row-wrap p-20">
      <view class="p-10 flex-row goodsBack" wx:for="{{selectedArr}}">
        <text class="text_operation">{{item.item.gbDistributerGoodsEntity.gbDgGoodsName}}</text>
        <image catchtap="deleteOrderGoods" data-index="{{index}}" data-id="{{item.purGoodsId}}" src="../../images/del.png" class="icon" style="padding: 10rpx;"></image>
      </view>
    </view>
  </view>
</view>

<!-- 流量不足弹窗 -->
<view class="overlay {{disInfo.gbDistributerBuyQuantity < 1 ? 'show' : 'hide'}}">
  <view class="popup flex-column-center pb-20">
    <view class="flex-row text-center mt-30 mb-30">
      <image src="../../images/warn.png" mode="aspectFill" class="icon mr-10"/>
      <text>没有点数啦！</text>
    </view>
    <view style="height: 200rpx;"></view>
    <view class="center-content twenty_radius p-20" style="width: {{windowWidth - 100}}rpx; background-color: #ffbc65; line-height: 60rpx; border-radius: 10rpx;" bindtap="toPay">
      <view class="font-lg">购买流量</view>
    </view>
  </view>
</view>

<!-- 收货确认弹窗 -->
<view class="overlay {{showReceiveWarn ? 'show' : 'hide'}}" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; justify-content: center; align-items: center; z-index: 9999;" catchtap="hideReceive">
  <view class="receive-warn-popup">
    <view class="warn-header">
      <image src="../../images/warn.png" mode="aspectFill" class="warn-icon"/>
      <text class="warn-title">确认收货</text>
    </view>
    <view class="warn-content">
      <text class="warn-text">点击确认后，将录入库存记录</text>
      <text class="warn-text">请确认数量和价格无误</text>
    </view>
    <view class="order-info">
      <view class="info-item"><text class="info-label">供货商</text><text class="info-value">{{editBatch.nxJrdhSupplierEntity.nxJrdhsSupplierName}}</text></view>
      <view class="info-item"><text class="info-label">总金额</text><text class="info-value amount">{{editBatch.gbDpbSubtotal}}元</text></view>
    </view>
    <view class="confirm-btn" bindtap="toReceiveBatch"><text class="btn-text">确认收货</text></view>
  </view>
</view>

<!-- 设置部门弹出层 -->
<view wx:if="{{showPage}}" class="popup-mask" bindtap="hidePopup"></view>

<view wx:if="{{showPage}}" class="popup-container font-lg" animation="{{popupAnimation}}">
  <view class="popup-header">
    <text class="popup-title">设置门店的部门</text>
    <text class="close-icon" bindtap="hidePopup">✕</text>
  </view>

  <view class="popup-content">
    <!-- 门店名称 -->
    <view class="flex-row p-10">
      <text class="form-label">门店名称:</text>
      <input class="flex-input" placeholder="请输入门店名称" bindblur="bindKeyInput" value="{{disInfo.gbDistributerName}}" />
    </view>

    <!-- 部门数量 -->
    <view class="flex-row p-20" wx:if="{{hasSubs == 2}}">
      <text class="form-label">部门数量:</text>
      <input style="width: 300rpx; border-bottom: 1px solid gray;" type="number" value="{{selNumber}}" placeholder="请输入数量" bindinput="handleDepartmentNumber" />
    </view>

    <!-- 部门名称列表 -->
    <view class="department-list">
      <view wx:for="{{gbDepartmentEntities}}" wx:for-item="item" wx:for-index="index" wx:key="index" class="flex-row p-20">
        <text class="form-label">部门{{index + 1}}:</text>
        <input class="form-input" placeholder="请输入部门名称" value="{{item.gbDepartmentName}}" bindinput="getDepartmentName" data-index="{{index}}" />
      </view>
    </view>
  </view>

  <view class="popup-footer">
    <button class="save-btn" bindtap="toSave">确定设置</button>
  </view>
</view>
