/* ============ 收货确认弹窗样式 ============ */

.overlay {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100% !important;
  background: rgba(0, 0, 0, 0.5) !important;
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  z-index: 9999 !important;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.overlay.show {
  opacity: 1 !important;
  visibility: visible !important;
}

.overlay.hide {
  opacity: 0 !important;
  visibility: hidden !important;
}

/* 操作弹窗内容 */
.nnn {
  position: fixed !important;
  bottom: 0 !important;
  left: 0 !important;
  width: 100% !important;
  border-radius: 24rpx 24rpx 0 0 !important;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.1) !important;
  z-index: 10000 !important;
}

.receive-warn-popup {
  background: #ffffff !important;
  border-radius: 20rpx !important;
  padding: 40rpx 30rpx !important;
  width: 600rpx !important;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15) !important;
  position: relative !important;
  transform: scale(0.8);
  opacity: 0;
  transition: all 0.3s ease;
  margin: 0 auto !important;
}

/* 弹窗显示动画 */
.overlay.show .receive-warn-popup {
  transform: scale(1);
  opacity: 1;
}

.warn-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.warn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 15rpx;
}

.warn-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.warn-content {
  margin-bottom: 30rpx;
  text-align: center;
}

.warn-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.order-info {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.info-value.amount {
  color: #ff6b35;
  font-weight: 600;
}

.confirm-btn {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%);
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
  transition: all 0.2s ease;
  cursor: pointer;
}

.confirm-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 53, 0.4);
}

.btn-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 600;
}

/* 确保内容区域占满父容器高度 */
.full-height {
  height: 100%;
}

/* 关注引导弹窗样式 */
.follow-guide {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.guide-content {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guide-img {
  width: 500rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}

.guide-text {
  font-size: 34rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 30rpx;
}

.qr-code {
  width: 360rpx;
  height: 360rpx;
  margin: 20rpx 0;
  border-radius: 16rpx;
}

.qr-tip {
  font-size: 24rpx;
  color: #999999;
  margin-top: 16rpx;
  text-align: center;
}

.guide-btns {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 30rpx;
  width: 100%;
}

.skip-btn {
  padding: 24rpx 80rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8f5a);
  border-radius: 50rpx;
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.skip-btn.secondary {
  background: #f5f5f5;
  color: #999999;
  font-weight: normal;
}

/* 集团用户：门店切换底部弹层（主色 #187e6e，与导航按钮一致） */
.group-store-overlay {
  z-index: 10040 !important;
}

.group-store-sheet-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10050;
  transform: translateY(110%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  pointer-events: none;
}

.group-store-sheet-wrap.is-open {
  transform: translateY(0);
  pointer-events: auto;
}

.group-store-sheet-card {
  background: #fafcfb;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow:
    0 -4rpx 24rpx rgba(24, 126, 110, 0.08),
    0 -16rpx 48rpx rgba(0, 0, 0, 0.06);
  max-height: 72vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
}

.group-store-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(24, 126, 110, 0.18);
  margin: 14rpx auto 6rpx;
}

.group-store-sheet-strip {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx 20rpx;
  margin: 0 16rpx;
  margin-bottom: 8rpx;
  background: linear-gradient(135deg, rgba(24, 126, 110, 0.12) 0%, rgba(24, 126, 110, 0.06) 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(24, 126, 110, 0.2);
}

.group-store-sheet-strip-hover {
  background: linear-gradient(135deg, rgba(24, 126, 110, 0.18) 0%, rgba(24, 126, 110, 0.1) 100%);
}

.group-store-sheet-strip-text {
  flex: 1;
  font-size: 28rpx;
  color: #187e6e;
  font-weight: 500;
  line-height: 1.45;
  padding-right: 12rpx;
}

.group-store-sheet-strip-arrow {
  font-size: 40rpx;
  color: rgba(24, 126, 110, 0.55);
  line-height: 1;
  font-weight: 300;
}

.group-store-sheet-heading {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 18rpx 28rpx 12rpx;
}

.group-store-sheet-heading-mark {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: #187e6e;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.group-store-sheet-heading-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #24302e;
  letter-spacing: 0.5rpx;
}

.group-store-sheet-loading {
  padding: 48rpx 28rpx 56rpx;
  font-size: 28rpx;
  color: #187e6e;
  text-align: center;
  opacity: 0.85;
}

.group-store-sheet-scroll {
  max-height: 42vh;
  padding: 0 20rpx 8rpx;
  box-sizing: border-box;
}

.group-store-sheet-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 22rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 2rpx 12rpx rgba(24, 126, 110, 0.04);
}

.group-store-sheet-row-hover {
  background: rgba(24, 126, 110, 0.06);
}

.group-store-sheet-row.is-current {
  border-color: rgba(24, 126, 110, 0.45);
  background: linear-gradient(180deg, rgba(24, 126, 110, 0.1) 0%, rgba(24, 126, 110, 0.04) 100%);
  box-shadow: 0 4rpx 16rpx rgba(24, 126, 110, 0.12);
}

.group-store-sheet-name {
  flex: 1;
  font-size: 30rpx;
  color: #2a2a2a;
  line-height: 1.4;
  padding-right: 16rpx;
}

.group-store-sheet-row.is-current .group-store-sheet-name {
  color: #145a50;
  font-weight: 500;
}

.group-store-sheet-check {
  font-size: 22rpx;
  color: #ffffff;
  background: #187e6e;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.2;
  flex-shrink: 0;
}

.group-store-sheet-footer {
  padding: 12rpx 28rpx 20rpx;
  border-top: 1rpx solid rgba(24, 126, 110, 0.1);
  background: #fafcfb;
}

.group-store-sheet-close {
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #187e6e;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(24, 126, 110, 0.35);
  background: #ffffff;
}

.group-store-sheet-close-hover {
  background: rgba(24, 126, 110, 0.08);
}

.order-goods-thumb {
  width: 78rpx;
  height: 78rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: #f2f4f3;
  flex-shrink: 0;
}

.auto-order-goods-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
  padding: 4rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #e7f6ec;
}

.pack-spec {
  color: #888;
  font-size: 28rpx;
  margin-left: 6rpx;
}
