.home-coupon-mask {
  position: fixed;
  z-index: 100100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(21, 24, 23, 0.58);
}

.batch-amount-preview {
  margin: 0;
  background: #fff;
}

.batch-amount-preview-body { padding: 10rpx 30rpx 0; }
.batch-amount-detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  color: #3a3735;
  font-size: 28rpx;
}
.batch-amount-detail-label { display: flex; align-items: center; min-width: 0; }
.batch-amount-detail-badge {
  margin-left: 10rpx;
  padding: 3rpx 9rpx;
  border-radius: 6rpx;
  color: #e95a2b;
  background: #fff0e7;
  font-size: 20rpx;
}
.batch-amount-detail-muted { color: #9a938f; font-size: 22rpx; }
.batch-amount-detail-discount { color: #e84f25; font-weight: 600; }
.batch-amount-detail-fee { display: flex; align-items: center; }
.batch-amount-estimate-tag {
  margin-left: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 5rpx;
  color: #df6b30;
  background: #fff1e8;
  font-size: 19rpx;
}
.batch-amount-preview-footer { padding: 12rpx 30rpx 28rpx; }
.batch-amount-total-row { display: flex; align-items: baseline; justify-content: space-between; }
.batch-amount-total-label { color: #262321; font-size: 31rpx; font-weight: 650; }
.batch-amount-total-value { color: #16a24c; font-size: 42rpx; font-weight: 750; }
.batch-amount-total-tip { display: block; margin-top: 12rpx; color: #e06a45; font-size: 21rpx; line-height: 1.5; }

.home-coupon-dialog {
  width: 100%;
  max-height: 78vh;
  overflow: hidden;
  border-radius: 32rpx;
  background: #f8f8f6;
  box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.24);
}

.home-coupon-dialog-header {
  position: relative;
  display: flex;
  padding: 34rpx 34rpx 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #ef5a2a 0%, #f47b36 100%);
}

.home-coupon-heading { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.home-coupon-eyebrow { font-size: 18rpx; letter-spacing: 3rpx; opacity: 0.72; }
.home-coupon-title-row { display: flex; align-items: baseline; margin-top: 8rpx; }
.home-coupon-dialog-title { font-size: 42rpx; line-height: 1.3; font-weight: 700; }
.home-coupon-count { margin-left: 14rpx; font-size: 22rpx; opacity: 0.9; }
.home-coupon-dialog-desc { margin-top: 8rpx; font-size: 23rpx; opacity: 0.86; }
.home-coupon-close {
  width: 52rpx;
  height: 52rpx;
  margin: -6rpx -6rpx 0 18rpx;
  border-radius: 50%;
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
  font-size: 40rpx;
  font-weight: 300;
  line-height: 48rpx;
  text-align: center;
}

.home-coupon-scroll {
  height: 530rpx;
  padding: 24rpx 24rpx 6rpx;
  box-sizing: border-box;
}

.home-coupon-card {
  width: 100%;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(236, 100, 43, 0.16);
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(63, 38, 25, 0.06);
}

.home-coupon-provider {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx 14rpx;
  background: #fff8f2;
}

.home-coupon-provider-tag {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border-radius: 7rpx;
  color: #e85b29;
  background: #ffe6d7;
  font-size: 19rpx;
  line-height: 1.4;
}

.home-coupon-provider-name {
