<view class="platform-tab-page page-orders">
  <view class="platform-tab-header platform-tab-header--fixed platform-tab-header--white">
    <view class="platform-title-block" style="padding-top: {{statusBarHeight}}px;">
      <text class="platform-title-main">我的订货</text>
      <text class="platform-title-sub">购物车结算后生成正式采购单</text>
    </view>
    <view class="orders-tab-bar">
      <view class="orders-tab-item {{activeTab === 'cart' ? 'active' : ''}}" data-tab="cart" bindtap="onTabSwitch">购物车</view>
      <view class="orders-tab-item {{activeTab === 'formal' ? 'active' : ''}}" data-tab="formal" bindtap="onTabSwitch">今日订货</view>
    </view>
  </view>

  <!-- 购物车 -->
  <block wx:if="{{activeTab === 'cart'}}">
    <scroll-view scroll-y class="platform-tab-scroll cart-scroll-with-bar" style="padding-top: {{scrollTopPadding + 44}}px;">
      <view class="cart-loading" wx:if="{{loading}}">
        <text>加载中...</text>
      </view>

      <view class="cart-empty" wx:elif="{{empty}}">
        <image class="cart-empty-icon" src="/images/orderlisto.png" mode="aspectFit" />
        <text class="cart-empty-text">购物车是空的</text>
        <text class="cart-empty-hint">去「全部类别」或首页选批发商加购</text>
        <view class="cart-empty-actions">
          <view class="cart-empty-btn secondary" bindtap="goCategory">去全部类别</view>
          <view class="cart-empty-btn" bindtap="goShop">去选批发商</view>
        </view>
      </view>

      <block wx:else>
        <view class="cart-pay-banner" wx:if="{{hasPaymentProcessing}}">
          <text>部分商品正在支付处理中，暂不可修改或再次结算</text>
        </view>

        <view class="section-block cart-section" wx:if="{{confirmedLines.length}}">
          <view class="section-head section-head-divider">
            <text class="section-title">已知价格商品</text>
            <text class="section-count">{{confirmedLines.length}} 项</text>
          </view>
          <view class="cart-item-card {{item.paymentProcessing ? 'is-payment-locked' : ''}}" wx:for="{{confirmedLines}}" wx:key="nxOrderId">
            <view class="cart-item-top">
              <view class="cart-check {{item.selected ? 'checked' : ''}} {{item.paymentProcessing ? 'disabled' : ''}}" data-id="{{item.nxOrderId}}" catchtap="onToggleLine">
                <text wx:if="{{item.selected}}">✓</text>
              </view>
              <image class="cart-goods-img" src="{{item.goodsImage}}" mode="aspectFill" />
              <view class="cart-goods-info">
                <view class="cart-goods-head">
                  <text class="cart-goods-name">{{item.goodsName}}</text>
                  <text class="cart-menu-btn" wx:if="{{!item.paymentProcessing && item.editable !== false}}" data-id="{{item.nxOrderId}}" catchtap="onCartLineMenu">···</text>
                </view>
                <view class="cart-qty-row">
                  <text class="cart-qty">{{item.quantity}}{{item.standard}}</text>
                  <text class="cart-tag cart-tag-pay" wx:if="{{item.paymentProcessing}}">{{item.paymentProcessingMessage || '支付处理中'}}</text>
                  <text class="cart-tag cart-tag-confirmed" wx:else>已知价</text>
                  <text class="cart-tag cart-tag-supplier" wx:if="{{item.hasSupplier}}">已选批发商</text>
                </view>
                <text class="cart-unit-price" wx:if="{{item.unitPriceText}}">单价：{{item.unitPriceText}}</text>
              </view>
              <text class="cart-subtotal">{{item.subtotalText}}</text>
            </view>
            <view class="cart-supplier-card" wx:if="{{item.supplier}}">
              <image class="cart-supplier-logo" src="{{item.supplier.supplierLogo || '/images/logo.jpg'}}" mode="aspectFill" />
              <view class="cart-supplier-info">
                <view class="cart-supplier-name-row">
                  <text class="cart-supplier-name">{{item.supplier.supplierName}}</text>
                  <image class="cart-supplier-verified" src="/images/correct.svg" mode="aspectFit" />
                </view>
                <text class="cart-supplier-addr" wx:if="{{item.supplier.supplierAddress}}">{{item.supplier.supplierAddress}}</text>
              </view>
              <view class="cart-supplier-phone" wx:if="{{item.supplier.supplierPhone}}" data-phone="{{item.supplier.supplierPhone}}" catchtap="onCallSupplier">
                <view class="cart-phone-icon">☎</view>
                <text class="cart-phone-num">{{item.supplier.supplierPhoneDisplay}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="section-block cart-section" wx:if="{{pendingPriceLines.length}}">
          <view class="section-head section-head-divider">
            <text class="section-title">未知价格商品</text>
            <text class="section-count">{{pendingPriceLines.length}} 项</text>
          </view>
          <view class="cart-item-card {{item.paymentProcessing ? 'is-payment-locked' : ''}}" wx:for="{{pendingPriceLines}}" wx:key="nxOrderId">
            <view class="cart-item-top">
              <view class="cart-check {{item.selected ? 'checked' : ''}} {{item.paymentProcessing ? 'disabled' : ''}}" data-id="{{item.nxOrderId}}" catchtap="onToggleLine">
                <text wx:if="{{item.selected}}">✓</text>
              </view>
              <image class="cart-goods-img" src="{{item.goodsImage}}" mode="aspectFill" />
              <view class="cart-goods-info">
                <view class="cart-goods-head">
                  <text class="cart-goods-name">{{item.goodsName}}</text>
                  <text class="cart-menu-btn" wx:if="{{!item.paymentProcessing && item.editable !== false}}" data-id="{{item.nxOrderId}}" catchtap="onCartLineMenu">···</text>
                </view>
                <view class="cart-qty-row">
                  <text class="cart-qty">{{item.quantity}}{{item.standard}}</text>
                  <text class="cart-tag cart-tag-pay" wx:if="{{item.paymentProcessing}}">{{item.paymentProcessingMessage || '支付处理中'}}</text>
                  <text class="cart-tag cart-tag-pending" wx:else>待称重确认</text>
                  <text class="cart-tag cart-tag-wait" wx:if="{{!item.hasSupplier}}">待分配批发商</text>
                </view>
                <text class="cart-unit-price pending-hint">价格待称重确认 · 不计入本次支付</text>
              </view>
              <text class="cart-subtotal pending">待确认</text>
            </view>
            <view class="cart-supplier-card" wx:if="{{item.supplier}}">
              <image class="cart-supplier-logo" src="{{item.supplier.supplierLogo || '/images/logo.jpg'}}" mode="aspectFill" />
              <view class="cart-supplier-info">
                <view class="cart-supplier-name-row">
                  <text class="cart-supplier-name">{{item.supplier.supplierName}}</text>
                  <image class="cart-supplier-verified" src="/images/correct.svg" mode="aspectFit" />
                </view>
                <text class="cart-supplier-addr" wx:if="{{item.supplier.supplierAddress}}">{{item.supplier.supplierAddress}}</text>
              </view>
              <view class="cart-supplier-phone" wx:if="{{item.supplier.supplierPhone}}" data-phone="{{item.supplier.supplierPhone}}" catchtap="onCallSupplier">
                <view class="cart-phone-icon">☎</view>
                <text class="cart-phone-num">{{item.supplier.supplierPhoneDisplay}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>

      <view class="platform-tab-bottom-spacer cart-bottom-spacer"></view>
    </scroll-view>

    <view class="cart-checkout-bar" wx:if="{{!empty && !loading}}">
      <view class="checkout-select-all" bindtap="onToggleSelectAll">
        <view class="cart-check {{selectAll ? 'checked' : ''}}">
          <text wx:if="{{selectAll}}">✓</text>
        </view>
        <text>全选</text>
      </view>
      <view class="checkout-summary">
        <view class="checkout-row">
          <text class="checkout-label">已知价格合计</text>
          <text class="checkout-value">¥{{knownTotal}}</text>
        </view>
        <view class="checkout-row" wx:if="{{pendingPriceItemCount > 0}}">
          <text class="checkout-label">未知价格</text>
          <text class="checkout-pending">{{pendingPriceItemCount}}项不计入本次支付</text>
        </view>
        <view class="checkout-row pay-row">
          <text class="checkout-label">本次应付</text>
          <text class="checkout-pay">¥{{payAmount}}</text>
        </view>
        <text class="checkout-notice" wx:if="{{checkoutNotice}}">{{checkoutNotice}}</text>
      </view>
      <view class="checkout-btn {{selectedIds.length && !checkoutBlocked ? '' : 'disabled'}}" bindtap="onGoCheckout">去结算</view>
    </view>
  </block>

  <!-- 今日正式订货（按采购单分组） -->
  <block wx:else>
    <scroll-view scroll-y class="platform-tab-scroll" style="padding-top: {{scrollTopPadding + 44}}px;">
      <view class="cart-loading" wx:if="{{formalLoading}}">
        <text>加载中...</text>
      </view>

      <view class="cart-empty" wx:elif="{{formalEmpty}}">
        <image class="cart-empty-icon" src="/images/orderlisto.png" mode="aspectFit" />
        <text class="cart-empty-text">今日暂无正式订货</text>
        <text class="cart-empty-hint">购物车结算后将在此展示采购单</text>
      </view>

      <view class="section-block" wx:else>
        <view class="section-head">
          <text class="section-title">今日采购单</text>
          <text class="section-count">{{todayBillCount}}笔 · {{todayLineCount}}项</text>
        </view>

        <view class="bill-card" wx:for="{{todayBills}}" wx:key="billId" wx:for-index="billIndex">
          <view class="bill-card-head" data-bill-id="{{item.billId}}" data-index="{{billIndex}}" bindtap="onToggleBillExpand">
            <view class="bill-card-title-row">
              <text class="bill-card-title">采购单 #{{item.billId}}</text>
              <text class="bill-card-toggle">{{item.expanded ? '收起' : '展开'}}</text>
            </view>
            <text class="bill-card-summary">{{item.summaryText}}</text>
            <view class="bill-card-meta">
              <text class="bill-tag">{{item.payStatusText}}</text>
              <text class="bill-tag bill-tag-muted" wx:if="{{item.priceConfirmStatus === 'PENDING' || item.priceConfirmStatus === 'PARTIAL_PENDING'}}">含待确认价</text>
              <text class="bill-tag bill-tag-muted">{{item.lineCount}} 项商品</text>
            </view>
          </view>

          <view class="bill-preview-list" wx:if="{{!item.expanded}}">
            <view class="bill-preview-line" wx:for="{{item.linesPreview}}" wx:for-item="preview" wx:key="orderId">
              <text>- {{preview.previewText}}</text>
            </view>
          </view>

          <view class="bill-detail-block" wx:if="{{item.expanded}}">
            <view class="bill-detail-loading" wx:if="{{item.detailLoading}}">明细加载中...</view>
            <block wx:else>
              <view class="bill-line-row" wx:for="{{item.detailLines}}" wx:for-item="line" wx:key="orderId">
                <view class="bill-line-main">
                  <text class="bill-line-name">{{line.goodsName}}</text>
                  <text class="bill-line-qty">{{line.quantity}}{{line.standard}}</text>
                </view>
                <text class="bill-line-status">{{line.lineStatusText}}</text>
                <view class="bill-line-menu" wx:if="{{line.editable}}" data-order-id="{{line.orderId}}" catchtap="onEditBillLine">···</view>
              </view>
            </block>
            <view class="bill-action-row">
              <view class="bill-action-btn" data-bill-id="{{item.billId}}" catchtap="onGoBillPending">{{item.actionText || '查看明细'}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="platform-tab-bottom-spacer"></view>
    </scroll-view>
  </block>
</view>

<myDismodalNx
  show="{{show}}"
  bindconfirm="confirm"
  bindcancle="cancle"
  binddelApply="delApply"
  applyStandardName="{{applyStandardName}}"
  applyNumber="{{applyNumber}}"
  applySubtotal="{{applySubtotal}}"
  applyRemark="{{applyRemark}}"
  editApply="{{editApply}}"
  bindchangeStandard="changeStandard"
  item="{{nxGoods}}"
  canSave="{{canSave}}"
  windowWidth="{{windowWidth}}"
  windowHeight="{{windowHeight}}"
/>
