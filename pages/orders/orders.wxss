@import "../../styles/platform-tab-page.wxss";

.page-orders {
  background: #f4f6f5;
}

.orders-tab-bar {
  display: flex;
  padding: 0 24rpx 16rpx;
  gap: 16rpx;
}

.orders-tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  background: #f0f4f3;
  border-radius: 999rpx;
}

.orders-tab-item.active {
  background: #187e6e;
  color: #fff;
  font-weight: 600;
}

.cart-scroll-with-bar {
  padding-bottom: 280rpx;
}

.cart-bottom-spacer {
  height: 280rpx;
}

.cart-checkout-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #fff;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.checkout-select-all {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #555;
  flex-shrink: 0;
  padding-bottom: 8rpx;
}

.cart-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
}

.cart-check.checked {
  background: #187e6e;
  border-color: #187e6e;
}

.checkout-summary {
  flex: 1;
  min-width: 0;
}

.checkout-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.checkout-value {
  color: #333;
}

.checkout-pending {
  color: #e6a23c;
}

.pay-row .checkout-label {
  font-size: 26rpx;
  color: #333;
}

.checkout-pay {
  font-size: 32rpx;
  font-weight: 700;
  color: #187e6e;
}

.checkout-notice {
  display: block;
  font-size: 20rpx;
  color: #e6a23c;
  margin-top: 4rpx;
  line-height: 1.4;
}

.checkout-btn {
  flex-shrink: 0;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #187e6e;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.checkout-btn.disabled {
  opacity: 0.45;
}

.cart-line-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.cart-line-body {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.line-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.line-tag.confirmed {
  background: #e8f5f2;
  color: #187e6e;
}

.line-tag.pending {
  background: #fff3e0;
  color: #e6a23c;
}

.line-tag.supplier {
  background: #eef5ff;
  color: #409eff;
}

.line-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.cart-line-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.cart-action {
  font-size: 24rpx;
  color: #187e6e;
  padding: 4rpx 0;
}

.cart-action.danger {
  color: #e64340;
}

.pending-hint {
  color: #e6a23c !important;
}

.cart-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.section-block {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-block .section-head {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 8rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

.platform-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.order-card {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 2rpx;
  border-bottom: 1rpx solid #ececec;
  min-height: 120rpx;
}

.order-card-body {
  flex: 1;
  padding: 20rpx 16rpx 20rpx 24rpx;
  min-width: 0;
}

.order-card-menu {
  width: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.order-menu-dots {
  font-size: 36rpx;
  color: #999;
  letter-spacing: 2rpx;
  line-height: 1;
  font-weight: 700;
}

.order-line {
  font-size: 28rpx;
  line-height: 1.55;
  color: #333;
  word-break: break-all;
}

.order-line-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.order-line-price {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #555;
}

.order-line-supplier {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #187e6e;
}

.order-line-supplier.status-ASSIGNED {
  color: #2563eb;
}

.order-line-supplier.status-SEARCHING {
  color: #187e6e;
}

.order-line-supplier.status-UNMATCHED {
  color: #e6a23c;
}

.order-line-meta {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #555;
}

.order-line-remark {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #e74c3c;
}

.order-line-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #187e6e;
}

.line-title-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.status-UNMATCHED {
  background: #fff3e0;
  color: #e6a23c;
}

.status-SEARCHING {
  background: #e8f4f2;
  color: #187e6e;
}

.status-ASSIGNED {
  background: #eef5ff;
  color: #409eff;
}

.line-remark {
  font-size: 24rpx;
  color: #aaa;
}

.line-edit-hint {
  font-size: 24rpx;
  color: #187e6e;
}

.line-readonly {
  font-size: 24rpx;
  color: #bbb;
}

.cart-empty-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.cart-empty-btn.secondary {
  background: #fff;
  color: #187e6e;
  border: 2rpx solid #187e6e;
}

.cart-scroll {
  /* 使用 platform-tab-scroll */
}

.cart-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.cart-empty-icon {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.35;
  margin-bottom: 24rpx;
}

.cart-empty-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.cart-empty-hint {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
  text-align: center;
}

.cart-empty-btn {
  margin-top: 40rpx;
  padding: 20rpx 64rpx;
  background: #187e6e;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.supplier-group {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.group-head {
  padding: 24rpx 28rpx 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.group-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #187e6e;
}

.cart-line {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.line-name {
  font-size: 30rpx;
  color: #222;
  font-weight: 500;
}

.line-meta {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.line-qty {
  font-size: 26rpx;
  color: #666;
}

.line-price-ref {
  font-size: 24rpx;
  color: #888;
}

.line-price-pending {
  font-size: 24rpx;
  color: #e6a23c;
}

.line-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.line-subtotal {
  font-size: 28rpx;
  color: #187e6e;
  font-weight: 600;
}

.line-subtotal.pending {
  color: #ccc;
}

.qty-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qty-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f0f4f3;
  color: #187e6e;
  font-size: 32rpx;
  text-align: center;
  line-height: 52rpx;
}

.qty-val {
  min-width: 40rpx;
  text-align: center;
  font-size: 28rpx;
}

.group-footer {
  padding: 20rpx 28rpx 28rpx;
}

.group-summary {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #555;
  margin-bottom: 20rpx;
}

.group-pending {
  color: #e6a23c;
}

.submit-btn {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  background: #187e6e;
  color: #fff;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.submit-btn.is-loading {
  opacity: 0.7;
}

.bottom-spacer {
  height: 40rpx;
}
