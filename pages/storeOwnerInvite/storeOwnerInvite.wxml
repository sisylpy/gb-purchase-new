<view class="page">
  <customer-navbar style="height: {{navBarHeight}}rpx;" title="{{roleView.navTitle}}" avatar="/images/back.png" bindnavbuttontap="toBack"></customer-navbar>
  <view class="loading" wx:if="{{loading}}">正在确认邀请…</view>
  <view class="card" wx:elif="{{summary}}">
    <view class="brand" wx:if="{{summary.brandName}}">{{summary.brandName}}</view>
    <view class="store">{{roleView.subjectName}}</view>
    <view class="company" wx:if="{{summary.companyName}}">所属加盟公司：{{summary.companyName}}</view>
    <view class="company">{{roleView.owner ? '负责人范围' : '店长范围'}}：{{roleView.scopeText}}</view>
    <block wx:if="{{relayMode}}">
      <view class="tip">{{roleView.relayTip}}</view>
      <button class="primary" open-type="share" disabled="{{!summary.acceptable}}">{{roleView.shareButtonText}}</button>
    </block>
    <block wx:else>
      <view class="tip">{{roleView.acceptTip}}</view>
      <input class="input" type="nickname" placeholder="{{roleView.inputPlaceholder}}" value="{{userName}}" bindinput="inputName" />
      <button class="primary" loading="{{saving}}" disabled="{{saving || !summary.acceptable}}" bindtap="accept">{{roleView.acceptButtonText}}</button>
    </block>
    <view class="status" wx:if="{{!summary.acceptable}}">该邀请当前状态：{{summary.invitationStatus}}</view>
  </view>
  <view class="error" wx:if="{{error}}">{{error}}<text bindtap="loadSummary">　重新加载</text></view>
</view>
