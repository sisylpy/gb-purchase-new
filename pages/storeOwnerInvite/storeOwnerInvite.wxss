.page { min-height: 100vh; background: #f5f7f6; color: #26342f; }
.loading, .error { padding: 100rpx 40rpx; text-align: center; color: #718078; }
.card { margin: 36rpx 24rpx; padding: 48rpx 36rpx; background: #fff; border-radius: 24rpx; text-align: center; }
.brand { color: #176153; font-size: 28rpx; }
.store { margin-top: 18rpx; font-size: 46rpx; font-weight: 700; }
.company { margin-top: 12rpx; color: #718078; font-size: 26rpx; }
.tip { margin: 42rpx 0 30rpx; padding: 28rpx; border-radius: 16rpx; background: #f0f8f5; text-align: left; line-height: 1.7; font-size: 28rpx; }
.input { height: 92rpx; padding: 0 28rpx; border: 1rpx solid #d9e2de; border-radius: 14rpx; text-align: left; background: #fff; }
.primary { margin-top: 32rpx; border-radius: 14rpx; background: #176153; color: #fff; font-size: 30rpx; }
.status { margin-top: 24rpx; color: #b05a49; }
