<wxs module="fmt" src="../../wxs/format.wxs" />
<wxs src="../../utils/fn.wxs" module="tool" />

<view class="flex flex-column">

  <back-navbar 
    title="智能经营看板" 
    style="height: {{navBarHeight}}rpx;" 
    avatar="/images/back-gray.png" 
    bindnavbuttontap="toBack">
  </back-navbar>

  <!-- 时间窗口 -->
  <view class="dashboard-top-bar">
    <view class="time-row" bindtap="toDatePage">
      <image src="/images/calender.png" class="calendar-icon"></image>
      <view class="time-text">
        <text class="time-label">{{timeWindow ? timeWindow.label : hanzi}}</text>
        <text class="time-range" wx:if="{{timeWindow}}">{{timeWindow.startDate}} ~ {{timeWindow.endDate}}</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading-state">
    <view class="loading-dots">
      <view class="dot"></view><view class="dot"></view><view class="dot"></view>
    </view>
    <view class="loading-text text-center">加载看板中...</view>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{errorMsg}}" class="error-state">
    <text class="error-icon">⚠️</text>
    <text class="error-text">{{errorMsg}}</text>
    <view class="retry-btn" bindtap="_loadRender">重试</view>
  </view>

  <!-- 内容区 -->
  <scroll-view wx:else scroll-y="true" class="dashboard-scroll" enhanced show-scrollbar="{{false}}">
    <view class="dashboard-page-body">

    <!-- 快捷导航 -->
      <view class="dashboard-nav-btns">
        <view class="dash-nav-btn" bindtap="toHomeTap">
          <text class="dash-nav-btn-text">首页</text>
        </view>
        <view class="dash-nav-btn dash-nav-btn-ai" bindtap="toAiChat">
          <text class="dash-nav-btn-text">AI助手</text>
        </view>
      </view>
    


      <!-- 遍历模块 -->
      <block wx:for="{{modules}}" wx:key="moduleId">

        <!-- 模块加载失败 -->
        <view wx:if="{{item.status === 'FAILED'}}" class="module-error-card">
          <text class="module-error-icon">⚠️</text>
          <text class="module-error-title">{{item.moduleTitle}} 加载失败</text>
          <text class="module-error-desc" wx:if="{{item.errorMessage}}">{{item.errorMessage}}</text>
        </view>

        <!-- 经营看板模块 -->
        <view wx:elif="{{item.moduleKey === 'business1'}}" class="module-card">
          <view class="module-header">
            <text class="module-title">{{item.moduleTitle}}</text>
          </view>

          <view class="scale-section" wx:if="{{item.payload.scaleDashboard}}">
            <view class="scale-beam">

              <!-- 收入端 -->
              <view class="panel income-panel" wx:if="{{item.payload.scaleDashboard.scaleBeam.income}}">
                <view class="panel-title">
                  <text class="panel-icon">💰</text>
                  <text>{{item.payload.scaleDashboard.scaleBeam.income.title}}</text>
                </view>
                <view class="big-value" wx:if="{{item.payload.scaleDashboard.scaleBeam.income.rows[0]}}">
                  ¥{{fmt.formatNumber(item.payload.scaleDashboard.scaleBeam.income.rows[0].value)}}
                </view>
                <view class="value-label" wx:if="{{item.payload.scaleDashboard.scaleBeam.income.rows[0]}}">
                  {{item.payload.scaleDashboard.scaleBeam.income.rows[0].label}}
                </view>
                <block wx:for="{{item.payload.scaleDashboard.scaleBeam.income.rows}}" wx:key="key" wx:for-item="row" wx:for-index="idx">
                  <view class="detail-row" wx:if="{{idx > 0}}">
                    <text class="detail-key">{{row.key}}</text>
                    <text class="detail-val">¥{{fmt.formatNumber(row.value)}}</text>
                  </view>
                </block>
                <view class="ratio-bar-wrap" wx:if="{{item.payload.scaleDashboard.scaleBeam.income.ratioBar}}">
                  <view class="ratio-bar-header">
                    <text>{{item.payload.scaleDashboard.scaleBeam.income.ratioBar.label}}</text>
                    <text>{{fmt.formatNumber(item.payload.scaleDashboard.scaleBeam.income.ratioBar.percent)}}%</text>
                  </view>
                  <view class="ratio-bar-track">
                    <view class="ratio-bar-fill" style="width: {{item.payload.scaleDashboard.scaleBeam.income.ratioBar.percent}}%"></view>
                  </view>
                </view>
              </view>

              <!-- 天平指针 -->
              <view class="scale-center" wx:if="{{item.payload.scaleDashboard.scaleBeam.pointer}}">
                <view class="pointer-wrap">
                  <view class="pointer-triangle"></view>
                  <view class="pointer-glow"></view>
                </view>
                <view class="status-label status-label-{{item.payload.scaleDashboard.scaleBeam.pointer.statusClass}}">
                  <text>⚖️ {{item.payload.scaleDashboard.scaleBeam.pointer.statusLabel}}</text>
                </view>
              </view>

              <!-- 支出端 -->
              <view class="panel expense-panel" wx:if="{{item.payload.scaleDashboard.scaleBeam.expense}}">
                <view class="panel-title">
                  <text class="panel-icon">📊</text>
                  <text>{{item.payload.scaleDashboard.scaleBeam.expense.title}}</text>
                </view>
                <view class="big-value" wx:if="{{item.payload.scaleDashboard.scaleBeam.expense.summary}}">
                  ¥{{fmt.formatNumber(item.payload.scaleDashboard.scaleBeam.expense.summary.value)}}
                </view>
                <view class="value-label" wx:if="{{item.payload.scaleDashboard.scaleBeam.expense.summary}}">
                  {{item.payload.scaleDashboard.scaleBeam.expense.summary.label}}
                </view>
                <block wx:for="{{item.payload.scaleDashboard.scaleBeam.expense.rows}}" wx:key="key" wx:for-item="row">
                  <view class="detail-row">
                    <text class="detail-key">{{row.key}}</text>
                    <text class="detail-val">¥{{fmt.formatNumber(row.value)}}</text>
                  </view>
                </block>
              </view>

            </view>

          
          </view>
        </view>

        <!-- 菜品看板模块 -->
        <view wx:elif="{{item.moduleKey === 'dish'}}" class="module-card">
          <view class="module-header">
            <text class="module-title">{{item.moduleTitle}}</text>
          </view>

          <view class="dish-payload">
            <!-- 经营洞察摘要 -->
            <view class="dish-summary-grid" wx:if="{{item.payload.businessInsightSummary}}">
              <view class="dish-kpi-item">
                <text class="dish-kpi-val">{{item.payload.businessInsightSummary.dishRowCount || 0}}</text>
                <text class="dish-kpi-label">菜品数量</text>
              </view>
              <view class="dish-kpi-item">
                <text class="dish-kpi-val">¥{{fmt.formatNumber(item.payload.businessInsightSummary.totalListPriceRevenue)}}</text>
                <text class="dish-kpi-label">销售额</text>
              </view>
              <view class="dish-kpi-item">
                <text class="dish-kpi-val">{{item.payload.businessInsightSummary.blendedGrossMarginRateOnListPrice || item.payload.businessInsightSummary.comprehensiveGrossMarginRateOnListPrice || '—'}}%</text>
                <text class="dish-kpi-label">毛利率</text>
              </view>
              <view class="dish-kpi-item">
                <text class="dish-kpi-val">{{item.payload.businessInsightSummary.wasteLossRatioInOutbound123 || '0.00'}}%</text>
                <text class="dish-kpi-label">损耗率</text>
              </view>
            </view>

          </view>
        </view>

        <!-- 配料看板模块 -->
        <view wx:elif="{{item.moduleKey === 'ingredient'}}" class="module-card">
          <view class="module-header">
            <text class="module-title">{{item.moduleTitle}}</text>
          </view>

          <view class="ingredient-payload" wx:if="{{item.payload.summary}}">
            <!-- 配料汇总 -->
            <view class="ingredient-summary-grid">
              <view class="ingredient-kpi-item">
                <text class="ingredient-kpi-val">¥{{fmt.formatNumber(item.payload.summary.totalOutboundAmount)}}</text>
                <text class="ingredient-kpi-label">配料出库金额</text>
              </view>
              <view class="ingredient-kpi-item">
                <text class="ingredient-kpi-val">{{fmt.formatNumber(item.payload.summary.totalOutboundWeight)}}kg</text>
                <text class="ingredient-kpi-label">配料出库重量</text>
              </view>
              <view class="ingredient-kpi-item">
                <text class="ingredient-kpi-val">{{item.payload.summary.averageUtilizationRate}}%</text>
                <text class="ingredient-kpi-label">平均利用率</text>
              </view>
              <view class="ingredient-kpi-item">
                <text class="ingredient-kpi-val ingredient-abnormal {{item.payload.summary.abnormalIngredientMomDelta < 0 ? 'ingredient-down' : 'ingredient-up'}}">
                  {{item.payload.summary.abnormalIngredientCount}}
                </text>
                <text class="ingredient-kpi-label">异常配料数</text>
              </view>
            </view>

            <!-- 利用率分布 -->
            <view class="ingredient-dist-card" wx:if="{{item.payload.utilizationDistribution && item.payload.utilizationDistribution.buckets.length > 0}}">
              <text class="ingredient-dist-title">利用率分布（共{{item.payload.utilizationDistribution.totalKindsWithUtilization}}种配料）</text>
              <view class="ingredient-dist-list">
                <block wx:for="{{item.payload.utilizationDistribution.buckets}}" wx:key="level" wx:for-item="bucket">
                  <view class="ingredient-dist-row">
                    <text class="ingredient-dist-level level-{{bucket.level}}">{{bucket.labelZh}}</text>
                    <text class="ingredient-dist-range">{{bucket.rangeZh}}</text>
                    <text class="ingredient-dist-count">{{bucket.count}}种</text>
                    <text class="ingredient-dist-pct">{{bucket.percentOfKinds}}%</text>
                  </view>
                </block>
              </view>
            </view>
          </view>
        </view>

        <!-- 我的关注模块 -->
        <view wx:elif="{{item.moduleKey === 'custom_focus'}}" class="module-card">
          <view class="module-header">
            <text class="module-title">{{item.moduleTitle}}</text>
            <view class="module-header-right">
              <text class="add-focus-btn" bindtap="onAddFocusWidget">+ 添加关注</text>
            </view>
          </view>

          <view class="focus-widgets" wx:if="{{item.payload.widgets && item.payload.widgets.length > 0}}">
            <block wx:for="{{item.payload.widgets}}" wx:key="widgetId" wx:for-item="widget">
              <view class="focus-widget-card" wx:if="{{widget.enabled}}">
                <view class="focus-widget-head">
                  <text class="focus-widget-title">{{widget.title}}</text>
                  <text class="focus-widget-delete" data-widgetid="{{widget.widgetId}}" bindtap="onDeleteFocusWidget">删除</text>
                </view>
                <view class="focus-widget-body">
                  <text class="focus-widget-value {{widget.data.mainValueText === '—' ? 'focus-placeholder' : ''}}">{{widget.data.mainValueText}}</text>
                </view>
              </view>
            </block>
          </view>

          <!-- 暂无关注 -->
          <view wx:else class="empty-focus">
            <text class="empty-focus-text">暂无关注卡片，点击上方添加</text>
          </view>
        </view>

      </block>

      <view style="height: 120rpx;"></view>
    </view>
  </scroll-view>

</view>

<!-- 添加关注卡片弹窗 -->
<view wx:if="{{showAddFocusDialog}}" class="dialog-mask" bindtap="onCloseAddFocus">
  <view class="dialog-content" catchtap="">

    <view class="dialog-header">
      <text class="dialog-title">添加关注卡片</text>
      <text class="dialog-close" bindtap="onCloseAddFocus">✕</text>
    </view>

    <scroll-view scroll-y="true" class="dialog-body">

      <!-- 选择关注类型 -->
      <view class="dialog-section">
        <text class="dialog-section-title">关注类型</text>
        <view class="catalog-grid">
          <block wx:for="{{focusCatalog}}" wx:key="widgetType" wx:for-item="catalog">
            <view 
              class="catalog-item {{addFocusWidgetType === catalog.widgetType ? 'catalog-item-active' : ''}}" 
              data-type="{{catalog.widgetType}}" 
              bindtap="onSelectWidgetType">
              <text class="catalog-item-name">{{catalog.name}}</text>
            </view>
          </block>
        </view>
      </view>

      <!-- 选择指标 -->
      <view class="dialog-section" wx:if="{{addFocusWidgetType}}">
        <text class="dialog-section-title">选择指标</text>
        <view class="catalog-grid">
          <block wx:for="{{focusCatalog}}" wx:key="widgetType" wx:for-item="catalog">
            <block wx:if="{{catalog.widgetType === addFocusWidgetType}}">
              <block wx:for="{{catalog.metrics}}" wx:key="value" wx:for-item="metric">
                <view 
                  class="catalog-item {{addFocusMetric === metric.value ? 'catalog-item-active' : ''}}" 
                  data-metric="{{metric.value}}" 
                  bindtap="onSelectMetric">
                  <text class="catalog-item-name">{{metric.label}}</text>
                </view>
              </block>
            </block>
          </block>
        </view>
      </view>

      <!-- 填写对象名 -->
      <view class="dialog-section" wx:if="{{addFocusWidgetType === 'DISH_FOCUS' && addFocusMetric}}">
        <text class="dialog-section-title">菜品名称</text>
        <input class="dialog-input" placeholder="例如：椒麻鸡" value="{{addFocusDishName}}" bindinput="onAddFocusDishNameInput" />
      </view>

      <view class="dialog-section" wx:if="{{addFocusWidgetType === 'INGREDIENT_FOCUS' && addFocusMetric}}">
        <text class="dialog-section-title">配料名称</text>
        <input class="dialog-input" placeholder="例如：牛肉" value="{{addFocusIngredientName}}" bindinput="onAddFocusIngredientNameInput" />
      </view>

      <!-- 卡片标题（自动生成后可手动修改） -->
      <view class="dialog-section" wx:if="{{addFocusMetric && (addFocusDishName || addFocusIngredientName || addFocusTitle)}}">
        <text class="dialog-section-title">卡片标题</text>
        <input class="dialog-input" placeholder="输入卡片标题" value="{{addFocusTitle}}" bindinput="onAddFocusTitleInput" />
      </view>

    </scroll-view>

    <view class="dialog-footer">
      <view class="dialog-btn dialog-btn-cancel" bindtap="onCloseAddFocus">取消</view>
      <view class="dialog-btn dialog-btn-confirm" bindtap="onSubmitAddFocus">确认添加</view>
    </view>

  </view>
</view>

<!-- 模块编辑弹窗 -->
<view wx:if="{{showModuleEditDialog}}" class="dialog-mask" bindtap="onCloseModuleEdit">
  <view class="dialog-content" catchtap="">

    <view class="dialog-header">
      <text class="dialog-title">模块设置</text>
      <text class="dialog-close" bindtap="onCloseModuleEdit">✕</text>
    </view>

    <view class="dialog-body" wx:if="{{editingModule}}">
      <view class="dialog-section">
        <text class="dialog-section-title">模块标题</text>
        <input class="dialog-input" value="{{editingModule.moduleTitle}}" bindinput="onEditModuleTitleInput" />
      </view>

      <view class="dialog-section">
        <view class="toggle-row">
          <text class="toggle-label">{{editingModule.enabled ? '已启用' : '已隐藏'}}</text>
          <switch checked="{{editingModule.enabled}}" bindchange="onToggleModuleEnabled" color="#667eea" />
        </view>
      </view>
    </view>

    <view class="dialog-footer">
      <view class="dialog-btn dialog-btn-cancel" bindtap="onCloseModuleEdit">取消</view>
      <view class="dialog-btn dialog-btn-confirm" bindtap="onSubmitModuleEdit">保存</view>
    </view>

  </view>
</view>
