/* ======================== */
/* 页面基础 */
/* ======================== */
.dashboard-page-body {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  color: #fff;
  padding-bottom: 30rpx;
}

/* 快捷导航按钮 */
.dashboard-nav-btns {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 30rpx 20rpx;
}

.dash-nav-btn {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  text-align: center;
}

.dash-nav-btn:active {
  background: rgba(255, 255, 255, 0.2);
}

.dash-nav-btn-ai {
  background: rgba(74, 108, 247, 0.25);
  border-color: rgba(74, 108, 247, 0.4);
}

.dash-nav-btn-ai:active {
  background: rgba(74, 108, 247, 0.4);
}

.dash-nav-btn-text {
  font-size: 28rpx;
  color: #e0e0ff;
}

.dashboard-scroll {
  height: calc(100vh - 180rpx);
}

/* ======================== */
/* 顶部栏 */
/* ======================== */
.dashboard-top-bar {
  background: rgba(26, 26, 46, 0.95);
  padding: 20rpx 30rpx;
}

.time-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255,255,255,0.08);
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
}

.calendar-icon {
  width: 36rpx;
  height: 36rpx;
}

.time-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.time-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.time-range {
  font-size: 22rpx;
  color: #8892b0;
}

/* ======================== */
/* 加载状态 */
/* ======================== */
.loading-state {
  padding: 120rpx 60rpx;
}

.loading-dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.loading-dots .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #667eea;
  animation: dot-bounce 1.4s ease-in-out infinite;
}

.loading-dots .dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dots .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dot-bounce {
  0%, 60%, 100% { transform: translateY(0); }
  30% { transform: translateY(-20rpx); }
}

.loading-text {
  color: #8892b0;
  font-size: 28rpx;
}

.text-center { text-align: center; }

/* ======================== */
/* 错误状态 */
/* ======================== */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: #8892b0;
  margin-bottom: 30rpx;
}

.retry-btn {
  background: #667eea;
  color: #fff;
  padding: 16rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* ======================== */
/* 模块卡片 */
/* ======================== */
.module-card {
  margin: 20rpx 24rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 24rpx;
  overflow: hidden;
}

.module-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
}

.module-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.module-header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.module-edit-btn {
  font-size: 24rpx;
  color: #8892b0;
  padding: 8rpx 16rpx;
}

.add-focus-btn {
  font-size: 24rpx;
  color: #667eea;
  padding: 10rpx 20rpx;
  background: rgba(102,126,234,0.15);
  border-radius: 30rpx;
}

/* ======================== */
/* 模块错误 */
/* ======================== */
.module-error-card {
  margin: 20rpx 24rpx;
  padding: 40rpx;
  background: rgba(235,51,73,0.1);
  border: 1rpx solid rgba(235,51,73,0.3);
  border-radius: 24rpx;
  text-align: center;
}

.module-error-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 12rpx;
}

.module-error-title {
  font-size: 28rpx;
  color: #eb3349;
  font-weight: 600;
}

.module-error-desc {
  font-size: 24rpx;
  color: #f45c43;
  margin-top: 8rpx;
  display: block;
}

/* ======================== */
/* 天平区 */
/* ======================== */
.scale-section {
  padding: 30rpx;
}

.scale-beam {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
}

.panel {
  flex: 1;
  min-width: 0;
  border-radius: 20rpx;
  padding: 24rpx;
  min-height: 360rpx;
  box-sizing: border-box;
}

.income-panel {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
}
.expense-panel {
  background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%);
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}
.panel-icon { font-size: 36rpx; }

.big-value {
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  letter-spacing: -2rpx;
}
.value-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 20rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.15);
  font-size: 24rpx;
}
.detail-key, .detail-val {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.detail-row:last-of-type { border-bottom: none; }
.detail-key { opacity: 0.9; }
.detail-val { font-weight: 600; }

.ratio-bar-wrap { margin-top: 16rpx; }
.ratio-bar-header {
  font-size: 22rpx;
  display: flex;
  justify-content: space-between;
  margin-bottom: 6rpx;
  opacity: 0.9;
}
.ratio-bar-track {
  height: 14rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 7rpx;
  overflow: hidden;
}
.ratio-bar-fill {
  height: 100%;
  background: rgba(255,255,255,0.9);
  border-radius: 7rpx;
  transition: width 0.8s ease;
}

/* 天平指针 */
.scale-center {
  flex: 0 0 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.pointer-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pointer-triangle {
  width: 0;
  height: 0;
  border-left: 30rpx solid transparent;
  border-right: 30rpx solid transparent;
  border-top: 50rpx solid #ffd700;
  transition: all 0.5s ease;
}
.pointer-glow {
  border-radius: 50%;
  position: absolute;
  top: -30rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 80rpx;
  opacity: 0.3;
}

.status-label {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}
.status-label-profit {
  background: linear-gradient(135deg, #38ef7d, #11998e);
  color: #1a1a2e;
}
.status-label-loss {
  background: linear-gradient(135deg, #eb3349, #c0392b);
  color: #fff;
}
.status-label-breakeven {
  background: linear-gradient(135deg, #ffd700, #f39c12);
  color: #1a1a2e;
}

/* 底座日期卡 */
.scale-base {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255,255,255,0.1);
}

.sb-date-card {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  background: rgba(255,255,255,0.06);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
}

.sb-date-card-left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}
.sb-date-main {
  font-size: 36rpx;
  font-weight: 700;
}
.sb-date-week {
  font-size: 26rpx;
  color: #8892b0;
}

.sb-date-card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 12rpx;
}
.sb-date-badge {
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.sb-date-month-chip {
  font-size: 22rpx;
  color: #94a3b8;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255,255,255,0.06);
}

/* ======================== */
/* 菜品看板 */
/* ======================== */
.dish-payload {
  padding: 24rpx 30rpx;
}

.dish-summary-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.dish-kpi-item {
  flex: 0 0 calc(50% - 8rpx);
  background: rgba(102,126,234,0.15);
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  box-sizing: border-box;
}

.dish-kpi-val {
  font-size: 40rpx;
  font-weight: 700;
  color: #38ef7d;
  display: block;
  margin-bottom: 8rpx;
}

.dish-kpi-label {
  font-size: 22rpx;
  color: #8892b0;
}

.dish-detail-card {
  background: rgba(255,255,255,0.05);
  border-radius: 16rpx;
  padding: 24rpx;
}

.dish-detail-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8892b0;
  display: block;
  margin-bottom: 16rpx;
}

.dish-detail-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
  font-size: 26rpx;
}

.dish-detail-row:last-of-type { border-bottom: none; }

.dish-detail-key { color: #94a3b8; }
.dish-detail-val { color: #cbd5f5; font-weight: 600; }

.dish-detail-total {
  border-top: 1rpx dashed rgba(255,255,255,0.12);
  margin-top: 4rpx;
  padding-top: 16rpx;
}

.dish-detail-total .dish-detail-key,
.dish-detail-total .dish-detail-val {
  color: #fff;
  font-weight: 700;
}

.dish-detail-sub .dish-detail-key { color: #f45c43; }
.dish-detail-sub .dish-detail-val { color: #f45c43; }

/* ======================== */
/* 配料看板 */
/* ======================== */
.ingredient-payload {
  padding: 24rpx 30rpx;
}

.ingredient-summary-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.ingredient-kpi-item {
  flex: 0 0 calc(50% - 8rpx);
  background: rgba(56,239,125,0.1);
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  box-sizing: border-box;
}

.ingredient-kpi-val {
  font-size: 40rpx;
  font-weight: 700;
  color: #38ef7d;
  display: block;
  margin-bottom: 8rpx;
}

.ingredient-kpi-label {
  font-size: 22rpx;
  color: #8892b0;
}

.ingredient-abnormal { color: #ffd700 !important; }
.ingredient-abnormal.ingredient-down { color: #38ef7d !important; }
.ingredient-abnormal.ingredient-up { color: #eb3349 !important; }

.ingredient-dist-card {
  background: rgba(255,255,255,0.05);
  border-radius: 16rpx;
  padding: 24rpx;
}

.ingredient-dist-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8892b0;
  display: block;
  margin-bottom: 16rpx;
}

.ingredient-dist-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ingredient-dist-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
  font-size: 24rpx;
}

.ingredient-dist-row:last-of-type { border-bottom: none; }

.ingredient-dist-level {
  width: 100rpx;
  text-align: center;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 600;
  font-size: 22rpx;
}
.level-OPTIMAL { background: rgba(56,239,125,0.2); color: #38ef7d; }
.level-NORMAL { background: rgba(102,126,234,0.2); color: #667eea; }
.level-WARNING { background: rgba(255,215,0,0.2); color: #ffd700; }
.level-CRITICAL { background: rgba(235,51,73,0.2); color: #eb3349; }

.ingredient-dist-range {
  color: #94a3b8;
  flex: 1;
}

.ingredient-dist-count {
  color: #cbd5f5;
  font-weight: 600;
  min-width: 60rpx;
  text-align: right;
}

.ingredient-dist-pct {
  color: #8892b0;
  min-width: 60rpx;
  text-align: right;
}

/* ======================== */
/* 我的关注模块 */
/* ======================== */
.focus-widgets {
  padding: 16rpx 30rpx 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.focus-widget-card {
  flex: 0 0 calc(50% - 8rpx);
  background: rgba(255,215,0,0.08);
  border: 1rpx solid rgba(255,215,0,0.15);
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.focus-widget-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.focus-widget-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #cbd5f5;
  flex: 1;
}

.focus-widget-delete {
  font-size: 20rpx;
  color: #eb3349;
  padding: 4rpx 8rpx;
}

.focus-widget-body {
  display: flex;
  align-items: baseline;
}

.focus-widget-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffd700;
}

.focus-placeholder {
  color: #94a3b8;
  font-size: 36rpx;
}

.empty-focus {
  padding: 40rpx 30rpx;
  text-align: center;
}

.empty-focus-text {
  font-size: 26rpx;
  color: #94a3b8;
}

/* ======================== */
/* 弹窗 */
/* ======================== */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.7);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.dialog-content {
  width: 100%;
  max-height: 80vh;
  background: #1a1a2e;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.dialog-close {
  font-size: 36rpx;
  color: #8892b0;
  padding: 10rpx;
}

.dialog-body {
  padding: 24rpx 30rpx;
  overflow-y: auto;
  flex: 1;
}

.dialog-section {
  margin-bottom: 28rpx;
}

.dialog-section-title {
  font-size: 26rpx;
  color: #94a3b8;
  display: block;
  margin-bottom: 16rpx;
}

.dialog-input {
  background: rgba(255,255,255,0.08);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #fff;
  width: 100%;
  box-sizing: border-box;
}

.dialog-input-placeholder {
  color: #64748b;
}

.catalog-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.catalog-item {
  padding: 16rpx 28rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  font-size: 26rpx;
  color: #cbd5f5;
}

.catalog-item-active {
  background: rgba(102,126,234,0.2);
  border-color: #667eea;
  color: #fff;
  font-weight: 600;
}

.catalog-item-name { color: #cbd5f5; }
.catalog-item-active .catalog-item-name { color: #fff; }

.toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.toggle-label {
  font-size: 28rpx;
  color: #cbd5f5;
}

.dialog-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 30rpx;
  border-top: 1rpx solid rgba(255,255,255,0.08);
}

.dialog-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.dialog-btn-cancel {
  background: rgba(255,255,255,0.06);
  color: #8892b0;
}

.dialog-btn-confirm {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}
