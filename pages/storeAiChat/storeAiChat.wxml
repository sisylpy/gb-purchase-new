<!-- AI 对话页 — 新版 Run + SSE 架构 -->
<view class="gem-page" style="height: {{windowHeight}}px;">
  <!-- 顶栏 -->
  <view class="gem-nav" style="padding-top: {{statusBarHeight  + 40}}px;">
    <navbar title="AI助理" leading-menu="{{true}}" bindnavbuttontap="onOpenDrawerTap"></navbar>
  </view>

  <!-- Debug 切换按钮 -->
  <view class="gem-debug-toggle" catchtap="toggleDebugJson">
    <text class="gem-debug-toggle-text">🐞 {{showDebugJson ? 'ON' : 'OFF'}}</text>
  </view>

  <!-- 主区域 -->
  <scroll-view
    scroll-y="{{true}}"
    class="gem-scroll"
    scroll-into-view="{{scrollToView}}"
    scroll-with-animation="{{true}}"
    show-scrollbar="{{false}}"
  >
    <!-- 连接中 -->
    <view class="gem-loading" wx:if="{{isLoading}}">
      <text class="gem-loading-text">正在连接…</text>
    </view>

    <!-- 空会话：问候语 -->
    <block wx:if="{{!isLoading && messages.length === 0}}">
      <view class="gem-home">
        <view class="gem-greet">{{greetLine1}}</view>
        <view class="gem-greet-sub">需要我为你做些什么？</view>
      </view>
    </block>

    <!-- 有消息：对话流 -->
    <block wx:if="{{!isLoading && messages.length > 0}}">
      <view class="gem-chat-inner">
        <block wx:for="{{messages}}" wx:key="id">
          <view class="gem-msg-row gem-msg-user" id="msg-{{index}}" wx:if="{{item.role === 'user'}}">
            <view class="gem-bubble gem-bubble-user">{{item.content}}</view>
          </view>
          <view class="gem-msg-row gem-msg-ai flex-column" id="msg-{{index}}" wx:if="{{item.role === 'assistant'}}">
            <view class="gem-bubble gem-bubble-ai">
              <!-- 加载中占位 -->
              <view class="gem-typing" wx:if="{{item.isLoading && !item.content}}">
                <view class="gem-dot"></view>
                <view class="gem-dot"></view>
                <view class="gem-dot"></view>
              </view>
              <!-- 有 richNodes 时用富文本渲染 -->
              <view
                wx:elif="{{item.richNodes}}"
                class="gem-ai-stream-row"
              >
                <rich-text class="gem-rich-md gem-rich-md--flex" nodes="{{item.richNodes}}" />
                <view class="gem-stream-cursor" wx:if="{{item.isLoading}}"></view>
              </view>
              <!-- 纯文本 -->
              <view wx:else class="gem-ai-stream-row">
                <text class="gem-bubble-text">{{item.content}}</text>
                <view class="gem-stream-cursor" wx:if="{{item.isLoading}}"></view>
              </view>
              <!-- 菜品成本分析卡片 -->
              <dish-cost-analysis-card
                wx:if="{{item.cardPayload && item.cardPayload.cardType === 'DISH_COST_ANALYSIS_CARD'}}"
                cardData="{{item.cardPayload.data}}"
              />
              <!-- 菜品销售卡片 -->
              <dish-sales-single-dish-card
                wx:if="{{item.cardPayload && item.cardPayload.cardType === 'DISH_SALES_CARD'}}"
                cardData="{{item.cardPayload.data}}"
              />
            </view>
            <!-- 调试 JSON 面板 -->
            <view
              class="gem-debug-panel " 
              wx:if="{{showDebugJson && !item.isLoading && item.debugJsonText}}"
            >
              <view class="gem-debug-head">
                <text class="gem-debug-title">原始 Debug JSON</text>
                <view class="gem-debug-copy" catchtap="onCopyDebugJson" data-msgid="{{item.id}}">
                  <text>复制</text>
                </view>
              </view>
              <scroll-view scroll-y class="gem-debug-body">
                <text class="gem-debug-json">{{item.debugJsonText}}</text>
              </scroll-view>
            </view>
          </view>
        </block>

        <!-- SSE 阶段状态提示 -->
        <view class="gem-stage-bar" wx:if="{{streamingStage}}">
          <view class="gem-stage-dot"></view>
          <text class="gem-stage-text">{{streamingStage}}</text>
        </view>
      </view>
    </block>

    <view class="gem-scroll-spacer"></view>
  </scroll-view>

  <!-- 底部输入区 -->
  <view class="gem-composer-wrap" style="padding-bottom: calc(12px + env(safe-area-inset-bottom));">
    <view class="gem-composer-card">
      <view class="gem-composer-row">
        <view
          class="gem-input-shell {{composerFocused ? 'gem-input-shell--focus' : ''}} {{isSending ? 'gem-input-shell--disabled' : ''}}"
        >
          <textarea
            class="gem-textarea gem-textarea--composer"
            value="{{inputValue}}"
            placeholder="输入经营、成本或订货问题，换行可多行输入"
            placeholder-class="gem-input-ph"
            maxlength="2000"
            auto-height
            show-confirm-bar="{{false}}"
            disable-default-padding="{{true}}"
            cursor-spacing="28"
            adjust-position="{{true}}"
            hold-keyboard="{{false}}"
            disabled="{{isSending}}"
            bindinput="onInputChange"
            bindfocus="onComposerFocus"
            bindblur="onComposerBlur"
            bindconfirm="onSendTap"
            confirm-type="send"
          />
        </view>
        <!-- 发送 / 停止按钮 -->
        <view
          wx:if="{{isSending}}"
          class="gem-stop-pill"
          hover-class="gem-stop-pill-hover"
          hover-stay-time="80"
          catchtap="onStopGeneratingTap"
        >停止</view>
        <view
          wx:else
          class="gem-send-pill {{!inputValue ? 'gem-send-pill-off' : ''}}"
          hover-class="gem-send-pill-hover"
          hover-stay-time="80"
          catchtap="onSendTap"
        >发送</view>
      </view>
    </view>
  </view>

  <!-- 左侧抽屉：历史会话 -->
  <view
    class="gem-drawer-mask {{drawerOpen ? 'gem-drawer-mask--show' : ''}}"
    catchtap="onDrawerMaskTap"
    catchtouchmove="onDrawerTouchMove"
  ></view>
  <view
    class="gem-drawer-sheet {{drawerOpen ? 'gem-drawer-sheet--open' : ''}}"
    style="padding-top: {{drawerPaddingTop}}px;"
  >
      <view class="gem-drawer-topbar">
        <view
          wx:if="{{isGroupManager}}"
          class="gem-drawer-tool-btn {{drawerStoreListVisible ? 'gem-drawer-tool-btn--active' : ''}}"
          catchtap="onDrawerToggleStoreListTap"
        >门店</view>
        <view class="gem-drawer-tool-btn gem-drawer-tool-btn--home" catchtap="onDrawerHomeTap" wx:else="">管理</view>
        <view class="gem-drawer-tool-btn gem-drawer-tool-btn--new" catchtap="onNewConversationTap">新建</view>
        <view class="gem-drawer-topbar-fill"></view>
        <view class="gem-drawer-close" catchtap="onDrawerCloseTap">✕</view>
      </view>

      <view
        class="gem-drawer-store-panel"
        wx:if="{{drawerStoreListVisible && isGroupManager && groupMendianDepartmentsLoaded}}"
      >
        <view class="gem-store-board-title gem-drawer-store-panel-title">进入门店采购</view>
        <view wx:if="{{!groupMendianDepartments.length}}" class="gem-store-board-empty">暂无门店数据</view>
        <block wx:else>
          <view
            class="gem-store-row"
            wx:for="{{groupMendianDepartments}}"
            wx:key="gbDepartmentId"
            catchtap="onEnterStoreForPurchaseTap"
            data-deptid="{{item.gbDepartmentId}}"
          >
            <text class="gem-store-name">{{item.gbDepartmentName || item.gbDepartmentPrintName || '门店'}}</text>
            <text class="gem-store-arrow">›</text>
          </view>
        </block>
      </view>

      <view class="gem-drawer-head">
        <text class="gem-drawer-head-title">历史对话</text>
      </view>
      <scroll-view
        scroll-y="{{true}}"
        class="gem-drawer-scroll"
        style="height: {{drawerScrollHeight}}px;"
      >
        <view wx:if="{{conversationHistoryLoading}}" class="gem-drawer-loading">加载中…</view>
        <block wx:else>
          <view
            class="gem-drawer-history-row {{item.id == conversationId ? 'gem-drawer-history-row--active' : ''}}"
            wx:for="{{conversationHistoryList}}"
            wx:key="id"
            catchtap="onHistoryConversationTap"
            data-id="{{item.id}}"
          >
            <text class="gem-drawer-history-title">{{item.title}}</text>
            <text class="gem-drawer-history-time" wx:if="{{item.time}}">{{item.time}}</text>
          </view>
          <view wx:if="{{!conversationHistoryList.length}}" class="gem-drawer-empty">暂无历史对话</view>
        </block>
        <view class="gem-drawer-scroll-bottom"></view>
      </scroll-view>
  </view>
</view>
