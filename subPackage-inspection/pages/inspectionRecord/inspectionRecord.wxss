@import "../../styles/common.wxss";
.inline-save { background: #eaf5f2; border-radius: 12rpx; color: #187e6e; font-size: 26rpx; margin: 18rpx 0 0; }
.inline-save::after, .ai-button::after { border: 0; }
.ai-button { background: linear-gradient(135deg, #187e6e, #2a9e89); border-radius: 16rpx; color: #fff; font-size: 30rpx; margin-bottom: 18rpx; }
.candidate-head { color: #263d38; font-size: 31rpx; font-weight: 600; margin: 28rpx 2rpx 16rpx; }
.candidate-title-row { align-items: center; border-bottom: 1rpx solid #edf0f2; display: flex; justify-content: space-between; padding-bottom: 18rpx; }
.candidate-number { color: #187e6e; font-size: 29rpx; font-weight: 600; }
.candidate-tool { font-size: 22rpx; margin-left: 18rpx; }
.two-column { display: grid; gap: 16rpx; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.photo-option { display: inline-flex; margin: 0 12rpx 12rpx 0; position: relative; }
.photo-option image { border-radius: 10rpx; height: 118rpx; width: 118rpx; }
.photo-option checkbox { bottom: 3rpx; position: absolute; right: 3rpx; transform: scale(0.75); }
.task-toggle { align-items: center; display: flex; font-size: 26rpx; padding-top: 20rpx; }
.task-toggle checkbox { transform: scale(0.8); }
.draft-state { color: #187e6e; font-size: 23rpx; margin-top: 8rpx; }
