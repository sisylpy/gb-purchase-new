@import "../../styles/common.wxss";
.raw-text { font-size: 28rpx; line-height: 1.75; white-space: pre-wrap; }
.compact { min-height: 120rpx; padding: 20rpx; }
.issue-row { border-bottom: 1rpx solid #edf0f2; padding: 18rpx 0; }
.issue-title { flex: 1; font-size: 28rpx; font-weight: 600; line-height: 1.45; }
.task-link { align-items: center; background: #f7f9f8; border-radius: 13rpx; display: flex; gap: 12rpx; justify-content: space-between; margin-top: 14rpx; padding: 18rpx; }
.task-no { font-size: 26rpx; font-weight: 600; }
.block { display: block; margin-top: 2rpx; }
.arrow { color: #82938e; font-size: 40rpx; }
.timeline-detail { background: #f6f8f8; border-radius: 10rpx; color: #59636b; margin-top: 7rpx; padding: 10rpx 13rpx; }
.void-record { background: #fff5f5; border-left: 6rpx solid #d34646; }
.void-reason { color: #b42318; font-size: 24rpx; margin-top: 12rpx; }
