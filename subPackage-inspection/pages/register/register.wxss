@import "../../styles/common.wxss";

.register-scroll { box-sizing: border-box; height: calc(100vh - 145rpx); padding: 26rpx 22rpx 70rpx; }
.register-hero { align-items: center; display: flex; flex-direction: column; padding: 30rpx 28rpx 38rpx; text-align: center; }
.role-icon { align-items: center; background: linear-gradient(145deg, #187e6e, #2aa48d); border-radius: 28rpx; box-shadow: 0 12rpx 30rpx rgba(24, 126, 110, 0.2); color: #fff; display: flex; font-size: 48rpx; font-weight: 700; height: 104rpx; justify-content: center; width: 104rpx; }
.register-title { color: #173b34; font-size: 38rpx; font-weight: 700; margin-top: 24rpx; }
.register-subtitle { color: #6f7d79; font-size: 24rpx; line-height: 1.65; margin-top: 14rpx; }
.role-row { align-items: center; display: flex; justify-content: space-between; margin-bottom: 22rpx; }
.role-row > view { display: flex; flex-direction: column; }
.role-label { color: #7a838b; font-size: 23rpx; }
.role-name { color: #173b34; font-size: 34rpx; font-weight: 650; margin-top: 8rpx; }
.name-input { background: #f6f8f8; border: 2rpx solid #dce7e3; border-radius: 14rpx; box-sizing: border-box; font-size: 30rpx; height: 88rpx; padding: 0 22rpx; width: 100%; }
.register-button { background: #187e6e; color: #fff; margin-top: 28rpx; width: 100%; }
.register-button::after { border: 0; }
.retry-link { color: #187e6e; display: block; font-weight: 600; margin-top: 12rpx; }
.test-note { color: #9aa19f; display: block; font-size: 21rpx; line-height: 1.6; margin: 18rpx 24rpx 0; text-align: center; }
