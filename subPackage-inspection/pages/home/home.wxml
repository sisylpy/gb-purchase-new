<view class="inspection-page">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="巡店管理" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>

  <view class="loading" wx:if="{{loading}}">正在核验巡店身份…</view>
  <view class="error" wx:elif="{{error && !identity}}">
    <view class="empty-title">暂时无法进入</view><text>{{error}}</text>
    <view class="small-button retry" bindtap="retry">重新校验</view>
  </view>

  <scroll-view wx:else scroll-y class="home-scroll">
    <view class="identity-bar">
      <view><text class="identity-name">{{identity.userName}}</text><text class="identity-role">{{mode === 'manager' ? '店长整改' : (mode === 'readonly' ? '只读查看' : '巡店员')}}</text></view>
      <view class="mode-switch" wx:if="{{isInspector && isManager}}">
        <text class="mode-option {{mode === 'inspector' ? 'active' : ''}}" data-mode="inspector" bindtap="switchMode">巡店</text>
        <text class="mode-option {{mode === 'manager' ? 'active' : ''}}" data-mode="manager" bindtap="switchMode">整改</text>
      </view>
    </view>

    <view class="stats-grid" wx:if="{{stats.length}}">
      <view class="stat-card {{index === 0 ? 'primary' : ''}}" wx:for="{{stats}}" wx:key="label">
        <text class="stat-value">{{item.value === null ? '—' : item.value}}</text><text class="stat-label">{{item.label}}</text>
      </view>
    </view>
    <view class="tip" wx:if="{{statsError}}">{{statsError}}，下拉可重试。</view>

    <button class="start-button" wx:if="{{mode === 'inspector' && isInspector}}" bindtap="startInspection">＋ 开始巡店</button>

    <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
      <view class="tab {{activeTab === item.key ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="selectTab">{{item.label}}</view>
    </scroll-view>

    <view class="tip tip-red" wx:if="{{listError}}"><text>{{listError}}</text><text class="retry-link" bindtap="retryList">重新加载</text></view>
    <view class="loading list-loading" wx:if="{{listLoading}}">正在加载…</view>
    <view class="empty" wx:elif="{{!items.length && !listError}}"><view class="empty-title">暂无记录</view><text>当前分类下没有待处理事项</text></view>
    <view class="inspection-card list-card" wx:for="{{items}}" wx:key="listKey" wx:for-index="index" data-index="{{index}}" bindtap="openItem" hover-class="card-pressed">
      <view class="card-head"><text class="card-title">{{item.displayTitle}}</text><text class="status {{item.statusClass}}">{{item.displayStatus}}</text></view>
      <view class="card-meta" wx:if="{{item.itemType === 'inspection'}}">{{item.displayNo}} · {{item.displayTime}}</view>
      <view class="card-meta" wx:else>{{item.storeName}} · {{item.inspectorLabel}} · 巡店 {{item.inspectionTime}}</view>
      <view class="card-meta" wx:if="{{item.itemType === 'task'}}">截止 {{item.displayTime}}</view>
      <view class="overdue" wx:if="{{item.overdue}}">后台判定：已逾期</view>
    </view>
  </scroll-view>
</view>
