@import "../../styles/common.wxss";
.home-scroll { box-sizing: border-box; height: calc(100vh - 145rpx); padding-bottom: 60rpx; }
.identity-bar { align-items: center; background: #fff; display: flex; justify-content: space-between; padding: 20rpx 24rpx; }
.identity-name { font-size: 29rpx; font-weight: 600; margin-right: 14rpx; }
.identity-role { color: #66817a; font-size: 22rpx; }
.stats-grid { display: grid; gap: 10rpx; grid-template-columns: repeat(5, minmax(0, 1fr)); padding: 18rpx 22rpx; }
.stat-card { background: #fff; border-radius: 16rpx; display: flex; flex-direction: column; min-height: 112rpx; padding: 17rpx 13rpx; }
.stat-card.primary { background: #187e6e; color: #fff; }
.stat-value { font-size: 37rpx; font-weight: 700; }
.stat-label { font-size: 21rpx; margin-top: 7rpx; }
.tabs { background: #fff; box-sizing: border-box; display: flex; padding: 16rpx 22rpx; white-space: nowrap; width: 100%; }
.tab { background: #f0f2f3; border-radius: 999rpx; color: #646c74; display: inline-block; font-size: 24rpx; margin-right: 12rpx; padding: 11rpx 21rpx; }
.tab.active { background: #187e6e; color: #fff; }
.list-card { margin: 16rpx 22rpx 0; }
.card-pressed { opacity: 0.68; }
.list-loading { min-height: 240rpx; }
.retry { margin-top: 24rpx; }
.owner-scope { background: #fff; margin: 16rpx 22rpx; padding: 24rpx; border-radius: 18rpx; }
.owner-store-tabs { white-space: nowrap; width: 100%; }
.owner-store-tab { display: inline-block; margin-right: 12rpx; padding: 12rpx 22rpx; border-radius: 999rpx; background: #f0f2f3; color: #646c74; font-size: 24rpx; }
.owner-store-tab.active { background: #187e6e; color: #fff; }
.owner-summary { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10rpx; margin-top: 20rpx; }
.owner-summary view { display: flex; flex-direction: column; font-size: 21rpx; color: #6f777f; }
.owner-number { color: #202429; font-size: 34rpx; font-weight: 700; }
.recipe-version-row { align-items: center; border-top: 1rpx solid #edf0f2; display: flex; justify-content: space-between; padding: 18rpx 0; }
.recipe-version-main { display: flex; flex-direction: column; }
.recipe-name { font-size: 28rpx; font-weight: 600; }
.empty-mini { color: #858d96; font-size: 24rpx; padding: 20rpx 0; }
