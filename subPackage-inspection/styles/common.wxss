page { background: #f5f6f8; color: #202429; font-size: 28rpx; }
.inspection-page { background: #f5f6f8; min-height: 100vh; }
.inspection-scroll { box-sizing: border-box; height: calc(100vh - 145rpx); padding: 20rpx 22rpx 180rpx; }
.inspection-card, .inspection-section { background: #fff; border-radius: 18rpx; box-sizing: border-box; margin-bottom: 18rpx; padding: 24rpx; }
.section-title { color: #202429; font-size: 31rpx; font-weight: 600; margin-bottom: 18rpx; }
.section-subtitle { color: #858d96; font-size: 23rpx; line-height: 1.55; margin: -8rpx 0 18rpx; }
.card-head { align-items: flex-start; display: flex; gap: 18rpx; justify-content: space-between; }
.card-title { color: #202429; font-size: 31rpx; font-weight: 600; line-height: 1.4; }
.card-meta { color: #727b84; font-size: 24rpx; line-height: 1.75; margin-top: 10rpx; }
.muted { color: #8b929b; font-size: 24rpx; }
.danger-text { color: #d34646; }
.warning-text { color: #b76512; }
.success-text { color: #187e6e; }
.status { border-radius: 999rpx; display: inline-block; flex-shrink: 0; font-size: 22rpx; line-height: 36rpx; padding: 0 14rpx; }
.status-success { background: #e5f5ef; color: #187e6e; }
.status-primary { background: #e7f2f8; color: #287aa0; }
.status-warning { background: #fff1dc; color: #b76512; }
.status-danger { background: #fde9e9; color: #cf3f3f; }
.status-muted { background: #eef0f2; color: #68717b; }
.form-row { border-bottom: 1rpx solid #edf0f2; padding: 18rpx 0; }
.form-row:last-child { border-bottom: 0; }
.form-label { color: #454d55; display: block; font-size: 27rpx; margin-bottom: 12rpx; }
.required::before { color: #d34646; content: '*'; margin-right: 6rpx; }
.form-input, .form-picker, .form-textarea { background: #f7f8fa; border: 1rpx solid #e1e5e8; border-radius: 12rpx; box-sizing: border-box; color: #202429; font-size: 28rpx; min-height: 76rpx; padding: 18rpx 20rpx; width: 100%; }
.form-textarea { height: 164rpx; line-height: 1.55; }
.form-textarea-large { height: 300rpx; }
.form-input[disabled], .form-textarea[disabled] { color: #5c646d; }
.placeholder { color: #a4abb2; }
.tip { background: #fff6e6; border-radius: 13rpx; color: #8c6321; font-size: 24rpx; line-height: 1.6; margin-bottom: 18rpx; padding: 18rpx 20rpx; }
.tip-green { background: #e9f6f1; color: #256f64; }
.tip-red { background: #fff0f0; color: #b43f3f; }
.empty, .loading, .error { align-items: center; color: #7d858e; display: flex; flex-direction: column; justify-content: center; line-height: 1.65; min-height: 340rpx; padding: 50rpx; text-align: center; }
.error { color: #b34747; }
.empty-title { color: #4f565f; font-size: 31rpx; font-weight: 600; margin-bottom: 10rpx; }
.bottom-actions { align-items: center; background: rgba(255, 255, 255, 0.98); border-top: 1rpx solid #e5e9eb; bottom: 0; box-sizing: border-box; display: flex; gap: 14rpx; left: 0; padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom)); position: fixed; right: 0; z-index: 40; }
.button { align-items: center; border-radius: 14rpx; box-sizing: border-box; display: flex; font-size: 29rpx; font-weight: 500; justify-content: center; line-height: 1; min-height: 84rpx; padding: 0 24rpx; }
.button::after { border: none; }
.button-primary { background: #187e6e; color: #fff; flex: 1; }
.button-secondary { background: #eaf5f2; color: #187e6e; }
.button-danger { background: #fff0f0; color: #cd4141; }
.button[disabled] { background: #cfd4d7; color: #fff; }
.small-button { border: 1rpx solid #187e6e; border-radius: 10rpx; color: #187e6e; display: inline-flex; font-size: 24rpx; line-height: 54rpx; padding: 0 18rpx; }
.row { align-items: center; border-bottom: 1rpx solid #edf0f2; display: flex; justify-content: space-between; min-height: 72rpx; }
.row:last-child { border-bottom: 0; }
.row-label { color: #717982; flex-shrink: 0; font-size: 25rpx; margin-right: 20rpx; }
.row-value { color: #202429; flex: 1; font-size: 27rpx; text-align: right; word-break: break-all; }
.timeline { border-left: 2rpx solid #d9e7e2; margin-left: 10rpx; padding-left: 28rpx; }
.timeline-item { margin-bottom: 28rpx; position: relative; }
.timeline-dot { background: #187e6e; border: 6rpx solid #e4f3ee; border-radius: 50%; height: 14rpx; left: -39rpx; position: absolute; top: 7rpx; width: 14rpx; }
.timeline-title { font-size: 27rpx; font-weight: 600; }
.timeline-meta { color: #858d96; font-size: 22rpx; line-height: 1.6; margin-top: 6rpx; }
